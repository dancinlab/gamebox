{
  "project": "gamebox",
  "profile": "hardcore",
  "stack": [
    "hexa"
  ],
  "lockdown": {
    "files": [],
    "fromMarkdown": "CLAUDE.md",
    "onEditReminder": "L0 file edited — update CHANGELOG + issue tracker in the same change."
  },
  "enforcementFile": ".harness/enforcement.json",
  "keywordsFile": ".harness/keywords.json",
  "severityMapFile": ".harness/severity-map.json",
  "verify": {
    "checks": [
      {
        "id": "verify",
        "cmd": "hexa verify",
        "timeoutMs": 240000
      }
    ]
  },
  "lint": {
    "freshnessFiles": [],
    "changelog": {
      "file": "CHANGELOG.md",
      "triggerPattern": "\\.(hexa)$",
      "ignore": [
        "(^|/)(tests?|__tests__|spec)/",
        "\\.(test|spec)\\.[a-z]+$",
        "(^|/)\\.harness(-engine)?/"
      ]
    },
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "guides": [
    "CLAUDE.md",
    "AGENTS.md",
    "README.md"
  ],
  "docs": {
    "architecture": "ARCHITECTURE.md",
    "log": "CHANGELOG.md",
    "scratchDir": "scripts/scratch",
    "scopeDirs": [
      ""
    ],
    "allow": [
      "README.md",
      "CHANGELOG.md",
      "ARCHITECTURE.md",
      "CLAUDE.md",
      "AGENTS.md",
      "LICENSE",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "RELEASE_NOTES_v1.0.0.md",
      "RELEASE_NOTES_v1.0.1.md",
      "RELEASE_NOTES_v1.0.2.md",
      "RELEASE_NOTES_v1.0.3.md",
      "RELEASE_NOTES_v1.0.4.md",
      "TAPE-AUDIT.md"
    ]
  },
  "ledger": {
    "staleSec": 1800
  }
}
