// tests/test_closure.hexa — closure validation harness (own 1 + own 2, hexa-only)
//
// 검증 자동화: docs/CLOSURE_ROADMAP.md § 7 의 모든 sub-section
//   7.1 own 1 enforcement (Wine 0)
//   7.2 hexa native PE loader / Win32 shim (Phase 0a~6 모듈)
//   7.3 만점 16 컴포넌트 (14 D-list + 2 R-list + harvest_integ + R0 5 modules)
//   7.4 sprint readiness (Phase 9 D2R + Phase 10 D4 launch skeleton)
//   7.5 RFC PR-ready summary (RFC A1/A2/A3)
//   7.6 documentation 6 docs
//
// own 2 mandate:
//   - r0_emit ≥ 4 (실제 = 5: closure_check_own1 / closure_check_phases /
//                  closure_check_manjeom / closure_check_status / closure_check_done)
//   - fn self_test() + main() dispatch
//   - headless (filesystem stat + grep 만, GUI / dialog / interactive 0)
//   - panic("test_closure FAIL [<sub>] expected=X got=Y")

use "../lib/perf/r0_common"

// ─── 7.1 own 1 enforcement (Wine 0) ───
//
//   FAIL count 반환 (0 = PASS).
//   - /Applications/Whisky.app, GPTK.app, CrossOver.app 부재
//   - /opt/homebrew/Caskroom/{whisky,game-porting-toolkit,crossover} 부재
//   - /opt/homebrew/bin/{wine64,wineserver} 부재
//   - /opt/homebrew/Library/Taps/gcenx 부재
//   - tests/test_apple_only.hexa PASS
fn check_own1() -> int {
    let mut fail = 0

    // (a) /Applications/* 부재
    let apps = ["/Applications/Whisky.app", "/Applications/Game Porting Toolkit.app", "/Applications/CrossOver.app"]
    let mut i = 0
    while i < len(apps) {
        let p = apps[i]
        let s = exec("test -e '" + p + "' && echo present || echo absent").trim()
        if s != "absent" { fail = fail + 1 }
        i = i + 1
    }

    // (b) /opt/homebrew/Caskroom/* 부재
    let casks = ["/opt/homebrew/Caskroom/whisky", "/opt/homebrew/Caskroom/game-porting-toolkit", "/opt/homebrew/Caskroom/crossover"]
    i = 0
    while i < len(casks) {
        let p = casks[i]
        let s = exec("test -e '" + p + "' && echo present || echo absent").trim()
        if s != "absent" { fail = fail + 1 }
        i = i + 1
    }

    // (c) wine64 / wineserver binary 부재
    let bins = ["/opt/homebrew/bin/wine64", "/opt/homebrew/bin/wineserver"]
    i = 0
    while i < len(bins) {
        let p = bins[i]
        let s = exec("test -e '" + p + "' && echo present || echo absent").trim()
        if s != "absent" { fail = fail + 1 }
        i = i + 1
    }

    // (d) gcenx tap 부재
    let tap = exec("test -e '/opt/homebrew/Library/Taps/gcenx' && echo present || echo absent").trim()
    if tap != "absent" { fail = fail + 1 }

    // (e) tests/test_apple_only.hexa PASS — pass= line 의 fail=0 확인
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    if cmd == "" {
        // hexa 부재 환경 — PE loader 자체가 동작 X. own1 쪽은 file system 만으로 합격 가능.
        // hexa 없으면 test_apple_only 실행 자체 불가 → 1 fail 로 marking.
        fail = fail + 1
    } else {
        let out = exec(cmd + " run tests/test_apple_only.hexa 2>&1 | grep -E '^pass=' | tail -1").trim()
        if out == "" || !out.contains("fail=0") { fail = fail + 1 }
    }

    return fail
}

// ─── 7.2 Phase 0a/0b/1/2/3a/3b/3c/4a/4b/4c/5a/5b/6 모듈 + R0 5 modules ───
//
//   FAIL count = (모듈 부재) + (self-test FAIL).
//   파일 존재만으로 부분 PASS (self-test 는 hexa CLI 가 있을 때만 실행).
fn check_phases() -> int {
    let mut fail = 0

    // Phase 0a (pe_parser) / 0b (pe_loader) / 1 (win32_abi) / 2 (win32_stubs) /
    // 3a (kernel32) / 3b (ntdll) / 3c (msvcrt) /
    // 4a (user32) / 4b (gdi32) / 4c (advapi32) /
    // 5a (dx_d3d11) / 5b (dx_d3d12) / 6 (winsock)
    let loader_mods = ["pe_parser", "pe_loader", "win32_abi", "win32_stubs", "win32_kernel32", "win32_ntdll", "win32_msvcrt", "win32_user32", "win32_gdi32", "win32_advapi32", "dx_d3d11", "dx_d3d12", "win32_winsock"]
    let cmd = exec("command -v hexa 2>/dev/null").trim()

    let mut i = 0
    while i < len(loader_mods) {
        let m = loader_mods[i]
        let path = "lib/loader/" + m + ".hexa"
        let exists = exec("test -f '" + path + "' && echo ok").trim()
        if exists != "ok" {
            fail = fail + 1
        } else {
            if cmd != "" {
                let out = exec(cmd + " run " + path + " self-test 2>&1")
                if !out.contains("✅") {
                    if !out.contains("PASS") { fail = fail + 1 }
                }
            }
        }
        i = i + 1
    }

    // R0 5 modules — Phase 의존성은 아니지만 closure spec 7.2 요구사항에 통합됨.
    let r0_mods = ["r0_common", "r0_hud_parser", "r0_cache_watch", "r0_heap_sample", "r0_session"]
    let mut j = 0
    while j < len(r0_mods) {
        let m = r0_mods[j]
        let path = "lib/perf/" + m + ".hexa"
        let exists = exec("test -f '" + path + "' && echo ok").trim()
        if exists != "ok" {
            fail = fail + 1
        } else {
            if cmd != "" {
                let out = exec(cmd + " run " + path + " self-test 2>&1")
                if !out.contains("✅") {
                    if !out.contains("PASS") { fail = fail + 1 }
                }
            }
        }
        j = j + 1
    }

    return fail
}

// ─── 7.3 만점 16 컴포넌트 (14 D-list + 2 R-list) + harvest_integ ───
//
//   D-list 만점 12 (M2-M14 minus R + 신규 own1-driven 4):
//     C-FRAMETIME / C-HEAP / C-PSO / C-FRAME / C-SHADER-AGING /
//     C-SHADER-SEQ / C-SHADER-WARM++ / C-CORRELATE /
//     C-PE-PARSE-CACHE / C-IAT-RESOLVE-CACHE / C-WIN32-CALL-PROFILE / C-SYSCALL-BRIDGE-CACHE
//   R-list 만점 2:
//     C-DXIL-PERSIST / C-SHADER-WARM
//   wiring: harvest_integ
//
//   합 = 12 + 2 + 1 = 15 모듈 ("만점 16" 은 spec 명칭 — 실 모듈 15 개).
fn check_manjeom() -> int {
    let mut fail = 0
    let cmd = exec("command -v hexa 2>/dev/null").trim()

    // 14 만점 + 2 R + harvest = 15 모듈
    let mods = ["c_frametime", "c_heap", "c_pso", "c_frame", "c_shader_aging", "c_shader_seq", "c_shader_warm_pp", "c_correlate", "c_pe_parse_cache", "c_iat_resolve_cache", "c_win32_call_profile", "c_syscall_bridge_cache", "c_dxil_persist", "c_shader_warm", "harvest_integ"]
    let mut i = 0
    while i < len(mods) {
        let m = mods[i]
        let path = "lib/perf/" + m + ".hexa"
        let exists = exec("test -f '" + path + "' && echo ok").trim()
        if exists != "ok" {
            fail = fail + 1
        } else {
            if cmd != "" {
                let out = exec(cmd + " run " + path + " self-test 2>&1")
                if !out.contains("✅") {
                    if !out.contains("PASS") { fail = fail + 1 }
                }
            }
        }
        i = i + 1
    }

    return fail
}

// ─── 7.4 sprint readiness (Phase 9 D2R + Phase 10 D4 launch skeleton) ───
//
//   M1 baseline 측정은 game install 필요 — 실측은 closure 후.
//   skeleton 모듈 존재만 검증.
//   D4 launch (Phase 10) 는 skeleton 도 아직 없으면 blocked 로 카운트.
fn check_sprint_readiness() -> int {
    let mut fail = 0

    // Phase 9 — D2R launch skeleton
    let d2r = exec("test -f 'lib/loader/d2r_launch.hexa' && echo ok").trim()
    if d2r != "ok" { fail = fail + 1 }

    // Phase 10 — D4 launch skeleton (skeleton 단계 — 부재 시 blocked, 존재 시 PASS)
    let d4 = exec("test -f 'lib/loader/d4_launch.hexa' && echo ok").trim()
    if d4 != "ok" { fail = fail + 1 }

    return fail
}

// ─── 7.5 RFC PR-ready (RFC A1/A2/A3 + PR-ready summary 섹션) ───
fn check_rfc() -> int {
    let mut fail = 0

    let rfcs = ["RFC_A1_float_stage1.md", "RFC_A2_bit_ops.md", "RFC_A3_dict_literal.md"]
    let mut i = 0
    while i < len(rfcs) {
        let f = "docs/hexa_rfc/" + rfcs[i]
        let exists = exec("test -f '" + f + "' && echo ok").trim()
        if exists != "ok" {
            fail = fail + 1
        } else {
            // PR-ready summary 섹션 grep — case-insensitive "PR-ready" 또는 "PR ready"
            let has_pr = exec("grep -ciE 'PR[- ]ready' '" + f + "'").trim()
            if has_pr == "0" || has_pr == "" { fail = fail + 1 }
        }
        i = i + 1
    }

    return fail
}

// ─── 7.6 documentation (6 docs) ───
fn check_docs() -> int {
    let mut fail = 0

    let docs = ["docs/CLOSURE_ROADMAP.md", "docs/MINIMAL_NATIVE_PLAN.md", "docs/PERF_PLAN.md", "docs/SCORING.md", "docs/BRAINSTORM.md", "docs/IMPLEMENTATION_ROADMAP.md"]
    let mut i = 0
    while i < len(docs) {
        let d = docs[i]
        let exists = exec("test -f '" + d + "' && echo ok").trim()
        if exists != "ok" { fail = fail + 1 }
        i = i + 1
    }

    return fail
}

// ─── closure_status — CM-X / CM-30 누적 ───
//
//   docs/CLOSURE_ROADMAP.md § 5 의 CM-0 ~ CM-30 을 기준으로 N% 산출.
//
//   동적 계산:
//     CM-0  현재 (commit baseline) — 항상 done
//     CM-1  C-PE-PARSE-CACHE 존재 → +1
//     CM-2  Phase 0b pe_loader 존재 → +1
//     CM-3  C-IAT-RESOLVE-CACHE 존재 → +1
//     CM-4  Phase 1 win32_abi 존재 → +1
//     CM-5  Phase 2 win32_stubs 존재 → +1
//     CM-6  C-WIN32-CALL-PROFILE 존재 → +1
//     CM-7  HEXA Phase A (RFC PR-ready 3 개 모두) → +1
//     CM-8  Phase 3a kernel32 존재 → +1
//     CM-9  C-SYSCALL-BRIDGE-CACHE 존재 → +1
//     CM-10 ntdll / CM-11 msvcrt / CM-12 user32 / CM-13 gdi32 / CM-14 advapi32
//     CM-15 dx_d3d11 / CM-16 dx_d3d12 / CM-17 winsock
//     CM-18 Phase 7 OSS Win 게임 검증 — runtime 의존 (skeleton 부재 — blocked)
//     CM-19 Phase 8 battlenet_bypass 존재 → +1
//     CM-20 Phase 9 d2r_launch 존재 → +1
//     CM-21~CM-30 — measurement / EXHAUSTION (closure 후) — blocked
//
//   "in-progress: N% (X/Y)" 또는 "ready" / "blocked: <reason>".
fn closure_status() -> str {
    // 30 milestone 진행 카운트.
    // CM-0 (baseline) 은 무조건 done — own 1 / own 2 enforcement 확립 완료.
    let mut done = 1

    // CM-1 / CM-3 / CM-6 / CM-9 — own1-driven 만점 4
    let cm1 = exec("test -f 'lib/perf/c_pe_parse_cache.hexa' && echo ok").trim()
    if cm1 == "ok" { done = done + 1 }
    let cm3 = exec("test -f 'lib/perf/c_iat_resolve_cache.hexa' && echo ok").trim()
    if cm3 == "ok" { done = done + 1 }
    let cm6 = exec("test -f 'lib/perf/c_win32_call_profile.hexa' && echo ok").trim()
    if cm6 == "ok" { done = done + 1 }
    let cm9 = exec("test -f 'lib/perf/c_syscall_bridge_cache.hexa' && echo ok").trim()
    if cm9 == "ok" { done = done + 1 }

    // CM-2 / CM-4 / CM-5 / CM-8 / CM-10 / CM-11 / CM-12 / CM-13 / CM-14 / CM-15 / CM-16 / CM-17
    let phase_files = ["lib/loader/pe_loader.hexa", "lib/loader/win32_abi.hexa", "lib/loader/win32_stubs.hexa", "lib/loader/win32_kernel32.hexa", "lib/loader/win32_ntdll.hexa", "lib/loader/win32_msvcrt.hexa", "lib/loader/win32_user32.hexa", "lib/loader/win32_gdi32.hexa", "lib/loader/win32_advapi32.hexa", "lib/loader/dx_d3d11.hexa", "lib/loader/dx_d3d12.hexa", "lib/loader/win32_winsock.hexa"]
    let mut i = 0
    while i < len(phase_files) {
        let f = phase_files[i]
        let s = exec("test -f '" + f + "' && echo ok").trim()
        if s == "ok" { done = done + 1 }
        i = i + 1
    }

    // CM-7 HEXA Phase A — RFC A1/A2/A3 모두 PR-ready summary 보유
    let rfc_fail = check_rfc()
    if rfc_fail == 0 { done = done + 1 }

    // CM-19 Phase 8 battlenet_bypass
    let cm19 = exec("test -f 'lib/loader/battlenet_bypass.hexa' && echo ok").trim()
    if cm19 == "ok" { done = done + 1 }

    // CM-20 Phase 9 d2r_launch skeleton
    let cm20 = exec("test -f 'lib/loader/d2r_launch.hexa' && echo ok").trim()
    if cm20 == "ok" { done = done + 1 }

    // CM-25 Phase 10 d4_launch skeleton (있으면 +1)
    let cm25 = exec("test -f 'lib/loader/d4_launch.hexa' && echo ok").trim()
    if cm25 == "ok" { done = done + 1 }

    // CM-18 Phase 7 OSS Win 게임 / CM-21~24 / CM-26~30 — runtime measurement / EXHAUSTION
    //   skeleton 단계에서는 검출 불가. 31 total milestones (CM-0 ~ CM-30).
    let total = 31

    // 차단 조건 — 측정-track (CM-21 이후) 은 game install 필요.
    if done >= total { return "ready" }

    // pct 계산 — int 산술 (stage1 float 우회).
    let pct = done * 100 / total

    return "in-progress: " + to_string(pct) + "% (CM-" + to_string(done - 1) + "/CM-30 done)"
}

// ─── self_test ───
//
// 주의: check_phases() / check_manjeom() 가 child hexa 프로세스를 spawn 하면
// 각 child 가 r0_session_set() 으로 R0_CURRENT_SESSION_PTR 을 overwrite 함.
// 따라서 emit 직전에 우리 sid 로 r0_session_set() 을 재설정해야 우리 session 파일에
// append 됨.
fn self_test() -> void {
    let sid = "closure-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. own 1 enforcement
    let f1 = check_own1()
    r0_session_set(sid)
    r0_emit("closure_check_own1", "\"fail\":" + to_string(f1))
    if f1 != 0 {
        panic("test_closure FAIL [check_own1] expected=0 got=" + to_string(f1))
    }

    // 2. Phase 0a~6 + R0 5 modules (child hexa spawn — sid 손상 가능)
    let f2 = check_phases()
    r0_session_set(sid)
    r0_emit("closure_check_phases", "\"fail\":" + to_string(f2))
    if f2 != 0 {
        panic("test_closure FAIL [check_phases] expected=0 got=" + to_string(f2))
    }

    // 3. 만점 16 (15 모듈) + harvest (child hexa spawn — sid 손상 가능)
    let f3 = check_manjeom()
    r0_session_set(sid)
    r0_emit("closure_check_manjeom", "\"fail\":" + to_string(f3))
    if f3 != 0 {
        panic("test_closure FAIL [check_manjeom] expected=0 got=" + to_string(f3))
    }

    // 4. sprint readiness — D4 skeleton 부재는 blocked (M1 measurement = closure 후) — 정보용 1+ 허용.
    let f4 = check_sprint_readiness()
    if f4 > 1 {
        panic("test_closure FAIL [check_sprint_readiness] expected=<=1 got=" + to_string(f4))
    }

    // 5. RFC PR-ready
    let f5 = check_rfc()
    if f5 != 0 {
        panic("test_closure FAIL [check_rfc] expected=0 got=" + to_string(f5))
    }

    // 6. documentation
    let f6 = check_docs()
    if f6 != 0 {
        panic("test_closure FAIL [check_docs] expected=0 got=" + to_string(f6))
    }

    // 7. closure_status
    let st = closure_status()
    if !st.contains("in-progress") {
        if st != "ready" {
            panic("test_closure FAIL [closure_status] expected=in-progress|ready got=" + st)
        }
    }
    r0_session_set(sid)
    r0_emit("closure_check_status", "\"status\":\"" + st + "\",\"sprint_readiness_fail\":" + to_string(f4) + ",\"rfc_fail\":" + to_string(f5) + ",\"docs_fail\":" + to_string(f6))

    // 8. emit count >= 4 검증 (own1 / phases / manjeom / status = 4 — done sentinel 추가 후 5)
    r0_session_set(sid)
    r0_emit("closure_check_done", "\"emits\":5")
    let cnt = r0_session_count(sid)
    if cnt < 4 {
        panic("test_closure FAIL [emit count] expected=>=4 got=" + to_string(cnt))
    }

    println("  ✅ test_closure self_test PASS (closure status: " + st + ", sid=" + sid + ", emits=" + to_string(cnt) + ")")
}

fn main() -> void {
    let a = args()
    // args() = [hexa, file, ...userargs]. a[2] = 첫 user arg.
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "status" {
            println(closure_status())
            return
        }
        println("usage: hexa run tests/test_closure.hexa { self-test | status }")
        return
    }
    // 인자 없으면 default = self-test (own 2 mandate: self_test 가 main 에서 dispatch).
    self_test()
}
