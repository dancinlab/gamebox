// tests/test_purple_lineage_offline_shim.hexa — Track-B Purple → Lineage chain harness (own1 + own2, hexa-only)
//
// Drives offline-shim PASS matrix for:
//   - .roadmap.purple_launcher cond.1 (.NET CLR + WebView2, 2 runtimes)
//   - .roadmap.purple_launcher cond.2 (Android emul layer — gles_to_metal, 4 stages)
//   - .roadmap.lineage_w cond.1 cascading via new pe_lineage_w_purple_track loader
//   - .roadmap.lineage_classic_r28 retired_intentional posture rows
//
// own 1 enforcement: Wine / CrossOver / Whisky / GPTK / community 코드 0 줄. plaync net 0건. real Edge runtime fetch 0건.
// own 2 mandate:
//   - r0_emit ≥ 6 (실제: track_b_purple_cond1 / track_b_purple_cond2 / track_b_lineage_w /
//                  track_b_lineage_classic_r28_retired / track_b_roadmap_headers /
//                  track_b_purple_cond3 / track_b_done)
//   - fn self_test() + main() dispatch
//   - headless (filesystem stat + child hexa probe 만, GUI / dialog / interactive 0)
//   - panic("test_purple_lineage_offline_shim FAIL [<sub>] expected=X got=Y") 형식

use "../lib/perf/r0_common"

// ─── helper — module file 존재 + (hexa CLI 있을 시) self-test PASS 검증 ───
fn check_module(path: str, label: str) -> int {
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" {
        return 1
    }
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    if cmd == "" {
        // hexa CLI 부재 — file 존재만으로 schema_only PASS (predecessor cycle 동일 posture).
        return 0
    }
    let out = exec(cmd + " run " + path + " self-test 2>&1")
    if out.contains("✅") { return 0 }
    if out.contains("PASS") { return 0 }
    return 1
}

// ─── 1. .roadmap.purple_launcher cond.1 — 2 runtimes (dotnet_clr + webview2) ───
fn check_purple_cond1() -> int {
    let mut fail = 0
    fail = fail + check_module("lib/perf/c_purple_dotnet_clr_probe.hexa", "purple_dotnet_clr")
    fail = fail + check_module("lib/perf/c_purple_webview2_warm.hexa", "purple_webview2")
    return fail
}

// ─── 2. .roadmap.purple_launcher cond.2 — gles_to_metal passthrough ───
fn check_purple_cond2() -> int {
    let mut fail = 0
    fail = fail + check_module("lib/perf/c_purple_android_emul_layer_track.hexa", "purple_android_emul")
    return fail
}

// ─── 3. .roadmap.lineage_w cond.1 — new loader sub-module pe_lineage_w_purple_track ───
fn check_lineage_w() -> int {
    let mut fail = 0
    fail = fail + check_module("lib/loader/pe_lineage_w_purple_track.hexa", "lineage_w_purple_track")
    // Cross-link sibling — pe_lineage_m_purple_track must remain (untouched in this cycle).
    let m_exists = exec("test -f 'lib/loader/pe_lineage_m_purple_track.hexa' && echo ok").trim()
    if m_exists != "ok" { fail = fail + 1 }
    return fail
}

// ─── 4. .roadmap.lineage_classic_r28 retired_intentional posture row ───
fn check_lineage_classic_r28_retired() -> int {
    let mut fail = 0
    fail = fail + check_module("lib/loader/pe_lineage_classic_r28_track.hexa", "lineage_classic_r28")
    // mk1 narrative doc must exist.
    let mk1 = exec("test -f 'docs/LINEAGE_CLASSIC_R28_MANJEOM_REVIEW.md' && echo ok").trim()
    if mk1 != "ok" { fail = fail + 1 }
    // .roadmap header presence.
    let rmap = exec("test -f '.roadmap.lineage_classic_r28' && echo ok").trim()
    if rmap != "ok" { fail = fail + 1 }
    return fail
}

// ─── 5. roadmap header parse smoke (4 files, JSONL header line 5) ───
fn check_roadmap_headers() -> int {
    let mut fail = 0
    let roadmaps = [".roadmap.purple_launcher", ".roadmap.lineage_m", ".roadmap.lineage_w", ".roadmap.lineage_classic_r28"]
    let mut i = 0
    while i < len(roadmaps) {
        let p = roadmaps[i]
        let exists = exec("test -f '" + p + "' && echo ok").trim()
        if exists != "ok" {
            fail = fail + 1
        } else {
            // line 5 must start with `{"type":"header"`
            let line5 = exec("sed -n '5p' '" + p + "'")
            if !line5.contains("\"type\":\"header\"") { fail = fail + 1 }
        }
        i = i + 1
    }
    return fail
}

// ─── 6. .roadmap.purple_launcher cond.3 — plaync OAuth token_refresh-FAIL leg ───
//
// cond.3 (plaync OAuth 2-leg + 2FA TOTP) 은 status=partial (purple_launcher.blk.1 —
// plaync online endpoint network dependency). 본 check 는 그 SYNTHETIC scaffold 의
// token_refresh-FAIL leg (stage=3 success=0, refresh_token 만료 → 재로그인) 가
// c_purple_plaync_oauth_proxy.hexa self_test 에서 실제로 행사되는지 skeleton-validate.
//   (a) static grep — 새 emit marker `plaync_oauth_refresh_fail` 가 module source 에 존재.
//   (b) live  out.contains — module self-test 가 PASS + summary 에 refresh_fail=1 노출.
// own1: 합성 데이터만 (실제 plaync account / network / token 0건 · GameGuard blocked-not-bypassed).
fn check_purple_cond3_oauth_refresh_fail() -> int {
    let mut fail = 0
    let path = "lib/perf/c_purple_plaync_oauth_proxy.hexa"
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" { return 1 }
    // (a) static — new token_refresh-fail emit marker must exist in module source.
    let g = exec("grep -c 'plaync_oauth_refresh_fail' '" + path + "'").trim()
    if g == "" || g == "0" { fail = fail + 1 }
    // (b) live — run module self-test (hexa CLI 부재 시 schema_only PASS, predecessor posture).
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    if cmd != "" {
        let out = exec(cmd + " run " + path + " self-test 2>&1")
        if !out.contains("✅") && !out.contains("PASS") { fail = fail + 1 }
        // new token_refresh-FAIL row must surface in the PASS summary line.
        if !out.contains("refresh_fail=1") { fail = fail + 1 }
    }
    return fail
}

// ─── self_test ───
//
// 주의: 각 child hexa spawn 은 r0_session_set() 으로 R0_CURRENT_SESSION_PTR 을 overwrite 함.
// emit 직전에 우리 sid 로 r0_session_set() 을 재설정해야 우리 session 파일에 append 됨.
fn self_test() -> void {
    let sid = "purple-lineage-shim-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. purple_launcher cond.1 (.NET CLR + WebView2)
    let f1 = check_purple_cond1()
    r0_session_set(sid)
    r0_emit("track_b_purple_cond1", "\"fail\":" + to_string(f1) + ",\"runtimes\":[\"dotnet_clr\",\"webview2\"]")
    if f1 != 0 {
        panic("test_purple_lineage_offline_shim FAIL [purple_cond1] expected=0 got=" + to_string(f1))
    }

    // 2. purple_launcher cond.2 (Android emul layer — gles_to_metal)
    let f2 = check_purple_cond2()
    r0_session_set(sid)
    r0_emit("track_b_purple_cond2", "\"fail\":" + to_string(f2) + ",\"stages\":[\"dalvik_vm\",\"art_aot\",\"jni_native_bridge\",\"gles_to_metal\"]")
    if f2 != 0 {
        panic("test_purple_lineage_offline_shim FAIL [purple_cond2] expected=0 got=" + to_string(f2))
    }

    // 3. lineage_w cond.1 cascading (new loader sub-module)
    let f3 = check_lineage_w()
    r0_session_set(sid)
    r0_emit("track_b_lineage_w", "\"fail\":" + to_string(f3) + ",\"loader\":\"pe_lineage_w_purple_track.hexa\",\"engine\":\"ue4\",\"binary\":\"LineageW.exe\"")
    if f3 != 0 {
        panic("test_purple_lineage_offline_shim FAIL [lineage_w] expected=0 got=" + to_string(f3))
    }

    // 4. lineage_classic_r28 retired_intentional posture
    let f4 = check_lineage_classic_r28_retired()
    r0_session_set(sid)
    r0_emit("track_b_lineage_classic_r28_retired", "\"fail\":" + to_string(f4) + ",\"posture\":\"retired_intentional\",\"family\":\"gameguard\",\"mode\":\"kernel\",\"bypass\":\"forbidden\"")
    if f4 != 0 {
        panic("test_purple_lineage_offline_shim FAIL [lineage_classic_r28_retired] expected=0 got=" + to_string(f4))
    }

    // 5. roadmap header parse smoke (4 files)
    let f5 = check_roadmap_headers()
    r0_session_set(sid)
    r0_emit("track_b_roadmap_headers", "\"fail\":" + to_string(f5) + ",\"files\":4")
    if f5 != 0 {
        panic("test_purple_lineage_offline_shim FAIL [roadmap_headers] expected=0 got=" + to_string(f5))
    }

    // 6. purple_launcher cond.3 (plaync OAuth token_refresh-FAIL leg — synthetic, network-gated)
    let f6 = check_purple_cond3_oauth_refresh_fail()
    r0_session_set(sid)
    r0_emit("track_b_purple_cond3", "\"fail\":" + to_string(f6) + ",\"leg\":\"token_refresh_fail\",\"marker\":\"plaync_oauth_refresh_fail\",\"status\":\"partial\",\"blocker\":\"purple_launcher.blk.1\",\"posture\":\"synthetic_network_gated\",\"gameguard\":\"blocked_not_bypassed\"")
    if f6 != 0 {
        panic("test_purple_lineage_offline_shim FAIL [purple_cond3] expected=0 got=" + to_string(f6))
    }

    // 7. done sentinel — emit count check
    r0_session_set(sid)
    r0_emit("track_b_done", "\"emits\":7,\"chain\":\"purple_to_lineage_offline_shim\"")
    let cnt = r0_session_count(sid)
    if cnt < 6 {
        panic("test_purple_lineage_offline_shim FAIL [emit count] expected=>=6 got=" + to_string(cnt))
    }

    println("  ✅ test_purple_lineage_offline_shim self_test PASS (purple_cond1=" + to_string(f1)
        + ", purple_cond2=" + to_string(f2) + ", lineage_w=" + to_string(f3)
        + ", lineage_classic_r28_retired=" + to_string(f4) + ", roadmap_headers=" + to_string(f5)
        + ", purple_cond3=" + to_string(f6)
        + ", emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    // args() = [hexa, file, ...userargs]. a[2] = 첫 user arg.
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        println("usage: hexa run tests/test_purple_lineage_offline_shim.hexa { self-test }")
        return
    }
    // 인자 없으면 default = self-test (own 2 mandate: self_test 가 main 에서 dispatch).
    self_test()
}
