// tests/test_d2r_d3d11_synthetic_scaffold.hexa — Track G cond.3 evidence augment harness (own 1 + own 2, hexa-only)
//
// Mission: D2R cond.3 (D3D11 renderer init + first-frame draw + dx11 pipeline warm)
// 측 synthetic D3D11 scaffold + first-frame trace + pipeline warm 검증.
//
// 검증 자동화:
//   pe_d2r_d3d11_renderer_init  — synthetic device_init + swapchain_create +
//                                 first_frame_submit_simulated 3 stage scaffold
//   c_d2r_first_frame_trace     — synthetic frame_0 instrumentation (frame_id_0 +
//                                 render_command_count + GPU submit ts synthesis)
//   c_d2r_dx11_pipeline_warm    — synthetic pso_priority + srv_binding 2 stage warm
//
// own 2 mandate:
//   - r0_emit ≥ 4 (track_g_check_renderer_scaffold / track_g_check_first_frame_trace /
//                  track_g_check_pipeline_warm / track_g_emit_count_audit / track_g_chain_done)
//   - fn self_test() + main() dispatch
//   - headless (filesystem stat + grep + child hexa spawn 만, GUI / dialog / interactive 0)
//   - panic("test_d2r_d3d11_synthetic_scaffold FAIL [<sub>] expected=X got=Y")
//
// own 1 mandate:
//   Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0.
//   D3DMetal binary linkage 0 / GPU driver shim 0 — synthetic byte-array inline only.
//
// Posture: cond.3 status `partial → partial` (evidence augment 만, NOT met 승격).
//          real GPU first-frame submit 는 loader_dx blk.1 D3DMetal binary licence transitive.

use "../lib/perf/r0_common"

// ─── helper: run module self-test + capture output ───
fn run_module_self_test(path: str) -> str {
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    if cmd == "" {
        return ""
    }
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" {
        return ""
    }
    return exec(cmd + " run " + path + " self-test 2>&1")
}

// ─── grep-based skeleton-validate fallback ───
//
// hexa CLI wrapper 가 docker route 로 fall-through 시 stdout 측 status_emit
// 미캡쳐 (resolver fail 후 exit 0) — 이 경우 source 측 grep 으로 emit string
// 존재 여부를 check (skeleton-validated PARTIAL, predecessor Track D landing 동급 posture).
fn grep_emit(path: str, marker: str) -> int {
    let g = exec("grep -c '" + marker + "' " + path).trim()
    if g == "0" || g == "" {
        return 1
    }
    return 0
}

// ─── 1. pe_d2r_d3d11_renderer_init synthetic D3D11 scaffold 3 stage ───
fn check_renderer_scaffold() -> int {
    let mut fail = 0

    let path = "lib/loader/pe_d2r_d3d11_renderer_init.hexa"
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" {
        return 99
    }

    // CLI 실측 1차 + skeleton grep 2차 OR fallback (둘 중 하나라도 PARTIAL emit = OK).
    let out = run_module_self_test(path)
    let live_device = out.contains("__D2R_RENDERER__ PARTIAL device_init")
    let live_swapchain = out.contains("__D2R_RENDERER__ PARTIAL swapchain_create")
    let live_submit = out.contains("__D2R_RENDERER__ PARTIAL first_frame_submit_simulated")

    let g_device = grep_emit(path, "__D2R_RENDERER__ PARTIAL device_init")
    let g_swapchain = grep_emit(path, "__D2R_RENDERER__ PARTIAL swapchain_create")
    let g_submit = grep_emit(path, "__D2R_RENDERER__ PARTIAL first_frame_submit_simulated")

    if !live_device && g_device != 0 { fail = fail + 1 }
    if !live_swapchain && g_swapchain != 0 { fail = fail + 1 }
    if !live_submit && g_submit != 0 { fail = fail + 1 }
    return fail
}

// ─── 2. c_d2r_first_frame_trace synthetic first-frame trace 1 stage ───
fn check_first_frame_trace() -> int {
    let mut fail = 0

    let path = "lib/perf/c_d2r_first_frame_trace.hexa"
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" {
        return 99
    }

    let out = run_module_self_test(path)
    let live_frame_0 = out.contains("__D2R_TRACE__ PARTIAL frame_0_synthetic")
    let g_frame_0 = grep_emit(path, "__D2R_TRACE__ PARTIAL frame_0_synthetic")

    if !live_frame_0 && g_frame_0 != 0 { fail = fail + 1 }
    return fail
}

// ─── 3. c_d2r_dx11_pipeline_warm synthetic pipeline warm 2 stage ───
fn check_pipeline_warm() -> int {
    let mut fail = 0

    let path = "lib/perf/c_d2r_dx11_pipeline_warm.hexa"
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" {
        return 99
    }

    let out = run_module_self_test(path)
    let live_pso = out.contains("__D2R_WARM__ PARTIAL pso_priority")
    let live_srv = out.contains("__D2R_WARM__ PARTIAL srv_binding")

    let g_pso = grep_emit(path, "__D2R_WARM__ PARTIAL pso_priority")
    let g_srv = grep_emit(path, "__D2R_WARM__ PARTIAL srv_binding")

    if !live_pso && g_pso != 0 { fail = fail + 1 }
    if !live_srv && g_srv != 0 { fail = fail + 1 }
    return fail
}

// ─── chain status: cond.3 evidence augment ready 인지 ───
fn track_g_chain_status() -> str {
    let f1 = check_renderer_scaffold()
    let f2 = check_first_frame_trace()
    let f3 = check_pipeline_warm()
    let total = f1 + f2 + f3
    if total == 0 {
        return "ready"
    }
    return "in-progress: renderer_scaffold_fail=" + to_string(f1)
        + ",first_frame_trace_fail=" + to_string(f2)
        + ",pipeline_warm_fail=" + to_string(f3)
}

// ─── self_test ───
//
// 주의: 각 check_*() 가 child hexa 프로세스 spawn 시 r0_session_set() overwrite —
// emit 직전 우리 sid 로 재설정 필수.
fn self_test() -> void {
    let sid = "track-g-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. pe_d2r_d3d11_renderer_init synthetic D3D11 scaffold
    let f1 = check_renderer_scaffold()
    r0_session_set(sid)
    r0_emit("track_g_check_renderer_scaffold",
        "\"cond\":\"diablo2_resurrected.cond.3\",\"stages\":[\"device_init\",\"swapchain_create\",\"first_frame_submit_simulated\"],\"posture\":\"partial_to_partial\",\"fail\":" + to_string(f1))
    if f1 != 0 {
        panic("test_d2r_d3d11_synthetic_scaffold FAIL [check_renderer_scaffold] expected=0 got=" + to_string(f1))
    }

    // 2. c_d2r_first_frame_trace synthetic first-frame trace
    let f2 = check_first_frame_trace()
    r0_session_set(sid)
    r0_emit("track_g_check_first_frame_trace",
        "\"cond\":\"diablo2_resurrected.cond.3\",\"stages\":[\"frame_0_synthetic\"],\"posture\":\"partial_to_partial\",\"fail\":" + to_string(f2))
    if f2 != 0 {
        panic("test_d2r_d3d11_synthetic_scaffold FAIL [check_first_frame_trace] expected=0 got=" + to_string(f2))
    }

    // 3. c_d2r_dx11_pipeline_warm synthetic pipeline warm
    let f3 = check_pipeline_warm()
    r0_session_set(sid)
    r0_emit("track_g_check_pipeline_warm",
        "\"cond\":\"diablo2_resurrected.cond.3\",\"stages\":[\"pso_priority\",\"srv_binding\"],\"posture\":\"partial_to_partial\",\"fail\":" + to_string(f3))
    if f3 != 0 {
        panic("test_d2r_d3d11_synthetic_scaffold FAIL [check_pipeline_warm] expected=0 got=" + to_string(f3))
    }

    // 4. emit count audit — 3 module 측 신규 PARTIAL emit ≥ 6 (3 + 1 + 2)
    let mut emit_audit = 0
    let p1 = "lib/loader/pe_d2r_d3d11_renderer_init.hexa"
    let p2 = "lib/perf/c_d2r_first_frame_trace.hexa"
    let p3 = "lib/perf/c_d2r_dx11_pipeline_warm.hexa"
    if grep_emit(p1, "__D2R_RENDERER__ PARTIAL device_init") == 0 { emit_audit = emit_audit + 1 }
    if grep_emit(p1, "__D2R_RENDERER__ PARTIAL swapchain_create") == 0 { emit_audit = emit_audit + 1 }
    if grep_emit(p1, "__D2R_RENDERER__ PARTIAL first_frame_submit_simulated") == 0 { emit_audit = emit_audit + 1 }
    if grep_emit(p2, "__D2R_TRACE__ PARTIAL frame_0_synthetic") == 0 { emit_audit = emit_audit + 1 }
    if grep_emit(p3, "__D2R_WARM__ PARTIAL pso_priority") == 0 { emit_audit = emit_audit + 1 }
    if grep_emit(p3, "__D2R_WARM__ PARTIAL srv_binding") == 0 { emit_audit = emit_audit + 1 }
    r0_session_set(sid)
    r0_emit("track_g_emit_count_audit",
        "\"expected_min\":6,\"got\":" + to_string(emit_audit) + ",\"posture\":\"evidence_augment\"")
    if emit_audit < 6 {
        panic("test_d2r_d3d11_synthetic_scaffold FAIL [emit_audit] expected=>=6 got=" + to_string(emit_audit))
    }

    // 5. chain status
    let st = track_g_chain_status()
    if st != "ready" {
        panic("test_d2r_d3d11_synthetic_scaffold FAIL [chain_status] expected=ready got=" + st)
    }

    // 6. emit count >= 4 (3 check + 1 audit + done sentinel)
    r0_session_set(sid)
    r0_emit("track_g_chain_done",
        "\"chain\":\"d2r_cond_3_synthetic_d3d11_scaffold\",\"cond_promoted\":0,\"cond_evidence_augmented\":1,\"posture\":\"partial_to_partial\",\"real_gpu_gap\":\"permanent\",\"transitive_blocker\":\"loader_dx.blk.1.d3dmetal_binary_licence\",\"status\":\"" + st + "\"")
    let cnt = r0_session_count(sid)
    if cnt < 4 {
        panic("test_d2r_d3d11_synthetic_scaffold FAIL [emit count] expected=>=4 got=" + to_string(cnt))
    }

    println("  ✅ test_d2r_d3d11_synthetic_scaffold self_test PASS (chain status: " + st + ", sid=" + sid + ", emits=" + to_string(cnt) + ")")
}

fn main() -> void {
    let a = args()
    // args() = [hexa, file, ...userargs]. a[2] = 첫 user arg.
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "status" {
            println(track_g_chain_status())
            return
        }
        println("usage: hexa run tests/test_d2r_d3d11_synthetic_scaffold.hexa { self-test | status }")
        return
    }
    // 인자 없으면 default = self-test (own 2 mandate: self_test 가 main 에서 dispatch).
    self_test()
}
