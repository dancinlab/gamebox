// community wine 흔적 검출 시 panic.

use "../lib/perf/r0_common"

let mut PASS = 0
let mut FAIL = 0

fn t_pass(label: str) -> void {
    PASS = PASS + 1
    println("  PASS " + label)
}

fn t_fail(label: str, msg: str) -> void {
    FAIL = FAIL + 1
    println("  FAIL " + label + ": " + msg)
}

fn check_absent(path: str, label: str) -> void {
    let f = exec("test -e '" + path + "' && echo present || echo absent").trim()
    if f == "absent" {
        t_pass(label)
    } else {
        t_fail(label, path + " exists")
    }
}

fn test_no_wine_apps() -> void {
    check_absent("/Applications/Whisky.app", "no /Applications/Whisky.app")
    check_absent("/Applications/Game Porting Toolkit.app", "no /Applications/Game Porting Toolkit.app")
    check_absent("/Applications/CrossOver.app", "no /Applications/CrossOver.app")
}

fn test_no_caskroom_wine() -> void {
    check_absent("/opt/homebrew/Caskroom/whisky", "no Caskroom/whisky")
    check_absent("/opt/homebrew/Caskroom/game-porting-toolkit", "no Caskroom/game-porting-toolkit")
    check_absent("/opt/homebrew/Caskroom/crossover", "no Caskroom/crossover")
}

fn test_no_path_wine() -> void {
    check_absent("/opt/homebrew/bin/wine64", "no /opt/homebrew/bin/wine64")
    check_absent("/opt/homebrew/bin/wineserver", "no /opt/homebrew/bin/wineserver")
    check_absent("/opt/homebrew/bin/wine64-preloader", "no wine64-preloader symlink")
}

fn test_no_gcenx_tap() -> void {
    check_absent("/opt/homebrew/Library/Taps/gcenx", "no gcenx tap")
}

// 코드 안의 wine binary "invocation" grep — exclusion: 이 test, lib/detect, .own
fn test_no_wine_calls_in_code() -> void {
    // lib + entry + tests 에서 wine64/wineserver/cxbottle invocation grep
    // exec wine64 라는 패턴이 invocation
    let cmd = "grep -rE '(^|[^/_])(wine64|wineserver|cxbottle|cxstart)([[:space:]]+[^=]|$)' --include='*.sh' --include='*.hexa' lib entry tests 2>/dev/null | grep -v 'test_apple_only' | grep -v 'lib/detect' | grep -vE '^[^:]*:[[:space:]]*(#|//)' || true"
    let hits = exec(cmd).trim()
    if hits == "" {
        t_pass("no wine64/wineserver/cxbottle invocations")
    } else {
        t_fail("wine invocations found", hits)
    }
}

fn test_no_legacy_files() -> void {
    check_absent("lib/launch.sh", "no lib/launch.sh")
    check_absent("lib/prefix.sh", "no lib/prefix.sh")
    check_absent("lib/games", "no lib/games/")
    check_absent("lib/perf/r0_install.hexa", "no r0_install.hexa")
    check_absent("lib/common.sh", "no lib/common.sh")
    check_absent("lib/detect.sh", "no lib/detect.sh")
    check_absent("tests/test.sh", "no tests/test.sh")
    check_absent("tests/test_apple_only.sh", "no tests/test_apple_only.sh")
}

fn test_plugin_manifest_clean() -> void {
    let f = "plugin.json"
    // jq 없이 grep — "backends" 키 자체가 있는지 확인
    let has_backends = exec("grep -c '\"backends\"' '" + f + "'").trim()
    if has_backends == "0" || has_backends == "" {
        t_pass("plugin.json: no community backends key")
        return
    }
    // backends 키 있으면 community 명칭 검출
    let bad = exec("grep -iE '\"backends\".*(whisky|crossover|gcenx)' '" + f + "' || true").trim()
    if bad == "" {
        t_pass("plugin.json backends clean")
    } else {
        t_fail("plugin.json backends mentions community", bad)
    }
}

fn test_loader_imports_clean() -> void {
    let bad = exec("grep -E '^use ' lib/loader/*.hexa 2>/dev/null | grep -vE '\"\\.\\./perf/r0_common\"|\"\\./r0_common\"|\"\\./[a-z][a-z_0-9]*\"' || true").trim()
    if bad == "" {
        t_pass("lib/loader/ imports clean (only r0_common)")
    } else {
        t_fail("loader unexpected imports", bad)
    }
}

fn main() -> void {
    println("own 1 enforcement — Apple-only test (hexa)")
    test_no_wine_apps()
    test_no_caskroom_wine()
    test_no_path_wine()
    test_no_gcenx_tap()
    test_no_wine_calls_in_code()
    test_no_legacy_files()
    test_plugin_manifest_clean()
    test_loader_imports_clean()
    println("")
    println("pass=" + to_string(PASS) + " fail=" + to_string(FAIL))
    if FAIL != 0 {
        panic("own 1 enforcement FAIL=" + to_string(FAIL))
    }
}
