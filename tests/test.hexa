// 6. loader (Phase 0a~10 + stage1 ×8)
fn test_loader() -> void {
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    let mods = ["pe_parser", "pe_loader", "pe_loader_stage1", "pe_imports", "pe_relocations", "win32_abi", "win32_stubs", "win32_kernel32", "win32_kernel32_stage1", "win32_kernel32_stage2", "win32_kernel32_stage3", "win32_kernel32_extras", "win32_abi_i386", "win32_ntdll", "win32_msvcrt", "win32_user32", "win32_user32_stage1", "win32_gdi32", "win32_advapi32", "win32_shell32", "win32_ole32", "win32_oleaut32", "win32_wintrust", "win32_version", "win32_msimg32", "win32_rpcrt4", "win32_uiautomationcore", "win32_wininet", "win32_crypt32", "dx_d3d11", "dx_d3d11_stage1", "dx_d3d12", "dx_d3d12_stage1", "dx_d3d12_stage2", "win32_winsock", "win32_winsock_stage1", "oss_validate", "battlenet_bypass", "d2r_launch", "d4_launch"]
    let i = 0
    let fail = 0
    while i < len(mods) {
        let m = mods[i]
        let out = exec(cmd + " run lib/loader/" + m + ".hexa self-test 2>&1")
        if !out.contains("✅") {
            if !out.contains("PASS") { fail = fail + 1 }
        }
        i = i + 1
    }
    if fail == 0 { t_pass("loader self-test ALL PASS (Phase 0a~10 + stage1 ×8 + 11 new DLL + i386 ABI, 40/40)") }
    else { t_fail("loader", to_string(fail) + " modules FAIL") }
}

// 7. closure status check — ✅ PASS line + closure status
fn test_closure() -> void {
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    let out = exec(cmd + " run tests/test_closure.hexa 2>&1 | grep -E '✅|PASS|status' | tail -1").trim()
    if out == "" {
        t_fail("closure validation", "no PASS line"); return
    }
    if out.contains("PASS") {
        // closure status 추출
        let status = exec(cmd + " run tests/test_closure.hexa status 2>&1 | tail -1").trim()
        t_pass("closure validation harness PASS — " + status)
    } else {
        t_fail("closure validation", out)
    }
}

// 7. dropped subcommands return non-zero (own 1)
fn test_deprecated_subcommands() -> void {
    let subs = ["launch", "prefix", "recommend", "backend"]
    let i = 0
    let fail = 0
    while i < len(subs) {
        let s = subs[i]
        let out = exec("./entry " + s + " 2>&1; echo __exit:$?").trim()
        let rc_str = exec("printf '%s' '" + out + "' | grep -oE '__exit:[0-9]+' | tail -1 | cut -d: -f2").trim()
        if rc_str == "0" {
            fail = fail + 1
        }
        i = i + 1
    }
    if fail == 0 { t_pass("deprecated subcommands (launch/prefix/recommend/backend) all fail") }
    else { t_fail("deprecated", "some still return 0") }
}

fn main() -> void {
    println("gamebox unified self-test (own 1, hexa-only)")
    test_manifest()
    test_entry()
    test_own1()
    test_own2()
    test_r0()
    test_perf()
    test_loader()
    test_closure()
    test_deprecated_subcommands()
    println("")
    println("pass=" + to_string(PASS) + " fail=" + to_string(FAIL))
    if FAIL != 0 {
        panic("unified test FAIL=" + to_string(FAIL))
    }
}
