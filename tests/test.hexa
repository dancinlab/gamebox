// tests/test.hexa — gamebox unified self-test (raw#9 hexa-only)

use "../lib/perf/r0_common"

let mut PASS = 0
let mut FAIL = 0

fn t_pass(label: str) -> void { PASS = PASS + 1; println("  PASS " + label) }
fn t_fail(label: str, msg: str) -> void { FAIL = FAIL + 1; println("  FAIL " + label + ": " + msg) }

// 1. plugin.json — grep 기반 검증 (docker 안 jq 부재 환경에서도 작동)
fn test_manifest() -> void {
    let f = "plugin.json"
    let exists = exec("test -f '" + f + "' && echo ok").trim()
    if exists != "ok" { t_fail("manifest", "plugin.json missing"); return }
    // 핵심 필드 grep — 정확한 raw text 매칭
    let has_name = exec("grep -c '\"name\":[[:space:]]*\"gamebox\"' '" + f + "'").trim()
    let has_os = exec("grep -c '\"os\":[[:space:]]*\"darwin\"' '" + f + "'").trim()
    let has_arch = exec("grep -c '\"arch\":[[:space:]]*\"arm64\"' '" + f + "'").trim()
    let has_ver = exec("grep -c '\"version\"' '" + f + "'").trim()
    if has_name != "1" { t_fail("manifest", "name field missing/wrong"); return }
    if has_os != "1"   { t_fail("manifest", "os != darwin"); return }
    if has_arch != "1" { t_fail("manifest", "arch != arm64"); return }
    if has_ver != "1"  { t_fail("manifest", "version field missing"); return }
    let ver = exec("grep -oE '\"version\":[[:space:]]*\"[^\"]*\"' '" + f + "' | head -1 | sed 's/.*\"version\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/'").trim()
    t_pass("manifest valid (gamebox " + ver + ")")
}

// 2. entry executable + shebang check (sh-only env 친화)
fn test_entry() -> void {
    let exists = exec("test -x entry && echo ok").trim()
    if exists != "ok" { t_fail("entry", "not executable"); return }
    // shebang 만 확인 (#!/usr/bin/env bash). docker runner 에 bash 없을 수 있으나 entry shim 자체는 valid.
    let shebang = exec("head -1 entry").trim()
    if !shebang.contains("bash") {
        t_fail("entry", "shebang not bash: " + shebang); return
    }
    t_pass("entry valid + executable + bash shebang")
}

// 3. own 1 enforcement (test_apple_only.hexa) — grep 'pass='
fn test_own1() -> void {
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    let out = exec(cmd + " run tests/test_apple_only.hexa 2>&1 | grep -E '^pass=' | tail -1").trim()
    if out == "" {
        t_fail("own 1 enforcement", "no pass= line in output"); return
    }
    if out.contains("fail=0") {
        t_pass("own 1 enforcement (test_apple_only.hexa: " + out + ")")
    } else {
        t_fail("own 1 enforcement", out)
    }
}

// 3b. own 2 enforcement (test_own2.hexa)
fn test_own2() -> void {
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    let out = exec(cmd + " run tests/test_own2.hexa 2>&1 | grep -E '^pass=' | tail -1").trim()
    if out == "" {
        t_fail("own 2 enforcement", "no pass= line"); return
    }
    if out.contains("fail=0") {
        t_pass("own 2 enforcement (test_own2.hexa: " + out + ")")
    } else {
        t_fail("own 2 enforcement", out)
    }
}

// 4. R0 (M0)
fn test_r0() -> void {
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    let mods = ["r0_common", "r0_hud_parser", "r0_cache_watch", "r0_heap_sample", "r0_session"]
    let i = 0
    let fail = 0
    while i < len(mods) {
        let m = mods[i]
        let out = exec(cmd + " run lib/perf/" + m + ".hexa self-test 2>&1")
        if !out.contains("✅") {
            if !out.contains("PASS") { fail = fail + 1 }
        }
        i = i + 1
    }
    if fail == 0 { t_pass("r0 self-test ALL PASS (M0, 5/5)") }
    else { t_fail("r0", to_string(fail) + " modules FAIL") }
}

