// tests/test_roadmap_op_self_impl.hexa — Track-I + Track-M + Track-AB + Track-AE harness (own1 + own2, hexa-only)
//
// Drives `tool/roadmap_op.hexa` against a synthetic temp `.roadmap.<name>` fixture
// (NEVER any production .roadmap.* file). Track-I covers S1-S5 (5 subcmd minimum-viable);
// Track-M extends additively with S6-S11 covering the 6 deferred subcmd to reach full
// 11/11 anima parity. Track-AB cycle 1 of 3 extends additively with S12-S14 covering
// the 3 NEW checkpoint subcmd (checkpoint-status / checkpoint-list / checkpoint-verify)
// over synthetic `.checkpoint.<name>` SSOT fixtures. Track-AE extends additively with
// S15-S17 covering the phase 2 weighted_threshold aggregation rule extension
// (synthetic .checkpoint with aggregation="weighted_threshold" + per-cond_ref weight
// + threshold_value; assert met/partial/unmet derivation + unknown-aggregation
// AND fallback path with stderr warning).
//
// Coverage matrix (subcmd × scenario):
//   S1  add           — append evidence row to cond.1; verify next show reflects.
//   S2  update        — cond status partial→met (forward, ok); met→partial (refused without --force);
//                       blocker status_enum_adopted=retired_intentional (str-typed set).
//   S3  list          — synthetic fixture detected via `cd <tmp> && ls -1 .roadmap.*`.
//   S4  show          — header summary (name + kind + cond/blocker counts).
//   S5  verify        — clean fixture PASSes; injected drift fixture (status_enum_adopted=true bool)
//                       FAILs with explicit issue text (Track-G first-priority validator regression).
//   S6  edit-blocker  — synthetic blocker.status field update; refuse invalid enum (Track-M).
//   S7  promote-met   — verifier guard PASS path (sufficient evidence + verifier_path) + FAIL paths
//                       (insufficient evidence / missing verifier_path) (Track-M).
//   S8  dump-evidence — tsv / json / md format outputs (Track-M).
//   S9  diff          — synthetic 2-roadmap fixture diff matrix (Track-M).
//   S10 migrate       — NO-OP guard always FAIL emit per repo policy migration:forbidden (Track-M).
//   S11 archive       — retired_intentional fixture passes (freeze marker emitted);
//                       non-retired_intentional fixture fails (Track-M).
//   S12 checkpoint-status — synthetic .checkpoint + 2 synthetic .roadmap fixtures;
//                       both refs met → checkpoint status=met; one ref unmet → status=unmet (Track-AB).
//   S13 checkpoint-list — synthetic 2 .checkpoint files in temp dir; assert count=2 emit (Track-AB).
//   S14 checkpoint-verify — synthetic clean fixture passes; injected drift fixture
//                       (cond_ref.required="frobnicate" not in enum) FAILs explicitly (Track-AB).
//   S15 weighted_threshold met — synthetic .checkpoint with aggregation="weighted_threshold",
//                       threshold_value=50, 2 cond_refs each weight=30, both met → sum=60 ≥ 50 → status=met (Track-AE).
//   S16 weighted_threshold partial — synthetic .checkpoint with aggregation="weighted_threshold",
//                       threshold_value=50, 2 cond_refs (one weight=20 met, one weight=20 unmet) → sum=20 < 50, > 0 → status=partial (Track-AE).
//   S17 weighted_threshold unknown aggregation fallback — synthetic .checkpoint with
//                       aggregation="frobnicate" (unknown kind) → AND_all_required_met fallback path engaged with explicit
//                       stderr warning emit + table line announces fallback (Track-AE).
//
// own 1 enforcement: hexa-only, no Wine/CrossOver/Whisky/GPTK, no anima clone/import/symlink.
// own 2 mandate:
//   - r0_emit ≥ 14 (S1..S17 + done sentinels)
//   - fn self_test() + main() dispatch
//   - headless (filesystem stat + exec child + grep, GUI / dialog / interactive 0)
//   - panic("test_roadmap_op_self_impl FAIL [<sub>] expected=X got=Y") 형식

use "../lib/perf/r0_common"

// ─── tool path resolution + CLI presence ────────────────────────────

fn tool_path() -> str {
    return "tool/roadmap_op.hexa"
}

fn hexa_cli_path() -> str {
    return exec("command -v hexa 2>/dev/null").trim()
}

// run tool subcmd via hexa CLI (live mode); on CLI absent, return "".
fn run_tool(args_line: str) -> str {
    let cli = hexa_cli_path()
    if cli == "" { return "" }
    if !exec("test -f '" + tool_path() + "' && echo y || echo n").trim().contains("y") {
        return ""
    }
    return exec(cli + " run " + tool_path() + " " + args_line + " 2>&1")
}

// grep-based skeleton-validate fallback — checks tool source contains expected emit string.
fn grep_emit(marker: str) -> int {
    let g = exec("grep -c '" + marker + "' " + tool_path()).trim()
    if g == "0" || g == "" { return 1 }
    return 0
}

// ─── synthetic fixture under temp dir ────────────────────────────────

fn make_fixture_dir() -> str {
    let stamp = exec("date +%s").trim()
    let dir = "/tmp/test_roadmap_op_self_impl." + stamp
    let _ = exec("mkdir -p '" + dir + "'")
    return dir
}

fn write_fixture(dir: str, name: str) -> str {
    let path = dir + "/.roadmap." + name
    let mut content = ""
    content = content + "# .roadmap." + name + " mk2 — synthetic test fixture (test_roadmap_op_self_impl)\n"
    content = content + "# Header on next line; entries follow.\n"
    content = content + "# Reflects own1 (hexa-only) + own2 (honest emit).\n"
    content = content + "# Status enum: unmet | partial | met | retired_intentional\n"
    content = content + "{\"type\":\"header\",\"kind\":\"game\",\"name\":\"" + name + "\",\"mk\":2,"
    content = content + "\"required_conditions\":["
    content = content + "{\"id\":\"" + name + ".cond.1\",\"desc\":\"synth-cond-1\",\"status\":\"partial\",\"evidence\":[\"e0\"]},"
    content = content + "{\"id\":\"" + name + ".cond.2\",\"desc\":\"synth-cond-2\",\"status\":\"unmet\",\"evidence\":[]}"
    content = content + "],"
    content = content + "\"blockers\":["
    content = content + "{\"id\":\"" + name + ".blk.1\",\"desc\":\"synth-blk-1\",\"status\":\"open\"}"
    content = content + "],"
    content = content + "\"cross_link\":{\"sister_roadmaps\":[]}}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

fn write_drift_fixture(dir: str, name: str) -> str {
    let path = dir + "/.roadmap." + name + "_drift"
    let mut content = ""
    content = content + "# drift fixture (status_enum_adopted=true bool — Track-G simulated drift)\n"
    content = content + "# header on next line\n"
    content = content + "# raw 12 silent_error_ban — drift must FAIL verify\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"game\",\"name\":\"" + name + "_drift\",\"mk\":2,"
    content = content + "\"required_conditions\":[{\"id\":\"" + name + "_drift.cond.1\",\"desc\":\"d\",\"status\":\"partial\",\"evidence\":[]}],"
    content = content + "\"blockers\":[{\"id\":\"" + name + "_drift.blk.1\",\"desc\":\"d\",\"status\":\"open\",\"status_enum_adopted\":true}],"
    content = content + "\"cross_link\":{}}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// ─── S1 add — append evidence row to cond.1, verify show reflects ────

fn check_s1_add(path: str, name: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        // schema-only PASS posture (predecessor cycle posture, hexa CLI build absent)
        if grep_emit("__ROADMAP_OP__ PASS add") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_add") != 0 { fail = fail + 1 }
        return fail
    }
    let out = run_tool("add --roadmap '" + path + "' --cond '" + name + ".cond.1' --evidence 's1_evidence_row'")
    if !out.contains("__ROADMAP_OP__ PASS add") { fail = fail + 1 }
    let after = exec("cat '" + path + "'")
    if !after.contains("s1_evidence_row") { fail = fail + 1 }
    return fail
}

// ─── S2 update — forward, downgrade-refused, blocker adopted ─────────

fn check_s2_update(path: str, name: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS update") != 0 { fail = fail + 1 }
        if grep_emit("status_downgrade_refused") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_update") != 0 { fail = fail + 1 }
        return fail
    }
    // S2a — cond.2 unmet → met (forward)
    let outA = run_tool("update --roadmap '" + path + "' --cond '" + name + ".cond.2' --status met")
    if !outA.contains("__ROADMAP_OP__ PASS update") { fail = fail + 1 }
    // S2b — cond.2 met → partial without --force (must FAIL)
    let outB = run_tool("update --roadmap '" + path + "' --cond '" + name + ".cond.2' --status partial")
    if !outB.contains("status_downgrade_refused") { fail = fail + 1 }
    // S2c — blocker.1 status_enum_adopted=retired_intentional (string-typed)
    let outC = run_tool("update --roadmap '" + path + "' --blocker '" + name + ".blk.1' --status_enum_adopted retired_intentional")
    if !outC.contains("__ROADMAP_OP__ PASS update") { fail = fail + 1 }
    let after = exec("cat '" + path + "'")
    if !after.contains("\"status_enum_adopted\":\"retired_intentional\"") { fail = fail + 1 }
    return fail
}

// ─── S3 list — synthetic fixture detected (cd into tmp_dir for ls scope) ─

fn check_s3_list(dir: str, name: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS list") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_list") != 0 { fail = fail + 1 }
        return fail
    }
    // Tool resolves cwd via `ls .roadmap.*` — invoke from tmp dir.
    let out = exec("cd '" + dir + "' && " + cli + " run " + exec("pwd").trim() + "/" + tool_path() + " list 2>&1")
    if !out.contains("__ROADMAP_OP__ PASS list") { fail = fail + 1 }
    if !out.contains(".roadmap." + name) { fail = fail + 1 }
    return fail
}

// ─── S4 show — header summary correct ─────────────────────────────────

fn check_s4_show(path: str, name: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS show") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_show") != 0 { fail = fail + 1 }
        return fail
    }
    let out = run_tool("show --roadmap '" + path + "'")
    if !out.contains("__ROADMAP_OP__ PASS show") { fail = fail + 1 }
    if !out.contains("name: " + name) { fail = fail + 1 }
    if !out.contains("kind: game") { fail = fail + 1 }
    if !out.contains("conds: 2") { fail = fail + 1 }
    if !out.contains("blockers: 1") { fail = fail + 1 }
    return fail
}

// ─── S5 verify — clean PASS + drift FAIL (Track-G first-priority validator) ─

fn check_s5_verify(path_clean: str, path_drift: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS verify") != 0 { fail = fail + 1 }
        if grep_emit("status_enum_adopted_bool_drift_true") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_verify") != 0 { fail = fail + 1 }
        return fail
    }
    let outClean = run_tool("verify --roadmap '" + path_clean + "'")
    if !outClean.contains("__ROADMAP_OP__ PASS verify") { fail = fail + 1 }
    let outDrift = run_tool("verify --roadmap '" + path_drift + "'")
    if !outDrift.contains("__ROADMAP_OP__ FAIL verify") { fail = fail + 1 }
    if !outDrift.contains("status_enum_adopted_bool_drift_true") { fail = fail + 1 }
    return fail
}

// ─── Track-M cycle-2: S6-S11 fixtures + check fns ─────────────────────

// promote-met fixture: cond with >=3 evidence + verifier_path; another cond with insufficient evidence;
// another cond with sufficient evidence but no verifier_path. blocker.1 starts open.
fn write_pm_fixture(dir: str, name: str) -> str {
    let path = dir + "/.roadmap." + name + "_pm"
    let mut content = ""
    content = content + "# .roadmap." + name + "_pm mk2 — promote-met fixture (Track-M S7)\n"
    content = content + "# Header on next line.\n"
    content = content + "# 3 conds: cond.1 (3 ev + verifier), cond.2 (1 ev + verifier), cond.3 (3 ev no verifier).\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"game\",\"name\":\"" + name + "_pm\",\"mk\":2,"
    content = content + "\"required_conditions\":["
    content = content + "{\"id\":\"" + name + "_pm.cond.1\",\"desc\":\"sufficient_with_verifier\",\"status\":\"partial\",\"evidence\":[\"e1\",\"e2\",\"e3\"],\"verifier_path\":\"tests/test_dummy_verifier.hexa\"},"
    content = content + "{\"id\":\"" + name + "_pm.cond.2\",\"desc\":\"insufficient_evidence\",\"status\":\"partial\",\"evidence\":[\"only_one\"],\"verifier_path\":\"tests/test_dummy_verifier.hexa\"},"
    content = content + "{\"id\":\"" + name + "_pm.cond.3\",\"desc\":\"sufficient_no_verifier\",\"status\":\"partial\",\"evidence\":[\"e1\",\"e2\",\"e3\"]}"
    content = content + "],"
    content = content + "\"blockers\":["
    content = content + "{\"id\":\"" + name + "_pm.blk.1\",\"desc\":\"pm-blk-1\",\"status\":\"open\"}"
    content = content + "],"
    content = content + "\"cross_link\":{}}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// archive FAIL fixture: blk.1 carries status_enum_adopted=acknowledged (NOT retired_intentional).
//   Required because S2c mutates the base `path` fixture to set
//   status_enum_adopted=retired_intentional, so the base fixture cannot be
//   re-used as the FAIL-branch input for S11.
fn write_archive_fail_fixture(dir: str, name: str) -> str {
    let path = dir + "/.roadmap." + name + "_arch_fail"
    let mut content = ""
    content = content + "# .roadmap." + name + "_arch_fail mk2 — archive FAIL fixture (Track-M S11)\n"
    content = content + "# Header on next line.\n"
    content = content + "# blk.1 carries status_enum_adopted=acknowledged (str-typed, NOT retired_intentional).\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"game\",\"name\":\"" + name + "_arch_fail\",\"mk\":2,"
    content = content + "\"required_conditions\":[{\"id\":\"" + name + "_arch_fail.cond.1\",\"desc\":\"a\",\"status\":\"partial\",\"evidence\":[]}],"
    content = content + "\"blockers\":[{\"id\":\"" + name + "_arch_fail.blk.1\",\"desc\":\"a\",\"status\":\"open\",\"status_enum_adopted\":\"acknowledged\"}],"
    content = content + "\"cross_link\":{}}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// archive PASS fixture: blk.1 already has status_enum_adopted=retired_intentional (str-typed).
fn write_archive_pass_fixture(dir: str, name: str) -> str {
    let path = dir + "/.roadmap." + name + "_arch"
    let mut content = ""
    content = content + "# .roadmap." + name + "_arch mk2 — archive PASS fixture (Track-M S11)\n"
    content = content + "# Header on next line.\n"
    content = content + "# blk.1 carries status_enum_adopted=retired_intentional (str-typed).\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"game\",\"name\":\"" + name + "_arch\",\"mk\":2,"
    content = content + "\"required_conditions\":[{\"id\":\"" + name + "_arch.cond.1\",\"desc\":\"a\",\"status\":\"retired_intentional\",\"evidence\":[]}],"
    content = content + "\"blockers\":[{\"id\":\"" + name + "_arch.blk.1\",\"desc\":\"a\",\"status\":\"acknowledged\",\"status_enum_adopted\":\"retired_intentional\"}],"
    content = content + "\"cross_link\":{}}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// diff B-fixture: same name root but with one extra evidence entry on cond.1 + cond.2 status met instead of unmet.
fn write_diff_b_fixture(dir: str, name: str) -> str {
    let path = dir + "/.roadmap." + name + "_b"
    let mut content = ""
    content = content + "# .roadmap." + name + "_b mk2 — diff B fixture (Track-M S9)\n"
    content = content + "# Header on next line.\n"
    content = content + "# differs from base fixture: cond.2 status met, cond.1 evidence +1.\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"game\",\"name\":\"" + name + "_b\",\"mk\":2,"
    content = content + "\"required_conditions\":["
    content = content + "{\"id\":\"" + name + "_b.cond.1\",\"desc\":\"diff-cond-1\",\"status\":\"partial\",\"evidence\":[\"e0\",\"e1\"]},"
    content = content + "{\"id\":\"" + name + "_b.cond.2\",\"desc\":\"diff-cond-2\",\"status\":\"met\",\"evidence\":[\"e0\"]}"
    content = content + "],"
    content = content + "\"blockers\":["
    content = content + "{\"id\":\"" + name + "_b.blk.1\",\"desc\":\"diff-blk-1\",\"status\":\"closed\"}"
    content = content + "],"
    content = content + "\"cross_link\":{}}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// ─── S6 edit-blocker — single-field update + invalid enum refusal ─────

fn check_s6_edit_blocker(path: str, name: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS edit-blocker") != 0 { fail = fail + 1 }
        if grep_emit("blocker_status_enum_invalid") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_edit_blocker") != 0 { fail = fail + 1 }
        return fail
    }
    // S6a — set blocker.1 status open → closed (valid enum).
    let outA = run_tool("edit-blocker --roadmap '" + path + "' --blocker '" + name + ".blk.1' --status closed")
    if !outA.contains("__ROADMAP_OP__ PASS edit-blocker") { fail = fail + 1 }
    let after = exec("cat '" + path + "'")
    if !after.contains("\"status\":\"closed\"") { fail = fail + 1 }
    // S6b — refuse invalid enum.
    let outB = run_tool("edit-blocker --roadmap '" + path + "' --blocker '" + name + ".blk.1' --status nonsense_value")
    if !outB.contains("blocker_status_enum_invalid") { fail = fail + 1 }
    // S6c — set resolution_path field.
    let outC = run_tool("edit-blocker --roadmap '" + path + "' --blocker '" + name + ".blk.1' --resolution_path 'see_handoff_doc'")
    if !outC.contains("__ROADMAP_OP__ PASS edit-blocker") { fail = fail + 1 }
    let after2 = exec("cat '" + path + "'")
    if !after2.contains("\"resolution_path\":\"see_handoff_doc\"") { fail = fail + 1 }
    return fail
}

// ─── S7 promote-met — guard PASS + FAIL paths ─────────────────────────

fn check_s7_promote_met(pm_path: str, pm_name: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS promote-met") != 0 { fail = fail + 1 }
        if grep_emit("insufficient_evidence") != 0 { fail = fail + 1 }
        if grep_emit("verifier_path_missing_in_cond") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_promote_met") != 0 { fail = fail + 1 }
        return fail
    }
    // S7a — cond.1 (3 ev + verifier_path) PASS.
    let outA = run_tool("promote-met --roadmap '" + pm_path + "' --cond '" + pm_name + "_pm.cond.1'")
    if !outA.contains("__ROADMAP_OP__ PASS promote-met") { fail = fail + 1 }
    if !outA.contains("would-exec") { fail = fail + 1 }
    // S7b — cond.2 (1 ev) FAIL insufficient_evidence.
    let outB = run_tool("promote-met --roadmap '" + pm_path + "' --cond '" + pm_name + "_pm.cond.2'")
    if !outB.contains("insufficient_evidence") { fail = fail + 1 }
    // S7c — cond.3 (3 ev no verifier) FAIL verifier_path_missing.
    let outC = run_tool("promote-met --roadmap '" + pm_path + "' --cond '" + pm_name + "_pm.cond.3'")
    if !outC.contains("verifier_path_missing_in_cond") { fail = fail + 1 }
    return fail
}

// ─── S8 dump-evidence — 3 format outputs ──────────────────────────────

fn check_s8_dump_evidence(path: str, name: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS dump-evidence") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_dump_evidence") != 0 { fail = fail + 1 }
        return fail
    }
    let outT = run_tool("dump-evidence --roadmap '" + path + "' --cond '" + name + ".cond.1' --format tsv")
    if !outT.contains("__ROADMAP_OP__ PASS dump-evidence") { fail = fail + 1 }
    if !outT.contains("format=tsv") { fail = fail + 1 }
    let outJ = run_tool("dump-evidence --roadmap '" + path + "' --cond '" + name + ".cond.1' --format json")
    if !outJ.contains("__ROADMAP_OP__ PASS dump-evidence") { fail = fail + 1 }
    if !outJ.contains("format=json") { fail = fail + 1 }
    if !outJ.contains("\"evidence\":[") { fail = fail + 1 }
    let outM = run_tool("dump-evidence --roadmap '" + path + "' --cond '" + name + ".cond.1' --format md")
    if !outM.contains("__ROADMAP_OP__ PASS dump-evidence") { fail = fail + 1 }
    if !outM.contains("format=md") { fail = fail + 1 }
    return fail
}

// ─── S9 diff — 2-roadmap delta matrix ─────────────────────────────────

fn check_s9_diff(path_a: str, path_b: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS diff") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_diff") != 0 { fail = fail + 1 }
        return fail
    }
    let out = run_tool("diff --roadmap-a '" + path_a + "' --roadmap-b '" + path_b + "'")
    if !out.contains("__ROADMAP_OP__ PASS diff") { fail = fail + 1 }
    if !out.contains("conds\t") { fail = fail + 1 }
    if !out.contains("blockers\t") { fail = fail + 1 }
    return fail
}

// ─── S10 migrate — NO-OP guard always FAIL ────────────────────────────

fn check_s10_migrate(path: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("migration_forbidden_per_repo_policy") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_migrate") != 0 { fail = fail + 1 }
        return fail
    }
    let out = run_tool("migrate --roadmap '" + path + "' --from mk1 --to mk2")
    if !out.contains("__ROADMAP_OP__ FAIL migrate migration_forbidden_per_repo_policy") { fail = fail + 1 }
    return fail
}

// ─── S11 archive — retired_intentional PASS + non-retired FAIL ────────

fn check_s11_archive(path_pass: str, path_fail: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS archive") != 0 { fail = fail + 1 }
        if grep_emit("blk_1_not_retired_intentional") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_archive") != 0 { fail = fail + 1 }
        return fail
    }
    let outA = run_tool("archive --roadmap '" + path_pass + "'")
    if !outA.contains("__ROADMAP_OP__ PASS archive") { fail = fail + 1 }
    if !outA.contains("freeze_marker_emit") { fail = fail + 1 }
    let outB = run_tool("archive --roadmap '" + path_fail + "'")
    if !outB.contains("__ROADMAP_OP__ FAIL archive") { fail = fail + 1 }
    if !outB.contains("blk_1_not_retired_intentional") { fail = fail + 1 }
    return fail
}

// ─── Track-AB cycle-1: S12-S14 checkpoint subcmd fixtures + check fns ─

// Write a synthetic .roadmap.<name> fixture into `dir` with a single cond
// of the given `cond_status`. Returns the full path.
fn write_synth_roadmap_for_cp(dir: str, name: str, cond_status: str) -> str {
    let path = dir + "/.roadmap." + name
    let mut content = ""
    content = content + "# .roadmap." + name + " mk2 — checkpoint synth roadmap (Track-AB S12)\n"
    content = content + "# Header on next line.\n"
    content = content + "# cond.1 status=" + cond_status + " baseline.\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"game\",\"name\":\"" + name + "\",\"mk\":2,"
    content = content + "\"required_conditions\":["
    content = content + "{\"id\":\"" + name + ".cond.1\",\"desc\":\"cp-synth-cond-1\",\"status\":\"" + cond_status + "\",\"evidence\":[]}"
    content = content + "],"
    content = content + "\"blockers\":[],"
    content = content + "\"cross_link\":{}}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// Write a synthetic clean .checkpoint.<name> fixture referencing 2 .roadmap.<X>
// targets via cond_refs[]. Both refs require="met". status field starts unmet
// (cached value; subcmd_checkpoint_status derives the live value).
fn write_clean_checkpoint_fixture(dir: str, cp_name: str, road_a: str, road_b: str, cached_status: str) -> str {
    let path = dir + "/.checkpoint." + cp_name
    let mut content = ""
    content = content + "# .checkpoint." + cp_name + " mk2 — Track-AB synth checkpoint fixture\n"
    content = content + "# Header on next line.\n"
    content = content + "# cond_refs aggregation = AND_all_required_met (Track-AA D1=b cross-roadmap)\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"checkpoint\",\"name\":\"" + cp_name + "\",\"mk\":2,"
    content = content + "\"status\":\"" + cached_status + "\","
    content = content + "\"aggregation\":\"AND_all_required_met\","
    content = content + "\"cond_refs\":["
    content = content + "{\"roadmap\":\"" + road_a + "\",\"cond\":\"cp_road_a.cond.1\",\"required\":\"met\"},"
    content = content + "{\"roadmap\":\"" + road_b + "\",\"cond\":\"cp_road_b.cond.1\",\"required\":\"met\"}"
    content = content + "]}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// Write a synthetic checkpoint with a drift cond_ref.required="frobnicate" (not in enum).
fn write_drift_checkpoint_fixture(dir: str, cp_name: str, road_a: str) -> str {
    let path = dir + "/.checkpoint." + cp_name
    let mut content = ""
    content = content + "# .checkpoint." + cp_name + " mk2 — Track-AB drift checkpoint fixture\n"
    content = content + "# header on next line\n"
    content = content + "# cond_ref.required=frobnicate (not in cond enum) — must FAIL verify\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"checkpoint\",\"name\":\"" + cp_name + "\",\"mk\":2,"
    content = content + "\"status\":\"unmet\","
    content = content + "\"aggregation\":\"AND_all_required_met\","
    content = content + "\"cond_refs\":["
    content = content + "{\"roadmap\":\"" + road_a + "\",\"cond\":\"cp_road_a.cond.1\",\"required\":\"frobnicate\"}"
    content = content + "]}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// ─── S12 checkpoint-status — both met → met / one unmet → unmet ───────

fn check_s12_checkpoint_status(dir: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS checkpoint-status") != 0 { fail = fail + 1 }
        if grep_emit("__ROADMAP_OP__ FAIL checkpoint-status") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_checkpoint_status") != 0 { fail = fail + 1 }
        return fail
    }
    // Build 2 .roadmap fixtures (a met, b met), and a checkpoint referencing both.
    // Tool resolves cwd via repo-relative `.roadmap.*` lookups; checkpoint-status
    // takes a path arg and reads cond_refs roadmap field — so we pass the explicit
    // path and craft cond_refs to point to absolute paths within tmp dir.
    let road_a = write_synth_roadmap_for_cp(dir, "cp_road_a", "met")
    let road_b_met = write_synth_roadmap_for_cp(dir, "cp_road_b", "met")
    let cp_path_pass = write_clean_checkpoint_fixture(dir, "cp_pass", road_a, road_b_met, "unmet")
    let outA = exec(cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-status --checkpoint '" + cp_path_pass + "' 2>&1")
    if !outA.contains("__ROADMAP_OP__ PASS checkpoint-status") { fail = fail + 1 }
    if !outA.contains("status=met") { fail = fail + 1 }
    // Now flip road_b cond status to unmet — overwrite fixture with unmet.
    let road_b_unmet = write_synth_roadmap_for_cp(dir, "cp_road_b", "unmet")
    let _unused = road_b_unmet
    let cp_path_fail = write_clean_checkpoint_fixture(dir, "cp_fail", road_a, road_b_unmet, "unmet")
    let outB = exec(cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-status --checkpoint '" + cp_path_fail + "' 2>&1")
    if !outB.contains("__ROADMAP_OP__ FAIL checkpoint-status") { fail = fail + 1 }
    if !outB.contains("status=unmet") { fail = fail + 1 }
    return fail
}

// ─── S13 checkpoint-list — count=2 in synth dir ───────────────────────

fn check_s13_checkpoint_list(dir: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS checkpoint-list") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_checkpoint_list") != 0 { fail = fail + 1 }
        if grep_emit("no checkpoints found") != 0 { fail = fail + 1 }
        return fail
    }
    // Tool's list_checkpoints_dir uses `ls .checkpoint.*` (cwd-scoped) — invoke
    // from the synth tmp dir. The dir already has cp_pass + cp_fail from S12 fixtures.
    let out = exec("cd '" + dir + "' && " + cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-list 2>&1")
    if !out.contains("__ROADMAP_OP__ PASS checkpoint-list") { fail = fail + 1 }
    // Count assertion: at least 2 .checkpoint.* fixtures present.
    if !out.contains("count=2") && !out.contains("count=3") && !out.contains("count=4") { fail = fail + 1 }
    return fail
}

// ─── S14 checkpoint-verify — clean PASS + drift FAIL ──────────────────

fn check_s14_checkpoint_verify(dir: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("__ROADMAP_OP__ PASS checkpoint-verify") != 0 { fail = fail + 1 }
        if grep_emit("required_enum_invalid") != 0 { fail = fail + 1 }
        if grep_emit("subcmd_checkpoint_verify") != 0 { fail = fail + 1 }
        return fail
    }
    // Clean fixture (re-uses S12 cp_pass — already present in dir).
    let cp_path_clean = dir + "/.checkpoint.cp_pass"
    let outClean = exec(cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-verify --checkpoint '" + cp_path_clean + "' 2>&1")
    if !outClean.contains("__ROADMAP_OP__ PASS checkpoint-verify") { fail = fail + 1 }
    // Drift fixture — cond_ref.required="frobnicate".
    let road_a = dir + "/.roadmap.cp_road_a"
    let cp_path_drift = write_drift_checkpoint_fixture(dir, "cp_drift", road_a)
    let outDrift = exec(cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-verify --checkpoint '" + cp_path_drift + "' 2>&1")
    if !outDrift.contains("__ROADMAP_OP__ FAIL checkpoint-verify") { fail = fail + 1 }
    if !outDrift.contains("required_enum_invalid") { fail = fail + 1 }
    return fail
}

// ─── Track-AE phase 2: S15-S17 weighted_threshold aggregation fixtures + check fns ─

// Write a weighted_threshold .checkpoint.<name> fixture with 2 cond_refs (each
// referencing a synth roadmap), per-ref `weight` and header threshold_value.
// `cp_name` becomes the .checkpoint.<cp_name> filename; `road_a` / `road_b` are
// already-written synthetic roadmaps (reuse write_synth_roadmap_for_cp helper).
fn write_weighted_checkpoint_fixture(dir: str, cp_name: str, road_a: str, road_b: str,
                                      weight_a: int, weight_b: int, threshold: int) -> str {
    let path = dir + "/.checkpoint." + cp_name
    let mut content = ""
    content = content + "# .checkpoint." + cp_name + " mk2 — Track-AE weighted_threshold synth checkpoint fixture\n"
    content = content + "# Header on next line.\n"
    content = content + "# aggregation = weighted_threshold (Track-AE phase 2 — Track-AB caveat C2 closed)\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"checkpoint\",\"name\":\"" + cp_name + "\",\"mk\":2,"
    content = content + "\"status\":\"unmet\","
    content = content + "\"aggregation\":\"weighted_threshold\","
    content = content + "\"threshold_kind\":\"percentage\","
    content = content + "\"threshold_value\":" + to_string(threshold) + ","
    content = content + "\"progress_metric\":\"weighted_synth\","
    content = content + "\"progress_source\":\"synthetic_test_fixture\","
    content = content + "\"cond_refs\":["
    content = content + "{\"roadmap\":\"" + road_a + "\",\"cond\":\"cp_road_a.cond.1\",\"required\":\"met\",\"weight\":" + to_string(weight_a) + "},"
    content = content + "{\"roadmap\":\"" + road_b + "\",\"cond\":\"cp_road_b.cond.1\",\"required\":\"met\",\"weight\":" + to_string(weight_b) + "}"
    content = content + "]}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// Write an unknown-aggregation .checkpoint.<name> fixture — aggregation="frobnicate".
// Used by S17 to assert AND fallback + stderr warning path (own2 silent_error_ban honest emit).
fn write_unknown_aggregation_checkpoint_fixture(dir: str, cp_name: str, road_a: str, road_b: str) -> str {
    let path = dir + "/.checkpoint." + cp_name
    let mut content = ""
    content = content + "# .checkpoint." + cp_name + " mk2 — Track-AE unknown aggregation drift fixture\n"
    content = content + "# Header on next line.\n"
    content = content + "# aggregation = frobnicate (unknown kind) — must trigger AND fallback + stderr WARN emit\n"
    content = content + "# enum first-priority\n"
    content = content + "{\"type\":\"header\",\"kind\":\"checkpoint\",\"name\":\"" + cp_name + "\",\"mk\":2,"
    content = content + "\"status\":\"unmet\","
    content = content + "\"aggregation\":\"frobnicate\","
    content = content + "\"cond_refs\":["
    content = content + "{\"roadmap\":\"" + road_a + "\",\"cond\":\"cp_road_a.cond.1\",\"required\":\"met\"},"
    content = content + "{\"roadmap\":\"" + road_b + "\",\"cond\":\"cp_road_b.cond.1\",\"required\":\"met\"}"
    content = content + "]}\n"
    let tmp = path + ".tmp"
    write_file(tmp, content)
    let _ = exec("mv '" + tmp + "' '" + path + "'")
    return path
}

// ─── S15 weighted_threshold met — sum ≥ threshold → met ───────────────

fn check_s15_weighted_threshold_met(dir: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("weighted_threshold") != 0 { fail = fail + 1 }
        if grep_emit("checkpoint_aggregate_weighted_threshold") != 0 { fail = fail + 1 }
        if grep_emit("aggregation=weighted_threshold") != 0 { fail = fail + 1 }
        return fail
    }
    // Both refs target met cond.1 (cp_road_a stays met from S12; refresh cp_road_b to met).
    let road_a = write_synth_roadmap_for_cp(dir, "cp_road_a", "met")
    let road_b = write_synth_roadmap_for_cp(dir, "cp_road_b", "met")
    // Each cond_ref weight=30, threshold_value=50 → sum=60 ≥ 50 → met.
    let cp_path = write_weighted_checkpoint_fixture(dir, "cp_wt_met", road_a, road_b, 30, 30, 50)
    let out = exec(cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-status --checkpoint '" + cp_path + "' 2>&1")
    if !out.contains("__ROADMAP_OP__ PASS checkpoint-status") { fail = fail + 1 }
    if !out.contains("status=met") { fail = fail + 1 }
    if !out.contains("aggregation=weighted_threshold") { fail = fail + 1 }
    return fail
}

// ─── S16 weighted_threshold partial — 0 < sum < threshold → partial ───

fn check_s16_weighted_threshold_partial(dir: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("checkpoint_aggregate_weighted_threshold") != 0 { fail = fail + 1 }
        if grep_emit("status=partial") != 0 { fail = fail + 1 }
        return fail
    }
    // road_a met (weight 20), road_b unmet (weight 20). Threshold=50. sum=20 → 0 < 20 < 50 → partial.
    let road_a = write_synth_roadmap_for_cp(dir, "cp_road_a", "met")
    let road_b = write_synth_roadmap_for_cp(dir, "cp_road_b", "unmet")
    let cp_path = write_weighted_checkpoint_fixture(dir, "cp_wt_partial", road_a, road_b, 20, 20, 50)
    let out = exec(cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-status --checkpoint '" + cp_path + "' 2>&1")
    // status=partial → derived != met → emit FAIL (PASS only on derived=met per Track-AB convention).
    if !out.contains("__ROADMAP_OP__ FAIL checkpoint-status") { fail = fail + 1 }
    if !out.contains("status=partial") { fail = fail + 1 }
    if !out.contains("aggregation=weighted_threshold") { fail = fail + 1 }
    return fail
}

// ─── S17 unknown aggregation → AND fallback + stderr warning ──────────

fn check_s17_weighted_threshold_unknown_fallback(dir: str) -> int {
    let mut fail = 0
    let cli = hexa_cli_path()
    if cli == "" {
        if grep_emit("unknown_aggregation_kind") != 0 { fail = fail + 1 }
        if grep_emit("fallback=AND_all_required_met") != 0 { fail = fail + 1 }
        if grep_emit("stderr_warn") != 0 { fail = fail + 1 }
        return fail
    }
    // Both refs met → AND fallback would emit met (all satisfied).
    let road_a = write_synth_roadmap_for_cp(dir, "cp_road_a", "met")
    let road_b = write_synth_roadmap_for_cp(dir, "cp_road_b", "met")
    let cp_path = write_unknown_aggregation_checkpoint_fixture(dir, "cp_wt_unknown", road_a, road_b)
    let out = exec(cli + " run " + exec("pwd").trim() + "/" + tool_path()
        + " checkpoint-status --checkpoint '" + cp_path + "' 2>&1")
    // 1) WARN line emitted (we capture stderr via 2>&1 above).
    if !out.contains("unknown_aggregation_kind:frobnicate") { fail = fail + 1 }
    if !out.contains("fallback=AND_all_required_met") { fail = fail + 1 }
    // 2) Effective aggregation kind is AND (logged in summary line).
    if !out.contains("aggregation=AND_all_required_met") { fail = fail + 1 }
    // 3) Both refs met → AND derivation says met → PASS.
    if !out.contains("__ROADMAP_OP__ PASS checkpoint-status") { fail = fail + 1 }
    return fail
}

// ─── chain status ─────────────────────────────────────────────────────

fn track_ae_chain_status(dir: str) -> str {
    let f15 = check_s15_weighted_threshold_met(dir)
    let f16 = check_s16_weighted_threshold_partial(dir)
    let f17 = check_s17_weighted_threshold_unknown_fallback(dir)
    let total = f15 + f16 + f17
    if total == 0 { return "ready" }
    return "in-progress: s15=" + to_string(f15) + ",s16=" + to_string(f16) + ",s17=" + to_string(f17)
}

fn track_i_chain_status(path: str, dir: str, name: str, drift: str) -> str {
    let f1 = check_s1_add(path, name)
    let f2 = check_s2_update(path, name)
    let f3 = check_s3_list(dir, name)
    let f4 = check_s4_show(path, name)
    let f5 = check_s5_verify(path, drift)
    let total = f1 + f2 + f3 + f4 + f5
    if total == 0 { return "ready" }
    return "in-progress: s1=" + to_string(f1) + ",s2=" + to_string(f2)
        + ",s3=" + to_string(f3) + ",s4=" + to_string(f4) + ",s5=" + to_string(f5)
}

fn track_m_chain_status(path: str, name: str, pm_path: str, pm_name: str, diff_b: str, arch_pass: str, arch_fail: str) -> str {
    let f6 = check_s6_edit_blocker(path, name)
    let f7 = check_s7_promote_met(pm_path, pm_name)
    let f8 = check_s8_dump_evidence(path, name)
    let f9 = check_s9_diff(path, diff_b)
    let f10 = check_s10_migrate(path)
    let f11 = check_s11_archive(arch_pass, arch_fail)
    let total = f6 + f7 + f8 + f9 + f10 + f11
    if total == 0 { return "ready" }
    return "in-progress: s6=" + to_string(f6) + ",s7=" + to_string(f7)
        + ",s8=" + to_string(f8) + ",s9=" + to_string(f9) + ",s10=" + to_string(f10) + ",s11=" + to_string(f11)
}

fn track_ab_chain_status(dir: str) -> str {
    let f12 = check_s12_checkpoint_status(dir)
    let f13 = check_s13_checkpoint_list(dir)
    let f14 = check_s14_checkpoint_verify(dir)
    let total = f12 + f13 + f14
    if total == 0 { return "ready" }
    return "in-progress: s12=" + to_string(f12) + ",s13=" + to_string(f13) + ",s14=" + to_string(f14)
}

// ─── self_test — dispatch S1..S5 in order ─────────────────────────────

fn self_test() -> void {
    let sid = "track-i-roadmap-op-" + exec("date +%s").trim()
    r0_session_set(sid)

    let dir = make_fixture_dir()
    let name = "self_synth"
    let path = write_fixture(dir, name)
    let drift = write_drift_fixture(dir, name)

    // S1 add
    let f1 = check_s1_add(path, name)
    r0_session_set(sid)
    r0_emit("track_i_roadmap_op_S1_add",
        "\"subcmd\":\"add\",\"path\":\"" + path + "\",\"fail\":" + to_string(f1))
    if f1 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S1_add] expected=0 got=" + to_string(f1))
    }

    // S2 update — forward + downgrade-refused + blocker adopted
    let f2 = check_s2_update(path, name)
    r0_session_set(sid)
    r0_emit("track_i_roadmap_op_S2_update",
        "\"subcmd\":\"update\",\"covers\":[\"forward\",\"downgrade_refused\",\"blocker_adopted\"],\"fail\":" + to_string(f2))
    if f2 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S2_update] expected=0 got=" + to_string(f2))
    }

    // S3 list
    let f3 = check_s3_list(dir, name)
    r0_session_set(sid)
    r0_emit("track_i_roadmap_op_S3_list",
        "\"subcmd\":\"list\",\"dir\":\"" + dir + "\",\"fail\":" + to_string(f3))
    if f3 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S3_list] expected=0 got=" + to_string(f3))
    }

    // S4 show
    let f4 = check_s4_show(path, name)
    r0_session_set(sid)
    r0_emit("track_i_roadmap_op_S4_show",
        "\"subcmd\":\"show\",\"path\":\"" + path + "\",\"fail\":" + to_string(f4))
    if f4 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S4_show] expected=0 got=" + to_string(f4))
    }

    // S5 verify (clean PASS + drift FAIL)
    let f5 = check_s5_verify(path, drift)
    r0_session_set(sid)
    r0_emit("track_i_roadmap_op_S5_verify",
        "\"subcmd\":\"verify\",\"covers\":[\"clean_pass\",\"drift_fail\",\"status_enum_adopted_bool_drift_first_priority\"],\"fail\":" + to_string(f5))
    if f5 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S5_verify] expected=0 got=" + to_string(f5))
    }

    // Track-I chain status (S1-S5 only; downstream S6-S11 are Track-M scope, asserted separately).
    let st = track_i_chain_status(path, dir, name, drift)
    if st != "ready" {
        panic("test_roadmap_op_self_impl FAIL [chain_status] expected=ready got=" + st)
    }

    r0_session_set(sid)
    r0_emit("track_i_roadmap_op_done",
        "\"chain\":\"roadmap_op_self_impl_5_subcmd\",\"validator_first_priority\":\"status_enum_adopted_str_only\",\"status\":\"" + st + "\"")

    // ─── Track-M cycle-2 S6-S11 dispatch (additive to Track-I S1-S5) ──
    //
    // Note: S6 mutates blocker.1 status (open → closed → resolution_path set), so it must run
    // after S2/S5 finished referencing the original open status. After S6, blocker.1 status
    // ends as closed which still satisfies BLOCKER_STATUS_ALLOWED (kept clean for S5 retest).

    let pm_path = write_pm_fixture(dir, name)
    let arch_pass_path = write_archive_pass_fixture(dir, name)
    let arch_fail_path = write_archive_fail_fixture(dir, name)
    let diff_b_path = write_diff_b_fixture(dir, name)

    // S6 edit-blocker
    let f6 = check_s6_edit_blocker(path, name)
    r0_session_set(sid)
    r0_emit("track_m_roadmap_op_S6_edit_blocker",
        "\"subcmd\":\"edit-blocker\",\"covers\":[\"status_set\",\"invalid_enum_refused\",\"resolution_path_upsert\"],\"fail\":" + to_string(f6))
    if f6 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S6_edit_blocker] expected=0 got=" + to_string(f6))
    }

    // S7 promote-met
    let f7 = check_s7_promote_met(pm_path, name)
    r0_session_set(sid)
    r0_emit("track_m_roadmap_op_S7_promote_met",
        "\"subcmd\":\"promote-met\",\"covers\":[\"guard_pass\",\"insufficient_evidence_fail\",\"verifier_path_missing_fail\"],\"fail\":" + to_string(f7))
    if f7 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S7_promote_met] expected=0 got=" + to_string(f7))
    }

    // S8 dump-evidence
    let f8 = check_s8_dump_evidence(path, name)
    r0_session_set(sid)
    r0_emit("track_m_roadmap_op_S8_dump_evidence",
        "\"subcmd\":\"dump-evidence\",\"covers\":[\"tsv\",\"json\",\"md\"],\"fail\":" + to_string(f8))
    if f8 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S8_dump_evidence] expected=0 got=" + to_string(f8))
    }

    // S9 diff
    let f9 = check_s9_diff(path, diff_b_path)
    r0_session_set(sid)
    r0_emit("track_m_roadmap_op_S9_diff",
        "\"subcmd\":\"diff\",\"covers\":[\"two_roadmap_delta_matrix\",\"per_status_count_diff\"],\"fail\":" + to_string(f9))
    if f9 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S9_diff] expected=0 got=" + to_string(f9))
    }

    // S10 migrate (NO-OP guard, always FAIL per repo policy migration:forbidden)
    let f10 = check_s10_migrate(path)
    r0_session_set(sid)
    r0_emit("track_m_roadmap_op_S10_migrate",
        "\"subcmd\":\"migrate\",\"covers\":[\"no_op_guard_always_fail\"],\"policy\":\"migration_forbidden\",\"fail\":" + to_string(f10))
    if f10 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S10_migrate] expected=0 got=" + to_string(f10))
    }

    // S11 archive (retired_intentional PASS + non-retired FAIL).
    // path_fail = arch_fail_path (fresh non-retired fixture) — NOT base `path`,
    // because S2c earlier set blocker.1 status_enum_adopted=retired_intentional
    // on the base fixture, which would make archive PASS instead of FAIL.
    let f11 = check_s11_archive(arch_pass_path, arch_fail_path)
    r0_session_set(sid)
    r0_emit("track_m_roadmap_op_S11_archive",
        "\"subcmd\":\"archive\",\"covers\":[\"retired_intentional_freeze_marker_pass\",\"non_retired_fail\"],\"fail\":" + to_string(f11))
    if f11 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S11_archive] expected=0 got=" + to_string(f11))
    }

    // Track-M chain status sanity recheck
    let st_m = track_m_chain_status(path, name, pm_path, name, diff_b_path, arch_pass_path, arch_fail_path)
    if st_m != "ready" {
        panic("test_roadmap_op_self_impl FAIL [track_m_chain_status] expected=ready got=" + st_m)
    }

    r0_session_set(sid)
    r0_emit("track_m_roadmap_op_done",
        "\"chain\":\"roadmap_op_full_11_subcmd_anima_parity\",\"track_i_status\":\"" + st + "\",\"track_m_status\":\"" + st_m + "\"")

    // ─── Track-AB cycle-1 S12-S14 dispatch (additive to Track-I + Track-M) ──
    //
    // S12-S14 cover the 3 NEW checkpoint subcmd. Synthetic fixtures (.roadmap.cp_road_a,
    // .roadmap.cp_road_b, .checkpoint.cp_pass, .checkpoint.cp_fail, .checkpoint.cp_drift)
    // live entirely under `dir` (tmp). NO production .checkpoint.* file is created (Track-AC
    // cycle 2 territory). NO production .roadmap.* file is touched.

    // S12 checkpoint-status
    let f12 = check_s12_checkpoint_status(dir)
    r0_session_set(sid)
    r0_emit("track_ab_roadmap_op_S12_checkpoint_status",
        "\"subcmd\":\"checkpoint-status\",\"covers\":[\"both_met_yields_status_met\",\"one_unmet_yields_status_unmet\"],\"fail\":" + to_string(f12))
    if f12 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S12_checkpoint_status] expected=0 got=" + to_string(f12))
    }

    // S13 checkpoint-list
    let f13 = check_s13_checkpoint_list(dir)
    r0_session_set(sid)
    r0_emit("track_ab_roadmap_op_S13_checkpoint_list",
        "\"subcmd\":\"checkpoint-list\",\"covers\":[\"count_emit_at_least_2\"],\"fail\":" + to_string(f13))
    if f13 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S13_checkpoint_list] expected=0 got=" + to_string(f13))
    }

    // S14 checkpoint-verify (clean PASS + drift required="frobnicate" FAIL)
    let f14 = check_s14_checkpoint_verify(dir)
    r0_session_set(sid)
    r0_emit("track_ab_roadmap_op_S14_checkpoint_verify",
        "\"subcmd\":\"checkpoint-verify\",\"covers\":[\"clean_pass\",\"required_enum_invalid_drift_fail\"],\"fail\":" + to_string(f14))
    if f14 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S14_checkpoint_verify] expected=0 got=" + to_string(f14))
    }

    // Track-AB chain status sanity recheck
    let st_ab = track_ab_chain_status(dir)
    if st_ab != "ready" {
        panic("test_roadmap_op_self_impl FAIL [track_ab_chain_status] expected=ready got=" + st_ab)
    }

    r0_session_set(sid)
    r0_emit("track_ab_roadmap_op_done",
        "\"chain\":\"roadmap_op_checkpoint_subcmd_extension_3_new\",\"track_i_status\":\"" + st + "\",\"track_m_status\":\"" + st_m + "\",\"track_ab_status\":\"" + st_ab + "\"")

    // ─── Track-AE phase 2 S15-S17 dispatch (additive to Track-I + Track-M + Track-AB) ──
    //
    // S15-S17 cover the weighted_threshold aggregation rule extension (phase 2 — Track-AB
    // caveat C2 closed). All fixtures live in the synth tmp dir; no production .checkpoint
    // or .roadmap file is created or modified. The dir already has .roadmap.cp_road_a +
    // .roadmap.cp_road_b from Track-AB S12 fixtures; S15-S17 rewrite/extend them as needed.

    // S15 weighted_threshold met
    let f15 = check_s15_weighted_threshold_met(dir)
    r0_session_set(sid)
    r0_emit("track_ae_roadmap_op_S15_weighted_threshold_met",
        "\"subcmd\":\"checkpoint-status\",\"aggregation\":\"weighted_threshold\",\"covers\":[\"sum_geq_threshold_yields_status_met\"],\"fail\":" + to_string(f15))
    if f15 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S15_weighted_threshold_met] expected=0 got=" + to_string(f15))
    }

    // S16 weighted_threshold partial
    let f16 = check_s16_weighted_threshold_partial(dir)
    r0_session_set(sid)
    r0_emit("track_ae_roadmap_op_S16_weighted_threshold_partial",
        "\"subcmd\":\"checkpoint-status\",\"aggregation\":\"weighted_threshold\",\"covers\":[\"zero_lt_sum_lt_threshold_yields_status_partial\"],\"fail\":" + to_string(f16))
    if f16 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S16_weighted_threshold_partial] expected=0 got=" + to_string(f16))
    }

    // S17 weighted_threshold unknown aggregation → AND fallback + stderr warning
    let f17 = check_s17_weighted_threshold_unknown_fallback(dir)
    r0_session_set(sid)
    r0_emit("track_ae_roadmap_op_S17_weighted_threshold_unknown_fallback",
        "\"subcmd\":\"checkpoint-status\",\"aggregation\":\"frobnicate\",\"covers\":[\"unknown_aggregation_AND_fallback\",\"stderr_warning_emit_explicit\"],\"fail\":" + to_string(f17))
    if f17 != 0 {
        panic("test_roadmap_op_self_impl FAIL [S17_weighted_threshold_unknown_fallback] expected=0 got=" + to_string(f17))
    }

    // Track-AE chain status sanity recheck
    let st_ae = track_ae_chain_status(dir)
    if st_ae != "ready" {
        panic("test_roadmap_op_self_impl FAIL [track_ae_chain_status] expected=ready got=" + st_ae)
    }

    r0_session_set(sid)
    r0_emit("track_ae_roadmap_op_done",
        "\"chain\":\"roadmap_op_weighted_threshold_aggregation_phase_2\",\"track_i_status\":\"" + st + "\",\"track_m_status\":\"" + st_m + "\",\"track_ab_status\":\"" + st_ab + "\",\"track_ae_status\":\"" + st_ae + "\"")

    let cnt = r0_session_count(sid)
    if cnt < 14 {
        panic("test_roadmap_op_self_impl FAIL [emit count] expected=>=14 got=" + to_string(cnt))
    }

    // cleanup synthetic temp (covers .roadmap.* + .checkpoint.* fixtures alike)
    let _ = exec("rm -rf '" + dir + "'")
    // also cleanup any freeze-marker stubs the archive subcmd may have emitted under state/markers
    // (they carry suffix `_archive_freeze_<unix_ts>.marker` — we scope to the test fixture name).
    let _ = exec("rm -f state/markers/" + name + "_arch_archive_freeze_*.marker 2>/dev/null")

    println("  ✅ test_roadmap_op_self_impl self_test PASS (track_i=" + st + ", track_m=" + st_m + ", track_ab=" + st_ab + ", track_ae=" + st_ae + ", sid=" + sid + ", emits=" + to_string(cnt) + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "status" {
            let dir = make_fixture_dir()
            let name = "self_synth"
            let path = write_fixture(dir, name)
            let drift = write_drift_fixture(dir, name)
            let pm_path = write_pm_fixture(dir, name)
            let arch_pass_path = write_archive_pass_fixture(dir, name)
            let arch_fail_path = write_archive_fail_fixture(dir, name)
            let diff_b_path = write_diff_b_fixture(dir, name)
            let st_i = track_i_chain_status(path, dir, name, drift)
            let st_m = track_m_chain_status(path, name, pm_path, name, diff_b_path, arch_pass_path, arch_fail_path)
            let st_ab = track_ab_chain_status(dir)
            let st_ae = track_ae_chain_status(dir)
            println("track_i=" + st_i + " track_m=" + st_m + " track_ab=" + st_ab + " track_ae=" + st_ae)
            let _ = exec("rm -rf '" + dir + "'")
            let _ = exec("rm -f state/markers/" + name + "_arch_archive_freeze_*.marker 2>/dev/null")
            return
        }
        println("usage: hexa run tests/test_roadmap_op_self_impl.hexa { self-test | status }")
        return
    }
    self_test()
}
