_focus_routing", "c_display_mode_dpi_scale_adapt", "c_display_mode_pip_render_concurrent", "c_macos_menubar_status_item", "c_macos_menubar_display_mode_submenu", "c_macos_menubar_fps_toggle_item", "c_macos_menubar_pip_focus_item", "c_fps_overlay_metal_compose", "c_fps_hotkey_handler", "c_fps_metric_aggregator", "c_fps_history_graph_render", "m1_baseline", "m8_sprint1", "m11_sprint2", "m15_sprint3", "m_orchestrator"]
    let i = 0
    let bad = ""
    while i < len(mods_c) {
        let m = mods_c[i]
        let n_str = exec("grep -c 'r0_emit\\|r0_log\\|r0_info\\|r0_warn\\|r0_err' lib/perf/" + m + ".hexa 2>/dev/null").trim()
        let n = to_int(n_str)
        if n < 1 {
            bad = bad + m + " "
        }
        i = i + 1
    }
    if bad == "" {
        t_pass("c_*.hexa emit count >= 1 (37 modules)")
    } else {
        t_fail("c_*.hexa emit gap", bad)
    }

    // loader 모듈 (Phase 0a~10 + stage1 ×8)
    let mods_l = ["pe_parser", "pe_loader", "pe_loader_stage1", "pe_imports", "pe_relocations", "pe_runtime_map", "iat_runtime_bind", "dll_resolve_master", "pe_entry_call", "i386_call_frame", "win32_emulate_kernel32", "syscall_map_i386", "native_helper_bridge", "win32_abi", "win32_abi_i386", "win32_stubs", "win32_kernel32", "win32_kernel32_stage1", "win32_kernel32_stage2", "win32_kernel32_stage3", "win32_kernel32_extras", "win32_ntdll", "win32_msvcrt", "win32_user32", "win32_user32_stage1", "win32_gdi32", "win32_advapi32", "win32_shell32", "win32_ole32", "win32_oleaut32", "win32_wintrust", "win32_version", "win32_msimg32", "win32_rpcrt4", "win32_uiautomationcore", "win32_wininet", "win32_crypt32", "dx_d3d11", "dx_d3d11_stage1", "dx_d3d12", "dx_d3d12_stage1", "dx_d3d12_stage2", "win32_winsock", "win32_winsock_stage1", "oss_validate", "battlenet_bypass", "d2r_launch", "d4_launch"]
    let j = 0
    let bad_l = ""
    while j < len(mods_l) {
        let m = mods_l[j]
        let n_str = exec("grep -c 'r0_emit' lib/loader/" + m + ".hexa 2>/dev/null").trim()
        let n = to_int(n_str)
        if n < 1 { bad_l = bad_l + m + " " }
        j = j + 1
    }
    if bad_l == "" {
        t_pass("lib/loader/*.hexa emit count >= 1 (48 modules)")
    } else {
        t_fail("loader emit gap", bad_l)
    }
}

// ─── (b) self_test 필수 ───
fn test_self_test_required() -> void {
    let bad = exec("for f in lib/perf/c_*.hexa lib/perf/r0_*.hexa lib/perf/harvest_integ.hexa lib/loader/*.hexa; do grep -L '^fn self_test' \"$f\" 2>/dev/null; done").trim()
    if bad == "" {
        t_pass("all production modules define fn self_test()")
    } else {
        t_fail("missing self_test", bad)
    }
}

// ─── (b-2) self_test 가 main() 에서 dispatch 되는지 ───
fn test_self_test_dispatched() -> void {
    let bad = exec("for f in lib/perf/c_*.hexa lib/perf/r0_*.hexa lib/perf/harvest_integ.hexa lib/loader/*.hexa; do if ! grep -q 'self-test' \"$f\"; then echo \"$f\"; fi; done").trim()
    if bad == "" {
        t_pass("self_test dispatched from main() (all modules)")
    } else {
        t_fail("self_test not dispatched", bad)
    }
}

// ─── (c) headless — GUI / dialog / interactive 부재 ───
fn test_headless() -> void {
    let hits = exec("grep -rE 'osascript|read -p|tty|dialog|prompt' --include='*.hexa' --include='*.sh' lib entry tests 2>/dev/null | grep -v 'test_own2' | grep -v '^[^:]*:[[:space:]]*//' | grep -v '^[^:]*:[[:space:]]*#' || true").trim()
    if hits == "" {
        t_pass("headless safe (no osascript / dialog / interactive prompt)")
    } else {
        t_fail("headless violation", hits)
    }
}

// ─── (d) error pattern 일관 — panic message 형식 검증 ───
// 우리 표준: panic("<module> FAIL [<sub>] expected=X got=Y")
fn test_panic_pattern() -> void {
    // 모든 panic 호출 grep
    let total_str = exec("grep -rh 'panic(' --include='*.hexa' lib tests 2>/dev/null | grep -c 'panic(' || true").trim()
    let total = to_int(total_str)
    if total == 0 {
        t_pass("panic pattern (none used)")
        return
    }
    // 형식 위반: panic("...") 안에 "FAIL" 도 "expected" 도 없는 것
    // 단 short panics like panic("not found") 도 일부 허용 — 80%+ 가 형식이면 OK
    let has_fail_str = exec("grep -rh 'panic(' --include='*.hexa' lib tests 2>/dev/null | grep -c 'FAIL' || true").trim()
    let has_fail = to_int(has_fail_str)
    let pct = 0
    if total > 0 { pct = has_fail * 100 / total }
    if pct >= 80 {
        t_pass("panic pattern (FAIL keyword in " + to_string(pct) + "% of panics, " + to_string(has_fail) + "/" + to_string(total) + ")")
    } else {
        t_fail("panic pattern", "only " + to_string(pct) + "% have FAIL keyword (expected >= 80%)")
    }
}

// ─── (e) emit JSONL schema — snake_case event_type ───
fn test_emit_schema() -> void {
    // r0_emit("EventName", ...) 의 EventName 검출 — snake_case 가 아닌 것 (CamelCase / kebab-case)
    let bad = exec("grep -rhoE 'r0_emit\\(\"[A-Z][a-zA-Z]*\"' --include='*.hexa' lib 2>/dev/null | sort -u | head -5 || true").trim()
    if bad == "" {
        t_pass("r0_emit event_type all snake_case")
    } else {
        t_fail("emit event_type CamelCase detected", bad)
    }
}

// ─── (f) entry 가 hexa shim 만 (logic 0) ───
fn test_entry_minimal() -> void {
    let lines = to_int(exec("wc -l < entry").trim())
    if lines <= 10 {
        t_pass("entry shim minimal (" + to_string(lines) + " lines, <= 10)")
    } else {
        t_fail("entry too large", to_string(lines) + " lines (should be <= 10, logic in dispatch.hexa)")
    }
}

fn main() -> void {
    println("own 2 enforcement — log/error/emit/headless mandate (hexa)")
    test_emit_required()
    test_self_test_required()
    test_self_test_dispatched()
    test_headless()
    test_panic_pattern()
    test_emit_schema()
    test_entry_minimal()
    println("")
    println("pass=" + to_string(PASS) + " fail=" + to_string(FAIL))
    if FAIL != 0 {
        panic("own 2 enforcement FAIL=" + to_string(FAIL))
    }
}
