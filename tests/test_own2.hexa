    let mods_c = ["c_correlate", "c_dxil_persist", "c_frame", "c_frametime", "c_heap", "c_pso", "c_shader_aging", "c_shader_seq", "c_shader_warm", "c_shader_warm_pp", "harvest_integ", "c_pe_parse_cache", "c_iat_resolve_cache", "c_win32_call_profile", "c_syscall_bridge_cache", "c_dll_load_predict", "c_pe_reloc_optimize", "c_pso_chain", "c_heap_defrag", "c_input_latency", "c_gpu_hud_ring", "c_audio_dsp", "c_dxil_delta", "c_zone_prefetch_io", "c_pso_family_cluster", "c_cascade_label", "c_remediate_plan", "c_agi_integration", "c_user_solo_profile", "c_metal_queue_priority", "c_thermal_throttle_predict", "c_swap_pressure_forecast", "c_frame_pacing_adaptive", "c_dxr_ray_coherence", "c_texture_streaming_predict", "c_airgenome_label_fusion", "c_raw_paradigm_extract", "c_metal_residency_coalesce", "c_compute_dispatch_merge", "c_vram_pressure_pre_evict", "c_neon_sse_xlat_cache", "c_unified_memory_zero_copy", "c_mesh_shader_cull", "c_core_ml_lod_select", "c_argument_buffer_tier2_map", "c_tile_memory_shader", "c_vrs_rate_adaptive", "c_heap_alias_sched", "c_gpu_family_shader_variant", "c_ca_display_link_vsync", "c_indirect_cmd_buffer", "c_amx_matrix_multiply", "c_mps_graph_postprocess", "c_metal_shared_event_sched", "c_resource_hazard_track", "c_command_buffer_pipelining", "c_dxr_inline_rt_shader", "c_metal_profiler_feedback", "c_driver_fence_pruning", "c_rt_as_compaction", "c_mtl_function_pointer_vtable", "c_dxil_to_air_fusion", "c_metal_private_heap_prewarm", "c_nsprocessinfo_lowpower", "c_os_log_runtime_stream", "c_render_pass_load_store", "c_mtl_imageblock_shared", "c_metal_simdgroup_reduce", "c_install_path_detect", "c_pe_install_coverage", "c_dll_coverage_growth_track", "c_pe_iat_simulation", "c_closure_path_dashboard", "c_oauth_flow_proxy", "c_product_db_cache", "c_catalog_forecast", "c_cdn_mirror_select", "c_phase1_install_simulator", "c_kernel32_function_growth", "c_abi_calling_convention_track", "c_d2r_first_frame_trace", "c_d2r_offline_profile_cache", "c_d2r_dx11_pipe