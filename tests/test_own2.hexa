// tests/test_own2.hexa — own 2 enforcement (raw#9 hexa-only)
//
// own 2 mandate (.own):
//   (a) emit 필수 — 모든 production hexa 모듈 r0_emit 최소 1 회
//   (b) self_test 필수 — 모든 production 모듈에 self_test() 정의 + main() dispatch
//   (c) headless 필수 — GUI / dialog / interactive prompt 호출 0
//   (d) error 패턴 일관 — panic message 에 module + sub + expected/got
//   (e) emit JSONL schema — r0_emit("snake_case_event", "\"k\":v") 패턴
//
// 이 test 가 위 5 항목 모두 검증.

use "../lib/perf/r0_common"

let mut PASS = 0
let mut FAIL = 0

fn t_pass(label: str) -> void { PASS = PASS + 1; println("  PASS " + label) }
fn t_fail(label: str, msg: str) -> void { FAIL = FAIL + 1; println("  FAIL " + label + ": " + msg) }

// ─── (a) emit gap 검증 ───
// production module = c_*.hexa + lib/loader/*.hexa + lib/dispatch.hexa
// 예외: detect.hexa (state output), r0_common.hexa (emit 자체 정의)
