state/markers/pe_d2r_mpq_archive_load_*.marker
state/markers/test_own2_*.marker
state/markers/vacuum_watcher_*.marker

# hexa-resolver / hx runtime telemetry markers (Track BZ post-mortem 2026-05-05).
# Auto-generated during invocation attempts (incl. failed runs); single-line
# JSON with ts + fingerprint, not source-of-truth.
state/markers/closure_orchestrator_[0-9]*.marker
state/markers/remote_preflight_[0-9]*.marker
state/markers/resource_lint_[0-9]*.marker
state/markers/closure_progress_[0-9]*.marker
state/markers/resource_op_[0-9]*.marker
