// cli/gamebox.hexa — gamebox standalone CLI entry.
//
// Subcommand dispatch: status / list / probe / launch / selftest
//
// Mirror pattern: sim-universe/cli/sim-universe.hexa + airgenome-gamebox
// tool/closure_orchestrator.hexa (subcmd table + honest-emit format).
//
// own1: Wine 0 / hexa-only / NO DRM bypass / NO Warden bypass / NO anti-cheat
//       bypass / NO anima clone. Apple-native runtime only.
// own2: PASS/FAIL emit honest, silent_swallow 0건. PARTIAL emit explicit.
//       RETIRED_INTENTIONAL emit explicit.
//
// HONEST EMIT (own2 mandate)
//   Every subcmd emits: `__GAMEBOX__ <PASS|FAIL|PARTIAL> <subcmd> <reason>` on completion.
//   selftest also emits: `__GAMEBOX_SELFTEST__ <PASS|FAIL>` for install.hexa hook.
//
// SUBCOMMANDS
//   status     Print package version + forensic verdict + module inventory snapshot.
//   list       Enumerate loaders / perf families / tools / roadmaps / checkpoints.
//   probe      Skeleton-tier import probe (loads dll_resolve_master + verifies own2 emit).
//   launch     Real launch dispatch (RETIRED_INTENTIONAL by default — own1 Wine 0 +
//              skeleton-tier validated_manjeom 0; emits PARTIAL with explicit rationale).
//   selftest   Quick self-validation (own2 emit + module presence checks).

use "../lib/perf/r0_common"

let GAMEBOX_VERSION = "1.0.0"
let GAMEBOX_FORENSIC = "SKELETON_TIER_100PCT_WIN32_VALIDATED_MANJEOM_0"
let GAMEBOX_PROVENANCE = "extracted from dancinlife/airgenome-gamebox 2026-05-05 (67 BG cycles)"

// ─── helpers ──────────────────────────────────────────────────

fn emit_status(verdict: str, subcmd: str, reason: str) {
    println("__GAMEBOX__ " + verdict + " " + subcmd + " " + reason)
}

fn pkg_root() -> str {
    let env_root = env("GAMEBOX_ROOT")
    if env_root.len() > 0 { return env_root }
    return exec("pwd").trim()
}

fn count_files(dir: str, glob: str) -> int {
    let cmd = "ls " + dir + "/" + glob + " 2>/dev/null | wc -l"
    let raw = exec(cmd).trim()
    return parse_int(raw)
}

// ─── subcmd: status ──────────────────────────────────────────

fn cmd_status() -> int {
    let root = pkg_root()
    println("gamebox v" + GAMEBOX_VERSION)
    println("forensic: " + GAMEBOX_FORENSIC)
    println("provenance: " + GAMEBOX_PROVENANCE)
    println("license: Apache-2.0")
    println("repository: https://github.com/dancinlab/gamebox")
    println("")
    println("inventory snapshot (root=" + root + "):")
    let loaders = count_files(root + "/lib/loader", "*.hexa")
    let perfs = count_files(root + "/lib/perf", "*.hexa")
    let tests = count_files(root + "/tests", "*.hexa")
    let tools = count_files(root + "/tool", "*.hexa")
    let roadmaps = count_files(root, ".roadmap.*")
    let checkpoints = count_files(root, ".checkpoint.*")
    let markers = count_files(root + "/state/markers", "airgenome_gamebox_*.marker")
    println("  loaders:           " + loaders.to_str())
    println("  perf modules:      " + perfs.to_str())
    println("  tests:             " + tests.to_str())
    println("  tools:             " + tools.to_str())
    println("  roadmaps:          " + roadmaps.to_str())
    println("  checkpoints:       " + checkpoints.to_str())
    println("  predecessor markers (airgenome_gamebox_*): " + markers.to_str())
    println("")
    println("posture (own1 invariant):")
    println("  wine_0:            true")
    println("  drm_bypass_0:      true")
    println("  warden_bypass_0:   true")
    println("  anti_cheat_bypass_0: true")
    println("  anima_clone_0:     true")
    println("  hexa_only:         true")
    emit_status("PASS", "status", "snapshot_emitted")
    return 0
}

// ─── subcmd: list ────────────────────────────────────────────

fn cmd_list(filter: str) -> int {
    let root = pkg_root()
    let mut shown = 0
    if filter == "" || filter == "loaders" {
        println("[loaders] " + root + "/lib/loader/")
        let raw = exec("ls " + root + "/lib/loader/ 2>/dev/null").trim()
        println(raw)
        shown = shown + 1
    }
    if filter == "" || filter == "perf" {
        println("[perf families top-20] " + root + "/lib/perf/")
        let raw = exec("ls " + root + "/lib/perf/ | head -20 2>/dev/null").trim()
        println(raw)
        shown = shown + 1
    }
    if filter == "" || filter == "tools" {
        println("[tools] " + root + "/tool/")
        let raw = exec("ls " + root + "/tool/ 2>/dev/null").trim()
        println(raw)
        shown = shown + 1
    }
    if filter == "" || filter == "roadmaps" {
        println("[roadmaps] " + root + "/.roadmap.*")
        let raw = exec("ls " + root + "/.roadmap.* 2>/dev/null").trim()
        println(raw)
        shown = shown + 1
    }
    if filter == "" || filter == "checkpoints" {
        println("[checkpoints] " + root + "/.checkpoint.*")
        let raw = exec("ls " + root + "/.checkpoint.* 2>/dev/null").trim()
        println(raw)
        shown = shown + 1
    }
    if shown == 0 {
        emit_status("FAIL", "list", "unknown_filter:" + filter)
        return 1
    }
    emit_status("PASS", "list", "shown:" + shown.to_str())
    return 0
}

// ─── subcmd: probe ───────────────────────────────────────────

fn cmd_probe() -> int {
    let root = pkg_root()
    let dll_master = root + "/lib/loader/dll_resolve_master.hexa"
    let exists = exec("[ -f \"" + dll_master + "\" ] && echo y || echo n").trim()
    if exists != "y" {
        emit_status("FAIL", "probe", "dll_resolve_master_missing")
        return 1
    }
    println("[probe] dll_resolve_master.hexa present at " + dll_master)
    println("[probe] skeleton-tier importable (own2 honest: NOT loaded into hexa interp)")
    println("[probe] real load requires hexa interp closure CM-26..CM-30 (validated_manjeom = 0)")
    emit_status("PARTIAL", "probe", "skeleton_tier_only_validated_manjeom_0")
    return 0
}

// ─── subcmd: launch ──────────────────────────────────────────

fn cmd_launch(game: str) -> int {
    println("[launch] target: " + game)
    println("[launch] own1 invariant: Wine 0 / DRM bypass 0 / Warden bypass 0 /")
    println("        anti-cheat bypass 0 / anima clone 0")
    println("[launch] forensic: " + GAMEBOX_FORENSIC)
    println("[launch] real launch RETIRED_INTENTIONAL — skeleton-tier validated_manjeom = 0")
    println("[launch] rationale: hexa interp closure CM-26..CM-30 missing per")
    println("        docs/CLOSURE_ROADMAP.md §5; D3DMetal harness unfinished;")
    println("        L1-L5 online expansion lock-in carries (EULA / Warden /")
    println("        multi-year / D2R-single / parallel) per .roadmap.battlenet.")
    emit_status("PARTIAL", "launch", "retired_intentional:skeleton_tier_only:" + game)
    return 0
}

// ─── subcmd: selftest ────────────────────────────────────────

fn cmd_selftest(quick: bool) -> int {
    let root = pkg_root()
    let mut ok = true

    let manifest = root + "/hexa.toml"
    let m_ok = exec("[ -f \"" + manifest + "\" ] && echo y || echo n").trim()
    if m_ok != "y" { ok = false; eprintln("[selftest] FAIL hexa.toml missing") }

    let cli = root + "/cli/gamebox.hexa"
    let c_ok = exec("[ -f \"" + cli + "\" ] && echo y || echo n").trim()
    if c_ok != "y" { ok = false; eprintln("[selftest] FAIL cli/gamebox.hexa missing") }

    let lic = root + "/LICENSE"
    let l_ok = exec("[ -f \"" + lic + "\" ] && echo y || echo n").trim()
    if l_ok != "y" { ok = false; eprintln("[selftest] FAIL LICENSE missing") }

    let dll_master = root + "/lib/loader/dll_resolve_master.hexa"
    let d_ok = exec("[ -f \"" + dll_master + "\" ] && echo y || echo n").trim()
    if d_ok != "y" { ok = false; eprintln("[selftest] FAIL lib/loader/dll_resolve_master.hexa missing") }

    if quick == false {
        let loader_count = count_files(root + "/lib/loader", "*.hexa")
        if loader_count < 30 {
            ok = false
            eprintln("[selftest] FAIL loader count " + loader_count.to_str() + " < 30 floor")
        }
        let perf_count = count_files(root + "/lib/perf", "*.hexa")
        if perf_count < 100 {
            ok = false
            eprintln("[selftest] FAIL perf count " + perf_count.to_str() + " < 100 floor")
        }
    }

    if ok {
        println("__GAMEBOX_SELFTEST__ PASS")
        emit_status("PASS", "selftest", "all_required_files_present")
        return 0
    }
    println("__GAMEBOX_SELFTEST__ FAIL")
    emit_status("FAIL", "selftest", "missing_required_files")
    return 1
}

// ─── help ────────────────────────────────────────────────────

fn cmd_help() -> int {
    println("gamebox v" + GAMEBOX_VERSION + " — Apple-native Win32 game runtime (hexa-only, Wine 0)")
    println("")
    println("usage: gamebox <subcmd> [args...]")
    println("")
    println("subcommands:")
    println("  status                     package version + forensic verdict + inventory snapshot")
    println("  list [filter]              enumerate loaders/perf/tools/roadmaps/checkpoints")
    println("                             filter: loaders | perf | tools | roadmaps | checkpoints")
    println("  probe                      skeleton-tier import probe (own2 PARTIAL emit)")
    println("  launch <game>              real launch dispatch (RETIRED_INTENTIONAL skeleton-tier)")
    println("  selftest [--quick]         self-validation (own2 PASS/FAIL emit)")
    println("  help                       print this help")
    println("")
    println("forensic: " + GAMEBOX_FORENSIC)
    println("license: Apache-2.0  |  repository: https://github.com/dancinlab/gamebox")
    return 0
}

// ─── main dispatch ───────────────────────────────────────────

fn main() -> void {
    // hexa args() = [interpreter, script_path, ...userargs] — userarg index starts at 2.
    let argv = args()
    let argc = len(argv)
    if argc < 3 {
        let _ = cmd_help()
        emit_status("PARTIAL", "help", "no_subcmd_given")
        return
    }
    let sub = argv[2]
    let mut rc = 0
    if sub == "status" {
        rc = cmd_status()
    } else if sub == "list" {
        let mut filter = ""
        if argc >= 4 { filter = argv[3] }
        rc = cmd_list(filter)
    } else if sub == "probe" {
        rc = cmd_probe()
    } else if sub == "launch" {
        let mut game = "<unspecified>"
        if argc >= 4 { game = argv[3] }
        rc = cmd_launch(game)
    } else if sub == "selftest" {
        let mut quick = false
        if argc >= 4 && argv[3] == "--quick" { quick = true }
        rc = cmd_selftest(quick)
    } else if sub == "help" || sub == "--help" || sub == "-h" {
        rc = cmd_help()
    } else {
        eprintln("[gamebox] unknown subcmd: " + sub)
        rc = cmd_help()
        emit_status("FAIL", "main", "unknown_subcmd:" + sub)
        return
    }
    if rc != 0 { return }
}
