// install.hexa — hx build hook for gamebox.
//
// Invoked by `hx install gamebox` (hexa-lang package manager) right after
// the GitHub checkout (or symlink from /Users/ghost/core/gamebox) lands
// in $HX_PKG_DIR. hx passes:
//   HX_PKG_DIR     — absolute path to the package root
//   HX_BIN_DIR     — ~/.hx/bin
//   HX_PKG_NAME    — "gamebox"
//   HX_HOOK_PHASE  — "pre" | "post" | "both" (default: "both")
//
// Mirror pattern: sim-universe/install.hexa (closure 8/8 cycle 2026-05-03)
//                 + qmirror/install.hexa.
//
//   1. Pre-install: detect macOS + Apple Silicon + D3DMetal SDK presence.
//      Failure of D3DMetal → warn-only (skeleton-tier loaders still importable).
//   2. Post-install: run `gamebox selftest --quick` via the freshly-staged
//      cli/gamebox.hexa. Selftest output captured; non-PASS = warn-only
//      validates own2 honest emit only, not real game frames).
//   3. Optional: emit hint when GAMEBOX_D3DMETAL_SDK is unset.
//
//   own1 Wine 0 / DRM bypass 0 / Warden bypass 0 / anti-cheat bypass 0 / anima clone 0.

fn check_macos() -> bool {
    // Returns true iff `uname -s` reports Darwin.
    let raw = exec("uname -s 2>&1").trim()
    return raw == "Darwin"
}

fn check_apple_silicon() -> bool {
    // Returns true iff `uname -m` reports arm64.
    let raw = exec("uname -m 2>&1").trim()
    return raw == "arm64"
}

fn check_d3dmetal_sdk() -> bool {
    // Game Porting Toolkit / D3DMetal SDK detection. Apple distributes via
    // Game Porting Toolkit DMG (free dev account). Common install paths:
    //   /Library/Apple/usr/share/D3DMetal*
    //   /opt/homebrew/Caskroom/game-porting-toolkit/*
    let probe1 = exec("[ -d \"/Library/Apple/usr/share\" ] && echo y || echo n").trim()
    if probe1 == "y" { return true }
    let probe2 = exec("[ -d \"/opt/homebrew/Caskroom/game-porting-toolkit\" ] && echo y || echo n").trim()
    return probe2 == "y"
}

fn ensure_apple_native_pre() -> bool {
    println("[gamebox/install] [pre] platform check (macOS + Apple Silicon + D3DMetal)")
    let mut all_ok = true

    if check_macos() == false {
        eprintln("[gamebox/install]   WARN: not macOS — gamebox is Apple-native (Wine 0)")
        eprintln("[gamebox/install]   skeleton-tier loaders still importable as hexa lib;")
        eprintln("[gamebox/install]   real launches require Darwin.")
        all_ok = false
    } else {
        println("[gamebox/install]   macOS — OK")
    }

    if all_ok && check_apple_silicon() == false {
        println("[gamebox/install]   note: x86_64 macOS — D3DMetal arm64-pinned; degraded mode")
    } else if all_ok {
        println("[gamebox/install]   Apple Silicon (arm64) — OK")
    }

    if check_d3dmetal_sdk() {
        println("[gamebox/install]   D3DMetal SDK present — OK")
    } else {
        eprintln("[gamebox/install]   WARN: D3DMetal SDK not detected at canonical paths")
        eprintln("[gamebox/install]   install hint: developer.apple.com/games → Game Porting Toolkit")
    }

    return true  // never fatal — skeleton-tier importable without D3DMetal
}

fn run_quick_selftest(root: str) -> bool {
    let cli = root + "/cli/gamebox.hexa"
    let exists = exec("[ -f \"" + cli + "\" ] && echo y || echo n").trim()
    if exists != "y" {
        eprintln("[gamebox/install] WARN: cli/gamebox.hexa missing — skip selftest")
        return false
    }
    println("[gamebox/install] [post] running quick selftest (own2 honest emit verification)")
    let cmd = "GAMEBOX_ROOT=\"" + root + "\" hexa run \"" + cli + "\" selftest --quick 2>&1"
    let raw = exec(cmd)
    if raw.contains("__GAMEBOX_SELFTEST__ PASS") {
        println("[gamebox/install]   selftest PASS — own2 honest emit + skeleton-tier importable")
        return true
    }
    eprintln("[gamebox/install] WARN: selftest non-PASS (warn-only, not a blocker)")
    eprintln("  hint: hexa stdlib mismatch / D3DMetal absence / closure CM-26..30 missing")
    return false
}

fn d3dmetal_hint() {
    let key = env("GAMEBOX_D3DMETAL_SDK")
    if key.len() > 0 { return }
    println("")
    println("[gamebox/install] hint: GAMEBOX_D3DMETAL_SDK unset — using auto-detect path scan.")
    println("  explicit override: export GAMEBOX_D3DMETAL_SDK=/path/to/D3DMetal")
    println("  (skeleton-tier loaders import fine without — only required for real launches)")
}

fn main() -> void {
    let mut root = env("HX_PKG_DIR")
    if root == "" { root = exec("pwd").trim() }
    let phase = env("HX_HOOK_PHASE")
    let mut p = phase
    if p == "" { p = "both" }
    println("[gamebox/install] HX_PKG_DIR=" + root + " phase=" + p)

    let entry = root + "/cli/gamebox.hexa"
    let entry_ok = exec("[ -f \"" + entry + "\" ] && echo y || echo n").trim()
    if entry_ok != "y" {
        eprintln("[gamebox/install] ERROR: canonical entry missing: " + entry)
        exit(1)
    }
    println("[gamebox/install] canonical entry OK: cli/gamebox.hexa")

    if p == "pre" || p == "both" {
        let _ = ensure_apple_native_pre()  // warn-only
    }

    if p == "post" || p == "both" {
        let _ = run_quick_selftest(root)  // warn-only
        d3dmetal_hint()
    }

    println("[gamebox/install] done — hx will generate " + env("HX_BIN_DIR") + "/gamebox shim")
}
