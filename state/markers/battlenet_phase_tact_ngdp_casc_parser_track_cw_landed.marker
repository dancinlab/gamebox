  "cw_phase_cq_p2_summary": {
    "parent_roadmap": "docs/BATTLENET_ROADMAP_TRACK_CQ.ai.md",
    "parent_phase_id": "CQ-P2",
    "parent_phase_scope_paraphrase": "TACT/NGDP/CASC parser skeleton — TSV-persisted phase tracker mirroring pe_battle_net_download_track.hexa style, covering manifest fetch + BLTE chunk parse + MD5 verify + LZMA inflate + install_path write. Public-spec implementation direction only (Apple Compression + CommonCrypto + Network.framework); no Wine cab/wininet code lift.",
    "cw_deliverable_kind": "audit_inventory_honest_spec",
    "cw_does_NOT_author_module": true,
    "cw_resolves_open_question": "CQ-Q2",
    "cw_recommendation": "separate_module_not_extension_multi_table_single_module_5_tsvs_manifest_blte_md5_lzma_install_under_one_module_pe_battlenet_tact_ngdp_casc_track_hexa",
    "rationale": "respects Track P precedent (do not modify existing modules; author new + cross-link); mirrors pe_battlenet_agent_http_rest.hexa (5 tables in one module) and Track CT spec (3 tables in one module) idiom; foreign-key linkage to download_track preserves cross-module composition honesty without mutating the existing transport-layer module; +1 to G-1 blocked-surface count is the accepted cost for clean separation of transport (download_track) vs format-decode (CQ-P2) concerns.",
    "recommended_schema": {
      "tables": [
        {"name": "manifest.tsv", "columns": ["session_id","manifest_id","archive_kind","game_kind","region","version_id","entry_count","encoding_table_size","root_hash_kind"]},
        {"name": "blte.tsv", "columns": ["session_id","blte_id","header_size","chunk_count_in_block","encoding_kind","chunk_index","encoded_size","decoded_size","total_decoded_size","integrity_pass"]},
        {"name": "md5.tsv", "columns": ["session_id","md5_id","key_kind","expected_md5_hex","computed_md5_hex","match","key_kind_link_id"]},
        {"name": "lzma.tsv", "columns": ["session_id","lzma_id","blte_id_link","input_size","expected_output_size","actual_output_size","inflate_status_code"]},
        {"name": "install.tsv", "columns": ["session_id","install_id","game_kind","stage_kind","target_subpath","bytes_to_write","bytes_written","write_status_code","link_chunk_id"]}
      ],
      "linkage": {
        "session_id_correlates_five_tables": true,
        "blte_id_link_intra_module_fk_lzma_to_blte": true,
        "key_kind_link_id_intra_module_fk_md5_to_manifest_encoding_table": true,
        "link_chunk_id_foreign_key_to_pe_battle_net_download_track_chunks_tsv": true,
        "foreign_keys_optional_zero_means_unlinked": true
      }
    },
    "honest_constraints": [
      "no_real_archive_bytes",
      "no_real_content_key_bytes",
      "no_real_md5_key_material",
      "no_real_lzma_decoded_payload",
