  "win32_shell32_three_conflict_fix": {
    "conflict_1_module_level_let_mut": {
      "before": "let mut g_shell_exec_log = \"\"  // at module top-level",
      "diagnosis": "hexa-lang upstream parser does not accept `let mut` at module scope; mismatch propagated to EOF as `expected RBrace, got Eof`",
      "fix": "replace_in_memory_mutable_global_with_file_backed_tsv_pattern_matching_rest_of_lib_loader_modules",
      "new_helpers": ["g_shell_exec_log_path", "shell_execute_log_ensure", "shell_execute_log_add_now_writes_to_disk", "shell_execute_log_size_now_reads_from_disk", "shell_execute_log_clear"],
      "self_test_modification": "added clear-then-add-then-clear bracketing for reproducibility"
    },
    "conflict_2_impl_reserved_keyword": {
      "before": "let impl = 0   // counter for impl-tier mappings inside shell32_stats",
      "diagnosis": "hexa-lang upstream now reserves `impl` keyword (joins `scope` from Track DA, `match` from Track DC as cycle reserved-keyword adjustments)",
      "fix": "rename_impl_to_impl_count_within_shell32_stats_only",
      "string_literal_impl_in_shell32_table_4th_column_unchanged": true,
      "string_literal_impl_unchanged_note": "the string `\"impl\"` used as 4th-column value in shell32_table() rows is a string value, not an identifier; unchanged"
    },
    "conflict_3_let_without_mut_reassignment": {
      "before": "let total = 0; let impl = 0; let i = 0; ... total = total + 1; impl = impl + 1; i = i + 1; ... result = result + [[cat, total, impl]]",
      "diagnosis": "hexa-lang upstream parser rejects reassignment of `let`-bound identifiers; pre-RFC-016 strictness era",
      "fix": "every_reassigned_local_now_let_mut_plus_array_append_via_result_push_instead_of_result_plus_array",
      "locals_now_let_mut": ["result", "c", "total", "impl_count", "i"],
      "array_append_pattern": "result.push([cat, total, impl_count]) replaces result = result + [[cat, total, impl_count]]"
    }
  },

