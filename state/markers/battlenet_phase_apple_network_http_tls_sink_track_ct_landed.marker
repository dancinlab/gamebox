  "ct_phase_cq_p1_summary": {
    "parent_roadmap": "docs/BATTLENET_ROADMAP_TRACK_CQ.ai.md",
    "parent_phase_id": "CQ-P1",
    "parent_phase_scope_paraphrase": "Apple Network framework HTTP/TLS sink module — instrumentation surface a real Network framework client would emit into; not the actual Network framework binding.",
    "ct_deliverable_kind": "audit_inventory_honest_spec",
    "ct_does_NOT_author_module": true,
    "ct_resolves_open_question": "CQ-Q1",
    "ct_recommendation": "multi_table_single_module_3_tsvs_request_tls_response_under_one_module_pe_battlenet_apple_network_http_hexa",
    "rationale": "mirrors pe_battlenet_agent_http_rest.hexa precedent (5 tables in one module); composable; extension-friendly; minimizes loader cluster bloat vs 3-module split; avoids wide-row coupling vs single combined TSV.",
    "recommended_schema": {
      "tables": [
        {"name": "request.tsv", "columns": ["exchange_id","request_open_id","host_kind","purpose_kind","method","path","header_count","body_size","bytes_sent_total"]},
        {"name": "tls.tsv", "columns": ["exchange_id","tls_id","target_host","sni_host","tls_version","cipher_suite_class","cert_chain_depth","alpn_selected","close_kind"]},
        {"name": "response.tsv", "columns": ["exchange_id","response_id","status_code","content_length","content_type","transfer_encoding","cache_kind","bytes_received_total","body_sha256_hex","link_chunk_id","link_oauth_op_id","bearer_attached"]}
      ],
      "linkage": {
        "exchange_id_correlates_three_tables": true,
        "link_chunk_id_foreign_key_to_pe_battle_net_download_track_chunks_tsv": true,
        "link_oauth_op_id_foreign_key_to_pe_battle_net_oauth_token_ops_tsv": true,
        "foreign_keys_optional_zero_means_unlinked": true
      }
    },
    "honest_constraints": [
      "no_real_token_bytes",
      "no_real_cipher_key_material",
      "no_real_certificate_bytes",
      "no_real_response_body",
      "no_apple_private_spi",
      "length_only_for_token_size_per_oauth_token_precedent",
      "cipher_suite_class_string_only_no_key_derivation_data"
    ],
    "expected_self_test_thresholds_paper_mode": {
      "request_rows_min": 6,
      "tls_rows_min": 6,
      "response_rows_min": 6,
      "r0_emit_total_min": 19,
      "tls_versions_covered_min": 2,
      "cipher_suite_classes_covered_min": 3,
      "host_kinds_covered_min": 4,
      "linked_chunk_id_rows_min": 2,
      "linked_oauth_op_id_rows_min": 2,
      "bearer_attached_rows_min": 2
    },
    "expected_honest_tier_at_module_author_exit": "skeleton-tier",
    "expected_validated_manjeom_at_module_author_exit": 0,
    "expected_aggregate_posture_at_module_author_exit": "SKELETON_TIER_100PCT_WIN32_VALIDATED_MANJEOM_0_unchanged_skeleton_module_count_plus_1"
  },

