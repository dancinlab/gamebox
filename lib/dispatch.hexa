//
// invoked from `entry` shim (bash, 5 줄 plugin-contract glue).
// 모든 logic 은 hexa.

use "./perf/r0_common"

let GAMEBOX_VERSION = "0.2.0"

// ─── helpers ───
fn run_hexa(rel_path: str, sub: str) -> int {
    let here = exec("dirname \"$0\" || echo .").trim()
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    if cmd == "" {
        println("error: hexa not on PATH")
        return 127
    }
    let full = "HEXA=" + cmd + " " + cmd + " run '" + here + "/" + rel_path + "' " + sub
    let out = exec(full)
    println(out)
    return 0
}

fn run_self_test_set(modules: array, dir: str, label: str) -> int {
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    if cmd == "" { return 127 }
    let here = exec("dirname \"${HEXA_DISPATCH_PATH:-./lib/dispatch.hexa}\"").trim()
    let i = 0
    let fail = 0
    while i < len(modules) {
        let m = modules[i]
        let path = here + "/" + dir + "/" + m + ".hexa"
        let out = exec(cmd + " run '" + path + "' self-test 2>&1")
        if out.contains("✅") {
            println("  PASS " + m)
        } else {
            if out.contains("PASS") {
                println("  PASS " + m)
            } else {
                println("  FAIL " + m)
                fail = fail + 1
            }
        }
        i = i + 1
    }
    if fail == 0 {
        println("  " + label + " ALL PASS (" + to_string(len(modules)) + "/" + to_string(len(modules)) + ")")
        return 0
    }
    println("  " + label + " FAIL=" + to_string(fail))
    return 1
}

// ─── subcommands ───
fn cmd_detect(mode: str) -> void {
    let here = exec("dirname \"${HEXA_DISPATCH_PATH:-./lib/dispatch.hexa}\"").trim()
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    let out = exec(cmd + " run '" + here + "/detect.hexa' " + mode)
    println(out)
}

fn cmd_doctor() -> void {
    println("gamebox doctor — own 1: Apple-only, Wine 0\n")
    cmd_detect("--human")
    println("")
    println("Phase status (lib/loader/, hexa-only):")
    println("  Phase 0a (PE parser):       ✓ done")
    println("  Phase 0b (PE memory loader): planned")
    println("  Phase 1+ (Win32 shim):       planned")
    println("")
    let hexa = exec("command -v hexa 2>/dev/null").trim()
    if hexa != "" {
        println("hexa-lang: ✓ " + hexa)
    } else {
        println("hexa-lang: ✗ not found")
    }
}

fn cmd_games() -> void {
    println("gamebox does NOT launch games (own 1: Wine 0).")
    println("")
    println("DIY hexa PE 로더 (lib/loader/) Phase 0a~10 in progress:")
    println("  Phase 0a   PE parser            done")
    println("  Phase 0b   PE memory loader     planned")
    println("  Phase 1    x64 ABI shim         planned")
    println("  Phase 2-4  Win32 stubs+impl     planned")
    println("  Phase 5    DirectX 11→D3DMetal  planned")
    println("  Phase 6    Winsock              planned")
    println("  Phase 7    OSS Win 게임 검증    planned")
    println("  Phase 8    Battle.net 우회      planned")
    println("  Phase 9    D2R 첫 frame         planned (~9-12 mo)")
    println("  Phase 10   D4 D3D12+DXR         planned (~12-18 mo)")
    println("")
    println("target after closure:")
    println("  D2R / D4")
    println("")
    println("see docs/CLOSURE_ROADMAP.md")
}

fn cmd_r0(sub: str) -> int {
    if sub == "self-test" || sub == "test" {
        let mods = ["r0_common", "r0_hud_parser", "r0_cache_watch", "r0_heap_sample", "r0_session"]
        return run_self_test_set(mods, "perf", "r0 self-test")
    }
    let here = exec("dirname \"${HEXA_DISPATCH_PATH:-./lib/dispatch.hexa}\"").trim()
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    if sub == "list" {
        let out = exec(cmd + " run '" + here + "/perf/r0_session.hexa' list")
        println(out)
        return 0
    }
    if sub == "current" {
        let out = exec(cmd + " run '" + here + "/perf/r0_session.hexa' current")
        println(out)
        return 0
    }
    println("usage: gamebox r0 { self-test | list | current | <module> <subcmd> }")
    return 0
}

