fn cmd_help() -> void {
    println("gamebox — DIY hexa Win32 emulation (own 1: Apple-only, Wine 0)")
    println("version: " + GAMEBOX_VERSION)
    println("")
    println("usage:")
    println("  gamebox detect [--json|--human]   Apple-native env + own 1 compliance")
    println("  gamebox doctor                    full diagnostic + Phase status")
    println("  gamebox games                     supported games (Phase 9+ 후 작동)")
    println("  gamebox self-test                 unified test (entry/plugin/all hexa)")
    println("  gamebox r0 <sub>                  M0 instrumentation (5 modules)")
    println("  gamebox perf <sub>                M2-M14 만점 컴포넌트 (11 modules)")
    println("  gamebox loader <sub>              Phase 0a~10 PE 로더")
    println("  gamebox version                   " + GAMEBOX_VERSION)
    println("  gamebox help")
    println("")
    println("own 1: Wine / CrossOver / Whisky / community wine 의존 0 줄")
    println("       DIY hexa PE 로더 + Win32 shim (lib/loader/)")
}

// install <path/to.exe> [--summary] — analyze + report coverage gap.
//   --summary: structured key=value (native dialog 용 short form)
//   default:   상세 분석 (사람-읽기)
//
//   현 단계: PE parse + coverage 분석만. 실 install (PE map + IAT resolve + run) 는
//   stage1→stage4 강화 후 가능 (~6-12 개월 — closure path B).
fn cmd_install(path: str) -> void {
    cmd_install_mode(path, false)
}

fn cmd_install_summary(path: str) -> void {
    cmd_install_mode(path, true)
}

fn cmd_install_mode(path: str, summary: bool) -> void {
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" {
        if summary {
            println("status=error")
            println("error=file_not_found")
            println("path=" + path)
        } else {
            println("gamebox install: file not found — " + path)
        }
        return
    }
    let cmd = exec("command -v hexa 2>/dev/null").trim()
    let here = exec("dirname \"${HEXA_DISPATCH_PATH:-./lib/dispatch.hexa}\"").trim()
    let _mk = exec("mkdir -p '" + here + "/../tool/bench'")
    let basename = exec("basename '" + path + "'").trim()
    let local_copy = here + "/../tool/bench/" + basename
    // self-cp 회피
    let same_check = exec("[ \"$(realpath '" + path + "' 2>/dev/null)\" = \"$(realpath '" + local_copy + "' 2>/dev/null)\" ] && echo same").trim()
    if same_check != "same" {
        let _cp = exec("cp '" + path + "' '" + local_copy + "'")
    }
    let gamebox_root = exec("cd '" + here + "/..' && pwd").trim()
    let rel_copy = "tool/bench/" + basename

    // PE parse
    let pe_out = exec("cd '" + gamebox_root + "' && " + cmd + " run lib/loader/pe_parser.hexa summary '" + rel_copy + "' 2>&1 | grep -v 'hexa-resolver\\|Shell cwd'").trim()
    let machine_str = ""
    let arch = "unknown"
    let machine_line = exec("echo '" + pe_out + "' | grep -E '^Machine:'").trim()
    if machine_line.contains("332") { arch = "i386" }
    if machine_line.contains("34404") { arch = "x86_64" }  // 0x8664
    if machine_line.contains("0x14C") { arch = "i386" }

    // coverage analyze
    let cov_out = exec("cd '" + gamebox_root + "' && " + cmd + " run lib/perf/c_pe_install_coverage.hexa analyze '" + rel_copy + "' 2>&1 | grep -v 'hexa-resolver\\|Shell cwd'").trim()
    let dlls = exec("echo '" + cov_out + "' | grep -E '^DLLs:' | awk '{print $2}'").trim()
    let funcs = exec("echo '" + cov_out + "' | grep -E '^Functions:' | awk '{print $2}'").trim()
    let covered = exec("echo '" + cov_out + "' | grep -E '^Covered:' | awk '{print $2}'").trim()
    let missing = exec("echo '" + cov_out + "' | grep -E '^Missing:' | awk '{print $2}'").trim()
    let coverage = exec("echo '" + cov_out + "' | grep -E '^Coverage:' | awk '{print $2}'").trim()

    if summary {
        println("status=ok")
        println("pe=" + path)
        println("arch=" + arch)
        println("dlls=" + dlls)
        println("functions=" + funcs)
        println("covered=" + covered)
        println("missing=" + missing)
        println("coverage=" + coverage)
        println("phase=stage1")
        println("next=kernel32_strengthening+i386_abi+6_missing_dlls")
        println("eta=6-12_months")
        println("path=closure_B")
        return
    }

    println("=== gamebox install — " + path + " ===")
    println("(copied to " + rel_copy + " for analysis)")
    println("")
    println("--- PE parse ---")
    println(pe_out)
    println("")
    println("--- Win32 API coverage (gamebox stage1 vs PE imports) ---")
    println(cov_out)
    println("")
    println("--- next ---")
    println("real install (PE map + IAT resolve + runtime exec) requires:")
    println("  - kernel32 stage1→stage4 (currently 3/224 functions for this PE)")
    println("  - +6 missing DLL adapters (CRYPT32, WININET, SHELL32, OLE32, OLEAUT32, WINTRUST)")
    println("  - i386 (32-bit) ABI support (current x86_64 only)")
    println("→ closure path B, est. 6-12 months. see docs/CLOSURE_ROADMAP.md")
}

fn main() -> void {
    let a = args()
    let sub = "help"
    if len(a) >= 3 { sub = a[2] }
    let arg2 = ""
    if len(a) >= 4 { arg2 = a[3] }

    if sub == "detect" || sub == "status" {
        let mode = "--human"
        if arg2 != "" { mode = arg2 }
        cmd_detect(mode)
        return
    }
    if sub == "doctor" {
        cmd_doctor()
        return
    }
    if sub == "games" {
        cmd_games()
        return
    }
    if sub == "version" || sub == "-v" || sub == "--version" {
        println("gamebox " + GAMEBOX_VERSION)
        return
    }
    if sub == "r0" {
        let _rc = cmd_r0(arg2)
        return
    }
    if sub == "perf" {
        let _rc = cmd_perf(arg2)
        return
    }
    if sub == "loader" {
        let _rc = cmd_loader(arg2)
        return
    }
    if sub == "install" {
        if arg2 == "" {
            println("usage: gamebox install <path/to.exe> [--summary]")
            return
        }
        let arg3 = ""
        if len(a) >= 5 { arg3 = a[4] }
        if arg3 == "--summary" { cmd_install_summary(arg2); return }
        cmd_install(arg2)
        return
    }
    if sub == "launch" {
        if arg2 == "" {
            println("usage: gamebox launch <path/to.exe>")
            println("  own1 정합 path: native/pe_to_macho_shim → native/airgenome_helper")
            println("  prereq: cd native && ./build.sh")
            return
        }
        let here = exec("dirname \"${HEXA_DISPATCH_PATH:-./lib/dispatch.hexa}\"").trim()
        let cmd = exec("command -v hexa 2>/dev/null").trim()
        let out = exec(cmd + " run '" + here + "/loader/pe_real_launch_orchestrator.hexa' launch '" + arg2 + "'")
        println(out)
        return
    }
    if sub == "self-test" || sub == "test" {
        let here = exec("dirname \"${HEXA_DISPATCH_PATH:-./lib/dispatch.hexa}\"").trim()
        let cmd = exec("command -v hexa 2>/dev/null").trim()
        let out1 = exec(cmd + " run '" + here + "/../tests/test.hexa'")
        println(out1)
        return
    }
    if sub == "help" || sub == "-h" || sub == "--help" {
        cmd_help()
        return
    }
    println("unknown subcommand: " + sub)
    cmd_help()
}
