// lib/detect.hexa — Apple-native env 감지 + own 1 enforcement (raw#9 hexa-only)
//
// own 1: Wine 0 — community wine 흔적 (Whisky / GPTK.app / CrossOver / gcenx tap / wine64 PATH) 검출.
//
// usage:
//   hexa run lib/detect.hexa --human       (default)
//   hexa run lib/detect.hexa --json
//   hexa run lib/detect.hexa --apple-only-check

use "./perf/r0_common"

fn detect_arch() -> str    { return exec("uname -m").trim() }
fn detect_macos() -> str   { return exec("sw_vers -productVersion 2>/dev/null").trim() }

fn detect_rosetta() -> str {
    let f = exec("test -f /Library/Apple/usr/share/rosetta/rosetta && echo ok").trim()
    if f == "ok" { return "installed" }
    let r = exec("arch -x86_64 /usr/bin/true 2>/dev/null && echo ok").trim()
    if r == "ok" { return "installed" }
    return "missing"
}

fn detect_metal() -> str {
    if detect_arch() == "arm64" { return "available" }
    return "unavailable"
}

fn detect_d3dmetal_dmg() -> str {
    let p = "/Volumes/Evaluation environment for Windows games 3.0/redist/lib/external/D3DMetal.framework"
    let f = exec("test -d '" + p + "' && echo ok").trim()
    if f == "ok" { return "mounted:GPTK_3.0" }
    let any = exec("ls -1 /Volumes/ 2>/dev/null | grep -c '^Evaluation environment for Windows games' || true").trim()
    if any != "0" && any != "" { return "mounted:other" }
    return "missing"
}

// own 1 violation 검출 — community wine 흔적
fn detect_apple_only_violations() -> str {
    let v = ""
    let _check = ""
    _check = exec("test -d '/Applications/Whisky.app' && echo Whisky.app || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -d '/Applications/Game Porting Toolkit.app' && echo GPTK.app || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -d '/Applications/CrossOver.app' && echo CrossOver.app || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -d '/opt/homebrew/Caskroom/whisky' && echo Caskroom/whisky || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -d '/opt/homebrew/Caskroom/game-porting-toolkit' && echo Caskroom/game-porting-toolkit || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -d '/opt/homebrew/Caskroom/crossover' && echo Caskroom/crossover || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -e '/opt/homebrew/bin/wine64' && echo wine64 || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -e '/opt/homebrew/bin/wineserver' && echo wineserver || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -L '/opt/homebrew/bin/wine64-preloader' && echo wine64-preloader || true").trim()
    if _check != "" { v = v + _check + " " }
    _check = exec("test -d '/opt/homebrew/Library/Taps/gcenx' && echo gcenx-tap || true").trim()
    if _check != "" { v = v + _check + " " }
    if v == "" { return "clean" }
    return "VIOLATIONS:" + v
}

fn build_json() -> str {
    let arch = detect_arch()
    let mac = detect_macos()
    let major = exec("sw_vers -productVersion | cut -d. -f1").trim()
    let ros = detect_rosetta()
    let metal = detect_metal()
    let d3dm = detect_d3dmetal_dmg()
    let viol = detect_apple_only_violations()
    let is_arm = "false"
    if arch == "arm64" { is_arm = "true" }
    return "{\"arch\":\"" + arch + "\",\"apple_silicon\":" + is_arm + ",\"macos_version\":\"" + mac + "\",\"macos_major\":" + major + ",\"rosetta2\":\"" + ros + "\",\"metal\":\"" + metal + "\",\"d3dmetal_dmg\":\"" + d3dm + "\",\"own1_violations\":\"" + viol + "\"}"
}

fn print_human() -> void {
    println("gamebox detect (own 1: Apple-only)")
    println("  arch:           " + detect_arch())
    println("  macOS:          " + detect_macos())
    println("  Rosetta 2:      " + detect_rosetta())
    println("  Metal:          " + detect_metal())
    println("  D3DMetal DMG:   " + detect_d3dmetal_dmg())
    println("")
    let v = detect_apple_only_violations()
    if v == "clean" {
        println("  ✓ own 1 clean — no community wine traces")
    } else {
        println("  ✗ own 1 VIOLATION: " + v)
    }
}

fn main() -> void {
    let a = args()
    let mode = "--human"
    if len(a) >= 3 { mode = a[2] }

    if mode == "--json" {
        println(build_json())
        return
    }
    if mode == "--apple-only-check" {
        let v = detect_apple_only_violations()
        println(v)
        return
    }
    if mode == "--rosetta" {
        println(detect_rosetta())
        return
    }
    if mode == "--metal" {
        println(detect_metal())
        return
    }
    print_human()
}
