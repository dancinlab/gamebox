// lib/loader/pe_manjeom_v2_aggregator.hexa — ★45+ 만점 컴포넌트 aggregator
//
// SCORING_V2.md ★25 확정 (5 D + 4 R + 4 own1 + 12 v2 신규) + ★22 후보 pool 추적기:
//   부록 B 만점 ⭐ 25 = D2/D3/D4/D5/D6 (5) + CN-1~CN-4 (4 own1-driven)
//                     + R1/R2/R3/R4 (4 R-list)
//                     + Sk-4/Sk-5 + T2-6/T2-7/T2-8 + Pf-1~5/Pf-9/Pf-10 (12 v2 신규)
//   ★22 후보 pool      = 14점 22 컴포넌트 (B/C 강화 후 만점 진입 가능)
//                       Sk-1/Sk-2/Sk-6/Sk-8/Sk-9/Sk-10, T1-1/T1-2/T1-8,
//                       T2-1~T2-5, Gs-1/Gs-2/Gs-3/Gs-5/Gs-6, Pf-6/Pf-7/Pf-8
//   ★47 max          = 25 확정 + 22 후보 (전체 승격 시 상한)
//
// 본 모듈은 raw component data 만 추적, 시각화는 별도. own1: 자체 dashboard,
// third-party CMS / Wine / CrossOver / community / GPTK / Whisky 인용 0 줄.
//
// own 1 enforcement: 외부 community 만점표 차용 X — airgenome 자체 채점기 데이터만.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// component_kind code:
//   1 = D_list           (v1 D2~D6 데이터재해석 만점)
//   2 = R_list           (v1 R1~R4, /10 만점)
//   3 = own1_driven      (v1 CN-1~CN-4 own1 자체 캐시/프로파일 layer)
//   4 = own2_skeleton    (v2 Sk-* skeleton + IPC layer)
//   5 = tier1_real       (v2 T1-* / T2-* tier 강화 함수 실구현)
//   6 = game_specific    (v2 Gs-* D2R/D4/CS2/Delta Force/Elden Ring/Lineage)
//   7 = infra            (v2 Pf-* perf trace + KPI + thermal)
//
// tier_score code:
//   10 = under threshold (≤12 폐기 카테고리, T1-6 등)
//   13 = 13점 후보       (Sk-3/Sk-7, T1-3/T1-4/T1-5/T1-7, Gs-4)
//   14 = 14점 후보       (★22 후보 pool — 만점 진입 미확정)
//   15 = 만점            (★25 확정 만점)
//
// confirmed code:
//   0 = 후보 (★22 14점 pool — 미확정)
//   1 = 확정 (★25 만점 또는 R-list /10 만점)
//
// persist schema (TSV — components.tsv):
//   component_id<str> \t component_kind<int> \t tier_score<int> \t confirmed<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmv2a_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_manjeom_v2_aggregator"
}

fn pmv2a_components_path() -> str {
    return pmv2a_dir() + "/components.tsv"
}

fn pmv2a_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmv2a_dir() + "'")
}

fn cleanup_pmv2a() -> void {
    pmv2a_ensure_dir()
    let _ = exec("rm -f '" + pmv2a_components_path() + "'")
}

// ─── 공통 file IO ───
fn pmv2a_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmv2a_append_row(path: str, row: str) -> void {
    pmv2a_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_component: 만점/후보 컴포넌트 1 건 기록 ───
fn record_component(component_id: str, component_kind: int, tier_score: int, confirmed: int) -> void {
    if component_id == "" {
        panic("pe_manjeom_v2_aggregator FAIL [record_component] expected=component_id!=\"\" got=\"\"")
    }
    if component_kind < 1 {
        panic("pe_manjeom_v2_aggregator FAIL [record_component] expected=component_kind>=1 got=" + to_string(component_kind))
    }
    if component_kind > 7 {
        panic("pe_manjeom_v2_aggregator FAIL [record_component] expected=component_kind<=7 got=" + to_string(component_kind))
    }
    if tier_score != 10 {
        if tier_score != 13 {
            if tier_score != 14 {
                if tier_score != 15 {
                    panic("pe_manjeom_v2_aggregator FAIL [record_component] expected=tier_score in {10,13,14,15} got=" + to_string(tier_score))
                }
            }
        }
    }
    if confirmed < 0 {
        panic("pe_manjeom_v2_aggregator FAIL [record_component] expected=confirmed>=0 got=" + to_string(confirmed))
    }
    if confirmed > 1 {
        panic("pe_manjeom_v2_aggregator FAIL [record_component] expected=confirmed<=1 got=" + to_string(confirmed))
    }
    let row = component_id + "\t" + to_string(component_kind)
        + "\t" + to_string(tier_score) + "\t" + to_string(confirmed) + "\n"
    pmv2a_append_row(pmv2a_components_path(), row)
}

// ─── component_count: total 등록 컴포넌트 수 ───
fn component_count() -> int {
    let t = pmv2a_read_table(pmv2a_components_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_component_kind: 특정 component_kind 의 컴포넌트 수 ───
fn count_by_component_kind(component_kind: int) -> int {
    let t = pmv2a_read_table(pmv2a_components_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == component_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_tier_score: 특정 tier_score 의 컴포넌트 수 ───
fn count_by_tier_score(tier_score: int) -> int {
    let t = pmv2a_read_table(pmv2a_components_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == tier_score {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── confirmed_count: confirmed=1 인 컴포넌트 수 ───
fn confirmed_count() -> int {
    let t = pmv2a_read_table(pmv2a_components_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── manjeom_count: tier_score=15 인 컴포넌트 수 (★ 만점 컴포넌트 totals) ───
fn manjeom_count() -> int {
    return count_by_tier_score(15)
}

// ─── component_tier: component_id 로 tier_score 조회 (없으면 0) ───
fn component_tier(component_id: str) -> int {
    let t = pmv2a_read_table(pmv2a_components_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == component_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pmv2a_stats: [component_count, manjeom_count, confirmed_count, count_by_tier_score(14)] ───
fn pmv2a_stats() -> array {
    let mut out = []
    out.push(component_count())
    out.push(manjeom_count())
    out.push(confirmed_count())
    out.push(count_by_tier_score(14))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pmv2a-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pmv2a()

    // 2. record 8 components — covers 5 component_kinds and tier scores 13/14/15.
    //    (kinds hit: 1=D_list, 2=R_list, 3=own1_driven, 4=own2_skeleton, 7=infra)
    //    (tiers   : 13 ×1, 14 ×3, 15 ×4)

    // C1: D_list 만점 — D2 pso_genome (확정)
    record_component("D2_pso_genome", 1, 15, 1)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"D2_pso_genome\",\"component_kind\":1,\"tier_score\":15,\"confirmed\":1")

    // C2: R_list 만점 — R1 d3dmetal_shader_cache (/10 만점, 확정)
    record_component("R1_d3dmetal_shader_cache", 2, 15, 1)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"R1_d3dmetal_shader_cache\",\"component_kind\":2,\"tier_score\":15,\"confirmed\":1")

    // C3: own1_driven 만점 — CN-1 C-PE-PARSE-CACHE (확정)
    record_component("CN1_pe_parse_cache", 3, 15, 1)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"CN1_pe_parse_cache\",\"component_kind\":3,\"tier_score\":15,\"confirmed\":1")

    // C4: own2_skeleton 만점 — Sk-4 pe_to_macho_shim_track (v2 신규 확정)
    record_component("Sk4_pe_to_macho_shim_track", 4, 15, 1)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"Sk4_pe_to_macho_shim_track\",\"component_kind\":4,\"tier_score\":15,\"confirmed\":1")

    // C5: own2_skeleton 후보 — Sk-1 pe_section_mapper_real (14점 후보)
    record_component("Sk1_pe_section_mapper_real", 4, 14, 0)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"Sk1_pe_section_mapper_real\",\"component_kind\":4,\"tier_score\":14,\"confirmed\":0")

    // C6: own2_skeleton 후보 — Sk-2 pe_iat_direct_resolve_real (14점 후보)
    record_component("Sk2_pe_iat_direct_resolve_real", 4, 14, 0)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"Sk2_pe_iat_direct_resolve_real\",\"component_kind\":4,\"tier_score\":14,\"confirmed\":0")

    // C7: infra 후보 — Pf-7 c_pe_runtime_layout_track (14점 후보)
    record_component("Pf7_c_pe_runtime_layout_track", 7, 14, 0)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"Pf7_c_pe_runtime_layout_track\",\"component_kind\":7,\"tier_score\":14,\"confirmed\":0")

    // C8: own2_skeleton 13점 — Sk-3 pe_native_dlopen_real (helper 의존)
    record_component("Sk3_pe_native_dlopen_real", 4, 13, 0)
    r0_emit("pe_manjeom_v2_aggregator_record",
        "\"component_id\":\"Sk3_pe_native_dlopen_real\",\"component_kind\":4,\"tier_score\":13,\"confirmed\":0")

    // 3. component_count = 8
    let cc = component_count()
    if cc != 8 {
        panic("pe_manjeom_v2_aggregator FAIL [component_count] expected=8 got=" + to_string(cc))
    }

    // 4. count_by_component_kind sanity (≥4 component_kinds present)
    let k1 = count_by_component_kind(1)
    if k1 != 1 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_component_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_component_kind(2)
    if k2 != 1 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_component_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_component_kind(3)
    if k3 != 1 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_component_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_component_kind(4)
    if k4 != 4 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_component_kind(4)] expected=4 got=" + to_string(k4))
    }
    let k7 = count_by_component_kind(7)
    if k7 != 1 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_component_kind(7)] expected=1 got=" + to_string(k7))
    }
    let k_miss = count_by_component_kind(6)
    if k_miss != 0 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_component_kind(6)] expected=0 got=" + to_string(k_miss))
    }

    // 5. count_by_tier_score sanity — 13,14,15 covered
    let s13 = count_by_tier_score(13)
    if s13 != 1 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_tier_score(13)] expected=1 got=" + to_string(s13))
    }
    let s14 = count_by_tier_score(14)
    if s14 != 3 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_tier_score(14)] expected=3 got=" + to_string(s14))
    }
    let s15 = count_by_tier_score(15)
    if s15 != 4 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_tier_score(15)] expected=4 got=" + to_string(s15))
    }
    let s10 = count_by_tier_score(10)
    if s10 != 0 {
        panic("pe_manjeom_v2_aggregator FAIL [count_by_tier_score(10)] expected=0 got=" + to_string(s10))
    }

    // 6. confirmed_count = 4 (C1-C4 모두 confirmed=1)
    let cf = confirmed_count()
    if cf != 4 {
        panic("pe_manjeom_v2_aggregator FAIL [confirmed_count] expected=4 got=" + to_string(cf))
    }

    // 7. manjeom_count = count_by_tier_score(15) = 4
    let mj = manjeom_count()
    if mj != 4 {
        panic("pe_manjeom_v2_aggregator FAIL [manjeom_count] expected=4 got=" + to_string(mj))
    }

    // 8. component_tier lookup
    let t_sk4 = component_tier("Sk4_pe_to_macho_shim_track")
    if t_sk4 != 15 {
        panic("pe_manjeom_v2_aggregator FAIL [component_tier(Sk4)] expected=15 got=" + to_string(t_sk4))
    }
    let t_sk3 = component_tier("Sk3_pe_native_dlopen_real")
    if t_sk3 != 13 {
        panic("pe_manjeom_v2_aggregator FAIL [component_tier(Sk3)] expected=13 got=" + to_string(t_sk3))
    }
    let t_miss = component_tier("nonexistent_component")
    if t_miss != 0 {
        panic("pe_manjeom_v2_aggregator FAIL [component_tier(miss)] expected=0 got=" + to_string(t_miss))
    }

    // 9. pmv2a_stats() = [8, 4, 4, 3]
    let s = pmv2a_stats()
    if len(s) != 4 {
        panic("pe_manjeom_v2_aggregator FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_manjeom_v2_aggregator FAIL [stats component_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_manjeom_v2_aggregator FAIL [stats manjeom_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_manjeom_v2_aggregator FAIL [stats confirmed_count] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_manjeom_v2_aggregator FAIL [stats tier14_count] expected=3 got=" + to_string(s[3]))
    }

    // 10. emit aggregate stats
    r0_emit("pe_manjeom_v2_aggregator_stats",
        "\"component_count\":" + to_string(s[0])
        + ",\"manjeom_count\":" + to_string(s[1])
        + ",\"confirmed_count\":" + to_string(s[2])
        + ",\"tier14_count\":" + to_string(s[3]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_manjeom_v2_aggregator FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pmv2a()
    let s2 = pmv2a_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_manjeom_v2_aggregator FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_manjeom_v2_aggregator self_test PASS (components=" + to_string(s[0])
        + ", manjeom=" + to_string(s[1]) + ", confirmed=" + to_string(s[2])
        + ", tier14=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmv2a_stats()
            println("component_count\t" + to_string(s[0]))
            println("manjeom_count\t" + to_string(s[1]))
            println("confirmed_count\t" + to_string(s[2]))
            println("tier14_count\t" + to_string(s[3]))
            return
        }
        if sub == "tier" {
            if len(a) >= 4 {
                let cid = a[3]
                println("tier\t" + to_string(component_tier(cid)))
                return
            }
            println("usage: hexa run pe_manjeom_v2_aggregator.hexa tier <component_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let val = to_int(a[4])
                if dim == "kind" {
                    println("count_by_component_kind\t" + to_string(count_by_component_kind(val)))
                    return
                }
                if dim == "tier" {
                    println("count_by_tier_score\t" + to_string(count_by_tier_score(val)))
                    return
                }
                println("usage: hexa run pe_manjeom_v2_aggregator.hexa count { kind | tier } <value>")
                return
            }
            println("usage: hexa run pe_manjeom_v2_aggregator.hexa count { kind | tier } <value>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmv2a()
            println("cleaned: " + pmv2a_dir())
            return
        }
        if sub == "dir" {
            println(pmv2a_dir())
            return
        }
    }
    println("usage: hexa run pe_manjeom_v2_aggregator.hexa { self-test | stats | tier <component_id> | count kind <component_kind> | count tier <tier_score> | cleanup | dir }")
}
