// lib/loader/pe_resource_string.hexa — cycle 79 PE resource string load tracker
//
// Win32 LoadStringW / LoadAcceleratorsW / LoadIconW / LoadMenuW / DialogBoxW
// 등 PE .rsrc section 자원 접근 telemetry. RT_STRING / RT_ACCELERATOR /
// RT_ICON / RT_DIALOG / RT_MENU / RT_BITMAP 분류 + language_id (LCID) 추적.
//
// own 1 enforcement: Wine / CrossOver / community resource loader 코드 0 줄.
//   본 module 은 load event tracker — 실 LoadResource() / LockResource() 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// resource_kind code:
//   1 = RT_STRING
//   2 = RT_ACCELERATOR
//   3 = RT_ICON
//   4 = RT_DIALOG
//   5 = RT_MENU
//   6 = RT_BITMAP
//
// language_id (LCID, 일부 예시):
//   1033 = en-US
//   1041 = ja-JP
//   1042 = ko-KR
//   2052 = zh-CN
//
// persist schema (TSV — loads.tsv):
//   load_id<int> \t resource_kind<int> \t language_id<int> \t data_bytes<int>
//
// 본 prefix 는 prs_res_* — pe_reloc_stage2.hexa 의 prs_* 및
// pe_resource_section.hexa 의 prss_* 와 모두 충돌 없음.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn prs_res_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_resource_string"
}

fn prs_res_loads_path() -> str {
    return prs_res_dir() + "/loads.tsv"
}

fn prs_res_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + prs_res_dir() + "'")
}

fn cleanup_prs_res() -> void {
    prs_res_ensure_dir()
    let _ = exec("rm -f '" + prs_res_loads_path() + "'")
}

// ─── 공통 file IO ───
fn prs_res_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn prs_res_append_row(path: str, row: str) -> void {
    prs_res_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_load: resource load 1 건 기록 ───
fn record_load(load_id: int, resource_kind: int, language_id: int, data_bytes: int) -> void {
    if load_id <= 0 {
        panic("pe_resource_string FAIL [record_load] expected=load_id>0 got=" + to_string(load_id))
    }
    if resource_kind < 1 {
        panic("pe_resource_string FAIL [record_load] expected=resource_kind>=1 got=" + to_string(resource_kind))
    }
    if resource_kind > 6 {
        panic("pe_resource_string FAIL [record_load] expected=resource_kind<=6 got=" + to_string(resource_kind))
    }
    if language_id < 0 {
        panic("pe_resource_string FAIL [record_load] expected=language_id>=0 got=" + to_string(language_id))
    }
    if data_bytes < 0 {
        panic("pe_resource_string FAIL [record_load] expected=data_bytes>=0 got=" + to_string(data_bytes))
    }
    let row = to_string(load_id) + "\t" + to_string(resource_kind)
        + "\t" + to_string(language_id) + "\t" + to_string(data_bytes) + "\n"
    prs_res_append_row(prs_res_loads_path(), row)
}

// ─── load_count: total load 수 ───
fn load_count() -> int {
    let t = prs_res_read_table(prs_res_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_data_bytes: 모든 load 의 data_bytes 합 ───
fn total_data_bytes() -> int {
    let t = prs_res_read_table(prs_res_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_resource_kind: 특정 resource_kind 의 load 수 ───
fn count_by_resource_kind(kind: int) -> int {
    let t = prs_res_read_table(prs_res_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_languages: 등장한 language_id 의 distinct 개수 ───
fn distinct_languages() -> int {
    let t = prs_res_read_table(prs_res_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let lang = to_int(parts[2])
                let mut found = 0
                let j = 0
                while j < len(seen) {
                    if seen[j] == lang {
                        found = 1
                    }
                    j = j + 1
                }
                if found == 0 {
                    seen.push(lang)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── load_data_bytes: 특정 load_id 의 data_bytes (없으면 0) ───
fn load_data_bytes(load_id: int) -> int {
    let t = prs_res_read_table(prs_res_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == load_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── prs_res_stats: [load_count, total_data_bytes, distinct_languages, count_by_resource_kind(1)] ───
fn prs_res_stats() -> array {
    let mut out = []
    out.push(load_count())
    out.push(total_data_bytes())
    out.push(distinct_languages())
    out.push(count_by_resource_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "prs-res-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_prs_res()

    // 2. record 5 loads — 4 distinct resource_kinds (1,2,3,5), 2 languages (1042, 1033)
    record_load(790001, 1, 1042, 256)
    r0_emit("pe_resource_string_record",
        "\"load_id\":790001,\"resource_kind\":1,\"language_id\":1042,\"data_bytes\":256,\"target\":\"RT_STRING\"")

    record_load(790002, 1, 1033, 192)
    r0_emit("pe_resource_string_record",
        "\"load_id\":790002,\"resource_kind\":1,\"language_id\":1033,\"data_bytes\":192,\"target\":\"RT_STRING\"")

    record_load(790003, 2, 1042, 64)
    r0_emit("pe_resource_string_record",
        "\"load_id\":790003,\"resource_kind\":2,\"language_id\":1042,\"data_bytes\":64,\"target\":\"RT_ACCELERATOR\"")

    record_load(790004, 3, 1042, 1024)
    r0_emit("pe_resource_string_record",
        "\"load_id\":790004,\"resource_kind\":3,\"language_id\":1042,\"data_bytes\":1024,\"target\":\"RT_ICON\"")

    record_load(790005, 5, 1033, 128)
    r0_emit("pe_resource_string_record",
        "\"load_id\":790005,\"resource_kind\":5,\"language_id\":1033,\"data_bytes\":128,\"target\":\"RT_MENU\"")

    // 3. load_count = 5
    let c = load_count()
    if c != 5 {
        panic("pe_resource_string FAIL [load_count] expected=5 got=" + to_string(c))
    }

    // 4. total_data_bytes = 1664
    let tb = total_data_bytes()
    if tb != 1664 {
        panic("pe_resource_string FAIL [total_data_bytes] expected=1664 got=" + to_string(tb))
    }

    // 5. count_by_resource_kind sanity
    let k1 = count_by_resource_kind(1)
    if k1 != 2 {
        panic("pe_resource_string FAIL [count_by_resource_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_resource_kind(2)
    if k2 != 1 {
        panic("pe_resource_string FAIL [count_by_resource_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_resource_kind(3)
    if k3 != 1 {
        panic("pe_resource_string FAIL [count_by_resource_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_resource_kind(4)
    if k4 != 0 {
        panic("pe_resource_string FAIL [count_by_resource_kind(4)] expected=0 got=" + to_string(k4))
    }
    let k5 = count_by_resource_kind(5)
    if k5 != 1 {
        panic("pe_resource_string FAIL [count_by_resource_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k6 = count_by_resource_kind(6)
    if k6 != 0 {
        panic("pe_resource_string FAIL [count_by_resource_kind(6)] expected=0 got=" + to_string(k6))
    }

    // 6. distinct_languages = 2
    let dl = distinct_languages()
    if dl != 2 {
        panic("pe_resource_string FAIL [distinct_languages] expected=2 got=" + to_string(dl))
    }

    // 7. load_data_bytes sanity
    let b1 = load_data_bytes(790001)
    if b1 != 256 {
        panic("pe_resource_string FAIL [load_data_bytes(790001)] expected=256 got=" + to_string(b1))
    }
    let b4 = load_data_bytes(790004)
    if b4 != 1024 {
        panic("pe_resource_string FAIL [load_data_bytes(790004)] expected=1024 got=" + to_string(b4))
    }
    let b_miss = load_data_bytes(9999)
    if b_miss != 0 {
        panic("pe_resource_string FAIL [load_data_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 8. prs_res_stats() = [5, 1664, 2, 2]
    let s = prs_res_stats()
    if len(s) != 4 {
        panic("pe_resource_string FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_resource_string FAIL [stats load_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 1664 {
        panic("pe_resource_string FAIL [stats total_data_bytes] expected=1664 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_resource_string FAIL [stats distinct_languages] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_resource_string FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_resource_string_stats",
        "\"load_count\":" + to_string(s[0])
        + ",\"total_data_bytes\":" + to_string(s[1])
        + ",\"distinct_languages\":" + to_string(s[2])
        + ",\"kind_string\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_resource_string FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_prs_res()
    let s2 = prs_res_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_resource_string FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_resource_string self_test PASS (loads=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", langs=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = prs_res_stats()
            println("load_count\t" + to_string(s[0]))
            println("total_data_bytes\t" + to_string(s[1]))
            println("distinct_languages\t" + to_string(s[2]))
            println("count_kind_string\t" + to_string(s[3]))
            return
        }
        if sub == "bytes" {
            if len(a) >= 4 {
                let lid = to_int(a[3])
                println("load_data_bytes\t" + to_string(load_data_bytes(lid)))
                return
            }
            println("usage: hexa run pe_resource_string.hexa bytes <load_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_resource_kind\t" + to_string(count_by_resource_kind(kind)))
                return
            }
            println("usage: hexa run pe_resource_string.hexa count <resource_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_prs_res()
            println("cleaned: " + prs_res_dir())
            return
        }
        if sub == "dir" {
            println(prs_res_dir())
            return
        }
    }
    println("usage: hexa run pe_resource_string.hexa { self-test | stats | bytes <load_id> | count <resource_kind> | cleanup | dir }")
}
