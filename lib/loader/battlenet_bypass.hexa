// ─── OWN1 DISAMBIGUATION — TRACK P 2026-05-03 ──────────────────
// "bypass" naming 측 own1 (Wine 0 / NO DRM evasion) 정합 disambiguation:
//   - SCOPE (in-scope, own1 정합): Battle.net launcher 부재 시 단독 실행 path
//                                  (launcher-absence standalone enumeration)
//                                  + feasibility matrix honest emit (D2R feasible,
//                                  D4 NOT feasible — online-only / server-side auth
//                                  / always-online DRM blocker 정직 보고)
//   - NOT IN SCOPE (영구 out-of-scope per own1):
//     * DRM evasion / license circumvention
//     * Account authentication bypass
//     * Warden anti-cheat bypass / hook chain shim / signature spoof / NOP-patch
//     * GameGuard kernel-mode AC bypass (non-Blizzard family)
//     * Online ToS violation tooling / cheat / botting
//     * Battle.net 계정 탈취 / fraud / ticket validation 우회
//     * Wine / CrossOver / Whisky / GPTK staging patch import
//   - VERDICT: PASS — module honestly enumerates feasibility (D4 NOT feasible
//                     정직 보고 + blockers list) + spec emit (path / dep / token
//                     cache spec) only. bypass / evasion / circumvent / hook-chain
//                     shim / NOP-patch 코드 0줄. 모든 "bypass" 단어 negation context
//                     (e.g. "community bypass 코드 0 줄", "BNET_BYPASS=1" env name
//                     은 launcher-absence flag — DRM bypass 의미 X) only.
//   - REFERENCE: docs/BATTLENET_BYPASS_OWN1_DISAMBIGUATION.md (Track P mk1 narrative)
//   - SISTER: docs/WARDEN_HONEST_FREEZE.md (Track J, user-mode AC honest freeze)
//             docs/GAMEGUARD_HONEST_FREEZE.md (Track E, kernel-mode AC honest freeze)
//             docs/D2R_REALM_PROTOCOL_HONEST_FREEZE.md (Track L, network protocol)
//   - 6 BG-AGB rank B+C unblock: 본 disambiguation land 시점 측 다음 6 candidates
//     (loader_native_helper / perf_manjeom / perf_game_d2r / perf_game_d4 /
//     closure_orchestrator / battlenet_bypass) cycle 측 own1 review gate 통과.
//   - additive_only: 본 annotation block PREPEND only — 기존 fn / self_test /
//     main / TSV schema / r0_emit content 측 modification 0건. destructive_ops 0.
// ──────────────────────────────────────────────────────────────
// lib/loader/battlenet_bypass.hexa — Phase 8 — Battle.net 우회 skeleton
//
// own 1 enforcement: Battle.net launcher / Blizzard SDK / community bypass 코드 0 줄.
//   참조 only — 공개 PE / Wine prefix layout / OAuth bearer 일반 spec.
//   Wine / Lutris / Heroic / community bypass 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 2: bypass_check + bypass_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("battlenet_bypass FAIL [<sub>] expected=X got=Y")
//
// 문제 정의:
//   D2R / D4 는 Battle.net launcher (Battle.net.exe) 경유로 시작되어
//     1) auth (OAuth bearer token)
//     2) version check (ProductDB.json)
//     3) DRM ticket
//     4) region routing
//   을 launcher 가 처리한 뒤 game.exe 를 spawn 한다.
//
//   우리의 우회 전략:
//     - launcher 없이 game.exe 직접 spawn
//     - 사전에 auth token 을 cache 위치에 inject (사용자 manual 추출 — 우리는 path 만 spec)
//     - version check + DRM 은 game-별 feasibility 에 따라 가능/불가
//
//   feasibility 매트릭스:
//     D2R — feasible: offline mode 존재, single-player 만이면 launcher 우회 가능
//     D4  — not feasible: online-only, server-side auth 강제, 우회 불가능 (정직하게 보고)
//
// 범위 (Phase 8 — skeleton):
//   path / dependency / spec 만. 실제 token inject 는 Phase 8 후속.

use "../perf/r0_common"

// ─── Battle.net launcher 경로 추정 (Wine prefix 기준) ───
//
//   Wine prefix 의 표준 위치: <prefix>/drive_c/Program Files (x86)/Battle.net/Battle.net.exe
fn battlenet_launcher_path(prefix: str) -> str {
    return prefix + "/drive_c/Program Files (x86)/Battle.net/Battle.net.exe"
}

// ─── Battle.net 의존성 분석 — D2R / D4 가 launcher 에서 받아오는 정보 ───
//
//   각 entry = [name, description]
//   stage1 hexa array of array.
fn battlenet_deps() -> array {
    let mut d = []
    d.push(["auth_token",     "OAuth bearer (us.battle.net OAuth2)"])
    d.push(["version_check",  "ProductDB.json (current build hash)"])
    d.push(["region",         "us-east / eu / kr routing endpoint"])
    d.push(["drm_ticket",     "per-launch DRM ticket (online-only games)"])
    d.push(["session_id",     "launcher-issued session UUID"])
    d.push(["product_code",   "OSI / D2R / FENRIS (D4) — game key"])
    return d
}

// ─── auth token cache path (synthetic) ───
//
//   실제 token 은 사용자가 manual 로 추출/제공해야 함.
//   우리는 cache 위치 spec 만 — 표준 Battle.net 의 token store 흉내.
fn auth_token_cache_path() -> str {
    return "/tmp/airgenome/battlenet/auth_token.cache"
}

// ─── game.exe 직접 launch spec — Wine prefix + env + cmdline (JSON) ───
//
//   game = "d2r" | "d4" | ... — 게임 short code
//   prefix = Wine prefix path
//   반환: JSON-like string spec.
fn direct_launch_spec(game: str, prefix: str) -> str {
    let mut g_exe = ""
    let mut g_args = ""
    if game == "d2r" {
        g_exe = "Diablo II Resurrected/D2R.exe"
        g_args = "-launch -skiptobnet"
    }
    if game == "d4" {
        g_exe = "Diablo IV/Diablo IV.exe"
        g_args = "-launch"
    }
    if g_exe == "" {
        g_exe = game + "/" + game + ".exe"
        g_args = ""
    }
    let mut s = "{"
    s = s + "\"game\":\"" + game + "\""
    s = s + ",\"prefix\":\"" + prefix + "\""
    s = s + ",\"exe\":\"" + g_exe + "\""
    s = s + ",\"args\":\"" + g_args + "\""
    s = s + ",\"env\":{\"WINEPREFIX\":\"" + prefix + "\",\"BNET_BYPASS\":\"1\"}"
    s = s + ",\"token_cache\":\"" + auth_token_cache_path() + "\""
    s = s + "}"
    return s
}

// ─── 우회 가능성 검증 ───
//
//   반환: [feasible_bool, reason, blockers]
//     feasible_bool: true / false
//     reason       : 한 줄 설명
//     blockers     : array of blocker name (online-only 인 경우)
//
//   D2R: feasible — offline mode 존재.
//   D4 : not feasible — online-only auth, server-side validation 강제.
fn bypass_feasibility(game: str) -> array {
    let mut r = []
    if game == "d2r" {
        let blockers = []
        r.push(true)
        r.push("D2R supports offline mode — launcher bypass viable with cached profile")
        r.push(blockers)
        return r
    }
    if game == "d4" {
        let mut blockers = []
        blockers.push("server_side_auth")
        blockers.push("always_online_drm")
        blockers.push("ProductDB version handshake")
        r.push(false)
        r.push("D4 is online-only — server-side auth blocks any launcher bypass")
        r.push(blockers)
        return r
    }
    // unknown
    let mut blockers = []
    blockers.push("unknown_game")
    r.push(false)
    r.push("unknown game code — feasibility undetermined")
    r.push(blockers)
    return r
}

// ─── stat ───
//
//   array of [game, status]
//     status = "feasible" | "blocked"
fn bypass_stats() -> array {
    let mut s = []
    let games = ["d2r", "d4"]
    let n = len(games)
    let i = 0
    while i < n {
        let f = bypass_feasibility(games[i])
        let mut st = "blocked"
        if f[0] == true {
            st = "feasible"
        }
        s.push([games[i], st])
        i = i + 1
    }
    return s
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "bnetbp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. battlenet_launcher_path("/test/prefix") contains "Battle.net.exe"
    let lp = battlenet_launcher_path("/test/prefix")
    if lp.contains("Battle.net.exe") == false {
        panic("battlenet_bypass FAIL [launcher_path] expected=contains Battle.net.exe got=" + lp)
    }
    if lp.contains("/test/prefix") == false {
        panic("battlenet_bypass FAIL [launcher_path prefix] expected=contains /test/prefix got=" + lp)
    }
    if lp.contains("Program Files (x86)") == false {
        panic("battlenet_bypass FAIL [launcher_path program files] expected=contains 'Program Files (x86)' got=" + lp)
    }

    // 2. battlenet_deps() ≥ 3 dependencies, 각 entry [name, desc]
    let deps = battlenet_deps()
    let dn = len(deps)
    if dn < 3 {
        panic("battlenet_bypass FAIL [deps count] expected=>=3 got=" + to_string(dn))
    }
    let i = 0
    while i < dn {
        if len(deps[i]) != 2 {
            panic("battlenet_bypass FAIL [deps shape] expected=[name,desc] got=arity " + to_string(len(deps[i])))
        }
        i = i + 1
    }

    // 3. auth_token_cache_path() non-empty
    let tp = auth_token_cache_path()
    if tp == "" {
        panic("battlenet_bypass FAIL [token_cache_path] expected=non-empty got=empty")
    }

    // 4. direct_launch_spec("d2r", "/test/prefix") contains "d2r" + "prefix"
    let spec_d2r = direct_launch_spec("d2r", "/test/prefix")
    if spec_d2r.contains("d2r") == false {
        panic("battlenet_bypass FAIL [spec d2r game] expected=contains d2r got=" + spec_d2r)
    }
    if spec_d2r.contains("/test/prefix") == false {
        panic("battlenet_bypass FAIL [spec d2r prefix] expected=contains /test/prefix got=" + spec_d2r)
    }
    if spec_d2r.contains("D2R.exe") == false {
        panic("battlenet_bypass FAIL [spec d2r exe] expected=contains D2R.exe got=" + spec_d2r)
    }
    let spec_d4 = direct_launch_spec("d4", "/test/prefix")
    if spec_d4.contains("Diablo IV.exe") == false {
        panic("battlenet_bypass FAIL [spec d4 exe] expected=contains Diablo IV.exe got=" + spec_d4)
    }

    // 5. bypass_feasibility("d2r") → [true, "...offline mode...", ...]
    let f_d2r = bypass_feasibility("d2r")
    if len(f_d2r) != 3 {
        panic("battlenet_bypass FAIL [feasibility d2r arity] expected=3 got=" + to_string(len(f_d2r)))
    }
    if f_d2r[0] != true {
        panic("battlenet_bypass FAIL [feasibility d2r flag] expected=true got=false")
    }
    let reason_d2r = f_d2r[1]
    if reason_d2r.contains("offline mode") == false {
        panic("battlenet_bypass FAIL [feasibility d2r reason] expected=contains 'offline mode' got=" + reason_d2r)
    }

    // 6. bypass_feasibility("d4") → [false, "...online-only...", ...]
    let f_d4 = bypass_feasibility("d4")
    if len(f_d4) != 3 {
        panic("battlenet_bypass FAIL [feasibility d4 arity] expected=3 got=" + to_string(len(f_d4)))
    }
    if f_d4[0] != false {
        panic("battlenet_bypass FAIL [feasibility d4 flag] expected=false got=true")
    }
    let reason_d4 = f_d4[1]
    if reason_d4.contains("online-only") == false {
        panic("battlenet_bypass FAIL [feasibility d4 reason] expected=contains 'online-only' got=" + reason_d4)
    }
    let blockers_d4 = f_d4[2]
    if len(blockers_d4) < 1 {
        panic("battlenet_bypass FAIL [feasibility d4 blockers] expected=>=1 got=" + to_string(len(blockers_d4)))
    }

    // 7. r0_emit "bypass_check"
    r0_emit("bypass_check",
        "\"game\":\"d2r\",\"feasible\":true,\"d4_feasible\":false,\"deps\":" + to_string(dn))

    // 8. bypass_stats() — [d2r=feasible, d4=blocked]
    let stats = bypass_stats()
    let sn = len(stats)
    if sn < 2 {
        panic("battlenet_bypass FAIL [stats count] expected=>=2 got=" + to_string(sn))
    }
    let mut found_d2r_feasible = false
    let mut found_d4_blocked = false
    let j = 0
    while j < sn {
        if stats[j][0] == "d2r" {
            if stats[j][1] == "feasible" {
                found_d2r_feasible = true
            }
        }
        if stats[j][0] == "d4" {
            if stats[j][1] == "blocked" {
                found_d4_blocked = true
            }
        }
        let k = j + 1
        j = k
    }
    if found_d2r_feasible == false {
        panic("battlenet_bypass FAIL [stats d2r] expected=feasible got=missing")
    }
    if found_d4_blocked == false {
        panic("battlenet_bypass FAIL [stats d4] expected=blocked got=missing")
    }

    // 9. r0_emit "bypass_stats"
    r0_emit("bypass_stats",
        "\"games\":" + to_string(sn) + ",\"d2r\":\"feasible\",\"d4\":\"blocked\"")

    // R0 emit count 검증 — 정확히 2 events
    let emit_n = r0_session_count(sid)
    if emit_n != 2 {
        panic("battlenet_bypass FAIL [r0 emit count] expected=2 got=" + to_string(emit_n))
    }

    println("  ✅ battlenet_bypass self_test PASS (deps=" + to_string(dn) + ", d2r feasible, d4 blocked, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "launcher-path" {
            if len(a) >= 4 {
                println(battlenet_launcher_path(a[3]))
                return
            }
        }
        if sub == "deps" {
            let d = battlenet_deps()
            let n = len(d)
            let i = 0
            while i < n {
                println(d[i][0] + "\t" + d[i][1])
                i = i + 1
            }
            return
        }
        if sub == "token-cache" {
            println(auth_token_cache_path())
            return
        }
        if sub == "spec" {
            if len(a) >= 5 {
                println(direct_launch_spec(a[3], a[4]))
                return
            }
        }
        if sub == "feasibility" {
            if len(a) >= 4 {
                let f = bypass_feasibility(a[3])
                let mut flag = "false"
                if f[0] == true {
                    flag = "true"
                }
                println(flag + "\t" + f[1])
                let bs = f[2]
                let bn = len(bs)
                let i = 0
                while i < bn {
                    println("  blocker: " + bs[i])
                    i = i + 1
                }
                return
            }
        }
        if sub == "stats" {
            let s = bypass_stats()
            let n = len(s)
            let i = 0
            while i < n {
                println(s[i][0] + "\t" + s[i][1])
                i = i + 1
            }
            return
        }
    }
    println("usage: hexa run battlenet_bypass.hexa { self-test | launcher-path <prefix> | deps | token-cache | spec <game> <prefix> | feasibility <game> | stats }")
}
