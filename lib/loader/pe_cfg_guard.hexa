// lib/loader/pe_cfg_guard.hexa — stage3 PE Control Flow Guard metadata skeleton
//
// PE LoadConfig.GuardCFFunctionTable: indirect call valid target bitmap.
// Microsoft CFG = anti-ROP/JOP. macOS 환경에서는 emulation 없음 — 무시 또는
// no-op stub. 본 module 은 CFG metadata 추적만.
//
// own 1 enforcement: Wine / CrossOver / community PE loader 코드 0 줄.
//   참조 only — Microsoft PE/COFF spec (learn.microsoft.com),
//   IMAGE_LOAD_CONFIG_DIRECTORY.GuardCFFunctionTable / GuardFlags.
// own 2 mandate:
//   - r0_emit ≥ 4 (record_cfg × 3 + summary marker)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("pe_cfg_guard FAIL [<sub>] expected=X got=Y")
//
// table schema (TSV, 4-key):
//   pcg_log.tsv — "pe_id\tvalid_target_count\tsuppression_count\tcfg_enabled\n"
//
// 동작 흐름 (skeleton):
//   1. record_cfg(pe_id, valid_target_count, suppression_count, cfg_enabled)
//      pcg_log.tsv 에 행 append. cfg_enabled = LoadConfig.GuardFlags &
//      IMAGE_GUARD_CF_INSTRUMENTED 이면 1.
//   2. cfg_count() — 행 수.
//   3. enabled_count() — cfg_enabled=1 행 수.
//   4. total_valid_targets() / total_suppressions() — 합계.
//   5. pe_target_count(pe_id) — pe_id 의 valid_target_count.
//   6. pcg_stats() — [cfg_count, enabled_count, total_valid_targets,
//                     total_suppressions].
//
// 실 CFG 검증 (indirect call target validation) 은 stage4. macOS native
// 환경에서는 PE bitmap 의미 없음 → no-op.

use "../perf/r0_common"

// ─── persist 디렉토리 (4-key 작업 영역) ───
fn pcg_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_cfg_guard"
}

fn pcg_log_path() -> str {
    return pcg_dir() + "/pcg_log.tsv"
}

fn ensure_pcg_dir() -> void {
    let _ = exec("mkdir -p '" + pcg_dir() + "'")
}

fn cleanup_pcg() -> void {
    ensure_pcg_dir()
    let _ = exec("rm -f '" + pcg_log_path() + "'")
}

// ─── 공통 file IO ───
fn pcg_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcg_append_row(path: str, row: str) -> void {
    ensure_pcg_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_cfg: pcg_log.tsv 행 추가 + r0_emit ───
fn record_cfg(pe_id: int, valid_target_count: int, suppression_count: int, cfg_enabled: int) -> void {
    let row = to_string(pe_id) + "\t" + to_string(valid_target_count)
        + "\t" + to_string(suppression_count) + "\t" + to_string(cfg_enabled) + "\n"
    pcg_append_row(pcg_log_path(), row)
    r0_emit("pcg_record",
        "\"pe_id\":" + to_string(pe_id)
        + ",\"valid_target_count\":" + to_string(valid_target_count)
        + ",\"suppression_count\":" + to_string(suppression_count)
        + ",\"cfg_enabled\":" + to_string(cfg_enabled))
}

// ─── cfg_count: log 의 행 수 ───
fn cfg_count() -> int {
    let mut row_n = 0
    let t = pcg_read_table(pcg_log_path())
    if t != "" {
        let lines = t.split("\n")
        let n = len(lines)
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    row_n = row_n + 1
                }
            }
            i = i + 1
        }
    }
    return row_n
}

// ─── enabled_count: cfg_enabled=1 행 수 ───
fn enabled_count() -> int {
    let mut en = 0
    let t = pcg_read_table(pcg_log_path())
    if t != "" {
        let lines = t.split("\n")
        let n = len(lines)
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    if to_int(parts[3]) == 1 {
                        en = en + 1
                    }
                }
            }
            i = i + 1
        }
    }
    return en
}

// ─── total_valid_targets: valid_target_count 합 ───
fn total_valid_targets() -> int {
    let mut sum_v = 0
    let t = pcg_read_table(pcg_log_path())
    if t != "" {
        let lines = t.split("\n")
        let n = len(lines)
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    sum_v = sum_v + to_int(parts[1])
                }
            }
            i = i + 1
        }
    }
    return sum_v
}

// ─── total_suppressions: suppression_count 합 ───
fn total_suppressions() -> int {
    let mut sum_s = 0
    let t = pcg_read_table(pcg_log_path())
    if t != "" {
        let lines = t.split("\n")
        let n = len(lines)
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    sum_s = sum_s + to_int(parts[2])
                }
            }
            i = i + 1
        }
    }
    return sum_s
}

// ─── pe_target_count: pe_id 의 valid_target_count ───
fn pe_target_count(pe_id: int) -> int {
    let t = pcg_read_table(pcg_log_path())
    if t == "" {
        return 0
    }
    let target = to_string(pe_id)
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == target {
                    return to_int(parts[1])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pcg_stats: [cfg_count, enabled_count, total_valid_targets, total_suppressions] ───
fn pcg_stats() -> array {
    let mut out = []
    let c = cfg_count()
    let e = enabled_count()
    let v = total_valid_targets()
    let s = total_suppressions()
    out.push(c)
    out.push(e)
    out.push(v)
    out.push(s)
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pcg-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup → log empty
    cleanup_pcg()
    let s0 = pcg_stats()
    if s0[0] != 0 {
        panic("pe_cfg_guard FAIL [stats[0] init] expected=0 got=" + to_string(s0[0]))
    }

    // 2. synthesize 3 PEs — Battle.net + D2R CFG patterns
    //    95001: Battle.net Setup — CFG enabled, 2400 valid targets, 80 suppressions
    //    95002: D2R.exe — CFG enabled, 4800 valid targets, 120 suppressions
    //    95003: Old PE — no CFG (cfg_enabled=0)
    record_cfg(95001, 2400, 80, 1)
    record_cfg(95002, 4800, 120, 1)
    record_cfg(95003, 0, 0, 0)

    // 3. cfg_count 검증 = 3
    let c = cfg_count()
    if c != 3 {
        panic("pe_cfg_guard FAIL [cfg_count] expected=3 got=" + to_string(c))
    }

    // 4. enabled_count 검증 = 2
    let en = enabled_count()
    if en != 2 {
        panic("pe_cfg_guard FAIL [enabled_count] expected=2 got=" + to_string(en))
    }

    // 5. total_valid_targets 검증 = 2400+4800+0 = 7200
    let tv = total_valid_targets()
    if tv != 7200 {
        panic("pe_cfg_guard FAIL [total_valid_targets] expected=7200 got=" + to_string(tv))
    }

    // 6. total_suppressions 검증 = 80+120+0 = 200
    let ts = total_suppressions()
    if ts != 200 {
        panic("pe_cfg_guard FAIL [total_suppressions] expected=200 got=" + to_string(ts))
    }

    // 7. pe_target_count(95001)=2400, pe_target_count(95003)=0, pe_target_count(9999)=0
    let p1 = pe_target_count(95001)
    if p1 != 2400 {
        panic("pe_cfg_guard FAIL [pe_target_count 95001] expected=2400 got=" + to_string(p1))
    }
    let p3 = pe_target_count(95003)
    if p3 != 0 {
        panic("pe_cfg_guard FAIL [pe_target_count 95003] expected=0 got=" + to_string(p3))
    }
    let p_miss = pe_target_count(9999)
    if p_miss != 0 {
        panic("pe_cfg_guard FAIL [pe_target_count 9999] expected=0 got=" + to_string(p_miss))
    }

    // 8. pcg_stats() = [3, 2, 7200, 200]
    let s = pcg_stats()
    if len(s) != 4 {
        panic("pe_cfg_guard FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 3 {
        panic("pe_cfg_guard FAIL [stats[0]] expected=3 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_cfg_guard FAIL [stats[1]] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 7200 {
        panic("pe_cfg_guard FAIL [stats[2]] expected=7200 got=" + to_string(s[2]))
    }
    if s[3] != 200 {
        panic("pe_cfg_guard FAIL [stats[3]] expected=200 got=" + to_string(s[3]))
    }

    // 9. r0_emit summary marker (ensures emit count ≥ 4)
    r0_emit("pcg_summary",
        "\"cfg_count\":" + to_string(s[0])
        + ",\"enabled\":" + to_string(s[1])
        + ",\"valid_targets\":" + to_string(s[2])
        + ",\"suppressions\":" + to_string(s[3]))

    let emit_n = r0_session_count(sid)
    if emit_n < 4 {
        panic("pe_cfg_guard FAIL [r0 emit count] expected=>=4 got=" + to_string(emit_n))
    }

    // 10. cleanup → stats reset
    cleanup_pcg()
    let s_after = pcg_stats()
    let j = 0
    while j < len(s_after) {
        if s_after[j] != 0 {
            panic("pe_cfg_guard FAIL [cleanup stats[" + to_string(j)
                + "]] expected=0 got=" + to_string(s_after[j]))
        }
        j = j + 1
    }

    println("  ✅ pe_cfg_guard self_test PASS (3 PEs, 2 enabled, 7200 valid_targets, 200 suppressions, sid="
        + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcg_stats()
            println("cfg_count\t" + to_string(s[0]))
            println("enabled_count\t" + to_string(s[1]))
            println("total_valid_targets\t" + to_string(s[2]))
            println("total_suppressions\t" + to_string(s[3]))
            return
        }
        if sub == "targets" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                let pc = pe_target_count(pid)
                println("pe_id\t" + to_string(pid))
                println("valid_target_count\t" + to_string(pc))
                return
            }
            println("usage: targets <pe_id>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcg()
            println("cleaned: " + pcg_dir())
            return
        }
        if sub == "dir" {
            println(pcg_dir())
            return
        }
    }
    println("usage: hexa run pe_cfg_guard.hexa { self-test | stats | targets <pe_id> | cleanup | dir }")
}
