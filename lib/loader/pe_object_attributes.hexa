// lib/loader/pe_object_attributes.hexa — cycle 69 OBJECT_ATTRIBUTES NT param struct telemetry
//
// Windows NT syscalls (NtCreateFile / NtOpenKey / NtCreateEvent / NtCreateMutant
// / NtCreateSection 등) 이 OBJECT_ATTRIBUTES 구조체를 인자로 받아 — name +
// attribute flags + (optional) security descriptor 를 wrapping. 본 module 은
// PE loader runtime 이 관찰하는 OBJECT_ATTRIBUTES 인스턴스 stat 을 tracker.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 attr telemetry — 실 NtCreateFile 등 호출 X (별 stage).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// object_kind code:
//   1 = file
//   2 = key
//   3 = event
//   4 = mutex
//   5 = section
//
// attribute_flags (bit field — wdm.h OBJ_*):
//   0x02 = OBJ_INHERIT
//   0x10 = OBJ_PERMANENT
//   0x20 = OBJ_EXCLUSIVE
//   0x40 = OBJ_CASE_INSENSITIVE   ← skeleton case_insensitive_count target bit
//   0x80 = OBJ_OPENIF
//
// persist schema (TSV — attrs.tsv):
//   attr_id<int> \t object_kind<int> \t attribute_flags<int> \t name_length<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn poa_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_object_attributes"
}

fn poa_attrs_path() -> str {
    return poa_dir() + "/attrs.tsv"
}

fn poa_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + poa_dir() + "'")
}

fn cleanup_poa() -> void {
    poa_ensure_dir()
    let _ = exec("rm -f '" + poa_attrs_path() + "'")
}

// ─── 공통 file IO ───
fn poa_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn poa_append_row(path: str, row: str) -> void {
    poa_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_attr: OBJECT_ATTRIBUTES 1 건 기록 ───
fn record_attr(attr_id: int, object_kind: int, attribute_flags: int, name_length: int) -> void {
    if attr_id <= 0 {
        panic("pe_object_attributes FAIL [record_attr] expected=attr_id>0 got=" + to_string(attr_id))
    }
    if object_kind < 1 {
        panic("pe_object_attributes FAIL [record_attr] expected=object_kind>=1 got=" + to_string(object_kind))
    }
    if object_kind > 5 {
        panic("pe_object_attributes FAIL [record_attr] expected=object_kind<=5 got=" + to_string(object_kind))
    }
    if attribute_flags < 0 {
        panic("pe_object_attributes FAIL [record_attr] expected=attribute_flags>=0 got=" + to_string(attribute_flags))
    }
    if name_length < 0 {
        panic("pe_object_attributes FAIL [record_attr] expected=name_length>=0 got=" + to_string(name_length))
    }
    let row = to_string(attr_id) + "\t" + to_string(object_kind)
        + "\t" + to_string(attribute_flags) + "\t" + to_string(name_length) + "\n"
    poa_append_row(poa_attrs_path(), row)
}

// ─── attr_count: 총 attr 수 ───
fn attr_count() -> int {
    let t = poa_read_table(poa_attrs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_name_length: 모든 attr name_length 합 ───
fn total_name_length() -> int {
    let t = poa_read_table(poa_attrs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── case_insensitive_count: OBJ_CASE_INSENSITIVE (0x40) bit set 인 attr 수 ───
// skeleton: attribute_flags == 64 (0x40 only) OR 192 (0x40 | 0x80) OR 66 (0x40|0x02)
//          → 단순화: flags 가 0x40 단독 또는 0x40 + 0x80 인 경우만 count.
fn case_insensitive_count() -> int {
    let t = poa_read_table(poa_attrs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let f = to_int(parts[2])
                if f == 64 {
                    cnt = cnt + 1
                }
                if f == 192 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_object: 특정 object_kind 의 attr 수 ───
fn count_by_object(object_kind: int) -> int {
    let t = poa_read_table(poa_attrs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == object_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── attr_flags: 특정 attr_id 의 attribute_flags (없으면 0) ───
fn attr_flags(attr_id: int) -> int {
    let t = poa_read_table(poa_attrs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == attr_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── poa_stats: [attr_count, total_name_length, case_insensitive_count, count_by_object(1)] ───
fn poa_stats() -> array {
    let mut out = []
    out.push(attr_count())
    out.push(total_name_length())
    out.push(case_insensitive_count())
    out.push(count_by_object(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "poa-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_poa()

    // 2. record 5 attrs across ≥3 object_kinds with ≥2 case_insensitive
    //    layout:
    //      69001 file  flags=64  (OBJ_CASE_INSENSITIVE)              name_len=24
    //      69002 key   flags=64  (OBJ_CASE_INSENSITIVE)              name_len=40
    //      69003 event flags=2   (OBJ_INHERIT)                       name_len=16
    //      69004 file  flags=192 (OBJ_CASE_INSENSITIVE | OBJ_OPENIF) name_len=32
    //      69005 mutex flags=0                                       name_len=20
    //    expected:
    //      attr_count           = 5
    //      total_name_length    = 24+40+16+32+20 = 132
    //      case_insensitive_cnt = 3   (69001, 69002, 69004)
    //      count_by_object(1)   = 2   (69001, 69004 — file)
    record_attr(69001, 1, 64, 24)
    r0_emit("pe_object_attributes_record",
        "\"attr_id\":69001,\"object_kind\":1,\"attribute_flags\":64,\"name_length\":24,\"target\":\"file\"")

    record_attr(69002, 2, 64, 40)
    r0_emit("pe_object_attributes_record",
        "\"attr_id\":69002,\"object_kind\":2,\"attribute_flags\":64,\"name_length\":40,\"target\":\"key\"")

    record_attr(69003, 3, 2, 16)
    r0_emit("pe_object_attributes_record",
        "\"attr_id\":69003,\"object_kind\":3,\"attribute_flags\":2,\"name_length\":16,\"target\":\"event\"")

    record_attr(69004, 1, 192, 32)
    r0_emit("pe_object_attributes_record",
        "\"attr_id\":69004,\"object_kind\":1,\"attribute_flags\":192,\"name_length\":32,\"target\":\"file\"")

    record_attr(69005, 4, 0, 20)
    r0_emit("pe_object_attributes_record",
        "\"attr_id\":69005,\"object_kind\":4,\"attribute_flags\":0,\"name_length\":20,\"target\":\"mutex\"")

    // 3. attr_count = 5
    let c = attr_count()
    if c != 5 {
        panic("pe_object_attributes FAIL [attr_count] expected=5 got=" + to_string(c))
    }

    // 4. total_name_length = 132
    let tnl = total_name_length()
    if tnl != 132 {
        panic("pe_object_attributes FAIL [total_name_length] expected=132 got=" + to_string(tnl))
    }

    // 5. case_insensitive_count = 3
    let ci = case_insensitive_count()
    if ci != 3 {
        panic("pe_object_attributes FAIL [case_insensitive_count] expected=3 got=" + to_string(ci))
    }

    // 6. count_by_object sanity
    let k1 = count_by_object(1)
    if k1 != 2 {
        panic("pe_object_attributes FAIL [count_by_object(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_object(2)
    if k2 != 1 {
        panic("pe_object_attributes FAIL [count_by_object(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_object(3)
    if k3 != 1 {
        panic("pe_object_attributes FAIL [count_by_object(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_object(4)
    if k4 != 1 {
        panic("pe_object_attributes FAIL [count_by_object(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_object(5)
    if k5 != 0 {
        panic("pe_object_attributes FAIL [count_by_object(5)] expected=0 got=" + to_string(k5))
    }

    // 7. attr_flags sanity
    let f1 = attr_flags(69001)
    if f1 != 64 {
        panic("pe_object_attributes FAIL [attr_flags(69001)] expected=64 got=" + to_string(f1))
    }
    let f4 = attr_flags(69004)
    if f4 != 192 {
        panic("pe_object_attributes FAIL [attr_flags(69004)] expected=192 got=" + to_string(f4))
    }
    let f_miss = attr_flags(99999)
    if f_miss != 0 {
        panic("pe_object_attributes FAIL [attr_flags(99999)] expected=0 got=" + to_string(f_miss))
    }

    // 8. poa_stats() = [5, 132, 3, 2]
    let s = poa_stats()
    if len(s) != 4 {
        panic("pe_object_attributes FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_object_attributes FAIL [stats attr_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 132 {
        panic("pe_object_attributes FAIL [stats total_name_length] expected=132 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_object_attributes FAIL [stats case_insensitive_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_object_attributes FAIL [stats count_by_object(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_object_attributes_stats",
        "\"attr_count\":" + to_string(s[0])
        + ",\"total_name_length\":" + to_string(s[1])
        + ",\"case_insensitive_count\":" + to_string(s[2])
        + ",\"count_file\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_object_attributes FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_poa()
    let s2 = poa_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_object_attributes FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_object_attributes self_test PASS (attrs=" + to_string(s[0])
        + ", name_len=" + to_string(s[1]) + ", case_insensitive=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = poa_stats()
            println("attr_count\t" + to_string(s[0]))
            println("total_name_length\t" + to_string(s[1]))
            println("case_insensitive_count\t" + to_string(s[2]))
            println("count_file\t" + to_string(s[3]))
            return
        }
        if sub == "flags" {
            if len(a) >= 4 {
                let aid = to_int(a[3])
                println("attr_flags\t" + to_string(attr_flags(aid)))
                return
            }
            println("usage: hexa run pe_object_attributes.hexa flags <attr_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let arg = a[3]
                if arg == "case_insensitive" {
                    println("case_insensitive_count\t" + to_string(case_insensitive_count()))
                    return
                }
                let kind = to_int(arg)
                println("count_by_object\t" + to_string(count_by_object(kind)))
                return
            }
            println("usage: hexa run pe_object_attributes.hexa count <object_kind|case_insensitive>")
            return
        }
        if sub == "cleanup" {
            cleanup_poa()
            println("cleaned: " + poa_dir())
            return
        }
        if sub == "dir" {
            println(poa_dir())
            return
        }
    }
    println("usage: hexa run pe_object_attributes.hexa { self-test | stats | flags <attr_id> | count <object_kind> | count case_insensitive | cleanup | dir }")
}
