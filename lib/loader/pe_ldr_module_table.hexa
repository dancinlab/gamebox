// lib/loader/pe_ldr_module_table.hexa — cycle 69 LDR_DATA_TABLE_ENTRY linked-list telemetry skeleton
//
// PEB->Ldr->InLoadOrderModuleList tracks the loaded DLL chain on Windows.
// Many anti-tamper checks walk this list (InLoadOrder / InMemoryOrder /
// InInitOrder + the LDR hash table) to fingerprint module presence, so
// gamebox shadow-tracks each LDR_DATA_TABLE_ENTRY observation we replay.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 LDR table observation tracker — ntdll!LdrLoadDll 호출 X
//   (실 entry insertion 은 후속 stage 의 ntdll bridge 가 담당).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// list_kind code:
//   1 = InLoadOrderModuleList
//   2 = InMemoryOrderModuleList
//   3 = InInitializationOrderModuleList
//   4 = LdrpHashTable
//
// persist schema (TSV — entries.tsv):
//   entry_id<int> \t list_kind<int> \t dll_size<int> \t load_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn plmt_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ldr_module_table"
}

fn plmt_entries_path() -> str {
    return plmt_dir() + "/entries.tsv"
}

fn plmt_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + plmt_dir() + "'")
}

fn cleanup_plmt() -> void {
    plmt_ensure_dir()
    let _ = exec("rm -f '" + plmt_entries_path() + "'")
}

// ─── 공통 file IO ───
fn plmt_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn plmt_append_row(path: str, row: str) -> void {
    plmt_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_entry: LDR_DATA_TABLE_ENTRY 1 건 기록 ───
fn record_entry(entry_id: int, list_kind: int, dll_size: int, load_count: int) -> void {
    if entry_id <= 0 {
        panic("pe_ldr_module_table FAIL [record_entry] expected=entry_id>0 got=" + to_string(entry_id))
    }
    if list_kind < 1 {
        panic("pe_ldr_module_table FAIL [record_entry] expected=list_kind>=1 got=" + to_string(list_kind))
    }
    if list_kind > 4 {
        panic("pe_ldr_module_table FAIL [record_entry] expected=list_kind<=4 got=" + to_string(list_kind))
    }
    if dll_size < 0 {
        panic("pe_ldr_module_table FAIL [record_entry] expected=dll_size>=0 got=" + to_string(dll_size))
    }
    if load_count < 0 {
        panic("pe_ldr_module_table FAIL [record_entry] expected=load_count>=0 got=" + to_string(load_count))
    }
    let row = to_string(entry_id) + "\t" + to_string(list_kind)
        + "\t" + to_string(dll_size) + "\t" + to_string(load_count) + "\n"
    plmt_append_row(plmt_entries_path(), row)
}

// ─── entry_count: total entry 수 ───
fn entry_count() -> int {
    let t = plmt_read_table(plmt_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_dll_size: 모든 entry dll_size 합 ───
fn total_dll_size() -> int {
    let t = plmt_read_table(plmt_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_load_count: 모든 entry load_count 합 ───
fn total_load_count() -> int {
    let t = plmt_read_table(plmt_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_list: 특정 list_kind 의 entry 수 ───
fn count_by_list(list_kind: int) -> int {
    let t = plmt_read_table(plmt_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == list_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── entry_dll_size: 특정 entry_id 의 dll_size (없으면 0) ───
fn entry_dll_size(entry_id: int) -> int {
    let t = plmt_read_table(plmt_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == entry_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── plmt_stats: [entry_count, total_dll_size, total_load_count, count_by_list(1)] ───
fn plmt_stats() -> array {
    let mut out = []
    out.push(entry_count())
    out.push(total_dll_size())
    out.push(total_load_count())
    out.push(count_by_list(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "plmt-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_plmt()

    // 2. record 5 entries spanning ≥3 list_kinds
    record_entry(690001, 1, 2097152, 1)
    r0_emit("pe_ldr_module_table_record",
        "\"entry_id\":690001,\"list_kind\":1,\"dll_size\":2097152,\"load_count\":1,\"target\":\"InLoadOrder\"")

    record_entry(690002, 1, 1048576, 2)
    r0_emit("pe_ldr_module_table_record",
        "\"entry_id\":690002,\"list_kind\":1,\"dll_size\":1048576,\"load_count\":2,\"target\":\"InLoadOrder\"")

    record_entry(690003, 2, 524288, 1)
    r0_emit("pe_ldr_module_table_record",
        "\"entry_id\":690003,\"list_kind\":2,\"dll_size\":524288,\"load_count\":1,\"target\":\"InMemoryOrder\"")

    record_entry(690004, 3, 262144, 3)
    r0_emit("pe_ldr_module_table_record",
        "\"entry_id\":690004,\"list_kind\":3,\"dll_size\":262144,\"load_count\":3,\"target\":\"InInitOrder\"")

    record_entry(690005, 4, 131072, 1)
    r0_emit("pe_ldr_module_table_record",
        "\"entry_id\":690005,\"list_kind\":4,\"dll_size\":131072,\"load_count\":1,\"target\":\"HashTable\"")

    // 3. entry_count = 5
    let c = entry_count()
    if c != 5 {
        panic("pe_ldr_module_table FAIL [entry_count] expected=5 got=" + to_string(c))
    }

    // 4. total_dll_size = 4063232
    let td = total_dll_size()
    if td != 4063232 {
        panic("pe_ldr_module_table FAIL [total_dll_size] expected=4063232 got=" + to_string(td))
    }

    // 5. total_load_count = 8
    let tlc = total_load_count()
    if tlc != 8 {
        panic("pe_ldr_module_table FAIL [total_load_count] expected=8 got=" + to_string(tlc))
    }

    // 6. count_by_list sanity
    let k1 = count_by_list(1)
    if k1 != 2 {
        panic("pe_ldr_module_table FAIL [count_by_list(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_list(2)
    if k2 != 1 {
        panic("pe_ldr_module_table FAIL [count_by_list(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_list(3)
    if k3 != 1 {
        panic("pe_ldr_module_table FAIL [count_by_list(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_list(4)
    if k4 != 1 {
        panic("pe_ldr_module_table FAIL [count_by_list(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_list(99)
    if k99 != 0 {
        panic("pe_ldr_module_table FAIL [count_by_list(99)] expected=0 got=" + to_string(k99))
    }

    // 7. entry_dll_size sanity
    let s2 = entry_dll_size(690002)
    if s2 != 1048576 {
        panic("pe_ldr_module_table FAIL [entry_dll_size(690002)] expected=1048576 got=" + to_string(s2))
    }
    let s4 = entry_dll_size(690004)
    if s4 != 262144 {
        panic("pe_ldr_module_table FAIL [entry_dll_size(690004)] expected=262144 got=" + to_string(s4))
    }
    let s_miss = entry_dll_size(9999)
    if s_miss != 0 {
        panic("pe_ldr_module_table FAIL [entry_dll_size(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 8. plmt_stats() = [5, 4063232, 8, 2]
    let s = plmt_stats()
    if len(s) != 4 {
        panic("pe_ldr_module_table FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_ldr_module_table FAIL [stats entry_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 4063232 {
        panic("pe_ldr_module_table FAIL [stats total_dll_size] expected=4063232 got=" + to_string(s[1]))
    }
    if s[2] != 8 {
        panic("pe_ldr_module_table FAIL [stats total_load_count] expected=8 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_ldr_module_table FAIL [stats count_list(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_ldr_module_table_stats",
        "\"entry_count\":" + to_string(s[0])
        + ",\"total_dll_size\":" + to_string(s[1])
        + ",\"total_load_count\":" + to_string(s[2])
        + ",\"kind_in_load\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_ldr_module_table FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_plmt()
    let s_after = plmt_stats()
    let i = 0
    while i < len(s_after) {
        if s_after[i] != 0 {
            panic("pe_ldr_module_table FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s_after[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ldr_module_table self_test PASS (entries=" + to_string(s[0])
        + ", dll_size=" + to_string(s[1]) + ", load_count=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = plmt_stats()
            println("entry_count\t" + to_string(s[0]))
            println("total_dll_size\t" + to_string(s[1]))
            println("total_load_count\t" + to_string(s[2]))
            println("count_kind_in_load\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let eid = to_int(a[3])
                println("entry_dll_size\t" + to_string(entry_dll_size(eid)))
                return
            }
            println("usage: hexa run pe_ldr_module_table.hexa size <entry_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_list\t" + to_string(count_by_list(kind)))
                return
            }
            println("usage: hexa run pe_ldr_module_table.hexa count <list_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_plmt()
            println("cleaned: " + plmt_dir())
            return
        }
        if sub == "dir" {
            println(plmt_dir())
            return
        }
    }
    println("usage: hexa run pe_ldr_module_table.hexa { self-test | stats | size <entry_id> | count <list_kind> | cleanup | dir }")
}
