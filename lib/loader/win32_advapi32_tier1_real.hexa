// lib/loader/win32_advapi32_tier1_real.hexa — cycle 81 R6 Tier 1 ADVAPI32 trivial 함수 tracker
//
// Tier 1 trivial ADVAPI32 → Apple-native:
//   GetCurrentSid           → fixed S-1-5-21-... template (sentinel SID)
//   AllocateLocallyUniqueId → uuid_generate (LUID = uint64 monotonic)
//   GetUserNameW            → getpwuid(getuid())->pw_name → UTF-16
//   GetComputerNameW        → gethostname() → UTF-16
//   IsUserAnAdmin           → getuid() == 0 (always FALSE in sandbox)
//   GetTokenInformation     → SECURITY_ATTRIBUTES synthesize (best-effort)
//   ImpersonateSelf         → no-op + return TRUE
//   RevertToSelf            → no-op + return TRUE
//   OpenProcessToken        → fake handle (per-process token sentinel)
//   DuplicateToken          → fake handle (token clone sentinel)
// own1: Apple Security framework + MSDN. Wine advapi32/security.c 인용 X
//
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//   1  = GetCurrentSid
//   2  = AllocateLocallyUniqueId
//   3  = GetUserNameW
//   4  = GetComputerNameW
//   5  = IsUserAnAdmin
//   6  = GetTokenInformation
//   7  = ImpersonateSelf
//   8  = RevertToSelf
//   9  = OpenProcessToken
//   10 = DuplicateToken
//
// impl_status code:
//   1 = real_apple_security
//   2 = stub_constant
//   3 = stub_string
//   4 = deprecated_fail
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t impl_status<int> \t return_value<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wat1_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_advapi32_tier1_real"
}

fn wat1_calls_path() -> str {
    return wat1_dir() + "/calls.tsv"
}

fn wat1_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wat1_dir() + "'")
}

fn cleanup_wat1() -> void {
    wat1_ensure_dir()
    let _ = exec("rm -f '" + wat1_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wat1_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wat1_append_row(path: str, row: str) -> void {
    wat1_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: ADVAPI32 trivial call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, impl_status: int, return_value: int) -> void {
    if call_id <= 0 {
        panic("win32_advapi32_tier1_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_advapi32_tier1_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 10 {
        panic("win32_advapi32_tier1_real FAIL [record_call] expected=func_kind<=10 got=" + to_string(func_kind))
    }
    if impl_status < 1 {
        panic("win32_advapi32_tier1_real FAIL [record_call] expected=impl_status>=1 got=" + to_string(impl_status))
    }
    if impl_status > 4 {
        panic("win32_advapi32_tier1_real FAIL [record_call] expected=impl_status<=4 got=" + to_string(impl_status))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(impl_status) + "\t" + to_string(return_value) + "\n"
    wat1_append_row(wat1_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wat1_read_table(wat1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = wat1_read_table(wat1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_impl_status: 특정 impl_status 의 call 수 ───
fn count_by_impl_status(status: int) -> int {
    let t = wat1_read_table(wat1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── real_security_count: impl_status=1 (real_apple_security) 인 call 수 ───
fn real_security_count() -> int {
    return count_by_impl_status(1)
}

// ─── success_count: return_value != 0 인 call 수 ───
fn success_count() -> int {
    let t = wat1_read_table(wat1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) != 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_return_value: 특정 call_id 의 return_value (없으면 0) ───
fn call_return_value(call_id: int) -> int {
    let t = wat1_read_table(wat1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wat1_stats: [call_count, real_security_count, success_count, count_by_impl_status(2)] ───
fn wat1_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(real_security_count())
    out.push(success_count())
    out.push(count_by_impl_status(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wat1-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wat1()

    // 2. record 6 trivial ADVAPI32 calls (deterministic synthetic)
    //    func_kinds covered: 3, 4, 5, 6, 7, 9 (≥4 distinct)
    //    impl_statuses covered: 1, 2, 3, 4 (all four)
    record_call(810001, 3, 1, 1)
    r0_emit("win32_advapi32_tier1_real_record",
        "\"call_id\":810001,\"func_kind\":3,\"impl_status\":1,\"return_value\":1,\"target\":\"GetUserNameW\"")

    record_call(810002, 4, 1, 1)
    r0_emit("win32_advapi32_tier1_real_record",
        "\"call_id\":810002,\"func_kind\":4,\"impl_status\":1,\"return_value\":1,\"target\":\"GetComputerNameW\"")

    record_call(810003, 5, 2, 0)
    r0_emit("win32_advapi32_tier1_real_record",
        "\"call_id\":810003,\"func_kind\":5,\"impl_status\":2,\"return_value\":0,\"target\":\"IsUserAnAdmin\"")

    record_call(810004, 7, 2, 1)
    r0_emit("win32_advapi32_tier1_real_record",
        "\"call_id\":810004,\"func_kind\":7,\"impl_status\":2,\"return_value\":1,\"target\":\"ImpersonateSelf\"")

    record_call(810005, 9, 3, 1)
    r0_emit("win32_advapi32_tier1_real_record",
        "\"call_id\":810005,\"func_kind\":9,\"impl_status\":3,\"return_value\":1,\"target\":\"OpenProcessToken\"")

    record_call(810006, 6, 4, 0)
    r0_emit("win32_advapi32_tier1_real_record",
        "\"call_id\":810006,\"func_kind\":6,\"impl_status\":4,\"return_value\":0,\"target\":\"GetTokenInformation\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("win32_advapi32_tier1_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. distinct func_kinds ≥ 4
    let mut kinds_seen = 0
    if count_by_func_kind(3) > 0 {
        kinds_seen = kinds_seen + 1
    }
    if count_by_func_kind(4) > 0 {
        kinds_seen = kinds_seen + 1
    }
    if count_by_func_kind(5) > 0 {
        kinds_seen = kinds_seen + 1
    }
    if count_by_func_kind(6) > 0 {
        kinds_seen = kinds_seen + 1
    }
    if count_by_func_kind(7) > 0 {
        kinds_seen = kinds_seen + 1
    }
    if count_by_func_kind(9) > 0 {
        kinds_seen = kinds_seen + 1
    }
    if kinds_seen < 4 {
        panic("win32_advapi32_tier1_real FAIL [distinct func_kinds] expected=>=4 got=" + to_string(kinds_seen))
    }

    // 5. count_by_func_kind sanity (unused = 0)
    let k_unused = count_by_func_kind(99)
    if k_unused != 0 {
        panic("win32_advapi32_tier1_real FAIL [count_by_func_kind(99)] expected=0 got=" + to_string(k_unused))
    }
    let k1 = count_by_func_kind(1)
    if k1 != 0 {
        panic("win32_advapi32_tier1_real FAIL [count_by_func_kind(1)] expected=0 got=" + to_string(k1))
    }

    // 6. count_by_impl_status — all 4 statuses present
    let s1 = count_by_impl_status(1)
    if s1 != 2 {
        panic("win32_advapi32_tier1_real FAIL [count_by_impl_status(1)] expected=2 got=" + to_string(s1))
    }
    let s2 = count_by_impl_status(2)
    if s2 != 2 {
        panic("win32_advapi32_tier1_real FAIL [count_by_impl_status(2)] expected=2 got=" + to_string(s2))
    }
    let s3 = count_by_impl_status(3)
    if s3 != 1 {
        panic("win32_advapi32_tier1_real FAIL [count_by_impl_status(3)] expected=1 got=" + to_string(s3))
    }
    let s4 = count_by_impl_status(4)
    if s4 != 1 {
        panic("win32_advapi32_tier1_real FAIL [count_by_impl_status(4)] expected=1 got=" + to_string(s4))
    }

    // 7. real_security_count = 2
    let rsc = real_security_count()
    if rsc != 2 {
        panic("win32_advapi32_tier1_real FAIL [real_security_count] expected=2 got=" + to_string(rsc))
    }

    // 8. success_count = 4 (return_value != 0: 810001, 810002, 810004, 810005)
    let sc = success_count()
    if sc != 4 {
        panic("win32_advapi32_tier1_real FAIL [success_count] expected=4 got=" + to_string(sc))
    }

    // 9. call_return_value sanity
    let rv1 = call_return_value(810001)
    if rv1 != 1 {
        panic("win32_advapi32_tier1_real FAIL [call_return_value(810001)] expected=1 got=" + to_string(rv1))
    }
    let rv3 = call_return_value(810003)
    if rv3 != 0 {
        panic("win32_advapi32_tier1_real FAIL [call_return_value(810003)] expected=0 got=" + to_string(rv3))
    }
    let rv_miss = call_return_value(99999)
    if rv_miss != 0 {
        panic("win32_advapi32_tier1_real FAIL [call_return_value(99999)] expected=0 got=" + to_string(rv_miss))
    }

    // 10. wat1_stats() = [6, 2, 4, 2]
    let s = wat1_stats()
    if len(s) != 4 {
        panic("win32_advapi32_tier1_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("win32_advapi32_tier1_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("win32_advapi32_tier1_real FAIL [stats real_security] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("win32_advapi32_tier1_real FAIL [stats success_count] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("win32_advapi32_tier1_real FAIL [stats stub_constant] expected=2 got=" + to_string(s[3]))
    }

    // 11. emit stats (7th emit: 6 record + 1 stats)
    r0_emit("win32_advapi32_tier1_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"real_security\":" + to_string(s[1])
        + ",\"success_count\":" + to_string(s[2])
        + ",\"stub_constant\":" + to_string(s[3]))

    // 12. emit count >= 7
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("win32_advapi32_tier1_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 13. cleanup → stats 모두 0
    cleanup_wat1()
    let s2v = wat1_stats()
    let i = 0
    while i < len(s2v) {
        if s2v[i] != 0 {
            panic("win32_advapi32_tier1_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2v[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_advapi32_tier1_real self_test PASS (calls=" + to_string(s[0])
        + ", real_sec=" + to_string(s[1]) + ", success=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wat1_stats()
            println("call_count\t" + to_string(s[0]))
            println("real_security_count\t" + to_string(s[1]))
            println("success_count\t" + to_string(s[2]))
            println("count_impl_stub_constant\t" + to_string(s[3]))
            return
        }
        if sub == "return" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_return_value\t" + to_string(call_return_value(cid)))
                return
            }
            println("usage: hexa run win32_advapi32_tier1_real.hexa return <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let k = to_int(a[4])
                if dim == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(k)))
                    return
                }
                if dim == "impl" {
                    println("count_by_impl_status\t" + to_string(count_by_impl_status(k)))
                    return
                }
                println("usage: hexa run win32_advapi32_tier1_real.hexa count { func | impl } <code>")
                return
            }
            println("usage: hexa run win32_advapi32_tier1_real.hexa count { func | impl } <code>")
            return
        }
        if sub == "cleanup" {
            cleanup_wat1()
            println("cleaned: " + wat1_dir())
            return
        }
        if sub == "dir" {
            println(wat1_dir())
            return
        }
    }
    println("usage: hexa run win32_advapi32_tier1_real.hexa { self-test | stats | return <call_id> | count func <func_kind> | count impl <impl_status> | cleanup | dir }")
}
