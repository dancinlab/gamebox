// lib/loader/pe_console_input_buffer.hexa — cycle 72 ReadConsoleInput INPUT_RECORD telemetry skeleton
//
// Win32 console subsystem 의 INPUT_RECORD stream — ReadConsoleInput() 가
// 반환하는 event 를 4-tuple (event_id, event_kind, key_code, repeat_count)
// 로 압축 추적. 본 module 은 buffer event recorder — 실 ReadConsoleInputW
// 호출 X (stage6 native bridge 에서 처리).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// event_kind code:
//   1 = key            (KEY_EVENT — char 입력 / 확장 key)
//   2 = mouse          (MOUSE_EVENT)
//   3 = buffer_resize  (WINDOW_BUFFER_SIZE_EVENT)
//   4 = focus          (FOCUS_EVENT)
//   5 = menu           (MENU_EVENT)
//
// persist schema (TSV — events.tsv):
//   event_id<int> \t event_kind<int> \t key_code<int> \t repeat_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcib_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_console_input_buffer"
}

fn pcib_events_path() -> str {
    return pcib_dir() + "/events.tsv"
}

fn pcib_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcib_dir() + "'")
}

fn cleanup_pcib() -> void {
    pcib_ensure_dir()
    let _ = exec("rm -f '" + pcib_events_path() + "'")
}

// ─── 공통 file IO ───
fn pcib_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcib_append_row(path: str, row: str) -> void {
    pcib_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_event: console input event 1 건 기록 ───
fn record_event(event_id: int, event_kind: int, key_code: int, repeat_count: int) -> void {
    if event_id <= 0 {
        panic("pe_console_input_buffer FAIL [record_event] expected=event_id>0 got=" + to_string(event_id))
    }
    if event_kind < 1 {
        panic("pe_console_input_buffer FAIL [record_event] expected=event_kind>=1 got=" + to_string(event_kind))
    }
    if event_kind > 5 {
        panic("pe_console_input_buffer FAIL [record_event] expected=event_kind<=5 got=" + to_string(event_kind))
    }
    if key_code < 0 {
        panic("pe_console_input_buffer FAIL [record_event] expected=key_code>=0 got=" + to_string(key_code))
    }
    if repeat_count < 0 {
        panic("pe_console_input_buffer FAIL [record_event] expected=repeat_count>=0 got=" + to_string(repeat_count))
    }
    let row = to_string(event_id) + "\t" + to_string(event_kind)
        + "\t" + to_string(key_code) + "\t" + to_string(repeat_count) + "\n"
    pcib_append_row(pcib_events_path(), row)
}

// ─── event_count: total event 수 ───
fn event_count() -> int {
    let t = pcib_read_table(pcib_events_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_repeat_count: 모든 event repeat_count 합 ───
fn total_repeat_count() -> int {
    let t = pcib_read_table(pcib_events_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_event_kind: 특정 event_kind 의 event 수 ───
fn count_by_event_kind(kind: int) -> int {
    let t = pcib_read_table(pcib_events_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_keys: event_kind=1 (key) event 의 distinct key_code 수 ───
fn distinct_keys() -> int {
    let t = pcib_read_table(pcib_events_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut seen = []
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == 1 {
                    let kc = to_int(parts[2])
                    let mut j = 0
                    let m = len(seen)
                    let mut dup = 0
                    while j < m {
                        if seen[j] == kc {
                            dup = 1
                        }
                        j = j + 1
                    }
                    if dup == 0 {
                        seen.push(kc)
                    }
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── event_repeat_count: 특정 event_id 의 repeat_count (없으면 0) ───
fn event_repeat_count(event_id: int) -> int {
    let t = pcib_read_table(pcib_events_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == event_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pcib_stats: [event_count, total_repeat_count, count_by_event_kind(1), distinct_keys] ───
fn pcib_stats() -> array {
    let mut out = []
    out.push(event_count())
    out.push(total_repeat_count())
    out.push(count_by_event_kind(1))
    out.push(distinct_keys())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pcib-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pcib()

    // 2. record 6 events across ≥3 event_kinds (key/mouse/buffer_resize/focus)
    record_event(720001, 1, 65, 1)
    r0_emit("pe_console_input_buffer_record",
        "\"event_id\":720001,\"event_kind\":1,\"key_code\":65,\"repeat_count\":1,\"target\":\"key_A\"")

    record_event(720002, 1, 66, 3)
    r0_emit("pe_console_input_buffer_record",
        "\"event_id\":720002,\"event_kind\":1,\"key_code\":66,\"repeat_count\":3,\"target\":\"key_B\"")

    record_event(720003, 1, 65, 2)
    r0_emit("pe_console_input_buffer_record",
        "\"event_id\":720003,\"event_kind\":1,\"key_code\":65,\"repeat_count\":2,\"target\":\"key_A_repeat\"")

    record_event(720004, 2, 0, 1)
    r0_emit("pe_console_input_buffer_record",
        "\"event_id\":720004,\"event_kind\":2,\"key_code\":0,\"repeat_count\":1,\"target\":\"mouse\"")

    record_event(720005, 3, 0, 1)
    r0_emit("pe_console_input_buffer_record",
        "\"event_id\":720005,\"event_kind\":3,\"key_code\":0,\"repeat_count\":1,\"target\":\"buffer_resize\"")

    record_event(720006, 4, 0, 1)
    r0_emit("pe_console_input_buffer_record",
        "\"event_id\":720006,\"event_kind\":4,\"key_code\":0,\"repeat_count\":1,\"target\":\"focus\"")

    // 3. event_count = 6
    let c = event_count()
    if c != 6 {
        panic("pe_console_input_buffer FAIL [event_count] expected=6 got=" + to_string(c))
    }

    // 4. total_repeat_count = 1+3+2+1+1+1 = 9
    let trc = total_repeat_count()
    if trc != 9 {
        panic("pe_console_input_buffer FAIL [total_repeat_count] expected=9 got=" + to_string(trc))
    }

    // 5. count_by_event_kind sanity
    let k1 = count_by_event_kind(1)
    if k1 != 3 {
        panic("pe_console_input_buffer FAIL [count_by_event_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_event_kind(2)
    if k2 != 1 {
        panic("pe_console_input_buffer FAIL [count_by_event_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_event_kind(3)
    if k3 != 1 {
        panic("pe_console_input_buffer FAIL [count_by_event_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_event_kind(4)
    if k4 != 1 {
        panic("pe_console_input_buffer FAIL [count_by_event_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_event_kind(5)
    if k5 != 0 {
        panic("pe_console_input_buffer FAIL [count_by_event_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_event_kind(99)
    if k99 != 0 {
        panic("pe_console_input_buffer FAIL [count_by_event_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. distinct_keys = 2 (key_code 65 + 66; 65 dedup)
    let dk = distinct_keys()
    if dk != 2 {
        panic("pe_console_input_buffer FAIL [distinct_keys] expected=2 got=" + to_string(dk))
    }

    // 7. event_repeat_count sanity
    let r2 = event_repeat_count(720002)
    if r2 != 3 {
        panic("pe_console_input_buffer FAIL [event_repeat_count(720002)] expected=3 got=" + to_string(r2))
    }
    let r3 = event_repeat_count(720003)
    if r3 != 2 {
        panic("pe_console_input_buffer FAIL [event_repeat_count(720003)] expected=2 got=" + to_string(r3))
    }
    let r_miss = event_repeat_count(9999)
    if r_miss != 0 {
        panic("pe_console_input_buffer FAIL [event_repeat_count(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 8. pcib_stats() = [6, 9, 3, 2]
    let s = pcib_stats()
    if len(s) != 4 {
        panic("pe_console_input_buffer FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_console_input_buffer FAIL [stats event_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 9 {
        panic("pe_console_input_buffer FAIL [stats total_repeat_count] expected=9 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_console_input_buffer FAIL [stats count_kind(1)] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_console_input_buffer FAIL [stats distinct_keys] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_console_input_buffer_stats",
        "\"event_count\":" + to_string(s[0])
        + ",\"total_repeat_count\":" + to_string(s[1])
        + ",\"kind_key\":" + to_string(s[2])
        + ",\"distinct_keys\":" + to_string(s[3]))

    // 10. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_console_input_buffer FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pcib()
    let s2 = pcib_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_console_input_buffer FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_console_input_buffer self_test PASS (events=" + to_string(s[0])
        + ", repeats=" + to_string(s[1]) + ", keys=" + to_string(s[2])
        + ", distinct=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcib_stats()
            println("event_count\t" + to_string(s[0]))
            println("total_repeat_count\t" + to_string(s[1]))
            println("kind_key\t" + to_string(s[2]))
            println("distinct_keys\t" + to_string(s[3]))
            return
        }
        if sub == "repeat" {
            if len(a) >= 4 {
                let eid = to_int(a[3])
                println("event_repeat_count\t" + to_string(event_repeat_count(eid)))
                return
            }
            println("usage: hexa run pe_console_input_buffer.hexa repeat <event_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_event_kind\t" + to_string(count_by_event_kind(kind)))
                return
            }
            println("usage: hexa run pe_console_input_buffer.hexa count <event_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcib()
            println("cleaned: " + pcib_dir())
            return
        }
        if sub == "dir" {
            println(pcib_dir())
            return
        }
    }
    println("usage: hexa run pe_console_input_buffer.hexa { self-test | stats | repeat <event_id> | count <event_kind> | cleanup | dir }")
}
