// lib/loader/pe_frame_compositor_queue.hexa — cycle 67 perf compositor queue skeleton
//
// CoreAnimation / Metal compositor frame queue metric tracker. host CALayer +
// CAMetalLayer drawable submit 시점 기록 — frame_id, layer_count, elapsed_us,
// dropped(0/1). docker hexa 영역에서는 host helper 가 emit 한 metric 을 TSV 에
// 누적하는 skeleton 만 제공 — 실제 compositor hook 은 native bridge (stage6+).
//
// own 1 enforcement: Wine / CrossOver / DXVK / community 코드 0 줄.
//   본 module 은 frame metric tracker — CAMetalLayer / IOSurface 직접 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// dropped code:
//   0 = on-time present
//   1 = dropped (deadline miss / discarded)
//
// persist schema (TSV — frames.tsv):
//   frame_id<int> \t layer_count<int> \t elapsed_us<int> \t dropped<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pfcq_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_frame_compositor_queue"
}

fn pfcq_frames_path() -> str {
    return pfcq_dir() + "/frames.tsv"
}

fn pfcq_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pfcq_dir() + "'")
}

fn cleanup_pfcq() -> void {
    pfcq_ensure_dir()
    let _ = exec("rm -f '" + pfcq_frames_path() + "'")
}

// ─── 공통 file IO ───
fn pfcq_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pfcq_append_row(path: str, row: str) -> void {
    pfcq_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_frame: compositor frame 1 건 기록 ───
fn record_frame(frame_id: int, layer_count: int, elapsed_us: int, dropped: int) -> void {
    if frame_id <= 0 {
        panic("pe_frame_compositor_queue FAIL [record_frame] expected=frame_id>0 got=" + to_string(frame_id))
    }
    if layer_count < 0 {
        panic("pe_frame_compositor_queue FAIL [record_frame] expected=layer_count>=0 got=" + to_string(layer_count))
    }
    if elapsed_us < 0 {
        panic("pe_frame_compositor_queue FAIL [record_frame] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    if dropped < 0 {
        panic("pe_frame_compositor_queue FAIL [record_frame] expected=dropped>=0 got=" + to_string(dropped))
    }
    if dropped > 1 {
        panic("pe_frame_compositor_queue FAIL [record_frame] expected=dropped<=1 got=" + to_string(dropped))
    }
    let row = to_string(frame_id) + "\t" + to_string(layer_count)
        + "\t" + to_string(elapsed_us) + "\t" + to_string(dropped) + "\n"
    pfcq_append_row(pfcq_frames_path(), row)
}

// ─── frame_count: 기록된 frame 수 ───
fn frame_count() -> int {
    let t = pfcq_read_table(pfcq_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_elapsed_us: 모든 frame elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = pfcq_read_table(pfcq_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── dropped_count: dropped=1 인 frame 수 ───
fn dropped_count() -> int {
    let t = pfcq_read_table(pfcq_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_layers: 모든 frame layer_count 합 ───
fn total_layers() -> int {
    let t = pfcq_read_table(pfcq_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── frame_elapsed_us: 특정 frame_id 의 elapsed_us (없으면 0) ───
fn frame_elapsed_us(frame_id: int) -> int {
    let t = pfcq_read_table(pfcq_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == frame_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pfcq_stats: [frame_count, total_elapsed_us, dropped_count, total_layers] ───
fn pfcq_stats() -> array {
    let mut out = []
    out.push(frame_count())
    out.push(total_elapsed_us())
    out.push(dropped_count())
    out.push(total_layers())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pfcq-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pfcq()

    // 2. record 5 frames — varying layer_count, ≥1 dropped (deterministic)
    record_frame(670001, 3, 8200, 0)
    r0_emit("pe_frame_compositor_queue_record",
        "\"frame_id\":670001,\"layer_count\":3,\"elapsed_us\":8200,\"dropped\":0,\"target\":\"present\"")

    record_frame(670002, 5, 9100, 0)
    r0_emit("pe_frame_compositor_queue_record",
        "\"frame_id\":670002,\"layer_count\":5,\"elapsed_us\":9100,\"dropped\":0,\"target\":\"present\"")

    record_frame(670003, 7, 22500, 1)
    r0_emit("pe_frame_compositor_queue_record",
        "\"frame_id\":670003,\"layer_count\":7,\"elapsed_us\":22500,\"dropped\":1,\"target\":\"discard\"")

    record_frame(670004, 4, 7800, 0)
    r0_emit("pe_frame_compositor_queue_record",
        "\"frame_id\":670004,\"layer_count\":4,\"elapsed_us\":7800,\"dropped\":0,\"target\":\"present\"")

    record_frame(670005, 6, 10400, 0)
    r0_emit("pe_frame_compositor_queue_record",
        "\"frame_id\":670005,\"layer_count\":6,\"elapsed_us\":10400,\"dropped\":0,\"target\":\"present\"")

    // 3. frame_count = 5
    let c = frame_count()
    if c != 5 {
        panic("pe_frame_compositor_queue FAIL [frame_count] expected=5 got=" + to_string(c))
    }

    // 4. total_elapsed_us = 8200+9100+22500+7800+10400 = 58000
    let te = total_elapsed_us()
    if te != 58000 {
        panic("pe_frame_compositor_queue FAIL [total_elapsed_us] expected=58000 got=" + to_string(te))
    }

    // 5. dropped_count = 1
    let dc = dropped_count()
    if dc != 1 {
        panic("pe_frame_compositor_queue FAIL [dropped_count] expected=1 got=" + to_string(dc))
    }

    // 6. total_layers = 3+5+7+4+6 = 25
    let tl = total_layers()
    if tl != 25 {
        panic("pe_frame_compositor_queue FAIL [total_layers] expected=25 got=" + to_string(tl))
    }

    // 7. frame_elapsed_us sanity
    let f3 = frame_elapsed_us(670003)
    if f3 != 22500 {
        panic("pe_frame_compositor_queue FAIL [frame_elapsed_us(670003)] expected=22500 got=" + to_string(f3))
    }
    let f5 = frame_elapsed_us(670005)
    if f5 != 10400 {
        panic("pe_frame_compositor_queue FAIL [frame_elapsed_us(670005)] expected=10400 got=" + to_string(f5))
    }
    let f_miss = frame_elapsed_us(9999)
    if f_miss != 0 {
        panic("pe_frame_compositor_queue FAIL [frame_elapsed_us(9999)] expected=0 got=" + to_string(f_miss))
    }

    // 8. pfcq_stats() = [5, 58000, 1, 25]
    let s = pfcq_stats()
    if len(s) != 4 {
        panic("pe_frame_compositor_queue FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_frame_compositor_queue FAIL [stats frame_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 58000 {
        panic("pe_frame_compositor_queue FAIL [stats total_elapsed_us] expected=58000 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_frame_compositor_queue FAIL [stats dropped_count] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 25 {
        panic("pe_frame_compositor_queue FAIL [stats total_layers] expected=25 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_frame_compositor_queue_stats",
        "\"frame_count\":" + to_string(s[0])
        + ",\"total_elapsed_us\":" + to_string(s[1])
        + ",\"dropped_count\":" + to_string(s[2])
        + ",\"total_layers\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_frame_compositor_queue FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pfcq()
    let s2 = pfcq_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_frame_compositor_queue FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_frame_compositor_queue self_test PASS (frames=" + to_string(s[0])
        + ", elapsed_us=" + to_string(s[1]) + ", dropped=" + to_string(s[2])
        + ", layers=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pfcq_stats()
            println("frame_count\t" + to_string(s[0]))
            println("total_elapsed_us\t" + to_string(s[1]))
            println("dropped_count\t" + to_string(s[2]))
            println("total_layers\t" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let fid = to_int(a[3])
                println("frame_elapsed_us\t" + to_string(frame_elapsed_us(fid)))
                return
            }
            println("usage: hexa run pe_frame_compositor_queue.hexa elapsed <frame_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let what = a[3]
                if what == "dropped" {
                    println("dropped_count\t" + to_string(dropped_count()))
                    return
                }
                println("usage: hexa run pe_frame_compositor_queue.hexa count dropped")
                return
            }
            println("usage: hexa run pe_frame_compositor_queue.hexa count dropped")
            return
        }
        if sub == "cleanup" {
            cleanup_pfcq()
            println("cleaned: " + pfcq_dir())
            return
        }
        if sub == "dir" {
            println(pfcq_dir())
            return
        }
    }
    println("usage: hexa run pe_frame_compositor_queue.hexa { self-test | stats | elapsed <frame_id> | count dropped | cleanup | dir }")
}
