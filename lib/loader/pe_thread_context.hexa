// lib/loader/pe_thread_context.hexa — cycle 74 GetThreadContext / SetThreadContext telemetry skeleton
//
// Win32 GetThreadContext / SetThreadContext op tracker. CONTEXT_FULL 은
// integer / control / segment / floating-point register block 으로 구성되며,
// ContextFlags bitmask 가 partial read/write 를 지시. 본 module 은 op_id /
// op_kind / context_flags / thread_id 를 TSV 로 persist 하고 aggregate stat
// 을 산출 — 실제 GetThreadContext / SetThreadContext syscall 호출 X (stage6).
//
// own 1 enforcement: Wine / CrossOver / GPTK / Whisky / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = get  (GetThreadContext)
//   2 = set  (SetThreadContext)
//
// CONTEXT_* bitmask:
//   CONTEXT_CONTROL         = 0x1
//   CONTEXT_INTEGER         = 0x2
//   CONTEXT_SEGMENTS        = 0x4
//   CONTEXT_FLOATING_POINT  = 0x8
//   CONTEXT_DEBUG_REGISTERS = 0x10
//   CONTEXT_FULL            = 0x7  (CONTROL | INTEGER | SEGMENTS)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t context_flags<int> \t thread_id<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ptc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_thread_context"
}

fn ptc_ops_path() -> str {
    return ptc_dir() + "/ops.tsv"
}

fn ptc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ptc_dir() + "'")
}

fn cleanup_ptc() -> void {
    ptc_ensure_dir()
    let _ = exec("rm -f '" + ptc_ops_path() + "'")
}

// ─── 공통 file IO ───
fn ptc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ptc_append_row(path: str, row: str) -> void {
    ptc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: thread context op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, context_flags: int, thread_id: int) -> void {
    if op_id <= 0 {
        panic("pe_thread_context FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_thread_context FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 2 {
        panic("pe_thread_context FAIL [record_op] expected=op_kind<=2 got=" + to_string(op_kind))
    }
    if context_flags < 0 {
        panic("pe_thread_context FAIL [record_op] expected=context_flags>=0 got=" + to_string(context_flags))
    }
    if context_flags > 31 {
        panic("pe_thread_context FAIL [record_op] expected=context_flags<=31 got=" + to_string(context_flags))
    }
    if thread_id <= 0 {
        panic("pe_thread_context FAIL [record_op] expected=thread_id>0 got=" + to_string(thread_id))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(context_flags) + "\t" + to_string(thread_id) + "\n"
    ptc_append_row(ptc_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = ptc_read_table(ptc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = ptc_read_table(ptc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_flag_bit: (context_flags AND bit_mask) != 0 인 op 수 ───
fn count_by_flag_bit(bit_mask: int) -> int {
    let t = ptc_read_table(ptc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let flags = to_int(parts[2])
                // bitwise AND via division/modulo decomposition
                let mut a = flags
                let mut b = bit_mask
                let mut and_acc = 0
                let mut bit = 1
                while bit <= 16 {
                    let a_lo = a - (a / 2) * 2
                    let b_lo = b - (b / 2) * 2
                    if a_lo == 1 {
                        if b_lo == 1 {
                            and_acc = and_acc + bit
                        }
                    }
                    a = a / 2
                    b = b / 2
                    bit = bit * 2
                }
                if and_acc != 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_threads: 고유 thread_id 수 ───
fn distinct_threads() -> int {
    let t = ptc_read_table(ptc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let tid = to_int(parts[3])
                let mut found = false
                let j = 0
                while j < len(seen) {
                    if seen[j] == tid {
                        found = true
                    }
                    j = j + 1
                }
                if found == false {
                    seen.push(tid)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── op_context_flags: 특정 op_id 의 context_flags (없으면 -1) ───
fn op_context_flags(op_id: int) -> int {
    let t = ptc_read_table(ptc_ops_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── ptc_stats: [op_count, count_kind_get, count_kind_set, distinct_threads] ───
fn ptc_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(count_by_op_kind(1))
    out.push(count_by_op_kind(2))
    out.push(distinct_threads())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ptc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ptc()

    // 2. record 5 ops — mix of get/set + flag bits + threads
    //    op 740001: get,  CONTROL|INTEGER (0x3),         tid=4001
    //    op 740002: get,  CONTEXT_FULL  (0x7),           tid=4002
    //    op 740003: set,  INTEGER       (0x2),           tid=4001
    //    op 740004: set,  FLOATING_POINT|DEBUG (0x18),   tid=4003
    //    op 740005: get,  SEGMENTS|DEBUG_REGISTERS (0x14),tid=4002
    record_op(740001, 1, 3, 4001)
    r0_emit("pe_thread_context_record",
        "\"op_id\":740001,\"op_kind\":1,\"context_flags\":3,\"thread_id\":4001,\"target\":\"get\"")

    record_op(740002, 1, 7, 4002)
    r0_emit("pe_thread_context_record",
        "\"op_id\":740002,\"op_kind\":1,\"context_flags\":7,\"thread_id\":4002,\"target\":\"get\"")

    record_op(740003, 2, 2, 4001)
    r0_emit("pe_thread_context_record",
        "\"op_id\":740003,\"op_kind\":2,\"context_flags\":2,\"thread_id\":4001,\"target\":\"set\"")

    record_op(740004, 2, 24, 4003)
    r0_emit("pe_thread_context_record",
        "\"op_id\":740004,\"op_kind\":2,\"context_flags\":24,\"thread_id\":4003,\"target\":\"set\"")

    record_op(740005, 1, 20, 4002)
    r0_emit("pe_thread_context_record",
        "\"op_id\":740005,\"op_kind\":1,\"context_flags\":20,\"thread_id\":4002,\"target\":\"get\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_thread_context FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_op_kind sanity — get=3, set=2
    let kg = count_by_op_kind(1)
    if kg != 3 {
        panic("pe_thread_context FAIL [count_by_op_kind(1)] expected=3 got=" + to_string(kg))
    }
    let ks = count_by_op_kind(2)
    if ks != 2 {
        panic("pe_thread_context FAIL [count_by_op_kind(2)] expected=2 got=" + to_string(ks))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_thread_context FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 5. count_by_flag_bit sanity
    //    CONTROL  (0x1): rows {3,7}                        → 2
    //    INTEGER  (0x2): rows {3,7,2}                      → 3
    //    SEGMENTS (0x4): rows {7,20}                       → 2
    //    FLOATING (0x8): rows {24}                         → 1
    //    DEBUG    (0x10): rows {24,20}                     → 2
    //    NONE     (0x0): 0
    let fc = count_by_flag_bit(1)
    if fc != 2 {
        panic("pe_thread_context FAIL [count_by_flag_bit(0x1)] expected=2 got=" + to_string(fc))
    }
    let fi = count_by_flag_bit(2)
    if fi != 3 {
        panic("pe_thread_context FAIL [count_by_flag_bit(0x2)] expected=3 got=" + to_string(fi))
    }
    let fs = count_by_flag_bit(4)
    if fs != 2 {
        panic("pe_thread_context FAIL [count_by_flag_bit(0x4)] expected=2 got=" + to_string(fs))
    }
    let ff = count_by_flag_bit(8)
    if ff != 1 {
        panic("pe_thread_context FAIL [count_by_flag_bit(0x8)] expected=1 got=" + to_string(ff))
    }
    let fd = count_by_flag_bit(16)
    if fd != 2 {
        panic("pe_thread_context FAIL [count_by_flag_bit(0x10)] expected=2 got=" + to_string(fd))
    }
    let fz = count_by_flag_bit(0)
    if fz != 0 {
        panic("pe_thread_context FAIL [count_by_flag_bit(0x0)] expected=0 got=" + to_string(fz))
    }

    // 6. distinct_threads = 3 (4001, 4002, 4003)
    let dt = distinct_threads()
    if dt != 3 {
        panic("pe_thread_context FAIL [distinct_threads] expected=3 got=" + to_string(dt))
    }

    // 7. op_context_flags sanity
    let f2 = op_context_flags(740002)
    if f2 != 7 {
        panic("pe_thread_context FAIL [op_context_flags(740002)] expected=7 got=" + to_string(f2))
    }
    let f4 = op_context_flags(740004)
    if f4 != 24 {
        panic("pe_thread_context FAIL [op_context_flags(740004)] expected=24 got=" + to_string(f4))
    }
    let f_miss = op_context_flags(9999)
    if f_miss != -1 {
        panic("pe_thread_context FAIL [op_context_flags(9999)] expected=-1 got=" + to_string(f_miss))
    }

    // 8. ptc_stats() = [5, 3, 2, 3]
    let s = ptc_stats()
    if len(s) != 4 {
        panic("pe_thread_context FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_thread_context FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_thread_context FAIL [stats kind_get] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_thread_context FAIL [stats kind_set] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_thread_context FAIL [stats distinct_threads] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_thread_context_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"kind_get\":" + to_string(s[1])
        + ",\"kind_set\":" + to_string(s[2])
        + ",\"distinct_threads\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_thread_context FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_ptc()
    let s2 = ptc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_thread_context FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_thread_context self_test PASS (ops=" + to_string(s[0])
        + ", get=" + to_string(s[1]) + ", set=" + to_string(s[2])
        + ", threads=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ptc_stats()
            println("op_count\t" + to_string(s[0]))
            println("kind_get\t" + to_string(s[1]))
            println("kind_set\t" + to_string(s[2]))
            println("distinct_threads\t" + to_string(s[3]))
            return
        }
        if sub == "flags" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_context_flags\t" + to_string(op_context_flags(oid)))
                return
            }
            println("usage: hexa run pe_thread_context.hexa flags <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_thread_context.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ptc()
            println("cleaned: " + ptc_dir())
            return
        }
        if sub == "dir" {
            println(ptc_dir())
            return
        }
    }
    println("usage: hexa run pe_thread_context.hexa { self-test | stats | flags <op_id> | count <op_kind> | cleanup | dir }")
}
