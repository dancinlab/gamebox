// lib/loader/pe_vectored_exception.hexa — VEH/VCH chain skeleton
//
// AddVectoredExceptionHandler / AddVectoredContinueHandler — process-wide
// handler list. SEH __except 보다 먼저 호출됨. anti-debug code 가 자주
// 사용 (Int 0x2D / debugger present check). chain order = 등록 순서 또는
// FirstHandler flag 로 head 삽입.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 handler entry tracker — 실 RtlAddVectoredExceptionHandler
//   호출 X. 등록 record 와 invoke count 만 누적.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// handler_kind code:
//   1 = exception handler (VEH)
//   2 = continue handler  (VCH)
//
// first_handler flag:
//   0 = appended at tail
//   1 = inserted at head (FirstHandler != 0)
//
// persist schema (TSV — entries.tsv):
//   entry_id<int> \t handler_kind<int> \t first_handler<int> \t invoke_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pve_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_vectored_exception"
}

fn pve_entries_path() -> str {
    return pve_dir() + "/entries.tsv"
}

fn pve_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pve_dir() + "'")
}

fn cleanup_pve() -> void {
    pve_ensure_dir()
    let _ = exec("rm -f '" + pve_entries_path() + "'")
}

// ─── 공통 file IO ───
fn pve_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pve_append_row(path: str, row: str) -> void {
    pve_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_entry: VEH/VCH entry 1 건 기록 ───
fn record_entry(entry_id: int, handler_kind: int, first_handler: int, invoke_count: int) -> void {
    if entry_id <= 0 {
        panic("pe_vectored_exception FAIL [record_entry] expected=entry_id>0 got=" + to_string(entry_id))
    }
    if handler_kind < 1 {
        panic("pe_vectored_exception FAIL [record_entry] expected=handler_kind>=1 got=" + to_string(handler_kind))
    }
    if handler_kind > 2 {
        panic("pe_vectored_exception FAIL [record_entry] expected=handler_kind<=2 got=" + to_string(handler_kind))
    }
    if first_handler < 0 {
        panic("pe_vectored_exception FAIL [record_entry] expected=first_handler>=0 got=" + to_string(first_handler))
    }
    if first_handler > 1 {
        panic("pe_vectored_exception FAIL [record_entry] expected=first_handler<=1 got=" + to_string(first_handler))
    }
    if invoke_count < 0 {
        panic("pe_vectored_exception FAIL [record_entry] expected=invoke_count>=0 got=" + to_string(invoke_count))
    }
    let row = to_string(entry_id) + "\t" + to_string(handler_kind)
        + "\t" + to_string(first_handler) + "\t" + to_string(invoke_count) + "\n"
    pve_append_row(pve_entries_path(), row)
}

// ─── entry_count: total entry 수 ───
fn entry_count() -> int {
    let t = pve_read_table(pve_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_invokes: 모든 entry invoke_count 합 ───
fn total_invokes() -> int {
    let t = pve_read_table(pve_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_handler_kind: 특정 handler_kind 의 entry 수 ───
fn count_by_handler_kind(kind: int) -> int {
    let t = pve_read_table(pve_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── first_handler_count: first_handler=1 인 entry 수 ───
fn first_handler_count() -> int {
    let t = pve_read_table(pve_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── entry_invokes: 특정 entry_id 의 invoke_count (없으면 0) ───
fn entry_invokes(entry_id: int) -> int {
    let t = pve_read_table(pve_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == entry_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pve_stats: [entry_count, total_invokes, first_handler_count, count_by_handler_kind(1)] ───
fn pve_stats() -> array {
    let mut out = []
    out.push(entry_count())
    out.push(total_invokes())
    out.push(first_handler_count())
    out.push(count_by_handler_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pve-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pve()

    // 2. record 5 entries (≥1 each handler_kind, ≥2 first_handler)
    record_entry(120001, 1, 1, 3)
    r0_emit("pe_vectored_exception_record",
        "\"entry_id\":120001,\"handler_kind\":1,\"first_handler\":1,\"invoke_count\":3,\"target\":\"veh_head\"")

    record_entry(120002, 1, 0, 5)
    r0_emit("pe_vectored_exception_record",
        "\"entry_id\":120002,\"handler_kind\":1,\"first_handler\":0,\"invoke_count\":5,\"target\":\"veh_tail\"")

    record_entry(120003, 2, 1, 2)
    r0_emit("pe_vectored_exception_record",
        "\"entry_id\":120003,\"handler_kind\":2,\"first_handler\":1,\"invoke_count\":2,\"target\":\"vch_head\"")

    record_entry(120004, 2, 0, 0)
    r0_emit("pe_vectored_exception_record",
        "\"entry_id\":120004,\"handler_kind\":2,\"first_handler\":0,\"invoke_count\":0,\"target\":\"vch_tail\"")

    record_entry(120005, 1, 0, 7)
    r0_emit("pe_vectored_exception_record",
        "\"entry_id\":120005,\"handler_kind\":1,\"first_handler\":0,\"invoke_count\":7,\"target\":\"veh_anti_debug\"")

    // 3. entry_count = 5
    let c = entry_count()
    if c != 5 {
        panic("pe_vectored_exception FAIL [entry_count] expected=5 got=" + to_string(c))
    }

    // 4. total_invokes = 17
    let ti = total_invokes()
    if ti != 17 {
        panic("pe_vectored_exception FAIL [total_invokes] expected=17 got=" + to_string(ti))
    }

    // 5. count_by_handler_kind sanity
    let k1 = count_by_handler_kind(1)
    if k1 != 3 {
        panic("pe_vectored_exception FAIL [count_by_handler_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_handler_kind(2)
    if k2 != 2 {
        panic("pe_vectored_exception FAIL [count_by_handler_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k99 = count_by_handler_kind(99)
    if k99 != 0 {
        panic("pe_vectored_exception FAIL [count_by_handler_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. first_handler_count = 2
    let fh = first_handler_count()
    if fh != 2 {
        panic("pe_vectored_exception FAIL [first_handler_count] expected=2 got=" + to_string(fh))
    }

    // 7. entry_invokes sanity
    let i2 = entry_invokes(120002)
    if i2 != 5 {
        panic("pe_vectored_exception FAIL [entry_invokes(120002)] expected=5 got=" + to_string(i2))
    }
    let i5 = entry_invokes(120005)
    if i5 != 7 {
        panic("pe_vectored_exception FAIL [entry_invokes(120005)] expected=7 got=" + to_string(i5))
    }
    let i_miss = entry_invokes(9999)
    if i_miss != 0 {
        panic("pe_vectored_exception FAIL [entry_invokes(9999)] expected=0 got=" + to_string(i_miss))
    }

    // 8. pve_stats() = [5, 17, 2, 3]
    let s = pve_stats()
    if len(s) != 4 {
        panic("pe_vectored_exception FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_vectored_exception FAIL [stats entry_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 17 {
        panic("pe_vectored_exception FAIL [stats total_invokes] expected=17 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_vectored_exception FAIL [stats first_handler_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_vectored_exception FAIL [stats count_kind(1)] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_vectored_exception_stats",
        "\"entry_count\":" + to_string(s[0])
        + ",\"total_invokes\":" + to_string(s[1])
        + ",\"first_handler_count\":" + to_string(s[2])
        + ",\"kind_veh\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_vectored_exception FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pve()
    let s2 = pve_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_vectored_exception FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_vectored_exception self_test PASS (entries=" + to_string(s[0])
        + ", invokes=" + to_string(s[1]) + ", first=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pve_stats()
            println("entry_count\t" + to_string(s[0]))
            println("total_invokes\t" + to_string(s[1]))
            println("first_handler_count\t" + to_string(s[2]))
            println("count_kind_veh\t" + to_string(s[3]))
            return
        }
        if sub == "invokes" {
            if len(a) >= 4 {
                let eid = to_int(a[3])
                println("entry_invokes\t" + to_string(entry_invokes(eid)))
                return
            }
            println("usage: hexa run pe_vectored_exception.hexa invokes <entry_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_handler_kind\t" + to_string(count_by_handler_kind(kind)))
                return
            }
            println("usage: hexa run pe_vectored_exception.hexa count <handler_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pve()
            println("cleaned: " + pve_dir())
            return
        }
        if sub == "dir" {
            println(pve_dir())
            return
        }
    }
    println("usage: hexa run pe_vectored_exception.hexa { self-test | stats | invokes <entry_id> | count <handler_kind> | cleanup | dir }")
}
