// lib/loader/win32_version.hexa — Phase 4h — version.dll resource info
//
// own 1: Wine 0. Microsoft Version Info spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe version imports (실측):
//   GetFileVersionInfoSizeW
//   VerQueryValueW
//   GetFileVersionInfoW
//
// PE 의 RT_VERSION resource 에서 ProductVersion / FileVersion 등 추출.
// macOS 의 CFBundleShortVersionString / Info.plist 와 유사한 개념.
// skeleton — synthetic ProductVersion "0.0.0.0" 반환.

use "../perf/r0_common"

fn version_table() -> str {
    let t = ""
    t = t + "GetFileVersionInfoSizeW\tCFBundleShortVersionString_size\tVersionInfo\tskeleton\n"
    t = t + "VerQueryValueW\tCFBundleInfo_query\tVersionInfo\tskeleton\n"
    t = t + "GetFileVersionInfoW\tCFBundleInfo_read\tVersionInfo\tskeleton\n"
    return t
}

fn version_table_size() -> int {
    let lines = version_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = version_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

// version_info(file) → synthetic key=value
fn version_info(file: str) -> str {
    return "ProductVersion=0.0.0.0;FileVersion=0.0.0.0;CompanyName=unknown;FileDescription=" + file
}

fn self_test() -> void {
    let sid = "versiontest-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = version_table_size()
    if sz != 3 { panic("win32_version FAIL [size] expected=3 got=" + to_string(sz)) }

    let m = lookup_mapping("VerQueryValueW")
    if !m.contains("VersionInfo") { panic("win32_version FAIL [lookup]") }

    let unk = lookup_mapping("UnknownVersionFunc")
    if unk != "" { panic("win32_version FAIL [lookup unknown]") }

    let info = version_info("/tmp/fake.exe")
    if !info.contains("ProductVersion") { panic("win32_version FAIL [info content]") }

    r0_emit("version_query", "\"file\":\"/tmp/fake.exe\",\"product_version\":\"0.0.0.0\"")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_version FAIL [emit count]") }

    println("  ✅ win32_version self_test PASS (3 funcs, synthetic version info, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "info" && len(a) >= 4 {
            println(version_info(a[3]))
            return
        }
    }
    println("usage: hexa run win32_version.hexa { self-test | info <file> }")
}
