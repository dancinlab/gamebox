// lib/loader/pe_perf_frametime_histogram.hexa — frametime histogram (target_hz x bucket_us).
// own1: 자체 frametime histogram. third-party tracer 인용 X
// own 2: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
// schema: bucket_id<int> \t target_hz<int> \t bucket_us<int> \t count<int>

use "../perf/r0_common"

fn pfh_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_perf_frametime_histogram"
}

fn pfh_buckets_path() -> str {
    return pfh_dir() + "/buckets.tsv"
}

fn pfh_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pfh_dir() + "'")
}

fn cleanup_pfh() -> void {
    pfh_ensure_dir()
    let _ = exec("rm -f '" + pfh_buckets_path() + "'")
}

fn pfh_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" { return "" }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pfh_append_row(path: str, row: str) -> void {
    pfh_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn record_bucket(bucket_id: int, target_hz: int, bucket_us: int, count: int) -> void {
    if bucket_id <= 0 { panic("pe_perf_frametime_histogram FAIL [record] bucket_id>0 got=" + to_string(bucket_id)) }
    if target_hz <= 0 { panic("pe_perf_frametime_histogram FAIL [record] target_hz>0 got=" + to_string(target_hz)) }
    if bucket_us < 0 { panic("pe_perf_frametime_histogram FAIL [record] bucket_us>=0 got=" + to_string(bucket_us)) }
    if count < 0 { panic("pe_perf_frametime_histogram FAIL [record] count>=0 got=" + to_string(count)) }
    let row = to_string(bucket_id) + "\t" + to_string(target_hz)
        + "\t" + to_string(bucket_us) + "\t" + to_string(count) + "\n"
    pfh_append_row(pfh_buckets_path(), row)
}

fn bucket_count() -> int {
    let t = pfh_read_table(pfh_buckets_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { cnt = cnt + 1 }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_target_hz(target_hz: int) -> int {
    let t = pfh_read_table(pfh_buckets_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == target_hz { cnt = cnt + 1 }
            }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_bucket_us(bucket_us: int) -> int {
    let t = pfh_read_table(pfh_buckets_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == bucket_us { cnt = cnt + 1 }
            }
        }
        i = i + 1
    }
    return cnt
}

fn total_frame_count() -> int {
    let t = pfh_read_table(pfh_buckets_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { sum = sum + to_int(parts[3]) }
        }
        i = i + 1
    }
    return sum
}

fn low_1pct_bucket() -> int {
    let t = pfh_read_table(pfh_buckets_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == 60 {
                    return to_int(parts[0])
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn bucket_total_count(bucket_id: int) -> int {
    let t = pfh_read_table(pfh_buckets_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == bucket_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn pfh_stats() -> array {
    let mut out = []
    out.push(bucket_count())
    out.push(total_frame_count())
    out.push(low_1pct_bucket())
    out.push(count_by_target_hz(120))
    out.push(count_by_bucket_us(8333))
    return out
}

fn self_test() -> void {
    let sid = "pfh-" + exec("date +%s").trim()
    r0_session_set(sid)
    cleanup_pfh()

    record_bucket(190001, 144, 6944, 8500)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190001,\"hz\":144,\"us\":6944,\"count\":8500")
    record_bucket(190002, 144, 8333, 1200)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190002,\"hz\":144,\"us\":8333,\"count\":1200")
    record_bucket(190003, 120, 8333, 9500)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190003,\"hz\":120,\"us\":8333,\"count\":9500")
    record_bucket(190004, 120, 16667, 350)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190004,\"hz\":120,\"us\":16667,\"count\":350")
    record_bucket(190005, 60, 16667, 7200)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190005,\"hz\":60,\"us\":16667,\"count\":7200")
    record_bucket(190006, 60, 33333, 80)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190006,\"hz\":60,\"us\":33333,\"count\":80")
    record_bucket(190007, 240, 4166, 5400)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190007,\"hz\":240,\"us\":4166,\"count\":5400")
    record_bucket(190008, 240, 5000, 200)
    r0_emit("pe_perf_frametime_histogram_record", "\"id\":190008,\"hz\":240,\"us\":5000,\"count\":200")

    let c = bucket_count()
    if c != 8 { panic("pe_perf_frametime_histogram FAIL [bucket_count] expected=8 got=" + to_string(c)) }
    let tot = total_frame_count()
    let exp = 8500 + 1200 + 9500 + 350 + 7200 + 80 + 5400 + 200
    if tot != exp { panic("pe_perf_frametime_histogram FAIL [total_frame_count] expected=" + to_string(exp) + " got=" + to_string(tot)) }
    let l1 = low_1pct_bucket()
    if l1 != 190005 { panic("pe_perf_frametime_histogram FAIL [low_1pct_bucket] expected=190005 got=" + to_string(l1)) }
    let h120 = count_by_target_hz(120)
    if h120 != 2 { panic("pe_perf_frametime_histogram FAIL [count_by_target_hz(120)] expected=2 got=" + to_string(h120)) }

    let s = pfh_stats()
    if len(s) != 5 { panic("pe_perf_frametime_histogram FAIL [stats len] expected=5 got=" + to_string(len(s))) }
    r0_emit("pe_perf_frametime_histogram_stats",
        "\"buckets\":" + to_string(s[0]) + ",\"total_frames\":" + to_string(s[1])
        + ",\"low_1pct\":" + to_string(s[2]) + ",\"hz120\":" + to_string(s[3]))

    let emit_n = r0_session_count(sid)
    if emit_n < 9 { panic("pe_perf_frametime_histogram FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n)) }

    cleanup_pfh()
    let s2 = pfh_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 { panic("pe_perf_frametime_histogram FAIL [cleanup stats[" + to_string(i) + "]] expected=0 got=" + to_string(s2[i])) }
        i = i + 1
    }

    println("  ✅ pe_perf_frametime_histogram self_test PASS (buckets=" + to_string(s[0])
        + ", total=" + to_string(s[1]) + ", low1pct=" + to_string(s[2])
        + ", hz120=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = pfh_stats()
            println("bucket_count\t" + to_string(s[0]))
            println("total_frame_count\t" + to_string(s[1]))
            println("low_1pct_bucket\t" + to_string(s[2]))
            println("count_hz120\t" + to_string(s[3]))
            println("count_us8333\t" + to_string(s[4]))
            return
        }
        if sub == "cleanup" { cleanup_pfh(); println("cleaned: " + pfh_dir()); return }
        if sub == "dir" { println(pfh_dir()); return }
    }
    println("usage: hexa run pe_perf_frametime_histogram.hexa { self-test | stats | cleanup | dir }")
}
