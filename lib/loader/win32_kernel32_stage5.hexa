// lib/loader/win32_kernel32_stage5.hexa — Battle.net Setup KERNEL32 leftover
//
// stage1/2/3/4/extras 후 남은 KERNEL32 imports. typically ~10-30 functions.
//
// 검증 결과 (2026-05-01, Battle.net-Setup.exe DLL index 5, 224 imports):
//   stage1 covers : CreateFileW ReadFile WriteFile CloseHandle GetFileSize
//                   VirtualAlloc VirtualFree HeapAlloc HeapFree Sleep GetTickCount   (11)
//   stage2 covers : CreateThread ExitThread WaitForSingleObject CreateMutexW
//                   ReleaseMutex CreateEventW SetEvent ResetEvent
//                   InitializeCriticalSection EnterCriticalSection
//                   LeaveCriticalSection DeleteCriticalSection GetCurrentThread     (13)
//   stage3 covers : CreateProcessW GetCurrentProcess GetCurrentProcessId
//                   TerminateProcess GetStartupInfoW GetCommandLineW
//                   GetExitCodeProcess LoadLibraryW FreeLibrary GetProcAddress
//                   GetModuleHandleW                                                  (11)
//   stage4 stubs  : 191 imports.
//   ─────────────────────────────────────────────────
//   total covered : 226 (≥ 224 — superset, full Battle.net coverage)
//   stage5 stubs  : 0 (모든 import 가 stage1-4 에 의해 cover 됨)
//
// 본 module 은 future Battle.net update / 다른 .exe (e.g. World of Warcraft Launcher)
// 에서 새로운 KERNEL32 import 가 발견되면 그 자리를 채울 placeholder.
//
// Return value convention (stage4 와 동일):
//   HANDLE (Open/Create)         → 1   (fake non-null)
//   INVALID_HANDLE_VALUE         → -1  (FindFirstFile family, sentinel)
//   BOOL                         → 1   (TRUE)
//   DWORD / int / void-equivalent→ 0
//   HMODULE / HRSRC / HGLOBAL    → 1

use "../perf/r0_common"

// ─── stage5 stubs (0 functions — all Battle.net imports already covered) ───
//
// (stub functions go here when new imports are discovered in future .exe analysis.)

// ─── stub names registry (for `list` subcommand) ───
fn stub_names() -> array {
    let mut a = []
    return a
}

// ─── self_test — call each stub once with safe args ───
fn self_test() -> void {
    println("  win32_kernel32_stage5 self_test")

    // (no stub calls — list is empty.)

    let names = stub_names()
    let n = len(names)
    if n != 0 {
        panic("win32_kernel32_stage5 FAIL [stub_count] expected=0 got=" + to_string(n))
    }

    println("  ✅ win32_kernel32_stage5 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            let names = stub_names()
            let n = len(names)
            let i = 0
            while i < n {
                println(names[i])
                i = i + 1
            }
            return
        }
    }
    println("usage: hexa run win32_kernel32_stage5.hexa { self-test | list }")
}
