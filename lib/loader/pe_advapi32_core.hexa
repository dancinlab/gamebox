    record_registry_op(1, "open", "0x80000002", "SOFTWARE\\Blizzard Entertainment\\Diablo II Resurrected", "PARTIAL")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"registry_op\",\"reg_id\":1,\"op_id\":\"open\",\"hkey_hex\":\"0x80000002\",\"sub_path_w_synth\":\"SOFTWARE\\\\Blizzard Entertainment\\\\Diablo II Resurrected\",\"out_hkey_hex\":\"0x000A0500\",\"sam_desired\":\"0x00020019\",\"status\":\"PARTIAL\"")
