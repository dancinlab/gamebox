    record_syscall_invoke(3, 2, "RegQueryValueExW", "PARTIAL")
    println("__ADVAPI32__ PARTIAL RegQueryValueExW")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"RegQueryValueExW\",\"fn_group\":\"registry\",\"status\":\"PARTIAL\",\"hkey_hex\":\"0x000A0500\",\"value_name_w_synth\":\"InstallPath\",\"value_kind\":\"REG_SZ\",\"value_data_w_synth\":\"C:\\\\Battle.net\\\\D2R\"")
    record_syscall_invoke(4, 3, "RegSetValueExW", "PARTIAL")
