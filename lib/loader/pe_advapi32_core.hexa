// lib/loader/pe_advapi32_core.hexa — ADVAPI32.dll core syscall surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine advapi32 source 인용 0.
//       Keychain/SecKeychainItem/Service Management/launchd 직접 binding 0. windows.h/winreg.h/
//       winsvc.h/wincrypt.h reference shape 만 (HKEY/SC_HANDLE/HCRYPTPROV/SECURITY_DESCRIPTOR
//       /TOKEN_*). 실 RegOpenKeyExW / 실 OpenSCManagerW / 실 OpenProcessToken / 실
//       CryptAcquireContextW = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + panic 형식. PARTIAL emit
//       명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1+L2+L3+L4+L5 ALL OK (사용자 lock-in 2026-05-03).
//
// Track Q3 — ADVAPI32 (advapi32.dll) core registry/security/service/token/crypto surface
// coverage 18 fn skeleton row. Track O (KERNEL32 18 fn) + Track Q1 (USER32 20 fn) + Track Q2
// (GDI32 15 fn) 후 본 Track Q3 는 ADVAPI32 5 group baseline land. cycle 30 측 61/435 (~14.02%)
// → cycle 31 측 79/435 (~18.16%) coverage progression (+18 fn 신규).
//
// 대상 fn (18 fn — 5 group, fn_kind 0..17):
//   Registry (5):  RegOpenKeyExW/RegCloseKey/RegQueryValueExW/RegSetValueExW/RegEnumKeyExW
//   Security (5):  InitializeSecurityDescriptor/SetSecurityDescriptorDacl/GetSecurityInfo/
//                  SetSecurityInfo/ConvertStringSecurityDescriptorToSecurityDescriptorW
//   Service (3):   OpenSCManagerW/OpenServiceW/CloseServiceHandle
//   Token (3):     OpenProcessToken/GetTokenInformation/AdjustTokenPrivileges
//   Crypto (2):    CryptAcquireContextW/CryptReleaseContext
//
// synthetic HKEY "0x80000002" (HKEY_LOCAL_MACHINE) + sub_hkey "0x000A0500". SC_HANDLE
// "0x000B0600" (manager) + svc "0x000B0700". token_handle "0x000C0800". HCRYPTPROV
// "0x000D0900". SECURITY_DESCRIPTOR (20 byte: Revision 0x01 + Sbz1 + Control 0x8004 LE +
// Owner/Group/Sacl/Dacl offsets). SID (12 byte). persist (TSV 4 table): syscall_invoke /
// registry_op / service_op / sec_token_event.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn padv_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_advapi32_core"
}

fn padv_syscall_invoke_path() -> str {
    return padv_dir() + "/syscall_invoke.tsv"
}

fn padv_registry_op_path() -> str {
    return padv_dir() + "/registry_op.tsv"
}

fn padv_service_op_path() -> str {
    return padv_dir() + "/service_op.tsv"
}

fn padv_sec_token_event_path() -> str {
    return padv_dir() + "/sec_token_event.tsv"
}

fn padv_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + padv_dir() + "'")
}

fn cleanup_padv() -> void {
    padv_ensure_dir()
    let _ = exec("rm -f '" + padv_syscall_invoke_path() + "' '" + padv_registry_op_path()
        + "' '" + padv_service_op_path() + "' '" + padv_sec_token_event_path() + "'")
}

// ─── 공통 file IO ───
fn padv_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn padv_append_row(path: str, row: str) -> void {
    padv_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn padv_count_rows(path: str, min_cols: int) -> int {
    let t = padv_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (18 fn coverage, fn_kind 0..17) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "RegOpenKeyExW" }
    if k == 1 { return "RegCloseKey" }
    if k == 2 { return "RegQueryValueExW" }
    if k == 3 { return "RegSetValueExW" }
    if k == 4 { return "RegEnumKeyExW" }
    if k == 5 { return "InitializeSecurityDescriptor" }
    if k == 6 { return "SetSecurityDescriptorDacl" }
    if k == 7 { return "GetSecurityInfo" }
    if k == 8 { return "SetSecurityInfo" }
    if k == 9 { return "ConvertStringSecurityDescriptorToSecurityDescriptorW" }
    if k == 10 { return "OpenSCManagerW" }
    if k == 11 { return "OpenServiceW" }
    if k == 12 { return "CloseServiceHandle" }
    if k == 13 { return "OpenProcessToken" }
    if k == 14 { return "GetTokenInformation" }
    if k == 15 { return "AdjustTokenPrivileges" }
    if k == 16 { return "CryptAcquireContextW" }
    if k == 17 { return "CryptReleaseContext" }
    return "unknown"
}

// ─── helper: fn_group_name (5 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 4 {
            return "registry"
        }
    }
    if k >= 5 {
        if k <= 9 {
            return "security"
        }
    }
    if k >= 10 {
        if k <= 12 {
            return "service"
        }
    }
    if k >= 13 {
        if k <= 15 {
            return "token"
        }
    }
    if k >= 16 {
        if k <= 17 {
            return "crypto"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: ADVAPI32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_advapi32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_advapi32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 17 {
        panic("pe_advapi32_core FAIL [record_syscall_invoke] expected=fn_kind<=17 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_advapi32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_advapi32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    padv_append_row(padv_syscall_invoke_path(), row)
}

// ─── record_registry_op: RegOpenKeyExW / RegQueryValueExW / RegSetValueExW / RegCloseKey row ───
fn record_registry_op(reg_id: int, op_id: str, hkey_hex: str, sub_path_w: str, status: str) -> void {
    if reg_id <= 0 {
        panic("pe_advapi32_core FAIL [record_registry_op] expected=reg_id>0 got=" + to_string(reg_id))
    }
    if op_id == "" {
        panic("pe_advapi32_core FAIL [record_registry_op] expected=op_id!=empty got=empty")
    }
    if hkey_hex == "" {
        panic("pe_advapi32_core FAIL [record_registry_op] expected=hkey_hex!=empty got=empty")
    }
    if sub_path_w == "" {
        panic("pe_advapi32_core FAIL [record_registry_op] expected=sub_path_w!=empty got=empty")
    }
    if status == "" {
        panic("pe_advapi32_core FAIL [record_registry_op] expected=status!=empty got=empty")
    }
    let row = to_string(reg_id) + "\t" + op_id + "\t" + hkey_hex + "\t"
        + sub_path_w + "\t" + status + "\n"
    padv_append_row(padv_registry_op_path(), row)
}

