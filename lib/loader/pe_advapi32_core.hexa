    r0_emit("pe_advapi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"RegSetValueExW\",\"fn_group\":\"registry\",\"status\":\"PARTIAL\",\"hkey_hex\":\"0x000A0500\",\"value_name_w_synth\":\"LastRunVersion\",\"value_kind\":\"REG_SZ\",\"data_size\":24")
    record_syscall_invoke(5, 4, "RegEnumKeyExW", "PARTIAL")
    println("__ADVAPI32__ PARTIAL RegEnumKeyExW")
