// ─── record_sec_token_event: SECURITY_DESCRIPTOR / token / crypto fn event row ───
fn record_sec_token_event(evt_id: int, sec_kind: str, fn_name: str, payload_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_advapi32_core FAIL [record_sec_token_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if sec_kind == "" {
        panic("pe_advapi32_core FAIL [record_sec_token_event] expected=sec_kind!=empty got=empty")
    }
    if fn_name == "" {
        panic("pe_advapi32_core FAIL [record_sec_token_event] expected=fn_name!=empty got=empty")
    }
    if payload_hex == "" {
        panic("pe_advapi32_core FAIL [record_sec_token_event] expected=payload_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_advapi32_core FAIL [record_sec_token_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + sec_kind + "\t" + fn_name + "\t"
        + payload_hex + "\t" + status + "\n"
    padv_append_row(padv_sec_token_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return padv_count_rows(padv_syscall_invoke_path(), 4)
}

fn registry_op_count() -> int {
    return padv_count_rows(padv_registry_op_path(), 5)
}

fn service_op_count() -> int {
    return padv_count_rows(padv_service_op_path(), 5)
}

fn sec_token_event_count() -> int {
    return padv_count_rows(padv_sec_token_event_path(), 5)
}

fn padv_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(registry_op_count())
    out.push(service_op_count())
    out.push(sec_token_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "padv-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_padv()

    // ─── 1. syscall_invoke × 18 (one per fn, 5 group coverage) ───
    //   Registry group (5)
    record_syscall_invoke(1, 0, "RegOpenKeyExW", "PARTIAL")
    println("__ADVAPI32__ PARTIAL RegOpenKeyExW")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"RegOpenKeyExW\",\"fn_group\":\"registry\",\"status\":\"PARTIAL\",\"hkey_hex\":\"0x80000002\",\"sub_path_w_synth\":\"SOFTWARE\\\\Blizzard Entertainment\\\\Diablo II Resurrected\",\"out_hkey_hex\":\"0x000A0500\"")
