    r0_emit("pe_advapi32_core_record", "\"kind\":\"sec_token_event\",\"evt_id\":1,\"sec_kind\":\"security_descriptor\",\"fn_name\":\"InitializeSecurityDescriptor\",\"sd_synth_hex\":\"01000480000000000000000000000000\",\"revision\":1,\"control\":\"0x8004\",\"status\":\"PARTIAL\"")
    record_sec_token_event(2, "token", "OpenProcessToken", "00080C00", "PARTIAL")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"sec_token_event\",\"evt_id\":2,\"sec_kind\":\"token\",\"fn_name\":\"OpenProcessToken\",\"token_handle_hex\":\"0x000C0800\",\"desired_access\":\"0x00000020\",\"status\":\"PARTIAL\"")
    record_sec_token_event(3, "token", "GetTokenInformation", "010100000000000512000000", "PARTIAL")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"sec_token_event\",\"evt_id\":3,\"sec_kind\":\"token\",\"fn_name\":\"GetTokenInformation\",\"token_handle_hex\":\"0x000C0800\",\"info_class\":\"TokenUser\",\"sid_synth_hex\":\"010100000000000512000000\",\"sid_revision\":1,\"sub_authority_count\":1,\"status\":\"PARTIAL\"")
    record_sec_token_event(4, "token", "AdjustTokenPrivileges", "00080C00", "PARTIAL")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"sec_token_event\",\"evt_id\":4,\"sec_kind\":\"token\",\"fn_name\":\"AdjustTokenPrivileges\",\"token_handle_hex\":\"0x000C0800\",\"disable_all\":false,\"priv_name_w_synth\":\"SeShutdownPrivilege\",\"status\":\"PARTIAL\"")
    record_sec_token_event(5, "crypto", "CryptAcquireContextW", "00090D00", "PARTIAL")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"sec_token_event\",\"evt_id\":5,\"sec_kind\":\"crypto\",\"fn_name\":\"CryptAcquireContextW\",\"prov_handle_hex\":\"0x000D0900\",\"prov_kind\":1,\"container_w_synth\":\"D2R-CryptoContainer\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 18 {
        panic("pe_advapi32_core FAIL [syscall_invoke_count] expected=18 got=" + to_string(si))
    }
    let ro = registry_op_count()
    if ro != 4 {
        panic("pe_advapi32_core FAIL [registry_op_count] expected=4 got=" + to_string(ro))
    }
    let so = service_op_count()
    if so != 3 {
        panic("pe_advapi32_core FAIL [service_op_count] expected=3 got=" + to_string(so))
    }
    let st = sec_token_event_count()
    if st != 5 {
        panic("pe_advapi32_core FAIL [sec_token_event_count] expected=5 got=" + to_string(st))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "RegOpenKeyExW" { panic("pe_advapi32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(5) != "InitializeSecurityDescriptor" { panic("pe_advapi32_core FAIL [fn_kind_name(5)]") }
    if fn_kind_name(10) != "OpenSCManagerW" { panic("pe_advapi32_core FAIL [fn_kind_name(10)]") }
    if fn_kind_name(13) != "OpenProcessToken" { panic("pe_advapi32_core FAIL [fn_kind_name(13)]") }
    if fn_kind_name(17) != "CryptReleaseContext" { panic("pe_advapi32_core FAIL [fn_kind_name(17)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_advapi32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "registry" { panic("pe_advapi32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(5) != "security" { panic("pe_advapi32_core FAIL [fn_group_name(5)]") }
    if fn_group_name(10) != "service" { panic("pe_advapi32_core FAIL [fn_group_name(10)]") }
    if fn_group_name(13) != "token" { panic("pe_advapi32_core FAIL [fn_group_name(13)]") }
    if fn_group_name(16) != "crypto" { panic("pe_advapi32_core FAIL [fn_group_name(16)]") }
    if fn_group_name(99) != "unknown" { panic("pe_advapi32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = padv_stats()
    if len(s) != 4 { panic("pe_advapi32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 18 { panic("pe_advapi32_core FAIL [stats syscall_invoke_count] expected=18 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_advapi32_core FAIL [stats registry_op_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_advapi32_core FAIL [stats service_op_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 5 { panic("pe_advapi32_core FAIL [stats sec_token_event_count] expected=5 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_advapi32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"registry_op_count\":" + to_string(s[1])
        + ",\"service_op_count\":" + to_string(s[2])
        + ",\"sec_token_event_count\":" + to_string(s[3]))

    r0_emit("pe_advapi32_core_summary",
        "\"target\":\"ADVAPI32.dll\",\"fn_total\":18,\"fn_emit_partial\":18,\"groups\":[\"registry\",\"security\",\"service\",\"token\",\"crypto\"],\"hkey_synth\":\"0x000A0500\",\"sc_handle_synth\":\"0x000B0600\",\"token_handle_synth\":\"0x000C0800\",\"prov_handle_synth\":\"0x000D0900\",\"security_descriptor_synth_bytes\":20,\"sid_synth_bytes\":12,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_advapi32_core_kpi",
        "\"registry_emits\":5,\"security_emits\":5,\"service_emits\":3,\"token_emits\":3,\"crypto_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true")

    // ─── cycle 30 → 31 ADVAPI32 coverage progression evidence emit ───
    r0_emit("pe_advapi32_core_coverage_progression",
        "\"surface\":\"ADVAPI32_full_~25_fn_estimated\",\"cycle_30_count\":61,\"cycle_31_count\":79,\"delta\":18,\"cycle_30_percent\":14.02,\"cycle_31_percent\":18.16,\"cycle_31_module\":\"pe_advapi32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\"")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_advapi32_core_round_trip_matrix",
        "\"surface\":\"ADVAPI32_core_18_fn\",\"fn_partial\":18,\"fn_groups\":5,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real RegOpenKeyExW + OpenSCManagerW + OpenProcessToken + CryptAcquireContextW pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"track_q_cumulative_to_track_o\":\"ADVAPI32 + USER32_20 + GDI32_15 + KERNEL32_18 = 71 fn cumulative skeleton-tier (Track Q bundled cycle 29-31 = 53 fn delta)\"")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_advapi32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_padv()
    let s2 = padv_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_advapi32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_advapi32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", registry_op=" + to_string(s[1])
        + ", service_op=" + to_string(s[2]) + ", sec_token_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = padv_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("registry_op_count\t" + to_string(s[1]))
            println("service_op_count\t" + to_string(s[2]))
            println("sec_token_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_advapi32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_advapi32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_padv()
            println("cleaned: " + padv_dir())
            return
        }
        if sub == "dir" {
            println(padv_dir())
            return
        }
    }
    println("usage: hexa run pe_advapi32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
