    record_service_op(1, "open_manager", "0x000B0600", "ServicesActive", "PARTIAL")
    r0_emit("pe_advapi32_core_record", "\"kind\":\"service_op\",\"svc_id\":1,\"op_id\":\"open_manager\",\"sc_handle_hex\":\"0x000B0600\",\"database_w_synth\":\"ServicesActive\",\"access\":\"0x000F003F\",\"status\":\"PARTIAL\"")
