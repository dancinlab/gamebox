// lib/loader/pe_native_pthread_wrapper.hexa — stage4 macOS pthread_create wrapper skeleton
//
// Win32 CreateThread → macOS pthread_create. attr_t 로 stack size + detached
// state 설정. start routine = PE 의 entry function (i386 emulated 코드).
// cycle 61 pe_thread_creation_bridge 는 high-level (CreateThread API) — 본
// module 은 lower-level (pthread_create syscall).
//
// own 1 enforcement: Wine / CrossOver / ReactOS / community pthread wrapper 0 줄.
//   참조 only — Apple 공식 pthread / Microsoft 공식 Thread API spec:
//     - pthread_create:        man 3 pthread_create
//     - pthread_attr_init:     man 3 pthread_attr_init
//     - pthread_attr_setstacksize / setdetachstate
//
// own 2 mandate:
//   - r0_emit ≥ 5
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("pe_native_pthread_wrapper FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase — native pthread_create call recording):
//   stage4 = call record skeleton (실 pthread_create 은 stage5).
//
// attr_kind 정의:
//   1 = joinable
//   2 = detached
//
// schema (calls.tsv): call_id<int> | stack_size<int> | attr_kind<int> | success<int>

use "../perf/r0_common"

// ─── persist 디렉토리 ───
fn pnpw_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_native_pthread_wrapper"
}

fn calls_path() -> str {
    return pnpw_dir() + "/calls.tsv"
}

fn ensure_pnpw_dir() -> void {
    let _ = exec("mkdir -p '" + pnpw_dir() + "'")
}

fn cleanup_pnpw() -> void {
    ensure_pnpw_dir()
    let _ = exec("rm -f '" + calls_path() + "'")
}

// ─── 공통 file IO ───
fn read_pnpw_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn append_pnpw_row(path: str, row: str) -> void {
    ensure_pnpw_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_pthread ───
//   attr_kind: 1=joinable, 2=detached
fn record_pthread(call_id: int, stack_size: int, attr_kind: int, success: int) -> void {
    let row = to_string(call_id) + "\t" + to_string(stack_size)
        + "\t" + to_string(attr_kind) + "\t" + to_string(success) + "\n"
    append_pnpw_row(calls_path(), row)
}

// ─── pthread_count: 전체 row 수 ───
fn pthread_count() -> int {
    let t = read_pnpw_table(calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        if lines[i] != "" {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ─── success_count: success==1 인 row 수 ───
fn success_count() -> int {
    let t = read_pnpw_table(calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let s = to_int(parts[3])
                if s == 1 {
                    c = c + 1
                }
            }
        }
        i = i + 1
    }
    return c
}

// ─── total_stack_bytes: stack_size 합 ───
fn total_stack_bytes() -> int {
    let t = read_pnpw_table(calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_attr: 특정 attr_kind 의 row 수 ───
fn count_by_attr(kind: int) -> int {
    let t = read_pnpw_table(calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let k = to_int(parts[2])
                if k == kind {
                    c = c + 1
                }
            }
        }
        i = i + 1
    }
    return c
}

// ─── call_stack_size: call_id 의 stack_size ───
fn call_stack_size(call_id: int) -> int {
    let t = read_pnpw_table(calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cid = to_int(parts[0])
                if cid == call_id {
                    return to_int(parts[1])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pnpw_stats: [pthread_count, success_count, total_stack_bytes, count_by_attr(1)] ───
fn pnpw_stats() -> array {
    let mut out = []
    out.push(pthread_count())
    out.push(success_count())
    out.push(total_stack_bytes())
    out.push(count_by_attr(1))
    return out
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "pnpw-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pnpw()

    // 1b. cleanup 후 pthread_count == 0
    let c0 = pthread_count()
    if c0 != 0 {
        panic("pe_native_pthread_wrapper FAIL [cleanup pthread_count] expected=0 got=" + to_string(c0))
    }

    // 2. record 4 pthread_create calls
    record_pthread(101001, 1048576, 1, 1)  // 1MB joinable success
    r0_emit("pnpw_record",
        "\"call_id\":101001,\"stack_size\":1048576,\"attr_kind\":1,\"success\":1")

    record_pthread(101002, 524288, 1, 1)   // 512KB joinable success
    r0_emit("pnpw_record",
        "\"call_id\":101002,\"stack_size\":524288,\"attr_kind\":1,\"success\":1")

    record_pthread(101003, 524288, 2, 1)   // 512KB detached success
    r0_emit("pnpw_record",
        "\"call_id\":101003,\"stack_size\":524288,\"attr_kind\":2,\"success\":1")

    record_pthread(101004, 524288, 1, 0)   // 512KB joinable FAIL
    r0_emit("pnpw_record",
        "\"call_id\":101004,\"stack_size\":524288,\"attr_kind\":1,\"success\":0")

    // 3. pthread_count == 4
    let c = pthread_count()
    if c != 4 {
        panic("pe_native_pthread_wrapper FAIL [pthread_count] expected=4 got=" + to_string(c))
    }

    // 4. success_count == 3
    let sc = success_count()
    if sc != 3 {
        panic("pe_native_pthread_wrapper FAIL [success_count] expected=3 got=" + to_string(sc))
    }

    // 5. total_stack_bytes == 2621440
    let tb = total_stack_bytes()
    if tb != 2621440 {
        panic("pe_native_pthread_wrapper FAIL [total_stack_bytes] expected=2621440 got=" + to_string(tb))
    }

    // 6. count_by_attr: 1=3, 2=1, 99=0
    let n1 = count_by_attr(1)
    if n1 != 3 {
        panic("pe_native_pthread_wrapper FAIL [count_by_attr 1] expected=3 got=" + to_string(n1))
    }
    let n2 = count_by_attr(2)
    if n2 != 1 {
        panic("pe_native_pthread_wrapper FAIL [count_by_attr 2] expected=1 got=" + to_string(n2))
    }
    let n99 = count_by_attr(99)
    if n99 != 0 {
        panic("pe_native_pthread_wrapper FAIL [count_by_attr 99] expected=0 got=" + to_string(n99))
    }

    // 7. call_stack_size lookups
    let ss1 = call_stack_size(101001)
    if ss1 != 1048576 {
        panic("pe_native_pthread_wrapper FAIL [call_stack_size 101001] expected=1048576 got=" + to_string(ss1))
    }
    let ss3 = call_stack_size(101003)
    if ss3 != 524288 {
        panic("pe_native_pthread_wrapper FAIL [call_stack_size 101003] expected=524288 got=" + to_string(ss3))
    }
    let ss_miss = call_stack_size(9999)
    if ss_miss != 0 {
        panic("pe_native_pthread_wrapper FAIL [call_stack_size 9999] expected=0 got=" + to_string(ss_miss))
    }

    // 8. pnpw_stats() == [4, 3, 2621440, 3]
    let s = pnpw_stats()
    if len(s) != 4 {
        panic("pe_native_pthread_wrapper FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 4 {
        panic("pe_native_pthread_wrapper FAIL [stats[0]] expected=4 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_native_pthread_wrapper FAIL [stats[1]] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 2621440 {
        panic("pe_native_pthread_wrapper FAIL [stats[2]] expected=2621440 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_native_pthread_wrapper FAIL [stats[3]] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit pnpw_stats (final aggregator)
    r0_emit("pnpw_stats",
        "\"pthread_count\":" + to_string(s[0])
        + ",\"success_count\":" + to_string(s[1])
        + ",\"total_stack_bytes\":" + to_string(s[2])
        + ",\"joinable_count\":" + to_string(s[3]))

    // 10. r0_emit count 검증 (≥ 5; 실제 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("pe_native_pthread_wrapper FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 11. cleanup → 모든 stat 0
    cleanup_pnpw()
    let s2 = pnpw_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_native_pthread_wrapper FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    // 12. PASS
    println("  ✅ pe_native_pthread_wrapper self_test PASS (4 calls, success="
        + to_string(sc) + ", total_stack=" + to_string(tb)
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pnpw_stats()
            println("pthread_count\t" + to_string(s[0]))
            println("success_count\t" + to_string(s[1]))
            println("total_stack_bytes\t" + to_string(s[2]))
            println("joinable_count\t" + to_string(s[3]))
            return
        }
        if sub == "stack" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println(to_string(call_stack_size(cid)))
                return
            }
            println("usage: hexa run pe_native_pthread_wrapper.hexa stack <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println(to_string(count_by_attr(kind)))
                return
            }
            println("usage: hexa run pe_native_pthread_wrapper.hexa count <attr_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pnpw()
            println("cleaned: " + pnpw_dir())
            return
        }
        if sub == "dir" {
            println(pnpw_dir())
            return
        }
    }
    println("usage: hexa run pe_native_pthread_wrapper.hexa { self-test | stats | stack <call_id> | count <attr_kind> | cleanup | dir }")
}
