// lib/loader/pe_handle_translation.hexa — stage3 HANDLE → fd translation skeleton
//
// Win32 HANDLE (32/64bit opaque) ↔ POSIX fd (int). file/event/mutex/thread
// 등 kind 별 translation table. CreateFile → open(2). 본 파일은 mapping
// 추적.
//
// own 1 enforcement: Wine / CrossOver / community PE loader 코드 0 줄.
//   참조 only — Microsoft Win32 API spec (learn.microsoft.com).
// own 2 mandate:
//   - r0_emit ≥ 6 (5 record_translation + 1 stats|self_test summary)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("pe_handle_translation FAIL [<sub>] expected=X got=Y")
//
// table schema (TSV, 4-key):
//   pht_log.tsv     — "handle_id\tkind\tfd\talive\n"
//
// kind 코드:
//   1 = file
//   2 = event
//   3 = mutex
//   4 = thread
//   5 = process
//   6 = registry_key
//
// 동작 흐름 (skeleton):
//   1. record_translation(handle_id, kind, fd, alive) — pht_log.tsv 행 append
//   2. handle_to_fd(handle_id) — log 에서 handle_id 매칭 후 fd 반환 (없으면 0)
//   3. count_by_kind(kind) — kind 별 행 수
//   4. alive_count() — alive=1 행 수
//   5. translation_count() — 전체 행 수
//   6. pht_stats() — [translation_count, alive_count, count_by_kind(1), count_by_kind(4)]

use "../perf/r0_common"

// ─── persist 디렉토리 (4-key 작업 영역) ───
fn pht_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_handle_translation"
}

fn pht_log_path() -> str {
    return pht_dir() + "/pht_log.tsv"
}

fn ensure_pht_dir() -> void {
    let _ = exec("mkdir -p '" + pht_dir() + "'")
}

fn cleanup_pht() -> void {
    ensure_pht_dir()
    let _ = exec("rm -f '" + pht_log_path() + "'")
}

// ─── 공통 file IO ───
fn pht_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pht_append_row(path: str, row: str) -> void {
    ensure_pht_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_translation: pht_log.tsv 행 추가 + r0_emit ───
//   handle_id: Win32 HANDLE numeric id (skeleton 은 int 로 모델링)
//   kind: 1=file, 2=event, 3=mutex, 4=thread, 5=process, 6=registry_key
//   fd: POSIX file descriptor (small int)
//   alive: 1=open, 0=closed (CloseHandle 후)
fn record_translation(handle_id: int, kind: int, fd: int, alive: int) -> void {
    let row = to_string(handle_id) + "\t" + to_string(kind)
        + "\t" + to_string(fd) + "\t" + to_string(alive) + "\n"
    pht_append_row(pht_log_path(), row)
    r0_emit("pht_record",
        "\"handle_id\":" + to_string(handle_id)
        + ",\"kind\":" + to_string(kind)
        + ",\"fd\":" + to_string(fd)
        + ",\"alive\":" + to_string(alive))
}

// ─── translation_count: 전체 행 수 ───
fn translation_count() -> int {
    let mut n = 0
    let t = pht_read_table(pht_log_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let total = len(lines)
    let i = 0
    while i < total {
        if lines[i] != "" {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// ─── alive_count: alive=1 행 수 ───
fn alive_count() -> int {
    let mut n = 0
    let t = pht_read_table(pht_log_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let total = len(lines)
    let i = 0
    while i < total {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    n = n + 1
                }
            }
        }
        i = i + 1
    }
    return n
}

// ─── count_by_kind: kind 별 행 수 ───
fn count_by_kind(kind: int) -> int {
    let mut n = 0
    let t = pht_read_table(pht_log_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let total = len(lines)
    let i = 0
    while i < total {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    n = n + 1
                }
            }
        }
        i = i + 1
    }
    return n
}

// ─── handle_to_fd: handle_id 매칭 후 fd 반환 (없으면 0) ───
fn handle_to_fd(handle_id: int) -> int {
    let t = pht_read_table(pht_log_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let total = len(lines)
    let i = 0
    while i < total {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == handle_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pht_stats: [translation_count, alive_count, count_by_kind(1), count_by_kind(4)] ───
fn pht_stats() -> array {
    let mut out = []
    out.push(translation_count())
    out.push(alive_count())
    out.push(count_by_kind(1))
    out.push(count_by_kind(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pht-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup → log empty
    cleanup_pht()
    let s0 = pht_stats()
    if s0[0] != 0 {
        panic("pe_handle_translation FAIL [stats[0] init] expected=0 got=" + to_string(s0[0]))
    }

    // 2. 5 translations 합성
    //    85001 file   → fd 3, alive
    //    85002 event  → fd 4, alive
    //    85003 mutex  → fd 5, alive
    //    85004 thread → fd 6, alive
    //    85005 file   → fd 7, closed
    record_translation(85001, 1, 3, 1)
    record_translation(85002, 2, 4, 1)
    record_translation(85003, 3, 5, 1)
    record_translation(85004, 4, 6, 1)
    record_translation(85005, 1, 7, 0)

    // 3. translation_count = 5
    let tc = translation_count()
    if tc != 5 {
        panic("pe_handle_translation FAIL [translation_count] expected=5 got=" + to_string(tc))
    }

    // 4. alive_count = 4
    let ac = alive_count()
    if ac != 4 {
        panic("pe_handle_translation FAIL [alive_count] expected=4 got=" + to_string(ac))
    }

    // 5. count_by_kind 검증
    let k1 = count_by_kind(1)
    if k1 != 2 {
        panic("pe_handle_translation FAIL [count_by_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_kind(2)
    if k2 != 1 {
        panic("pe_handle_translation FAIL [count_by_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_kind(3)
    if k3 != 1 {
        panic("pe_handle_translation FAIL [count_by_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_kind(4)
    if k4 != 1 {
        panic("pe_handle_translation FAIL [count_by_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_kind(99)
    if k99 != 0 {
        panic("pe_handle_translation FAIL [count_by_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. handle_to_fd 검증
    let fd1 = handle_to_fd(85001)
    if fd1 != 3 {
        panic("pe_handle_translation FAIL [handle_to_fd(85001)] expected=3 got=" + to_string(fd1))
    }
    let fd4 = handle_to_fd(85004)
    if fd4 != 6 {
        panic("pe_handle_translation FAIL [handle_to_fd(85004)] expected=6 got=" + to_string(fd4))
    }
    let fdx = handle_to_fd(9999)
    if fdx != 0 {
        panic("pe_handle_translation FAIL [handle_to_fd(9999)] expected=0 got=" + to_string(fdx))
    }

    // 7. pht_stats() = [5, 4, 2, 1]
    let s = pht_stats()
    if len(s) != 4 {
        panic("pe_handle_translation FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_handle_translation FAIL [stats[0]] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_handle_translation FAIL [stats[1]] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_handle_translation FAIL [stats[2]] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_handle_translation FAIL [stats[3]] expected=1 got=" + to_string(s[3]))
    }

    // 8. summary emit (≥ 6 total: 5 record + 1 summary)
    r0_emit("pht_summary",
        "\"translation_count\":" + to_string(s[0])
        + ",\"alive_count\":" + to_string(s[1])
        + ",\"file_count\":" + to_string(s[2])
        + ",\"thread_count\":" + to_string(s[3]))

    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_handle_translation FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 9. cleanup → stats reset
    cleanup_pht()
    let s_after = pht_stats()
    let j = 0
    while j < len(s_after) {
        if s_after[j] != 0 {
            panic("pe_handle_translation FAIL [cleanup stats[" + to_string(j)
                + "]] expected=0 got=" + to_string(s_after[j]))
        }
        j = j + 1
    }

    println("  ✅ pe_handle_translation self_test PASS (5 translations, 4 alive, sid="
        + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pht_stats()
            println("translation_count\t" + to_string(s[0]))
            println("alive_count\t" + to_string(s[1]))
            println("file_count\t" + to_string(s[2]))
            println("thread_count\t" + to_string(s[3]))
            return
        }
        if sub == "fd" {
            if len(a) >= 4 {
                let hid = to_int(a[3])
                let fd = handle_to_fd(hid)
                println("handle_id\t" + to_string(hid))
                println("fd\t" + to_string(fd))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                let c = count_by_kind(k)
                println("kind\t" + to_string(k))
                println("count\t" + to_string(c))
                return
            }
        }
        if sub == "cleanup" {
            cleanup_pht()
            println("cleaned: " + pht_dir())
            return
        }
        if sub == "dir" {
            println(pht_dir())
            return
        }
    }
    println("usage: hexa run pe_handle_translation.hexa { self-test | stats | fd <handle_id> | count <kind> | cleanup | dir }")
}
