// lib/loader/pe_charset_convert.hexa — cycle 79 Win32 charset conversion bridge skeleton
//
// Win32 MultiByteToWideChar / WideCharToMultiByte → libiconv bridge telemetry.
// 본 module 은 conversion op tracker — 실 iconv_open() / iconv() 호출 X (stage6+).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// direction code:
//   1 = MultiByteToWideChar   (mbtowc)
//   2 = WideCharToMultiByte   (wctomb)
//
// codepage code:
//   0      = CP_ACP        (system ANSI)
//   1      = CP_OEMCP      (system OEM)
//   65001  = CP_UTF8
//   65000  = CP_UTF7
//   949    = korean (cp949 / EUC-KR superset)
//   932    = jp_shift_jis
//   936    = gbk (simplified chinese)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t direction<int> \t codepage<int> \t input_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcco_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_charset_convert"
}

fn pcco_ops_path() -> str {
    return pcco_dir() + "/ops.tsv"
}

fn pcco_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcco_dir() + "'")
}

fn cleanup_pcco() -> void {
    pcco_ensure_dir()
    let _ = exec("rm -f '" + pcco_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pcco_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcco_append_row(path: str, row: str) -> void {
    pcco_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: charset conversion op 1 건 기록 ───
fn record_op(op_id: int, direction: int, codepage: int, input_bytes: int) -> void {
    if op_id <= 0 {
        panic("pe_charset_convert FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if direction < 1 {
        panic("pe_charset_convert FAIL [record_op] expected=direction>=1 got=" + to_string(direction))
    }
    if direction > 2 {
        panic("pe_charset_convert FAIL [record_op] expected=direction<=2 got=" + to_string(direction))
    }
    if codepage < 0 {
        panic("pe_charset_convert FAIL [record_op] expected=codepage>=0 got=" + to_string(codepage))
    }
    if input_bytes < 0 {
        panic("pe_charset_convert FAIL [record_op] expected=input_bytes>=0 got=" + to_string(input_bytes))
    }
    let row = to_string(op_id) + "\t" + to_string(direction)
        + "\t" + to_string(codepage) + "\t" + to_string(input_bytes) + "\n"
    pcco_append_row(pcco_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pcco_read_table(pcco_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_input_bytes: 모든 op input_bytes 합 ───
fn total_input_bytes() -> int {
    let t = pcco_read_table(pcco_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_direction: 특정 direction 의 op 수 ───
fn count_by_direction(direction: int) -> int {
    let t = pcco_read_table(pcco_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == direction {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_codepage: 특정 codepage 의 op 수 ───
fn count_by_codepage(codepage: int) -> int {
    let t = pcco_read_table(pcco_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == codepage {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_input_bytes: 특정 op_id 의 input_bytes (없으면 0) ───
fn op_input_bytes(op_id: int) -> int {
    let t = pcco_read_table(pcco_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pcco_stats: [op_count, total_input_bytes, count_dir(1), count_cp(65001)] ───
fn pcco_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_input_bytes())
    out.push(count_by_direction(1))
    out.push(count_by_codepage(65001))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pcco-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pcco()

    // 2. record 5 conversion ops (deterministic synthetic)
    //    direction 1=mbtowc, 2=wctomb. codepages cover ≥3: utf8, korean, oemcp, utf7, acp.
    record_op(790001, 1, 65001, 128)
    r0_emit("pe_charset_convert_record",
        "\"op_id\":790001,\"direction\":1,\"codepage\":65001,\"input_bytes\":128,\"target\":\"mbtowc_utf8\"")

    record_op(790002, 1, 949, 64)
    r0_emit("pe_charset_convert_record",
        "\"op_id\":790002,\"direction\":1,\"codepage\":949,\"input_bytes\":64,\"target\":\"mbtowc_korean\"")

    record_op(790003, 2, 65001, 256)
    r0_emit("pe_charset_convert_record",
        "\"op_id\":790003,\"direction\":2,\"codepage\":65001,\"input_bytes\":256,\"target\":\"wctomb_utf8\"")

    record_op(790004, 2, 1, 96)
    r0_emit("pe_charset_convert_record",
        "\"op_id\":790004,\"direction\":2,\"codepage\":1,\"input_bytes\":96,\"target\":\"wctomb_oemcp\"")

    record_op(790005, 1, 65000, 32)
    r0_emit("pe_charset_convert_record",
        "\"op_id\":790005,\"direction\":1,\"codepage\":65000,\"input_bytes\":32,\"target\":\"mbtowc_utf7\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_charset_convert FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_input_bytes = 128+64+256+96+32 = 576
    let tb = total_input_bytes()
    if tb != 576 {
        panic("pe_charset_convert FAIL [total_input_bytes] expected=576 got=" + to_string(tb))
    }

    // 5. count_by_direction sanity
    let d1 = count_by_direction(1)
    if d1 != 3 {
        panic("pe_charset_convert FAIL [count_by_direction(1)] expected=3 got=" + to_string(d1))
    }
    let d2 = count_by_direction(2)
    if d2 != 2 {
        panic("pe_charset_convert FAIL [count_by_direction(2)] expected=2 got=" + to_string(d2))
    }

    // 6. count_by_codepage sanity (≥3 distinct codepages exercised)
    let cp_utf8 = count_by_codepage(65001)
    if cp_utf8 != 2 {
        panic("pe_charset_convert FAIL [count_by_codepage(65001)] expected=2 got=" + to_string(cp_utf8))
    }
    let cp_949 = count_by_codepage(949)
    if cp_949 != 1 {
        panic("pe_charset_convert FAIL [count_by_codepage(949)] expected=1 got=" + to_string(cp_949))
    }
    let cp_oem = count_by_codepage(1)
    if cp_oem != 1 {
        panic("pe_charset_convert FAIL [count_by_codepage(1)] expected=1 got=" + to_string(cp_oem))
    }
    let cp_utf7 = count_by_codepage(65000)
    if cp_utf7 != 1 {
        panic("pe_charset_convert FAIL [count_by_codepage(65000)] expected=1 got=" + to_string(cp_utf7))
    }
    let cp_miss = count_by_codepage(936)
    if cp_miss != 0 {
        panic("pe_charset_convert FAIL [count_by_codepage(936)] expected=0 got=" + to_string(cp_miss))
    }

    // 7. op_input_bytes sanity
    let b3 = op_input_bytes(790003)
    if b3 != 256 {
        panic("pe_charset_convert FAIL [op_input_bytes(790003)] expected=256 got=" + to_string(b3))
    }
    let b1 = op_input_bytes(790001)
    if b1 != 128 {
        panic("pe_charset_convert FAIL [op_input_bytes(790001)] expected=128 got=" + to_string(b1))
    }
    let b_miss = op_input_bytes(99999)
    if b_miss != 0 {
        panic("pe_charset_convert FAIL [op_input_bytes(99999)] expected=0 got=" + to_string(b_miss))
    }

    // 8. pcco_stats() = [5, 576, 3, 2]
    let s = pcco_stats()
    if len(s) != 4 {
        panic("pe_charset_convert FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_charset_convert FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 576 {
        panic("pe_charset_convert FAIL [stats total_input_bytes] expected=576 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_charset_convert FAIL [stats count_dir(1)] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_charset_convert FAIL [stats count_cp(65001)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_charset_convert_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_input_bytes\":" + to_string(s[1])
        + ",\"dir_mbtowc\":" + to_string(s[2])
        + ",\"cp_utf8\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_charset_convert FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pcco()
    let s2 = pcco_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_charset_convert FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_charset_convert self_test PASS (ops=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", dir_mbtowc=" + to_string(s[2])
        + ", cp_utf8=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcco_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_input_bytes\t" + to_string(s[1]))
            println("count_dir_mbtowc\t" + to_string(s[2]))
            println("count_cp_utf8\t" + to_string(s[3]))
            return
        }
        if sub == "bytes" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_input_bytes\t" + to_string(op_input_bytes(oid)))
                return
            }
            println("usage: hexa run pe_charset_convert.hexa bytes <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let kind = a[3]
                let val = to_int(a[4])
                if kind == "direction" {
                    println("count_by_direction\t" + to_string(count_by_direction(val)))
                    return
                }
                if kind == "cp" {
                    println("count_by_codepage\t" + to_string(count_by_codepage(val)))
                    return
                }
                println("usage: hexa run pe_charset_convert.hexa count { direction <d> | cp <codepage> }")
                return
            }
            println("usage: hexa run pe_charset_convert.hexa count { direction <d> | cp <codepage> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pcco()
            println("cleaned: " + pcco_dir())
            return
        }
        if sub == "dir" {
            println(pcco_dir())
            return
        }
    }
    println("usage: hexa run pe_charset_convert.hexa { self-test | stats | bytes <op_id> | count direction <direction> | count cp <codepage> | cleanup | dir }")
}
