// lib/loader/pe_gdi_brush_object.hexa — cycle 78 GDI brush bridge skeleton
//
// Win32 GDI brush object (CreateSolidBrush / CreatePatternBrush /
// CreateHatchBrush / GetStockObject(NULL_BRUSH)) → CoreGraphics CGColor /
// CGPattern bridge telemetry. PE loader 가 GDI32 import thunk 를 만나면
// brush 1 개당 row 1 건 기록.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 brush op tracker — 실 GDI / CG 호출 X (stage6 native bridge).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// brush_kind code:
//   1 = solid   (CreateSolidBrush)
//   2 = pattern (CreatePatternBrush)
//   3 = hatch   (CreateHatchBrush)
//   4 = null    (GetStockObject(NULL_BRUSH))
//
// persist schema (TSV — brushes.tsv):
//   brush_id<int> \t brush_kind<int> \t color_rgba<str> \t ref_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pgbo_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_gdi_brush_object"
}

fn pgbo_brushes_path() -> str {
    return pgbo_dir() + "/brushes.tsv"
}

fn pgbo_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pgbo_dir() + "'")
}

fn cleanup_pgbo() -> void {
    pgbo_ensure_dir()
    let _ = exec("rm -f '" + pgbo_brushes_path() + "'")
}

// ─── 공통 file IO ───
fn pgbo_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pgbo_append_row(path: str, row: str) -> void {
    pgbo_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_brush: brush 1 건 기록 ───
fn record_brush(brush_id: int, brush_kind: int, color_rgba: str, ref_count: int) -> void {
    if brush_id <= 0 {
        panic("pe_gdi_brush_object FAIL [record_brush] expected=brush_id>0 got=" + to_string(brush_id))
    }
    if brush_kind < 1 {
        panic("pe_gdi_brush_object FAIL [record_brush] expected=brush_kind>=1 got=" + to_string(brush_kind))
    }
    if brush_kind > 4 {
        panic("pe_gdi_brush_object FAIL [record_brush] expected=brush_kind<=4 got=" + to_string(brush_kind))
    }
    if color_rgba == "" {
        panic("pe_gdi_brush_object FAIL [record_brush] expected=color_rgba!=empty got=empty")
    }
    if ref_count < 0 {
        panic("pe_gdi_brush_object FAIL [record_brush] expected=ref_count>=0 got=" + to_string(ref_count))
    }
    let row = to_string(brush_id) + "\t" + to_string(brush_kind)
        + "\t" + color_rgba + "\t" + to_string(ref_count) + "\n"
    pgbo_append_row(pgbo_brushes_path(), row)
}

// ─── brush_count: total brush 수 ───
fn brush_count() -> int {
    let t = pgbo_read_table(pgbo_brushes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_ref_count: 모든 brush ref_count 합 ───
fn total_ref_count() -> int {
    let t = pgbo_read_table(pgbo_brushes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_brush_kind: 특정 brush_kind 의 brush 수 ───
fn count_by_brush_kind(kind: int) -> int {
    let t = pgbo_read_table(pgbo_brushes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_colors: 고유 color_rgba 수 ───
fn distinct_colors() -> int {
    let t = pgbo_read_table(pgbo_brushes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut seen = []
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let c = parts[2]
                let m = len(seen)
                let j = 0
                let mut dup = 0
                while j < m {
                    if seen[j] == c {
                        dup = 1
                    }
                    j = j + 1
                }
                if dup == 0 {
                    seen.push(c)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── brush_color_rgba: 특정 brush_id 의 color_rgba (없으면 "") ───
fn brush_color_rgba(brush_id: int) -> str {
    let t = pgbo_read_table(pgbo_brushes_path())
    if t == "" {
        return ""
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == brush_id {
                    return parts[2]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── pgbo_stats: [brush_count, total_ref_count, distinct_colors, count_by_brush_kind(1)] ───
fn pgbo_stats() -> array {
    let mut out = []
    out.push(brush_count())
    out.push(total_ref_count())
    out.push(distinct_colors())
    out.push(count_by_brush_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pgbo-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pgbo()

    // 2. record 5 brushes across ≥3 brush_kinds (1=solid, 2=pattern, 3=hatch, 4=null)
    record_brush(780001, 1, "FF0000FF", 3)
    r0_emit("pe_gdi_brush_object_record",
        "\"brush_id\":780001,\"brush_kind\":1,\"color_rgba\":\"FF0000FF\",\"ref_count\":3,\"target\":\"solid\"")

    record_brush(780002, 1, "00FF00FF", 2)
    r0_emit("pe_gdi_brush_object_record",
        "\"brush_id\":780002,\"brush_kind\":1,\"color_rgba\":\"00FF00FF\",\"ref_count\":2,\"target\":\"solid\"")

    record_brush(780003, 2, "0000FFFF", 1)
    r0_emit("pe_gdi_brush_object_record",
        "\"brush_id\":780003,\"brush_kind\":2,\"color_rgba\":\"0000FFFF\",\"ref_count\":1,\"target\":\"pattern\"")

    record_brush(780004, 3, "FFFF00FF", 4)
    r0_emit("pe_gdi_brush_object_record",
        "\"brush_id\":780004,\"brush_kind\":3,\"color_rgba\":\"FFFF00FF\",\"ref_count\":4,\"target\":\"hatch\"")

    record_brush(780005, 4, "00000000", 0)
    r0_emit("pe_gdi_brush_object_record",
        "\"brush_id\":780005,\"brush_kind\":4,\"color_rgba\":\"00000000\",\"ref_count\":0,\"target\":\"null\"")

    // 3. brush_count = 5
    let c = brush_count()
    if c != 5 {
        panic("pe_gdi_brush_object FAIL [brush_count] expected=5 got=" + to_string(c))
    }

    // 4. total_ref_count = 10
    let tr = total_ref_count()
    if tr != 10 {
        panic("pe_gdi_brush_object FAIL [total_ref_count] expected=10 got=" + to_string(tr))
    }

    // 5. count_by_brush_kind sanity
    let k1 = count_by_brush_kind(1)
    if k1 != 2 {
        panic("pe_gdi_brush_object FAIL [count_by_brush_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_brush_kind(2)
    if k2 != 1 {
        panic("pe_gdi_brush_object FAIL [count_by_brush_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_brush_kind(3)
    if k3 != 1 {
        panic("pe_gdi_brush_object FAIL [count_by_brush_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_brush_kind(4)
    if k4 != 1 {
        panic("pe_gdi_brush_object FAIL [count_by_brush_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_brush_kind(99)
    if k99 != 0 {
        panic("pe_gdi_brush_object FAIL [count_by_brush_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. distinct_colors = 5 (all 5 colors unique)
    let dc = distinct_colors()
    if dc != 5 {
        panic("pe_gdi_brush_object FAIL [distinct_colors] expected=5 got=" + to_string(dc))
    }

    // 7. brush_color_rgba sanity
    let c3 = brush_color_rgba(780003)
    if c3 != "0000FFFF" {
        panic("pe_gdi_brush_object FAIL [brush_color_rgba(780003)] expected=0000FFFF got=" + c3)
    }
    let c4 = brush_color_rgba(780004)
    if c4 != "FFFF00FF" {
        panic("pe_gdi_brush_object FAIL [brush_color_rgba(780004)] expected=FFFF00FF got=" + c4)
    }
    let c_miss = brush_color_rgba(9999)
    if c_miss != "" {
        panic("pe_gdi_brush_object FAIL [brush_color_rgba(9999)] expected=empty got=" + c_miss)
    }

    // 8. pgbo_stats() = [5, 10, 5, 2]
    let s = pgbo_stats()
    if len(s) != 4 {
        panic("pe_gdi_brush_object FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_gdi_brush_object FAIL [stats brush_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 10 {
        panic("pe_gdi_brush_object FAIL [stats total_ref_count] expected=10 got=" + to_string(s[1]))
    }
    if s[2] != 5 {
        panic("pe_gdi_brush_object FAIL [stats distinct_colors] expected=5 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_gdi_brush_object FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_gdi_brush_object_stats",
        "\"brush_count\":" + to_string(s[0])
        + ",\"total_ref_count\":" + to_string(s[1])
        + ",\"distinct_colors\":" + to_string(s[2])
        + ",\"kind_solid\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_gdi_brush_object FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pgbo()
    let s2 = pgbo_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_gdi_brush_object FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_gdi_brush_object self_test PASS (brushes=" + to_string(s[0])
        + ", refs=" + to_string(s[1]) + ", colors=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pgbo_stats()
            println("brush_count\t" + to_string(s[0]))
            println("total_ref_count\t" + to_string(s[1]))
            println("distinct_colors\t" + to_string(s[2]))
            println("count_kind_solid\t" + to_string(s[3]))
            return
        }
        if sub == "color" {
            if len(a) >= 4 {
                let bid = to_int(a[3])
                println("brush_color_rgba\t" + brush_color_rgba(bid))
                return
            }
            println("usage: hexa run pe_gdi_brush_object.hexa color <brush_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_brush_kind\t" + to_string(count_by_brush_kind(kind)))
                return
            }
            println("usage: hexa run pe_gdi_brush_object.hexa count <brush_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pgbo()
            println("cleaned: " + pgbo_dir())
            return
        }
        if sub == "dir" {
            println(pgbo_dir())
            return
        }
    }
    println("usage: hexa run pe_gdi_brush_object.hexa { self-test | stats | color <brush_id> | count <brush_kind> | cleanup | dir }")
}
