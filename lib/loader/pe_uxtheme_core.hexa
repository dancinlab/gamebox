// lib/loader/pe_uxtheme_core.hexa — UXTHEME.dll visual styles surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine uxtheme source 인용 0.
//       uxtheme.dll 직접 binding 0. macOS NSAppearance / NSVisualEffectView /
//       CGColorSpace / NSImage rep / CTFontRef / CFAttributedString 직접 binding 0.
//       NOTE: UXTHEME 측 D2R/D4 launcher visual styles + Battle.net Agent themed
//       window dialog baseline; OpenThemeData/DrawThemeBackground/GetThemeColor 측
//       HTHEME round-trip baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BH1 — UXTHEME visual styles theme_handle/drawing/properties surface 10 fn skeleton-tier.
// cycle 51 304/435 (~69.89%) → cycle 52 ~314/435 (~72.18%) (+10 fn, BH bundled part 1/4).
// **70% threshold breach milestone** at cycle 52 via BH1 UXTHEME.
//
// 대상 fn (10 fn — 3 group, fn_kind 0..9):
//   THEME_HANDLE  (4): OpenThemeData(0) / CloseThemeData(1) / IsThemeActive(2) / IsAppThemed(3)
//   DRAWING       (4): DrawThemeBackground(4) / DrawThemeText(5) / DrawThemeIcon(6) /
//                      GetThemePartSize(7)
//   PROPERTIES    (3): GetThemeColor(8) / GetThemeFont(9) — wait, 3 fn = 8/9/X
//   (revised 3 props): GetThemeColor / GetThemeFont / GetThemeMetric
//   So ranges: 0..3 theme_handle, 4..7 drawing, 8..10? No, total 10 fn = 4+4+2.
//   Map: 0..3 theme_handle (4), 4..7 drawing (4), 8..9 properties (2 of GetThemeColor/Font).
//   But mission spec says properties (3): Color/Font/Metric.
//   So: 0..3 theme_handle (4), 4..6 drawing (3 — drop one), 7..9 properties (3).
//   Adjusted: drawing = DrawThemeBackground/DrawThemeText/GetThemePartSize (3), properties = Color/Font/Metric (3).
//   Per mission text: drawing 4 + properties 3 → impossible 4+4+3 = 11.
//   So we use 3 group totals: theme_handle 4 + drawing 3 + properties 3 = 10 fn.
//   Re-mapping: theme_handle (4) + drawing (3): DrawThemeBackground/DrawThemeText/DrawThemeIcon
//               + properties (3): GetThemeColor/GetThemeFont/GetThemeMetric
//
// synthetic struct families:
//   HTHEME 0xA0010100 opaque handle (synthetic).
//   THEME_PART_BUTTON_PRESSED iPartId 1 iStateId 1 + THEME_PART_TAB iPartId 9 iStateId 2.
//   RECT 16B left 0 top 0 right 200 bottom 32 button rect.
//   COLORREF 4B 0x00f0f0f0 windowtext + 0x00006400 hyperlink.
//   LOGFONTW 92B lfHeight -12 lfWeight 400 lfFaceName "Segoe UI" WCHAR LE.
//   SIZE 8B cx 16 cy 16 icon size + cx 200 cy 32 button size.
//
// persist schema (TSV — 4 table):
//   syscall_invoke / theme_handle_event / drawing_event / property_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn put_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_uxtheme_core"
}

fn put_syscall_invoke_path() -> str {
    return put_dir() + "/syscall_invoke.tsv"
}

fn put_theme_handle_event_path() -> str {
    return put_dir() + "/theme_handle_event.tsv"
}

fn put_drawing_event_path() -> str {
    return put_dir() + "/drawing_event.tsv"
}

fn put_property_event_path() -> str {
    return put_dir() + "/property_event.tsv"
}

fn put_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + put_dir() + "'")
}

fn cleanup_put() -> void {
    put_ensure_dir()
    let _ = exec("rm -f '" + put_syscall_invoke_path() + "' '" + put_theme_handle_event_path()
        + "' '" + put_drawing_event_path() + "' '" + put_property_event_path() + "'")
}

// ─── 공통 file IO ───
fn put_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn put_append_row(path: str, row: str) -> void {
    put_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn put_count_rows(path: str, min_cols: int) -> int {
    let t = put_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "OpenThemeData" }
    if k == 1 { return "CloseThemeData" }
    if k == 2 { return "IsThemeActive" }
    if k == 3 { return "IsAppThemed" }
    if k == 4 { return "DrawThemeBackground" }
    if k == 5 { return "DrawThemeText" }
    if k == 6 { return "DrawThemeIcon" }
    if k == 7 { return "GetThemeColor" }
    if k == 8 { return "GetThemeFont" }
    if k == 9 { return "GetThemeMetric" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "theme_handle"
        }
    }
    if k >= 4 {
        if k <= 6 {
            return "drawing"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "properties"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: UXTHEME fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_uxtheme_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_uxtheme_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_uxtheme_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_uxtheme_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_uxtheme_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    put_append_row(put_syscall_invoke_path(), row)
}

// ─── record_theme_handle_event: OpenThemeData/CloseThemeData/IsThemeActive/IsAppThemed row ───
fn record_theme_handle_event(evt_id: int, t_kind: str, htheme_hex: str, class_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_uxtheme_core FAIL [record_theme_handle_event] evt_id<=0") }
    if t_kind == "" { panic("pe_uxtheme_core FAIL [record_theme_handle_event] t_kind=empty") }
    if htheme_hex == "" { panic("pe_uxtheme_core FAIL [record_theme_handle_event] htheme_hex=empty") }
    if class_synth == "" { panic("pe_uxtheme_core FAIL [record_theme_handle_event] class_synth=empty") }
    if status == "" { panic("pe_uxtheme_core FAIL [record_theme_handle_event] status=empty") }
    let row = to_string(evt_id) + "\t" + t_kind + "\t" + htheme_hex + "\t" + class_synth + "\t" + status + "\n"
    put_append_row(put_theme_handle_event_path(), row)
}

// ─── record_drawing_event: DrawThemeBackground/DrawThemeText/DrawThemeIcon row ───
fn record_drawing_event(evt_id: int, d_kind: str, part_state: str, rect_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_uxtheme_core FAIL [record_drawing_event] evt_id<=0") }
    if d_kind == "" { panic("pe_uxtheme_core FAIL [record_drawing_event] d_kind=empty") }
    if part_state == "" { panic("pe_uxtheme_core FAIL [record_drawing_event] part_state=empty") }
    if rect_synth == "" { panic("pe_uxtheme_core FAIL [record_drawing_event] rect_synth=empty") }
    if status == "" { panic("pe_uxtheme_core FAIL [record_drawing_event] status=empty") }
    let row = to_string(evt_id) + "\t" + d_kind + "\t" + part_state + "\t" + rect_synth + "\t" + status + "\n"
    put_append_row(put_drawing_event_path(), row)
}

// ─── record_property_event: GetThemeColor/GetThemeFont/GetThemeMetric row ───
fn record_property_event(evt_id: int, p_kind: str, prop_id: str, value_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_uxtheme_core FAIL [record_property_event] evt_id<=0") }
    if p_kind == "" { panic("pe_uxtheme_core FAIL [record_property_event] p_kind=empty") }
    if prop_id == "" { panic("pe_uxtheme_core FAIL [record_property_event] prop_id=empty") }
    if value_synth == "" { panic("pe_uxtheme_core FAIL [record_property_event] value_synth=empty") }
    if status == "" { panic("pe_uxtheme_core FAIL [record_property_event] status=empty") }
    let row = to_string(evt_id) + "\t" + p_kind + "\t" + prop_id + "\t" + value_synth + "\t" + status + "\n"
    put_append_row(put_property_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return put_count_rows(put_syscall_invoke_path(), 4)
}

fn theme_handle_event_count() -> int {
    return put_count_rows(put_theme_handle_event_path(), 5)
}

fn drawing_event_count() -> int {
    return put_count_rows(put_drawing_event_path(), 5)
}

fn property_event_count() -> int {
    return put_count_rows(put_property_event_path(), 5)
}

fn put_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(theme_handle_event_count())
    out.push(drawing_event_count())
    out.push(property_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "put-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_put()

    // ─── 1. syscall_invoke × 10 (one per fn, 3 group coverage) ───
    //   THEME_HANDLE group (4)
    record_syscall_invoke(1, 0, "OpenThemeData", "PARTIAL")
    println("__UXTHEME__ PARTIAL OpenThemeData")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"OpenThemeData\",\"fn_group\":\"theme_handle\",\"status\":\"PARTIAL\",\"hwnd\":\"0xA0020100_HWND_battlenet_launcher\",\"pszClassList\":\"BUTTON_WCHAR_LE_synth\",\"out_HTHEME\":\"0xA0010100\",\"return_handle\":\"0xA0010100\"")
    record_syscall_invoke(2, 1, "CloseThemeData", "PARTIAL")
    println("__UXTHEME__ PARTIAL CloseThemeData")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"CloseThemeData\",\"fn_group\":\"theme_handle\",\"status\":\"PARTIAL\",\"hTheme\":\"0xA0010100\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(3, 2, "IsThemeActive", "PARTIAL")
    println("__UXTHEME__ PARTIAL IsThemeActive")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"IsThemeActive\",\"fn_group\":\"theme_handle\",\"status\":\"PARTIAL\",\"return_bool\":\"TRUE_1\",\"theme_active_synth\":\"Aero_Win10_default\"")
    record_syscall_invoke(4, 3, "IsAppThemed", "PARTIAL")
    println("__UXTHEME__ PARTIAL IsAppThemed")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"IsAppThemed\",\"fn_group\":\"theme_handle\",\"status\":\"PARTIAL\",\"return_bool\":\"TRUE_1\",\"app_themed_synth\":\"d2r_launcher_themed\"")

    //   DRAWING group (3)
    record_syscall_invoke(5, 4, "DrawThemeBackground", "PARTIAL")
    println("__UXTHEME__ PARTIAL DrawThemeBackground")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"DrawThemeBackground\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"hTheme\":\"0xA0010100\",\"hdc\":\"0xA0030100_HDC\",\"iPartId\":1,\"iStateId\":1,\"pRect\":\"RECT_16B_0_0_200_32\",\"pClipRect\":0,\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(6, 5, "DrawThemeText", "PARTIAL")
    println("__UXTHEME__ PARTIAL DrawThemeText")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"DrawThemeText\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"hTheme\":\"0xA0010100\",\"hdc\":\"0xA0030100_HDC\",\"iPartId\":1,\"iStateId\":1,\"pszText\":\"PLAY_WCHAR_LE_4\",\"cchText\":4,\"dwTextFlags\":\"DT_CENTER_0x1\",\"pRect\":\"RECT_16B_0_0_200_32\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(7, 6, "DrawThemeIcon", "PARTIAL")
    println("__UXTHEME__ PARTIAL DrawThemeIcon")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"DrawThemeIcon\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"hTheme\":\"0xA0010100\",\"hdc\":\"0xA0030100_HDC\",\"iPartId\":15,\"iStateId\":1,\"pRect\":\"RECT_16B_0_0_16_16\",\"himl\":\"0xA0040100_HIMAGELIST\",\"iImageIndex\":0,\"return_hresult\":\"S_OK_0\"")

    //   PROPERTIES group (3)
    record_syscall_invoke(8, 7, "GetThemeColor", "PARTIAL")
    println("__UXTHEME__ PARTIAL GetThemeColor")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"GetThemeColor\",\"fn_group\":\"properties\",\"status\":\"PARTIAL\",\"hTheme\":\"0xA0010100\",\"iPartId\":1,\"iStateId\":1,\"iPropId\":\"TMT_TEXTCOLOR_3803\",\"out_pColor\":\"COLORREF_4B_0x00f0f0f0_windowtext\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(9, 8, "GetThemeFont", "PARTIAL")
    println("__UXTHEME__ PARTIAL GetThemeFont")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"GetThemeFont\",\"fn_group\":\"properties\",\"status\":\"PARTIAL\",\"hTheme\":\"0xA0010100\",\"hdc\":\"0xA0030100_HDC\",\"iPartId\":1,\"iStateId\":1,\"iPropId\":\"TMT_FONT_210\",\"out_pFont\":\"LOGFONTW_92B_Segoe_UI_lfHeight_-12_lfWeight_400\",\"struct_bytes\":92,\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(10, 9, "GetThemeMetric", "PARTIAL")
    println("__UXTHEME__ PARTIAL GetThemeMetric")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"GetThemeMetric\",\"fn_group\":\"properties\",\"status\":\"PARTIAL\",\"hTheme\":\"0xA0010100\",\"hdc\":\"0xA0030100_HDC\",\"iPartId\":1,\"iStateId\":1,\"iPropId\":\"TMT_BORDERSIZE_2403\",\"out_piVal\":1,\"return_hresult\":\"S_OK_0\"")

    // ─── 2. theme_handle_event × 4 (open/close/active/themed) ───
    record_theme_handle_event(1, "open_button_battlenet_launcher", "0xA0010100", "BUTTON_WCHAR_LE_synth", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"theme_handle_event\",\"evt_id\":1,\"t_kind\":\"open_button_battlenet_launcher\",\"htheme_hex\":\"0xA0010100\",\"class_synth\":\"BUTTON_WCHAR_LE\",\"d2r_d4_launcher_baseline\":true,\"status\":\"PARTIAL\"")
    record_theme_handle_event(2, "close_button_handle", "0xA0010100", "release_handle", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"theme_handle_event\",\"evt_id\":2,\"t_kind\":\"close_button_handle\",\"htheme_hex\":\"0xA0010100\",\"class_synth\":\"release_handle\",\"return_hresult\":\"S_OK_0\",\"status\":\"PARTIAL\"")
    record_theme_handle_event(3, "active_query_aero", "0xA0010000", "Aero_Win10_default_active", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"theme_handle_event\",\"evt_id\":3,\"t_kind\":\"active_query_aero\",\"htheme_hex\":\"0xA0010000\",\"class_synth\":\"Aero_Win10_default_active\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_theme_handle_event(4, "app_themed_d2r_launcher", "0xA0010000", "d2r_launcher_themed", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"theme_handle_event\",\"evt_id\":4,\"t_kind\":\"app_themed_d2r_launcher\",\"htheme_hex\":\"0xA0010000\",\"class_synth\":\"d2r_launcher_themed\",\"battle_net_themed\":true,\"status\":\"PARTIAL\"")

    // ─── 3. drawing_event × 3 (background/text/icon) ───
    record_drawing_event(1, "draw_button_pressed_play", "BP_PUSHBUTTON_1_PBS_PRESSED_3", "RECT_16B_0_0_200_32", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"drawing_event\",\"evt_id\":1,\"d_kind\":\"draw_button_pressed_play\",\"part_state\":\"BP_PUSHBUTTON_1_PBS_PRESSED_3\",\"rect_synth\":\"RECT_16B_0_0_200_32\",\"struct_bytes\":16,\"hdc\":\"0xA0030100_HDC\",\"status\":\"PARTIAL\"")
    record_drawing_event(2, "draw_text_play_label", "BP_PUSHBUTTON_1_PBS_NORMAL_1", "RECT_16B_0_0_200_32", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"drawing_event\",\"evt_id\":2,\"d_kind\":\"draw_text_play_label\",\"part_state\":\"BP_PUSHBUTTON_1_PBS_NORMAL_1\",\"rect_synth\":\"RECT_16B_0_0_200_32\",\"text_wchar\":\"PLAY\",\"cchText\":4,\"dwTextFlags\":\"DT_CENTER_0x1\",\"status\":\"PARTIAL\"")
    record_drawing_event(3, "draw_icon_settings_gear", "TAB_TABITEM_1_TIS_NORMAL_1", "RECT_16B_0_0_16_16", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"drawing_event\",\"evt_id\":3,\"d_kind\":\"draw_icon_settings_gear\",\"part_state\":\"TAB_TABITEM_1_TIS_NORMAL_1\",\"rect_synth\":\"RECT_16B_0_0_16_16\",\"himl\":\"0xA0040100_HIMAGELIST\",\"iImageIndex\":0,\"status\":\"PARTIAL\"")

    // ─── 4. property_event × 3 (color/font/metric) ───
    record_property_event(1, "color_textcolor_default", "TMT_TEXTCOLOR_3803", "COLORREF_4B_0x00f0f0f0_windowtext", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"property_event\",\"evt_id\":1,\"p_kind\":\"color_textcolor_default\",\"prop_id\":\"TMT_TEXTCOLOR_3803\",\"value_synth\":\"COLORREF_4B_0x00f0f0f0_windowtext\",\"struct_bytes\":4,\"d2r_launcher_palette_baseline\":true,\"status\":\"PARTIAL\"")
    record_property_event(2, "font_segoe_ui_button", "TMT_FONT_210", "LOGFONTW_92B_Segoe_UI_lfHeight_-12_lfWeight_400", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"property_event\",\"evt_id\":2,\"p_kind\":\"font_segoe_ui_button\",\"prop_id\":\"TMT_FONT_210\",\"value_synth\":\"LOGFONTW_92B_Segoe_UI_lfHeight_-12_lfWeight_400\",\"struct_bytes\":92,\"battle_net_font_baseline\":true,\"status\":\"PARTIAL\"")
    record_property_event(3, "metric_bordersize_1px", "TMT_BORDERSIZE_2403", "INT_4B_value_1px", "PARTIAL")
    r0_emit("pe_uxtheme_core_record", "\"kind\":\"property_event\",\"evt_id\":3,\"p_kind\":\"metric_bordersize_1px\",\"prop_id\":\"TMT_BORDERSIZE_2403\",\"value_synth\":\"INT_4B_value_1px\",\"struct_bytes\":4,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_uxtheme_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let th = theme_handle_event_count()
    if th != 4 {
        panic("pe_uxtheme_core FAIL [theme_handle_event_count] expected=4 got=" + to_string(th))
    }
    let de = drawing_event_count()
    if de != 3 {
        panic("pe_uxtheme_core FAIL [drawing_event_count] expected=3 got=" + to_string(de))
    }
    let pe = property_event_count()
    if pe != 3 {
        panic("pe_uxtheme_core FAIL [property_event_count] expected=3 got=" + to_string(pe))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "OpenThemeData" { panic("pe_uxtheme_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "IsThemeActive" { panic("pe_uxtheme_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(4) != "DrawThemeBackground" { panic("pe_uxtheme_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(7) != "GetThemeColor" { panic("pe_uxtheme_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(9) != "GetThemeMetric" { panic("pe_uxtheme_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_uxtheme_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "theme_handle" { panic("pe_uxtheme_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "drawing" { panic("pe_uxtheme_core FAIL [fn_group_name(4)]") }
    if fn_group_name(7) != "properties" { panic("pe_uxtheme_core FAIL [fn_group_name(7)]") }
    if fn_group_name(99) != "unknown" { panic("pe_uxtheme_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = put_stats()
    if len(s) != 4 { panic("pe_uxtheme_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_uxtheme_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_uxtheme_core FAIL [stats theme_handle_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_uxtheme_core FAIL [stats drawing_event_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_uxtheme_core FAIL [stats property_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_uxtheme_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"theme_handle_event_count\":" + to_string(s[1])
        + ",\"drawing_event_count\":" + to_string(s[2])
        + ",\"property_event_count\":" + to_string(s[3]))

    r0_emit("pe_uxtheme_core_summary",
        "\"target\":\"UXTHEME.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"theme_handle\",\"drawing\",\"properties\"],\"htheme_synth\":\"0xA0010100\",\"rect_synth_bytes\":16,\"colorref_synth_bytes\":4,\"logfontw_synth_bytes\":92,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_uxtheme_core_kpi",
        "\"theme_handle_emits\":4,\"drawing_emits\":3,\"property_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_d4_launcher_visual_styles_baseline\":true,\"battlenet_agent_themed_dialog_baseline\":true,\"nsappearance_nsvisualeffectview_binding\":false,\"ctfontref_cfattributedstring_binding\":false")

    // ─── cycle 51 → 52 UXTHEME coverage progression evidence emit ───
    r0_emit("pe_uxtheme_core_coverage_progression",
        "\"surface\":\"UXTHEME_full_435_fn\",\"cycle_51_count\":304,\"cycle_52_count\":314,\"delta\":10,\"cycle_51_percent\":69.89,\"cycle_52_percent\":72.18,\"cycle_52_module\":\"pe_uxtheme_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_bh1_cycle_increment\":10,\"track_bh_bundled_part_1_of_4\":true,\"threshold_70pct_breach_module\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_uxtheme_core_round_trip_matrix",
        "\"surface\":\"UXTHEME_core_10_fn\",\"fn_partial\":10,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.2\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real OpenThemeData + DrawThemeBackground + GetThemeColor = NSAppearance + NSVisualEffectView + CGColorSpace + CTFontRef + CFAttributedString bridge pending separate cycle (long-horizon visual styles pipeline)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    // ─── Track BH1 expansion emit (cycle 52, UXTHEME +10 fn) ───
    r0_emit("pe_uxtheme_core_bh1_expansion",
        "\"track\":\"BH1\",\"cycle\":52,\"surface\":\"UXTHEME_new\",\"new_fn\":10,\"groups\":[\"theme_handle\",\"drawing\",\"properties\"],\"theme_handle_count\":4,\"drawing_count\":3,\"properties_count\":3,\"emit_format\":\"__UXTHEME__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_2_evidence_augment\":true,\"track_bh_bundled_part_1_of_4\":true,\"threshold_70pct_breach\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_uxtheme_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_put()
    let s2 = put_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_uxtheme_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_uxtheme_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", theme_handle_event=" + to_string(s[1])
        + ", drawing_event=" + to_string(s[2]) + ", property_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = put_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("theme_handle_event_count\t" + to_string(s[1]))
            println("drawing_event_count\t" + to_string(s[2]))
            println("property_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_uxtheme_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_uxtheme_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_put()
            println("cleaned: " + put_dir())
            return
        }
        if sub == "dir" {
            println(put_dir())
            return
        }
    }
    println("usage: hexa run pe_uxtheme_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
