// lib/loader/pe_comctl32_core.hexa — COMCTL32.dll Common Controls surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine comctl32 source 측 코드 인용 0. comctl32.dll 직접 binding 0. macOS NSImage /
//       NSTableView / NSOutlineView 직접 binding 0. commctrl.h reference shape 만
//       (HIMAGELIST / LVITEM / TVITEM / INITCOMMONCONTROLSEX). 실 InitCommonControls /
//       실 ImageList_Create / 실 ListView_InsertItem / 실 TreeView_InsertItem = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AH3 — COMCTL32 (comctl32.dll) Common Controls surface coverage 10 fn (skeleton row 만).
// Track AH2 predecessor (SHELL32 12 fn cycle 37) 후 본 Track AH3 는 COMCTL32 측 init +
// imagelist + listview + treeview baseline land. cycle 37 측 156/435 (~35.86%) → cycle 38
// 측 ~166/435 (~38.16%) coverage progression (+10 fn 신규, Track AH bundled cycle 36-39
// 측 AH3 row, 세 번째 row).
//
// 대상 fn (10 fn — 4 group, fn_kind 0..9 canonical map):
//   INIT      (2): InitCommonControls(0) / InitCommonControlsEx(1)
//   IMAGELIST (3): ImageList_Create(2) / ImageList_Add(3) / ImageList_Destroy(4)
//   LISTVIEW  (3): ListView_InsertItem(5) / ListView_SetItemText(6) /
//                  ListView_GetItemCount(7)
//   TREEVIEW  (2): TreeView_InsertItem(8) / TreeView_DeleteItem(9)
//
// synthetic INITCOMMONCONTROLSEX (8 byte = DWORD dwSize 4 + DWORD dwICC 4):
//   dwSize 0x00000008, dwICC 0x000000FF (ICC_LISTVIEW_CLASSES|ICC_TREEVIEW_CLASSES|...).
// synthetic HIMAGELIST 0x92010000, ImageList_Create return synth: 32x32 RGBA.
// synthetic LVITEM (60 byte = mask 4 + iItem 4 + iSubItem 4 + state 4 + stateMask 4 + pszText 8 +
//   cchTextMax 4 + iImage 4 + lParam 8 + iIndent 4 + ...) at 0x92020000:
//   mask 0x0000000D (LVIF_TEXT|LVIF_IMAGE|LVIF_PARAM), iItem 5, pszText "Item 5".
// synthetic TVITEM (40 byte) at 0x92030000: mask TVIF_TEXT, hItem 0x92030400, pszText "Tree Node".
// HIMAGELIST/HTREEITEM family: 0x92010000 (imagelist), 0x92030400 (htreeitem).
//
// persist schema (TSV — 4 table): syscall_invoke / imagelist_event / listview_event / treeview_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_comctl32_core"
}

fn pcc_syscall_invoke_path() -> str {
    return pcc_dir() + "/syscall_invoke.tsv"
}

fn pcc_imagelist_event_path() -> str {
    return pcc_dir() + "/imagelist_event.tsv"
}

fn pcc_listview_event_path() -> str {
    return pcc_dir() + "/listview_event.tsv"
}

fn pcc_treeview_event_path() -> str {
    return pcc_dir() + "/treeview_event.tsv"
}

fn pcc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcc_dir() + "'")
}

fn cleanup_pcc() -> void {
    pcc_ensure_dir()
    let _ = exec("rm -f '" + pcc_syscall_invoke_path() + "' '" + pcc_imagelist_event_path()
        + "' '" + pcc_listview_event_path() + "' '" + pcc_treeview_event_path() + "'")
}

// ─── 공통 file IO ───
fn pcc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcc_append_row(path: str, row: str) -> void {
    pcc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pcc_count_rows(path: str, min_cols: int) -> int {
    let t = pcc_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "InitCommonControls" }
    if k == 1 { return "InitCommonControlsEx" }
    if k == 2 { return "ImageList_Create" }
    if k == 3 { return "ImageList_Add" }
    if k == 4 { return "ImageList_Destroy" }
    if k == 5 { return "ListView_InsertItem" }
    if k == 6 { return "ListView_SetItemText" }
    if k == 7 { return "ListView_GetItemCount" }
    if k == 8 { return "TreeView_InsertItem" }
    if k == 9 { return "TreeView_DeleteItem" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 1 {
            return "init"
        }
    }
    if k >= 2 {
        if k <= 4 {
            return "imagelist"
        }
    }
    if k >= 5 {
        if k <= 7 {
            return "listview"
        }
    }
    if k >= 8 {
        if k <= 9 {
            return "treeview"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: COMCTL32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_comctl32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_comctl32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_comctl32_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_comctl32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_comctl32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pcc_append_row(pcc_syscall_invoke_path(), row)
}

// ─── record_imagelist_event: ImageList_Create/Add/Destroy row ───
fn record_imagelist_event(evt_id: int, il_kind: str, himagelist_hex: str, image_count: int, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_comctl32_core FAIL [record_imagelist_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if il_kind == "" {
        panic("pe_comctl32_core FAIL [record_imagelist_event] expected=il_kind!=empty got=empty")
    }
    if himagelist_hex == "" {
        panic("pe_comctl32_core FAIL [record_imagelist_event] expected=himagelist_hex!=empty got=empty")
    }
    if image_count < 0 {
        panic("pe_comctl32_core FAIL [record_imagelist_event] expected=image_count>=0 got=" + to_string(image_count))
    }
    if status == "" {
        panic("pe_comctl32_core FAIL [record_imagelist_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + il_kind + "\t" + himagelist_hex + "\t"
        + to_string(image_count) + "\t" + status + "\n"
    pcc_append_row(pcc_imagelist_event_path(), row)
}

