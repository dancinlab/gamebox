fn record_treeview_event(evt_id: int, tv_kind: str, htreeitem_hex: str, parent_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_comctl32_core FAIL [record_treeview_event] expected=evt_id>0 got=" + to_string(evt_id))
