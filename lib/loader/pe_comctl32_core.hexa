// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pcc_count_rows(pcc_syscall_invoke_path(), 4)
}

fn imagelist_event_count() -> int {
    return pcc_count_rows(pcc_imagelist_event_path(), 5)
}

fn listview_event_count() -> int {
    return pcc_count_rows(pcc_listview_event_path(), 5)
}

fn treeview_event_count() -> int {
    return pcc_count_rows(pcc_treeview_event_path(), 5)
}

fn pcc_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(imagelist_event_count())
    out.push(listview_event_count())
    out.push(treeview_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pcc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pcc()

    // ─── 1. syscall_invoke × 10 (one per fn, 4 group coverage) ───
    //   INIT group (2)
    record_syscall_invoke(1, 0, "InitCommonControls", "PARTIAL")
    println("__COMCTL32__ PARTIAL InitCommonControls")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"InitCommonControls\",\"fn_group\":\"init\",\"status\":\"PARTIAL\",\"return_synth\":\"void\",\"deprecated_note\":\"replaced by InitCommonControlsEx in newer apps\"")
    record_syscall_invoke(2, 1, "InitCommonControlsEx", "PARTIAL")
    println("__COMCTL32__ PARTIAL InitCommonControlsEx")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"InitCommonControlsEx\",\"fn_group\":\"init\",\"status\":\"PARTIAL\",\"icex_hex\":\"0x92000000\",\"struct_bytes\":8,\"dwsize\":\"0x00000008\",\"dwicc\":\"0x000000FF\",\"return_synth\":\"TRUE\"")

    //   IMAGELIST group (3)
    record_syscall_invoke(3, 2, "ImageList_Create", "PARTIAL")
    println("__COMCTL32__ PARTIAL ImageList_Create")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"ImageList_Create\",\"fn_group\":\"imagelist\",\"status\":\"PARTIAL\",\"cx\":32,\"cy\":32,\"flags\":\"0x00000020\",\"flags_kind\":\"ILC_COLOR32\",\"cInitial\":4,\"cGrow\":4,\"himagelist_hex\":\"0x92010000\"")
    record_syscall_invoke(4, 3, "ImageList_Add", "PARTIAL")
    println("__COMCTL32__ PARTIAL ImageList_Add")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"ImageList_Add\",\"fn_group\":\"imagelist\",\"status\":\"PARTIAL\",\"himagelist_hex\":\"0x92010000\",\"hbitmap_hex\":\"0x92010100\",\"hbitmap_mask_hex\":\"0x00000000\",\"image_index_synth\":0")
    record_syscall_invoke(5, 4, "ImageList_Destroy", "PARTIAL")
    println("__COMCTL32__ PARTIAL ImageList_Destroy")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"ImageList_Destroy\",\"fn_group\":\"imagelist\",\"status\":\"PARTIAL\",\"himagelist_hex\":\"0x92010000\",\"return_synth\":\"TRUE\"")

    //   LISTVIEW group (3)
    record_syscall_invoke(6, 5, "ListView_InsertItem", "PARTIAL")
    println("__COMCTL32__ PARTIAL ListView_InsertItem")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"ListView_InsertItem\",\"fn_group\":\"listview\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00020000\",\"lvitem_hex\":\"0x92020000\",\"struct_bytes\":60,\"mask\":\"0x0000000D\",\"iItem\":5,\"pszText_synth\":\"Item 5\",\"return_synth\":5")
    record_syscall_invoke(7, 6, "ListView_SetItemText", "PARTIAL")
    println("__COMCTL32__ PARTIAL ListView_SetItemText")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"ListView_SetItemText\",\"fn_group\":\"listview\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00020000\",\"iItem\":5,\"iSubItem\":1,\"pszText_synth\":\"D2R Save 1\",\"return_synth\":\"TRUE\"")
    record_syscall_invoke(8, 7, "ListView_GetItemCount", "PARTIAL")
    println("__COMCTL32__ PARTIAL ListView_GetItemCount")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"ListView_GetItemCount\",\"fn_group\":\"listview\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00020000\",\"return_synth\":8")

    //   TREEVIEW group (2)
    record_syscall_invoke(9, 8, "TreeView_InsertItem", "PARTIAL")
    println("__COMCTL32__ PARTIAL TreeView_InsertItem")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"TreeView_InsertItem\",\"fn_group\":\"treeview\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00030000\",\"tvitem_hex\":\"0x92030000\",\"struct_bytes\":40,\"mask\":\"0x00000001\",\"mask_kind\":\"TVIF_TEXT\",\"hParent_hex\":\"0x00000000\",\"hParent_kind\":\"TVI_ROOT\",\"pszText_synth\":\"Tree Node\",\"htreeitem_hex\":\"0x92030400\"")
    record_syscall_invoke(10, 9, "TreeView_DeleteItem", "PARTIAL")
    println("__COMCTL32__ PARTIAL TreeView_DeleteItem")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"TreeView_DeleteItem\",\"fn_group\":\"treeview\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00030000\",\"htreeitem_hex\":\"0x92030400\",\"return_synth\":\"TRUE\"")

    // ─── 2. imagelist_event × 3 (create/add/destroy) ───
    record_imagelist_event(1, "il_create_32x32_ILC_COLOR32", "0x92010000", 0, "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"imagelist_event\",\"evt_id\":1,\"il_kind\":\"il_create_32x32_ILC_COLOR32\",\"himagelist_hex\":\"0x92010000\",\"cx\":32,\"cy\":32,\"flags\":\"0x00000020\",\"image_count\":0,\"status\":\"PARTIAL\"")
    record_imagelist_event(2, "il_add_bitmap", "0x92010000", 1, "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"imagelist_event\",\"evt_id\":2,\"il_kind\":\"il_add_bitmap\",\"himagelist_hex\":\"0x92010000\",\"hbitmap_hex\":\"0x92010100\",\"hmask_hex\":\"0x00000000\",\"image_count\":1,\"image_index\":0,\"status\":\"PARTIAL\"")
    record_imagelist_event(3, "il_destroy", "0x92010000", 0, "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"imagelist_event\",\"evt_id\":3,\"il_kind\":\"il_destroy\",\"himagelist_hex\":\"0x92010000\",\"image_count\":0,\"return_synth\":\"TRUE\",\"status\":\"PARTIAL\"")

    // ─── 3. listview_event × 3 (insert/set_text/get_count) ───
    record_listview_event(1, "lv_insert_item", "0x92020000", 5, "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"listview_event\",\"evt_id\":1,\"lv_kind\":\"lv_insert_item\",\"lvitem_hex\":\"0x92020000\",\"struct_bytes\":60,\"mask\":\"0x0000000D\",\"iItem\":5,\"iSubItem\":0,\"pszText_synth\":\"Item 5\",\"item_index\":5,\"return_synth\":5,\"status\":\"PARTIAL\"")
    record_listview_event(2, "lv_set_item_text", "0x92020000", 5, "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"listview_event\",\"evt_id\":2,\"lv_kind\":\"lv_set_item_text\",\"lvitem_hex\":\"0x92020000\",\"iItem\":5,\"iSubItem\":1,\"pszText_synth\":\"D2R Save 1\",\"item_index\":5,\"return_synth\":\"TRUE\",\"status\":\"PARTIAL\"")
    record_listview_event(3, "lv_get_item_count", "0x00020000", 8, "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"listview_event\",\"evt_id\":3,\"lv_kind\":\"lv_get_item_count\",\"hwnd_hex\":\"0x00020000\",\"lvitem_hex\":\"0x00020000\",\"item_index\":8,\"return_synth\":8,\"status\":\"PARTIAL\"")

    // ─── 4. treeview_event × 2 (insert/delete) ───
    record_treeview_event(1, "tv_insert_item", "0x92030400", "0x00000000", "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"treeview_event\",\"evt_id\":1,\"tv_kind\":\"tv_insert_item\",\"tvitem_hex\":\"0x92030000\",\"struct_bytes\":40,\"mask\":\"0x00000001\",\"hParent_hex\":\"0x00000000\",\"hParent_kind\":\"TVI_ROOT\",\"hInsertAfter\":\"TVI_LAST\",\"pszText_synth\":\"Tree Node\",\"htreeitem_hex\":\"0x92030400\",\"parent_hex\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_treeview_event(2, "tv_delete_item", "0x92030400", "0x92030400", "PARTIAL")
    r0_emit("pe_comctl32_core_record", "\"kind\":\"treeview_event\",\"evt_id\":2,\"tv_kind\":\"tv_delete_item\",\"hwnd_hex\":\"0x00030000\",\"htreeitem_hex\":\"0x92030400\",\"parent_hex\":\"0x92030400\",\"return_synth\":\"TRUE\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_comctl32_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let il = imagelist_event_count()
    if il != 3 {
        panic("pe_comctl32_core FAIL [imagelist_event_count] expected=3 got=" + to_string(il))
    }
    let lv = listview_event_count()
    if lv != 3 {
        panic("pe_comctl32_core FAIL [listview_event_count] expected=3 got=" + to_string(lv))
    }
    let tv = treeview_event_count()
    if tv != 2 {
        panic("pe_comctl32_core FAIL [treeview_event_count] expected=2 got=" + to_string(tv))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "InitCommonControls" { panic("pe_comctl32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(1) != "InitCommonControlsEx" { panic("pe_comctl32_core FAIL [fn_kind_name(1)]") }
    if fn_kind_name(2) != "ImageList_Create" { panic("pe_comctl32_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(5) != "ListView_InsertItem" { panic("pe_comctl32_core FAIL [fn_kind_name(5)]") }
    if fn_kind_name(8) != "TreeView_InsertItem" { panic("pe_comctl32_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(9) != "TreeView_DeleteItem" { panic("pe_comctl32_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_comctl32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "init" { panic("pe_comctl32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(2) != "imagelist" { panic("pe_comctl32_core FAIL [fn_group_name(2)]") }
    if fn_group_name(5) != "listview" { panic("pe_comctl32_core FAIL [fn_group_name(5)]") }
    if fn_group_name(8) != "treeview" { panic("pe_comctl32_core FAIL [fn_group_name(8)]") }
    if fn_group_name(99) != "unknown" { panic("pe_comctl32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pcc_stats()
    if len(s) != 4 { panic("pe_comctl32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_comctl32_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 3 { panic("pe_comctl32_core FAIL [stats imagelist_event_count] expected=3 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_comctl32_core FAIL [stats listview_event_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 2 { panic("pe_comctl32_core FAIL [stats treeview_event_count] expected=2 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_comctl32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"imagelist_event_count\":" + to_string(s[1])
        + ",\"listview_event_count\":" + to_string(s[2])
        + ",\"treeview_event_count\":" + to_string(s[3]))

    r0_emit("pe_comctl32_core_summary",
        "\"target\":\"COMCTL32.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"init\",\"imagelist\",\"listview\",\"treeview\"],\"initcommoncontrolsex_synth_bytes\":8,\"lvitem_synth_bytes\":60,\"tvitem_synth_bytes\":40,\"icc_class_constants\":\"0x000000FF_all\",\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_comctl32_core_kpi",
        "\"init_emits\":2,\"imagelist_emits\":3,\"listview_emits\":3,\"treeview_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"common_controls_dependency_unblock_partial\":true")

    // ─── cycle 37 → 38 COMCTL32 coverage progression evidence emit ───
    r0_emit("pe_comctl32_core_coverage_progression",
        "\"surface\":\"COMCTL32_full_435_fn\",\"cycle_37_count\":156,\"cycle_38_count\":166,\"delta\":10,\"cycle_37_percent\":35.86,\"cycle_38_percent\":38.16,\"cycle_38_module\":\"pe_comctl32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_ah3_cycle_increment\":10")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_comctl32_core_round_trip_matrix",
        "\"surface\":\"COMCTL32_core_10_fn\",\"fn_partial\":10,\"fn_groups\":4,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.2\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real ImageList_Create + ListView_InsertItem + TreeView_InsertItem = NSImage + NSTableView + NSOutlineView bridge pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"common_controls_dependency\":\"D2R installer/launcher UI + D2R config dialog + 다수 PE binary common controls baseline\"")

    // ─── Track AH3 expansion emit (cycle 38, COMCTL32 +10 fn) ───
    r0_emit("pe_comctl32_core_ah3_expansion",
        "\"track\":\"AH3\",\"cycle\":38,\"surface\":\"COMCTL32_new\",\"new_fn\":10,\"groups\":[\"init\",\"imagelist\",\"listview\",\"treeview\"],\"init_count\":2,\"imagelist_count\":3,\"listview_count\":3,\"treeview_count\":2,\"emit_format\":\"__COMCTL32__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_2_evidence_augment\":true,\"track_ah_bundled_part_3_of_4\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_comctl32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pcc()
    let s2 = pcc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_comctl32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_comctl32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", imagelist_event=" + to_string(s[1])
        + ", listview_event=" + to_string(s[2]) + ", treeview_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcc_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("imagelist_event_count\t" + to_string(s[1]))
            println("listview_event_count\t" + to_string(s[2]))
            println("treeview_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_comctl32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_comctl32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcc()
            println("cleaned: " + pcc_dir())
            return
        }
        if sub == "dir" {
            println(pcc_dir())
            return
        }
    }
    println("usage: hexa run pe_comctl32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
