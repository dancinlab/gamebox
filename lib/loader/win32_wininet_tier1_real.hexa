// lib/loader/win32_wininet_tier1_real.hexa — cycle 81 R6 Tier 1 WININET trivial impl tracker
//
// Tier 1 trivial WININET → Apple-native:
//   InternetOpenW                  → NSURLSession sharedSession + handle table entry
//   InternetCloseHandle            → handle table free
//   InternetSet/QueryOptionW       → NSURLSessionConfiguration get/set
//   InternetGet/SetCookieW         → NSHTTPCookieStorage sharedHTTPCookieStorage
//   InternetCheckConnectionW       → NSURLConnection canConnectToHost (deprecated MSDN, simple ping)
//   InternetCrackUrlW              → NSURLComponents parser
// own1: Apple Foundation/Network + MSDN. Wine wininet/internet.c 인용 X
//
// own 1 enforcement: Wine / Reactos / CrossOver / community 코드 0 줄.
//   본 module 은 WININET Tier 1 trivial 함수 호출 tracker — 실 native dispatch X.
//   Apple-native mapping 은 docstring 만 (실 helper.mm bridge stage6).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code (WININET export):
//   1 = InternetOpenW
//   2 = InternetCloseHandle
//   3 = InternetSetOptionW
//   4 = InternetQueryOptionW
//   5 = InternetGetCookieW
//   6 = InternetSetCookieW
//   7 = InternetCheckConnectionW
//   8 = InternetCrackUrlW
//
// impl_status code:
//   1 = real_nsurlsession  (NSURLSession sharedSession + handle table — InternetOpenW/CloseHandle)
//   2 = stub_handle        (handle table id without real session — placeholder)
//   3 = stub_no_op         (deprecated/no-op return — InternetCheckConnectionW)
//   4 = passthrough        (NSURLSessionConfiguration / NSHTTPCookieStorage / NSURLComponents call-through)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t impl_status<int> \t handle_value<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wit1_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_wininet_tier1_real"
}

fn wit1_calls_path() -> str {
    return wit1_dir() + "/calls.tsv"
}

fn wit1_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wit1_dir() + "'")
}

fn cleanup_wit1() -> void {
    wit1_ensure_dir()
    let _ = exec("rm -f '" + wit1_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wit1_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wit1_append_row(path: str, row: str) -> void {
    wit1_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: WININET Tier 1 호출 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, impl_status: int, handle_value: int) -> void {
    if call_id <= 0 {
        panic("win32_wininet_tier1_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_wininet_tier1_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 8 {
        panic("win32_wininet_tier1_real FAIL [record_call] expected=func_kind<=8 got=" + to_string(func_kind))
    }
    if impl_status < 1 {
        panic("win32_wininet_tier1_real FAIL [record_call] expected=impl_status>=1 got=" + to_string(impl_status))
    }
    if impl_status > 4 {
        panic("win32_wininet_tier1_real FAIL [record_call] expected=impl_status<=4 got=" + to_string(impl_status))
    }
    if handle_value < 0 {
        panic("win32_wininet_tier1_real FAIL [record_call] expected=handle_value>=0 got=" + to_string(handle_value))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(impl_status) + "\t" + to_string(handle_value) + "\n"
    wit1_append_row(wit1_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wit1_read_table(wit1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 호출 수 ───
fn count_by_func_kind(func_kind: int) -> int {
    let t = wit1_read_table(wit1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == func_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_impl_status: 특정 impl_status 의 호출 수 ───
fn count_by_impl_status(impl_status: int) -> int {
    let t = wit1_read_table(wit1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == impl_status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── real_nsurlsession_count: impl_status=1 (real_nsurlsession) 호출 수 ───
fn real_nsurlsession_count() -> int {
    return count_by_impl_status(1)
}

// ─── valid_handle_count: handle_value > 0 인 호출 수 ───
fn valid_handle_count() -> int {
    let t = wit1_read_table(wit1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) > 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_handle_value: 특정 call_id 의 handle_value (없으면 0) ───
fn call_handle_value(call_id: int) -> int {
    let t = wit1_read_table(wit1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wit1_stats: [call_count, real_nsurlsession_count, valid_handle_count, count_by_impl_status(3)] ───
fn wit1_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(real_nsurlsession_count())
    out.push(valid_handle_count())
    out.push(count_by_impl_status(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wit1-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wit1()

    // 2. record 5 calls (≥3 func_kinds, ≥3 impl_statuses)
    //    func_kinds: 1 (InternetOpenW), 2 (InternetCloseHandle), 5 (InternetGetCookieW),
    //                7 (InternetCheckConnectionW), 8 (InternetCrackUrlW)
    //    impl_statuses: 1 (real_nsurlsession) ×2, 3 (stub_no_op) ×1, 4 (passthrough) ×2

    // call 1: InternetOpenW → real_nsurlsession (NSURLSession sharedSession) → handle 0xC0FE0001
    record_call(820001, 1, 1, 3237806081)
    r0_emit("win32_wininet_tier1_real_record",
        "\"call_id\":820001,\"func_kind\":1,\"impl_status\":1,\"handle_value\":3237806081,\"target\":\"InternetOpenW\",\"native\":\"NSURLSession.sharedSession\"")

    // call 2: InternetCloseHandle → real_nsurlsession (handle table free) → 0 (closed)
    record_call(820002, 2, 1, 0)
    r0_emit("win32_wininet_tier1_real_record",
        "\"call_id\":820002,\"func_kind\":2,\"impl_status\":1,\"handle_value\":0,\"target\":\"InternetCloseHandle\",\"native\":\"handle_table.free\"")

    // call 3: InternetGetCookieW → passthrough (NSHTTPCookieStorage) → handle 0 (stateless query)
    record_call(820003, 5, 4, 0)
    r0_emit("win32_wininet_tier1_real_record",
        "\"call_id\":820003,\"func_kind\":5,\"impl_status\":4,\"handle_value\":0,\"target\":\"InternetGetCookieW\",\"native\":\"NSHTTPCookieStorage.sharedHTTPCookieStorage\"")

    // call 4: InternetCheckConnectionW → stub_no_op (deprecated MSDN) → 1 (always success)
    record_call(820004, 7, 3, 1)
    r0_emit("win32_wininet_tier1_real_record",
        "\"call_id\":820004,\"func_kind\":7,\"impl_status\":3,\"handle_value\":1,\"target\":\"InternetCheckConnectionW\",\"native\":\"deprecated_simple_ping\"")

    // call 5: InternetCrackUrlW → passthrough (NSURLComponents) → handle 0 (parser, no session)
    record_call(820005, 8, 4, 0)
    r0_emit("win32_wininet_tier1_real_record",
        "\"call_id\":820005,\"func_kind\":8,\"impl_status\":4,\"handle_value\":0,\"target\":\"InternetCrackUrlW\",\"native\":\"NSURLComponents\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("win32_wininet_tier1_real FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (≥3 distinct: 1,2,5,7,8)
    let fk1 = count_by_func_kind(1)
    if fk1 != 1 {
        panic("win32_wininet_tier1_real FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(fk1))
    }
    let fk2 = count_by_func_kind(2)
    if fk2 != 1 {
        panic("win32_wininet_tier1_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(fk2))
    }
    let fk5 = count_by_func_kind(5)
    if fk5 != 1 {
        panic("win32_wininet_tier1_real FAIL [count_by_func_kind(5)] expected=1 got=" + to_string(fk5))
    }
    let fk7 = count_by_func_kind(7)
    if fk7 != 1 {
        panic("win32_wininet_tier1_real FAIL [count_by_func_kind(7)] expected=1 got=" + to_string(fk7))
    }
    let fk8 = count_by_func_kind(8)
    if fk8 != 1 {
        panic("win32_wininet_tier1_real FAIL [count_by_func_kind(8)] expected=1 got=" + to_string(fk8))
    }
    let fk3 = count_by_func_kind(3)
    if fk3 != 0 {
        panic("win32_wininet_tier1_real FAIL [count_by_func_kind(3)] expected=0 got=" + to_string(fk3))
    }

    // 5. count_by_impl_status — ≥3 statuses covered (1, 3, 4)
    let is1 = count_by_impl_status(1)
    if is1 != 2 {
        panic("win32_wininet_tier1_real FAIL [count_by_impl_status(1)] expected=2 got=" + to_string(is1))
    }
    let is2 = count_by_impl_status(2)
    if is2 != 0 {
        panic("win32_wininet_tier1_real FAIL [count_by_impl_status(2)] expected=0 got=" + to_string(is2))
    }
    let is3 = count_by_impl_status(3)
    if is3 != 1 {
        panic("win32_wininet_tier1_real FAIL [count_by_impl_status(3)] expected=1 got=" + to_string(is3))
    }
    let is4 = count_by_impl_status(4)
    if is4 != 2 {
        panic("win32_wininet_tier1_real FAIL [count_by_impl_status(4)] expected=2 got=" + to_string(is4))
    }

    // 6. real_nsurlsession_count = 2
    let rnc = real_nsurlsession_count()
    if rnc != 2 {
        panic("win32_wininet_tier1_real FAIL [real_nsurlsession_count] expected=2 got=" + to_string(rnc))
    }

    // 7. valid_handle_count = 2 (call 1: 3237806081 > 0, call 4: 1 > 0; rest = 0)
    let vhc = valid_handle_count()
    if vhc != 2 {
        panic("win32_wininet_tier1_real FAIL [valid_handle_count] expected=2 got=" + to_string(vhc))
    }

    // 8. call_handle_value sanity
    let hv1 = call_handle_value(820001)
    if hv1 != 3237806081 {
        panic("win32_wininet_tier1_real FAIL [call_handle_value(820001)] expected=3237806081 got=" + to_string(hv1))
    }
    let hv4 = call_handle_value(820004)
    if hv4 != 1 {
        panic("win32_wininet_tier1_real FAIL [call_handle_value(820004)] expected=1 got=" + to_string(hv4))
    }
    let hv_miss = call_handle_value(9999)
    if hv_miss != 0 {
        panic("win32_wininet_tier1_real FAIL [call_handle_value(9999)] expected=0 got=" + to_string(hv_miss))
    }

    // 9. wit1_stats() = [5, 2, 2, 1]
    let s = wit1_stats()
    if len(s) != 4 {
        panic("win32_wininet_tier1_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("win32_wininet_tier1_real FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("win32_wininet_tier1_real FAIL [stats real_nsurlsession_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("win32_wininet_tier1_real FAIL [stats valid_handle_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("win32_wininet_tier1_real FAIL [stats stub_no_op] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("win32_wininet_tier1_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"real_nsurlsession_count\":" + to_string(s[1])
        + ",\"valid_handle_count\":" + to_string(s[2])
        + ",\"stub_no_op_count\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("win32_wininet_tier1_real FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_wit1()
    let s2 = wit1_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("win32_wininet_tier1_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_wininet_tier1_real self_test PASS (calls=" + to_string(s[0])
        + ", real_nsurlsession=" + to_string(s[1]) + ", valid_handles=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wit1_stats()
            println("call_count\t" + to_string(s[0]))
            println("real_nsurlsession_count\t" + to_string(s[1]))
            println("valid_handle_count\t" + to_string(s[2]))
            println("stub_no_op_count\t" + to_string(s[3]))
            return
        }
        if sub == "handle" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_handle_value\t" + to_string(call_handle_value(cid)))
                return
            }
            println("usage: hexa run win32_wininet_tier1_real.hexa handle <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let mode = a[3]
                let val = to_int(a[4])
                if mode == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if mode == "impl" {
                    println("count_by_impl_status\t" + to_string(count_by_impl_status(val)))
                    return
                }
                println("usage: hexa run win32_wininet_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
                return
            }
            println("usage: hexa run win32_wininet_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_wit1()
            println("cleaned: " + wit1_dir())
            return
        }
        if sub == "dir" {
            println(wit1_dir())
            return
        }
    }
    println("usage: hexa run win32_wininet_tier1_real.hexa { self-test | stats | handle <call_id> | count func <func_kind> | count impl <impl_status> | cleanup | dir }")
}
