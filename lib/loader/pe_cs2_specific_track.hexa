// lib/loader/pe_cs2_specific_track.hexa — Counter-Strike 2 (Source 2) 전용 entry/loader 추적.
//
// CS2 (Source 2) launch chain (own2 자체 추적):
//   process_attach        — cs2.exe entry
//   source2_engine_init   — engine2.dll, materialsystem2.dll, rendersystemvulkan.dll
//   client_dll_load       — client.dll, server.dll
//   vac_init              — VAC user-mode (closure path B 가능 영역, kernel 아님)
//   server_browser        — matchmaking listing
//   match_load            — bsp/vmap level load
//   first_frame           — Vulkan/Source 2 swapchain
//   disconnect_clean      — match end cleanup
//   주의: 멀티플레이어는 정책상 거부 (사용자 directive: "multiplayer 는 정의상 거부")
//         single-player practice / bot match 만 closure path B 적용
// own1: CS2 binary observation only. Wine CS2 wrapper / community fix 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 CS2-specific phase tracker — 실 cs2.exe 실행 X.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = process_attach        (cs2.exe entry)
//   2 = source2_engine_init   (engine2.dll, materialsystem2.dll, rendersystemvulkan.dll)
//   3 = client_dll_load       (client.dll, server.dll)
//   4 = vac_init              (VAC user-mode init — closure path B 영역)
//   5 = server_browser        (matchmaking listing)
//   6 = match_load            (bsp/vmap level load)
//   7 = first_frame           (Vulkan/Source 2 swapchain)
//   8 = disconnect_clean      (match end cleanup)
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t dll_loaded<int> \t online<int>
//   online: 0 = single-player practice / bot, 1 = MP (정책상 거부 영역 — 추적 only)

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcs2t_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_cs2_specific_track"
}

fn pcs2t_steps_path() -> str {
    return pcs2t_dir() + "/steps.tsv"
}

fn pcs2t_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcs2t_dir() + "'")
}

fn cleanup_pcs2t() -> void {
    pcs2t_ensure_dir()
    let _ = exec("rm -f '" + pcs2t_steps_path() + "'")
}

// ─── 공통 file IO ───
fn pcs2t_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcs2t_append_row(path: str, row: str) -> void {
    pcs2t_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_step: CS2 launch step 1 건 기록 ───
fn record_step(step_id: int, phase_kind: int, dll_loaded: int, online: int) -> void {
    if step_id <= 0 {
        panic("pe_cs2_specific_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_cs2_specific_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 8 {
        panic("pe_cs2_specific_track FAIL [record_step] expected=phase_kind<=8 got=" + to_string(phase_kind))
    }
    if dll_loaded < 0 {
        panic("pe_cs2_specific_track FAIL [record_step] expected=dll_loaded>=0 got=" + to_string(dll_loaded))
    }
    if dll_loaded > 1 {
        panic("pe_cs2_specific_track FAIL [record_step] expected=dll_loaded<=1 got=" + to_string(dll_loaded))
    }
    if online < 0 {
        panic("pe_cs2_specific_track FAIL [record_step] expected=online>=0 got=" + to_string(online))
    }
    if online > 1 {
        panic("pe_cs2_specific_track FAIL [record_step] expected=online<=1 got=" + to_string(online))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(dll_loaded) + "\t" + to_string(online) + "\n"
    pcs2t_append_row(pcs2t_steps_path(), row)
}

// ─── step_count: total step 수 ───
fn step_count() -> int {
    let t = pcs2t_read_table(pcs2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 step 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = pcs2t_read_table(pcs2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── loaded_count: dll_loaded=1 인 step 수 ───
fn loaded_count() -> int {
    let t = pcs2t_read_table(pcs2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── online_count: online=1 인 step 수 (MP 영역, 정책상 거부) ───
fn online_count() -> int {
    let t = pcs2t_read_table(pcs2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── vac_init_count: phase_kind=4 step 수 (closure path B 가능 영역) ───
fn vac_init_count() -> int {
    return count_by_phase_kind(4)
}

// ─── step_dll_loaded: 특정 step_id 의 dll_loaded (없으면 0) ───
fn step_dll_loaded(step_id: int) -> int {
    let t = pcs2t_read_table(pcs2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pcs2t_stats: [step_count, loaded_count, online_count, vac_init_count, count_by_phase_kind(2)] ───
fn pcs2t_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(loaded_count())
    out.push(online_count())
    out.push(vac_init_count())
    out.push(count_by_phase_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pcs2t-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pcs2t()

    // 2. record 8 steps — CS2 launch chain 전체, phase_kind 1..8 각 1건
    //   id 140001: phase 1 process_attach        dll=0 online=0  (cs2.exe entry)
    //   id 140002: phase 2 source2_engine_init   dll=1 online=0  (engine2.dll family)
    //   id 140003: phase 3 client_dll_load       dll=1 online=0  (client.dll, server.dll)
    //   id 140004: phase 4 vac_init              dll=1 online=0  (VAC user-mode, single-player)
    //   id 140005: phase 5 server_browser        dll=0 online=0  (listing — bot match)
    //   id 140006: phase 6 match_load            dll=0 online=0  (bsp/vmap load)
    //   id 140007: phase 7 first_frame           dll=0 online=0  (Vulkan swapchain)
    //   id 140008: phase 8 disconnect_clean      dll=0 online=0  (match end cleanup)
    //   sums: steps=8, loaded=3, online=0, vac_init=1, count_kind(2)=1
    record_step(140001, 1, 0, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140001,\"phase_kind\":1,\"dll_loaded\":0,\"online\":0,\"target\":\"process_attach\"")

    record_step(140002, 2, 1, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140002,\"phase_kind\":2,\"dll_loaded\":1,\"online\":0,\"target\":\"source2_engine_init\"")

    record_step(140003, 3, 1, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140003,\"phase_kind\":3,\"dll_loaded\":1,\"online\":0,\"target\":\"client_dll_load\"")

    record_step(140004, 4, 1, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140004,\"phase_kind\":4,\"dll_loaded\":1,\"online\":0,\"target\":\"vac_init\"")

    record_step(140005, 5, 0, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140005,\"phase_kind\":5,\"dll_loaded\":0,\"online\":0,\"target\":\"server_browser\"")

    record_step(140006, 6, 0, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140006,\"phase_kind\":6,\"dll_loaded\":0,\"online\":0,\"target\":\"match_load\"")

    record_step(140007, 7, 0, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140007,\"phase_kind\":7,\"dll_loaded\":0,\"online\":0,\"target\":\"first_frame\"")

    record_step(140008, 8, 0, 0)
    r0_emit("pe_cs2_specific_track_record",
        "\"step_id\":140008,\"phase_kind\":8,\"dll_loaded\":0,\"online\":0,\"target\":\"disconnect_clean\"")

    // 3. step_count = 8
    let c = step_count()
    if c != 8 {
        panic("pe_cs2_specific_track FAIL [step_count] expected=8 got=" + to_string(c))
    }

    // 4. count_by_phase_kind sanity — 1..8 각 1건, 99 = 0
    let p1 = count_by_phase_kind(1)
    if p1 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p6 = count_by_phase_kind(6)
    if p6 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(p6))
    }
    let p7 = count_by_phase_kind(7)
    if p7 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(7)] expected=1 got=" + to_string(p7))
    }
    let p8 = count_by_phase_kind(8)
    if p8 != 1 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(8)] expected=1 got=" + to_string(p8))
    }
    let p99 = count_by_phase_kind(99)
    if p99 != 0 {
        panic("pe_cs2_specific_track FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p99))
    }

    // 5. loaded_count = 3 (140002, 140003, 140004)
    let lc = loaded_count()
    if lc != 3 {
        panic("pe_cs2_specific_track FAIL [loaded_count] expected=3 got=" + to_string(lc))
    }

    // 6. online_count = 0 (single-player practice/bot only — 정책상 MP X)
    let oc = online_count()
    if oc != 0 {
        panic("pe_cs2_specific_track FAIL [online_count] expected=0 got=" + to_string(oc))
    }

    // 7. vac_init_count = 1
    let vc = vac_init_count()
    if vc != 1 {
        panic("pe_cs2_specific_track FAIL [vac_init_count] expected=1 got=" + to_string(vc))
    }

    // 8. step_dll_loaded sanity
    let d2 = step_dll_loaded(140002)
    if d2 != 1 {
        panic("pe_cs2_specific_track FAIL [step_dll_loaded(140002)] expected=1 got=" + to_string(d2))
    }
    let d7 = step_dll_loaded(140007)
    if d7 != 0 {
        panic("pe_cs2_specific_track FAIL [step_dll_loaded(140007)] expected=0 got=" + to_string(d7))
    }
    let d_miss = step_dll_loaded(9999)
    if d_miss != 0 {
        panic("pe_cs2_specific_track FAIL [step_dll_loaded(9999)] expected=0 got=" + to_string(d_miss))
    }

    // 9. pcs2t_stats() = [8, 3, 0, 1, 1]
    let s = pcs2t_stats()
    if len(s) != 5 {
        panic("pe_cs2_specific_track FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_cs2_specific_track FAIL [stats step_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_cs2_specific_track FAIL [stats loaded_count] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 0 {
        panic("pe_cs2_specific_track FAIL [stats online_count] expected=0 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_cs2_specific_track FAIL [stats vac_init_count] expected=1 got=" + to_string(s[3]))
    }
    if s[4] != 1 {
        panic("pe_cs2_specific_track FAIL [stats count_source2_engine_init] expected=1 got=" + to_string(s[4]))
    }

    // 10. emit stats
    r0_emit("pe_cs2_specific_track_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"loaded_count\":" + to_string(s[1])
        + ",\"online_count\":" + to_string(s[2])
        + ",\"vac_init_count\":" + to_string(s[3])
        + ",\"count_source2_engine_init\":" + to_string(s[4]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_cs2_specific_track FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pcs2t()
    let s2 = pcs2t_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_cs2_specific_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_cs2_specific_track self_test PASS (steps=" + to_string(s[0])
        + ", loaded=" + to_string(s[1]) + ", online=" + to_string(s[2])
        + ", vac_init=" + to_string(s[3]) + ", source2_engine_init=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcs2t_stats()
            println("step_count\t" + to_string(s[0]))
            println("loaded_count\t" + to_string(s[1]))
            println("online_count\t" + to_string(s[2]))
            println("vac_init_count\t" + to_string(s[3]))
            println("count_source2_engine_init\t" + to_string(s[4]))
            return
        }
        if sub == "loaded" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_dll_loaded\t" + to_string(step_dll_loaded(sid)))
                return
            }
            println("usage: hexa run pe_cs2_specific_track.hexa loaded <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_cs2_specific_track.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcs2t()
            println("cleaned: " + pcs2t_dir())
            return
        }
        if sub == "dir" {
            println(pcs2t_dir())
            return
        }
    }
    println("usage: hexa run pe_cs2_specific_track.hexa { self-test | stats | loaded <step_id> | count <phase_kind> | cleanup | dir }")
}
