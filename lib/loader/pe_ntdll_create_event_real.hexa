// lib/loader/pe_ntdll_create_event_real.hexa — NTDLL NtCreateEvent/Set/Reset/Pulse 실 호출 추적
//
// NTDLL NtCreateEvent / NtSetEvent / NtResetEvent / NtPulseEvent / NtOpenEvent 실 호출 → POSIX bridge:
//   NtCreateEvent(out EventHandle, DesiredAccess, OBJECT_ATTRIBUTES*, EventType, InitialState)
//     → pthread_mutex_init + pthread_cond_init + handle table entry
//   NtSetEvent(EventHandle, PreviousState*)
//     → pthread_mutex_lock + state=signaled + pthread_cond_broadcast(notification) / pthread_cond_signal(synchronization) + pthread_mutex_unlock
//   NtResetEvent(EventHandle, PreviousState*)
//     → pthread_mutex_lock + state=non-signaled + pthread_mutex_unlock
//   NtPulseEvent(EventHandle, PreviousState*)
//     → pthread_mutex_lock + pthread_cond_broadcast(or _signal) + state=non-signaled + pthread_mutex_unlock
//   NtOpenEvent(out EventHandle, DesiredAccess, OBJECT_ATTRIBUTES*)
//     → handle table lookup by NT object name
//
//   event_kind 의미:
//     1 = NotificationEvent (manual-reset) — NtSetEvent → broadcast, 모든 waiter wake, state stays signaled until reset
//     2 = SynchronizationEvent (auto-reset)  — NtSetEvent → signal, 1 waiter wake + state auto-reset to non-signaled
//
//   D2R / D4 의 thread sync (loader → renderer ready, network IO completion 등) NtCreateEvent path 사용
//
// own1: NTDLL spec + Apple pthread. Wine ntdll/sync.c 인용 X.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 NT API call tracker — 실 NtCreateEvent / pthread_cond_init 호출 X (native bridge stage).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = NtCreateEvent
//   2 = NtSetEvent
//   3 = NtResetEvent
//   4 = NtPulseEvent
//   5 = NtOpenEvent
//
// event_kind code:
//   1 = NotificationEvent  (manual-reset, pthread_cond_broadcast)
//   2 = SynchronizationEvent (auto-reset, pthread_cond_signal)
//
// elevated code:
//   0 = normal user
//   1 = elevated (admin / SeIncreaseBasePriorityPrivilege 등)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t event_kind<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pncer_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ntdll_create_event_real"
}

fn pncer_ops_path() -> str {
    return pncer_dir() + "/ops.tsv"
}

fn pncer_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pncer_dir() + "'")
}

fn cleanup_pncer() -> void {
    pncer_ensure_dir()
    let _ = exec("rm -f '" + pncer_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pncer_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pncer_append_row(path: str, row: str) -> void {
    pncer_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: NT event op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, event_kind: int, elevated: int) -> void {
    if op_id <= 0 {
        panic("pe_ntdll_create_event_real FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_ntdll_create_event_real FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 5 {
        panic("pe_ntdll_create_event_real FAIL [record_op] expected=op_kind<=5 got=" + to_string(op_kind))
    }
    if event_kind < 1 {
        panic("pe_ntdll_create_event_real FAIL [record_op] expected=event_kind>=1 got=" + to_string(event_kind))
    }
    if event_kind > 2 {
        panic("pe_ntdll_create_event_real FAIL [record_op] expected=event_kind<=2 got=" + to_string(event_kind))
    }
    if elevated < 0 {
        panic("pe_ntdll_create_event_real FAIL [record_op] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_ntdll_create_event_real FAIL [record_op] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(event_kind) + "\t" + to_string(elevated) + "\n"
    pncer_append_row(pncer_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pncer_read_table(pncer_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = pncer_read_table(pncer_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_event_kind: 특정 event_kind 의 op 수 ───
fn count_by_event_kind(kind: int) -> int {
    let t = pncer_read_table(pncer_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── elevated_count: elevated == 1 op 수 ───
fn elevated_count() -> int {
    let t = pncer_read_table(pncer_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── set_count: NtSetEvent (op_kind=2) 의 op 수 ───
fn set_count() -> int {
    return count_by_op_kind(2)
}

// ─── op_event_kind: 특정 op_id 의 event_kind (없으면 -1) ───
fn op_event_kind(op_id: int) -> int {
    let t = pncer_read_table(pncer_ops_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pncer_stats: [op_count, set_count, count_by_event_kind(1), elevated_count] ───
fn pncer_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(set_count())
    out.push(count_by_event_kind(1))
    out.push(elevated_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pncer-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pncer()

    // 2. record 6 ops — covers ≥4 op_kinds (1,2,3,4) + both event_kinds (1,2) + mix elevated
    //    NtCreateEvent NotificationEvent (D2R loader → renderer ready signal, manual-reset)
    record_op(170001, 1, 1, 0)
    r0_emit("pe_ntdll_create_event_real_record",
        "\"op_id\":170001,\"op_kind\":1,\"event_kind\":1,\"elevated\":0,\"target\":\"NtCreateEvent\"")

    //    NtCreateEvent SynchronizationEvent (auto-reset, network IO completion)
    record_op(170002, 1, 2, 0)
    r0_emit("pe_ntdll_create_event_real_record",
        "\"op_id\":170002,\"op_kind\":1,\"event_kind\":2,\"elevated\":0,\"target\":\"NtCreateEvent\"")

    //    NtSetEvent on NotificationEvent → cond_broadcast (all waiters wake)
    record_op(170003, 2, 1, 0)
    r0_emit("pe_ntdll_create_event_real_record",
        "\"op_id\":170003,\"op_kind\":2,\"event_kind\":1,\"elevated\":0,\"target\":\"NtSetEvent\"")

    //    NtSetEvent on SynchronizationEvent → cond_signal (1 waiter wake, auto-reset)
    record_op(170004, 2, 2, 1)
    r0_emit("pe_ntdll_create_event_real_record",
        "\"op_id\":170004,\"op_kind\":2,\"event_kind\":2,\"elevated\":1,\"target\":\"NtSetEvent\"")

    //    NtResetEvent on NotificationEvent (manual reset to non-signaled)
    record_op(170005, 3, 1, 0)
    r0_emit("pe_ntdll_create_event_real_record",
        "\"op_id\":170005,\"op_kind\":3,\"event_kind\":1,\"elevated\":0,\"target\":\"NtResetEvent\"")

    //    NtPulseEvent on SynchronizationEvent (broadcast then immediate reset)
    record_op(170006, 4, 2, 0)
    r0_emit("pe_ntdll_create_event_real_record",
        "\"op_id\":170006,\"op_kind\":4,\"event_kind\":2,\"elevated\":0,\"target\":\"NtPulseEvent\"")

    // 3. op_count = 6
    let c = op_count()
    if c != 6 {
        panic("pe_ntdll_create_event_real FAIL [op_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_op_kind sanity (≥4 op_kinds covered: 1,2,3,4)
    let k1 = count_by_op_kind(1)
    if k1 != 2 {
        panic("pe_ntdll_create_event_real FAIL [count_by_op_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 2 {
        panic("pe_ntdll_create_event_real FAIL [count_by_op_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_ntdll_create_event_real FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 1 {
        panic("pe_ntdll_create_event_real FAIL [count_by_op_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_op_kind(5)
    if k99 != 0 {
        panic("pe_ntdll_create_event_real FAIL [count_by_op_kind(5)] expected=0 got=" + to_string(k99))
    }

    // 5. count_by_event_kind sanity (both kinds covered)
    let e1 = count_by_event_kind(1)
    if e1 != 3 {
        panic("pe_ntdll_create_event_real FAIL [count_by_event_kind(1)] expected=3 got=" + to_string(e1))
    }
    let e2 = count_by_event_kind(2)
    if e2 != 3 {
        panic("pe_ntdll_create_event_real FAIL [count_by_event_kind(2)] expected=3 got=" + to_string(e2))
    }

    // 6. set_count = 2 (== count_by_op_kind(2))
    let sc = set_count()
    if sc != 2 {
        panic("pe_ntdll_create_event_real FAIL [set_count] expected=2 got=" + to_string(sc))
    }

    // 7. elevated_count = 1
    let ec = elevated_count()
    if ec != 1 {
        panic("pe_ntdll_create_event_real FAIL [elevated_count] expected=1 got=" + to_string(ec))
    }

    // 8. op_event_kind sanity
    let ek1 = op_event_kind(170001)
    if ek1 != 1 {
        panic("pe_ntdll_create_event_real FAIL [op_event_kind(170001)] expected=1 got=" + to_string(ek1))
    }
    let ek4 = op_event_kind(170004)
    if ek4 != 2 {
        panic("pe_ntdll_create_event_real FAIL [op_event_kind(170004)] expected=2 got=" + to_string(ek4))
    }
    let ek_miss = op_event_kind(9999)
    if ek_miss != -1 {
        panic("pe_ntdll_create_event_real FAIL [op_event_kind(9999)] expected=-1 got=" + to_string(ek_miss))
    }

    // 9. pncer_stats() = [6, 2, 3, 1]
    let s = pncer_stats()
    if len(s) != 4 {
        panic("pe_ntdll_create_event_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_ntdll_create_event_real FAIL [stats op_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_ntdll_create_event_real FAIL [stats set_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_ntdll_create_event_real FAIL [stats event_kind(1)] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_ntdll_create_event_real FAIL [stats elevated_count] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats (7th r0_emit)
    r0_emit("pe_ntdll_create_event_real_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"set_count\":" + to_string(s[1])
        + ",\"event_kind_notification\":" + to_string(s[2])
        + ",\"elevated_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_ntdll_create_event_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0 (post-cleanup zero)
    cleanup_pncer()
    let s2 = pncer_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ntdll_create_event_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ntdll_create_event_real self_test PASS (ops=" + to_string(s[0])
        + ", set=" + to_string(s[1]) + ", notification=" + to_string(s[2])
        + ", elevated=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pncer_stats()
            println("op_count\t" + to_string(s[0]))
            println("set_count\t" + to_string(s[1]))
            println("count_event_kind_notification\t" + to_string(s[2]))
            println("elevated_count\t" + to_string(s[3]))
            return
        }
        if sub == "event-kind" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_event_kind\t" + to_string(op_event_kind(oid)))
                return
            }
            println("usage: hexa run pe_ntdll_create_event_real.hexa event-kind <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let what = a[3]
                let val = to_int(a[4])
                if what == "op" {
                    println("count_by_op_kind\t" + to_string(count_by_op_kind(val)))
                    return
                }
                if what == "event" {
                    println("count_by_event_kind\t" + to_string(count_by_event_kind(val)))
                    return
                }
            }
            println("usage: hexa run pe_ntdll_create_event_real.hexa count { op <op_kind> | event <event_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pncer()
            println("cleaned: " + pncer_dir())
            return
        }
        if sub == "dir" {
            println(pncer_dir())
            return
        }
    }
    println("usage: hexa run pe_ntdll_create_event_real.hexa { self-test | stats | event-kind <op_id> | count op <op_kind> | count event <event_kind> | cleanup | dir }")
}
