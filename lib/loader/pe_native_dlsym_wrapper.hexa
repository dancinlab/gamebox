// lib/loader/pe_native_dlsym_wrapper.hexa — stage4 macOS dlsym wrapper skeleton
//
// Win32 GetProcAddress → macOS dlsym 의 wrapper. handle + symbol name →
// function pointer (void*). PE IAT slot 에 fixup 될 주소.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   Apple dlsym(3) man page 만 참조.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// 본 파일은 instrumentation skeleton — 실 dlsym() syscall 은 stage5.
//
// persist schema (TSV — dlsym_calls.tsv):
//   call_id<int> \t handle_id<int> \t symbol_name_len<int> \t success<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pndsw_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_native_dlsym_wrapper"
}

fn pndsw_calls_path() -> str {
    return pndsw_dir() + "/dlsym_calls.tsv"
}

fn pndsw_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pndsw_dir() + "'")
}

fn cleanup_pndsw() -> void {
    pndsw_ensure_dir()
    let _ = exec("rm -f '" + pndsw_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pndsw_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pndsw_append_row(path: str, row: str) -> void {
    pndsw_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dlsym: dlsym 1건 기록 ───
//   stage5 에서 실 dlsym() syscall 로 교체.
fn record_dlsym(call_id: int, handle_id: int, symbol_name_len: int, success: int) -> void {
    if call_id <= 0 {
        panic("pe_native_dlsym_wrapper FAIL [record_dlsym] expected=call_id>0 got=" + to_string(call_id))
    }
    if handle_id <= 0 {
        panic("pe_native_dlsym_wrapper FAIL [record_dlsym] expected=handle_id>0 got=" + to_string(handle_id))
    }
    if symbol_name_len <= 0 {
        panic("pe_native_dlsym_wrapper FAIL [record_dlsym] expected=symbol_name_len>0 got=" + to_string(symbol_name_len))
    }
    if success < 0 {
        panic("pe_native_dlsym_wrapper FAIL [record_dlsym] expected=success>=0 got=" + to_string(success))
    }
    if success > 1 {
        panic("pe_native_dlsym_wrapper FAIL [record_dlsym] expected=success<=1 got=" + to_string(success))
    }
    let row = to_string(call_id) + "\t" + to_string(handle_id)
        + "\t" + to_string(symbol_name_len) + "\t" + to_string(success) + "\n"
    pndsw_append_row(pndsw_calls_path(), row)
}

// ─── dlsym_count: 총 dlsym 호출 수 ───
fn dlsym_count() -> int {
    let mut cnt = 0
    let t = pndsw_read_table(pndsw_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── success_count: success=1 호출 수 ───
fn success_count() -> int {
    let mut cnt = 0
    let t = pndsw_read_table(pndsw_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── fail_count: success=0 호출 수 ───
fn fail_count() -> int {
    let mut cnt = 0
    let t = pndsw_read_table(pndsw_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_symbol_bytes: symbol_name_len 합계 ───
fn total_symbol_bytes() -> int {
    let mut sum = 0
    let t = pndsw_read_table(pndsw_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── handle_dlsym_count: 특정 handle_id 의 dlsym 호출 수 ───
fn handle_dlsym_count(handle_id: int) -> int {
    let mut cnt = 0
    let t = pndsw_read_table(pndsw_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == handle_id {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── pndsw_stats: [dlsym_count, success_count, fail_count, total_symbol_bytes] ───
fn pndsw_stats() -> array {
    let mut out = []
    out.push(dlsym_count())
    out.push(success_count())
    out.push(fail_count())
    out.push(total_symbol_bytes())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pndsw-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pndsw()

    // 2. record 5 dlsym calls
    //    98001/1/16/1 — KERNEL32 "CreateFileA"
    record_dlsym(98001, 1, 16, 1)
    r0_emit("pe_native_dlsym_wrapper_call",
        "\"call_id\":98001,\"handle_id\":1,\"symbol_name_len\":16,\"success\":1,\"hint\":\"CreateFileA\"")

    //    98002/1/12/1 — KERNEL32 "CloseHandle"
    record_dlsym(98002, 1, 12, 1)
    r0_emit("pe_native_dlsym_wrapper_call",
        "\"call_id\":98002,\"handle_id\":1,\"symbol_name_len\":12,\"success\":1,\"hint\":\"CloseHandle\"")

    //    98003/2/14/1 — USER32 "MessageBoxW"
    record_dlsym(98003, 2, 14, 1)
    r0_emit("pe_native_dlsym_wrapper_call",
        "\"call_id\":98003,\"handle_id\":2,\"symbol_name_len\":14,\"success\":1,\"hint\":\"MessageBoxW\"")

    //    98004/1/22/0 — KERNEL32 "MissingFunctionXyz" — fail
    record_dlsym(98004, 1, 22, 0)
    r0_emit("pe_native_dlsym_wrapper_call",
        "\"call_id\":98004,\"handle_id\":1,\"symbol_name_len\":22,\"success\":0,\"hint\":\"MissingFunctionXyz\"")

    //    98005/1/8/1 — KERNEL32 "GetTime"
    record_dlsym(98005, 1, 8, 1)
    r0_emit("pe_native_dlsym_wrapper_call",
        "\"call_id\":98005,\"handle_id\":1,\"symbol_name_len\":8,\"success\":1,\"hint\":\"GetTime\"")

    // 3. dlsym_count = 5
    let dc = dlsym_count()
    if dc != 5 {
        panic("pe_native_dlsym_wrapper FAIL [dlsym_count] expected=5 got=" + to_string(dc))
    }

    // 4. success_count = 4
    let sc = success_count()
    if sc != 4 {
        panic("pe_native_dlsym_wrapper FAIL [success_count] expected=4 got=" + to_string(sc))
    }

    // 5. fail_count = 1
    let fc = fail_count()
    if fc != 1 {
        panic("pe_native_dlsym_wrapper FAIL [fail_count] expected=1 got=" + to_string(fc))
    }

    // 6. total_symbol_bytes = 16+12+14+22+8 = 72
    let tb = total_symbol_bytes()
    if tb != 72 {
        panic("pe_native_dlsym_wrapper FAIL [total_symbol_bytes] expected=72 got=" + to_string(tb))
    }

    // 7. handle_dlsym_count
    let h1 = handle_dlsym_count(1)
    if h1 != 4 {
        panic("pe_native_dlsym_wrapper FAIL [handle_dlsym_count(1)] expected=4 got=" + to_string(h1))
    }
    let h2 = handle_dlsym_count(2)
    if h2 != 1 {
        panic("pe_native_dlsym_wrapper FAIL [handle_dlsym_count(2)] expected=1 got=" + to_string(h2))
    }
    let h0 = handle_dlsym_count(9999)
    if h0 != 0 {
        panic("pe_native_dlsym_wrapper FAIL [handle_dlsym_count(9999)] expected=0 got=" + to_string(h0))
    }

    // 8. pndsw_stats() = [5, 4, 1, 72]
    let s = pndsw_stats()
    if len(s) != 4 {
        panic("pe_native_dlsym_wrapper FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_native_dlsym_wrapper FAIL [stats dlsym_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_native_dlsym_wrapper FAIL [stats success_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_native_dlsym_wrapper FAIL [stats fail_count] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 72 {
        panic("pe_native_dlsym_wrapper FAIL [stats total_symbol_bytes] expected=72 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_native_dlsym_wrapper_stats",
        "\"dlsym_count\":" + to_string(s[0])
        + ",\"success_count\":" + to_string(s[1])
        + ",\"fail_count\":" + to_string(s[2])
        + ",\"total_symbol_bytes\":" + to_string(s[3]))

    // 10. emit count >= 6 (실제: 5 calls + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_native_dlsym_wrapper FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pndsw()
    let s2 = pndsw_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_native_dlsym_wrapper FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_native_dlsym_wrapper self_test PASS (5 calls, success=" + to_string(s[1])
        + ", fail=" + to_string(s[2]) + ", bytes=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pndsw_stats()
            println("dlsym_count\t" + to_string(s[0]))
            println("success_count\t" + to_string(s[1]))
            println("fail_count\t" + to_string(s[2]))
            println("total_symbol_bytes\t" + to_string(s[3]))
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let hid = to_int(a[3])
                println("handle_dlsym_count(" + to_string(hid) + ")\t" + to_string(handle_dlsym_count(hid)))
                return
            }
            println("usage: hexa run pe_native_dlsym_wrapper.hexa count <handle_id>")
            return
        }
        if sub == "cleanup" {
            cleanup_pndsw()
            println("cleaned: " + pndsw_dir())
            return
        }
        if sub == "dir" {
            println(pndsw_dir())
            return
        }
    }
    println("usage: hexa run pe_native_dlsym_wrapper.hexa { self-test | stats | count <handle_id> | cleanup | dir }")
}
