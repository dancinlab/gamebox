// lib/loader/pe_d3d11_texture_create_real.hexa — cycle 81 R5 phase 2
//
// ID3D11Device::CreateTexture2D / CreateTexture3D 추적 module. host stage6
// 에서 native Metal MTLDevice newTextureWithDescriptor: 로 매핑되기 전,
// docker hexa 측에서 D3D11_TEXTURE2D_DESC / D3D11_TEXTURE3D_DESC 메타를
// row 단위로 누적 — texture_id, dxgi_format, dimension_kind, area_pixels.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 D3D11 texture metadata tracker — 실 ID3D11Device 호출 X.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// dxgi_format code (subset — MSDN DXGI_FORMAT 기반):
//   28 = DXGI_FORMAT_R8G8B8A8_UNORM
//   87 = DXGI_FORMAT_B8G8R8A8_UNORM
//   77 = DXGI_FORMAT_BC1_UNORM
//   98 = DXGI_FORMAT_BC7_UNORM
//   40 = DXGI_FORMAT_D32_FLOAT
//   45 = DXGI_FORMAT_D24_UNORM_S8_UINT
//
// dimension_kind code:
//   1 = 2d (D3D11_TEXTURE2D_DESC, ArraySize=1)
//   2 = 3d (D3D11_TEXTURE3D_DESC)
//   3 = cube (ArraySize=6 + D3D11_RESOURCE_MISC_TEXTURECUBE)
//   4 = array_2d (D3D11_TEXTURE2D_DESC, ArraySize>1)
//
// D3D11 CreateTexture2D/3D → Metal MTLTexture:
//   D3D11_TEXTURE2D_DESC + D3D11_TEXTURE3D_DESC → MTLTextureDescriptor
//   DXGI_FORMAT_R8G8B8A8_UNORM (28) → MTLPixelFormatRGBA8Unorm
//   DXGI_FORMAT_B8G8R8A8_UNORM (87) → MTLPixelFormatBGRA8Unorm
//   DXGI_FORMAT_BC1_UNORM (71)      → MTLPixelFormatBC1_RGBA (Apple Silicon support)
//   DXGI_FORMAT_BC7_UNORM (98)      → MTLPixelFormatBC7_RGBAUnorm
//   DXGI_FORMAT_D32_FLOAT           → MTLPixelFormatDepth32Float
//   DXGI_FORMAT_D24_UNORM_S8_UINT   → MTLPixelFormatDepth24Unorm_Stencil8 (M3+ only) or fallback
//   D3D11_TEXTURE2D_DESC.ArraySize  → MTLTextureType2DArray
//   D3D11 cubemap (ArraySize=6 + MISC_FLAG_TEXTURECUBE) → MTLTextureTypeCube
// own1: Apple Metal + MSDN DXGI_FORMAT spec only
//
// persist schema (TSV — textures.tsv):
//   texture_id<int> \t dxgi_format<int> \t dimension_kind<int> \t area_pixels<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdtc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3d11_texture_create_real"
}

fn pdtc_textures_path() -> str {
    return pdtc_dir() + "/textures.tsv"
}

fn pdtc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdtc_dir() + "'")
}

fn cleanup_pdtc() -> void {
    pdtc_ensure_dir()
    let _ = exec("rm -f '" + pdtc_textures_path() + "'")
}

// ─── 공통 file IO ───
fn pdtc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdtc_append_row(path: str, row: str) -> void {
    pdtc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_texture: D3D11 texture descriptor 1 건 기록 ───
fn record_texture(texture_id: int, dxgi_format: int, dimension_kind: int, area_pixels: int) -> void {
    if texture_id <= 0 {
        panic("pe_d3d11_texture_create_real FAIL [record_texture] expected=texture_id>0 got=" + to_string(texture_id))
    }
    if dxgi_format <= 0 {
        panic("pe_d3d11_texture_create_real FAIL [record_texture] expected=dxgi_format>0 got=" + to_string(dxgi_format))
    }
    if dimension_kind < 1 {
        panic("pe_d3d11_texture_create_real FAIL [record_texture] expected=dimension_kind>=1 got=" + to_string(dimension_kind))
    }
    if dimension_kind > 4 {
        panic("pe_d3d11_texture_create_real FAIL [record_texture] expected=dimension_kind<=4 got=" + to_string(dimension_kind))
    }
    if area_pixels <= 0 {
        panic("pe_d3d11_texture_create_real FAIL [record_texture] expected=area_pixels>0 got=" + to_string(area_pixels))
    }
    let row = to_string(texture_id) + "\t" + to_string(dxgi_format)
        + "\t" + to_string(dimension_kind) + "\t" + to_string(area_pixels) + "\n"
    pdtc_append_row(pdtc_textures_path(), row)
}

// ─── texture_count: total texture row 수 ───
fn texture_count() -> int {
    let t = pdtc_read_table(pdtc_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_area_pixels: 모든 texture area_pixels 합 ───
fn total_area_pixels() -> int {
    let t = pdtc_read_table(pdtc_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_dxgi_format: 특정 dxgi_format 의 texture 수 ───
fn count_by_dxgi_format(dxgi_format: int) -> int {
    let t = pdtc_read_table(pdtc_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == dxgi_format {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_dimension_kind: 특정 dimension_kind 의 texture 수 ───
fn count_by_dimension_kind(dimension_kind: int) -> int {
    let t = pdtc_read_table(pdtc_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == dimension_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── depth_stencil_count: D32_FLOAT(40) + D24_UNORM_S8_UINT(45) 합 ───
fn depth_stencil_count() -> int {
    return count_by_dxgi_format(40) + count_by_dxgi_format(45)
}

// ─── texture_area: 특정 texture_id 의 area_pixels (없으면 0) ───
fn texture_area(texture_id: int) -> int {
    let t = pdtc_read_table(pdtc_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == texture_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdtc_stats: [texture_count, total_area_pixels, depth_stencil_count, count_by_dimension_kind(1)] ───
fn pdtc_stats() -> array {
    let mut out = []
    out.push(texture_count())
    out.push(total_area_pixels())
    out.push(depth_stencil_count())
    out.push(count_by_dimension_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdtc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdtc()

    // 2. record 6 textures across ≥4 dxgi_formats and ≥3 dimension_kinds
    //    formats used: 28 (RGBA8), 87 (BGRA8), 77 (BC1), 98 (BC7), 40 (D32F), 45 (D24S8)  → 6 distinct
    //    dimensions used: 1 (2d), 2 (3d), 3 (cube), 4 (array_2d)                            → 4 distinct
    record_texture(810001, 28, 1, 1048576)   // 1024x1024 RGBA8 2d
    r0_emit("pe_d3d11_texture_create_real_record",
        "\"texture_id\":810001,\"dxgi_format\":28,\"dimension_kind\":1,\"area_pixels\":1048576,\"target\":\"RGBA8_2d\"")

    record_texture(810002, 87, 1, 524288)    // 1024x512 BGRA8 2d
    r0_emit("pe_d3d11_texture_create_real_record",
        "\"texture_id\":810002,\"dxgi_format\":87,\"dimension_kind\":1,\"area_pixels\":524288,\"target\":\"BGRA8_2d\"")

    record_texture(810003, 77, 4, 2097152)   // 1024x1024 BC1 array_2d (×2 slices)
    r0_emit("pe_d3d11_texture_create_real_record",
        "\"texture_id\":810003,\"dxgi_format\":77,\"dimension_kind\":4,\"area_pixels\":2097152,\"target\":\"BC1_array2d\"")

    record_texture(810004, 98, 3, 393216)    // 256x256 BC7 cube (×6 faces)
    r0_emit("pe_d3d11_texture_create_real_record",
        "\"texture_id\":810004,\"dxgi_format\":98,\"dimension_kind\":3,\"area_pixels\":393216,\"target\":\"BC7_cube\"")

    record_texture(810005, 40, 1, 2073600)   // 1920x1080 D32F depth 2d
    r0_emit("pe_d3d11_texture_create_real_record",
        "\"texture_id\":810005,\"dxgi_format\":40,\"dimension_kind\":1,\"area_pixels\":2073600,\"target\":\"D32F_2d\"")

    record_texture(810006, 45, 2, 16777216)  // 256x256x256 D24S8 3d (volume depth-stencil)
    r0_emit("pe_d3d11_texture_create_real_record",
        "\"texture_id\":810006,\"dxgi_format\":45,\"dimension_kind\":2,\"area_pixels\":16777216,\"target\":\"D24S8_3d\"")

    // 3. texture_count = 6
    let c = texture_count()
    if c != 6 {
        panic("pe_d3d11_texture_create_real FAIL [texture_count] expected=6 got=" + to_string(c))
    }

    // 4. total_area_pixels = 1048576 + 524288 + 2097152 + 393216 + 2073600 + 16777216 = 22914048
    let ta = total_area_pixels()
    if ta != 22914048 {
        panic("pe_d3d11_texture_create_real FAIL [total_area_pixels] expected=22914048 got=" + to_string(ta))
    }

    // 5. count_by_dxgi_format sanity (≥4 distinct formats)
    let f28 = count_by_dxgi_format(28)
    if f28 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dxgi_format(28)] expected=1 got=" + to_string(f28))
    }
    let f87 = count_by_dxgi_format(87)
    if f87 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dxgi_format(87)] expected=1 got=" + to_string(f87))
    }
    let f77 = count_by_dxgi_format(77)
    if f77 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dxgi_format(77)] expected=1 got=" + to_string(f77))
    }
    let f98 = count_by_dxgi_format(98)
    if f98 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dxgi_format(98)] expected=1 got=" + to_string(f98))
    }
    let f40 = count_by_dxgi_format(40)
    if f40 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dxgi_format(40)] expected=1 got=" + to_string(f40))
    }
    let f45 = count_by_dxgi_format(45)
    if f45 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dxgi_format(45)] expected=1 got=" + to_string(f45))
    }
    let f_miss = count_by_dxgi_format(999)
    if f_miss != 0 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dxgi_format(999)] expected=0 got=" + to_string(f_miss))
    }

    // 6. count_by_dimension_kind sanity (≥3 distinct dimension_kinds — 1,2,3,4)
    let d1 = count_by_dimension_kind(1)
    if d1 != 3 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dimension_kind(1)] expected=3 got=" + to_string(d1))
    }
    let d2 = count_by_dimension_kind(2)
    if d2 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dimension_kind(2)] expected=1 got=" + to_string(d2))
    }
    let d3 = count_by_dimension_kind(3)
    if d3 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dimension_kind(3)] expected=1 got=" + to_string(d3))
    }
    let d4 = count_by_dimension_kind(4)
    if d4 != 1 {
        panic("pe_d3d11_texture_create_real FAIL [count_by_dimension_kind(4)] expected=1 got=" + to_string(d4))
    }

    // 7. depth_stencil_count = f40(1) + f45(1) = 2
    let ds = depth_stencil_count()
    if ds != 2 {
        panic("pe_d3d11_texture_create_real FAIL [depth_stencil_count] expected=2 got=" + to_string(ds))
    }

    // 8. texture_area sanity
    let a3 = texture_area(810003)
    if a3 != 2097152 {
        panic("pe_d3d11_texture_create_real FAIL [texture_area(810003)] expected=2097152 got=" + to_string(a3))
    }
    let a5 = texture_area(810005)
    if a5 != 2073600 {
        panic("pe_d3d11_texture_create_real FAIL [texture_area(810005)] expected=2073600 got=" + to_string(a5))
    }
    let a_miss = texture_area(9999)
    if a_miss != 0 {
        panic("pe_d3d11_texture_create_real FAIL [texture_area(9999)] expected=0 got=" + to_string(a_miss))
    }

    // 9. pdtc_stats() = [6, 22914048, 2, 3]
    let s = pdtc_stats()
    if len(s) != 4 {
        panic("pe_d3d11_texture_create_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_d3d11_texture_create_real FAIL [stats texture_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 22914048 {
        panic("pe_d3d11_texture_create_real FAIL [stats total_area_pixels] expected=22914048 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_d3d11_texture_create_real FAIL [stats depth_stencil_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_d3d11_texture_create_real FAIL [stats dim2d_count] expected=3 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_d3d11_texture_create_real_stats",
        "\"texture_count\":" + to_string(s[0])
        + ",\"total_area_pixels\":" + to_string(s[1])
        + ",\"depth_stencil_count\":" + to_string(s[2])
        + ",\"dim2d_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_d3d11_texture_create_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdtc()
    let s2 = pdtc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d3d11_texture_create_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3d11_texture_create_real self_test PASS (textures=" + to_string(s[0])
        + ", area=" + to_string(s[1]) + ", depth_stencil=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdtc_stats()
            println("texture_count\t" + to_string(s[0]))
            println("total_area_pixels\t" + to_string(s[1]))
            println("depth_stencil_count\t" + to_string(s[2]))
            println("dim2d_count\t" + to_string(s[3]))
            return
        }
        if sub == "area" {
            if len(a) >= 4 {
                let tid = to_int(a[3])
                println("texture_area\t" + to_string(texture_area(tid)))
                return
            }
            println("usage: hexa run pe_d3d11_texture_create_real.hexa area <texture_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let which = a[3]
                let val = to_int(a[4])
                if which == "format" {
                    println("count_by_dxgi_format\t" + to_string(count_by_dxgi_format(val)))
                    return
                }
                if which == "dim" {
                    println("count_by_dimension_kind\t" + to_string(count_by_dimension_kind(val)))
                    return
                }
                println("usage: hexa run pe_d3d11_texture_create_real.hexa count { format <dxgi_format> | dim <dimension_kind> }")
                return
            }
            println("usage: hexa run pe_d3d11_texture_create_real.hexa count { format <dxgi_format> | dim <dimension_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pdtc()
            println("cleaned: " + pdtc_dir())
            return
        }
        if sub == "dir" {
            println(pdtc_dir())
            return
        }
    }
    println("usage: hexa run pe_d3d11_texture_create_real.hexa { self-test | stats | area <texture_id> | count format <dxgi_format> | count dim <dimension_kind> | cleanup | dir }")
}
