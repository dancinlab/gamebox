// lib/loader/pe_tls_init_real.hexa — cycle 80 R2 phase 1 PE TLS directory 실 초기화 skeleton
//
// PE TLS directory init:
//   IMAGE_TLS_DIRECTORY:
//     StartAddressOfRawData / EndOfRawData → TLS data block
//     AddressOfIndex → TLS slot index (DWORD*)
//     AddressOfCallBacks → null-terminated PIMAGE_TLS_CALLBACK array
//     SizeOfZeroFill / Characteristics
//   Win64 TEB:
//     gs:[0x58] → TLS array (PVOID[64])
//     gs:[0x60] → TLS expansion slots (PVOID[1024])
//   Apple-native 매핑: per-thread TLS 별도 영역 + signal trampoline 으로 fs/gs 모방
// own1: PE TLS spec + Apple pthread_key_create only
//
// cross-ref: cycle 72 pe_tls_callback_dispatch — init_kind 값은
// (1=process_attach / 2=thread_attach / 3=thread_detach / 4=process_detach)
// dispatch reason_kind 와 동일 의미를 공유한다 (DLL_*_ATTACH/DETACH).
//
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// init_kind code:
//   1 = process_attach   (DLL_PROCESS_ATTACH)
//   2 = thread_attach    (DLL_THREAD_ATTACH)
//   3 = thread_detach    (DLL_THREAD_DETACH)
//   4 = process_detach   (DLL_PROCESS_DETACH)
//
// persist schema (TSV — inits.tsv):
//   init_id<int> \t init_kind<int> \t tls_size_bytes<int> \t callback_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ptir_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_tls_init_real"
}

fn ptir_inits_path() -> str {
    return ptir_dir() + "/inits.tsv"
}

fn ptir_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ptir_dir() + "'")
}

fn cleanup_ptir() -> void {
    ptir_ensure_dir()
    let _ = exec("rm -f '" + ptir_inits_path() + "'")
}

// ─── 공통 file IO ───
fn ptir_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ptir_append_row(path: str, row: str) -> void {
    ptir_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_init: TLS init 1 건 기록 ───
fn record_init(init_id: int, init_kind: int, tls_size_bytes: int, callback_count: int) -> void {
    if init_id <= 0 {
        panic("pe_tls_init_real FAIL [record_init] expected=init_id>0 got=" + to_string(init_id))
    }
    if init_kind < 1 {
        panic("pe_tls_init_real FAIL [record_init] expected=init_kind>=1 got=" + to_string(init_kind))
    }
    if init_kind > 4 {
        panic("pe_tls_init_real FAIL [record_init] expected=init_kind<=4 got=" + to_string(init_kind))
    }
    if tls_size_bytes < 0 {
        panic("pe_tls_init_real FAIL [record_init] expected=tls_size_bytes>=0 got=" + to_string(tls_size_bytes))
    }
    if callback_count < 0 {
        panic("pe_tls_init_real FAIL [record_init] expected=callback_count>=0 got=" + to_string(callback_count))
    }
    let row = to_string(init_id) + "\t" + to_string(init_kind)
        + "\t" + to_string(tls_size_bytes) + "\t" + to_string(callback_count) + "\n"
    ptir_append_row(ptir_inits_path(), row)
}

// ─── init_count: total init 수 ───
fn init_count() -> int {
    let t = ptir_read_table(ptir_inits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_tls_size_bytes: 모든 init 의 tls_size_bytes 합 ───
fn total_tls_size_bytes() -> int {
    let t = ptir_read_table(ptir_inits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_callback_count: 모든 init 의 callback_count 합 ───
fn total_callback_count() -> int {
    let t = ptir_read_table(ptir_inits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_init_kind: 특정 init_kind 의 init 수 ───
fn count_by_init_kind(kind: int) -> int {
    let t = ptir_read_table(ptir_inits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── init_callback_count: 특정 init_id 의 callback_count (없으면 0) ───
fn init_callback_count(init_id: int) -> int {
    let t = ptir_read_table(ptir_inits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == init_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── ptir_stats: [init_count, total_tls_size_bytes, total_callback_count, count_by_init_kind(1)] ───
fn ptir_stats() -> array {
    let mut out = []
    out.push(init_count())
    out.push(total_tls_size_bytes())
    out.push(total_callback_count())
    out.push(count_by_init_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ptir-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ptir()

    // 2. record 5 inits covering all 4 init_kinds
    //    init_kind: 1=process_attach / 2=thread_attach / 3=thread_detach / 4=process_detach
    record_init(810001, 1, 4096, 3)
    r0_emit("pe_tls_init_real_record",
        "\"init_id\":810001,\"init_kind\":1,\"tls_size_bytes\":4096,\"callback_count\":3,\"target\":\"process_attach\"")

    record_init(810002, 2, 1024, 2)
    r0_emit("pe_tls_init_real_record",
        "\"init_id\":810002,\"init_kind\":2,\"tls_size_bytes\":1024,\"callback_count\":2,\"target\":\"thread_attach\"")

    record_init(810003, 2, 1024, 2)
    r0_emit("pe_tls_init_real_record",
        "\"init_id\":810003,\"init_kind\":2,\"tls_size_bytes\":1024,\"callback_count\":2,\"target\":\"thread_attach\"")

    record_init(810004, 3, 0, 1)
    r0_emit("pe_tls_init_real_record",
        "\"init_id\":810004,\"init_kind\":3,\"tls_size_bytes\":0,\"callback_count\":1,\"target\":\"thread_detach\"")

    record_init(810005, 4, 0, 1)
    r0_emit("pe_tls_init_real_record",
        "\"init_id\":810005,\"init_kind\":4,\"tls_size_bytes\":0,\"callback_count\":1,\"target\":\"process_detach\"")

    // 3. init_count = 5
    let c = init_count()
    if c != 5 {
        panic("pe_tls_init_real FAIL [init_count] expected=5 got=" + to_string(c))
    }

    // 4. total_tls_size_bytes = 4096 + 1024 + 1024 + 0 + 0 = 6144
    let tb = total_tls_size_bytes()
    if tb != 6144 {
        panic("pe_tls_init_real FAIL [total_tls_size_bytes] expected=6144 got=" + to_string(tb))
    }

    // 5. total_callback_count = 3 + 2 + 2 + 1 + 1 = 9
    let tc = total_callback_count()
    if tc != 9 {
        panic("pe_tls_init_real FAIL [total_callback_count] expected=9 got=" + to_string(tc))
    }

    // 6. count_by_init_kind sanity (all 4 kinds covered)
    let k1 = count_by_init_kind(1)
    if k1 != 1 {
        panic("pe_tls_init_real FAIL [count_by_init_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_init_kind(2)
    if k2 != 2 {
        panic("pe_tls_init_real FAIL [count_by_init_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_init_kind(3)
    if k3 != 1 {
        panic("pe_tls_init_real FAIL [count_by_init_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_init_kind(4)
    if k4 != 1 {
        panic("pe_tls_init_real FAIL [count_by_init_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_init_kind(99)
    if k99 != 0 {
        panic("pe_tls_init_real FAIL [count_by_init_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. init_callback_count sanity
    let cb1 = init_callback_count(810001)
    if cb1 != 3 {
        panic("pe_tls_init_real FAIL [init_callback_count(810001)] expected=3 got=" + to_string(cb1))
    }
    let cb2 = init_callback_count(810002)
    if cb2 != 2 {
        panic("pe_tls_init_real FAIL [init_callback_count(810002)] expected=2 got=" + to_string(cb2))
    }
    let cb_miss = init_callback_count(9999)
    if cb_miss != 0 {
        panic("pe_tls_init_real FAIL [init_callback_count(9999)] expected=0 got=" + to_string(cb_miss))
    }

    // 8. ptir_stats() = [5, 6144, 9, 1]
    let s = ptir_stats()
    if len(s) != 4 {
        panic("pe_tls_init_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_tls_init_real FAIL [stats init_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 6144 {
        panic("pe_tls_init_real FAIL [stats total_tls_size_bytes] expected=6144 got=" + to_string(s[1]))
    }
    if s[2] != 9 {
        panic("pe_tls_init_real FAIL [stats total_callback_count] expected=9 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_tls_init_real FAIL [stats count_kind(1)] expected=1 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_tls_init_real_stats",
        "\"init_count\":" + to_string(s[0])
        + ",\"total_tls_size_bytes\":" + to_string(s[1])
        + ",\"total_callback_count\":" + to_string(s[2])
        + ",\"kind_process_attach\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_tls_init_real FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_ptir()
    let s2 = ptir_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_tls_init_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_tls_init_real self_test PASS (inits=" + to_string(s[0])
        + ", tls_bytes=" + to_string(s[1]) + ", callbacks=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ptir_stats()
            println("init_count\t" + to_string(s[0]))
            println("total_tls_size_bytes\t" + to_string(s[1]))
            println("total_callback_count\t" + to_string(s[2]))
            println("count_kind_process_attach\t" + to_string(s[3]))
            return
        }
        if sub == "callbacks" {
            if len(a) >= 4 {
                let iid = to_int(a[3])
                println("init_callback_count\t" + to_string(init_callback_count(iid)))
                return
            }
            println("usage: hexa run pe_tls_init_real.hexa callbacks <init_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_init_kind\t" + to_string(count_by_init_kind(kind)))
                return
            }
            println("usage: hexa run pe_tls_init_real.hexa count <init_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ptir()
            println("cleaned: " + ptir_dir())
            return
        }
        if sub == "dir" {
            println(ptir_dir())
            return
        }
    }
    println("usage: hexa run pe_tls_init_real.hexa { self-test | stats | callbacks <init_id> | count <init_kind> | cleanup | dir }")
}
