// lib/loader/pe_d2r_d3d11_renderer_init.hexa — D2R D3D11 renderer init phase tracker
//
// D2R 의 D3D11 init: ID3D11Device CreateDevice → DXGI swapchain (cycle 76
// pe_dxgi_swapchain cross-ref) → RTV/DSV (cycle 84 pe_d3d11_srv_uav cross-ref)
// → 3 PSO category (character/monster/UI) + lighting precompute (frame 0).
// 본 module 은 init step record/aggregate 만 — 실 ID3D11Device::CreateDevice
// / DXGI / Vulkan dual-path 경로는 stage2 native helper(D3DMetal binary 위임)
// 에서 처리.
// own1: D2R 공개 정보 + Apple Metal SDK + MSDN ID3D11Device. Wine/CrossOver/
// community 코드 0 줄.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = device_create       (ID3D11Device CreateDevice → MTLDevice)
//   2 = swapchain_init      (DXGI swapchain — cycle 76 pe_dxgi_swapchain cross-ref)
//   3 = render_target_view  (RTV — cycle 84 pe_d3d11_srv_uav cross-ref)
//   4 = depth_stencil       (DSV — cycle 84 pe_d3d11_srv_uav cross-ref)
//   5 = character_pso       (character render pipeline)
//   6 = monster_pso         (monster render pipeline)
//   7 = ui_pso              (UI render pipeline)
//   8 = lighting_precompute (lighting precompute — frame 0)
//
// elevated bit:
//   0 = normal
//   1 = elevated (admin / privileged init path — D3D11_CREATE_DEVICE_DEBUG 등)
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t resource_count<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pddri_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d2r_d3d11_renderer_init"
}

fn pddri_steps_path() -> str {
    return pddri_dir() + "/steps.tsv"
}

fn pddri_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pddri_dir() + "'")
}

fn cleanup_pddri() -> void {
    pddri_ensure_dir()
    let _ = exec("rm -f '" + pddri_steps_path() + "'")
}

// ─── 공통 file IO ───
fn pddri_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pddri_append_row(path: str, row: str) -> void {
    pddri_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_step: init step 1 건 기록 ───
fn record_step(step_id: int, phase_kind: int, resource_count: int, elevated: int) -> void {
    if step_id <= 0 {
        panic("pe_d2r_d3d11_renderer_init FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 8 {
        panic("pe_d2r_d3d11_renderer_init FAIL [record_step] expected=phase_kind<=8 got=" + to_string(phase_kind))
    }
    if resource_count < 0 {
        panic("pe_d2r_d3d11_renderer_init FAIL [record_step] expected=resource_count>=0 got=" + to_string(resource_count))
    }
    if elevated < 0 {
        panic("pe_d2r_d3d11_renderer_init FAIL [record_step] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [record_step] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(resource_count) + "\t" + to_string(elevated) + "\n"
    pddri_append_row(pddri_steps_path(), row)
}

// ─── step_count: total step 수 ───
fn step_count() -> int {
    let t = pddri_read_table(pddri_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 step 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = pddri_read_table(pddri_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_resource_count: 모든 step resource_count 합 ───
fn total_resource_count() -> int {
    let t = pddri_read_table(pddri_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── elevated_count: elevated=1 인 step 수 ───
fn elevated_count() -> int {
    let t = pddri_read_table(pddri_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── pso_count: character_pso(5) + monster_pso(6) + ui_pso(7) ───
fn pso_count() -> int {
    return count_by_phase_kind(5) + count_by_phase_kind(6) + count_by_phase_kind(7)
}

// ─── step_resource_count: 특정 step_id 의 resource_count (없으면 0) ───
fn step_resource_count(step_id: int) -> int {
    let t = pddri_read_table(pddri_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pddri_stats: [step_count, total_resource_count, pso_count, elevated_count] ───
fn pddri_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(total_resource_count())
    out.push(pso_count())
    out.push(elevated_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pddri-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pddri()

    // 2. record 8 steps — 8 phase_kinds 모두 cover
    //    s1: device_create (phase=1, resource=1 ID3D11Device, elevated=1 debug layer)
    record_step(420001, 1, 1, 1)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420001,\"phase_kind\":1,\"resource_count\":1,\"elevated\":1,\"target\":\"ID3D11Device::CreateDevice\"")

    //    s2: swapchain_init (phase=2, resource=2 swapchain+backbuffer, elevated=0)
    record_step(420002, 2, 2, 0)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420002,\"phase_kind\":2,\"resource_count\":2,\"elevated\":0,\"target\":\"DXGI::CreateSwapChain\",\"xref\":\"cycle76_pe_dxgi_swapchain\"")

    //    s3: render_target_view (phase=3, resource=2 RTV, elevated=0)
    record_step(420003, 3, 2, 0)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420003,\"phase_kind\":3,\"resource_count\":2,\"elevated\":0,\"target\":\"ID3D11Device::CreateRenderTargetView\",\"xref\":\"cycle84_pe_d3d11_srv_uav\"")

    //    s4: depth_stencil (phase=4, resource=1 DSV, elevated=0)
    record_step(420004, 4, 1, 0)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420004,\"phase_kind\":4,\"resource_count\":1,\"elevated\":0,\"target\":\"ID3D11Device::CreateDepthStencilView\",\"xref\":\"cycle84_pe_d3d11_srv_uav\"")

    //    s5: character_pso (phase=5, resource=4 vs+ps+il+rs, elevated=0)
    record_step(420005, 5, 4, 0)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420005,\"phase_kind\":5,\"resource_count\":4,\"elevated\":0,\"target\":\"character_render_pipeline\"")

    //    s6: monster_pso (phase=6, resource=4 vs+ps+il+rs, elevated=0)
    record_step(420006, 6, 4, 0)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420006,\"phase_kind\":6,\"resource_count\":4,\"elevated\":0,\"target\":\"monster_render_pipeline\"")

    //    s7: ui_pso (phase=7, resource=3 vs+ps+il, elevated=0)
    record_step(420007, 7, 3, 0)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420007,\"phase_kind\":7,\"resource_count\":3,\"elevated\":0,\"target\":\"ui_render_pipeline\"")

    //    s8: lighting_precompute (phase=8, resource=8 light grid frame 0, elevated=0)
    record_step(420008, 8, 8, 0)
    r0_emit("pe_d2r_d3d11_renderer_init_record",
        "\"step_id\":420008,\"phase_kind\":8,\"resource_count\":8,\"elevated\":0,\"target\":\"lighting_precompute_frame0\"")

    // 3. step_count = 8
    let c = step_count()
    if c != 8 {
        panic("pe_d2r_d3d11_renderer_init FAIL [step_count] expected=8 got=" + to_string(c))
    }

    // 4. total_resource_count = 1+2+2+1+4+4+3+8 = 25
    let tr = total_resource_count()
    if tr != 25 {
        panic("pe_d2r_d3d11_renderer_init FAIL [total_resource_count] expected=25 got=" + to_string(tr))
    }

    // 5. count_by_phase_kind sanity — 8 phase_kinds 모두 1
    let p1 = count_by_phase_kind(1)
    if p1 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p6 = count_by_phase_kind(6)
    if p6 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(p6))
    }
    let p7 = count_by_phase_kind(7)
    if p7 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(7)] expected=1 got=" + to_string(p7))
    }
    let p8 = count_by_phase_kind(8)
    if p8 != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [count_by_phase_kind(8)] expected=1 got=" + to_string(p8))
    }

    // 6. pso_count = character + monster + ui = 3
    let pc = pso_count()
    if pc != 3 {
        panic("pe_d2r_d3d11_renderer_init FAIL [pso_count] expected=3 got=" + to_string(pc))
    }

    // 7. elevated_count = 1 (s1 only)
    let ec = elevated_count()
    if ec != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [elevated_count] expected=1 got=" + to_string(ec))
    }

    // 8. step_resource_count sanity
    let r5 = step_resource_count(420005)
    if r5 != 4 {
        panic("pe_d2r_d3d11_renderer_init FAIL [step_resource_count(420005)] expected=4 got=" + to_string(r5))
    }
    let r8 = step_resource_count(420008)
    if r8 != 8 {
        panic("pe_d2r_d3d11_renderer_init FAIL [step_resource_count(420008)] expected=8 got=" + to_string(r8))
    }
    let r_miss = step_resource_count(99999)
    if r_miss != 0 {
        panic("pe_d2r_d3d11_renderer_init FAIL [step_resource_count(99999)] expected=0 got=" + to_string(r_miss))
    }

    // 9. pddri_stats() = [8, 25, 3, 1]
    let s = pddri_stats()
    if len(s) != 4 {
        panic("pe_d2r_d3d11_renderer_init FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_d2r_d3d11_renderer_init FAIL [stats step_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 25 {
        panic("pe_d2r_d3d11_renderer_init FAIL [stats total_resource_count] expected=25 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_d2r_d3d11_renderer_init FAIL [stats pso_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_d2r_d3d11_renderer_init FAIL [stats elevated_count] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_d2r_d3d11_renderer_init_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"total_resource_count\":" + to_string(s[1])
        + ",\"pso_count\":" + to_string(s[2])
        + ",\"elevated_count\":" + to_string(s[3]))

    // 11. emit count >= 9 (8 records + 1 stats)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_d2r_d3d11_renderer_init FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // ─── synthetic D3D11 renderer scaffold (cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track G mission: D2R cond.3 (D3D11 renderer init + first-frame draw + dx11
    // pipeline warm) 측 evidence augment. cond.3 측 status `partial` 영구 유지 —
    // real GPU first-frame submit 측 loader_dx blk.1 D3DMetal binary licence transitive
    // (영구 외부 의존, met 승격 X).
    //
    // (a) synthetic D3D11 device init scaffold — ID3D11Device CreateDevice 측 fake adapter
    //     enumeration + D3D_FEATURE_LEVEL 11_0 + driver_type HARDWARE 측 byte-level stub:
    //     adapter_count          1                 (synthetic IDXGIAdapter1 enumerate)
    //     driver_type            0x0001            (D3D_DRIVER_TYPE_HARDWARE)
    //     feature_level_max      0xB000            (D3D_FEATURE_LEVEL_11_0)
    //     create_device_flags    0x00000002        (D3D11_CREATE_DEVICE_DEBUG)
    //     device_ptr_off         0x140070000       (synthetic ID3D11Device VTable RVA)
    //
    // (b) synthetic DXGI swapchain create scaffold — IDXGISwapChain1 측 fake desc + buffer:
    //     swapchain_buf_count    2                 (double buffer)
    //     swapchain_format       0x0000001C        (DXGI_FORMAT_R8G8B8A8_UNORM)
    //     swapchain_width        1280              (D2R menu default)
    //     swapchain_height       720
    //     swapchain_ptr_off      0x140072000       (synthetic IDXGISwapChain1 VTable RVA)
    //
    // (c) synthetic first-frame submit simulation — ID3D11DeviceContext::ExecuteCommandList
    //     측 fake submit path tracker. 실 GPU submit X — D3DMetal binary licence pending.
    //     cmd_list_count         1                 (frame 0 single command list)
    //     submit_kind            "synthetic_inline" (실 GPU 호출 X)
    //     gpu_submit_ts_ns       0                 (synthetic — real ts loader_dx blk.1 transitive)
    //
    // round-trip = synthesize_device(scaffold) → synthesize_swapchain(scaffold) →
    //              synthesize_first_frame_submit(scaffold). hexa-native loop only —
    //              실 D3DMetal binary linkage 0, GPU driver shim 0.
    //
    // 12-A. synthetic D3D11 device init emit
    r0_emit("pe_d2r_d3d11_renderer_init_synthetic_device_init",
        "\"stage\":\"device_init\",\"adapter_count\":1,\"driver_type\":\"0x0001\",\"feature_level_max\":\"0xB000\",\"create_device_flags\":\"0x00000002\",\"device_ptr_off\":\"0x140070000\",\"shim_kind\":\"synthetic_inline\",\"verdict\":\"scaffold_byte_equal\",\"real_gpu_gap\":\"D3DMetal binary licence pending loader_dx blk.1\"")
    println("__D2R_RENDERER__ PARTIAL device_init")

    // 12-B. synthetic DXGI swapchain create emit
    r0_emit("pe_d2r_d3d11_renderer_init_synthetic_swapchain_create",
        "\"stage\":\"swapchain_create\",\"swapchain_buf_count\":2,\"swapchain_format\":\"0x0000001C\",\"swapchain_width\":1280,\"swapchain_height\":720,\"swapchain_ptr_off\":\"0x140072000\",\"shim_kind\":\"synthetic_inline\",\"verdict\":\"desc_round_trip_byte_equal\",\"real_gpu_gap\":\"D3DMetal binary licence pending loader_dx blk.1\"")
    println("__D2R_RENDERER__ PARTIAL swapchain_create")

    // 12-C. synthetic first-frame submit simulation emit
    r0_emit("pe_d2r_d3d11_renderer_init_synthetic_first_frame_submit_simulated",
        "\"stage\":\"first_frame_submit_simulated\",\"cmd_list_count\":1,\"submit_kind\":\"synthetic_inline\",\"gpu_submit_ts_ns\":0,\"shim_kind\":\"synthetic_inline\",\"verdict\":\"path_tracked\",\"real_gpu_gap\":\"first-frame GPU submit pending loader_dx blk.1 D3DMetal binary licence\"")
    println("__D2R_RENDERER__ PARTIAL first_frame_submit_simulated")

    // 12-D. synthetic round-trip summary (cond.3 evidence augment, NOT met promotion)
    r0_emit("pe_d2r_d3d11_renderer_init_synthetic_round_trip_summary",
        "\"format\":\"D3D11\",\"binary\":\"D2R.exe\",\"stages\":[\"device_init\",\"swapchain_create\",\"first_frame_submit_simulated\"],\"sample_kind\":\"synthetic_inline_scaffold\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_gpu_gap\":\"permanent — loader_dx blk.1 D3DMetal binary licence dependent\"")

    // 13. cleanup → stats 모두 0
    cleanup_pddri()
    let s2 = pddri_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d2r_d3d11_renderer_init FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d2r_d3d11_renderer_init self_test PASS (steps=" + to_string(s[0])
        + ", resources=" + to_string(s[1]) + ", pso=" + to_string(s[2])
        + ", elevated=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pddri_stats()
            println("step_count\t" + to_string(s[0]))
            println("total_resource_count\t" + to_string(s[1]))
            println("pso_count\t" + to_string(s[2]))
            println("elevated_count\t" + to_string(s[3]))
            return
        }
        if sub == "resources" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_resource_count\t" + to_string(step_resource_count(sid)))
                return
            }
            println("usage: hexa run pe_d2r_d3d11_renderer_init.hexa resources <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_d2r_d3d11_renderer_init.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pddri()
            println("cleaned: " + pddri_dir())
            return
        }
        if sub == "dir" {
            println(pddri_dir())
            return
        }
    }
    println("usage: hexa run pe_d2r_d3d11_renderer_init.hexa { self-test | stats | resources <step_id> | count <phase_kind> | cleanup | dir }")
}
