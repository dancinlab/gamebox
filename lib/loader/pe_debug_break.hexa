// lib/loader/pe_debug_break.hexa — cycle 70 debug break instruction telemetry
//
// PE binaries 안에 박힌 anti-debug 패턴 (int3, __debugbreak(), DebugBreak() API,
// icebp/INT1, arm64 BRK #0xF000) 이 trigger 될 때 마다 본 module 이 break_id /
// break_kind / debugger_present / caller_rip_kb 를 1 행씩 누적. 실 SEH/exception
// handler 등록은 cycle 71 stage 에서 — 여기서는 detection event tracker 로만 동작.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 break event tracker — 실 vectored exception handler 설치 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// break_kind code:
//   1 = int3 (0xCC) inline
//   2 = debugbreak_api (kernel32!DebugBreak / __debugbreak intrinsic)
//   3 = icebp / INT1 (0xF1)
//   4 = arm64 BRK #0xF000 (Rosetta translation 대상)
//
// persist schema (TSV — breaks.tsv):
//   break_id<int> \t break_kind<int> \t debugger_present<int> \t caller_rip_kb<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdb_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_debug_break"
}

fn pdb_breaks_path() -> str {
    return pdb_dir() + "/breaks.tsv"
}

fn pdb_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdb_dir() + "'")
}

fn cleanup_pdb() -> void {
    pdb_ensure_dir()
    let _ = exec("rm -f '" + pdb_breaks_path() + "'")
}

// ─── 공통 file IO ───
fn pdb_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdb_append_row(path: str, row: str) -> void {
    pdb_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_break: break event 1 건 기록 ───
fn record_break(break_id: int, break_kind: int, debugger_present: int, caller_rip_kb: int) -> void {
    if break_id <= 0 {
        panic("pe_debug_break FAIL [record_break] expected=break_id>0 got=" + to_string(break_id))
    }
    if break_kind < 1 {
        panic("pe_debug_break FAIL [record_break] expected=break_kind>=1 got=" + to_string(break_kind))
    }
    if break_kind > 4 {
        panic("pe_debug_break FAIL [record_break] expected=break_kind<=4 got=" + to_string(break_kind))
    }
    if debugger_present < 0 {
        panic("pe_debug_break FAIL [record_break] expected=debugger_present>=0 got=" + to_string(debugger_present))
    }
    if debugger_present > 1 {
        panic("pe_debug_break FAIL [record_break] expected=debugger_present<=1 got=" + to_string(debugger_present))
    }
    if caller_rip_kb < 0 {
        panic("pe_debug_break FAIL [record_break] expected=caller_rip_kb>=0 got=" + to_string(caller_rip_kb))
    }
    let row = to_string(break_id) + "\t" + to_string(break_kind)
        + "\t" + to_string(debugger_present) + "\t" + to_string(caller_rip_kb) + "\n"
    pdb_append_row(pdb_breaks_path(), row)
}

// ─── break_count: total break event 수 ───
fn break_count() -> int {
    let t = pdb_read_table(pdb_breaks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_kind: 특정 break_kind event 수 ───
fn count_by_kind(kind: int) -> int {
    let t = pdb_read_table(pdb_breaks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── debugger_present_count: debugger_present=1 인 event 수 ───
fn debugger_present_count() -> int {
    let t = pdb_read_table(pdb_breaks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_callers: 고유 caller_rip_kb 수 ───
fn distinct_callers() -> int {
    let t = pdb_read_table(pdb_breaks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let rip = to_int(parts[3])
                let mut found = 0
                let j = 0
                while j < len(seen) {
                    if seen[j] == rip {
                        found = 1
                    }
                    j = j + 1
                }
                if found == 0 {
                    seen.push(rip)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── break_caller_kb: 특정 break_id 의 caller_rip_kb (없으면 0) ───
fn break_caller_kb(break_id: int) -> int {
    let t = pdb_read_table(pdb_breaks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == break_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdb_stats: [break_count, debugger_present_count, distinct_callers, count_by_kind(1)] ───
fn pdb_stats() -> array {
    let mut out = []
    out.push(break_count())
    out.push(debugger_present_count())
    out.push(distinct_callers())
    out.push(count_by_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdb-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdb()

    // 2. record 5 breaks across ≥3 kinds, with ≥2 debugger_present
    record_break(170001, 1, 0, 4096)
    r0_emit("pe_debug_break_record",
        "\"break_id\":170001,\"break_kind\":1,\"debugger_present\":0,\"caller_rip_kb\":4096,\"target\":\"int3\"")

    record_break(170002, 1, 1, 4100)
    r0_emit("pe_debug_break_record",
        "\"break_id\":170002,\"break_kind\":1,\"debugger_present\":1,\"caller_rip_kb\":4100,\"target\":\"int3\"")

    record_break(170003, 2, 1, 8192)
    r0_emit("pe_debug_break_record",
        "\"break_id\":170003,\"break_kind\":2,\"debugger_present\":1,\"caller_rip_kb\":8192,\"target\":\"debugbreak_api\"")

    record_break(170004, 3, 0, 8192)
    r0_emit("pe_debug_break_record",
        "\"break_id\":170004,\"break_kind\":3,\"debugger_present\":0,\"caller_rip_kb\":8192,\"target\":\"icebp\"")

    record_break(170005, 4, 0, 16384)
    r0_emit("pe_debug_break_record",
        "\"break_id\":170005,\"break_kind\":4,\"debugger_present\":0,\"caller_rip_kb\":16384,\"target\":\"arm64_brk\"")

    // 3. break_count = 5
    let c = break_count()
    if c != 5 {
        panic("pe_debug_break FAIL [break_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_kind sanity (1=int3 ×2, 2=api ×1, 3=icebp ×1, 4=arm64 ×1, 99=0)
    let k1 = count_by_kind(1)
    if k1 != 2 {
        panic("pe_debug_break FAIL [count_by_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_kind(2)
    if k2 != 1 {
        panic("pe_debug_break FAIL [count_by_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_kind(3)
    if k3 != 1 {
        panic("pe_debug_break FAIL [count_by_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_kind(4)
    if k4 != 1 {
        panic("pe_debug_break FAIL [count_by_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_kind(99)
    if k99 != 0 {
        panic("pe_debug_break FAIL [count_by_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 5. debugger_present_count = 2
    let dp = debugger_present_count()
    if dp != 2 {
        panic("pe_debug_break FAIL [debugger_present_count] expected=2 got=" + to_string(dp))
    }

    // 6. distinct_callers = 4 (4096, 4100, 8192, 16384)
    let dc = distinct_callers()
    if dc != 4 {
        panic("pe_debug_break FAIL [distinct_callers] expected=4 got=" + to_string(dc))
    }

    // 7. break_caller_kb sanity
    let r2 = break_caller_kb(170002)
    if r2 != 4100 {
        panic("pe_debug_break FAIL [break_caller_kb(170002)] expected=4100 got=" + to_string(r2))
    }
    let r5 = break_caller_kb(170005)
    if r5 != 16384 {
        panic("pe_debug_break FAIL [break_caller_kb(170005)] expected=16384 got=" + to_string(r5))
    }
    let r_miss = break_caller_kb(9999)
    if r_miss != 0 {
        panic("pe_debug_break FAIL [break_caller_kb(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 8. pdb_stats() = [5, 2, 4, 2]
    let s = pdb_stats()
    if len(s) != 4 {
        panic("pe_debug_break FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_debug_break FAIL [stats break_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_debug_break FAIL [stats debugger_present_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_debug_break FAIL [stats distinct_callers] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_debug_break FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_debug_break_stats",
        "\"break_count\":" + to_string(s[0])
        + ",\"debugger_present_count\":" + to_string(s[1])
        + ",\"distinct_callers\":" + to_string(s[2])
        + ",\"kind_int3\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_debug_break FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdb()
    let s2 = pdb_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_debug_break FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_debug_break self_test PASS (breaks=" + to_string(s[0])
        + ", dbg=" + to_string(s[1]) + ", callers=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdb_stats()
            println("break_count\t" + to_string(s[0]))
            println("debugger_present_count\t" + to_string(s[1]))
            println("distinct_callers\t" + to_string(s[2]))
            println("count_kind_int3\t" + to_string(s[3]))
            return
        }
        if sub == "caller" {
            if len(a) >= 4 {
                let bid = to_int(a[3])
                println("break_caller_kb\t" + to_string(break_caller_kb(bid)))
                return
            }
            println("usage: hexa run pe_debug_break.hexa caller <break_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_kind\t" + to_string(count_by_kind(kind)))
                return
            }
            println("usage: hexa run pe_debug_break.hexa count <break_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdb()
            println("cleaned: " + pdb_dir())
            return
        }
        if sub == "dir" {
            println(pdb_dir())
            return
        }
    }
    println("usage: hexa run pe_debug_break.hexa { self-test | stats | caller <break_id> | count <break_kind> | cleanup | dir }")
}
