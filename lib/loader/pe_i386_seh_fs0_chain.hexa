// lib/loader/pe_i386_seh_fs0_chain.hexa — i386 SEH FS:[0] EXCEPTION_REGISTRATION_RECORD chain telemetry
//
// i386 SEH = FS:[0] → EXCEPTION_REGISTRATION_RECORD { Prev, Handler } singly-linked list
// (per-thread, 8 byte struct: 4 byte Prev pointer + 4 byte Handler pointer). x64 = .pdata
// table directory + RUNTIME_FUNCTION table-based handler (cycle 84 pe_seh_x64_pdata_walker
// cross-ref) — 본 module 은 i386 전용 chain depth tracker. unwind = walk Prev chain,
// call Handler. Apple-native FS register 합성 = per-thread fake segment (실제 FS write
// 없이 emulator 가 chain head 를 thread-local 로 관리). 본 module 은 chain frame
// telemetry — frame_id / prev_offset / handler_offset / depth 누적.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄. 본 module 은 i386 SEH spec
//   기반 chain depth tracker — 실 FS:[0] write / EXCEPTION_REGISTRATION_RECORD 실 link
//   호출 X (cycle80+). own1: i386 SEH spec.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// frame schema:
//   prev_offset = -1  → FS:[0] head (sentinel — chain 의 가장 바깥쪽 frame)
//   prev_offset >= 0  → 이전 EXCEPTION_REGISTRATION_RECORD 의 stack offset
//   handler_offset    → __except / __finally handler 의 code offset
//   depth             → FS:[0] head 부터의 chain depth (0 = head)
//
// persist schema (TSV — frames.tsv):
//   frame_id<int> \t prev_offset<int> \t handler_offset<int> \t depth<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pisfc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_i386_seh_fs0_chain"
}

fn pisfc_frames_path() -> str {
    return pisfc_dir() + "/frames.tsv"
}

fn pisfc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pisfc_dir() + "'")
}

fn cleanup_pisfc() -> void {
    pisfc_ensure_dir()
    let _ = exec("rm -f '" + pisfc_frames_path() + "'")
}

// ─── 공통 file IO ───
fn pisfc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pisfc_append_row(path: str, row: str) -> void {
    pisfc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_frame: i386 SEH chain frame 1 건 기록 ───
fn record_frame(frame_id: int, prev_offset: int, handler_offset: int, depth: int) -> void {
    if frame_id <= 0 {
        panic("pe_i386_seh_fs0_chain FAIL [record_frame] expected=frame_id>0 got=" + to_string(frame_id))
    }
    if prev_offset < -1 {
        panic("pe_i386_seh_fs0_chain FAIL [record_frame] expected=prev_offset>=-1 got=" + to_string(prev_offset))
    }
    if handler_offset < 0 {
        panic("pe_i386_seh_fs0_chain FAIL [record_frame] expected=handler_offset>=0 got=" + to_string(handler_offset))
    }
    if depth < 0 {
        panic("pe_i386_seh_fs0_chain FAIL [record_frame] expected=depth>=0 got=" + to_string(depth))
    }
    let row = to_string(frame_id) + "\t" + to_string(prev_offset)
        + "\t" + to_string(handler_offset) + "\t" + to_string(depth) + "\n"
    pisfc_append_row(pisfc_frames_path(), row)
}

// ─── frame_count: total frame 수 ───
fn frame_count() -> int {
    let t = pisfc_read_table(pisfc_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_depth: 모든 frame depth 합 ───
fn total_depth() -> int {
    let t = pisfc_read_table(pisfc_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── max_depth: chain 의 최대 depth ───
fn max_depth() -> int {
    let t = pisfc_read_table(pisfc_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut m = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let d = to_int(parts[3])
                if d > m {
                    m = d
                }
            }
        }
        i = i + 1
    }
    return m
}

// ─── count_by_handler_offset: 특정 handler_offset 의 frame 수 ───
fn count_by_handler_offset(ho: int) -> int {
    let t = pisfc_read_table(pisfc_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == ho {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── head_frame_count: prev_offset == -1 (FS:[0] head sentinel) frame 수 ───
fn head_frame_count() -> int {
    let t = pisfc_read_table(pisfc_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == -1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── frame_depth: 특정 frame_id 의 depth (없으면 -1) ───
fn frame_depth(frame_id: int) -> int {
    let t = pisfc_read_table(pisfc_frames_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == frame_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pisfc_stats: [frame_count, total_depth, max_depth, head_frame_count] ───
fn pisfc_stats() -> array {
    let mut out = []
    out.push(frame_count())
    out.push(total_depth())
    out.push(max_depth())
    out.push(head_frame_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pisfc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pisfc()

    // 2. record 5 frames forming chain depth 0..4
    //    frame 1 = head (prev=-1, depth=0)
    //    frame 2 → prev=frame1.offset, depth=1
    //    frame 3 → prev=frame2.offset, depth=2
    //    frame 4 → prev=frame3.offset, depth=3
    //    frame 5 → prev=frame4.offset, depth=4
    //    handler_offset 은 depth 1, 3 frame 이 같은 handler 공유 (count_by_handler_offset 검증)
    record_frame(800001, -1, 0x401000, 0)
    r0_emit("pe_i386_seh_fs0_chain_record",
        "\"frame_id\":800001,\"prev_offset\":-1,\"handler_offset\":4198400,\"depth\":0,\"role\":\"fs0_head\"")

    record_frame(800002, 0x12FF80, 0x401050, 1)
    r0_emit("pe_i386_seh_fs0_chain_record",
        "\"frame_id\":800002,\"prev_offset\":1245056,\"handler_offset\":4198480,\"depth\":1,\"role\":\"chain\"")

    record_frame(800003, 0x12FF70, 0x401080, 2)
    r0_emit("pe_i386_seh_fs0_chain_record",
        "\"frame_id\":800003,\"prev_offset\":1245040,\"handler_offset\":4198528,\"depth\":2,\"role\":\"chain\"")

    record_frame(800004, 0x12FF60, 0x401050, 3)
    r0_emit("pe_i386_seh_fs0_chain_record",
        "\"frame_id\":800004,\"prev_offset\":1245024,\"handler_offset\":4198480,\"depth\":3,\"role\":\"chain\"")

    record_frame(800005, 0x12FF50, 0x4010C0, 4)
    r0_emit("pe_i386_seh_fs0_chain_record",
        "\"frame_id\":800005,\"prev_offset\":1245008,\"handler_offset\":4198592,\"depth\":4,\"role\":\"chain_tail\"")

    // 3. frame_count = 5
    let c = frame_count()
    if c != 5 {
        panic("pe_i386_seh_fs0_chain FAIL [frame_count] expected=5 got=" + to_string(c))
    }

    // 4. total_depth = 0+1+2+3+4 = 10
    let td = total_depth()
    if td != 10 {
        panic("pe_i386_seh_fs0_chain FAIL [total_depth] expected=10 got=" + to_string(td))
    }

    // 5. max_depth = 4
    let md = max_depth()
    if md != 4 {
        panic("pe_i386_seh_fs0_chain FAIL [max_depth] expected=4 got=" + to_string(md))
    }

    // 6. head_frame_count = 1 (only frame 800001 has prev_offset == -1)
    let hc = head_frame_count()
    if hc != 1 {
        panic("pe_i386_seh_fs0_chain FAIL [head_frame_count] expected=1 got=" + to_string(hc))
    }

    // 7. count_by_handler_offset sanity
    let h_shared = count_by_handler_offset(0x401050)
    if h_shared != 2 {
        panic("pe_i386_seh_fs0_chain FAIL [count_by_handler_offset(0x401050)] expected=2 got=" + to_string(h_shared))
    }
    let h_uniq = count_by_handler_offset(0x401000)
    if h_uniq != 1 {
        panic("pe_i386_seh_fs0_chain FAIL [count_by_handler_offset(0x401000)] expected=1 got=" + to_string(h_uniq))
    }
    let h_miss = count_by_handler_offset(0xDEAD)
    if h_miss != 0 {
        panic("pe_i386_seh_fs0_chain FAIL [count_by_handler_offset(0xDEAD)] expected=0 got=" + to_string(h_miss))
    }

    // 8. frame_depth sanity
    let d1 = frame_depth(800001)
    if d1 != 0 {
        panic("pe_i386_seh_fs0_chain FAIL [frame_depth(800001)] expected=0 got=" + to_string(d1))
    }
    let d5 = frame_depth(800005)
    if d5 != 4 {
        panic("pe_i386_seh_fs0_chain FAIL [frame_depth(800005)] expected=4 got=" + to_string(d5))
    }
    let d_miss = frame_depth(9999)
    if d_miss != -1 {
        panic("pe_i386_seh_fs0_chain FAIL [frame_depth(9999)] expected=-1 got=" + to_string(d_miss))
    }

    // 9. pisfc_stats() = [5, 10, 4, 1]
    let s = pisfc_stats()
    if len(s) != 4 {
        panic("pe_i386_seh_fs0_chain FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_i386_seh_fs0_chain FAIL [stats frame_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 10 {
        panic("pe_i386_seh_fs0_chain FAIL [stats total_depth] expected=10 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_i386_seh_fs0_chain FAIL [stats max_depth] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_i386_seh_fs0_chain FAIL [stats head_frame_count] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_i386_seh_fs0_chain_stats",
        "\"frame_count\":" + to_string(s[0])
        + ",\"total_depth\":" + to_string(s[1])
        + ",\"max_depth\":" + to_string(s[2])
        + ",\"head_frame_count\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_i386_seh_fs0_chain FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pisfc()
    let s2 = pisfc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_i386_seh_fs0_chain FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_i386_seh_fs0_chain self_test PASS (frames=" + to_string(s[0])
        + ", total_depth=" + to_string(s[1]) + ", max_depth=" + to_string(s[2])
        + ", head=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pisfc_stats()
            println("frame_count\t" + to_string(s[0]))
            println("total_depth\t" + to_string(s[1]))
            println("max_depth\t" + to_string(s[2]))
            println("head_frame_count\t" + to_string(s[3]))
            return
        }
        if sub == "depth" {
            if len(a) >= 4 {
                let fid = to_int(a[3])
                println("frame_depth\t" + to_string(frame_depth(fid)))
                return
            }
            println("usage: hexa run pe_i386_seh_fs0_chain.hexa depth <frame_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let ho = to_int(a[3])
                println("count_by_handler_offset\t" + to_string(count_by_handler_offset(ho)))
                return
            }
            println("usage: hexa run pe_i386_seh_fs0_chain.hexa count <handler_offset>")
            return
        }
        if sub == "cleanup" {
            cleanup_pisfc()
            println("cleaned: " + pisfc_dir())
            return
        }
        if sub == "dir" {
            println(pisfc_dir())
            return
        }
    }
    println("usage: hexa run pe_i386_seh_fs0_chain.hexa { self-test | stats | depth <frame_id> | count <handler_offset> | cleanup | dir }")
}
