// lib/loader/pe_metal_texture_residency.hexa — Metal texture residency tracker skeleton
//
// Metal GPU texture residency 추적 — texture_id 별 format / size_kb / GPU 상주
// 여부 기록. 본 module 은 residency tracker — 실제 MTLTexture / heap api 호출 X.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// format_kind code:
//   1 = rgba8
//   2 = bgra8
//   3 = bc7
//   4 = astc
//
// persist schema (TSV — textures.tsv):
//   texture_id<int> \t format_kind<int> \t size_kb<int> \t gpu_resident<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmtr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_metal_texture_residency"
}

fn pmtr_textures_path() -> str {
    return pmtr_dir() + "/textures.tsv"
}

fn pmtr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmtr_dir() + "'")
}

fn cleanup_pmtr() -> void {
    pmtr_ensure_dir()
    let _ = exec("rm -f '" + pmtr_textures_path() + "'")
}

// ─── 공통 file IO ───
fn pmtr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmtr_append_row(path: str, row: str) -> void {
    pmtr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_texture: texture residency 1 건 기록 ───
fn record_texture(texture_id: int, format_kind: int, size_kb: int, gpu_resident: int) -> void {
    if texture_id <= 0 {
        panic("pe_metal_texture_residency FAIL [record_texture] expected=texture_id>0 got=" + to_string(texture_id))
    }
    if format_kind < 1 {
        panic("pe_metal_texture_residency FAIL [record_texture] expected=format_kind>=1 got=" + to_string(format_kind))
    }
    if format_kind > 4 {
        panic("pe_metal_texture_residency FAIL [record_texture] expected=format_kind<=4 got=" + to_string(format_kind))
    }
    if size_kb < 0 {
        panic("pe_metal_texture_residency FAIL [record_texture] expected=size_kb>=0 got=" + to_string(size_kb))
    }
    if gpu_resident < 0 {
        panic("pe_metal_texture_residency FAIL [record_texture] expected=gpu_resident>=0 got=" + to_string(gpu_resident))
    }
    if gpu_resident > 1 {
        panic("pe_metal_texture_residency FAIL [record_texture] expected=gpu_resident<=1 got=" + to_string(gpu_resident))
    }
    let row = to_string(texture_id) + "\t" + to_string(format_kind)
        + "\t" + to_string(size_kb) + "\t" + to_string(gpu_resident) + "\n"
    pmtr_append_row(pmtr_textures_path(), row)
}

// ─── texture_count: total texture 수 ───
fn texture_count() -> int {
    let t = pmtr_read_table(pmtr_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_size_kb: 모든 texture size_kb 합 ───
fn total_size_kb() -> int {
    let t = pmtr_read_table(pmtr_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── gpu_resident_count: gpu_resident=1 인 texture 수 ───
fn gpu_resident_count() -> int {
    let t = pmtr_read_table(pmtr_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_format: 특정 format_kind texture 수 ───
fn count_by_format(format_kind: int) -> int {
    let t = pmtr_read_table(pmtr_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == format_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── texture_size_kb: 특정 texture_id 의 size_kb (없으면 0) ───
fn texture_size_kb(texture_id: int) -> int {
    let t = pmtr_read_table(pmtr_textures_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == texture_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pmtr_stats: [texture_count, total_size_kb, gpu_resident_count, count_by_format(3)] ───
fn pmtr_stats() -> array {
    let mut out = []
    out.push(texture_count())
    out.push(total_size_kb())
    out.push(gpu_resident_count())
    out.push(count_by_format(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pmtr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pmtr()

    // 2. record 5 textures across 4 formats (≥3 gpu_resident)
    record_texture(220001, 1, 4096, 1)
    r0_emit("pe_metal_texture_residency_record",
        "\"texture_id\":220001,\"format_kind\":1,\"size_kb\":4096,\"gpu_resident\":1,\"format\":\"rgba8\"")

    record_texture(220002, 2, 2048, 1)
    r0_emit("pe_metal_texture_residency_record",
        "\"texture_id\":220002,\"format_kind\":2,\"size_kb\":2048,\"gpu_resident\":1,\"format\":\"bgra8\"")

    record_texture(220003, 3, 1024, 1)
    r0_emit("pe_metal_texture_residency_record",
        "\"texture_id\":220003,\"format_kind\":3,\"size_kb\":1024,\"gpu_resident\":1,\"format\":\"bc7\"")

    record_texture(220004, 3, 512, 0)
    r0_emit("pe_metal_texture_residency_record",
        "\"texture_id\":220004,\"format_kind\":3,\"size_kb\":512,\"gpu_resident\":0,\"format\":\"bc7\"")

    record_texture(220005, 4, 256, 0)
    r0_emit("pe_metal_texture_residency_record",
        "\"texture_id\":220005,\"format_kind\":4,\"size_kb\":256,\"gpu_resident\":0,\"format\":\"astc\"")

    // 3. texture_count = 5
    let c = texture_count()
    if c != 5 {
        panic("pe_metal_texture_residency FAIL [texture_count] expected=5 got=" + to_string(c))
    }

    // 4. total_size_kb = 7936
    let ts = total_size_kb()
    if ts != 7936 {
        panic("pe_metal_texture_residency FAIL [total_size_kb] expected=7936 got=" + to_string(ts))
    }

    // 5. gpu_resident_count = 3
    let gr = gpu_resident_count()
    if gr != 3 {
        panic("pe_metal_texture_residency FAIL [gpu_resident_count] expected=3 got=" + to_string(gr))
    }

    // 6. count_by_format sanity
    let f1 = count_by_format(1)
    if f1 != 1 {
        panic("pe_metal_texture_residency FAIL [count_by_format(1)] expected=1 got=" + to_string(f1))
    }
    let f2 = count_by_format(2)
    if f2 != 1 {
        panic("pe_metal_texture_residency FAIL [count_by_format(2)] expected=1 got=" + to_string(f2))
    }
    let f3 = count_by_format(3)
    if f3 != 2 {
        panic("pe_metal_texture_residency FAIL [count_by_format(3)] expected=2 got=" + to_string(f3))
    }
    let f4 = count_by_format(4)
    if f4 != 1 {
        panic("pe_metal_texture_residency FAIL [count_by_format(4)] expected=1 got=" + to_string(f4))
    }
    let f99 = count_by_format(99)
    if f99 != 0 {
        panic("pe_metal_texture_residency FAIL [count_by_format(99)] expected=0 got=" + to_string(f99))
    }

    // 7. texture_size_kb sanity
    let s2 = texture_size_kb(220002)
    if s2 != 2048 {
        panic("pe_metal_texture_residency FAIL [texture_size_kb(220002)] expected=2048 got=" + to_string(s2))
    }
    let s3 = texture_size_kb(220003)
    if s3 != 1024 {
        panic("pe_metal_texture_residency FAIL [texture_size_kb(220003)] expected=1024 got=" + to_string(s3))
    }
    let s_miss = texture_size_kb(9999)
    if s_miss != 0 {
        panic("pe_metal_texture_residency FAIL [texture_size_kb(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 8. pmtr_stats() = [5, 7936, 3, 2]
    let s = pmtr_stats()
    if len(s) != 4 {
        panic("pe_metal_texture_residency FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_metal_texture_residency FAIL [stats texture_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 7936 {
        panic("pe_metal_texture_residency FAIL [stats total_size_kb] expected=7936 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_metal_texture_residency FAIL [stats gpu_resident_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_metal_texture_residency FAIL [stats count_format(3)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_metal_texture_residency_stats",
        "\"texture_count\":" + to_string(s[0])
        + ",\"total_size_kb\":" + to_string(s[1])
        + ",\"gpu_resident_count\":" + to_string(s[2])
        + ",\"format_bc7\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_metal_texture_residency FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pmtr()
    let s_post = pmtr_stats()
    let i = 0
    while i < len(s_post) {
        if s_post[i] != 0 {
            panic("pe_metal_texture_residency FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s_post[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_metal_texture_residency self_test PASS (textures=" + to_string(s[0])
        + ", size_kb=" + to_string(s[1]) + ", gpu_resident=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmtr_stats()
            println("texture_count\t" + to_string(s[0]))
            println("total_size_kb\t" + to_string(s[1]))
            println("gpu_resident_count\t" + to_string(s[2]))
            println("count_format_bc7\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let tid = to_int(a[3])
                println("texture_size_kb\t" + to_string(texture_size_kb(tid)))
                return
            }
            println("usage: hexa run pe_metal_texture_residency.hexa size <texture_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let fk = to_int(a[3])
                println("count_by_format\t" + to_string(count_by_format(fk)))
                return
            }
            println("usage: hexa run pe_metal_texture_residency.hexa count <format_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmtr()
            println("cleaned: " + pmtr_dir())
            return
        }
        if sub == "dir" {
            println(pmtr_dir())
            return
        }
    }
    println("usage: hexa run pe_metal_texture_residency.hexa { self-test | stats | size <texture_id> | count <format_kind> | cleanup | dir }")
}
