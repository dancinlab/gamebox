// lib/loader/win32_msvcrt.hexa — Phase 3c — msvcrt C runtime mapping (skeleton)
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 CRT spec / ISO C standard:
//     - stdio:  https://learn.microsoft.com/en-us/cpp/c-runtime-library/stream-i-o
//     - string: https://learn.microsoft.com/en-us/cpp/c-runtime-library/string-manipulation-crt
//     - memory: https://learn.microsoft.com/en-us/cpp/c-runtime-library/memory-allocation
//     - stdlib: https://learn.microsoft.com/en-us/cpp/c-runtime-library/process-and-environment-control
//     - math:   https://learn.microsoft.com/en-us/cpp/c-runtime-library/floating-point-support
//     - ctype:  https://learn.microsoft.com/en-us/cpp/c-runtime-library/character-classification
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 2: msvcrt_lookup + msvcrt_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("win32_msvcrt FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 3c — skeleton):
//   ~40 핵심 msvcrt C runtime 함수의 *mapping table* 만 정의.
//   각 entry = (msvcrt 함수명, 대응되는 macOS libc 호출, 카테고리, status).
//   실제 implementation (libc trampoline / variadic forwarding) 은 Phase 3c 후속.
//
// status 값:
//   "skeleton" — mapping 만 (Phase 3c 현재 모든 entry)
//   "stub"     — default value 만 반환
//   "impl"     — 실제 macOS libc 호출
//
// 40 함수 카테고리 (실제 분포):
//   stdio   12  (printf, fprintf, sprintf, snprintf, fopen, fclose,
//                fread, fwrite, fseek, ftell, fflush, fgets)
//   string  10  (strcpy, strncpy, strcmp, strncmp, strlen, strcat,
//                strchr, strstr, _strdup, _stricmp)
//   memory   5  (malloc, free, calloc, realloc, memcpy)
//   stdlib   6  (atoi, atol, atof, exit, abort, system)
//   math     4  (abs, fabs, sqrt, pow)
//   ctype    3  (isalpha, isdigit, toupper)
//   ──────────
//   total   40  / 6 categories

use "../perf/r0_common"

// ─── 40 함수 mapping table (TSV — name\tmacos_equiv\tcategory\tstatus) ───
//
// 한 줄 = "<msvcrt name>\t<macOS equivalent>\t<category>\t<status>"
// 줄 구분자 = "\n". 첫 줄도 의미 entry (header 없음 — 데이터 40줄).
fn msvcrt_table() -> str {
    let t = ""
    // stdio (12)
    t = t + "printf\tprintf\tstdio\tskeleton\n"
    t = t + "fprintf\tfprintf\tstdio\tskeleton\n"
    t = t + "sprintf\tsprintf\tstdio\tskeleton\n"
    t = t + "snprintf\tsnprintf\tstdio\tskeleton\n"
    t = t + "fopen\tfopen\tstdio\tskeleton\n"
    t = t + "fclose\tfclose\tstdio\tskeleton\n"
    t = t + "fread\tfread\tstdio\tskeleton\n"
    t = t + "fwrite\tfwrite\tstdio\tskeleton\n"
    t = t + "fseek\tfseek\tstdio\tskeleton\n"
    t = t + "ftell\tftell\tstdio\tskeleton\n"
    t = t + "fflush\tfflush\tstdio\tskeleton\n"
    t = t + "fgets\tfgets\tstdio\tskeleton\n"
    // string (10)
    t = t + "strcpy\tstrcpy\tstring\tskeleton\n"
    t = t + "strncpy\tstrncpy\tstring\tskeleton\n"
    t = t + "strcmp\tstrcmp\tstring\tskeleton\n"
    t = t + "strncmp\tstrncmp\tstring\tskeleton\n"
    t = t + "strlen\tstrlen\tstring\tskeleton\n"
    t = t + "strcat\tstrcat\tstring\tskeleton\n"
    t = t + "strchr\tstrchr\tstring\tskeleton\n"
    t = t + "strstr\tstrstr\tstring\tskeleton\n"
    t = t + "_strdup\tstrdup\tstring\tskeleton\n"
    t = t + "_stricmp\tstrcasecmp\tstring\tskeleton\n"
    // memory (5)
    t = t + "malloc\tmalloc\tmemory\tskeleton\n"
    t = t + "free\tfree\tmemory\tskeleton\n"
    t = t + "calloc\tcalloc\tmemory\tskeleton\n"
    t = t + "realloc\trealloc\tmemory\tskeleton\n"
    t = t + "memcpy\tmemcpy\tmemory\tskeleton\n"
    // stdlib (6)
    t = t + "atoi\tatoi\tstdlib\tskeleton\n"
    t = t + "atol\tatol\tstdlib\tskeleton\n"
    t = t + "atof\tatof\tstdlib\tskeleton\n"
    t = t + "exit\texit\tstdlib\tskeleton\n"
    t = t + "abort\tabort\tstdlib\tskeleton\n"
    t = t + "system\tsystem\tstdlib\tskeleton\n"
    // math (4)
    t = t + "abs\tabs\tmath\tskeleton\n"
    t = t + "fabs\tfabs\tmath\tskeleton\n"
    t = t + "sqrt\tsqrt\tmath\tskeleton\n"
    t = t + "pow\tpow\tmath\tskeleton\n"
    // ctype (3)
    t = t + "isalpha\tisalpha\tctype\tskeleton\n"
    t = t + "isdigit\tisdigit\tctype\tskeleton\n"
    t = t + "toupper\ttoupper\tctype\tskeleton\n"
    return t
}

// ─── table line count (entry 수 = 40) ───
fn msvcrt_table_size() -> int {
    let t = msvcrt_table()
    let lines = t.split("\n")
    // trailing "\n" → 마지막 빈 element 1 개. count 에서 제외.
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ─── lookup: msvcrt 함수명 → "<macos>\t<category>\t<status>" 또는 "" ───
fn lookup_mapping(name: str) -> str {
    let t = msvcrt_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── status only ───
fn function_status(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[2]
    }
    return ""
}

// ─── category only ───
fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[1]
    }
    return ""
}

// ─── macOS equivalent only ───
fn function_macos_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[0]
    }
    return ""
}

// ─── category 통계 ───
//
//   반환: array of [category_name, total_count, impl_count]
//   (hexa stage1 dict 부재 → array of array).
//   impl_count = status == "impl" 인 entry 수 (Phase 3c 현재 모두 0).
fn msvcrt_stats() -> array {
    let mut cats = []
    cats.push(["stdio", 0, 0])
    cats.push(["string", 0, 0])
    cats.push(["memory", 0, 0])
    cats.push(["stdlib", 0, 0])
    cats.push(["math", 0, 0])
    cats.push(["ctype", 0, 0])

    let t = msvcrt_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cat = parts[2]
                let st = parts[3]
                let j = 0
                while j < len(cats) {
                    if cats[j][0] == cat {
                        cats[j][1] = cats[j][1] + 1
                        if st == "impl" {
                            cats[j][2] = cats[j][2] + 1
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return cats
}

// ─── 전체 impl_count 합 (스카라) ───
fn msvcrt_impl_count() -> int {
    let stats = msvcrt_stats()
    let n = len(stats)
    let i = 0
    let total = 0
    while i < n {
        total = total + stats[i][2]
        i = i + 1
    }
    return total
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "msvcrttest-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size ≥ 35 (실제 = 40)
    let sz = msvcrt_table_size()
    if sz < 35 {
        panic("win32_msvcrt FAIL [table_size] expected=>=35 got=" + to_string(sz))
    }
    if sz != 40 {
        panic("win32_msvcrt FAIL [table_size_exact] expected=40 got=" + to_string(sz))
    }

    // 2. lookup_mapping("printf") = "printf\tstdio\tskeleton"
    let m_printf = lookup_mapping("printf")
    let exp_printf = "printf\tstdio\tskeleton"
    if m_printf != exp_printf {
        panic("win32_msvcrt FAIL [lookup printf] expected=" + exp_printf + " got=" + m_printf)
    }

    // 3. lookup_mapping("malloc") = "malloc\tmemory\tskeleton"
    let m_malloc = lookup_mapping("malloc")
    let exp_malloc = "malloc\tmemory\tskeleton"
    if m_malloc != exp_malloc {
        panic("win32_msvcrt FAIL [lookup malloc] expected=" + exp_malloc + " got=" + m_malloc)
    }

    // 4. lookup_mapping("strcpy") = "strcpy\tstring\tskeleton"
    let m_strcpy = lookup_mapping("strcpy")
    let exp_strcpy = "strcpy\tstring\tskeleton"
    if m_strcpy != exp_strcpy {
        panic("win32_msvcrt FAIL [lookup strcpy] expected=" + exp_strcpy + " got=" + m_strcpy)
    }

    // 4b. function_status("printf") = "skeleton"
    let st = function_status("printf")
    if st != "skeleton" {
        panic("win32_msvcrt FAIL [function_status printf] expected=skeleton got=" + st)
    }

    // 4c. unknown name → empty
    let m_unknown = lookup_mapping("NoSuchFunction")
    if m_unknown != "" {
        panic("win32_msvcrt FAIL [lookup unknown] expected=empty got=" + m_unknown)
    }

    // 6. r0_emit "msvcrt_lookup" {name, macos}
    let macos_printf = function_macos_equiv("printf")
    r0_emit("msvcrt_lookup",
        "\"name\":\"printf\",\"macos\":\"" + macos_printf + "\"")

    // 5. msvcrt_stats() ≥ 6 categories with expected counts
    let stats = msvcrt_stats()
    let cat_n = len(stats)
    if cat_n < 6 {
        panic("win32_msvcrt FAIL [stats categories] expected=>=6 got=" + to_string(cat_n))
    }
    // 카테고리별 정확한 count 검증
    let i = 0
    let sum_total = 0
    let sum_impl = 0
    while i < cat_n {
        let cn = stats[i][0]
        let ct = stats[i][1]
        let ci = stats[i][2]
        sum_total = sum_total + ct
        sum_impl = sum_impl + ci
        if cn == "stdio" {
            if ct != 12 {
                panic("win32_msvcrt FAIL [stats stdio count] expected=12 got=" + to_string(ct))
            }
        }
        if cn == "string" {
            if ct != 10 {
                panic("win32_msvcrt FAIL [stats string count] expected=10 got=" + to_string(ct))
            }
        }
        if cn == "memory" {
            if ct != 5 {
                panic("win32_msvcrt FAIL [stats memory count] expected=5 got=" + to_string(ct))
            }
        }
        if cn == "stdlib" {
            if ct != 6 {
                panic("win32_msvcrt FAIL [stats stdlib count] expected=6 got=" + to_string(ct))
            }
        }
        if cn == "math" {
            if ct != 4 {
                panic("win32_msvcrt FAIL [stats math count] expected=4 got=" + to_string(ct))
            }
        }
        if cn == "ctype" {
            if ct != 3 {
                panic("win32_msvcrt FAIL [stats ctype count] expected=3 got=" + to_string(ct))
            }
        }
        i = i + 1
    }
    if sum_total != 40 {
        panic("win32_msvcrt FAIL [stats total sum] expected=40 got=" + to_string(sum_total))
    }
    if sum_impl != 0 {
        panic("win32_msvcrt FAIL [stats impl sum] expected=0 got=" + to_string(sum_impl))
    }

    // 6b. r0_emit "msvcrt_stats" {table_size, categories, impl_count}
    r0_emit("msvcrt_stats",
        "\"table_size\":" + to_string(sz)
        + ",\"categories\":" + to_string(cat_n)
        + ",\"impl_count\":" + to_string(sum_impl))

    // R0 emit count 검증 — 정확히 2 events (msvcrt_lookup + msvcrt_stats)
    let emit_n = r0_session_count(sid)
    if emit_n != 2 {
        panic("win32_msvcrt FAIL [r0 emit count] expected=2 got=" + to_string(emit_n))
    }

    println("  ✅ win32_msvcrt self_test PASS (40 functions, 6 categories, all skeleton, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "table" {
            print(msvcrt_table())
            return
        }
        if sub == "lookup" {
            if len(a) >= 4 {
                let name = a[3]
                let m = lookup_mapping(name)
                if m == "" {
                    println("(not found)")
                } else {
                    println(m)
                }
                return
            }
        }
        if sub == "status" {
            if len(a) >= 4 {
                let name = a[3]
                let s = function_status(name)
                if s == "" {
                    println("(not found)")
                } else {
                    println(s)
                }
                return
            }
        }
        if sub == "stats" {
            let stats = msvcrt_stats()
            let n = len(stats)
            let i = 0
            while i < n {
                println(stats[i][0]
                    + "\t" + to_string(stats[i][1])
                    + "\t" + to_string(stats[i][2]))
                i = i + 1
            }
            return
        }
        if sub == "size" {
            println(to_string(msvcrt_table_size()))
            return
        }
    }
    println("usage: hexa run win32_msvcrt.hexa { self-test | table | lookup <name> | status <name> | stats | size }")
}
