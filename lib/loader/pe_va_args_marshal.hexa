// lib/loader/pe_va_args_marshal.hexa — cycle 68 variadic args marshalling skeleton
//
// Win32 → arm64 variadic argument marshalling telemetry. printf / wsprintf /
// sprintf 류 함수의 va_list layout 은 platform 별 상이 — Win32 x86_64 는 GP
// register (rcx/rdx/r8/r9) + stack 조합, arm64 darwin 은 모든 variadic 인자
// stack passing. 본 module 은 call site 별 va_count / va_total_bytes /
// format_specifier_count 추적기 — 실 marshalling 변환은 stage 후속.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 va_args call site tracker — 실 변환 / re-pack 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t va_count<int> \t va_total_bytes<int> \t format_specifier_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pvam_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_va_args_marshal"
}

fn pvam_calls_path() -> str {
    return pvam_dir() + "/calls.tsv"
}

fn pvam_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pvam_dir() + "'")
}

fn cleanup_pvam() -> void {
    pvam_ensure_dir()
    let _ = exec("rm -f '" + pvam_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pvam_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pvam_append_row(path: str, row: str) -> void {
    pvam_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: variadic call site 1 건 기록 ───
fn record_call(call_id: int, va_count: int, va_total_bytes: int, format_specifier_count: int) -> void {
    if call_id <= 0 {
        panic("pe_va_args_marshal FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if va_count < 0 {
        panic("pe_va_args_marshal FAIL [record_call] expected=va_count>=0 got=" + to_string(va_count))
    }
    if va_total_bytes < 0 {
        panic("pe_va_args_marshal FAIL [record_call] expected=va_total_bytes>=0 got=" + to_string(va_total_bytes))
    }
    if format_specifier_count < 0 {
        panic("pe_va_args_marshal FAIL [record_call] expected=format_specifier_count>=0 got=" + to_string(format_specifier_count))
    }
    let row = to_string(call_id) + "\t" + to_string(va_count)
        + "\t" + to_string(va_total_bytes) + "\t" + to_string(format_specifier_count) + "\n"
    pvam_append_row(pvam_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = pvam_read_table(pvam_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_va_count: 모든 call 의 va_count 합 ───
fn total_va_count() -> int {
    let t = pvam_read_table(pvam_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_va_bytes: 모든 call 의 va_total_bytes 합 ───
fn total_va_bytes() -> int {
    let t = pvam_read_table(pvam_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_format_specs: 모든 call 의 format_specifier_count 합 ───
fn total_format_specs() -> int {
    let t = pvam_read_table(pvam_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_va_count: 특정 va_count 값 가진 call 수 ───
fn count_by_va_count(vc: int) -> int {
    let t = pvam_read_table(pvam_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == vc {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_va_bytes: 특정 call_id 의 va_total_bytes (없으면 0) ───
fn call_va_bytes(call_id: int) -> int {
    let t = pvam_read_table(pvam_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pvam_stats: [call_count, total_va_count, total_va_bytes, total_format_specs] ───
fn pvam_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_va_count())
    out.push(total_va_bytes())
    out.push(total_format_specs())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pvam-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pvam()

    // 2. record 5 variadic calls (deterministic synthetic)
    //    va_count: 0, 1, 3, 5, 8 → sum = 17
    //    va_total_bytes: 0, 8, 24, 40, 64 → sum = 136
    //    format_specifier_count: 0, 1, 3, 5, 8 → sum = 17
    record_call(680001, 0, 0, 0)
    r0_emit("pe_va_args_marshal_record",
        "\"call_id\":680001,\"va_count\":0,\"va_total_bytes\":0,\"format_specifier_count\":0,\"target\":\"puts\"")

    record_call(680002, 1, 8, 1)
    r0_emit("pe_va_args_marshal_record",
        "\"call_id\":680002,\"va_count\":1,\"va_total_bytes\":8,\"format_specifier_count\":1,\"target\":\"printf\"")

    record_call(680003, 3, 24, 3)
    r0_emit("pe_va_args_marshal_record",
        "\"call_id\":680003,\"va_count\":3,\"va_total_bytes\":24,\"format_specifier_count\":3,\"target\":\"sprintf\"")

    record_call(680004, 5, 40, 5)
    r0_emit("pe_va_args_marshal_record",
        "\"call_id\":680004,\"va_count\":5,\"va_total_bytes\":40,\"format_specifier_count\":5,\"target\":\"wsprintf\"")

    record_call(680005, 8, 64, 8)
    r0_emit("pe_va_args_marshal_record",
        "\"call_id\":680005,\"va_count\":8,\"va_total_bytes\":64,\"format_specifier_count\":8,\"target\":\"_snprintf\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("pe_va_args_marshal FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. total_va_count = 17
    let tvc = total_va_count()
    if tvc != 17 {
        panic("pe_va_args_marshal FAIL [total_va_count] expected=17 got=" + to_string(tvc))
    }

    // 5. total_va_bytes = 136
    let tvb = total_va_bytes()
    if tvb != 136 {
        panic("pe_va_args_marshal FAIL [total_va_bytes] expected=136 got=" + to_string(tvb))
    }

    // 6. total_format_specs = 17
    let tfs = total_format_specs()
    if tfs != 17 {
        panic("pe_va_args_marshal FAIL [total_format_specs] expected=17 got=" + to_string(tfs))
    }

    // 7. count_by_va_count sanity (each unique value appears once)
    let v0 = count_by_va_count(0)
    if v0 != 1 {
        panic("pe_va_args_marshal FAIL [count_by_va_count(0)] expected=1 got=" + to_string(v0))
    }
    let v1 = count_by_va_count(1)
    if v1 != 1 {
        panic("pe_va_args_marshal FAIL [count_by_va_count(1)] expected=1 got=" + to_string(v1))
    }
    let v3 = count_by_va_count(3)
    if v3 != 1 {
        panic("pe_va_args_marshal FAIL [count_by_va_count(3)] expected=1 got=" + to_string(v3))
    }
    let v5 = count_by_va_count(5)
    if v5 != 1 {
        panic("pe_va_args_marshal FAIL [count_by_va_count(5)] expected=1 got=" + to_string(v5))
    }
    let v8 = count_by_va_count(8)
    if v8 != 1 {
        panic("pe_va_args_marshal FAIL [count_by_va_count(8)] expected=1 got=" + to_string(v8))
    }
    let v99 = count_by_va_count(99)
    if v99 != 0 {
        panic("pe_va_args_marshal FAIL [count_by_va_count(99)] expected=0 got=" + to_string(v99))
    }

    // 8. call_va_bytes sanity
    let b3 = call_va_bytes(680003)
    if b3 != 24 {
        panic("pe_va_args_marshal FAIL [call_va_bytes(680003)] expected=24 got=" + to_string(b3))
    }
    let b5 = call_va_bytes(680005)
    if b5 != 64 {
        panic("pe_va_args_marshal FAIL [call_va_bytes(680005)] expected=64 got=" + to_string(b5))
    }
    let b_miss = call_va_bytes(9999)
    if b_miss != 0 {
        panic("pe_va_args_marshal FAIL [call_va_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 9. pvam_stats() = [5, 17, 136, 17]
    let s = pvam_stats()
    if len(s) != 4 {
        panic("pe_va_args_marshal FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_va_args_marshal FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 17 {
        panic("pe_va_args_marshal FAIL [stats total_va_count] expected=17 got=" + to_string(s[1]))
    }
    if s[2] != 136 {
        panic("pe_va_args_marshal FAIL [stats total_va_bytes] expected=136 got=" + to_string(s[2]))
    }
    if s[3] != 17 {
        panic("pe_va_args_marshal FAIL [stats total_format_specs] expected=17 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_va_args_marshal_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_va_count\":" + to_string(s[1])
        + ",\"total_va_bytes\":" + to_string(s[2])
        + ",\"total_format_specs\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_va_args_marshal FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pvam()
    let s2 = pvam_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_va_args_marshal FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_va_args_marshal self_test PASS (calls=" + to_string(s[0])
        + ", va_count=" + to_string(s[1]) + ", va_bytes=" + to_string(s[2])
        + ", fmt_specs=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pvam_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_va_count\t" + to_string(s[1]))
            println("total_va_bytes\t" + to_string(s[2]))
            println("total_format_specs\t" + to_string(s[3]))
            return
        }
        if sub == "bytes" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_va_bytes\t" + to_string(call_va_bytes(cid)))
                return
            }
            println("usage: hexa run pe_va_args_marshal.hexa bytes <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let vc = to_int(a[3])
                println("count_by_va_count\t" + to_string(count_by_va_count(vc)))
                return
            }
            println("usage: hexa run pe_va_args_marshal.hexa count <va_count>")
            return
        }
        if sub == "cleanup" {
            cleanup_pvam()
            println("cleaned: " + pvam_dir())
            return
        }
        if sub == "dir" {
            println(pvam_dir())
            return
        }
    }
    println("usage: hexa run pe_va_args_marshal.hexa { self-test | stats | bytes <call_id> | count <va_count> | cleanup | dir }")
}
