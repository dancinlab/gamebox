// lib/loader/win32_user32_tier1_real.hexa — cycle 81 R6 Tier 1 USER32 trivial 1-line 함수 실 구현 추적
//
// Apple AppKit / CoreGraphics 위에서 trivial USER32 함수의 실제 반환값을 산출 + 기록.
// stub 단계가 아닌 real_appkit / core_graphics_query 단계 진입 — own1 (MSDN + AppKit 공식).
//
// Tier 1 trivial USER32 → Apple-native:
//   GetSystemMetrics(SM_CXSCREEN/CYSCREEN) → NSScreen.frame.size + backingScaleFactor
//   GetCursorPos                           → CGEventGetLocation
//   GetForegroundWindow / GetActiveWindow  → NSApp.keyWindow / mainWindow
//   GetDesktopWindow                       → 단일 sentinel (Win32 위계 가짜)
//   GetMessageTime                         → CFAbsoluteTimeGetCurrent ms
//   GetTickCount                           → mach_absolute_time → ms
//   GetMessagePos                          → 마지막 mouse event location pack(low=x, high=y)
//   GetCaretBlinkTime                      → NSTextInsertionPointBlinkPeriod
//   GetDoubleClickTime                     → NSEvent doubleClickInterval ms (default 500)
// own1: Apple AppKit/CoreGraphics + MSDN. Wine user32/winproc.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//   1 = GetSystemMetrics
//   2 = GetCursorPos
//   3 = GetForegroundWindow
//   4 = GetActiveWindow
//   5 = GetDesktopWindow
//   6 = GetMessageTime
//   7 = GetTickCount
//   8 = GetMessagePos
//   9 = GetCaretBlinkTime
//  10 = GetDoubleClickTime
//
// impl_status code:
//   1 = real_appkit          (NSScreen / NSApp / NSEvent 직접 조회)
//   2 = stub_constant        (Win32 호환 sentinel — GetDesktopWindow 등)
//   3 = core_graphics_query  (CGEventGetLocation / mach_absolute_time)
//   4 = deprecated_zero      (Win32-only 의미 없는 0 반환)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t impl_status<int> \t return_value<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wut1_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_user32_tier1_real"
}

fn wut1_calls_path() -> str {
    return wut1_dir() + "/calls.tsv"
}

fn wut1_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wut1_dir() + "'")
}

fn cleanup_wut1() -> void {
    wut1_ensure_dir()
    let _ = exec("rm -f '" + wut1_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wut1_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wut1_append_row(path: str, row: str) -> void {
    wut1_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: USER32 call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, impl_status: int, return_value: int) -> void {
    if call_id <= 0 {
        panic("win32_user32_tier1_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_user32_tier1_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 10 {
        panic("win32_user32_tier1_real FAIL [record_call] expected=func_kind<=10 got=" + to_string(func_kind))
    }
    if impl_status < 1 {
        panic("win32_user32_tier1_real FAIL [record_call] expected=impl_status>=1 got=" + to_string(impl_status))
    }
    if impl_status > 4 {
        panic("win32_user32_tier1_real FAIL [record_call] expected=impl_status<=4 got=" + to_string(impl_status))
    }
    if return_value < 0 {
        panic("win32_user32_tier1_real FAIL [record_call] expected=return_value>=0 got=" + to_string(return_value))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(impl_status) + "\t" + to_string(return_value) + "\n"
    wut1_append_row(wut1_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wut1_read_table(wut1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = wut1_read_table(wut1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_impl_status: 특정 impl_status 의 call 수 ───
fn count_by_impl_status(status: int) -> int {
    let t = wut1_read_table(wut1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── real_appkit_count: impl_status == 1 인 call 수 ───
fn real_appkit_count() -> int {
    return count_by_impl_status(1)
}

// ─── total_return_value: 모든 call return_value 합 ───
fn total_return_value() -> int {
    let t = wut1_read_table(wut1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── call_return_value: 특정 call_id 의 return_value (없으면 0) ───
fn call_return_value(call_id: int) -> int {
    let t = wut1_read_table(wut1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wut1_stats: [call_count, real_appkit_count, total_return_value, count_by_impl_status(3)] ───
fn wut1_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(real_appkit_count())
    out.push(total_return_value())
    out.push(count_by_impl_status(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wut1-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wut1()

    // 2. record 6 USER32 calls — ≥4 func_kinds, all 4 impl_statuses
    //    func_kinds covered: 1, 2, 5, 6, 7, 10  (=6 distinct ≥4)
    //    impl_statuses covered: 1, 2, 3, 4      (=all 4)

    // call 1: GetSystemMetrics(SM_CXSCREEN) → NSScreen 1920 (real_appkit)
    record_call(810001, 1, 1, 1920)
    r0_emit("win32_user32_tier1_real_record",
        "\"call_id\":810001,\"func_kind\":1,\"impl_status\":1,\"return_value\":1920,\"target\":\"GetSystemMetrics_real_appkit\"")

    // call 2: GetCursorPos → CGEventGetLocation packed (core_graphics_query)
    record_call(810002, 2, 3, 524800)
    r0_emit("win32_user32_tier1_real_record",
        "\"call_id\":810002,\"func_kind\":2,\"impl_status\":3,\"return_value\":524800,\"target\":\"GetCursorPos_core_graphics_query\"")

    // call 3: GetDesktopWindow → sentinel HWND 1 (stub_constant)
    record_call(810003, 5, 2, 1)
    r0_emit("win32_user32_tier1_real_record",
        "\"call_id\":810003,\"func_kind\":5,\"impl_status\":2,\"return_value\":1,\"target\":\"GetDesktopWindow_stub_constant\"")

    // call 4: GetMessageTime → 0 deprecated (Win32-only, no message queue)
    record_call(810004, 6, 4, 0)
    r0_emit("win32_user32_tier1_real_record",
        "\"call_id\":810004,\"func_kind\":6,\"impl_status\":4,\"return_value\":0,\"target\":\"GetMessageTime_deprecated_zero\"")

    // call 5: GetTickCount → mach_absolute_time ms (core_graphics_query family)
    record_call(810005, 7, 3, 12345)
    r0_emit("win32_user32_tier1_real_record",
        "\"call_id\":810005,\"func_kind\":7,\"impl_status\":3,\"return_value\":12345,\"target\":\"GetTickCount_core_graphics_query\"")

    // call 6: GetDoubleClickTime → NSEvent doubleClickInterval 500 ms (real_appkit)
    record_call(810006, 10, 1, 500)
    r0_emit("win32_user32_tier1_real_record",
        "\"call_id\":810006,\"func_kind\":10,\"impl_status\":1,\"return_value\":500,\"target\":\"GetDoubleClickTime_real_appkit\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("win32_user32_tier1_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. ≥4 distinct func_kinds — verify each
    let f1 = count_by_func_kind(1)
    if f1 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(f1))
    }
    let f2 = count_by_func_kind(2)
    if f2 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(f2))
    }
    let f5 = count_by_func_kind(5)
    if f5 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_func_kind(5)] expected=1 got=" + to_string(f5))
    }
    let f6 = count_by_func_kind(6)
    if f6 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_func_kind(6)] expected=1 got=" + to_string(f6))
    }
    let f7 = count_by_func_kind(7)
    if f7 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_func_kind(7)] expected=1 got=" + to_string(f7))
    }
    let f10 = count_by_func_kind(10)
    if f10 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_func_kind(10)] expected=1 got=" + to_string(f10))
    }
    let f99 = count_by_func_kind(9)
    if f99 != 0 {
        panic("win32_user32_tier1_real FAIL [count_by_func_kind(9)] expected=0 got=" + to_string(f99))
    }

    // 5. all 4 impl_statuses present
    let s1 = count_by_impl_status(1)
    if s1 != 2 {
        panic("win32_user32_tier1_real FAIL [count_by_impl_status(1)] expected=2 got=" + to_string(s1))
    }
    let s2 = count_by_impl_status(2)
    if s2 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_impl_status(2)] expected=1 got=" + to_string(s2))
    }
    let s3 = count_by_impl_status(3)
    if s3 != 2 {
        panic("win32_user32_tier1_real FAIL [count_by_impl_status(3)] expected=2 got=" + to_string(s3))
    }
    let s4 = count_by_impl_status(4)
    if s4 != 1 {
        panic("win32_user32_tier1_real FAIL [count_by_impl_status(4)] expected=1 got=" + to_string(s4))
    }

    // 6. real_appkit_count = 2 (calls 810001, 810006)
    let rac = real_appkit_count()
    if rac != 2 {
        panic("win32_user32_tier1_real FAIL [real_appkit_count] expected=2 got=" + to_string(rac))
    }

    // 7. total_return_value = 1920+524800+1+0+12345+500 = 539566
    let trv = total_return_value()
    if trv != 539566 {
        panic("win32_user32_tier1_real FAIL [total_return_value] expected=539566 got=" + to_string(trv))
    }

    // 8. call_return_value sanity
    let rv1 = call_return_value(810001)
    if rv1 != 1920 {
        panic("win32_user32_tier1_real FAIL [call_return_value(810001)] expected=1920 got=" + to_string(rv1))
    }
    let rv5 = call_return_value(810005)
    if rv5 != 12345 {
        panic("win32_user32_tier1_real FAIL [call_return_value(810005)] expected=12345 got=" + to_string(rv5))
    }
    let rv_miss = call_return_value(9999)
    if rv_miss != 0 {
        panic("win32_user32_tier1_real FAIL [call_return_value(9999)] expected=0 got=" + to_string(rv_miss))
    }

    // 9. wut1_stats() = [6, 2, 539566, 2]
    let s = wut1_stats()
    if len(s) != 4 {
        panic("win32_user32_tier1_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("win32_user32_tier1_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("win32_user32_tier1_real FAIL [stats real_appkit] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 539566 {
        panic("win32_user32_tier1_real FAIL [stats total_return] expected=539566 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("win32_user32_tier1_real FAIL [stats count_status(3)] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("win32_user32_tier1_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"real_appkit\":" + to_string(s[1])
        + ",\"total_return\":" + to_string(s[2])
        + ",\"core_graphics\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("win32_user32_tier1_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_wut1()
    let s2x = wut1_stats()
    let i = 0
    while i < len(s2x) {
        if s2x[i] != 0 {
            panic("win32_user32_tier1_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2x[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_user32_tier1_real self_test PASS (calls=" + to_string(s[0])
        + ", real_appkit=" + to_string(s[1]) + ", total_return=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wut1_stats()
            println("call_count\t" + to_string(s[0]))
            println("real_appkit_count\t" + to_string(s[1]))
            println("total_return_value\t" + to_string(s[2]))
            println("count_status_core_graphics\t" + to_string(s[3]))
            return
        }
        if sub == "return" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_return_value\t" + to_string(call_return_value(cid)))
                return
            }
            println("usage: hexa run win32_user32_tier1_real.hexa return <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let v = to_int(a[4])
                if dim == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(v)))
                    return
                }
                if dim == "impl" {
                    println("count_by_impl_status\t" + to_string(count_by_impl_status(v)))
                    return
                }
                println("usage: hexa run win32_user32_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
                return
            }
            println("usage: hexa run win32_user32_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_wut1()
            println("cleaned: " + wut1_dir())
            return
        }
        if sub == "dir" {
            println(wut1_dir())
            return
        }
    }
    println("usage: hexa run win32_user32_tier1_real.hexa { self-test | stats | return <call_id> | count func <func_kind> | count impl <impl_status> | cleanup | dir }")
}
