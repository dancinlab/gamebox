// lib/loader/pe_i386_calling_conv_real.hexa — i386 PE32 calling convention 실 stack frame tracker
//
// i386 PE32 stack frame: ESP+0=return addr, ESP+4..=args.
//   - stdcall  : callee RET imm16 (=param_bytes) — callee cleans stack
//   - cdecl    : caller ESP+=size — caller cleans stack
//   - fastcall : ECX=arg1 EDX=arg2 + 나머지 stack — callee cleans stack
//   - thiscall : ECX=this + 나머지 stack — callee cleans stack (MS C++)
//   - naked    : compiler 가 prologue/epilogue 생략, 사용자 inline asm 가 책임
// arm64 → x29 frame pointer + LR + saved x19-x30. i386 stack frame 을 arm64
// AAPCS frame 으로 rebalance 하는 adapter telemetry skeleton — 본 module 은
// call site 1 건당 (call_id, conv_kind, param_bytes, ret_bytes) 만 보존.
//
// own 1 enforcement: Wine winecrt0 / CrossOver / community 코드 0 줄.
//   i386 ABI 는 Microsoft __stdcall / __cdecl / __fastcall / __thiscall spec
//   기반 자체 구현. Wine winecrt0 인용 X.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// param_bytes / ret_bytes 단위: byte (4-byte aligned slot 가정).
//   - cdecl  : ret_bytes == 0 (caller cleans)
//   - stdcall: ret_bytes == param_bytes (callee cleans full)
//   - fastcall/thiscall: ret_bytes == max(0, param_bytes - register_bytes)
//     (ECX/EDX 통해 전달된 인자는 stack 점유 X — register_bytes 만큼 차감)
//   - naked  : ret_bytes 는 사용자 책임 — 본 skeleton 은 0 으로 기록
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t conv_kind<int> \t param_bytes<int> \t ret_bytes<int>
//   conv_kind: 1=stdcall, 2=cdecl, 3=fastcall, 4=thiscall, 5=naked

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn picc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_i386_calling_conv_real"
}

fn picc_calls_path() -> str {
    return picc_dir() + "/calls.tsv"
}

fn picc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + picc_dir() + "'")
}

fn cleanup_picc() -> void {
    picc_ensure_dir()
    let _ = exec("rm -f '" + picc_calls_path() + "'")
}

// ─── 공통 file IO ───
fn picc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn picc_append_row(path: str, row: str) -> void {
    picc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: i386 call site 1 건 기록 ───
fn record_call(call_id: int, conv_kind: int, param_bytes: int, ret_bytes: int) -> void {
    if call_id <= 0 {
        panic("pe_i386_calling_conv_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if conv_kind < 1 {
        panic("pe_i386_calling_conv_real FAIL [record_call] expected=conv_kind>=1 got=" + to_string(conv_kind))
    }
    if conv_kind > 5 {
        panic("pe_i386_calling_conv_real FAIL [record_call] expected=conv_kind<=5 got=" + to_string(conv_kind))
    }
    if param_bytes < 0 {
        panic("pe_i386_calling_conv_real FAIL [record_call] expected=param_bytes>=0 got=" + to_string(param_bytes))
    }
    if ret_bytes < 0 {
        panic("pe_i386_calling_conv_real FAIL [record_call] expected=ret_bytes>=0 got=" + to_string(ret_bytes))
    }
    if ret_bytes > param_bytes {
        panic("pe_i386_calling_conv_real FAIL [record_call] expected=ret_bytes<=param_bytes got="
            + to_string(ret_bytes) + ">" + to_string(param_bytes))
    }
    // cdecl (2) → ret_bytes 는 0 이어야 함 (caller cleans).
    if conv_kind == 2 {
        if ret_bytes != 0 {
            panic("pe_i386_calling_conv_real FAIL [record_call cdecl] expected=ret_bytes=0 got="
                + to_string(ret_bytes))
        }
    }
    // stdcall (1) → ret_bytes == param_bytes (callee cleans full).
    if conv_kind == 1 {
        if ret_bytes != param_bytes {
            panic("pe_i386_calling_conv_real FAIL [record_call stdcall] expected=ret_bytes==param_bytes got="
                + to_string(ret_bytes) + "!=" + to_string(param_bytes))
        }
    }
    let row = to_string(call_id) + "\t" + to_string(conv_kind)
        + "\t" + to_string(param_bytes) + "\t" + to_string(ret_bytes) + "\n"
    picc_append_row(picc_calls_path(), row)
}

// ─── call_count: total call site 수 ───
fn call_count() -> int {
    let t = picc_read_table(picc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_conv_kind: 특정 conv_kind 의 call 수 ───
fn count_by_conv_kind(ck: int) -> int {
    let t = picc_read_table(picc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == ck {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_param_bytes: 모든 call 의 param_bytes 합 ───
fn total_param_bytes() -> int {
    let t = picc_read_table(picc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_ret_bytes: 모든 call 의 ret_bytes 합 ───
fn total_ret_bytes() -> int {
    let t = picc_read_table(picc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── stdcall_count: conv_kind == 1 의 call 수 ───
fn stdcall_count() -> int {
    return count_by_conv_kind(1)
}

// ─── call_ret_bytes: 특정 call_id 의 ret_bytes (없으면 0) ───
fn call_ret_bytes(call_id: int) -> int {
    let t = picc_read_table(picc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── picc_stats: [call_count, total_param_bytes, total_ret_bytes, stdcall_count] ───
fn picc_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_param_bytes())
    out.push(total_ret_bytes())
    out.push(stdcall_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "picc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_picc()

    // 2. record 6 calls covering ≥4 conv_kinds:
    //   call 691001: stdcall  (ck=1) — pb=8,  rb=8   (RET 8)
    //   call 691002: stdcall  (ck=1) — pb=16, rb=16  (RET 16)
    //   call 691003: cdecl    (ck=2) — pb=12, rb=0   (caller cleans)
    //   call 691004: fastcall (ck=3) — pb=8,  rb=0   (ECX+EDX, no stack args left)
    //   call 691005: thiscall (ck=4) — pb=12, rb=8   (ECX=this, 8 bytes stack)
    //   call 691006: naked    (ck=5) — pb=0,  rb=0   (user inline asm 책임)
    record_call(691001, 1, 8, 8)
    r0_emit("pe_i386_calling_conv_real_record",
        "\"call_id\":691001,\"conv_kind\":1,\"conv\":\"stdcall\",\"param_bytes\":8,\"ret_bytes\":8")

    record_call(691002, 1, 16, 16)
    r0_emit("pe_i386_calling_conv_real_record",
        "\"call_id\":691002,\"conv_kind\":1,\"conv\":\"stdcall\",\"param_bytes\":16,\"ret_bytes\":16")

    record_call(691003, 2, 12, 0)
    r0_emit("pe_i386_calling_conv_real_record",
        "\"call_id\":691003,\"conv_kind\":2,\"conv\":\"cdecl\",\"param_bytes\":12,\"ret_bytes\":0")

    record_call(691004, 3, 8, 0)
    r0_emit("pe_i386_calling_conv_real_record",
        "\"call_id\":691004,\"conv_kind\":3,\"conv\":\"fastcall\",\"param_bytes\":8,\"ret_bytes\":0")

    record_call(691005, 4, 12, 8)
    r0_emit("pe_i386_calling_conv_real_record",
        "\"call_id\":691005,\"conv_kind\":4,\"conv\":\"thiscall\",\"param_bytes\":12,\"ret_bytes\":8")

    record_call(691006, 5, 0, 0)
    r0_emit("pe_i386_calling_conv_real_record",
        "\"call_id\":691006,\"conv_kind\":5,\"conv\":\"naked\",\"param_bytes\":0,\"ret_bytes\":0")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("pe_i386_calling_conv_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. total_param_bytes = 8+16+12+8+12+0 = 56
    let tpb = total_param_bytes()
    if tpb != 56 {
        panic("pe_i386_calling_conv_real FAIL [total_param_bytes] expected=56 got=" + to_string(tpb))
    }

    // 5. total_ret_bytes = 8+16+0+0+8+0 = 32
    let trb = total_ret_bytes()
    if trb != 32 {
        panic("pe_i386_calling_conv_real FAIL [total_ret_bytes] expected=32 got=" + to_string(trb))
    }

    // 6. count_by_conv_kind sanity (≥4 conv_kinds covered)
    let ck1 = count_by_conv_kind(1)
    if ck1 != 2 {
        panic("pe_i386_calling_conv_real FAIL [count_by_conv_kind(1)] expected=2 got=" + to_string(ck1))
    }
    let ck2 = count_by_conv_kind(2)
    if ck2 != 1 {
        panic("pe_i386_calling_conv_real FAIL [count_by_conv_kind(2)] expected=1 got=" + to_string(ck2))
    }
    let ck3 = count_by_conv_kind(3)
    if ck3 != 1 {
        panic("pe_i386_calling_conv_real FAIL [count_by_conv_kind(3)] expected=1 got=" + to_string(ck3))
    }
    let ck4 = count_by_conv_kind(4)
    if ck4 != 1 {
        panic("pe_i386_calling_conv_real FAIL [count_by_conv_kind(4)] expected=1 got=" + to_string(ck4))
    }
    let ck5 = count_by_conv_kind(5)
    if ck5 != 1 {
        panic("pe_i386_calling_conv_real FAIL [count_by_conv_kind(5)] expected=1 got=" + to_string(ck5))
    }
    let ck99 = count_by_conv_kind(99)
    if ck99 != 0 {
        panic("pe_i386_calling_conv_real FAIL [count_by_conv_kind(99)] expected=0 got=" + to_string(ck99))
    }

    // 7. stdcall_count == count_by_conv_kind(1) == 2
    let sc = stdcall_count()
    if sc != 2 {
        panic("pe_i386_calling_conv_real FAIL [stdcall_count] expected=2 got=" + to_string(sc))
    }

    // 8. call_ret_bytes sanity
    let r1 = call_ret_bytes(691001)
    if r1 != 8 {
        panic("pe_i386_calling_conv_real FAIL [call_ret_bytes(691001)] expected=8 got=" + to_string(r1))
    }
    let r3 = call_ret_bytes(691003)
    if r3 != 0 {
        panic("pe_i386_calling_conv_real FAIL [call_ret_bytes(691003)] expected=0 got=" + to_string(r3))
    }
    let r5 = call_ret_bytes(691005)
    if r5 != 8 {
        panic("pe_i386_calling_conv_real FAIL [call_ret_bytes(691005)] expected=8 got=" + to_string(r5))
    }
    let r_miss = call_ret_bytes(9999)
    if r_miss != 0 {
        panic("pe_i386_calling_conv_real FAIL [call_ret_bytes(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 9. picc_stats() = [6, 56, 32, 2]
    let s = picc_stats()
    if len(s) != 4 {
        panic("pe_i386_calling_conv_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_i386_calling_conv_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 56 {
        panic("pe_i386_calling_conv_real FAIL [stats total_param_bytes] expected=56 got=" + to_string(s[1]))
    }
    if s[2] != 32 {
        panic("pe_i386_calling_conv_real FAIL [stats total_ret_bytes] expected=32 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_i386_calling_conv_real FAIL [stats stdcall_count] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats (≥7 r0_emit: 6 records + 1 stats = 7)
    r0_emit("pe_i386_calling_conv_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_param_bytes\":" + to_string(s[1])
        + ",\"total_ret_bytes\":" + to_string(s[2])
        + ",\"stdcall_count\":" + to_string(s[3]))

    // 11. emit count >= 7
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_i386_calling_conv_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_picc()
    let s2 = picc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_i386_calling_conv_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_i386_calling_conv_real self_test PASS (calls=" + to_string(s[0])
        + ", param_bytes=" + to_string(s[1]) + ", ret_bytes=" + to_string(s[2])
        + ", stdcall=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = picc_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_param_bytes\t" + to_string(s[1]))
            println("total_ret_bytes\t" + to_string(s[2]))
            println("stdcall_count\t" + to_string(s[3]))
            return
        }
        if sub == "ret" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_ret_bytes\t" + to_string(call_ret_bytes(cid)))
                return
            }
            println("usage: hexa run pe_i386_calling_conv_real.hexa ret <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let ck = to_int(a[3])
                println("count_by_conv_kind\t" + to_string(count_by_conv_kind(ck)))
                return
            }
            println("usage: hexa run pe_i386_calling_conv_real.hexa count <conv_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_picc()
            println("cleaned: " + picc_dir())
            return
        }
        if sub == "dir" {
            println(picc_dir())
            return
        }
    }
    println("usage: hexa run pe_i386_calling_conv_real.hexa { self-test | stats | ret <call_id> | count <conv_kind> | cleanup | dir }")
}
