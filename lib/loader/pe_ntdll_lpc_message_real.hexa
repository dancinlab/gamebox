// lib/loader/pe_ntdll_lpc_message_real.hexa — cycle 83 NTDLL LPC/ALPC port message tracker
//
// NTDLL ALPC (Advanced LPC, post-Vista):
//   NtAlpcSendWaitReceivePort → request/reply pair via Mach port
//   sm_api (Session Manager), csrss_api (Console Subsystem), lsass_api (Security)
//   per-process ALPC port → per-process Mach port pair (cycle 65 pe_ipc_mach_port cross-ref)
//   D2R/D4 launch path 에서 csrss → kernelbase 내부 호출
// own1: NTDLL ALPC spec + Apple mach_msg. Wine ntdll/lpc.c 인용 X
//
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// msg_kind code:
//   1 = request
//   2 = reply
//   3 = datagram
//   4 = connect
//   5 = disconnect
//
// port_kind code:
//   1 = sm_api
//   2 = csrss_api
//   3 = lsass_api
//   4 = custom
//
// persist schema (TSV — msgs.tsv):
//   msg_id<int> \t msg_kind<int> \t port_kind<int> \t data_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pnlmr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ntdll_lpc_message_real"
}

fn pnlmr_msgs_path() -> str {
    return pnlmr_dir() + "/msgs.tsv"
}

fn pnlmr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pnlmr_dir() + "'")
}

fn cleanup_pnlmr() -> void {
    pnlmr_ensure_dir()
    let _ = exec("rm -f '" + pnlmr_msgs_path() + "'")
}

// ─── 공통 file IO ───
fn pnlmr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pnlmr_append_row(path: str, row: str) -> void {
    pnlmr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_msg: ALPC msg 1 건 기록 ───
fn record_msg(msg_id: int, msg_kind: int, port_kind: int, data_bytes: int) -> void {
    if msg_id <= 0 {
        panic("pe_ntdll_lpc_message_real FAIL [record_msg] expected=msg_id>0 got=" + to_string(msg_id))
    }
    if msg_kind < 1 {
        panic("pe_ntdll_lpc_message_real FAIL [record_msg] expected=msg_kind>=1 got=" + to_string(msg_kind))
    }
    if msg_kind > 5 {
        panic("pe_ntdll_lpc_message_real FAIL [record_msg] expected=msg_kind<=5 got=" + to_string(msg_kind))
    }
    if port_kind < 1 {
        panic("pe_ntdll_lpc_message_real FAIL [record_msg] expected=port_kind>=1 got=" + to_string(port_kind))
    }
    if port_kind > 4 {
        panic("pe_ntdll_lpc_message_real FAIL [record_msg] expected=port_kind<=4 got=" + to_string(port_kind))
    }
    if data_bytes < 0 {
        panic("pe_ntdll_lpc_message_real FAIL [record_msg] expected=data_bytes>=0 got=" + to_string(data_bytes))
    }
    let row = to_string(msg_id) + "\t" + to_string(msg_kind)
        + "\t" + to_string(port_kind) + "\t" + to_string(data_bytes) + "\n"
    pnlmr_append_row(pnlmr_msgs_path(), row)
}

// ─── msg_count: total msg 수 ───
fn msg_count() -> int {
    let t = pnlmr_read_table(pnlmr_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_msg_kind: 특정 msg_kind 의 msg 수 ───
fn count_by_msg_kind(kind: int) -> int {
    let t = pnlmr_read_table(pnlmr_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_port_kind: 특정 port_kind 의 msg 수 ───
fn count_by_port_kind(kind: int) -> int {
    let t = pnlmr_read_table(pnlmr_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_data_bytes: 모든 msg data_bytes 합 ───
fn total_data_bytes() -> int {
    let t = pnlmr_read_table(pnlmr_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── request_reply_balance: count_by_msg_kind(1) - count_by_msg_kind(2) ───
fn request_reply_balance() -> int {
    return count_by_msg_kind(1) - count_by_msg_kind(2)
}

// ─── msg_data_bytes: 특정 msg_id 의 data_bytes (없으면 0) ───
fn msg_data_bytes(msg_id: int) -> int {
    let t = pnlmr_read_table(pnlmr_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == msg_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pnlmr_stats: [msg_count, total_data_bytes, request_reply_balance, count_by_port_kind(2)] ───
fn pnlmr_stats() -> array {
    let mut out = []
    out.push(msg_count())
    out.push(total_data_bytes())
    out.push(request_reply_balance())
    out.push(count_by_port_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pnlmr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pnlmr()

    // 2. record 6 msgs across ≥3 msg_kinds (1/2/3/4) and ≥2 port_kinds (1/2/3)
    record_msg(830001, 4, 1, 0)
    r0_emit("pe_ntdll_lpc_message_real_record",
        "\"msg_id\":830001,\"msg_kind\":4,\"port_kind\":1,\"data_bytes\":0,\"target\":\"sm_api_connect\"")

    record_msg(830002, 1, 2, 256)
    r0_emit("pe_ntdll_lpc_message_real_record",
        "\"msg_id\":830002,\"msg_kind\":1,\"port_kind\":2,\"data_bytes\":256,\"target\":\"csrss_request\"")

    record_msg(830003, 2, 2, 128)
    r0_emit("pe_ntdll_lpc_message_real_record",
        "\"msg_id\":830003,\"msg_kind\":2,\"port_kind\":2,\"data_bytes\":128,\"target\":\"csrss_reply\"")

    record_msg(830004, 1, 3, 512)
    r0_emit("pe_ntdll_lpc_message_real_record",
        "\"msg_id\":830004,\"msg_kind\":1,\"port_kind\":3,\"data_bytes\":512,\"target\":\"lsass_request\"")

    record_msg(830005, 3, 2, 64)
    r0_emit("pe_ntdll_lpc_message_real_record",
        "\"msg_id\":830005,\"msg_kind\":3,\"port_kind\":2,\"data_bytes\":64,\"target\":\"csrss_datagram\"")

    record_msg(830006, 1, 2, 192)
    r0_emit("pe_ntdll_lpc_message_real_record",
        "\"msg_id\":830006,\"msg_kind\":1,\"port_kind\":2,\"data_bytes\":192,\"target\":\"csrss_request\"")

    // 3. msg_count = 6
    let c = msg_count()
    if c != 6 {
        panic("pe_ntdll_lpc_message_real FAIL [msg_count] expected=6 got=" + to_string(c))
    }

    // 4. total_data_bytes = 0+256+128+512+64+192 = 1152
    let tb = total_data_bytes()
    if tb != 1152 {
        panic("pe_ntdll_lpc_message_real FAIL [total_data_bytes] expected=1152 got=" + to_string(tb))
    }

    // 5. count_by_msg_kind sanity
    let mk1 = count_by_msg_kind(1)
    if mk1 != 3 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_msg_kind(1)] expected=3 got=" + to_string(mk1))
    }
    let mk2 = count_by_msg_kind(2)
    if mk2 != 1 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_msg_kind(2)] expected=1 got=" + to_string(mk2))
    }
    let mk3 = count_by_msg_kind(3)
    if mk3 != 1 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_msg_kind(3)] expected=1 got=" + to_string(mk3))
    }
    let mk4 = count_by_msg_kind(4)
    if mk4 != 1 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_msg_kind(4)] expected=1 got=" + to_string(mk4))
    }
    let mk5 = count_by_msg_kind(5)
    if mk5 != 0 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_msg_kind(5)] expected=0 got=" + to_string(mk5))
    }

    // 6. count_by_port_kind sanity
    let pk1 = count_by_port_kind(1)
    if pk1 != 1 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_port_kind(1)] expected=1 got=" + to_string(pk1))
    }
    let pk2 = count_by_port_kind(2)
    if pk2 != 4 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_port_kind(2)] expected=4 got=" + to_string(pk2))
    }
    let pk3 = count_by_port_kind(3)
    if pk3 != 1 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_port_kind(3)] expected=1 got=" + to_string(pk3))
    }
    let pk4 = count_by_port_kind(4)
    if pk4 != 0 {
        panic("pe_ntdll_lpc_message_real FAIL [count_by_port_kind(4)] expected=0 got=" + to_string(pk4))
    }

    // 7. request_reply_balance = 3 - 1 = 2
    let bal = request_reply_balance()
    if bal != 2 {
        panic("pe_ntdll_lpc_message_real FAIL [request_reply_balance] expected=2 got=" + to_string(bal))
    }

    // 8. msg_data_bytes sanity
    let d2 = msg_data_bytes(830002)
    if d2 != 256 {
        panic("pe_ntdll_lpc_message_real FAIL [msg_data_bytes(830002)] expected=256 got=" + to_string(d2))
    }
    let d4 = msg_data_bytes(830004)
    if d4 != 512 {
        panic("pe_ntdll_lpc_message_real FAIL [msg_data_bytes(830004)] expected=512 got=" + to_string(d4))
    }
    let d_miss = msg_data_bytes(9999)
    if d_miss != 0 {
        panic("pe_ntdll_lpc_message_real FAIL [msg_data_bytes(9999)] expected=0 got=" + to_string(d_miss))
    }

    // 9. pnlmr_stats() = [6, 1152, 2, 4]
    let s = pnlmr_stats()
    if len(s) != 4 {
        panic("pe_ntdll_lpc_message_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_ntdll_lpc_message_real FAIL [stats msg_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 1152 {
        panic("pe_ntdll_lpc_message_real FAIL [stats total_data_bytes] expected=1152 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_ntdll_lpc_message_real FAIL [stats request_reply_balance] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 4 {
        panic("pe_ntdll_lpc_message_real FAIL [stats port_csrss] expected=4 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_ntdll_lpc_message_real_stats",
        "\"msg_count\":" + to_string(s[0])
        + ",\"total_data_bytes\":" + to_string(s[1])
        + ",\"request_reply_balance\":" + to_string(s[2])
        + ",\"port_csrss\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_ntdll_lpc_message_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pnlmr()
    let s2 = pnlmr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ntdll_lpc_message_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ntdll_lpc_message_real self_test PASS (msgs=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", balance=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pnlmr_stats()
            println("msg_count\t" + to_string(s[0]))
            println("total_data_bytes\t" + to_string(s[1]))
            println("request_reply_balance\t" + to_string(s[2]))
            println("count_port_csrss\t" + to_string(s[3]))
            return
        }
        if sub == "data" {
            if len(a) >= 4 {
                let mid = to_int(a[3])
                println("msg_data_bytes\t" + to_string(msg_data_bytes(mid)))
                return
            }
            println("usage: hexa run pe_ntdll_lpc_message_real.hexa data <msg_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let which = a[3]
                let kind = to_int(a[4])
                if which == "msg" {
                    println("count_by_msg_kind\t" + to_string(count_by_msg_kind(kind)))
                    return
                }
                if which == "port" {
                    println("count_by_port_kind\t" + to_string(count_by_port_kind(kind)))
                    return
                }
            }
            println("usage: hexa run pe_ntdll_lpc_message_real.hexa count { msg <msg_kind> | port <port_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pnlmr()
            println("cleaned: " + pnlmr_dir())
            return
        }
        if sub == "dir" {
            println(pnlmr_dir())
            return
        }
    }
    println("usage: hexa run pe_ntdll_lpc_message_real.hexa { self-test | stats | data <msg_id> | count msg <msg_kind> | count port <port_kind> | cleanup | dir }")
}
