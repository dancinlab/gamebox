// lib/loader/win32_uiautomationcore_stage2.hexa — Battle.net Setup UIAutomationCore imports coverage
//
// Battle.net 의 accessibility / UI automation 함수. UiaReturnRawElementProvider,
// UiaRaiseAutomationEvent, UiaHostProviderFromHwnd 등. stage1 base 위에 추가.
//
// 실측 (pe_imports.hexa names tool/bench/Battle.net-Setup.exe 0):
//   UiaHostProviderFromHwnd                       — stage1 covered
//   UiaReturnRawElementProvider                   — stage1 covered
//   UiaRaiseAutomationPropertyChangedEvent        — stage1 covered
//   UiaRaiseAutomationEvent                       — stage1 covered
//   UiaClientsAreListening                        — stage1 covered
//
// 결과: Battle.net 의 모든 UIAutomationCore import 가 stage1 lookup_mapping 으로 커버됨.
// stage2 추가 stub 0 — 향후 추가 발견 시 이 파일에 stub 추가.

fn stage2_table() -> str {
    let t = ""
    return t
}

fn stage2_count() -> int {
    let lines = stage2_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn list_stubs() -> void {
    let lines = stage2_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" { println(lines[i]) }
        i = i + 1
    }
    if stage2_count() == 0 {
        println("# (no additional stubs — all Battle.net UIAutomationCore imports covered by stage1)")
    }
}

fn self_test() -> void {
    let n = stage2_count()
    if n != 0 { panic("win32_uiautomationcore_stage2 FAIL [count] expected=0 got=" + to_string(n)) }

    println("  ✅ win32_uiautomationcore_stage2 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "list" { list_stubs(); return }
    }
    println("usage: hexa run win32_uiautomationcore_stage2.hexa { self-test | list }")
}
