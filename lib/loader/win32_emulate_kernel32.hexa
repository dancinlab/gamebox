// lib/loader/win32_emulate_kernel32.hexa — Phase 1 stage1 — kernel32 인라인 emulation
//
// 자주 쓰이는 kernel32 함수의 hexa-level emulation.
// macOS native 까지 안 가도 응답 가능한 함수만 (state-free / pure metadata).
//
// 실 호출은 stage2 의 dlopen 으로 위임. 본 모듈은 단순 reply.

use "../perf/r0_common"

// GetTickCount → uptime millis (date +%s 기반 secs → ms)
fn emu_get_tick_count() -> int {
    let s = exec("date +%s").trim()
    return to_int(s) * 1000
}

// GetCurrentProcessId → exec PID
fn emu_get_current_process_id() -> int {
    let p = exec("echo $$").trim()
    return to_int(p)
}

// GetVersion → 0x06030001 (Windows 8.1 platform-id 호환)
fn emu_get_version() -> int { return 0x06030001 }

// GetSystemTimeAsFileTime → FILETIME 100-ns since 1601-01-01
fn emu_get_system_time_filetime() -> int {
    let s = exec("date +%s").trim()
    let unix = to_int(s)
    // FILETIME = (unix + 11644473600) * 10000000  (100ns)
    return (unix + 11644473600) * 10000000
}

// GetCurrentThreadId
fn emu_get_current_thread_id() -> int {
    return 1   // skeleton — single-thread
}

// IsDebuggerPresent
fn emu_is_debugger_present() -> int { return 0 }

// GetModuleHandleA(NULL) → fake ImageBase
fn emu_get_module_handle_null() -> int { return 0x400000 }

fn emulated_count() -> int { return 7 }

fn self_test() -> void {
    let sid = "wek-" + exec("date +%s").trim()
    r0_session_set(sid)

    let t1 = emu_get_tick_count()
    let t2 = emu_get_tick_count()
    if t2 < t1 { panic("win32_emulate_kernel32 FAIL [tick monotonic]") }

    let pid = emu_get_current_process_id()
    if pid <= 0 { panic("win32_emulate_kernel32 FAIL [pid]") }

    let ver = emu_get_version()
    if ver != 0x06030001 { panic("win32_emulate_kernel32 FAIL [version]") }

    let ft = emu_get_system_time_filetime()
    if ft < 100000000000000 { panic("win32_emulate_kernel32 FAIL [filetime range]") }

    let tid = emu_get_current_thread_id()
    if tid != 1 { panic("win32_emulate_kernel32 FAIL [tid]") }

    if emu_is_debugger_present() != 0 { panic("win32_emulate_kernel32 FAIL [no debugger]") }

    let mh = emu_get_module_handle_null()
    if mh != 0x400000 { panic("win32_emulate_kernel32 FAIL [imagebase]") }

    if emulated_count() != 7 { panic("win32_emulate_kernel32 FAIL [count]") }

    r0_emit("kernel32_emulate_ok", "\"functions\":7")

    println("  ✅ win32_emulate_kernel32 self_test PASS (7 funcs: tick/pid/ver/ft/tid/dbg/imagebase)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "tick" { println(to_string(emu_get_tick_count())); return }
        if sub == "pid" { println(to_string(emu_get_current_process_id())); return }
        if sub == "version" { println("0x" + to_string(emu_get_version())); return }
        if sub == "filetime" { println(to_string(emu_get_system_time_filetime())); return }
    }
    println("usage: hexa run win32_emulate_kernel32.hexa { self-test | tick | pid | version | filetime }")
}
