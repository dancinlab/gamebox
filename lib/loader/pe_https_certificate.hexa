// lib/loader/pe_https_certificate.hexa — cycle 75 Win32 cert chain validation skeleton
//
// Win32 CertGetCertificateChain / CertVerifyCertificateChainPolicy telemetry —
// Schannel TLS handshake 시 server certificate chain 을 root store 까지 build 하고
// trust policy(SSL/Authenticode/...)를 평가. 본 module 은 chain build / verify
// 결과 tracker — 실 wincrypt API 호출 X (stage 후속).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// root_kind code:
//   1 = microsoft_root
//   2 = enterprise
//   3 = user
//   4 = third_party
//
// trust_status code:
//   0 = trusted
//   1 = revoked
//   2 = expired
//   3 = untrusted_root
//   4 = invalid_chain
//
// persist schema (TSV — chains.tsv):
//   chain_id<int> \t root_kind<int> \t chain_depth<int> \t trust_status<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn phc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_https_certificate"
}

fn phc_chains_path() -> str {
    return phc_dir() + "/chains.tsv"
}

fn phc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + phc_dir() + "'")
}

fn cleanup_phc() -> void {
    phc_ensure_dir()
    let _ = exec("rm -f '" + phc_chains_path() + "'")
}

// ─── 공통 file IO ───
fn phc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn phc_append_row(path: str, row: str) -> void {
    phc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_chain: chain build/verify 결과 1 건 기록 ───
fn record_chain(chain_id: int, root_kind: int, chain_depth: int, trust_status: int) -> void {
    if chain_id <= 0 {
        panic("pe_https_certificate FAIL [record_chain] expected=chain_id>0 got=" + to_string(chain_id))
    }
    if root_kind < 1 {
        panic("pe_https_certificate FAIL [record_chain] expected=root_kind>=1 got=" + to_string(root_kind))
    }
    if root_kind > 4 {
        panic("pe_https_certificate FAIL [record_chain] expected=root_kind<=4 got=" + to_string(root_kind))
    }
    if chain_depth < 1 {
        panic("pe_https_certificate FAIL [record_chain] expected=chain_depth>=1 got=" + to_string(chain_depth))
    }
    if trust_status < 0 {
        panic("pe_https_certificate FAIL [record_chain] expected=trust_status>=0 got=" + to_string(trust_status))
    }
    if trust_status > 4 {
        panic("pe_https_certificate FAIL [record_chain] expected=trust_status<=4 got=" + to_string(trust_status))
    }
    let row = to_string(chain_id) + "\t" + to_string(root_kind)
        + "\t" + to_string(chain_depth) + "\t" + to_string(trust_status) + "\n"
    phc_append_row(phc_chains_path(), row)
}

// ─── chain_count: total chain 수 ───
fn chain_count() -> int {
    let t = phc_read_table(phc_chains_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_depth: 모든 chain chain_depth 합 ───
fn total_depth() -> int {
    let t = phc_read_table(phc_chains_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── trusted_count: trust_status=0 인 chain 수 ───
fn trusted_count() -> int {
    let t = phc_read_table(phc_chains_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_root_kind: 특정 root_kind 의 chain 수 ───
fn count_by_root_kind(root_kind: int) -> int {
    let t = phc_read_table(phc_chains_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == root_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_trust_status: 특정 trust_status 의 chain 수 ───
fn count_by_trust_status(trust_status: int) -> int {
    let t = phc_read_table(phc_chains_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == trust_status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── chain_depth_value: 특정 chain_id 의 chain_depth (없으면 0) ───
fn chain_depth_value(chain_id: int) -> int {
    let t = phc_read_table(phc_chains_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == chain_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── phc_stats: [chain_count, total_depth, trusted_count, count_by_root_kind(1)] ───
fn phc_stats() -> array {
    let mut out = []
    out.push(chain_count())
    out.push(total_depth())
    out.push(trusted_count())
    out.push(count_by_root_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "phc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_phc()

    // 2. record 5 chains across ≥3 root_kinds and ≥3 trust_statuses, ≥3 trusted
    //    layout:
    //      750001  root_kind=1 microsoft  depth=3  trust=0 trusted
    //      750002  root_kind=1 microsoft  depth=4  trust=0 trusted
    //      750003  root_kind=2 enterprise depth=2  trust=0 trusted
    //      750004  root_kind=3 user       depth=3  trust=2 expired
    //      750005  root_kind=4 third_party depth=5 trust=3 untrusted_root
    record_chain(750001, 1, 3, 0)
    r0_emit("pe_https_certificate_record",
        "\"chain_id\":750001,\"root_kind\":1,\"chain_depth\":3,\"trust_status\":0,\"target\":\"microsoft_trusted\"")

    record_chain(750002, 1, 4, 0)
    r0_emit("pe_https_certificate_record",
        "\"chain_id\":750002,\"root_kind\":1,\"chain_depth\":4,\"trust_status\":0,\"target\":\"microsoft_trusted\"")

    record_chain(750003, 2, 2, 0)
    r0_emit("pe_https_certificate_record",
        "\"chain_id\":750003,\"root_kind\":2,\"chain_depth\":2,\"trust_status\":0,\"target\":\"enterprise_trusted\"")

    record_chain(750004, 3, 3, 2)
    r0_emit("pe_https_certificate_record",
        "\"chain_id\":750004,\"root_kind\":3,\"chain_depth\":3,\"trust_status\":2,\"target\":\"user_expired\"")

    record_chain(750005, 4, 5, 3)
    r0_emit("pe_https_certificate_record",
        "\"chain_id\":750005,\"root_kind\":4,\"chain_depth\":5,\"trust_status\":3,\"target\":\"third_party_untrusted\"")

    // 3. chain_count = 5
    let c = chain_count()
    if c != 5 {
        panic("pe_https_certificate FAIL [chain_count] expected=5 got=" + to_string(c))
    }

    // 4. total_depth = 3+4+2+3+5 = 17
    let td = total_depth()
    if td != 17 {
        panic("pe_https_certificate FAIL [total_depth] expected=17 got=" + to_string(td))
    }

    // 5. trusted_count = 3 (750001/750002/750003)
    let tc = trusted_count()
    if tc != 3 {
        panic("pe_https_certificate FAIL [trusted_count] expected=3 got=" + to_string(tc))
    }

    // 6. count_by_root_kind sanity
    let r1 = count_by_root_kind(1)
    if r1 != 2 {
        panic("pe_https_certificate FAIL [count_by_root_kind(1)] expected=2 got=" + to_string(r1))
    }
    let r2 = count_by_root_kind(2)
    if r2 != 1 {
        panic("pe_https_certificate FAIL [count_by_root_kind(2)] expected=1 got=" + to_string(r2))
    }
    let r3 = count_by_root_kind(3)
    if r3 != 1 {
        panic("pe_https_certificate FAIL [count_by_root_kind(3)] expected=1 got=" + to_string(r3))
    }
    let r4 = count_by_root_kind(4)
    if r4 != 1 {
        panic("pe_https_certificate FAIL [count_by_root_kind(4)] expected=1 got=" + to_string(r4))
    }
    let r99 = count_by_root_kind(99)
    if r99 != 0 {
        panic("pe_https_certificate FAIL [count_by_root_kind(99)] expected=0 got=" + to_string(r99))
    }

    // 7. count_by_trust_status sanity
    let s0 = count_by_trust_status(0)
    if s0 != 3 {
        panic("pe_https_certificate FAIL [count_by_trust_status(0)] expected=3 got=" + to_string(s0))
    }
    let s2 = count_by_trust_status(2)
    if s2 != 1 {
        panic("pe_https_certificate FAIL [count_by_trust_status(2)] expected=1 got=" + to_string(s2))
    }
    let s3 = count_by_trust_status(3)
    if s3 != 1 {
        panic("pe_https_certificate FAIL [count_by_trust_status(3)] expected=1 got=" + to_string(s3))
    }
    let s_miss = count_by_trust_status(1)
    if s_miss != 0 {
        panic("pe_https_certificate FAIL [count_by_trust_status(1)] expected=0 got=" + to_string(s_miss))
    }

    // 8. chain_depth_value sanity
    let d2 = chain_depth_value(750002)
    if d2 != 4 {
        panic("pe_https_certificate FAIL [chain_depth_value(750002)] expected=4 got=" + to_string(d2))
    }
    let d5 = chain_depth_value(750005)
    if d5 != 5 {
        panic("pe_https_certificate FAIL [chain_depth_value(750005)] expected=5 got=" + to_string(d5))
    }
    let d_miss = chain_depth_value(9999)
    if d_miss != 0 {
        panic("pe_https_certificate FAIL [chain_depth_value(9999)] expected=0 got=" + to_string(d_miss))
    }

    // 9. phc_stats() = [5, 17, 3, 2]
    let s = phc_stats()
    if len(s) != 4 {
        panic("pe_https_certificate FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_https_certificate FAIL [stats chain_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 17 {
        panic("pe_https_certificate FAIL [stats total_depth] expected=17 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_https_certificate FAIL [stats trusted_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_https_certificate FAIL [stats count_microsoft] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_https_certificate_stats",
        "\"chain_count\":" + to_string(s[0])
        + ",\"total_depth\":" + to_string(s[1])
        + ",\"trusted_count\":" + to_string(s[2])
        + ",\"microsoft_root\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_https_certificate FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_phc()
    let s2v = phc_stats()
    let i = 0
    while i < len(s2v) {
        if s2v[i] != 0 {
            panic("pe_https_certificate FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2v[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_https_certificate self_test PASS (chains=" + to_string(s[0])
        + ", depth=" + to_string(s[1]) + ", trusted=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = phc_stats()
            println("chain_count\t" + to_string(s[0]))
            println("total_depth\t" + to_string(s[1]))
            println("trusted_count\t" + to_string(s[2]))
            println("count_microsoft_root\t" + to_string(s[3]))
            return
        }
        if sub == "depth" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("chain_depth\t" + to_string(chain_depth_value(cid)))
                return
            }
            println("usage: hexa run pe_https_certificate.hexa depth <chain_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let kind = a[3]
                let val = to_int(a[4])
                if kind == "root" {
                    println("count_by_root_kind\t" + to_string(count_by_root_kind(val)))
                    return
                }
                if kind == "trust" {
                    println("count_by_trust_status\t" + to_string(count_by_trust_status(val)))
                    return
                }
                println("usage: hexa run pe_https_certificate.hexa count { root <root_kind> | trust <trust_status> }")
                return
            }
            println("usage: hexa run pe_https_certificate.hexa count { root <root_kind> | trust <trust_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_phc()
            println("cleaned: " + phc_dir())
            return
        }
        if sub == "dir" {
            println(phc_dir())
            return
        }
    }
    println("usage: hexa run pe_https_certificate.hexa { self-test | stats | depth <chain_id> | count root <root_kind> | count trust <trust_status> | cleanup | dir }")
}
