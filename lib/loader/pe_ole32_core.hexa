// lib/loader/pe_ole32_core.hexa — OLE32.dll COM init + IUnknown + apartment surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine ole32 source 측 코드 인용 0. ole32.dll 직접 binding 0. CoreFoundation CFType /
//       NSXPCConnection / Dispatch object 측 직접 binding 0. objbase.h / unknwn.h / combaseapi.h
//       reference shape 만 (HRESULT / IID / CLSID / IUnknown vtable / COSERVERINFO). 실
//       CoInitialize / 실 CoCreateInstance / 실 QueryInterface = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track W3 — OLE32 (ole32.dll) COM init + IUnknown surface coverage 12 fn (skeleton row 만).
// Track W2 predecessor (NTDLL Nt* core 15 fn) 후 본 Track W3 는 OLE32 측 COM apartment + IUnknown
// vtable + CoMarshal baseline land. cycle 33 측 109/435 (~25.06%) → cycle 34 측 ~121/435 (~27.82%)
// coverage progression (+12 fn 신규, Track W bundled cycle 32-35 측 W3 row).
//
// 대상 fn (12 fn — 4 group, fn_kind 0..11 canonical map):
//   COM init (4):     CoInitialize(0) / CoInitializeEx(1) / CoUninitialize(2) / CoCreateInstance(3)
//   IUnknown (3):     QueryInterface(4) / AddRef(5) / Release(6) [vtable simulation rows]
//   COM marshal (3):  CoMarshalInterface(7) / CoUnmarshalInterface(8) / CoCreateInstanceEx(9)
//   Apartment (2):    CoGetCurrentProcess(10) / CoGetCurrentLogicalThreadId(11)
//
// synthetic IID/CLSID byte arrays (16 byte each, GUID LE):
//   IID_IUnknown    = "00000000-0000-0000-C000-000000000046" → bytes 00000000 00000000 C0000000 00000046
//   CLSID_StdMarshal = "00000017-0000-0000-C000-000000000046"
//   IID_IClassFactory = "00000001-0000-0000-C000-000000000046"
// synthetic IUnknown vtable (3 slot × 8 byte = 24 byte): QueryInterface@0x70010000,
//   AddRef@0x70010008, Release@0x70010010. ref_count_synth: 1 → 2 (AddRef) → 1 (Release).
// synthetic STREAM* for marshal (HSTREAM 0x70020000), CoInit dwCoInit 0x00000002 (APARTMENTTHREADED).
// HRESULT LE: S_OK 0x00000000, E_NOINTERFACE 0x80004002, REGDB_E_CLASSNOTREG 0x80040154,
//   CO_E_NOTINITIALIZED 0x800401F0.
//
// persist schema (TSV — 4 table): syscall_invoke / com_init_event / iunknown_vtable / marshal_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pole_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ole32_core"
}

fn pole_syscall_invoke_path() -> str {
    return pole_dir() + "/syscall_invoke.tsv"
}

fn pole_com_init_event_path() -> str {
    return pole_dir() + "/com_init_event.tsv"
}

fn pole_iunknown_vtable_path() -> str {
    return pole_dir() + "/iunknown_vtable.tsv"
}

fn pole_marshal_event_path() -> str {
    return pole_dir() + "/marshal_event.tsv"
}

fn pole_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pole_dir() + "'")
}

fn cleanup_pole() -> void {
    pole_ensure_dir()
    let _ = exec("rm -f '" + pole_syscall_invoke_path() + "' '" + pole_com_init_event_path()
        + "' '" + pole_iunknown_vtable_path() + "' '" + pole_marshal_event_path() + "'")
}

// ─── 공통 file IO ───
fn pole_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pole_append_row(path: str, row: str) -> void {
    pole_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pole_count_rows(path: str, min_cols: int) -> int {
    let t = pole_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "CoInitialize" }
    if k == 1 { return "CoInitializeEx" }
    if k == 2 { return "CoUninitialize" }
    if k == 3 { return "CoCreateInstance" }
    if k == 4 { return "QueryInterface" }
    if k == 5 { return "AddRef" }
    if k == 6 { return "Release" }
    if k == 7 { return "CoMarshalInterface" }
    if k == 8 { return "CoUnmarshalInterface" }
    if k == 9 { return "CoCreateInstanceEx" }
    if k == 10 { return "CoGetCurrentProcess" }
    if k == 11 { return "CoGetCurrentLogicalThreadId" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "com_init"
        }
    }
    if k >= 4 {
        if k <= 6 {
            return "iunknown"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "com_marshal"
        }
    }
    if k >= 10 {
        if k <= 11 {
            return "apartment"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: OLE32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_ole32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_ole32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_ole32_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_ole32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_ole32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pole_append_row(pole_syscall_invoke_path(), row)
}

// ─── record_com_init_event: CoInitialize/CoInitializeEx/CoUninitialize/CoCreateInstance row ───
fn record_com_init_event(evt_id: int, com_kind: str, hresult_hex: str, dw_co_init: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_ole32_core FAIL [record_com_init_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if com_kind == "" {
        panic("pe_ole32_core FAIL [record_com_init_event] expected=com_kind!=empty got=empty")
    }
    if hresult_hex == "" {
        panic("pe_ole32_core FAIL [record_com_init_event] expected=hresult_hex!=empty got=empty")
    }
    if dw_co_init == "" {
        panic("pe_ole32_core FAIL [record_com_init_event] expected=dw_co_init!=empty got=empty")
    }
    if status == "" {
        panic("pe_ole32_core FAIL [record_com_init_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + com_kind + "\t" + hresult_hex + "\t"
        + dw_co_init + "\t" + status + "\n"
    pole_append_row(pole_com_init_event_path(), row)
}

// ─── record_iunknown_vtable: QueryInterface/AddRef/Release vtable simulation row ───
fn record_iunknown_vtable(vt_id: int, slot_kind: str, slot_addr_hex: str, ref_count: int, status: str) -> void {
    if vt_id <= 0 {
        panic("pe_ole32_core FAIL [record_iunknown_vtable] expected=vt_id>0 got=" + to_string(vt_id))
    }
    if slot_kind == "" {
        panic("pe_ole32_core FAIL [record_iunknown_vtable] expected=slot_kind!=empty got=empty")
    }
    if slot_addr_hex == "" {
        panic("pe_ole32_core FAIL [record_iunknown_vtable] expected=slot_addr_hex!=empty got=empty")
    }
    if ref_count < 0 {
        panic("pe_ole32_core FAIL [record_iunknown_vtable] expected=ref_count>=0 got=" + to_string(ref_count))
    }
    if status == "" {
        panic("pe_ole32_core FAIL [record_iunknown_vtable] expected=status!=empty got=empty")
    }
    let row = to_string(vt_id) + "\t" + slot_kind + "\t" + slot_addr_hex + "\t"
        + to_string(ref_count) + "\t" + status + "\n"
    pole_append_row(pole_iunknown_vtable_path(), row)
}

// ─── record_marshal_event: CoMarshalInterface/CoUnmarshalInterface/CoCreateInstanceEx row ───
fn record_marshal_event(evt_id: int, marshal_kind: str, fn_name: str, payload_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_ole32_core FAIL [record_marshal_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if marshal_kind == "" {
        panic("pe_ole32_core FAIL [record_marshal_event] expected=marshal_kind!=empty got=empty")
    }
    if fn_name == "" {
        panic("pe_ole32_core FAIL [record_marshal_event] expected=fn_name!=empty got=empty")
    }
    if payload_hex == "" {
        panic("pe_ole32_core FAIL [record_marshal_event] expected=payload_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_ole32_core FAIL [record_marshal_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + marshal_kind + "\t" + fn_name + "\t"
        + payload_hex + "\t" + status + "\n"
    pole_append_row(pole_marshal_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pole_count_rows(pole_syscall_invoke_path(), 4)
}

fn com_init_event_count() -> int {
    return pole_count_rows(pole_com_init_event_path(), 5)
}

fn iunknown_vtable_count() -> int {
    return pole_count_rows(pole_iunknown_vtable_path(), 5)
}

fn marshal_event_count() -> int {
    return pole_count_rows(pole_marshal_event_path(), 5)
}

fn pole_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(com_init_event_count())
    out.push(iunknown_vtable_count())
    out.push(marshal_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pole-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pole()

    // ─── 1. syscall_invoke × 12 (one per fn, 4 group coverage) ───
    //   COM init group (4)
    record_syscall_invoke(1, 0, "CoInitialize", "PARTIAL")
    println("__OLE32__ PARTIAL CoInitialize")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"CoInitialize\",\"fn_group\":\"com_init\",\"status\":\"PARTIAL\",\"reserved\":\"NULL\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(2, 1, "CoInitializeEx", "PARTIAL")
    println("__OLE32__ PARTIAL CoInitializeEx")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"CoInitializeEx\",\"fn_group\":\"com_init\",\"status\":\"PARTIAL\",\"dw_co_init\":\"0x00000002\",\"co_init_kind\":\"APARTMENTTHREADED\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(3, 2, "CoUninitialize", "PARTIAL")
    println("__OLE32__ PARTIAL CoUninitialize")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"CoUninitialize\",\"fn_group\":\"com_init\",\"status\":\"PARTIAL\"")
    record_syscall_invoke(4, 3, "CoCreateInstance", "PARTIAL")
    println("__OLE32__ PARTIAL CoCreateInstance")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"CoCreateInstance\",\"fn_group\":\"com_init\",\"status\":\"PARTIAL\",\"clsid_hex\":\"17000000000000000000C000000000000046\",\"clsid_name\":\"CLSID_StdMarshal\",\"iid_hex\":\"00000000000000000000C000000000000046\",\"iid_name\":\"IID_IUnknown\",\"dw_cls_context\":\"0x00000001\",\"obj_out_hex\":\"0x70030000\",\"hresult\":\"0x00000000\"")

    //   IUnknown group (3: vtable simulation slot 0/1/2)
    record_syscall_invoke(5, 4, "QueryInterface", "PARTIAL")
    println("__OLE32__ PARTIAL QueryInterface")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"QueryInterface\",\"fn_group\":\"iunknown\",\"status\":\"PARTIAL\",\"vtable_slot\":0,\"vtable_addr_hex\":\"0x70010000\",\"this_hex\":\"0x70030000\",\"iid_name\":\"IID_IClassFactory\",\"obj_out_hex\":\"0x70030100\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(6, 5, "AddRef", "PARTIAL")
    println("__OLE32__ PARTIAL AddRef")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"AddRef\",\"fn_group\":\"iunknown\",\"status\":\"PARTIAL\",\"vtable_slot\":1,\"vtable_addr_hex\":\"0x70010008\",\"this_hex\":\"0x70030000\",\"ref_count_before\":1,\"ref_count_after\":2")
    record_syscall_invoke(7, 6, "Release", "PARTIAL")
    println("__OLE32__ PARTIAL Release")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"Release\",\"fn_group\":\"iunknown\",\"status\":\"PARTIAL\",\"vtable_slot\":2,\"vtable_addr_hex\":\"0x70010010\",\"this_hex\":\"0x70030000\",\"ref_count_before\":2,\"ref_count_after\":1")

    //   COM marshal group (3)
    record_syscall_invoke(8, 7, "CoMarshalInterface", "PARTIAL")
    println("__OLE32__ PARTIAL CoMarshalInterface")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"CoMarshalInterface\",\"fn_group\":\"com_marshal\",\"status\":\"PARTIAL\",\"hstream_hex\":\"0x70020000\",\"iid_name\":\"IID_IUnknown\",\"this_hex\":\"0x70030000\",\"dest_context\":\"0x00000001\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(9, 8, "CoUnmarshalInterface", "PARTIAL")
    println("__OLE32__ PARTIAL CoUnmarshalInterface")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"CoUnmarshalInterface\",\"fn_group\":\"com_marshal\",\"status\":\"PARTIAL\",\"hstream_hex\":\"0x70020000\",\"iid_name\":\"IID_IUnknown\",\"obj_out_hex\":\"0x70030200\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(10, 9, "CoCreateInstanceEx", "PARTIAL")
    println("__OLE32__ PARTIAL CoCreateInstanceEx")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"CoCreateInstanceEx\",\"fn_group\":\"com_marshal\",\"status\":\"PARTIAL\",\"clsid_name\":\"CLSID_StdMarshal\",\"server_info_hex\":\"0x70040000\",\"multi_qi_count\":1,\"hresult\":\"0x00000000\"")

    //   Apartment group (2)
    record_syscall_invoke(11, 10, "CoGetCurrentProcess", "PARTIAL")
    println("__OLE32__ PARTIAL CoGetCurrentProcess")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"CoGetCurrentProcess\",\"fn_group\":\"apartment\",\"status\":\"PARTIAL\",\"co_process_id\":\"0x00001234\"")
    record_syscall_invoke(12, 11, "CoGetCurrentLogicalThreadId", "PARTIAL")
    println("__OLE32__ PARTIAL CoGetCurrentLogicalThreadId")
    r0_emit("pe_ole32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"CoGetCurrentLogicalThreadId\",\"fn_group\":\"apartment\",\"status\":\"PARTIAL\",\"logical_thread_id_guid_hex\":\"D34DB33F00000000C0000000000000046\",\"hresult\":\"0x00000000\"")

    // ─── 2. com_init_event × 4 (init/init_ex/uninit/create_instance) ───
    record_com_init_event(1, "co_initialize", "0x00000000", "0x00000000", "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"com_init_event\",\"evt_id\":1,\"com_kind\":\"co_initialize\",\"hresult\":\"0x00000000\",\"dw_co_init\":\"0x00000000\",\"co_init_kind\":\"DEFAULT\",\"status\":\"PARTIAL\"")
    record_com_init_event(2, "co_initialize_ex", "0x00000000", "0x00000002", "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"com_init_event\",\"evt_id\":2,\"com_kind\":\"co_initialize_ex\",\"hresult\":\"0x00000000\",\"dw_co_init\":\"0x00000002\",\"co_init_kind\":\"APARTMENTTHREADED\",\"status\":\"PARTIAL\"")
    record_com_init_event(3, "co_create_instance", "0x00000000", "0x00000001", "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"com_init_event\",\"evt_id\":3,\"com_kind\":\"co_create_instance\",\"hresult\":\"0x00000000\",\"clsid_name\":\"CLSID_StdMarshal\",\"iid_name\":\"IID_IUnknown\",\"obj_out_hex\":\"0x70030000\",\"status\":\"PARTIAL\"")
    record_com_init_event(4, "co_uninitialize", "0x00000000", "0x00000000", "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"com_init_event\",\"evt_id\":4,\"com_kind\":\"co_uninitialize\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── 3. iunknown_vtable × 3 (slot 0/1/2 — QueryInterface/AddRef/Release) ───
    record_iunknown_vtable(1, "QueryInterface", "0x70010000", 1, "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"iunknown_vtable\",\"vt_id\":1,\"slot_kind\":\"QueryInterface\",\"slot_index\":0,\"slot_addr_hex\":\"0x70010000\",\"ref_count\":1,\"this_hex\":\"0x70030000\",\"iid_name\":\"IID_IClassFactory\",\"status\":\"PARTIAL\"")
    record_iunknown_vtable(2, "AddRef", "0x70010008", 2, "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"iunknown_vtable\",\"vt_id\":2,\"slot_kind\":\"AddRef\",\"slot_index\":1,\"slot_addr_hex\":\"0x70010008\",\"ref_count\":2,\"this_hex\":\"0x70030000\",\"status\":\"PARTIAL\"")
    record_iunknown_vtable(3, "Release", "0x70010010", 1, "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"iunknown_vtable\",\"vt_id\":3,\"slot_kind\":\"Release\",\"slot_index\":2,\"slot_addr_hex\":\"0x70010010\",\"ref_count\":1,\"this_hex\":\"0x70030000\",\"status\":\"PARTIAL\"")

    // ─── 4. marshal_event × 3 (marshal/unmarshal/instance_ex) ───
    record_marshal_event(1, "marshal", "CoMarshalInterface", "0000020700000000", "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"marshal_event\",\"evt_id\":1,\"marshal_kind\":\"marshal\",\"fn_name\":\"CoMarshalInterface\",\"hstream_hex\":\"0x70020000\",\"iid_name\":\"IID_IUnknown\",\"this_hex\":\"0x70030000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_marshal_event(2, "unmarshal", "CoUnmarshalInterface", "0000020700000000", "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"marshal_event\",\"evt_id\":2,\"marshal_kind\":\"unmarshal\",\"fn_name\":\"CoUnmarshalInterface\",\"hstream_hex\":\"0x70020000\",\"iid_name\":\"IID_IUnknown\",\"obj_out_hex\":\"0x70030200\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_marshal_event(3, "instance_ex", "CoCreateInstanceEx", "0000040700000000", "PARTIAL")
    r0_emit("pe_ole32_core_record", "\"kind\":\"marshal_event\",\"evt_id\":3,\"marshal_kind\":\"instance_ex\",\"fn_name\":\"CoCreateInstanceEx\",\"clsid_name\":\"CLSID_StdMarshal\",\"server_info_hex\":\"0x70040000\",\"multi_qi_count\":1,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 12 {
        panic("pe_ole32_core FAIL [syscall_invoke_count] expected=12 got=" + to_string(si))
    }
    let ci = com_init_event_count()
    if ci != 4 {
        panic("pe_ole32_core FAIL [com_init_event_count] expected=4 got=" + to_string(ci))
    }
    let vt = iunknown_vtable_count()
    if vt != 3 {
        panic("pe_ole32_core FAIL [iunknown_vtable_count] expected=3 got=" + to_string(vt))
    }
    let me = marshal_event_count()
    if me != 3 {
        panic("pe_ole32_core FAIL [marshal_event_count] expected=3 got=" + to_string(me))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "CoInitialize" { panic("pe_ole32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(3) != "CoCreateInstance" { panic("pe_ole32_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(4) != "QueryInterface" { panic("pe_ole32_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(6) != "Release" { panic("pe_ole32_core FAIL [fn_kind_name(6)]") }
    if fn_kind_name(7) != "CoMarshalInterface" { panic("pe_ole32_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(11) != "CoGetCurrentLogicalThreadId" { panic("pe_ole32_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_ole32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "com_init" { panic("pe_ole32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "iunknown" { panic("pe_ole32_core FAIL [fn_group_name(4)]") }
    if fn_group_name(7) != "com_marshal" { panic("pe_ole32_core FAIL [fn_group_name(7)]") }
    if fn_group_name(10) != "apartment" { panic("pe_ole32_core FAIL [fn_group_name(10)]") }
    if fn_group_name(99) != "unknown" { panic("pe_ole32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pole_stats()
    if len(s) != 4 { panic("pe_ole32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 12 { panic("pe_ole32_core FAIL [stats syscall_invoke_count] expected=12 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_ole32_core FAIL [stats com_init_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_ole32_core FAIL [stats iunknown_vtable_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_ole32_core FAIL [stats marshal_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_ole32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"com_init_event_count\":" + to_string(s[1])
        + ",\"iunknown_vtable_count\":" + to_string(s[2])
        + ",\"marshal_event_count\":" + to_string(s[3]))

    r0_emit("pe_ole32_core_summary",
        "\"target\":\"OLE32.dll\",\"fn_total\":12,\"fn_emit_partial\":12,\"groups\":[\"com_init\",\"iunknown\",\"com_marshal\",\"apartment\"],\"iid_iunknown_hex\":\"00000000000000000000C000000000000046\",\"clsid_stdmarshal_hex\":\"17000000000000000000C000000000000046\",\"vtable_synth_bytes\":24,\"vtable_slots\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_ole32_core_kpi",
        "\"com_init_emits\":4,\"iunknown_emits\":3,\"com_marshal_emits\":3,\"apartment_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d3d11_d3d12_dependency_unblock_partial\":true")

    // ─── cycle 33 → 34 OLE32 coverage progression evidence emit ───
    r0_emit("pe_ole32_core_coverage_progression",
        "\"surface\":\"OLE32_full_435_fn\",\"cycle_33_count\":109,\"cycle_34_count\":121,\"delta\":12,\"cycle_33_percent\":25.06,\"cycle_34_percent\":27.82,\"cycle_34_module\":\"pe_ole32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_w3_cycle_increment\":12")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_ole32_core_round_trip_matrix",
        "\"surface\":\"OLE32_core_12_fn\",\"fn_partial\":12,\"fn_groups\":4,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real CoInitializeEx + CoCreateInstance + QueryInterface vtable + CoMarshalInterface = NSXPC bridge + NSObject vtable pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"d3d11_d3d12_dependency\":\"OLE32_COM_apartment_prerequisite\"")

    // ─── Track W3 expansion emit (cycle 34, OLE32 +12 fn) ───
    r0_emit("pe_ole32_core_w3_expansion",
        "\"track\":\"W3\",\"cycle\":34,\"surface\":\"OLE32_new\",\"new_fn\":12,\"groups\":[\"com_init\",\"iunknown\",\"com_marshal\",\"apartment\"],\"com_init_count\":4,\"iunknown_count\":3,\"com_marshal_count\":3,\"apartment_count\":2,\"emit_format\":\"__OLE32__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_ole32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pole()
    let s2 = pole_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ole32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ole32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", com_init_event=" + to_string(s[1])
        + ", iunknown_vtable=" + to_string(s[2]) + ", marshal_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pole_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("com_init_event_count\t" + to_string(s[1]))
            println("iunknown_vtable_count\t" + to_string(s[2]))
            println("marshal_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_ole32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_ole32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pole()
            println("cleaned: " + pole_dir())
            return
        }
        if sub == "dir" {
            println(pole_dir())
            return
        }
    }
    println("usage: hexa run pe_ole32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
