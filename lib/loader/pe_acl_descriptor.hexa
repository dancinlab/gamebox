// lib/loader/pe_acl_descriptor.hexa — cycle 74 Win32 SECURITY_DESCRIPTOR + ACL marshalling telemetry
//
// Win32 SECURITY_DESCRIPTOR 는 owner SID + group SID + DACL + SACL 로 구성.
// DACL (Discretionary ACL) = grant/deny rights to SIDs.
// SACL (System ACL)        = audit policy.
// ACE (Access Control Entry) = SID + access mask + ace_type.
// 본 module 은 descriptor record tracker — 실 OpenProcessToken / GetSecurityInfo 호출 X.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// acl_kind code:
//   1 = dacl
//   2 = sacl
//
// inherited code:
//   0 = explicit
//   1 = inherited from parent
//
// persist schema (TSV — descriptors.tsv):
//   desc_id<int> \t acl_kind<int> \t ace_count<int> \t inherited<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pad_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_acl_descriptor"
}

fn pad_descriptors_path() -> str {
    return pad_dir() + "/descriptors.tsv"
}

fn pad_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pad_dir() + "'")
}

fn cleanup_pad() -> void {
    pad_ensure_dir()
    let _ = exec("rm -f '" + pad_descriptors_path() + "'")
}

// ─── 공통 file IO ───
fn pad_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pad_append_row(path: str, row: str) -> void {
    pad_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_descriptor: descriptor 1 건 기록 ───
fn record_descriptor(desc_id: int, acl_kind: int, ace_count: int, inherited: int) -> void {
    if desc_id <= 0 {
        panic("pe_acl_descriptor FAIL [record_descriptor] expected=desc_id>0 got=" + to_string(desc_id))
    }
    if acl_kind < 1 {
        panic("pe_acl_descriptor FAIL [record_descriptor] expected=acl_kind>=1 got=" + to_string(acl_kind))
    }
    if acl_kind > 2 {
        panic("pe_acl_descriptor FAIL [record_descriptor] expected=acl_kind<=2 got=" + to_string(acl_kind))
    }
    if ace_count < 0 {
        panic("pe_acl_descriptor FAIL [record_descriptor] expected=ace_count>=0 got=" + to_string(ace_count))
    }
    if inherited < 0 {
        panic("pe_acl_descriptor FAIL [record_descriptor] expected=inherited>=0 got=" + to_string(inherited))
    }
    if inherited > 1 {
        panic("pe_acl_descriptor FAIL [record_descriptor] expected=inherited<=1 got=" + to_string(inherited))
    }
    let row = to_string(desc_id) + "\t" + to_string(acl_kind)
        + "\t" + to_string(ace_count) + "\t" + to_string(inherited) + "\n"
    pad_append_row(pad_descriptors_path(), row)
}

// ─── descriptor_count: total descriptor 수 ───
fn descriptor_count() -> int {
    let t = pad_read_table(pad_descriptors_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_ace_count: 모든 descriptor ace_count 합 ───
fn total_ace_count() -> int {
    let t = pad_read_table(pad_descriptors_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_acl_kind: 특정 acl_kind 의 descriptor 수 ───
fn count_by_acl_kind(kind: int) -> int {
    let t = pad_read_table(pad_descriptors_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── inherited_count: inherited=1 인 descriptor 수 ───
fn inherited_count() -> int {
    let t = pad_read_table(pad_descriptors_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── desc_ace_count: 특정 desc_id 의 ace_count (없으면 0) ───
fn desc_ace_count(desc_id: int) -> int {
    let t = pad_read_table(pad_descriptors_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == desc_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pad_stats: [descriptor_count, total_ace_count, inherited_count, count_by_acl_kind(1)] ───
fn pad_stats() -> array {
    let mut out = []
    out.push(descriptor_count())
    out.push(total_ace_count())
    out.push(inherited_count())
    out.push(count_by_acl_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pad-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pad()

    // 2. record 5 descriptors (both acl_kinds, ≥2 inherited)
    record_descriptor(740001, 1, 4, 0)
    r0_emit("pe_acl_descriptor_record",
        "\"desc_id\":740001,\"acl_kind\":1,\"ace_count\":4,\"inherited\":0,\"target\":\"dacl\"")

    record_descriptor(740002, 1, 6, 1)
    r0_emit("pe_acl_descriptor_record",
        "\"desc_id\":740002,\"acl_kind\":1,\"ace_count\":6,\"inherited\":1,\"target\":\"dacl\"")

    record_descriptor(740003, 2, 2, 0)
    r0_emit("pe_acl_descriptor_record",
        "\"desc_id\":740003,\"acl_kind\":2,\"ace_count\":2,\"inherited\":0,\"target\":\"sacl\"")

    record_descriptor(740004, 2, 3, 1)
    r0_emit("pe_acl_descriptor_record",
        "\"desc_id\":740004,\"acl_kind\":2,\"ace_count\":3,\"inherited\":1,\"target\":\"sacl\"")

    record_descriptor(740005, 1, 5, 0)
    r0_emit("pe_acl_descriptor_record",
        "\"desc_id\":740005,\"acl_kind\":1,\"ace_count\":5,\"inherited\":0,\"target\":\"dacl\"")

    // 3. descriptor_count = 5
    let c = descriptor_count()
    if c != 5 {
        panic("pe_acl_descriptor FAIL [descriptor_count] expected=5 got=" + to_string(c))
    }

    // 4. total_ace_count = 4+6+2+3+5 = 20
    let ta = total_ace_count()
    if ta != 20 {
        panic("pe_acl_descriptor FAIL [total_ace_count] expected=20 got=" + to_string(ta))
    }

    // 5. count_by_acl_kind sanity
    let k1 = count_by_acl_kind(1)
    if k1 != 3 {
        panic("pe_acl_descriptor FAIL [count_by_acl_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_acl_kind(2)
    if k2 != 2 {
        panic("pe_acl_descriptor FAIL [count_by_acl_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k99 = count_by_acl_kind(99)
    if k99 != 0 {
        panic("pe_acl_descriptor FAIL [count_by_acl_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. inherited_count = 2
    let ic = inherited_count()
    if ic != 2 {
        panic("pe_acl_descriptor FAIL [inherited_count] expected=2 got=" + to_string(ic))
    }

    // 7. desc_ace_count sanity
    let a2 = desc_ace_count(740002)
    if a2 != 6 {
        panic("pe_acl_descriptor FAIL [desc_ace_count(740002)] expected=6 got=" + to_string(a2))
    }
    let a3 = desc_ace_count(740003)
    if a3 != 2 {
        panic("pe_acl_descriptor FAIL [desc_ace_count(740003)] expected=2 got=" + to_string(a3))
    }
    let a_miss = desc_ace_count(9999)
    if a_miss != 0 {
        panic("pe_acl_descriptor FAIL [desc_ace_count(9999)] expected=0 got=" + to_string(a_miss))
    }

    // 8. pad_stats() = [5, 20, 2, 3]
    let s = pad_stats()
    if len(s) != 4 {
        panic("pe_acl_descriptor FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_acl_descriptor FAIL [stats descriptor_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 20 {
        panic("pe_acl_descriptor FAIL [stats total_ace_count] expected=20 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_acl_descriptor FAIL [stats inherited_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_acl_descriptor FAIL [stats count_kind(1)] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_acl_descriptor_stats",
        "\"descriptor_count\":" + to_string(s[0])
        + ",\"total_ace_count\":" + to_string(s[1])
        + ",\"inherited_count\":" + to_string(s[2])
        + ",\"kind_dacl\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_acl_descriptor FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pad()
    let s2 = pad_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_acl_descriptor FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_acl_descriptor self_test PASS (descriptors=" + to_string(s[0])
        + ", aces=" + to_string(s[1]) + ", inherited=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pad_stats()
            println("descriptor_count\t" + to_string(s[0]))
            println("total_ace_count\t" + to_string(s[1]))
            println("inherited_count\t" + to_string(s[2]))
            println("count_kind_dacl\t" + to_string(s[3]))
            return
        }
        if sub == "aces" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("desc_ace_count\t" + to_string(desc_ace_count(did)))
                return
            }
            println("usage: hexa run pe_acl_descriptor.hexa aces <desc_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_acl_kind\t" + to_string(count_by_acl_kind(kind)))
                return
            }
            println("usage: hexa run pe_acl_descriptor.hexa count <acl_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pad()
            println("cleaned: " + pad_dir())
            return
        }
        if sub == "dir" {
            println(pad_dir())
            return
        }
    }
    println("usage: hexa run pe_acl_descriptor.hexa { self-test | stats | aces <desc_id> | count <acl_kind> | cleanup | dir }")
}
