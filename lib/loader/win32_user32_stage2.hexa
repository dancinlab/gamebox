// lib/loader/win32_user32_stage2.hexa — Battle.net Setup USER32 imports coverage
//
// Battle.net 의 window/dialog/message/clipboard 함수. CreateWindowEx, MessageBox,
// GetMessage, ShowWindow, SetForegroundWindow 등. stage1 base 위에 추가.
//
// own 1: only `use "../perf/r0_common"` (POSIX equivalent — Wine 0 줄).
// own 2: fn self_test() + main() dispatch, headless,
//        panic("win32_user32_stage2 FAIL [<sub>] expected=X got=Y").
//
// Coverage matrix (Battle.net 50 USER32 imports):
//   stage1 covers : CreateWindowExW DestroyWindow ShowWindow MessageBoxW
//                   DispatchMessageW PostMessageW                          (6)
//   stage2 stubs  : 44 missing imports below (typed defaults).
//
// Return value convention:
//   HWND / HDC / HMENU / HICON / HCURSOR / HWINSTA / ATOM / UINT_PTR → 1
//   BOOL                                                              → 1
//   LRESULT / LONG / DWORD / int / SHORT / void-equivalent            → 0
//   특수: PeekMessageW=0 (no msg), TranslateMessage=0 (no key),
//         IsIconic=0 (not minimized), GetWindowLong/SetWindowLong=0,
//         GetSystemMetrics=0, DrawTextW=0, GetKeyState=0,
//         CharLowerA=src (return param), GetWindowThreadProcessId=7000
//
// 모든 stub 은 parameter 를 int 로 받음 — pointer 도 stage2 simulation 에선 단순 word.

use "../perf/r0_common"

// ─── stage2 stubs (44 functions, alphabetical) ───

fn AdjustWindowRectEx(rect: int, style: int, menu: int, ex: int) -> int { return 1 }
fn AllowSetForegroundWindow(pid: int) -> int { return 1 }
fn BeginPaint(hwnd: int, ps: int) -> int { return 1 }
fn CharLowerA(s: int) -> int { return s }
fn ClientToScreen(hwnd: int, pt: int) -> int { return 1 }
fn DefWindowProcW(hwnd: int, msg: int, wparam: int, lparam: int) -> int { return 0 }
fn DrawTextW(hdc: int, text: int, len: int, rect: int, fmt: int) -> int { return 0 }
fn EndPaint(hwnd: int, ps: int) -> int { return 1 }
fn GetActiveWindow() -> int { return 1 }
fn GetCursorPos(pt: int) -> int { return 1 }
fn GetDC(hwnd: int) -> int { return 1 }
fn GetDesktopWindow() -> int { return 1 }
fn GetForegroundWindow() -> int { return 1 }
fn GetKeyState(vk: int) -> int { return 0 }
fn GetProcessWindowStation() -> int { return 1 }
fn GetShellWindow() -> int { return 1 }
fn GetSystemMetrics(idx: int) -> int { return 0 }
fn GetUserObjectInformationW(obj: int, idx: int, info: int, sz: int, need: int) -> int { return 1 }
fn GetWindowDC(hwnd: int) -> int { return 1 }
fn GetWindowLongW(hwnd: int, idx: int) -> int { return 0 }
fn GetWindowRect(hwnd: int, rect: int) -> int { return 1 }
fn GetWindowThreadProcessId(hwnd: int, pid: int) -> int { return 7000 }
fn InvalidateRect(hwnd: int, rect: int, erase: int) -> int { return 1 }
fn IsIconic(hwnd: int) -> int { return 0 }
fn LoadCursorW(hmod: int, name: int) -> int { return 1 }
fn LoadIconW(hmod: int, name: int) -> int { return 1 }
fn MessageBoxA(hwnd: int, text: int, caption: int, kind: int) -> int { return 1 }
fn MoveWindow(hwnd: int, x: int, y: int, w: int, h: int, repaint: int) -> int { return 1 }
fn PeekMessageW(msg: int, hwnd: int, lo: int, hi: int, rm: int) -> int { return 0 }
fn PostQuitMessage(code: int) -> int { return 0 }
fn RegisterClassExW(wcx: int) -> int { return 1 }
fn ReleaseCapture() -> int { return 1 }
fn ReleaseDC(hwnd: int, hdc: int) -> int { return 1 }
fn ScreenToClient(hwnd: int, pt: int) -> int { return 1 }
fn SendMessageW(hwnd: int, msg: int, wparam: int, lparam: int) -> int { return 0 }
fn SetCapture(hwnd: int) -> int { return 1 }
fn SetFocus(hwnd: int) -> int { return 1 }
fn SetTimer(hwnd: int, id: int, ms: int, cb: int) -> int { return 1 }
fn SetWindowLongW(hwnd: int, idx: int, val: int) -> int { return 0 }
fn SetWindowPos(hwnd: int, after: int, x: int, y: int, w: int, h: int, flags: int) -> int { return 1 }
fn SetWindowTextW(hwnd: int, text: int) -> int { return 1 }
fn TrackMouseEvent(track: int) -> int { return 1 }
fn TranslateMessage(msg: int) -> int { return 0 }
fn UpdateLayeredWindow(hwnd: int, hdc: int, dst: int, sz: int, src: int, srcpt: int, key: int, blend: int, flags: int) -> int { return 1 }

// ─── stub names registry (for `list` subcommand) ───
fn stub_names() -> array {
    let mut a = []
    a.push("AdjustWindowRectEx")
    a.push("AllowSetForegroundWindow")
    a.push("BeginPaint")
    a.push("CharLowerA")
    a.push("ClientToScreen")
    a.push("DefWindowProcW")
    a.push("DrawTextW")
    a.push("EndPaint")
    a.push("GetActiveWindow")
    a.push("GetCursorPos")
    a.push("GetDC")
    a.push("GetDesktopWindow")
    a.push("GetForegroundWindow")
    a.push("GetKeyState")
    a.push("GetProcessWindowStation")
    a.push("GetShellWindow")
    a.push("GetSystemMetrics")
    a.push("GetUserObjectInformationW")
    a.push("GetWindowDC")
    a.push("GetWindowLongW")
    a.push("GetWindowRect")
    a.push("GetWindowThreadProcessId")
    a.push("InvalidateRect")
    a.push("IsIconic")
    a.push("LoadCursorW")
    a.push("LoadIconW")
    a.push("MessageBoxA")
    a.push("MoveWindow")
    a.push("PeekMessageW")
    a.push("PostQuitMessage")
    a.push("RegisterClassExW")
    a.push("ReleaseCapture")
    a.push("ReleaseDC")
    a.push("ScreenToClient")
    a.push("SendMessageW")
    a.push("SetCapture")
    a.push("SetFocus")
    a.push("SetTimer")
    a.push("SetWindowLongW")
    a.push("SetWindowPos")
    a.push("SetWindowTextW")
    a.push("TrackMouseEvent")
    a.push("TranslateMessage")
    a.push("UpdateLayeredWindow")
    return a
}

// ─── self_test — call each stub once with safe args ───
fn self_test() -> void {
    println("  win32_user32_stage2 self_test")

    let _ = AdjustWindowRectEx(0, 0, 0, 0)
    let _ = AllowSetForegroundWindow(0)
    let _ = BeginPaint(0, 0)
    let _ = CharLowerA(0)
    let _ = ClientToScreen(0, 0)
    let _ = DefWindowProcW(0, 0, 0, 0)
    let _ = DrawTextW(0, 0, 0, 0, 0)
    let _ = EndPaint(0, 0)
    let _ = GetActiveWindow()
    let _ = GetCursorPos(0)
    let _ = GetDC(0)
    let _ = GetDesktopWindow()
    let _ = GetForegroundWindow()
    let _ = GetKeyState(0)
    let _ = GetProcessWindowStation()
    let _ = GetShellWindow()
    let _ = GetSystemMetrics(0)
    let _ = GetUserObjectInformationW(0, 0, 0, 0, 0)
    let _ = GetWindowDC(0)
    let _ = GetWindowLongW(0, 0)
    let _ = GetWindowRect(0, 0)
    let _ = GetWindowThreadProcessId(0, 0)
    let _ = InvalidateRect(0, 0, 0)
    let _ = IsIconic(0)
    let _ = LoadCursorW(0, 0)
    let _ = LoadIconW(0, 0)
    let _ = MessageBoxA(0, 0, 0, 0)
    let _ = MoveWindow(0, 0, 0, 0, 0, 0)
    let _ = PeekMessageW(0, 0, 0, 0, 0)
    let _ = PostQuitMessage(0)
    let _ = RegisterClassExW(0)
    let _ = ReleaseCapture()
    let _ = ReleaseDC(0, 0)
    let _ = ScreenToClient(0, 0)
    let _ = SendMessageW(0, 0, 0, 0)
    let _ = SetCapture(0)
    let _ = SetFocus(0)
    let _ = SetTimer(0, 0, 0, 0)
    let _ = SetWindowLongW(0, 0, 0)
    let _ = SetWindowPos(0, 0, 0, 0, 0, 0, 0)
    let _ = SetWindowTextW(0, 0)
    let _ = TrackMouseEvent(0)
    let _ = TranslateMessage(0)
    let _ = UpdateLayeredWindow(0, 0, 0, 0, 0, 0, 0, 0, 0)

    let names = stub_names()
    let n = len(names)
    if n != 44 {
        panic("win32_user32_stage2 FAIL [stub_count] expected=44 got=" + to_string(n))
    }

    println("  ✅ win32_user32_stage2 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            let names = stub_names()
            let n = len(names)
            let i = 0
            while i < n {
                println(names[i])
                i = i + 1
            }
            return
        }
    }
    println("usage: hexa run win32_user32_stage2.hexa { self-test | list }")
}
