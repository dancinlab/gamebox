// lib/loader/win32_oleaut32_stage2.hexa — Battle.net Setup OLEAUT32 imports coverage
//
// Battle.net 의 OLE Automation 함수 — SysAllocString, SysFreeString,
// VariantInit, VariantClear 등. stage1 base 위에 Battle.net 특이 imports 추가.
//
// own 1: Wine / CrossOver / community 코드 0 줄. Microsoft OLE Automation spec 만 참조.
//   - SysAllocString: https://learn.microsoft.com/en-us/windows/win32/api/oleauto/nf-oleauto-sysallocstring
//   - SysFreeString:  https://learn.microsoft.com/en-us/windows/win32/api/oleauto/nf-oleauto-sysfreestring
//   - VariantInit:    https://learn.microsoft.com/en-us/windows/win32/api/oleauto/nf-oleauto-variantinit
//   - VariantClear:   https://learn.microsoft.com/en-us/windows/win32/api/oleauto/nf-oleauto-variantclear
//   - VarUI4FromStr:  https://learn.microsoft.com/en-us/windows/win32/api/oleauto/nf-oleauto-varui4fromstr
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실측: oleaut32s2_self_test)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("win32_oleaut32_stage2 FAIL [<sub>] expected=X got=Y")
//
// Battle.net-Setup.exe OLEAUT32 imports (DLL index 15, 실측):
//   #2   SysAllocString  (BSTR)        → return 0 (NULL BSTR)
//   #9   VariantInit     (void)        → no return
//   #26  SysFreeString   (void)        → no return
//   #411 VarUI4FromStr   (HRESULT)     → return 0 (S_OK)
//
// stage2 = stage1 의 ordinal mapping 위에 callable stub 추가.
// 실제 BSTR memory / VARIANT struct 동작은 추후 phase 에서 simulation 으로 확장.

use "../perf/r0_common"

// ─── Battle.net Setup OLEAUT32 stubs ───

// SysAllocString(LPCOLESTR psz) -> BSTR
//   BSTR / HRESULT / LPVOID → return 0
fn sys_alloc_string(psz: str) -> int {
    let _ = psz
    return 0
}

// SysFreeString(BSTR bstr) -> void
//   void → no return
fn sys_free_string(bstr: int) -> void {
    let _ = bstr
}

// VariantInit(VARIANTARG* pvarg) -> void
//   void → no return
fn variant_init(pvarg: int) -> void {
    let _ = pvarg
}

// VarUI4FromStr(LPCOLESTR strIn, LCID lcid, ULONG flags, ULONG* pulOut) -> HRESULT
//   HRESULT → return 0 (S_OK)
fn var_ui4_from_str(str_in: str, lcid: int, flags: int, p_ul_out: int) -> int {
    let _ = str_in
    let _ = lcid
    let _ = flags
    let _ = p_ul_out
    return 0
}

// ─── stub count (Battle.net 특이 imports 한정) ───
fn stub_count() -> int {
    return 4
}

// ─── stub list (name\tordinal\treturn_type) ───
fn stub_list() -> str {
    let t = ""
    t = t + "SysAllocString\t2\tBSTR\n"
    t = t + "VariantInit\t9\tvoid\n"
    t = t + "SysFreeString\t26\tvoid\n"
    t = t + "VarUI4FromStr\t411\tHRESULT\n"
    return t
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "oleaut32s2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. SysAllocString → 0 (BSTR stub)
    let bstr = sys_alloc_string("Battle.net")
    if bstr != 0 {
        panic("win32_oleaut32_stage2 FAIL [SysAllocString] expected=0 got=" + to_string(bstr))
    }

    // 2. SysFreeString → void (no return value to check, just must not panic)
    sys_free_string(bstr)

    // 3. VariantInit → void
    variant_init(0)

    // 4. VarUI4FromStr → 0 (S_OK)
    let hr = var_ui4_from_str("12345", 0, 0, 0)
    if hr != 0 {
        panic("win32_oleaut32_stage2 FAIL [VarUI4FromStr] expected=0 got=" + to_string(hr))
    }

    // 5. stub_count == 4
    let n = stub_count()
    if n != 4 {
        panic("win32_oleaut32_stage2 FAIL [stub_count] expected=4 got=" + to_string(n))
    }

    // 6. stub_list 4 줄 검증
    let lines = stub_list().split("\n")
    let i = 0
    let row_n = 0
    while i < len(lines) {
        if lines[i] != "" {
            row_n = row_n + 1
        }
        i = i + 1
    }
    if row_n != 4 {
        panic("win32_oleaut32_stage2 FAIL [stub_list rows] expected=4 got=" + to_string(row_n))
    }

    // r0_emit
    r0_emit("oleaut32s2_self_test",
        "\"stubs\":" + to_string(n)
        + ",\"bstr\":" + to_string(bstr)
        + ",\"hr\":" + to_string(hr))

    let cnt = r0_session_count(sid)
    if cnt < 1 {
        panic("win32_oleaut32_stage2 FAIL [r0 emit count] expected=>=1 got=" + to_string(cnt))
    }

    println("  ✅ win32_oleaut32_stage2 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            println(stub_list())
            return
        }
    }
    println("usage: hexa run win32_oleaut32_stage2.hexa { self-test | list }")
}
