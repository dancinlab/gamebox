// lib/loader/win32_crypt32.hexa — Phase 4m — crypt32 cert handling
//
// own 1: Wine 0. Microsoft CRYPT32 API spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe crypt32 imports (실측, 18 funcs):
//   Cert Store (4):    CertOpenStore, CertCloseStore, CertEnumCertificatesInStore,
//                      CertAddCertificateContextToStore
//   Cert Find (3):     CertFindCertificateInStore, CertDuplicateCertificateContext,
//                      CertFreeCertificateContext
//   Cert Chain (4):    CertCreateCertificateChainEngine, CertGetCertificateChain,
//                      CertFreeCertificateChain, CertFreeCertificateChainEngine
//   Cert Info (3):     CertGetNameStringA, CertGetNameStringW, CertGetCertificateContextProperty
//   Crypto Msg (2):    CryptQueryObject, CryptMsgClose, CryptMsgGetParam
//   Util (2):          CryptStringToBinaryA, (CryptDecrypt — already in advapi32)
//
// macOS 매핑: Security framework — SecCertificate, SecTrust, SecCertificateChain.
// skeleton — mapping table 만 (cert verify 우회 가능 — wintrust 와 동일 정책).

use "../perf/r0_common"

fn crypt32_table() -> str {
    let t = ""
    // Cert Store (4)
    t = t + "CertOpenStore\tSecKeychain_open\tCertStore\tskeleton\n"
    t = t + "CertCloseStore\tSecKeychain_close\tCertStore\tskeleton\n"
    t = t + "CertEnumCertificatesInStore\tSecItemCopyMatching\tCertStore\tskeleton\n"
    t = t + "CertAddCertificateContextToStore\tSecKeychainItemAdd\tCertStore\tskeleton\n"
    // Cert Find (3)
    t = t + "CertFindCertificateInStore\tSecItemCopyMatching_byProp\tCertFind\tskeleton\n"
    t = t + "CertDuplicateCertificateContext\tCFRetain\tCertFind\tskeleton\n"
    t = t + "CertFreeCertificateContext\tCFRelease\tCertFind\tskeleton\n"
    // Cert Chain (4)
    t = t + "CertCreateCertificateChainEngine\tSecPolicyCreate\tCertChain\tskeleton\n"
    t = t + "CertGetCertificateChain\tSecTrustCreateWithCertificates\tCertChain\tskeleton\n"
    t = t + "CertFreeCertificateChain\tCFRelease\tCertChain\tskeleton\n"
    t = t + "CertFreeCertificateChainEngine\tCFRelease\tCertChain\tskeleton\n"
    // Cert Info (3)
    t = t + "CertGetNameStringA\tSecCertificateCopyCommonName\tCertInfo\tskeleton\n"
    t = t + "CertGetNameStringW\tSecCertificateCopyCommonName\tCertInfo\tskeleton\n"
    t = t + "CertGetCertificateContextProperty\tSecCertificateCopyData\tCertInfo\tskeleton\n"
    // Crypto Msg (3)
    t = t + "CryptQueryObject\tCMSDecoderCreate\tCryptoMsg\tskeleton\n"
    t = t + "CryptMsgClose\tCMSDecoderRelease\tCryptoMsg\tskeleton\n"
    t = t + "CryptMsgGetParam\tCMSDecoderCopyContent\tCryptoMsg\tskeleton\n"
    // Util (1)
    t = t + "CryptStringToBinaryA\tbase64_decode\tUtil\tskeleton\n"
    return t
}

fn crypt32_table_size() -> int {
    let lines = crypt32_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = crypt32_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" { return "" }
    let parts = m.split("\t")
    if len(parts) < 2 { return "" }
    return parts[1]
}

fn crypt32_stats() -> array {
    let cats = ["CertStore", "CertFind", "CertChain", "CertInfo", "CryptoMsg", "Util"]
    let result = []
    let lines = crypt32_table().split("\n")
    let n = len(lines)
    let c = 0
    while c < len(cats) {
        let cat = cats[c]
        let total = 0
        let i = 0
        while i < n {
            if lines[i] != "" {
                let parts = lines[i].split("\t")
                if len(parts) >= 4 && parts[2] == cat {
                    total = total + 1
                }
            }
            i = i + 1
        }
        result = result + [[cat, total]]
        c = c + 1
    }
    return result
}

// ─── stub: CertGetCertificateChain — 항상 valid chain 반환 (skeleton policy) ───
fn cert_chain_verify_stub(cert_blob: str) -> int {
    return 0  // S_OK = chain valid
}

fn self_test() -> void {
    let sid = "crypt32test-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = crypt32_table_size()
    if sz != 18 { panic("win32_crypt32 FAIL [size] expected=18 got=" + to_string(sz)) }

    // category samples
    let m_store = lookup_mapping("CertOpenStore")
    if !m_store.contains("CertStore") { panic("win32_crypt32 FAIL [Store]") }

    let m_chain = lookup_mapping("CertGetCertificateChain")
    if !m_chain.contains("CertChain") { panic("win32_crypt32 FAIL [Chain]") }

    let m_msg = lookup_mapping("CryptMsgGetParam")
    if !m_msg.contains("CryptoMsg") { panic("win32_crypt32 FAIL [Msg]") }

    let m_util = lookup_mapping("CryptStringToBinaryA")
    if !m_util.contains("Util") { panic("win32_crypt32 FAIL [Util]") }

    let unk = lookup_mapping("UnknownCertFunc")
    if unk != "" { panic("win32_crypt32 FAIL [unknown]") }

    // chain stub
    let rc = cert_chain_verify_stub("fake_blob")
    if rc != 0 { panic("win32_crypt32 FAIL [chain stub] got=" + to_string(rc)) }

    // stats
    let stats = crypt32_stats()
    if len(stats) != 6 { panic("win32_crypt32 FAIL [stats categories]") }
    let total = 0
    let i = 0
    while i < len(stats) {
        total = total + stats[i][1]
        i = i + 1
    }
    if total != 18 { panic("win32_crypt32 FAIL [stats total] expected=18 got=" + to_string(total)) }

    r0_emit("crypt32_lookup", "\"name\":\"CertOpenStore\",\"category\":\"" + function_category("CertOpenStore") + "\"")
    r0_emit("crypt32_stats", "\"functions\":18,\"categories\":6")

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("win32_crypt32 FAIL [emit count]") }

    println("  ✅ win32_crypt32 self_test PASS (18 funcs, 6 categories, chain verify stub=valid, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_mapping(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_crypt32.hexa { self-test | lookup <name> }")
}
