// lib/loader/pe_wininet_extras.hexa — WININET.dll advanced surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine wininet source 인용 0.
//       wininet.dll 직접 binding 0. macOS NSHTTPCookieStorage / NSHTTPCookie /
//       NSURLCache / NSURLCredentialStorage / CFFTPStream / NSURLConnection 직접 binding 0.
//       NOTE: WININET extras 측 Battle.net Agent cookie persistence + cache mgmt +
//       FTP fallback + auth advanced; InternetSetCookieExW/GetUrlCacheEntryInfoW/
//       FtpOpenFileW/InternetSetOptionExW 측 cookie/cache/ftp/auth round-trip baseline
//       (long-horizon production smoke pending separate cycle).
//       DISTINCT from Track K2 pe_wininet_https.hexa basic (HTTP/HTTPS request flow).
//       This module covers ADVANCED extras (cookie/cache/ftp/auth).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BH3 — WININET cookie/cache/ftp/auth advanced surface 13 fn skeleton-tier.
// cycle 53 325/435 (~74.71%) → cycle 54 ~338/435 (~77.70%) (+13 fn, BH bundled part 3/4).
//
// 대상 fn (13 fn — 4 group, fn_kind 0..12):
//   COOKIE (4): InternetSetCookieW(0) / InternetGetCookieW(1) /
//               InternetSetCookieExW(2) / InternetGetCookieExW(3)
//   CACHE  (3): GetUrlCacheEntryInfoW(4) / DeleteUrlCacheEntryW(5) /
//               FindFirstUrlCacheEntryW(6)
//   FTP    (3): FtpOpenFileW(7) / FtpGetFileSize(8) / FtpFindFirstFileW(9)
//   AUTH   (3): InternetSetOptionExW(10) / InternetSetStatusCallback(11) /
//               InternetAttemptConnect(12)
//
// synthetic struct families:
//   URL_COMPONENTSW 60B nScheme INTERNET_SCHEME_HTTPS_2 + lpszHostName "us.battle.net" +
//     nPort 443 + lpszUrlPath "/oauth/token".
//   INTERNET_COOKIE_HISTORY 4B*4 fAccepted/fLeashed/fDowngraded/fRejected.
//   INTERNET_CACHE_ENTRY_INFOW 80B+ dwStructSize 80 + lpszSourceUrlName +
//     lpszLocalFileName + CacheEntryType 0x40_NORMAL_CACHE_ENTRY + dwUseCount + dwHitRate +
//     dwSizeLow / dwSizeHigh + LastModifiedTime FILETIME 8B + ExpireTime 8B + LastAccessTime 8B +
//     LastSyncTime 8B + lpHeaderInfo + dwHeaderInfoSize + lpszFileExtension + dwExemptDelta.
//   WIN32_FIND_DATAW 592B FTP listing dwFileAttributes + ftCreationTime/LastAccessTime/LastWriteTime +
//     nFileSizeHigh/Low + dwReserved0/1 + cFileName 260*WCHAR + cAlternateFileName 14*WCHAR.
//   INTERNET_BUFFERSW 56B dwStructSize + Next + lpcszHeader + dwHeadersLength + dwHeadersTotal +
//     lpvBuffer + dwBufferLength + dwBufferTotal + dwOffsetLow + dwOffsetHigh.
//
// persist schema (TSV — 5 table):
//   syscall_invoke / cookie_event / cache_event / ftp_event / auth_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwx_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_wininet_extras"
}

fn pwx_syscall_invoke_path() -> str {
    return pwx_dir() + "/syscall_invoke.tsv"
}

fn pwx_cookie_event_path() -> str {
    return pwx_dir() + "/cookie_event.tsv"
}

fn pwx_cache_event_path() -> str {
    return pwx_dir() + "/cache_event.tsv"
}

fn pwx_ftp_event_path() -> str {
    return pwx_dir() + "/ftp_event.tsv"
}

fn pwx_auth_event_path() -> str {
    return pwx_dir() + "/auth_event.tsv"
}

fn pwx_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwx_dir() + "'")
}

fn cleanup_pwx() -> void {
    pwx_ensure_dir()
    let _ = exec("rm -f '" + pwx_syscall_invoke_path() + "' '" + pwx_cookie_event_path()
        + "' '" + pwx_cache_event_path() + "' '" + pwx_ftp_event_path()
        + "' '" + pwx_auth_event_path() + "'")
}

// ─── 공통 file IO ───
fn pwx_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwx_append_row(path: str, row: str) -> void {
    pwx_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pwx_count_rows(path: str, min_cols: int) -> int {
    let t = pwx_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (13 fn coverage, fn_kind 0..12) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "InternetSetCookieW" }
    if k == 1 { return "InternetGetCookieW" }
    if k == 2 { return "InternetSetCookieExW" }
    if k == 3 { return "InternetGetCookieExW" }
    if k == 4 { return "GetUrlCacheEntryInfoW" }
    if k == 5 { return "DeleteUrlCacheEntryW" }
    if k == 6 { return "FindFirstUrlCacheEntryW" }
    if k == 7 { return "FtpOpenFileW" }
    if k == 8 { return "FtpGetFileSize" }
    if k == 9 { return "FtpFindFirstFileW" }
    if k == 10 { return "InternetSetOptionExW" }
    if k == 11 { return "InternetSetStatusCallback" }
    if k == 12 { return "InternetAttemptConnect" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "cookie"
        }
    }
    if k >= 4 {
        if k <= 6 {
            return "cache"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "ftp"
        }
    }
    if k >= 10 {
        if k <= 12 {
            return "auth"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: WININET extras fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_wininet_extras FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_wininet_extras FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 12 {
        panic("pe_wininet_extras FAIL [record_syscall_invoke] expected=fn_kind<=12 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_wininet_extras FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_wininet_extras FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pwx_append_row(pwx_syscall_invoke_path(), row)
}

// ─── record_cookie_event: SetCookie/GetCookie/SetCookieEx/GetCookieEx row ───
fn record_cookie_event(evt_id: int, c_kind: str, url: str, cookie_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_wininet_extras FAIL [record_cookie_event] evt_id<=0") }
    if c_kind == "" { panic("pe_wininet_extras FAIL [record_cookie_event] c_kind=empty") }
    if url == "" { panic("pe_wininet_extras FAIL [record_cookie_event] url=empty") }
    if cookie_synth == "" { panic("pe_wininet_extras FAIL [record_cookie_event] cookie_synth=empty") }
    if status == "" { panic("pe_wininet_extras FAIL [record_cookie_event] status=empty") }
    let row = to_string(evt_id) + "\t" + c_kind + "\t" + url + "\t" + cookie_synth + "\t" + status + "\n"
    pwx_append_row(pwx_cookie_event_path(), row)
}

