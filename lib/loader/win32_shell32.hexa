// lib/loader/win32_shell32.hexa — Phase 4d — shell32 mapping skeleton
//
// Closure path B 첫 step — Battle.net-Setup.exe 의 8 SHELL32 함수 stub.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 shell32 API spec:
//     - SHGetFolderPath:  https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/
//     - ShellExecuteEx:   https://learn.microsoft.com/en-us/windows/win32/api/shellapi/
//     - CommandLineToArgvW: https://learn.microsoft.com/en-us/windows/win32/api/shellapi/
//   macOS equivalent — NSFileManager / NSWorkspace / NSURL / posix exec*.
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 3: shell32_lookup + shell32_stats + folder_path)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만 — folder path = synthetic posix mapping)
//   - panic("win32_shell32 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 4d — skeleton):
//   8 핵심 shell32 함수의 *mapping table* + macOS-friendly synthetic responses.
//   각 entry = (Win32 함수명, 대응되는 macOS API, 카테고리, status).
//   실제 implementation (NSWorkspace.openURL / NSFileManager URLsForDirectory) 은
//   Phase 4d 후속.
//
// status:
//   "skeleton" — mapping 만 (Phase 4d 현재 모든 entry)
//   "stub"     — synthetic value 반환 (FOLDERID → POSIX path 매핑 등)
//   "impl"     — NSWorkspace / NSFileManager 실 호출 (후속)
//
// 8 함수 카테고리 (Battle.net-Setup.exe 실측 import):
//   FolderPath  3  (SHGetFolderPathW, SHGetPathFromIDListW, SHGetMalloc)
//   Execute     3  (ShellExecuteExA, ShellExecuteExW, FindExecutableA)
//   Dialog      1  (SHBrowseForFolderW)
//   Cmdline     1  (CommandLineToArgvW)
//   ──────────
//   total       8  / 4 categories
//
// SHGetFolderPathW CSIDL → macOS path 매핑 (skeleton 가짜 반환):
//   CSIDL_PROFILE       (40)  → $HOME
//   CSIDL_APPDATA       (26)  → $HOME/Library/Application Support
//   CSIDL_LOCAL_APPDATA (28)  → $HOME/Library/Caches
//   CSIDL_PROGRAM_FILES (38)  → /Applications
//   CSIDL_DESKTOP       (16)  → $HOME/Desktop
//   CSIDL_MYDOCUMENTS   (5)   → $HOME/Documents
//   CSIDL_TEMP          (32)  → /tmp
//
// 실 install 시 Battle.net 은 보통 CSIDL_LOCAL_APPDATA + CSIDL_PROGRAM_FILES 호출.

use "../perf/r0_common"

// ─── 8 함수 mapping table (TSV — name\tmacos_equiv\tcategory\tstatus) ───
fn shell32_table() -> str {
    let t = ""
    // FolderPath (3)
    t = t + "SHGetFolderPathW\tNSFileManager_URLsForDirectory\tFolderPath\tskeleton\n"
    t = t + "SHGetPathFromIDListW\tNSURL_path\tFolderPath\tskeleton\n"
    t = t + "SHGetMalloc\tposix_malloc\tFolderPath\tskeleton\n"
    // Execute (3)
    t = t + "ShellExecuteExA\tNSWorkspace_openURL\tExecute\tskeleton\n"
    t = t + "ShellExecuteExW\tNSWorkspace_openURL\tExecute\tskeleton\n"
    t = t + "FindExecutableA\tNSWorkspace_URLForApplicationToOpenURL\tExecute\tskeleton\n"
    // Dialog (1)
    t = t + "SHBrowseForFolderW\tNSOpenPanel_chooseDirectory\tDialog\tskeleton\n"
    // Cmdline (1)
    t = t + "CommandLineToArgvW\tposix_wordexp\tCmdline\tskeleton\n"
    return t
}

// ─── table line count ───
fn shell32_table_size() -> int {
    let t = shell32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ─── lookup — Win32 name → "macos_equiv\tcategory\tstatus" or "" ───
fn lookup_mapping(name: str) -> str {
    let t = shell32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3]
                }
            }
        }
        i = i + 1
    }
    return ""
}

fn function_macos_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" { return "" }
    let parts = m.split("\t")
    if len(parts) < 1 { return "" }
    return parts[0]
}

fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" { return "" }
    let parts = m.split("\t")
    if len(parts) < 2 { return "" }
    return parts[1]
}

// ─── CSIDL → macOS posix path (synthetic stub) ───
//   Battle.net-Setup.exe 가 SHGetFolderPathW(CSIDL_LOCAL_APPDATA) 같은 호출 시
//   적절한 macOS 경로 반환.
fn csidl_to_path(csidl: int) -> str {
    let home = env("HOME")
    if csidl == 40 { return home }                              // PROFILE
    if csidl == 26 { return home + "/Library/Application Support" }  // APPDATA
    if csidl == 28 { return home + "/Library/Caches" }          // LOCAL_APPDATA
    if csidl == 38 { return "/Applications" }                   // PROGRAM_FILES
    if csidl == 16 { return home + "/Desktop" }                 // DESKTOP
    if csidl == 5 { return home + "/Documents" }                // MYDOCUMENTS
    if csidl == 32 { return "/tmp" }                            // TEMP (실 stub)
    if csidl == 24 { return home + "/Library/Application Support" }  // COMMON_APPDATA
    return ""  // unknown CSIDL
}

// ─── stats per category ───
//   array of [category, total, impl_count]
fn shell32_stats() -> array {
    let t = shell32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let cats = ["FolderPath", "Execute", "Dialog", "Cmdline"]
    let result = []
    let c = 0
    while c < len(cats) {
        let cat = cats[c]
        let total = 0
        let impl = 0
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    if parts[2] == cat {
                        total = total + 1
                        if parts[3] == "impl" {
                            impl = impl + 1
                        }
                    }
                }
            }
            i = i + 1
        }
        result = result + [[cat, total, impl]]
        c = c + 1
    }
    return result
}

// ─── synthetic ShellExecute log (in-memory list) ───
let mut g_shell_exec_log = ""

fn shell_execute_log_add(verb: str, path: str) -> void {
    g_shell_exec_log = g_shell_exec_log + verb + "\t" + path + "\n"
}

fn shell_execute_log_size() -> int {
    let lines = g_shell_exec_log.split("\n")
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "shell32test-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size = 8 (Battle.net-Setup.exe 실측)
    let sz = shell32_table_size()
    if sz != 8 {
        panic("win32_shell32 FAIL [table_size] expected=8 got=" + to_string(sz))
    }

    // 2. lookup_mapping
    let m_folder = lookup_mapping("SHGetFolderPathW")
    let exp_folder = "NSFileManager_URLsForDirectory\tFolderPath\tskeleton"
    if m_folder != exp_folder {
        panic("win32_shell32 FAIL [lookup SHGetFolderPathW] expected=" + exp_folder + " got=" + m_folder)
    }
    let m_exec = lookup_mapping("ShellExecuteExA")
    let exp_exec = "NSWorkspace_openURL\tExecute\tskeleton"
    if m_exec != exp_exec {
        panic("win32_shell32 FAIL [lookup ShellExecuteExA] expected=" + exp_exec + " got=" + m_exec)
    }
    let m_cmd = lookup_mapping("CommandLineToArgvW")
    let exp_cmd = "posix_wordexp\tCmdline\tskeleton"
    if m_cmd != exp_cmd {
        panic("win32_shell32 FAIL [lookup CommandLineToArgvW] expected=" + exp_cmd + " got=" + m_cmd)
    }

    // 3. unknown → empty
    let m_unknown = lookup_mapping("NoSuchShell32Function")
    if m_unknown != "" {
        panic("win32_shell32 FAIL [lookup unknown] expected=empty got=" + m_unknown)
    }

    // 4. CSIDL stub
    let p_local = csidl_to_path(28)
    if !p_local.contains("Caches") {
        panic("win32_shell32 FAIL [csidl LOCAL_APPDATA] expected contains Caches, got=" + p_local)
    }
    let p_prog = csidl_to_path(38)
    if p_prog != "/Applications" {
        panic("win32_shell32 FAIL [csidl PROGRAM_FILES] expected=/Applications got=" + p_prog)
    }
    let p_unknown = csidl_to_path(9999)
    if p_unknown != "" {
        panic("win32_shell32 FAIL [csidl unknown] expected=empty got=" + p_unknown)
    }

    // 5. emit lookup + stats
    r0_emit("shell32_lookup", "\"name\":\"SHGetFolderPathW\",\"macos\":\"" + function_macos_equiv("SHGetFolderPathW") + "\"")

    // 6. stats
    let stats = shell32_stats()
    let cat_n = len(stats)
    if cat_n != 4 {
        panic("win32_shell32 FAIL [stats categories] expected=4 got=" + to_string(cat_n))
    }
    let i = 0
    let total_sum = 0
    let saw_folder = false
    let saw_exec = false
    while i < cat_n {
        total_sum = total_sum + stats[i][1]
        if stats[i][0] == "FolderPath" {
            saw_folder = true
            if stats[i][1] != 3 {
                panic("win32_shell32 FAIL [stats FolderPath] expected=3 got=" + to_string(stats[i][1]))
            }
        }
        if stats[i][0] == "Execute" {
            saw_exec = true
            if stats[i][1] != 3 {
                panic("win32_shell32 FAIL [stats Execute] expected=3 got=" + to_string(stats[i][1]))
            }
        }
        i = i + 1
    }
    if !saw_folder { panic("win32_shell32 FAIL [stats no FolderPath]") }
    if !saw_exec { panic("win32_shell32 FAIL [stats no Execute]") }
    if total_sum != 8 {
        panic("win32_shell32 FAIL [stats total] expected=8 got=" + to_string(total_sum))
    }
    r0_emit("shell32_stats", "\"categories\":" + to_string(cat_n) + ",\"total\":" + to_string(total_sum))

    // 7. shell_execute log
    shell_execute_log_add("open", "/Applications/Battle.net.app")
    shell_execute_log_add("runas", "/tmp/installer.tmp")
    let log_size = shell_execute_log_size()
    if log_size != 2 {
        panic("win32_shell32 FAIL [exec log size] expected=2 got=" + to_string(log_size))
    }
    r0_emit("folder_path", "\"csidl\":28,\"path\":\"" + p_local + "\"")

    let cnt = r0_session_count(sid)
    if cnt < 3 { panic("win32_shell32 FAIL [emit count] expected>=3 got=" + to_string(cnt)) }

    println("  ✅ win32_shell32 self_test PASS (8 funcs, 4 categories, " + to_string(log_size) + " exec entries, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "table" {
            println(shell32_table())
            return
        }
        if sub == "lookup" && len(a) >= 4 {
            let name = a[3]
            let r = lookup_mapping(name)
            if r == "" { println("not_found") }
            else { println(r) }
            return
        }
        if sub == "csidl" && len(a) >= 4 {
            let n = to_int(a[3])
            let p = csidl_to_path(n)
            if p == "" { println("unknown_csidl") }
            else { println(p) }
            return
        }
        if sub == "stats" {
            let s = shell32_stats()
            let i = 0
            while i < len(s) {
                println(s[i][0] + "\t" + to_string(s[i][1]) + "\t" + to_string(s[i][2]))
                i = i + 1
            }
            return
        }
    }
    println("usage: hexa run win32_shell32.hexa { self-test | table | lookup <name> | csidl <n> | stats }")
}
