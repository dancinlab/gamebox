// lib/loader/pe_command_line_parse.hexa — cycle 72 GetCommandLineW / CommandLineToArgvW telemetry skeleton
//
// PEB->ProcessParameters->CommandLine 에서 얻은 wide-char command line 을
// Win32 parsing rule (quote / backslash escape) 로 argv 배열로 분해한 결과
// 를 기록한다. parse 단위 1 row — arg_count, quoted_arg_count, total_chars.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 parse outcome tracker — 실 GetCommandLineW() / CommandLineToArgvW()
//   호출 X (stage6 native bridge 에서 수행).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// persist schema (TSV — parses.tsv):
//   parse_id<int> \t arg_count<int> \t quoted_arg_count<int> \t total_chars<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pclp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_command_line_parse"
}

fn pclp_parses_path() -> str {
    return pclp_dir() + "/parses.tsv"
}

fn pclp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pclp_dir() + "'")
}

fn cleanup_pclp() -> void {
    pclp_ensure_dir()
    let _ = exec("rm -f '" + pclp_parses_path() + "'")
}

// ─── 공통 file IO ───
fn pclp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pclp_append_row(path: str, row: str) -> void {
    pclp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_parse: command line parse 1 건 기록 ───
fn record_parse(parse_id: int, arg_count: int, quoted_arg_count: int, total_chars: int) -> void {
    if parse_id <= 0 {
        panic("pe_command_line_parse FAIL [record_parse] expected=parse_id>0 got=" + to_string(parse_id))
    }
    if arg_count < 1 {
        panic("pe_command_line_parse FAIL [record_parse] expected=arg_count>=1 got=" + to_string(arg_count))
    }
    if quoted_arg_count < 0 {
        panic("pe_command_line_parse FAIL [record_parse] expected=quoted_arg_count>=0 got=" + to_string(quoted_arg_count))
    }
    if quoted_arg_count > arg_count {
        panic("pe_command_line_parse FAIL [record_parse] expected=quoted_arg_count<=arg_count got=" + to_string(quoted_arg_count))
    }
    if total_chars < 0 {
        panic("pe_command_line_parse FAIL [record_parse] expected=total_chars>=0 got=" + to_string(total_chars))
    }
    let row = to_string(parse_id) + "\t" + to_string(arg_count)
        + "\t" + to_string(quoted_arg_count) + "\t" + to_string(total_chars) + "\n"
    pclp_append_row(pclp_parses_path(), row)
}

// ─── parse_count: total parse 수 ───
fn parse_count() -> int {
    let t = pclp_read_table(pclp_parses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_args: 모든 parse arg_count 합 ───
fn total_args() -> int {
    let t = pclp_read_table(pclp_parses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_quoted_args: 모든 parse quoted_arg_count 합 ───
fn total_quoted_args() -> int {
    let t = pclp_read_table(pclp_parses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_chars: 모든 parse total_chars 합 ───
fn total_chars() -> int {
    let t = pclp_read_table(pclp_parses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_arg_count: 특정 arg_count 의 parse 수 ───
fn count_by_arg_count(target: int) -> int {
    let t = pclp_read_table(pclp_parses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == target {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── parse_total_chars: 특정 parse_id 의 total_chars (없으면 0) ───
fn parse_total_chars(parse_id: int) -> int {
    let t = pclp_read_table(pclp_parses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == parse_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pclp_stats: [parse_count, total_args, total_quoted_args, total_chars] ───
fn pclp_stats() -> array {
    let mut out = []
    out.push(parse_count())
    out.push(total_args())
    out.push(total_quoted_args())
    out.push(total_chars())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pclp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pclp()

    // 2. record 5 parses (arg_count 1, 2, 3, 5, 8)
    //    quoted_arg_count <= arg_count, total_chars synthetic
    record_parse(120001, 1, 0, 12)
    r0_emit("pe_command_line_parse_record",
        "\"parse_id\":120001,\"arg_count\":1,\"quoted_arg_count\":0,\"total_chars\":12")

    record_parse(120002, 2, 1, 32)
    r0_emit("pe_command_line_parse_record",
        "\"parse_id\":120002,\"arg_count\":2,\"quoted_arg_count\":1,\"total_chars\":32")

    record_parse(120003, 3, 2, 48)
    r0_emit("pe_command_line_parse_record",
        "\"parse_id\":120003,\"arg_count\":3,\"quoted_arg_count\":2,\"total_chars\":48")

    record_parse(120004, 5, 2, 96)
    r0_emit("pe_command_line_parse_record",
        "\"parse_id\":120004,\"arg_count\":5,\"quoted_arg_count\":2,\"total_chars\":96")

    record_parse(120005, 8, 3, 160)
    r0_emit("pe_command_line_parse_record",
        "\"parse_id\":120005,\"arg_count\":8,\"quoted_arg_count\":3,\"total_chars\":160")

    // 3. parse_count = 5
    let c = parse_count()
    if c != 5 {
        panic("pe_command_line_parse FAIL [parse_count] expected=5 got=" + to_string(c))
    }

    // 4. total_args = 1+2+3+5+8 = 19
    let ta = total_args()
    if ta != 19 {
        panic("pe_command_line_parse FAIL [total_args] expected=19 got=" + to_string(ta))
    }

    // 5. total_quoted_args = 0+1+2+2+3 = 8
    let tq = total_quoted_args()
    if tq != 8 {
        panic("pe_command_line_parse FAIL [total_quoted_args] expected=8 got=" + to_string(tq))
    }

    // 6. total_chars = 12+32+48+96+160 = 348
    let tc = total_chars()
    if tc != 348 {
        panic("pe_command_line_parse FAIL [total_chars] expected=348 got=" + to_string(tc))
    }

    // 7. count_by_arg_count sanity
    let a1 = count_by_arg_count(1)
    if a1 != 1 {
        panic("pe_command_line_parse FAIL [count_by_arg_count(1)] expected=1 got=" + to_string(a1))
    }
    let a2 = count_by_arg_count(2)
    if a2 != 1 {
        panic("pe_command_line_parse FAIL [count_by_arg_count(2)] expected=1 got=" + to_string(a2))
    }
    let a3 = count_by_arg_count(3)
    if a3 != 1 {
        panic("pe_command_line_parse FAIL [count_by_arg_count(3)] expected=1 got=" + to_string(a3))
    }
    let a5 = count_by_arg_count(5)
    if a5 != 1 {
        panic("pe_command_line_parse FAIL [count_by_arg_count(5)] expected=1 got=" + to_string(a5))
    }
    let a8 = count_by_arg_count(8)
    if a8 != 1 {
        panic("pe_command_line_parse FAIL [count_by_arg_count(8)] expected=1 got=" + to_string(a8))
    }
    let a99 = count_by_arg_count(99)
    if a99 != 0 {
        panic("pe_command_line_parse FAIL [count_by_arg_count(99)] expected=0 got=" + to_string(a99))
    }

    // 8. parse_total_chars sanity
    let p3 = parse_total_chars(120003)
    if p3 != 48 {
        panic("pe_command_line_parse FAIL [parse_total_chars(120003)] expected=48 got=" + to_string(p3))
    }
    let p5 = parse_total_chars(120005)
    if p5 != 160 {
        panic("pe_command_line_parse FAIL [parse_total_chars(120005)] expected=160 got=" + to_string(p5))
    }
    let p_miss = parse_total_chars(9999)
    if p_miss != 0 {
        panic("pe_command_line_parse FAIL [parse_total_chars(9999)] expected=0 got=" + to_string(p_miss))
    }

    // 9. pclp_stats() = [5, 19, 8, 348]
    let s = pclp_stats()
    if len(s) != 4 {
        panic("pe_command_line_parse FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_command_line_parse FAIL [stats parse_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 19 {
        panic("pe_command_line_parse FAIL [stats total_args] expected=19 got=" + to_string(s[1]))
    }
    if s[2] != 8 {
        panic("pe_command_line_parse FAIL [stats total_quoted_args] expected=8 got=" + to_string(s[2]))
    }
    if s[3] != 348 {
        panic("pe_command_line_parse FAIL [stats total_chars] expected=348 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_command_line_parse_stats",
        "\"parse_count\":" + to_string(s[0])
        + ",\"total_args\":" + to_string(s[1])
        + ",\"total_quoted_args\":" + to_string(s[2])
        + ",\"total_chars\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_command_line_parse FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pclp()
    let s2 = pclp_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_command_line_parse FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_command_line_parse self_test PASS (parses=" + to_string(s[0])
        + ", args=" + to_string(s[1]) + ", quoted=" + to_string(s[2])
        + ", chars=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pclp_stats()
            println("parse_count\t" + to_string(s[0]))
            println("total_args\t" + to_string(s[1]))
            println("total_quoted_args\t" + to_string(s[2]))
            println("total_chars\t" + to_string(s[3]))
            return
        }
        if sub == "chars" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                println("parse_total_chars\t" + to_string(parse_total_chars(pid)))
                return
            }
            println("usage: hexa run pe_command_line_parse.hexa chars <parse_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let target = to_int(a[3])
                println("count_by_arg_count\t" + to_string(count_by_arg_count(target)))
                return
            }
            println("usage: hexa run pe_command_line_parse.hexa count <arg_count>")
            return
        }
        if sub == "cleanup" {
            cleanup_pclp()
            println("cleaned: " + pclp_dir())
            return
        }
        if sub == "dir" {
            println(pclp_dir())
            return
        }
    }
    println("usage: hexa run pe_command_line_parse.hexa { self-test | stats | chars <parse_id> | count <arg_count> | cleanup | dir }")
}
