// lib/loader/pe_dxgi_core.hexa — DXGI.dll swap chain surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine dxgi source 측 코드 인용 0. dxgi.dll 직접 binding 0. D3DMetal binary 측 link
//       binding 0. DirectX SDK / agility SDK 측 import 0. dxgi.h / dxgi1_2.h reference shape
//       만 (IDXGIFactory / IDXGISwapChain / IDXGIAdapter / DXGI_SWAP_CHAIN_DESC / DXGI_ADAPTER_DESC).
//       실 CreateDXGIFactory / 실 IDXGIFactory::CreateSwapChain / 실 IDXGISwapChain::Present /
//       실 IDXGIAdapter::EnumOutputs = 미수행. NOTE: DXGI 는 D3D11/12 device creation
//       prerequisite, 본 module 측 D2R cond.3 partial → met path baseline (long-horizon 측
//       D3DMetal binary licence 측 dependent).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AH4 — DXGI (dxgi.dll) swap chain surface coverage 10 fn (skeleton row 만).
// Track AH3 predecessor (COMCTL32 10 fn cycle 38) 후 본 Track AH4 는 DXGI 측 factory +
// swapchain + adapter baseline land. cycle 38 측 166/435 (~38.16%) → cycle 39 측 ~176/435
// (~40.46%) coverage progression (+10 fn 신규, Track AH bundled cycle 36-39 측 AH4 row,
// 마지막 row, D3D11 prerequisite).
//
// 대상 fn (10 fn — 3 group, fn_kind 0..9 canonical map):
//   FACTORY    (3): CreateDXGIFactory(0) / CreateDXGIFactory2(1) /
//                   IDXGIFactory_EnumAdapters(2)
//   SWAPCHAIN  (4): IDXGIFactory_CreateSwapChain(3) / IDXGISwapChain_Present(4) /
//                   IDXGISwapChain_ResizeBuffers(5) / IDXGISwapChain_GetBuffer(6)
//   ADAPTER    (3): IDXGIAdapter_EnumOutputs(7) / IDXGIAdapter_GetDesc(8) /
//                   IDXGIAdapter_CheckInterfaceSupport(9)
//
// synthetic IID 16 byte LE GUID:
//   IID_IDXGIFactory     "7B7166EC-21C7-44AE-B21A-C9AE321AE369"  (LE bytes)
//   IID_IDXGIFactory2    "50C83A1C-E072-4C48-87B0-3630FA36A6D0"
//   IID_IDXGISwapChain   "310D36A0-D2E7-4C0A-AA04-6A9D23B8886A"
//   IID_IDXGIAdapter     "2411E7E1-12AC-4CCF-BD14-9798E8534DC0"
// synthetic DXGI_SWAP_CHAIN_DESC (104 byte, simplified):
//   BufferDesc.Width 1920 / Height 1080 / RefreshRate.Numerator 60 / Denominator 1 /
//   Format DXGI_FORMAT_R8G8B8A8_UNORM (28) / SampleDesc.Count 1 / BufferUsage 0x00000020
//   (DXGI_USAGE_RENDER_TARGET_OUTPUT) / BufferCount 2 / SwapEffect DXGI_SWAP_EFFECT_DISCARD (0)
//   / Windowed TRUE.
// synthetic DXGI_ADAPTER_DESC (308 byte, simplified):
//   Description WCHAR[128] "Apple M-series Synthetic Adapter" UTF-16 LE / VendorId 0x000010DE /
//   DeviceId 0x00002684 / SubSysId 0x00000000 / Revision 0x00000000 / DedicatedVideoMemory
//   0x80000000 (2GB) / DedicatedSystemMemory 0 / SharedSystemMemory 0x40000000 (1GB) /
//   AdapterLuid 0x0000000000010001.
// synthetic IDXGIFactory/SwapChain/Adapter handles family:
//   IDXGIFactory*  0x93010000   IDXGIFactory2*  0x93010100
//   IDXGISwapChain* 0x93020000  IDXGIAdapter* 0x93030000  IDXGIOutput* 0x93040000
//
// persist schema (TSV — 4 table): syscall_invoke / dxgi_factory_event / dxgi_swapchain_event / dxgi_adapter_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdx_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dxgi_core"
}

fn pdx_syscall_invoke_path() -> str {
    return pdx_dir() + "/syscall_invoke.tsv"
}

fn pdx_factory_event_path() -> str {
    return pdx_dir() + "/dxgi_factory_event.tsv"
}

fn pdx_swapchain_event_path() -> str {
    return pdx_dir() + "/dxgi_swapchain_event.tsv"
}

fn pdx_adapter_event_path() -> str {
    return pdx_dir() + "/dxgi_adapter_event.tsv"
}

fn pdx_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdx_dir() + "'")
}

fn cleanup_pdx() -> void {
    pdx_ensure_dir()
    let _ = exec("rm -f '" + pdx_syscall_invoke_path() + "' '" + pdx_factory_event_path()
        + "' '" + pdx_swapchain_event_path() + "' '" + pdx_adapter_event_path() + "'")
}

// ─── 공통 file IO ───
fn pdx_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdx_append_row(path: str, row: str) -> void {
    pdx_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pdx_count_rows(path: str, min_cols: int) -> int {
    let t = pdx_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "CreateDXGIFactory" }
    if k == 1 { return "CreateDXGIFactory2" }
    if k == 2 { return "IDXGIFactory_EnumAdapters" }
    if k == 3 { return "IDXGIFactory_CreateSwapChain" }
    if k == 4 { return "IDXGISwapChain_Present" }
    if k == 5 { return "IDXGISwapChain_ResizeBuffers" }
    if k == 6 { return "IDXGISwapChain_GetBuffer" }
    if k == 7 { return "IDXGIAdapter_EnumOutputs" }
    if k == 8 { return "IDXGIAdapter_GetDesc" }
    if k == 9 { return "IDXGIAdapter_CheckInterfaceSupport" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "factory"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "swapchain"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "adapter"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: DXGI fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_dxgi_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_dxgi_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_dxgi_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_dxgi_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_dxgi_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pdx_append_row(pdx_syscall_invoke_path(), row)
}

// ─── record_factory_event: CreateDXGIFactory/Factory2/EnumAdapters row ───
fn record_factory_event(evt_id: int, factory_kind: str, iid_synth: str, factory_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_dxgi_core FAIL [record_factory_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if factory_kind == "" {
        panic("pe_dxgi_core FAIL [record_factory_event] expected=factory_kind!=empty got=empty")
    }
    if iid_synth == "" {
        panic("pe_dxgi_core FAIL [record_factory_event] expected=iid_synth!=empty got=empty")
    }
    if factory_hex == "" {
        panic("pe_dxgi_core FAIL [record_factory_event] expected=factory_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_dxgi_core FAIL [record_factory_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + factory_kind + "\t" + iid_synth + "\t"
        + factory_hex + "\t" + status + "\n"
    pdx_append_row(pdx_factory_event_path(), row)
}

// ─── record_swapchain_event: CreateSwapChain/Present/ResizeBuffers/GetBuffer row ───
fn record_swapchain_event(evt_id: int, sc_kind: str, swapchain_hex: str, buffer_index: int, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_dxgi_core FAIL [record_swapchain_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if sc_kind == "" {
        panic("pe_dxgi_core FAIL [record_swapchain_event] expected=sc_kind!=empty got=empty")
    }
    if swapchain_hex == "" {
        panic("pe_dxgi_core FAIL [record_swapchain_event] expected=swapchain_hex!=empty got=empty")
    }
    if buffer_index < 0 {
        panic("pe_dxgi_core FAIL [record_swapchain_event] expected=buffer_index>=0 got=" + to_string(buffer_index))
    }
    if status == "" {
        panic("pe_dxgi_core FAIL [record_swapchain_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + sc_kind + "\t" + swapchain_hex + "\t"
        + to_string(buffer_index) + "\t" + status + "\n"
    pdx_append_row(pdx_swapchain_event_path(), row)
}

// ─── record_adapter_event: EnumOutputs/GetDesc/CheckInterfaceSupport row ───
fn record_adapter_event(evt_id: int, ad_kind: str, adapter_hex: str, descriptor_synth: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_dxgi_core FAIL [record_adapter_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if ad_kind == "" {
        panic("pe_dxgi_core FAIL [record_adapter_event] expected=ad_kind!=empty got=empty")
    }
    if adapter_hex == "" {
        panic("pe_dxgi_core FAIL [record_adapter_event] expected=adapter_hex!=empty got=empty")
    }
    if descriptor_synth == "" {
        panic("pe_dxgi_core FAIL [record_adapter_event] expected=descriptor_synth!=empty got=empty")
    }
    if status == "" {
        panic("pe_dxgi_core FAIL [record_adapter_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + ad_kind + "\t" + adapter_hex + "\t"
        + descriptor_synth + "\t" + status + "\n"
    pdx_append_row(pdx_adapter_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pdx_count_rows(pdx_syscall_invoke_path(), 4)
}

fn factory_event_count() -> int {
    return pdx_count_rows(pdx_factory_event_path(), 5)
}

fn swapchain_event_count() -> int {
    return pdx_count_rows(pdx_swapchain_event_path(), 5)
}

fn adapter_event_count() -> int {
    return pdx_count_rows(pdx_adapter_event_path(), 5)
}

fn pdx_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(factory_event_count())
    out.push(swapchain_event_count())
    out.push(adapter_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pdx-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pdx()

    // ─── 1. syscall_invoke × 10 (one per fn, 3 group coverage) ───
    //   FACTORY group (3)
    record_syscall_invoke(1, 0, "CreateDXGIFactory", "PARTIAL")
    println("__DXGI__ PARTIAL CreateDXGIFactory")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"CreateDXGIFactory\",\"fn_group\":\"factory\",\"status\":\"PARTIAL\",\"riid_synth\":\"IID_IDXGIFactory_7B7166EC\",\"iid_synth_bytes\":16,\"factory_out_hex\":\"0x93010000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(2, 1, "CreateDXGIFactory2", "PARTIAL")
    println("__DXGI__ PARTIAL CreateDXGIFactory2")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"CreateDXGIFactory2\",\"fn_group\":\"factory\",\"status\":\"PARTIAL\",\"flags\":\"0x00000001\",\"flags_kind\":\"DXGI_CREATE_FACTORY_DEBUG\",\"riid_synth\":\"IID_IDXGIFactory2_50C83A1C\",\"iid_synth_bytes\":16,\"factory_out_hex\":\"0x93010100\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(3, 2, "IDXGIFactory_EnumAdapters", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGIFactory_EnumAdapters")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"IDXGIFactory_EnumAdapters\",\"fn_group\":\"factory\",\"status\":\"PARTIAL\",\"factory_hex\":\"0x93010000\",\"adapter_index\":0,\"adapter_out_hex\":\"0x93030000\",\"hresult\":\"0x00000000\"")

    //   SWAPCHAIN group (4)
    record_syscall_invoke(4, 3, "IDXGIFactory_CreateSwapChain", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGIFactory_CreateSwapChain")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"IDXGIFactory_CreateSwapChain\",\"fn_group\":\"swapchain\",\"status\":\"PARTIAL\",\"factory_hex\":\"0x93010000\",\"device_hex\":\"0x94000000\",\"swapchain_desc_hex\":\"0x93020100\",\"struct_bytes\":104,\"width\":1920,\"height\":1080,\"format\":\"DXGI_FORMAT_R8G8B8A8_UNORM_28\",\"buffer_count\":2,\"swap_effect\":\"DXGI_SWAP_EFFECT_DISCARD_0\",\"swapchain_out_hex\":\"0x93020000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(5, 4, "IDXGISwapChain_Present", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGISwapChain_Present")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"IDXGISwapChain_Present\",\"fn_group\":\"swapchain\",\"status\":\"PARTIAL\",\"swapchain_hex\":\"0x93020000\",\"sync_interval\":1,\"flags\":\"0x00000000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(6, 5, "IDXGISwapChain_ResizeBuffers", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGISwapChain_ResizeBuffers")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"IDXGISwapChain_ResizeBuffers\",\"fn_group\":\"swapchain\",\"status\":\"PARTIAL\",\"swapchain_hex\":\"0x93020000\",\"buffer_count\":2,\"width\":2560,\"height\":1440,\"format\":\"DXGI_FORMAT_R8G8B8A8_UNORM_28\",\"flags\":\"0x00000000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(7, 6, "IDXGISwapChain_GetBuffer", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGISwapChain_GetBuffer")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"IDXGISwapChain_GetBuffer\",\"fn_group\":\"swapchain\",\"status\":\"PARTIAL\",\"swapchain_hex\":\"0x93020000\",\"buffer_index\":0,\"riid_synth\":\"IID_ID3D11Texture2D_6F15AAF2\",\"buffer_out_hex\":\"0x93020400\",\"hresult\":\"0x00000000\"")

    //   ADAPTER group (3)
    record_syscall_invoke(8, 7, "IDXGIAdapter_EnumOutputs", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGIAdapter_EnumOutputs")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"IDXGIAdapter_EnumOutputs\",\"fn_group\":\"adapter\",\"status\":\"PARTIAL\",\"adapter_hex\":\"0x93030000\",\"output_index\":0,\"output_out_hex\":\"0x93040000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(9, 8, "IDXGIAdapter_GetDesc", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGIAdapter_GetDesc")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"IDXGIAdapter_GetDesc\",\"fn_group\":\"adapter\",\"status\":\"PARTIAL\",\"adapter_hex\":\"0x93030000\",\"adapter_desc_hex\":\"0x93030400\",\"struct_bytes\":308,\"description_synth\":\"Apple M-series Synthetic Adapter\",\"vendor_id\":\"0x000010DE\",\"device_id\":\"0x00002684\",\"dedicated_video_memory\":\"0x80000000\",\"shared_system_memory\":\"0x40000000\",\"adapter_luid\":\"0x0000000000010001\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(10, 9, "IDXGIAdapter_CheckInterfaceSupport", "PARTIAL")
    println("__DXGI__ PARTIAL IDXGIAdapter_CheckInterfaceSupport")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"IDXGIAdapter_CheckInterfaceSupport\",\"fn_group\":\"adapter\",\"status\":\"PARTIAL\",\"adapter_hex\":\"0x93030000\",\"interface_name_synth\":\"IDXGIDevice\",\"umd_version_hex\":\"0x000B000000000000\",\"hresult\":\"0x00000000\"")

    // ─── 2. dxgi_factory_event × 3 (factory_v1/v2/enum_adapters) ───
    record_factory_event(1, "factory_v1", "IID_IDXGIFactory_7B7166EC", "0x93010000", "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_factory_event\",\"evt_id\":1,\"factory_kind\":\"factory_v1\",\"iid_synth\":\"IID_IDXGIFactory_7B7166EC\",\"iid_synth_bytes\":16,\"factory_hex\":\"0x93010000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_factory_event(2, "factory_v2_debug", "IID_IDXGIFactory2_50C83A1C", "0x93010100", "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_factory_event\",\"evt_id\":2,\"factory_kind\":\"factory_v2_debug\",\"iid_synth\":\"IID_IDXGIFactory2_50C83A1C\",\"iid_synth_bytes\":16,\"factory_hex\":\"0x93010100\",\"flags\":\"0x00000001\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_factory_event(3, "enum_adapters_index_0", "IID_IDXGIAdapter_2411E7E1", "0x93030000", "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_factory_event\",\"evt_id\":3,\"factory_kind\":\"enum_adapters_index_0\",\"iid_synth\":\"IID_IDXGIAdapter_2411E7E1\",\"factory_hex\":\"0x93010000\",\"adapter_index\":0,\"adapter_out_hex\":\"0x93030000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── 3. dxgi_swapchain_event × 4 (create/present/resize/get_buffer) ───
    record_swapchain_event(1, "create_swapchain_1080p_2buf", "0x93020000", 0, "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_swapchain_event\",\"evt_id\":1,\"sc_kind\":\"create_swapchain_1080p_2buf\",\"swapchain_hex\":\"0x93020000\",\"swapchain_desc_hex\":\"0x93020100\",\"struct_bytes\":104,\"width\":1920,\"height\":1080,\"format\":\"DXGI_FORMAT_R8G8B8A8_UNORM_28\",\"buffer_count\":2,\"buffer_index\":0,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_swapchain_event(2, "present_vsync_1", "0x93020000", 0, "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_swapchain_event\",\"evt_id\":2,\"sc_kind\":\"present_vsync_1\",\"swapchain_hex\":\"0x93020000\",\"sync_interval\":1,\"flags\":\"0x00000000\",\"buffer_index\":0,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_swapchain_event(3, "resize_buffers_1440p", "0x93020000", 0, "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_swapchain_event\",\"evt_id\":3,\"sc_kind\":\"resize_buffers_1440p\",\"swapchain_hex\":\"0x93020000\",\"width\":2560,\"height\":1440,\"buffer_count\":2,\"format\":\"DXGI_FORMAT_R8G8B8A8_UNORM_28\",\"buffer_index\":0,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_swapchain_event(4, "get_buffer_index_0", "0x93020400", 0, "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_swapchain_event\",\"evt_id\":4,\"sc_kind\":\"get_buffer_index_0\",\"swapchain_hex\":\"0x93020000\",\"buffer_index\":0,\"buffer_out_hex\":\"0x93020400\",\"riid_synth\":\"IID_ID3D11Texture2D_6F15AAF2\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── 4. dxgi_adapter_event × 3 (enum_outputs/get_desc/check_interface) ───
    record_adapter_event(1, "enum_outputs_index_0", "0x93030000", "IDXGIOutput*0x93040000", "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_adapter_event\",\"evt_id\":1,\"ad_kind\":\"enum_outputs_index_0\",\"adapter_hex\":\"0x93030000\",\"output_index\":0,\"output_out_hex\":\"0x93040000\",\"descriptor_synth\":\"IDXGIOutput*0x93040000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_adapter_event(2, "get_desc_apple_m_series", "0x93030000", "Apple M-series Synthetic Adapter|0x000010DE|0x80000000", "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_adapter_event\",\"evt_id\":2,\"ad_kind\":\"get_desc_apple_m_series\",\"adapter_hex\":\"0x93030000\",\"adapter_desc_hex\":\"0x93030400\",\"struct_bytes\":308,\"description_synth\":\"Apple M-series Synthetic Adapter\",\"vendor_id\":\"0x000010DE\",\"device_id\":\"0x00002684\",\"dedicated_video_memory\":\"0x80000000\",\"shared_system_memory\":\"0x40000000\",\"adapter_luid\":\"0x0000000000010001\",\"descriptor_synth\":\"Apple M-series Synthetic Adapter|0x000010DE|0x80000000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_adapter_event(3, "check_interface_idxgidevice", "0x93030000", "IDXGIDevice|umd_0x000B000000000000", "PARTIAL")
    r0_emit("pe_dxgi_core_record", "\"kind\":\"dxgi_adapter_event\",\"evt_id\":3,\"ad_kind\":\"check_interface_idxgidevice\",\"adapter_hex\":\"0x93030000\",\"interface_name_synth\":\"IDXGIDevice\",\"umd_version_hex\":\"0x000B000000000000\",\"descriptor_synth\":\"IDXGIDevice|umd_0x000B000000000000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_dxgi_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let fe = factory_event_count()
    if fe != 3 {
        panic("pe_dxgi_core FAIL [factory_event_count] expected=3 got=" + to_string(fe))
    }
    let sce = swapchain_event_count()
    if sce != 4 {
        panic("pe_dxgi_core FAIL [swapchain_event_count] expected=4 got=" + to_string(sce))
    }
    let ae = adapter_event_count()
    if ae != 3 {
        panic("pe_dxgi_core FAIL [adapter_event_count] expected=3 got=" + to_string(ae))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "CreateDXGIFactory" { panic("pe_dxgi_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(1) != "CreateDXGIFactory2" { panic("pe_dxgi_core FAIL [fn_kind_name(1)]") }
    if fn_kind_name(3) != "IDXGIFactory_CreateSwapChain" { panic("pe_dxgi_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(4) != "IDXGISwapChain_Present" { panic("pe_dxgi_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(7) != "IDXGIAdapter_EnumOutputs" { panic("pe_dxgi_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(9) != "IDXGIAdapter_CheckInterfaceSupport" { panic("pe_dxgi_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_dxgi_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "factory" { panic("pe_dxgi_core FAIL [fn_group_name(0)]") }
    if fn_group_name(3) != "swapchain" { panic("pe_dxgi_core FAIL [fn_group_name(3)]") }
    if fn_group_name(7) != "adapter" { panic("pe_dxgi_core FAIL [fn_group_name(7)]") }
    if fn_group_name(99) != "unknown" { panic("pe_dxgi_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pdx_stats()
    if len(s) != 4 { panic("pe_dxgi_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_dxgi_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 3 { panic("pe_dxgi_core FAIL [stats factory_event_count] expected=3 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_dxgi_core FAIL [stats swapchain_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_dxgi_core FAIL [stats adapter_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_dxgi_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"factory_event_count\":" + to_string(s[1])
        + ",\"swapchain_event_count\":" + to_string(s[2])
        + ",\"adapter_event_count\":" + to_string(s[3]))

    r0_emit("pe_dxgi_core_summary",
        "\"target\":\"DXGI.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"factory\",\"swapchain\",\"adapter\"],\"iid_guid_synth_bytes\":16,\"swapchain_desc_synth_bytes\":104,\"adapter_desc_synth_bytes\":308,\"d3d11_prerequisite\":true,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_dxgi_core_kpi",
        "\"factory_emits\":3,\"swapchain_emits\":4,\"adapter_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d3d11_prerequisite_unblock_partial\":true,\"d3dmetal_binary_licence_dependent_long_horizon\":true")

    // ─── cycle 38 → 39 DXGI coverage progression evidence emit ───
    r0_emit("pe_dxgi_core_coverage_progression",
        "\"surface\":\"DXGI_full_435_fn\",\"cycle_38_count\":166,\"cycle_39_count\":176,\"delta\":10,\"cycle_38_percent\":38.16,\"cycle_39_percent\":40.46,\"cycle_39_module\":\"pe_dxgi_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_ah4_cycle_increment\":10,\"track_ah_bundled_total_delta\":44")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_dxgi_core_round_trip_matrix",
        "\"surface\":\"DXGI_core_10_fn\",\"fn_partial\":10,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real CreateDXGIFactory + CreateSwapChain + Present = D3DMetal binary licence dependent + Metal CAMetalLayer bridge pending separate cycle (long-horizon)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"d3d11_prerequisite\":\"DXGI factory + swapchain = D3D11CreateDeviceAndSwapChain dependency baseline\",\"d2r_cond3_partial_to_met_path\":\"long_horizon_d3dmetal_binary_licence_dependent\"")

    // ─── Track AH4 expansion emit (cycle 39, DXGI +10 fn) ───
    r0_emit("pe_dxgi_core_ah4_expansion",
        "\"track\":\"AH4\",\"cycle\":39,\"surface\":\"DXGI_new\",\"new_fn\":10,\"groups\":[\"factory\",\"swapchain\",\"adapter\"],\"factory_count\":3,\"swapchain_count\":4,\"adapter_count\":3,\"emit_format\":\"__DXGI__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_3_evidence_augment\":true,\"track_ah_bundled_complete\":true,\"track_ah_bundled_part_4_of_4\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_dxgi_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pdx()
    let s2 = pdx_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dxgi_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dxgi_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", factory_event=" + to_string(s[1])
        + ", swapchain_event=" + to_string(s[2]) + ", adapter_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdx_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("factory_event_count\t" + to_string(s[1]))
            println("swapchain_event_count\t" + to_string(s[2]))
            println("adapter_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_dxgi_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_dxgi_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdx()
            println("cleaned: " + pdx_dir())
            return
        }
        if sub == "dir" {
            println(pdx_dir())
            return
        }
    }
    println("usage: hexa run pe_dxgi_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
