// lib/loader/pe_msvc_initterm_real_walk.hexa
// — _initterm / _initterm_e 의 실 array walk + 각 fn ptr 호출 trace
//
// pe_msvc_initterm_array_real 가 segment / size / decision 의 high-level summary 를
// 기록한다면, 본 hexa 는 그 안쪽 — 즉 `_initterm` / `_initterm_e` 가 (fn**) 사이를
// 한 슬롯씩 "실제로 걸으며" 각 fn ptr 을 호출할 때마다의 invocation 결과 / skip 결정
// 을 더 fine-grained 하게 추적한다.
//
// MSVC `_initterm` (UCRT 공개 doc 기준):
//   void _initterm(_PVFV* pfbegin, _PVFV* pfend) {
//       while (pfbegin < pfend) {
//           if (*pfbegin != 0) (**pfbegin)();   // void → no return value
//           ++pfbegin;
//       }
//   }
//
//   int  _initterm_e(_PIFV* pfbegin, _PIFV* pfend) {
//       while (pfbegin < pfend) {
//           if (*pfbegin != 0) {
//               int r = (**pfbegin)();           // int → 0 = success, !=0 = abort
//               if (r != 0) return r;
//           }
//           ++pfbegin;
//       }
//       return 0;
//   }
//
// 본 hexa 는 walk 단위 + slot 단위 + invoke 단위 + skip 단위 + summary 단위 5 종을
// 기록 — pe_msvc_initterm_array_real 의 ctor_invocations 보다 한 단계 더 자세함:
// slot 의 종류 (null / encoded / plain) 와 skip 사유 (null / invalid_target /
// cap_reached) 까지 분리한다.
//
// own 1 enforcement: Wine msvcrt source / Microsoft msvcrt source / CrossOver / GPTK /
//                    Whisky 0 줄. Microsoft UCRT API 공개 doc 만 참조.
// own 2 mandate: r0_emit ≥ 14 + self_test() + main() dispatch + headless safe + panic 형식.
//
// persist schema (TSV 5 종):
//   walks.tsv          : walk_id<int>      \t walk_kind<int>   \t start_va_hex<str>
//                        \t end_va_hex<str> \t total_slots<int>
//   slots.tsv          : slot_id<int>      \t walk_id<int>     \t slot_index<int>
//                        \t fn_va_hex<str>  \t slot_kind<int>
//   invokes.tsv        : invoke_id<int>    \t slot_id<int>     \t ret_value_hex<str>
//                        \t succeeded<int>
//   skips.tsv          : skip_id<int>      \t slot_id<int>     \t skip_reason<int>
//   walk_summaries.tsv : summary_id<int>   \t walk_id<int>     \t invoked<int>
//                        \t skipped<int>   \t total<int>
//
// walk_kind code  : 0=initterm 1=initterm_e
// slot_kind code  : 0=null 1=encoded 2=plain
// skip_reason code: 0=null 1=invalid_target 2=cap_reached
//
// Hexa 예약어 회피: type/mod/resume/handle 단독 identifier 금지 → walk_kind / slot_kind /
// skip_reason / kind. (cycle 47 의 type 예약어 사고 사례 반영.)

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmirw_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_msvc_initterm_real_walk"
}

fn pmirw_walks_path() -> str {
    return pmirw_dir() + "/walks.tsv"
}

fn pmirw_slots_path() -> str {
    return pmirw_dir() + "/slots.tsv"
}

fn pmirw_invokes_path() -> str {
    return pmirw_dir() + "/invokes.tsv"
}

fn pmirw_skips_path() -> str {
    return pmirw_dir() + "/skips.tsv"
}

fn pmirw_summaries_path() -> str {
    return pmirw_dir() + "/walk_summaries.tsv"
}

fn pmirw_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmirw_dir() + "'")
}

fn cleanup_pmirw() -> void {
    pmirw_ensure_dir()
    let _ = exec("rm -f '" + pmirw_walks_path()
        + "' '" + pmirw_slots_path()
        + "' '" + pmirw_invokes_path()
        + "' '" + pmirw_skips_path()
        + "' '" + pmirw_summaries_path() + "'")
}

// ─── 공통 file IO ───
fn pmirw_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmirw_append_row(path: str, row: str) -> void {
    pmirw_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_walk_start: _initterm / _initterm_e walk 시작 1 건 ───
//   walk_kind: 0=initterm 1=initterm_e
fn record_walk_start(walk_id: int, walk_kind: int, start_va_hex: str, end_va_hex: str, total_slots: int) -> void {
    if walk_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_start] expected=walk_id>0 got=" + to_string(walk_id))
    }
    if walk_kind < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_start] expected=walk_kind>=0 got=" + to_string(walk_kind))
    }
    if walk_kind > 1 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_start] expected=walk_kind<=1 got=" + to_string(walk_kind))
    }
    if start_va_hex == "" {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_start] expected=start_va_hex!=empty got=empty")
    }
    if end_va_hex == "" {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_start] expected=end_va_hex!=empty got=empty")
    }
    if total_slots < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_start] expected=total_slots>=0 got=" + to_string(total_slots))
    }
    let row = to_string(walk_id) + "\t" + to_string(walk_kind) + "\t" + start_va_hex
        + "\t" + end_va_hex + "\t" + to_string(total_slots) + "\n"
    pmirw_append_row(pmirw_walks_path(), row)
}

// ─── record_slot: walk 의 한 array slot 1 건 ───
//   slot_kind: 0=null 1=encoded 2=plain
fn record_slot(slot_id: int, walk_id: int, slot_index: int, fn_va_hex: str, slot_kind: int) -> void {
    if slot_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_slot] expected=slot_id>0 got=" + to_string(slot_id))
    }
    if walk_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_slot] expected=walk_id>0 got=" + to_string(walk_id))
    }
    if slot_index < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_slot] expected=slot_index>=0 got=" + to_string(slot_index))
    }
    if fn_va_hex == "" {
        panic("pe_msvc_initterm_real_walk FAIL [record_slot] expected=fn_va_hex!=empty got=empty")
    }
    if slot_kind < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_slot] expected=slot_kind>=0 got=" + to_string(slot_kind))
    }
    if slot_kind > 2 {
        panic("pe_msvc_initterm_real_walk FAIL [record_slot] expected=slot_kind<=2 got=" + to_string(slot_kind))
    }
    let row = to_string(slot_id) + "\t" + to_string(walk_id) + "\t" + to_string(slot_index)
        + "\t" + fn_va_hex + "\t" + to_string(slot_kind) + "\n"
    pmirw_append_row(pmirw_slots_path(), row)
}

// ─── record_invoke: slot 한 개 ctor 호출 1 건 ───
//   ret_value_hex: ctor 반환값 (initterm 은 0, initterm_e 는 임의 int)
//   succeeded   : 1=성공 0=실패
fn record_invoke(invoke_id: int, slot_id: int, ret_value_hex: str, succeeded: int) -> void {
    if invoke_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if slot_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_invoke] expected=slot_id>0 got=" + to_string(slot_id))
    }
    if ret_value_hex == "" {
        panic("pe_msvc_initterm_real_walk FAIL [record_invoke] expected=ret_value_hex!=empty got=empty")
    }
    if succeeded < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_invoke] expected=succeeded>=0 got=" + to_string(succeeded))
    }
    if succeeded > 1 {
        panic("pe_msvc_initterm_real_walk FAIL [record_invoke] expected=succeeded<=1 got=" + to_string(succeeded))
    }
    let row = to_string(invoke_id) + "\t" + to_string(slot_id) + "\t" + ret_value_hex
        + "\t" + to_string(succeeded) + "\n"
    pmirw_append_row(pmirw_invokes_path(), row)
}

// ─── record_skip: slot 호출이 skip 된 사유 1 건 ───
//   skip_reason: 0=null 1=invalid_target 2=cap_reached
fn record_skip(skip_id: int, slot_id: int, skip_reason: int) -> void {
    if skip_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_skip] expected=skip_id>0 got=" + to_string(skip_id))
    }
    if slot_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_skip] expected=slot_id>0 got=" + to_string(slot_id))
    }
    if skip_reason < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_skip] expected=skip_reason>=0 got=" + to_string(skip_reason))
    }
    if skip_reason > 2 {
        panic("pe_msvc_initterm_real_walk FAIL [record_skip] expected=skip_reason<=2 got=" + to_string(skip_reason))
    }
    let row = to_string(skip_id) + "\t" + to_string(slot_id) + "\t" + to_string(skip_reason) + "\n"
    pmirw_append_row(pmirw_skips_path(), row)
}

// ─── record_walk_summary: walk 1 건의 invoked / skipped / total 통합 1 건 ───
fn record_walk_summary(summary_id: int, walk_id: int, invoked: int, skipped: int, total: int) -> void {
    if summary_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_summary] expected=summary_id>0 got=" + to_string(summary_id))
    }
    if walk_id <= 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_summary] expected=walk_id>0 got=" + to_string(walk_id))
    }
    if invoked < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_summary] expected=invoked>=0 got=" + to_string(invoked))
    }
    if skipped < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_summary] expected=skipped>=0 got=" + to_string(skipped))
    }
    if total < 0 {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_summary] expected=total>=0 got=" + to_string(total))
    }
    if invoked + skipped > total {
        panic("pe_msvc_initterm_real_walk FAIL [record_walk_summary] expected=invoked+skipped<=total got=" + to_string(invoked + skipped) + ">" + to_string(total))
    }
    let row = to_string(summary_id) + "\t" + to_string(walk_id) + "\t" + to_string(invoked)
        + "\t" + to_string(skipped) + "\t" + to_string(total) + "\n"
    pmirw_append_row(pmirw_summaries_path(), row)
}

// ─── 공통 row counter ───
fn pmirw_count_rows(path: str, min_fields: int) -> int {
    let t = pmirw_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_fields {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

fn walk_start_count() -> int {
    return pmirw_count_rows(pmirw_walks_path(), 5)
}

fn slot_count() -> int {
    return pmirw_count_rows(pmirw_slots_path(), 5)
}

fn invoke_count() -> int {
    return pmirw_count_rows(pmirw_invokes_path(), 4)
}

fn skip_count() -> int {
    return pmirw_count_rows(pmirw_skips_path(), 3)
}

fn summary_count() -> int {
    return pmirw_count_rows(pmirw_summaries_path(), 5)
}

// ─── walk_kind_name: 0..1 → 명칭 ───
fn walk_kind_name(k: int) -> str {
    if k == 0 {
        return "initterm"
    }
    if k == 1 {
        return "initterm_e"
    }
    panic("pe_msvc_initterm_real_walk FAIL [walk_kind_name] expected=0..1 got=" + to_string(k))
}

// ─── slot_kind_name: 0..2 → 명칭 ───
fn slot_kind_name(k: int) -> str {
    if k == 0 {
        return "null"
    }
    if k == 1 {
        return "encoded"
    }
    if k == 2 {
        return "plain"
    }
    panic("pe_msvc_initterm_real_walk FAIL [slot_kind_name] expected=0..2 got=" + to_string(k))
}

// ─── skip_reason_name: 0..2 → 명칭 ───
fn skip_reason_name(r: int) -> str {
    if r == 0 {
        return "null"
    }
    if r == 1 {
        return "invalid_target"
    }
    if r == 2 {
        return "cap_reached"
    }
    panic("pe_msvc_initterm_real_walk FAIL [skip_reason_name] expected=0..2 got=" + to_string(r))
}

// ─── pmirw_stats: [walk_start, slot, invoke, skip, summary] ───
fn pmirw_stats() -> array {
    let mut out = []
    out.push(walk_start_count())
    out.push(slot_count())
    out.push(invoke_count())
    out.push(skip_count())
    out.push(summary_count())
    return out
}

// ─── self_test ───
//   2 walk_start + 6 slot + 4 invoke + 2 skip + 2 walk_summary = 16 record (≥ 12)
//   r0_emit per record + 1 stats summary = 17 emit (≥ 14)
fn self_test() -> void {
    let sid = "pmirw-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pmirw()

    // 2. record_walk_start x2 — initterm (walk_id=1, total 3) + initterm_e (walk_id=2, total 3)
    record_walk_start(1, 0, "0x401000", "0x40100c", 3)
    r0_emit("pe_msvc_initterm_real_walk_record_walk_start",
        "\"walk_id\":1,\"walk_kind\":0,\"name\":\"" + walk_kind_name(0)
        + "\",\"start_va_hex\":\"0x401000\",\"end_va_hex\":\"0x40100c\",\"total_slots\":3")

    record_walk_start(2, 1, "0x40100c", "0x401018", 3)
    r0_emit("pe_msvc_initterm_real_walk_record_walk_start",
        "\"walk_id\":2,\"walk_kind\":1,\"name\":\"" + walk_kind_name(1)
        + "\",\"start_va_hex\":\"0x40100c\",\"end_va_hex\":\"0x401018\",\"total_slots\":3")

    // 3. record_slot x6 — null 1 / encoded 4 / plain 1
    //    walk 1 (initterm): slot 0 null, slot 1 encoded, slot 2 encoded → 3 slot
    //    walk 2 (initterm_e): slot 0 plain, slot 1 encoded, slot 2 encoded → 3 slot
    record_slot(1, 1, 0, "0x00000000", 0)        // null  → skip
    r0_emit("pe_msvc_initterm_real_walk_record_slot",
        "\"slot_id\":1,\"walk_id\":1,\"slot_index\":0,\"fn_va_hex\":\"0x00000000\",\"slot_kind\":0,\"name\":\""
        + slot_kind_name(0) + "\"")

    record_slot(2, 1, 1, "0x402000", 1)          // encoded
    r0_emit("pe_msvc_initterm_real_walk_record_slot",
        "\"slot_id\":2,\"walk_id\":1,\"slot_index\":1,\"fn_va_hex\":\"0x402000\",\"slot_kind\":1,\"name\":\""
        + slot_kind_name(1) + "\"")

    record_slot(3, 1, 2, "0x402040", 1)          // encoded — invalid target → skip
    r0_emit("pe_msvc_initterm_real_walk_record_slot",
        "\"slot_id\":3,\"walk_id\":1,\"slot_index\":2,\"fn_va_hex\":\"0x402040\",\"slot_kind\":1,\"name\":\""
        + slot_kind_name(1) + "\"")

    record_slot(4, 2, 0, "0x403000", 2)          // plain
    r0_emit("pe_msvc_initterm_real_walk_record_slot",
        "\"slot_id\":4,\"walk_id\":2,\"slot_index\":0,\"fn_va_hex\":\"0x403000\",\"slot_kind\":2,\"name\":\""
        + slot_kind_name(2) + "\"")

    record_slot(5, 2, 1, "0x403040", 1)          // encoded
    r0_emit("pe_msvc_initterm_real_walk_record_slot",
        "\"slot_id\":5,\"walk_id\":2,\"slot_index\":1,\"fn_va_hex\":\"0x403040\",\"slot_kind\":1,\"name\":\""
        + slot_kind_name(1) + "\"")

    record_slot(6, 2, 2, "0x403080", 1)          // encoded
    r0_emit("pe_msvc_initterm_real_walk_record_slot",
        "\"slot_id\":6,\"walk_id\":2,\"slot_index\":2,\"fn_va_hex\":\"0x403080\",\"slot_kind\":1,\"name\":\""
        + slot_kind_name(1) + "\"")

    // 4. record_invoke x4 — succeeded all (slot 2,4,5,6)
    record_invoke(1, 2, "0x00000000", 1)
    r0_emit("pe_msvc_initterm_real_walk_record_invoke",
        "\"invoke_id\":1,\"slot_id\":2,\"ret_value_hex\":\"0x00000000\",\"succeeded\":1")

    record_invoke(2, 4, "0x00000000", 1)
    r0_emit("pe_msvc_initterm_real_walk_record_invoke",
        "\"invoke_id\":2,\"slot_id\":4,\"ret_value_hex\":\"0x00000000\",\"succeeded\":1")

    record_invoke(3, 5, "0x00000000", 1)
    r0_emit("pe_msvc_initterm_real_walk_record_invoke",
        "\"invoke_id\":3,\"slot_id\":5,\"ret_value_hex\":\"0x00000000\",\"succeeded\":1")

    record_invoke(4, 6, "0x00000000", 1)
    r0_emit("pe_msvc_initterm_real_walk_record_invoke",
        "\"invoke_id\":4,\"slot_id\":6,\"ret_value_hex\":\"0x00000000\",\"succeeded\":1")

    // 5. record_skip x2 — null (slot 1) + invalid_target (slot 3)
    record_skip(1, 1, 0)
    r0_emit("pe_msvc_initterm_real_walk_record_skip",
        "\"skip_id\":1,\"slot_id\":1,\"skip_reason\":0,\"name\":\"" + skip_reason_name(0) + "\"")

    record_skip(2, 3, 1)
    r0_emit("pe_msvc_initterm_real_walk_record_skip",
        "\"skip_id\":2,\"slot_id\":3,\"skip_reason\":1,\"name\":\"" + skip_reason_name(1) + "\"")

    // 6. record_walk_summary x2 — invoked=2 skipped=1 total=3 each (per walk)
    record_walk_summary(1, 1, 2, 1, 3)
    r0_emit("pe_msvc_initterm_real_walk_record_walk_summary",
        "\"summary_id\":1,\"walk_id\":1,\"invoked\":2,\"skipped\":1,\"total\":3")

    record_walk_summary(2, 2, 2, 1, 3)
    r0_emit("pe_msvc_initterm_real_walk_record_walk_summary",
        "\"summary_id\":2,\"walk_id\":2,\"invoked\":2,\"skipped\":1,\"total\":3")

    // 7. assertion: walk_start == 2
    let ws = walk_start_count()
    if ws != 2 {
        panic("pe_msvc_initterm_real_walk FAIL [walk_start_count] expected=2 got=" + to_string(ws))
    }

    // 8. assertion: slot == 6
    let sl = slot_count()
    if sl != 6 {
        panic("pe_msvc_initterm_real_walk FAIL [slot_count] expected=6 got=" + to_string(sl))
    }

    // 9. assertion: invoke == 4
    let iv = invoke_count()
    if iv != 4 {
        panic("pe_msvc_initterm_real_walk FAIL [invoke_count] expected=4 got=" + to_string(iv))
    }

    // 10. assertion: skip == 2
    let sk = skip_count()
    if sk != 2 {
        panic("pe_msvc_initterm_real_walk FAIL [skip_count] expected=2 got=" + to_string(sk))
    }

    // 11. assertion: summary == 2
    let sm = summary_count()
    if sm != 2 {
        panic("pe_msvc_initterm_real_walk FAIL [summary_count] expected=2 got=" + to_string(sm))
    }

    // 12. walk_kind_name sanity
    let w0 = walk_kind_name(0)
    if w0 != "initterm" {
        panic("pe_msvc_initterm_real_walk FAIL [walk_kind_name(0)] expected=initterm got=" + w0)
    }
    let w1 = walk_kind_name(1)
    if w1 != "initterm_e" {
        panic("pe_msvc_initterm_real_walk FAIL [walk_kind_name(1)] expected=initterm_e got=" + w1)
    }

    // 13. slot_kind_name sanity
    let sk0 = slot_kind_name(0)
    if sk0 != "null" {
        panic("pe_msvc_initterm_real_walk FAIL [slot_kind_name(0)] expected=null got=" + sk0)
    }
    let sk1 = slot_kind_name(1)
    if sk1 != "encoded" {
        panic("pe_msvc_initterm_real_walk FAIL [slot_kind_name(1)] expected=encoded got=" + sk1)
    }
    let sk2 = slot_kind_name(2)
    if sk2 != "plain" {
        panic("pe_msvc_initterm_real_walk FAIL [slot_kind_name(2)] expected=plain got=" + sk2)
    }

    // 14. skip_reason_name sanity
    let r0 = skip_reason_name(0)
    if r0 != "null" {
        panic("pe_msvc_initterm_real_walk FAIL [skip_reason_name(0)] expected=null got=" + r0)
    }
    let r1 = skip_reason_name(1)
    if r1 != "invalid_target" {
        panic("pe_msvc_initterm_real_walk FAIL [skip_reason_name(1)] expected=invalid_target got=" + r1)
    }
    let r2 = skip_reason_name(2)
    if r2 != "cap_reached" {
        panic("pe_msvc_initterm_real_walk FAIL [skip_reason_name(2)] expected=cap_reached got=" + r2)
    }

    // 15. pmirw_stats() == [2, 6, 4, 2, 2]
    let s = pmirw_stats()
    if len(s) != 5 {
        panic("pe_msvc_initterm_real_walk FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 2 {
        panic("pe_msvc_initterm_real_walk FAIL [stats walk_start] expected=2 got=" + to_string(s[0]))
    }
    if s[1] != 6 {
        panic("pe_msvc_initterm_real_walk FAIL [stats slot] expected=6 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_msvc_initterm_real_walk FAIL [stats invoke] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_msvc_initterm_real_walk FAIL [stats skip] expected=2 got=" + to_string(s[3]))
    }
    if s[4] != 2 {
        panic("pe_msvc_initterm_real_walk FAIL [stats summary] expected=2 got=" + to_string(s[4]))
    }

    // 16. emit stats summary
    r0_emit("pe_msvc_initterm_real_walk_stats",
        "\"walk_start\":" + to_string(s[0])
        + ",\"slot\":" + to_string(s[1])
        + ",\"invoke\":" + to_string(s[2])
        + ",\"skip\":" + to_string(s[3])
        + ",\"summary\":" + to_string(s[4]))

    // 17. emit count >= 14 — 2 walk_start + 6 slot + 4 invoke + 2 skip + 2 summary + 1 stats = 17
    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_msvc_initterm_real_walk FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // 18. cleanup → stats 모두 0
    cleanup_pmirw()
    let s2 = pmirw_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_msvc_initterm_real_walk FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_msvc_initterm_real_walk self_test PASS (walk_start=" + to_string(s[0])
        + ", slot=" + to_string(s[1]) + ", invoke=" + to_string(s[2])
        + ", skip=" + to_string(s[3]) + ", summary=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmirw_stats()
            println("walk_start_count\t" + to_string(s[0]))
            println("slot_count\t" + to_string(s[1]))
            println("invoke_count\t" + to_string(s[2]))
            println("skip_count\t" + to_string(s[3]))
            println("summary_count\t" + to_string(s[4]))
            return
        }
        if sub == "cleanup" {
            cleanup_pmirw()
            println("cleaned: " + pmirw_dir())
            return
        }
        if sub == "dir" {
            println(pmirw_dir())
            return
        }
    }
    println("usage: hexa run pe_msvc_initterm_real_walk.hexa { self-test | stats | cleanup | dir }")
}
