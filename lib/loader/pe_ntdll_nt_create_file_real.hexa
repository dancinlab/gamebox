// lib/loader/pe_ntdll_nt_create_file_real.hexa — NTDLL NtCreateFile/NtOpenFile 실 호출 추적 (cycle 83)
//
// NTDLL NtCreateFile/NtOpenFile 실 호출 → POSIX bridge:
//   NtCreateFile(out FileHandle, DesiredAccess, OBJECT_ATTRIBUTES*, IO_STATUS_BLOCK*, ...)
//     → POSIX open(utf8_path, O_RDWR|O_CREAT, mode) + handle table entry (cycle 81)
//   create_disposition translation:
//     FILE_SUPERSEDE  → O_TRUNC|O_CREAT
//     FILE_OPEN       → just O_RDWR
//     FILE_CREATE     → O_EXCL|O_CREAT
//     FILE_OPEN_IF    → O_CREAT (no excl, no trunc)
//     FILE_OVERWRITE_IF → O_TRUNC|O_CREAT
//   nt_status mapping:
//     EACCES → STATUS_ACCESS_DENIED (0xC0000022)
//     ENOENT → STATUS_OBJECT_NAME_NOT_FOUND (0xC0000034)
//   D2R/D4 의 SaveData (.d2s/.d4s 파일) NtCreateFile path 사용
// own1: NTDLL spec + Apple POSIX. Wine ntdll/file.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 NT API call tracker — 실 NtCreateFile / open() 호출 X (native bridge stage).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//   1 = NtCreateFile
//   2 = NtOpenFile
//   3 = NtClose
//   4 = NtReadFile
//   5 = NtWriteFile
//   6 = NtDeviceIoControlFile
//
// nt_status code (decimal — stored as int):
//   0          = STATUS_SUCCESS
//   3221225506 = 0xC0000022 = STATUS_ACCESS_DENIED
//   3221225524 = 0xC0000034 = STATUS_OBJECT_NAME_NOT_FOUND
//
// create_disposition code:
//   0 = FILE_SUPERSEDE
//   1 = FILE_OPEN
//   2 = FILE_CREATE
//   3 = FILE_OPEN_IF
//   5 = FILE_OVERWRITE_IF
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t nt_status<int> \t create_disposition<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pncfr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ntdll_nt_create_file_real"
}

fn pncfr_calls_path() -> str {
    return pncfr_dir() + "/calls.tsv"
}

fn pncfr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pncfr_dir() + "'")
}

fn cleanup_pncfr() -> void {
    pncfr_ensure_dir()
    let _ = exec("rm -f '" + pncfr_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pncfr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pncfr_append_row(path: str, row: str) -> void {
    pncfr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: NT API call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, nt_status: int, create_disposition: int) -> void {
    if call_id <= 0 {
        panic("pe_ntdll_nt_create_file_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 6 {
        panic("pe_ntdll_nt_create_file_real FAIL [record_call] expected=func_kind<=6 got=" + to_string(func_kind))
    }
    if nt_status < 0 {
        panic("pe_ntdll_nt_create_file_real FAIL [record_call] expected=nt_status>=0 got=" + to_string(nt_status))
    }
    if create_disposition < 0 {
        panic("pe_ntdll_nt_create_file_real FAIL [record_call] expected=create_disposition>=0 got=" + to_string(create_disposition))
    }
    if create_disposition > 5 {
        panic("pe_ntdll_nt_create_file_real FAIL [record_call] expected=create_disposition<=5 got=" + to_string(create_disposition))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(nt_status) + "\t" + to_string(create_disposition) + "\n"
    pncfr_append_row(pncfr_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = pncfr_read_table(pncfr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = pncfr_read_table(pncfr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_nt_status: 특정 nt_status 의 call 수 ───
fn count_by_nt_status(status: int) -> int {
    let t = pncfr_read_table(pncfr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── success_count: nt_status == 0 (STATUS_SUCCESS) call 수 ───
fn success_count() -> int {
    return count_by_nt_status(0)
}

// ─── count_by_disposition: 특정 create_disposition 의 call 수 ───
fn count_by_disposition(disp: int) -> int {
    let t = pncfr_read_table(pncfr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == disp {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_nt_status: 특정 call_id 의 nt_status (없으면 -1) ───
fn call_nt_status(call_id: int) -> int {
    let t = pncfr_read_table(pncfr_calls_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pncfr_stats: [call_count, success_count, count_by_func_kind(1), count_by_disposition(3)] ───
fn pncfr_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(success_count())
    out.push(count_by_func_kind(1))
    out.push(count_by_disposition(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pncfr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pncfr()

    // 2. record 6 calls — covers ≥4 func_kinds, mix of success/fail nt_status
    //    NtCreateFile FILE_OPEN_IF SUCCESS (D2R .d2s save)
    record_call(130001, 1, 0, 3)
    r0_emit("pe_ntdll_nt_create_file_real_record",
        "\"call_id\":130001,\"func_kind\":1,\"nt_status\":0,\"create_disposition\":3,\"target\":\"NtCreateFile\"")

    //    NtOpenFile FILE_OPEN SUCCESS
    record_call(130002, 2, 0, 1)
    r0_emit("pe_ntdll_nt_create_file_real_record",
        "\"call_id\":130002,\"func_kind\":2,\"nt_status\":0,\"create_disposition\":1,\"target\":\"NtOpenFile\"")

    //    NtCreateFile FILE_CREATE → ACCESS_DENIED (0xC0000022 = 3221225506)
    record_call(130003, 1, 3221225506, 2)
    r0_emit("pe_ntdll_nt_create_file_real_record",
        "\"call_id\":130003,\"func_kind\":1,\"nt_status\":3221225506,\"create_disposition\":2,\"target\":\"NtCreateFile\"")

    //    NtOpenFile FILE_OPEN → OBJECT_NAME_NOT_FOUND (0xC0000034 = 3221225524)
    record_call(130004, 2, 3221225524, 1)
    r0_emit("pe_ntdll_nt_create_file_real_record",
        "\"call_id\":130004,\"func_kind\":2,\"nt_status\":3221225524,\"create_disposition\":1,\"target\":\"NtOpenFile\"")

    //    NtReadFile SUCCESS (no disposition — 0 placeholder = FILE_SUPERSEDE slot reused as N/A)
    record_call(130005, 4, 0, 0)
    r0_emit("pe_ntdll_nt_create_file_real_record",
        "\"call_id\":130005,\"func_kind\":4,\"nt_status\":0,\"create_disposition\":0,\"target\":\"NtReadFile\"")

    //    NtClose SUCCESS
    record_call(130006, 3, 0, 0)
    r0_emit("pe_ntdll_nt_create_file_real_record",
        "\"call_id\":130006,\"func_kind\":3,\"nt_status\":0,\"create_disposition\":0,\"target\":\"NtClose\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("pe_ntdll_nt_create_file_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (≥4 func_kinds covered: 1,2,3,4)
    let f1 = count_by_func_kind(1)
    if f1 != 2 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_func_kind(1)] expected=2 got=" + to_string(f1))
    }
    let f2 = count_by_func_kind(2)
    if f2 != 2 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_func_kind(2)] expected=2 got=" + to_string(f2))
    }
    let f3 = count_by_func_kind(3)
    if f3 != 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_func_kind(3)] expected=1 got=" + to_string(f3))
    }
    let f4 = count_by_func_kind(4)
    if f4 != 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(f4))
    }
    let f99 = count_by_func_kind(99)
    if f99 != 0 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_func_kind(99)] expected=0 got=" + to_string(f99))
    }

    // 5. count_by_nt_status sanity (mix of success/fail)
    let s_ok = count_by_nt_status(0)
    if s_ok != 4 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_nt_status(0)] expected=4 got=" + to_string(s_ok))
    }
    let s_denied = count_by_nt_status(3221225506)
    if s_denied != 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_nt_status(ACCESS_DENIED)] expected=1 got=" + to_string(s_denied))
    }
    let s_nf = count_by_nt_status(3221225524)
    if s_nf != 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_nt_status(NAME_NOT_FOUND)] expected=1 got=" + to_string(s_nf))
    }

    // 6. success_count = 4 (== count_by_nt_status(0))
    let sc = success_count()
    if sc != 4 {
        panic("pe_ntdll_nt_create_file_real FAIL [success_count] expected=4 got=" + to_string(sc))
    }

    // 7. count_by_disposition sanity
    let d3 = count_by_disposition(3)
    if d3 != 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_disposition(3)] expected=1 got=" + to_string(d3))
    }
    let d1 = count_by_disposition(1)
    if d1 != 2 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_disposition(1)] expected=2 got=" + to_string(d1))
    }
    let d2 = count_by_disposition(2)
    if d2 != 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [count_by_disposition(2)] expected=1 got=" + to_string(d2))
    }

    // 8. call_nt_status sanity
    let st1 = call_nt_status(130001)
    if st1 != 0 {
        panic("pe_ntdll_nt_create_file_real FAIL [call_nt_status(130001)] expected=0 got=" + to_string(st1))
    }
    let st3 = call_nt_status(130003)
    if st3 != 3221225506 {
        panic("pe_ntdll_nt_create_file_real FAIL [call_nt_status(130003)] expected=3221225506 got=" + to_string(st3))
    }
    let st_miss = call_nt_status(9999)
    if st_miss != -1 {
        panic("pe_ntdll_nt_create_file_real FAIL [call_nt_status(9999)] expected=-1 got=" + to_string(st_miss))
    }

    // 9. pncfr_stats() = [6, 4, 2, 1]
    let s = pncfr_stats()
    if len(s) != 4 {
        panic("pe_ntdll_nt_create_file_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_ntdll_nt_create_file_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_ntdll_nt_create_file_real FAIL [stats success_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_ntdll_nt_create_file_real FAIL [stats func_kind(1)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_ntdll_nt_create_file_real FAIL [stats disp(3)] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats (7th r0_emit)
    r0_emit("pe_ntdll_nt_create_file_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"success_count\":" + to_string(s[1])
        + ",\"func_kind_create\":" + to_string(s[2])
        + ",\"disp_open_if\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_ntdll_nt_create_file_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0 (post-cleanup zero)
    cleanup_pncfr()
    let s2 = pncfr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ntdll_nt_create_file_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ntdll_nt_create_file_real self_test PASS (calls=" + to_string(s[0])
        + ", success=" + to_string(s[1]) + ", create=" + to_string(s[2])
        + ", open_if=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pncfr_stats()
            println("call_count\t" + to_string(s[0]))
            println("success_count\t" + to_string(s[1]))
            println("count_func_kind_create\t" + to_string(s[2]))
            println("count_disp_open_if\t" + to_string(s[3]))
            return
        }
        if sub == "status" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_nt_status\t" + to_string(call_nt_status(cid)))
                return
            }
            println("usage: hexa run pe_ntdll_nt_create_file_real.hexa status <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let what = a[3]
                let val = to_int(a[4])
                if what == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if what == "status" {
                    println("count_by_nt_status\t" + to_string(count_by_nt_status(val)))
                    return
                }
            }
            println("usage: hexa run pe_ntdll_nt_create_file_real.hexa count { func <func_kind> | status <nt_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pncfr()
            println("cleaned: " + pncfr_dir())
            return
        }
        if sub == "dir" {
            println(pncfr_dir())
            return
        }
    }
    println("usage: hexa run pe_ntdll_nt_create_file_real.hexa { self-test | stats | status <call_id> | count func <func_kind> | count status <nt_status> | cleanup | dir }")
}
