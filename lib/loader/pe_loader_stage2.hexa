// lib/loader/pe_loader_stage2.hexa — stage2 PE loader 실 구현 skeleton
//
// stage1 = parse + coverage 분석. stage2 = 실제 memory mapping + IAT resolve +
// entry call orchestration. 본 파일은 instrumentation skeleton — sub-modules
// (pe_iat_resolve_stage2, pe_reloc_stage2, pe_tls_stage2 등) 호출 sequence
// 정의 + section copy 추적.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   Microsoft PE/COFF spec (https://learn.microsoft.com/en-us/windows/win32/debug/pe-format) 만 참조.
// own 2 mandate: r0_emit ≥ 4 + self_test() + main() dispatch + headless safe + panic 형식.
//
// orchestrate sequence (stage3 에서 실 mapping 으로 교체):
//   1) map_pe_sections(pe_path, image_base) — header + sections copy 추적
//   2) load_dependencies(pe_path)           — DLL import descriptor 수 count
//   3) IAT resolve  (pe_iat_resolve_stage2 — stub here)
//   4) reloc        (pe_reloc_stage2       — stub here)
//   5) TLS callback (pe_tls_stage2         — stub here)
//   6) entry call   (pe_entry_call         — stub here)
//
// persist schema (TSV — orchestrate_history.tsv):
//   orchestrate_id<int> \t sections<int> \t bytes_mapped<int> \t dlls_loaded<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pls_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_loader_stage2"
}

fn pls_history_path() -> str {
    return pls_dir() + "/orchestrate_history.tsv"
}

fn pls_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pls_dir() + "'")
}

fn cleanup_pls() -> void {
    pls_ensure_dir()
    let _ = exec("rm -f '" + pls_history_path() + "'")
}

// ─── 공통 file IO ───
fn pls_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pls_append_row(path: str, row: str) -> void {
    pls_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── next orchestrate_id (max+1, base 72000) ───
fn pls_next_id() -> int {
    let t = pls_read_table(pls_history_path())
    if t == "" {
        return 72000
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut max_h = 71999
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 1 {
                let h = to_int(parts[0])
                if h > max_h {
                    max_h = h
                }
            }
        }
        i = i + 1
    }
    return max_h + 1
}

// ─── map_pe_sections: header + section copy 추적 (skeleton — synthetic list) ───
//   stage3 에서 실제 mmap / mprotect 로 교체.
//   현재는 PE 가 존재하지 않아도 동작 가능한 deterministic synthetic.
//   pe_path basename 을 hash 한 4-bucket 으로 section count / size 결정.
//   반환: [total_sections, total_bytes_mapped, virt_addr_top]
fn map_pe_sections(pe_path: str, image_base: int) -> array {
    if pe_path == "" {
        panic("pe_loader_stage2 FAIL [map_pe_sections] expected=non-empty pe_path got=empty")
    }
    if image_base <= 0 {
        panic("pe_loader_stage2 FAIL [map_pe_sections] expected=image_base>0 got=" + to_string(image_base))
    }
    // synthetic — basename 을 awk 로 추출, 길이 mod 4 로 bucket 결정
    let bn = exec("printf '%s' '" + pe_path + "' | awk -F/ '{print $NF}'").trim()
    let blen = len(bn)
    let bucket = blen % 4
    let mut sections = 0
    let mut bytes_mapped = 0
    if bucket == 0 {
        sections = 5
        bytes_mapped = 5279744
    }
    if bucket == 1 {
        sections = 8
        bytes_mapped = 15000000
    }
    if bucket == 2 {
        sections = 10
        bytes_mapped = 18000000
    }
    if bucket == 3 {
        sections = 12
        bytes_mapped = 20000000
    }
    let virt_addr_top = image_base + bytes_mapped
    return [sections, bytes_mapped, virt_addr_top]
}

// ─── load_dependencies: DLL import descriptor 수 count (skeleton) ───
//   stage3 에서 pe_imports 의 import descriptor table 으로 교체.
//   현재는 basename bucket 기반 deterministic synthetic.
fn load_dependencies(pe_path: str) -> int {
    if pe_path == "" {
        panic("pe_loader_stage2 FAIL [load_dependencies] expected=non-empty pe_path got=empty")
    }
    let bn = exec("printf '%s' '" + pe_path + "' | awk -F/ '{print $NF}'").trim()
    let blen = len(bn)
    let bucket = blen % 4
    if bucket == 0 {
        return 16
    }
    if bucket == 1 {
        return 20
    }
    if bucket == 2 {
        return 22
    }
    return 24
}

// ─── orchestrate_loader: 전체 loader sequence ───
//   stage code: 0=success, 1=map fail, 2=deps fail, 3=IAT fail, 4=reloc fail, 5=TLS fail, 6=entry fail
//   현재 sub-modules 모두 stub — 실 구현은 stage3.
fn orchestrate_loader(pe_path: str) -> int {
    if pe_path == "" {
        return 1
    }
    // stage1: map_pe_sections (image_base 0x400000 = 4194304 default)
    let map_result = map_pe_sections(pe_path, 4194304)
    if len(map_result) != 3 {
        return 1
    }
    let sections = map_result[0]
    let bytes_mapped = map_result[1]
    if sections <= 0 {
        return 1
    }
    if bytes_mapped <= 0 {
        return 1
    }
    // stage2: load_dependencies
    let dlls = load_dependencies(pe_path)
    if dlls <= 0 {
        return 2
    }
    // stage3: IAT resolve (stub — pe_iat_resolve_stage2 placeholder)
    // stage4: reloc       (stub — pe_reloc_stage2 placeholder)
    // stage5: TLS         (stub — pe_tls_stage2 placeholder)
    // stage6: entry call  (stub — pe_entry_call placeholder)
    // persist row append
    let oid = pls_next_id()
    let row = to_string(oid) + "\t" + to_string(sections)
        + "\t" + to_string(bytes_mapped) + "\t" + to_string(dlls) + "\n"
    pls_append_row(pls_history_path(), row)
    return 0
}

// ─── orchestrate_record: synthetic 데이터 직접 기록 (self_test 용 deterministic injection) ───
//   실 orchestrate_loader 는 basename bucket 으로 결정되어 specific 합성 row 가 만들어지지 않음.
//   self_test 에서는 expected 값 (5, 5279744, 16) 등을 정확히 기록하려면 이 함수 사용.
fn orchestrate_record(orchestrate_id: int, sections: int, bytes_mapped: int, dlls_loaded: int) -> void {
    if orchestrate_id <= 0 {
        panic("pe_loader_stage2 FAIL [orchestrate_record] expected=orchestrate_id>0 got=" + to_string(orchestrate_id))
    }
    if sections <= 0 {
        panic("pe_loader_stage2 FAIL [orchestrate_record] expected=sections>0 got=" + to_string(sections))
    }
    if bytes_mapped <= 0 {
        panic("pe_loader_stage2 FAIL [orchestrate_record] expected=bytes_mapped>0 got=" + to_string(bytes_mapped))
    }
    if dlls_loaded <= 0 {
        panic("pe_loader_stage2 FAIL [orchestrate_record] expected=dlls_loaded>0 got=" + to_string(dlls_loaded))
    }
    let row = to_string(orchestrate_id) + "\t" + to_string(sections)
        + "\t" + to_string(bytes_mapped) + "\t" + to_string(dlls_loaded) + "\n"
    pls_append_row(pls_history_path(), row)
}

// ─── pls_stats: [orchestrate_count, total_sections_mapped, total_bytes_mapped, total_dlls_loaded] ───
fn pls_stats() -> array {
    let mut out = []
    let mut cnt = 0
    let mut sect_sum = 0
    let mut bytes_sum = 0
    let mut dll_sum = 0
    let t = pls_read_table(pls_history_path())
    if t != "" {
        let lines = t.split("\n")
        let n = len(lines)
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    cnt = cnt + 1
                    sect_sum = sect_sum + to_int(parts[1])
                    bytes_sum = bytes_sum + to_int(parts[2])
                    dll_sum = dll_sum + to_int(parts[3])
                }
            }
            i = i + 1
        }
    }
    out.push(cnt)
    out.push(sect_sum)
    out.push(bytes_sum)
    out.push(dll_sum)
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pestage2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pls()

    // 2. record 3 PEs (synthetic — Battle.net-Setup / D2R / Battle.net)
    orchestrate_record(72001, 5, 5279744, 16)
    r0_emit("pe_loader_stage2_record",
        "\"orchestrate_id\":72001,\"sections\":5,\"bytes_mapped\":5279744,\"dlls_loaded\":16,\"pe\":\"Battle.net-Setup.exe\"")

    orchestrate_record(72002, 12, 20000000, 24)
    r0_emit("pe_loader_stage2_record",
        "\"orchestrate_id\":72002,\"sections\":12,\"bytes_mapped\":20000000,\"dlls_loaded\":24,\"pe\":\"D2R.exe\"")

    orchestrate_record(72003, 8, 15000000, 20)
    r0_emit("pe_loader_stage2_record",
        "\"orchestrate_id\":72003,\"sections\":8,\"bytes_mapped\":15000000,\"dlls_loaded\":20,\"pe\":\"Battle.net.exe\"")

    // 3. orchestrate_loader sanity (deterministic — empty path → 1)
    let bad = orchestrate_loader("")
    if bad != 1 {
        panic("pe_loader_stage2 FAIL [orchestrate_loader empty] expected=1 got=" + to_string(bad))
    }

    // 4. map_pe_sections sanity (synthetic bucket 결과 검증)
    let mr = map_pe_sections("/tmp/synthetic.exe", 4194304)
    if len(mr) != 3 {
        panic("pe_loader_stage2 FAIL [map_pe_sections len] expected=3 got=" + to_string(len(mr)))
    }
    if mr[0] <= 0 {
        panic("pe_loader_stage2 FAIL [map_pe_sections sections] expected=>0 got=" + to_string(mr[0]))
    }
    if mr[1] <= 0 {
        panic("pe_loader_stage2 FAIL [map_pe_sections bytes] expected=>0 got=" + to_string(mr[1]))
    }
    if mr[2] != 4194304 + mr[1] {
        panic("pe_loader_stage2 FAIL [map_pe_sections virt_top] expected="
            + to_string(4194304 + mr[1]) + " got=" + to_string(mr[2]))
    }

    // 5. load_dependencies sanity
    let dn = load_dependencies("/tmp/synthetic.exe")
    if dn <= 0 {
        panic("pe_loader_stage2 FAIL [load_dependencies] expected=>0 got=" + to_string(dn))
    }

    // 6. pls_stats() = [3, 25, 40279744, 60]
    let s = pls_stats()
    if len(s) != 4 {
        panic("pe_loader_stage2 FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 3 {
        panic("pe_loader_stage2 FAIL [orchestrate_count] expected=3 got=" + to_string(s[0]))
    }
    if s[1] != 25 {
        panic("pe_loader_stage2 FAIL [total_sections_mapped] expected=25 got=" + to_string(s[1]))
    }
    if s[2] != 40279744 {
        panic("pe_loader_stage2 FAIL [total_bytes_mapped] expected=40279744 got=" + to_string(s[2]))
    }
    if s[3] != 60 {
        panic("pe_loader_stage2 FAIL [total_dlls_loaded] expected=60 got=" + to_string(s[3]))
    }

    // 7. emit stats
    r0_emit("pe_loader_stage2_stats",
        "\"orchestrate_count\":" + to_string(s[0])
        + ",\"total_sections\":" + to_string(s[1])
        + ",\"total_bytes\":" + to_string(s[2])
        + ",\"total_dlls\":" + to_string(s[3]))

    // 8. emit count >= 4 (실제: 3 records + 1 stats = 4)
    let emit_n = r0_session_count(sid)
    if emit_n < 4 {
        panic("pe_loader_stage2 FAIL [r0 emit count] expected=>=4 got=" + to_string(emit_n))
    }

    // 9. cleanup → stats 모두 0
    cleanup_pls()
    let s2 = pls_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_loader_stage2 FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_loader_stage2 self_test PASS (3 PEs, sections=" + to_string(s[1])
        + ", bytes=" + to_string(s[2]) + ", dlls=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pls_stats()
            println("orchestrate_count\t" + to_string(s[0]))
            println("total_sections_mapped\t" + to_string(s[1]))
            println("total_bytes_mapped\t" + to_string(s[2]))
            println("total_dlls_loaded\t" + to_string(s[3]))
            return
        }
        if sub == "orchestrate" {
            if len(a) >= 4 {
                let rc = orchestrate_loader(a[3])
                println("stage_code\t" + to_string(rc))
                return
            }
            println("usage: hexa run pe_loader_stage2.hexa orchestrate <pe_path>")
            return
        }
        if sub == "cleanup" {
            cleanup_pls()
            println("cleaned: " + pls_dir())
            return
        }
        if sub == "dir" {
            println(pls_dir())
            return
        }
    }
    println("usage: hexa run pe_loader_stage2.hexa { self-test | stats | orchestrate <pe_path> | cleanup | dir }")
}
