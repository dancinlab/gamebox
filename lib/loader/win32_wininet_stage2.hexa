// lib/loader/win32_wininet_stage2.hexa — Battle.net Setup WININET imports coverage
//
// Battle.net 의 HTTP client (WININET) 함수 — InternetOpenA/W, HttpOpenRequest,
// InternetReadFile, InternetCloseHandle 등. stage1 base 위에 Battle.net 특이
// imports 추가.
//
// own 1: Wine 0. Microsoft WININET API spec 만 참조.
//   https://learn.microsoft.com/en-us/windows/win32/api/wininet/
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe WININET imports (실측, DLL idx=13, 11 funcs):
//   HttpSendRequestA, InternetCloseHandle, InternetSetStatusCallbackA,
//   InternetOpenA, InternetReadFileExA, InternetSetCookieW,
//   InternetSetOptionA, InternetCrackUrlA, HttpOpenRequestA,
//   HttpQueryInfoA, InternetConnectA
//
// stage2 = synthetic stub layer (실제 network 호출 없이 ABI level retval):
//   HANDLE returns (HINTERNET) → 1
//   BOOL returns               → 1 (TRUE)
//   DWORD returns              → 0

use "../perf/r0_common"

// ─── HINTERNET handle returns ───────────────────────────────
fn stub_internet_open_a() -> int {
    return 1
}

fn stub_internet_open_w() -> int {
    return 1
}

fn stub_internet_connect_a() -> int {
    return 1
}

fn stub_http_open_request_a() -> int {
    return 1
}

fn stub_http_open_request_w() -> int {
    return 1
}

// ─── BOOL returns ───────────────────────────────────────────
fn stub_internet_close_handle() -> int {
    return 1
}

fn stub_http_send_request_a() -> int {
    return 1
}

fn stub_internet_read_file() -> int {
    return 1
}

fn stub_internet_read_file_ex_a() -> int {
    return 1
}

fn stub_internet_set_cookie_w() -> int {
    return 1
}

fn stub_internet_set_option_a() -> int {
    return 1
}

fn stub_internet_crack_url_a() -> int {
    return 1
}

fn stub_http_query_info_a() -> int {
    return 1
}

// ─── DWORD / function-ptr returns ───────────────────────────
//   InternetSetStatusCallbackA returns previous callback (or
//   INTERNET_INVALID_STATUS_CALLBACK = -1 ); stub returns 0.
fn stub_internet_set_status_callback_a() -> int {
    return 0
}

// ─── coverage table — stub name → return-class ──────────────
fn stub_table() -> str {
    let t = ""
    t = t + "InternetOpenA\tHANDLE\n"
    t = t + "InternetOpenW\tHANDLE\n"
    t = t + "InternetConnectA\tHANDLE\n"
    t = t + "HttpOpenRequestA\tHANDLE\n"
    t = t + "HttpOpenRequestW\tHANDLE\n"
    t = t + "InternetCloseHandle\tBOOL\n"
    t = t + "HttpSendRequestA\tBOOL\n"
    t = t + "InternetReadFile\tBOOL\n"
    t = t + "InternetReadFileExA\tBOOL\n"
    t = t + "InternetSetCookieW\tBOOL\n"
    t = t + "InternetSetOptionA\tBOOL\n"
    t = t + "InternetCrackUrlA\tBOOL\n"
    t = t + "HttpQueryInfoA\tBOOL\n"
    t = t + "InternetSetStatusCallbackA\tDWORD\n"
    return t
}

fn stub_count() -> int {
    let lines = stub_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn list_stubs() -> void {
    let lines = stub_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            println(lines[i])
        }
        i = i + 1
    }
}

fn self_test() -> void {
    let sid = "wininets2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. stub count
    let n = stub_count()
    if n != 14 { panic("win32_wininet_stage2 FAIL [count] expected=14 got=" + to_string(n)) }

    // 2. HANDLE-returning stubs → 1
    let h1 = stub_internet_open_a()
    if h1 != 1 { panic("win32_wininet_stage2 FAIL [InternetOpenA] expected=1 got=" + to_string(h1)) }
    let h2 = stub_internet_open_w()
    if h2 != 1 { panic("win32_wininet_stage2 FAIL [InternetOpenW] expected=1 got=" + to_string(h2)) }
    let h3 = stub_internet_connect_a()
    if h3 != 1 { panic("win32_wininet_stage2 FAIL [InternetConnectA] expected=1 got=" + to_string(h3)) }
    let h4 = stub_http_open_request_a()
    if h4 != 1 { panic("win32_wininet_stage2 FAIL [HttpOpenRequestA] expected=1 got=" + to_string(h4)) }
    let h5 = stub_http_open_request_w()
    if h5 != 1 { panic("win32_wininet_stage2 FAIL [HttpOpenRequestW] expected=1 got=" + to_string(h5)) }

    // 3. BOOL-returning stubs → 1
    let b1 = stub_internet_close_handle()
    if b1 != 1 { panic("win32_wininet_stage2 FAIL [InternetCloseHandle] expected=1 got=" + to_string(b1)) }
    let b2 = stub_http_send_request_a()
    if b2 != 1 { panic("win32_wininet_stage2 FAIL [HttpSendRequestA] expected=1 got=" + to_string(b2)) }
    let b3 = stub_internet_read_file()
    if b3 != 1 { panic("win32_wininet_stage2 FAIL [InternetReadFile] expected=1 got=" + to_string(b3)) }
    let b4 = stub_internet_read_file_ex_a()
    if b4 != 1 { panic("win32_wininet_stage2 FAIL [InternetReadFileExA] expected=1 got=" + to_string(b4)) }
    let b5 = stub_internet_set_cookie_w()
    if b5 != 1 { panic("win32_wininet_stage2 FAIL [InternetSetCookieW] expected=1 got=" + to_string(b5)) }
    let b6 = stub_internet_set_option_a()
    if b6 != 1 { panic("win32_wininet_stage2 FAIL [InternetSetOptionA] expected=1 got=" + to_string(b6)) }
    let b7 = stub_internet_crack_url_a()
    if b7 != 1 { panic("win32_wininet_stage2 FAIL [InternetCrackUrlA] expected=1 got=" + to_string(b7)) }
    let b8 = stub_http_query_info_a()
    if b8 != 1 { panic("win32_wininet_stage2 FAIL [HttpQueryInfoA] expected=1 got=" + to_string(b8)) }

    // 4. DWORD-returning stub → 0
    let d1 = stub_internet_set_status_callback_a()
    if d1 != 0 { panic("win32_wininet_stage2 FAIL [InternetSetStatusCallbackA] expected=0 got=" + to_string(d1)) }

    // 5. r0_emit
    r0_emit("wininet_stage2_stub",
        "\"stubs\":" + to_string(n)
        + ",\"handles\":5,\"bools\":8,\"dwords\":1")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_wininet_stage2 FAIL [emit count] expected=>=1 got=" + to_string(cnt)) }

    println("  ✅ win32_wininet_stage2 self_test PASS (" + to_string(n) + " functions stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            list_stubs()
            return
        }
    }
    println("usage: hexa run win32_wininet_stage2.hexa { self-test | list }")
}
