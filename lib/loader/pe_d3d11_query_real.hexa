// lib/loader/pe_d3d11_query_real.hexa — D3D11 ID3D11Query real_invoke (phase_kind 2)
//
// ID3D11Query Begin/End/GetData → MTLCounterSampleBuffer +
// sampleCountersInBuffer:atSampleIndex. timestamp_disjoint → mach_timebase_info.
// cycle 76 (pe_d3d11_query.hexa) 의 query_kind 추적기 위에 phase_kind 차원을
// 추가해 Begin/End/GetData lifecycle 의 실 invoke 단계까지 record. 본 module 은
// in-memory 모델로 phase x kind matrix 를 aggregate — 실 ID3D11DeviceContext::Begin
// /End/GetData → Metal counter sample buffer bridge 는 stage2 native helper 가
// 처리.
//
// own 1 enforcement: D3DMetal + MSDN ID3D11Query 만 reference. Wine / CrossOver /
// community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code (lifecycle stage):
//   1 = begin
//   2 = end
//   3 = get_data
//
// query_kind code (D3D11_QUERY enum 의 sentinel mapping):
//   1 = event
//   2 = occlusion
//   3 = timestamp
//   4 = timestamp_disjoint
//   5 = pipeline_stats
//
// persist schema (TSV — queries.tsv):
//   query_id<int> \t phase_kind<int> \t query_kind<int> \t result_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdqr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3d11_query_real"
}

fn pdqr_queries_path() -> str {
    return pdqr_dir() + "/queries.tsv"
}

fn pdqr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdqr_dir() + "'")
}

fn cleanup_pdqr() -> void {
    pdqr_ensure_dir()
    let _ = exec("rm -f '" + pdqr_queries_path() + "'")
}

// ─── 공통 file IO ───
fn pdqr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdqr_append_row(path: str, row: str) -> void {
    pdqr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_query: GPU query 1 건 lifecycle phase 기록 ───
fn record_query(query_id: int, phase_kind: int, query_kind: int, result_us: int) -> void {
    if query_id <= 0 {
        panic("pe_d3d11_query_real FAIL [record_query] expected=query_id>0 got=" + to_string(query_id))
    }
    if phase_kind < 1 {
        panic("pe_d3d11_query_real FAIL [record_query] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 3 {
        panic("pe_d3d11_query_real FAIL [record_query] expected=phase_kind<=3 got=" + to_string(phase_kind))
    }
    if query_kind < 1 {
        panic("pe_d3d11_query_real FAIL [record_query] expected=query_kind>=1 got=" + to_string(query_kind))
    }
    if query_kind > 5 {
        panic("pe_d3d11_query_real FAIL [record_query] expected=query_kind<=5 got=" + to_string(query_kind))
    }
    if result_us < 0 {
        panic("pe_d3d11_query_real FAIL [record_query] expected=result_us>=0 got=" + to_string(result_us))
    }
    let row = to_string(query_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(query_kind) + "\t" + to_string(result_us) + "\n"
    pdqr_append_row(pdqr_queries_path(), row)
}

// ─── query_count: total query 수 ───
fn query_count() -> int {
    let t = pdqr_read_table(pdqr_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 query 수 ───
fn count_by_phase_kind(phase: int) -> int {
    let t = pdqr_read_table(pdqr_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_query_kind: 특정 query_kind 의 query 수 ───
fn count_by_query_kind(kind: int) -> int {
    let t = pdqr_read_table(pdqr_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_result_us: 모든 query result_us 합 ───
fn total_result_us() -> int {
    let t = pdqr_read_table(pdqr_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── timestamp_count: timestamp(3) + timestamp_disjoint(4) 합 ───
fn timestamp_count() -> int {
    return count_by_query_kind(3) + count_by_query_kind(4)
}

// ─── query_result_us: 특정 query_id 의 result_us (없으면 0; 동일 id 다중 phase 시 첫 매칭) ───
fn query_result_us(query_id: int) -> int {
    let t = pdqr_read_table(pdqr_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == query_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdqr_stats: [query_count, total_result_us, timestamp_count, count_by_phase_kind(3)] ───
fn pdqr_stats() -> array {
    let mut out = []
    out.push(query_count())
    out.push(total_result_us())
    out.push(timestamp_count())
    out.push(count_by_phase_kind(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdqr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdqr()

    // 2. record 6 queries — covers all 3 phase_kinds + ≥3 query_kinds
    //    (begin → timestamp, end → timestamp, get_data → timestamp,
    //     begin → occlusion, end → pipeline_stats, get_data → timestamp_disjoint)
    record_query(330001, 1, 3, 0)
    r0_emit("pe_d3d11_query_real_record",
        "\"query_id\":330001,\"phase_kind\":1,\"query_kind\":3,\"result_us\":0,\"target\":\"begin/timestamp\"")

    record_query(330001, 2, 3, 0)
    r0_emit("pe_d3d11_query_real_record",
        "\"query_id\":330001,\"phase_kind\":2,\"query_kind\":3,\"result_us\":0,\"target\":\"end/timestamp\"")

    record_query(330001, 3, 3, 1500)
    r0_emit("pe_d3d11_query_real_record",
        "\"query_id\":330001,\"phase_kind\":3,\"query_kind\":3,\"result_us\":1500,\"target\":\"get_data/timestamp\"")

    record_query(330002, 1, 2, 0)
    r0_emit("pe_d3d11_query_real_record",
        "\"query_id\":330002,\"phase_kind\":1,\"query_kind\":2,\"result_us\":0,\"target\":\"begin/occlusion\"")

    record_query(330003, 2, 5, 0)
    r0_emit("pe_d3d11_query_real_record",
        "\"query_id\":330003,\"phase_kind\":2,\"query_kind\":5,\"result_us\":0,\"target\":\"end/pipeline_stats\"")

    record_query(330004, 3, 4, 900)
    r0_emit("pe_d3d11_query_real_record",
        "\"query_id\":330004,\"phase_kind\":3,\"query_kind\":4,\"result_us\":900,\"target\":\"get_data/timestamp_disjoint\"")

    // 3. query_count = 6
    let c = query_count()
    if c != 6 {
        panic("pe_d3d11_query_real FAIL [query_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_phase_kind sanity
    let p1 = count_by_phase_kind(1)
    if p1 != 2 {
        panic("pe_d3d11_query_real FAIL [count_by_phase_kind(1)] expected=2 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 2 {
        panic("pe_d3d11_query_real FAIL [count_by_phase_kind(2)] expected=2 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 2 {
        panic("pe_d3d11_query_real FAIL [count_by_phase_kind(3)] expected=2 got=" + to_string(p3))
    }

    // 5. count_by_query_kind sanity
    let k2 = count_by_query_kind(2)
    if k2 != 1 {
        panic("pe_d3d11_query_real FAIL [count_by_query_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_query_kind(3)
    if k3 != 3 {
        panic("pe_d3d11_query_real FAIL [count_by_query_kind(3)] expected=3 got=" + to_string(k3))
    }
    let k4 = count_by_query_kind(4)
    if k4 != 1 {
        panic("pe_d3d11_query_real FAIL [count_by_query_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_query_kind(5)
    if k5 != 1 {
        panic("pe_d3d11_query_real FAIL [count_by_query_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k1 = count_by_query_kind(1)
    if k1 != 0 {
        panic("pe_d3d11_query_real FAIL [count_by_query_kind(1)] expected=0 got=" + to_string(k1))
    }

    // 6. total_result_us = 1500 + 900 = 2400
    let tr = total_result_us()
    if tr != 2400 {
        panic("pe_d3d11_query_real FAIL [total_result_us] expected=2400 got=" + to_string(tr))
    }

    // 7. timestamp_count = kind3(3) + kind4(1) = 4
    let tc = timestamp_count()
    if tc != 4 {
        panic("pe_d3d11_query_real FAIL [timestamp_count] expected=4 got=" + to_string(tc))
    }

    // 8. query_result_us — 첫 매칭 (330001 → phase 1 row → 0)
    let r1 = query_result_us(330001)
    if r1 != 0 {
        panic("pe_d3d11_query_real FAIL [query_result_us(330001)] expected=0 got=" + to_string(r1))
    }
    let r4 = query_result_us(330004)
    if r4 != 900 {
        panic("pe_d3d11_query_real FAIL [query_result_us(330004)] expected=900 got=" + to_string(r4))
    }
    let r_miss = query_result_us(9999)
    if r_miss != 0 {
        panic("pe_d3d11_query_real FAIL [query_result_us(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 9. pdqr_stats() = [6, 2400, 4, 2]
    let s = pdqr_stats()
    if len(s) != 4 {
        panic("pe_d3d11_query_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_d3d11_query_real FAIL [stats query_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2400 {
        panic("pe_d3d11_query_real FAIL [stats total_result_us] expected=2400 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_d3d11_query_real FAIL [stats timestamp_count] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_d3d11_query_real FAIL [stats phase_get_data] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_d3d11_query_real_stats",
        "\"query_count\":" + to_string(s[0])
        + ",\"total_result_us\":" + to_string(s[1])
        + ",\"timestamp_count\":" + to_string(s[2])
        + ",\"phase_get_data\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_d3d11_query_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdqr()
    let s2 = pdqr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d3d11_query_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3d11_query_real self_test PASS (queries=" + to_string(s[0])
        + ", result_us=" + to_string(s[1]) + ", ts_count=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdqr_stats()
            println("query_count\t" + to_string(s[0]))
            println("total_result_us\t" + to_string(s[1]))
            println("timestamp_count\t" + to_string(s[2]))
            println("count_phase_get_data\t" + to_string(s[3]))
            return
        }
        if sub == "result" {
            if len(a) >= 4 {
                let qid = to_int(a[3])
                println("query_result_us\t" + to_string(query_result_us(qid)))
                return
            }
            println("usage: hexa run pe_d3d11_query_real.hexa result <query_id>")
            return
        }
        if sub == "count-phase" {
            if len(a) >= 4 {
                let phase = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(phase)))
                return
            }
            println("usage: hexa run pe_d3d11_query_real.hexa count-phase <phase_kind>")
            return
        }
        if sub == "count-kind" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_query_kind\t" + to_string(count_by_query_kind(kind)))
                return
            }
            println("usage: hexa run pe_d3d11_query_real.hexa count-kind <query_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdqr()
            println("cleaned: " + pdqr_dir())
            return
        }
        if sub == "dir" {
            println(pdqr_dir())
            return
        }
    }
    println("usage: hexa run pe_d3d11_query_real.hexa { self-test | stats | result <query_id> | count-phase <phase_kind> | count-kind <query_kind> | cleanup | dir }")
}
