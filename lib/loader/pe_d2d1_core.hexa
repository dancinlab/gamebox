// lib/loader/pe_d2d1_core.hexa — D2D1.dll Direct2D rendering surface (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine d2d1 source 인용 0.
//       d2d1.dll 직접 binding 0. macOS CoreGraphics CGContext / CGPath / CGGradient /
//       CoreText CTFontRef / CTLineCreateWithAttributedString / NSAttributedString /
//       CGColorRef / CGImageRef / CALayer 직접 binding 0.
//       NOTE: D2D1 측 ID2D1Factory ↔ ID2D1RenderTarget ↔ ID2D1Brush/Bitmap/Geometry/StrokeStyle
//       2D rendering tree pattern + D2D1_RECT_F/D2D1_COLOR_F/IDWriteTextFormat
//       round-trip baseline (long-horizon production smoke pending separate cycle).
//       **90% threshold breach milestone** at cycle 59 via BL4 D2D1.
// own2: r0_emit ≥ 16 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BL4 — D2D1 Direct2D rendering surface 13 fn skeleton-tier (factory/render_target/resources/text).
// cycle 58 385/435 (~88.51%) → cycle 59 ~398/435 (~91.49%) (+13 fn, BL bundled part 4/4).
// **90% threshold breach milestone** at cycle 59 via BL4 D2D1 (398/435 91.49%, exceeds spec target ~85%).
//
// 대상 fn (13 fn — 4 group, fn_kind 0..12):
//   FACTORY        (3): D2D1CreateFactory(0) /
//                       ID2D1Factory_CreateHwndRenderTarget(1) /
//                       ID2D1Factory_CreateBitmapRenderTarget(2)
//   RENDER_TARGET  (4): ID2D1RenderTarget_BeginDraw(3) /
//                       ID2D1RenderTarget_EndDraw(4) /
//                       ID2D1RenderTarget_Clear(5) /
//                       ID2D1RenderTarget_DrawRectangle(6)
//   RESOURCES      (4): ID2D1RenderTarget_CreateSolidColorBrush(7) /
//                       ID2D1RenderTarget_CreateBitmap(8) /
//                       ID2D1Factory_CreatePathGeometry(9) /
//                       ID2D1Factory_CreateStrokeStyle(10)
//   TEXT           (2): ID2D1RenderTarget_DrawText(11) /
//                       IDWriteFactory_CreateTextFormat(12)
//   (총 = 3+4+4+2 = 13 fn — spec 12 + DWrite text-format split = 13 total final)
//   spec primary = 12 fn (factory 3 + render_target 4 + resources 4 + text 2 - 1)
//   actual self_test count = 13 fn for completeness (DWrite split family).
//
// synthetic struct families:
//   ID2D1Factory 0xF1010100 / ID2D1HwndRenderTarget 0xF1020100 /
//   ID2D1BitmapRenderTarget 0xF1020200 / ID2D1SolidColorBrush 0xF1030100 /
//   ID2D1Bitmap 0xF1040100 / ID2D1PathGeometry 0xF1050100 /
//   ID2D1StrokeStyle 0xF1060100 / IDWriteTextFormat 0xF1070100 opaque (synthetic).
//   D2D1_RECT_F 16B left 0.0 top 0.0 right 200.0 bottom 32.0 button rect.
//   D2D1_COLOR_F 16B r 0.94 g 0.94 b 0.94 a 1.0 (windowtext).
//   D2D1_BRUSH_PROPERTIES 24B + D2D1_BITMAP_PROPERTIES 28B.
//   D2D1_RENDER_TARGET_PROPERTIES 28B type=DEFAULT pixelFormat=B8G8R8A8 alphaMode=PREMULTIPLIED.
//   D2D1_HWND_RENDER_TARGET_PROPERTIES 16B + D2D1_PIXEL_FORMAT 8B.
//   D2D1_STROKE_STYLE_PROPERTIES 28B startCap=FLAT endCap=FLAT lineJoin=MITER miterLimit=10.0.
//   IDWriteTextFormat synth Segoe UI 12.0pt FontWeight 400 NORMAL FontStretch 5.
//
// persist schema (TSV — 5 table):
//   syscall_invoke / factory_event / render_target_event / resource_event / text_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn put_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d2d1_core"
}

fn put_syscall_invoke_path() -> str {
    return put_dir() + "/syscall_invoke.tsv"
}

fn put_factory_event_path() -> str {
    return put_dir() + "/factory_event.tsv"
}

fn put_render_target_event_path() -> str {
    return put_dir() + "/render_target_event.tsv"
}

fn put_resource_event_path() -> str {
    return put_dir() + "/resource_event.tsv"
}

fn put_text_event_path() -> str {
    return put_dir() + "/text_event.tsv"
}

fn put_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + put_dir() + "'")
}

fn cleanup_put() -> void {
    put_ensure_dir()
    let _ = exec("rm -f '" + put_syscall_invoke_path() + "' '" + put_factory_event_path()
        + "' '" + put_render_target_event_path() + "' '" + put_resource_event_path()
        + "' '" + put_text_event_path() + "'")
}

// ─── 공통 file IO ───
fn put_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn put_append_row(path: str, row: str) -> void {
    put_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn put_count_rows(path: str, min_cols: int) -> int {
    let t = put_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (13 fn coverage, fn_kind 0..12) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "D2D1CreateFactory" }
    if k == 1 { return "ID2D1Factory_CreateHwndRenderTarget" }
    if k == 2 { return "ID2D1Factory_CreateBitmapRenderTarget" }
    if k == 3 { return "ID2D1RenderTarget_BeginDraw" }
    if k == 4 { return "ID2D1RenderTarget_EndDraw" }
    if k == 5 { return "ID2D1RenderTarget_Clear" }
    if k == 6 { return "ID2D1RenderTarget_DrawRectangle" }
    if k == 7 { return "ID2D1RenderTarget_CreateSolidColorBrush" }
    if k == 8 { return "ID2D1RenderTarget_CreateBitmap" }
    if k == 9 { return "ID2D1Factory_CreatePathGeometry" }
    if k == 10 { return "ID2D1Factory_CreateStrokeStyle" }
    if k == 11 { return "ID2D1RenderTarget_DrawText" }
    if k == 12 { return "IDWriteFactory_CreateTextFormat" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "factory"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "render_target"
        }
    }
    if k >= 7 {
        if k <= 10 {
            return "resources"
        }
    }
    if k >= 11 {
        if k <= 12 {
            return "text"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: D2D1 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_d2d1_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_d2d1_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 12 {
        panic("pe_d2d1_core FAIL [record_syscall_invoke] expected=fn_kind<=12 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_d2d1_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_d2d1_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    put_append_row(put_syscall_invoke_path(), row)
}

// ─── record_factory_event: D2D1CreateFactory/CreateHwndRenderTarget/CreateBitmapRenderTarget row ───
fn record_factory_event(evt_id: int, f_kind: str, factory_synth: str, target_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_d2d1_core FAIL [record_factory_event] evt_id<=0") }
    if f_kind == "" { panic("pe_d2d1_core FAIL [record_factory_event] f_kind=empty") }
    if factory_synth == "" { panic("pe_d2d1_core FAIL [record_factory_event] factory_synth=empty") }
    if target_synth == "" { panic("pe_d2d1_core FAIL [record_factory_event] target_synth=empty") }
    if status == "" { panic("pe_d2d1_core FAIL [record_factory_event] status=empty") }
    let row = to_string(evt_id) + "\t" + f_kind + "\t" + factory_synth + "\t" + target_synth + "\t" + status + "\n"
    put_append_row(put_factory_event_path(), row)
}

