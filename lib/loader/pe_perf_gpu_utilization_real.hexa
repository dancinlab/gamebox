// lib/loader/pe_perf_gpu_utilization_real.hexa — Apple GPU utilization sampler.
// own1: Apple Metal + Foundation only. Wine 인용 X
// schema: sample_id<int> \t utilization_pct<int> \t thermal_state<int> \t power_state<int>

use "../perf/r0_common"

fn pgur_dir() -> str { return GAMEBOX_HOME + "/persist/pe_perf_gpu_utilization_real" }
fn pgur_samples_path() -> str { return pgur_dir() + "/samples.tsv" }
fn pgur_ensure_dir() -> void { let _ = exec("mkdir -p '" + pgur_dir() + "'") }
fn cleanup_pgur() -> void { pgur_ensure_dir(); let _ = exec("rm -f '" + pgur_samples_path() + "'") }

fn pgur_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" { return "" }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pgur_append_row(path: str, row: str) -> void {
    pgur_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn record_sample(sample_id: int, utilization_pct: int, thermal_state: int, power_state: int) -> void {
    if sample_id <= 0 { panic("pe_perf_gpu_utilization_real FAIL [record] sample_id>0 got=" + to_string(sample_id)) }
    if utilization_pct < 0 { panic("pe_perf_gpu_utilization_real FAIL [record] util>=0 got=" + to_string(utilization_pct)) }
    if utilization_pct > 100 { panic("pe_perf_gpu_utilization_real FAIL [record] util<=100 got=" + to_string(utilization_pct)) }
    if thermal_state < 1 { panic("pe_perf_gpu_utilization_real FAIL [record] thermal>=1 got=" + to_string(thermal_state)) }
    if thermal_state > 4 { panic("pe_perf_gpu_utilization_real FAIL [record] thermal<=4 got=" + to_string(thermal_state)) }
    if power_state < 1 { panic("pe_perf_gpu_utilization_real FAIL [record] power>=1 got=" + to_string(power_state)) }
    if power_state > 4 { panic("pe_perf_gpu_utilization_real FAIL [record] power<=4 got=" + to_string(power_state)) }
    let row = to_string(sample_id) + "\t" + to_string(utilization_pct)
        + "\t" + to_string(thermal_state) + "\t" + to_string(power_state) + "\n"
    pgur_append_row(pgur_samples_path(), row)
}

fn sample_count() -> int {
    let t = pgur_read_table(pgur_samples_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { cnt = cnt + 1 }
        }
        i = i + 1
    }
    return cnt
}

fn total_utilization_pct() -> int {
    let t = pgur_read_table(pgur_samples_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { sum = sum + to_int(parts[1]) }
        }
        i = i + 1
    }
    return sum
}

fn count_by_thermal_state(thermal_state: int) -> int {
    let t = pgur_read_table(pgur_samples_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == thermal_state { cnt = cnt + 1 }
            }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_power_state(power_state: int) -> int {
    let t = pgur_read_table(pgur_samples_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == power_state { cnt = cnt + 1 }
            }
        }
        i = i + 1
    }
    return cnt
}

fn throttled_count() -> int {
    return count_by_power_state(2) + count_by_power_state(3) + count_by_power_state(4)
}

fn sample_utilization(sample_id: int) -> int {
    let t = pgur_read_table(pgur_samples_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == sample_id { return to_int(parts[1]) }
            }
        }
        i = i + 1
    }
    return 0
}

fn pgur_stats() -> array {
    let mut out = []
    out.push(sample_count())
    out.push(total_utilization_pct())
    out.push(throttled_count())
    out.push(count_by_thermal_state(1))
    out.push(count_by_power_state(1))
    return out
}

fn self_test() -> void {
    let sid = "pgur-" + exec("date +%s").trim()
    r0_session_set(sid)
    cleanup_pgur()

    record_sample(200001, 95, 1, 1)
    r0_emit("pe_perf_gpu_utilization_real_record", "\"id\":200001,\"util\":95,\"thermal\":1,\"power\":1")
    record_sample(200002, 87, 2, 1)
    r0_emit("pe_perf_gpu_utilization_real_record", "\"id\":200002,\"util\":87,\"thermal\":2,\"power\":1")
    record_sample(200003, 78, 3, 2)
    r0_emit("pe_perf_gpu_utilization_real_record", "\"id\":200003,\"util\":78,\"thermal\":3,\"power\":2")
    record_sample(200004, 65, 4, 3)
    r0_emit("pe_perf_gpu_utilization_real_record", "\"id\":200004,\"util\":65,\"thermal\":4,\"power\":3")
    record_sample(200005, 30, 4, 4)
    r0_emit("pe_perf_gpu_utilization_real_record", "\"id\":200005,\"util\":30,\"thermal\":4,\"power\":4")
    record_sample(200006, 88, 1, 1)
    r0_emit("pe_perf_gpu_utilization_real_record", "\"id\":200006,\"util\":88,\"thermal\":1,\"power\":1")

    let c = sample_count()
    if c != 6 { panic("pe_perf_gpu_utilization_real FAIL [sample_count] expected=6 got=" + to_string(c)) }
    let tu = total_utilization_pct()
    if tu != 443 { panic("pe_perf_gpu_utilization_real FAIL [total_util] expected=443 got=" + to_string(tu)) }
    let tc = throttled_count()
    if tc != 3 { panic("pe_perf_gpu_utilization_real FAIL [throttled_count] expected=3 got=" + to_string(tc)) }
    let t1 = count_by_thermal_state(1)
    if t1 != 2 { panic("pe_perf_gpu_utilization_real FAIL [thermal_1] expected=2 got=" + to_string(t1)) }

    let s = pgur_stats()
    if len(s) != 5 { panic("pe_perf_gpu_utilization_real FAIL [stats len] expected=5 got=" + to_string(len(s))) }
    r0_emit("pe_perf_gpu_utilization_real_stats",
        "\"samples\":" + to_string(s[0]) + ",\"total_util\":" + to_string(s[1])
        + ",\"throttled\":" + to_string(s[2]) + ",\"thermal_1\":" + to_string(s[3]))

    let emit_n = r0_session_count(sid)
    if emit_n < 7 { panic("pe_perf_gpu_utilization_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n)) }

    cleanup_pgur()
    let s2 = pgur_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 { panic("pe_perf_gpu_utilization_real FAIL [cleanup stats[" + to_string(i) + "]] expected=0 got=" + to_string(s2[i])) }
        i = i + 1
    }

    println("  ✅ pe_perf_gpu_utilization_real self_test PASS (samples=" + to_string(s[0])
        + ", total_util=" + to_string(s[1]) + ", throttled=" + to_string(s[2])
        + ", thermal_1=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = pgur_stats()
            println("sample_count\t" + to_string(s[0]))
            println("total_util\t" + to_string(s[1]))
            println("throttled_count\t" + to_string(s[2]))
            println("thermal_nominal\t" + to_string(s[3]))
            println("power_full\t" + to_string(s[4]))
            return
        }
        if sub == "cleanup" { cleanup_pgur(); println("cleaned: " + pgur_dir()); return }
        if sub == "dir" { println(pgur_dir()); return }
    }
    println("usage: hexa run pe_perf_gpu_utilization_real.hexa { self-test | stats | cleanup | dir }")
}
