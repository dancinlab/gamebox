// lib/loader/pe_ipc_handshake.hexa — stage5 IPC handshake protocol skeleton
//
// 첫 연결 시 client (docker) → server (host helper) version 정보 교환,
// capability set negotiate, auth token verify. 일부분 보안 요청 시 mutual
// challenge-response 도 가능.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 handshake tracker — 실 socket handshake X (stage6).
// own 2 mandate: r0_emit ≥ 5 + self_test() + main() dispatch + headless safe + panic 형식.
//
// persist schema (TSV — handshakes.tsv):
//   session_id<int> \t client_version<int> \t server_version<int> \t success<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pih_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ipc_handshake"
}

fn pih_handshakes_path() -> str {
    return pih_dir() + "/handshakes.tsv"
}

fn pih_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pih_dir() + "'")
}

fn cleanup_pih() -> void {
    pih_ensure_dir()
    let _ = exec("rm -f '" + pih_handshakes_path() + "'")
}

// ─── 공통 file IO ───
fn pih_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pih_append_row(path: str, row: str) -> void {
    pih_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_handshake: handshake 1 건 기록 ───
fn record_handshake(session_id: int, client_version: int, server_version: int, success: int) -> void {
    if session_id <= 0 {
        panic("pe_ipc_handshake FAIL [record_handshake] expected=session_id>0 got=" + to_string(session_id))
    }
    if client_version < 1 {
        panic("pe_ipc_handshake FAIL [record_handshake] expected=client_version>=1 got=" + to_string(client_version))
    }
    if server_version < 1 {
        panic("pe_ipc_handshake FAIL [record_handshake] expected=server_version>=1 got=" + to_string(server_version))
    }
    if success < 0 {
        panic("pe_ipc_handshake FAIL [record_handshake] expected=success>=0 got=" + to_string(success))
    }
    if success > 1 {
        panic("pe_ipc_handshake FAIL [record_handshake] expected=success<=1 got=" + to_string(success))
    }
    let row = to_string(session_id) + "\t" + to_string(client_version)
        + "\t" + to_string(server_version) + "\t" + to_string(success) + "\n"
    pih_append_row(pih_handshakes_path(), row)
}

// ─── handshake_count: total handshake 수 ───
fn handshake_count() -> int {
    let t = pih_read_table(pih_handshakes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── success_count: success=1 인 handshake 수 ───
fn success_count() -> int {
    let t = pih_read_table(pih_handshakes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── fail_count: success=0 인 handshake 수 ───
fn fail_count() -> int {
    let t = pih_read_table(pih_handshakes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── version_match_count: client_version == server_version 인 handshake 수 ───
fn version_match_count() -> int {
    let t = pih_read_table(pih_handshakes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == to_int(parts[2]) {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── session_versions: 특정 session_id 의 client version (없으면 0) ───
fn session_versions(session_id: int) -> int {
    let t = pih_read_table(pih_handshakes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == session_id {
                    return to_int(parts[1])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pih_stats: [handshake_count, success_count, fail_count, version_match_count] ───
fn pih_stats() -> array {
    let mut out = []
    out.push(handshake_count())
    out.push(success_count())
    out.push(fail_count())
    out.push(version_match_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pih-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pih()

    // 2. record 4 handshakes (deterministic synthetic)
    record_handshake(116001, 1, 1, 1)
    r0_emit("pe_ipc_handshake_record",
        "\"session_id\":116001,\"client_version\":1,\"server_version\":1,\"success\":1,\"target\":\"v1_v1_match\"")

    record_handshake(116002, 1, 2, 1)
    r0_emit("pe_ipc_handshake_record",
        "\"session_id\":116002,\"client_version\":1,\"server_version\":2,\"success\":1,\"target\":\"v1_v2_compat\"")

    record_handshake(116003, 2, 2, 1)
    r0_emit("pe_ipc_handshake_record",
        "\"session_id\":116003,\"client_version\":2,\"server_version\":2,\"success\":1,\"target\":\"v2_v2_match\"")

    record_handshake(116004, 1, 3, 0)
    r0_emit("pe_ipc_handshake_record",
        "\"session_id\":116004,\"client_version\":1,\"server_version\":3,\"success\":0,\"target\":\"v1_v3_incompat\"")

    // 3. handshake_count = 4
    let c = handshake_count()
    if c != 4 {
        panic("pe_ipc_handshake FAIL [handshake_count] expected=4 got=" + to_string(c))
    }

    // 4. success_count = 3
    let sc = success_count()
    if sc != 3 {
        panic("pe_ipc_handshake FAIL [success_count] expected=3 got=" + to_string(sc))
    }

    // 5. fail_count = 1
    let fc = fail_count()
    if fc != 1 {
        panic("pe_ipc_handshake FAIL [fail_count] expected=1 got=" + to_string(fc))
    }

    // 6. version_match_count = 2 (116001 v1=v1, 116003 v2=v2)
    let vm = version_match_count()
    if vm != 2 {
        panic("pe_ipc_handshake FAIL [version_match_count] expected=2 got=" + to_string(vm))
    }

    // 7. session_versions sanity
    let sv1 = session_versions(116001)
    if sv1 != 1 {
        panic("pe_ipc_handshake FAIL [session_versions(116001)] expected=1 got=" + to_string(sv1))
    }
    let sv3 = session_versions(116003)
    if sv3 != 2 {
        panic("pe_ipc_handshake FAIL [session_versions(116003)] expected=2 got=" + to_string(sv3))
    }
    let sv_miss = session_versions(9999)
    if sv_miss != 0 {
        panic("pe_ipc_handshake FAIL [session_versions(9999)] expected=0 got=" + to_string(sv_miss))
    }

    // 8. pih_stats() = [4, 3, 1, 2]
    let s = pih_stats()
    if len(s) != 4 {
        panic("pe_ipc_handshake FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 4 {
        panic("pe_ipc_handshake FAIL [stats handshake_count] expected=4 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_ipc_handshake FAIL [stats success_count] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_ipc_handshake FAIL [stats fail_count] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_ipc_handshake FAIL [stats version_match_count] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_ipc_handshake_stats",
        "\"handshake_count\":" + to_string(s[0])
        + ",\"success_count\":" + to_string(s[1])
        + ",\"fail_count\":" + to_string(s[2])
        + ",\"version_match_count\":" + to_string(s[3]))

    // 10. emit count >= 5 (4 records + 1 stats = 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("pe_ipc_handshake FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pih()
    let s2 = pih_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ipc_handshake FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ipc_handshake self_test PASS (handshakes=" + to_string(s[0])
        + ", success=" + to_string(s[1]) + ", fail=" + to_string(s[2])
        + ", v_match=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pih_stats()
            println("handshake_count\t" + to_string(s[0]))
            println("success_count\t" + to_string(s[1]))
            println("fail_count\t" + to_string(s[2]))
            println("version_match_count\t" + to_string(s[3]))
            return
        }
        if sub == "version" {
            if len(a) >= 4 {
                let sess = to_int(a[3])
                println("session_versions\t" + to_string(session_versions(sess)))
                return
            }
            println("usage: hexa run pe_ipc_handshake.hexa version <session_id>")
            return
        }
        if sub == "cleanup" {
            cleanup_pih()
            println("cleaned: " + pih_dir())
            return
        }
        if sub == "dir" {
            println(pih_dir())
            return
        }
    }
    println("usage: hexa run pe_ipc_handshake.hexa { self-test | stats | version <session_id> | cleanup | dir }")
}
