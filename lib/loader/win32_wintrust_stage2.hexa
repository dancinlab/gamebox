// lib/loader/win32_wintrust_stage2.hexa — Battle.net Setup WINTRUST imports coverage
//
// Battle.net 의 Authenticode signature verification 함수 — WinVerifyTrust,
// CryptCATAdminAcquireContext 등. stage1 base 위에 Battle.net 특이 imports 추가.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 WINTRUST / Authenticode API spec:
//     - WinVerifyTrust:
//         https://learn.microsoft.com/en-us/windows/win32/api/wintrust/nf-wintrust-winverifytrust
//     - CryptCATAdminAcquireContext / ReleaseContext:
//         https://learn.microsoft.com/en-us/windows/win32/api/mscat/nf-mscat-cryptcatadminacquirecontext
//     - CryptCATAdminCalcHashFromFileHandle:
//         https://learn.microsoft.com/en-us/windows/win32/api/mscat/
//     - CryptCATCatalogInfoFromContext:
//         https://learn.microsoft.com/en-us/windows/win32/api/mscat/
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 1 — wintrust_s2_self_test)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - awk only (no shasum/git/openssl); reserved keyword `type` 회피
//   - panic format: "win32_wintrust_stage2 FAIL [<sub>] expected=X got=Y"
//
// 범위 (Phase 4g stage2 — Battle.net Authenticode 추가 imports):
//   stage1 = WinVerifyTrust 단일 stub (codesign skeleton).
//   stage2 = installer 가 dynamic resolution (LoadLibrary/GetProcAddress) 으로
//            추가 호출하는 CryptCAT * family + WinVerifyTrustEx 를 stub.
//   own 1 정합 — 자체 codesign 의존 X. stub return 값으로만 Authenticode 통과.
//
// stub return 정책 (Win32 retval):
//   LONG / HRESULT  → 0 (ERROR_SUCCESS / S_OK)        ← signature valid 가정
//   BOOL            → 1 (TRUE)                        ← API success
//   HANDLE          → 1 (synthetic non-NULL handle)   ← acquire success

use "../perf/r0_common"

// ─── Battle.net 특이 WINTRUST imports 매핑 (TSV: name\tstub\tcategory\treturn_kind) ───
fn wintrust_s2_table() -> str {
    let t = ""
    // WinVerifyTrust 는 stage1 에 있으나 stage2 에서도 재선언 (ABI 일치).
    t = t + "WinVerifyTrust\twin_verify_trust_s2_stub\tCodeSigning\tLONG\n"
    t = t + "WinVerifyTrustEx\twin_verify_trust_ex_s2_stub\tCodeSigning\tHRESULT\n"
    t = t + "CryptCATAdminAcquireContext\tcryptcat_admin_acquire_context_s2_stub\tCatalog\tBOOL\n"
    t = t + "CryptCATAdminReleaseContext\tcryptcat_admin_release_context_s2_stub\tCatalog\tBOOL\n"
    t = t + "CryptCATAdminCalcHashFromFileHandle\tcryptcat_admin_calc_hash_s2_stub\tCatalog\tBOOL\n"
    t = t + "CryptCATAdminEnumCatalogFromHash\tcryptcat_admin_enum_catalog_s2_stub\tCatalog\tHANDLE\n"
    t = t + "CryptCATCatalogInfoFromContext\tcryptcat_catalog_info_s2_stub\tCatalog\tBOOL\n"
    return t
}

fn wintrust_s2_table_size() -> int {
    let lines = wintrust_s2_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn wintrust_s2_lookup(name: str) -> str {
    let lines = wintrust_s2_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

// ─── stub: WinVerifyTrust (LONG) → 0 = ERROR_SUCCESS ───
fn win_verify_trust_s2_stub(file_path: str) -> int {
    let _ = file_path
    return 0
}

// ─── stub: WinVerifyTrustEx (HRESULT) → 0 = S_OK ───
fn win_verify_trust_ex_s2_stub(file_path: str) -> int {
    let _ = file_path
    return 0
}

// ─── stub: CryptCATAdminAcquireContext (BOOL) → 1 = TRUE ───
//   원래 out param 으로 HCATADMIN handle 반환. simulation 에선 BOOL 만 sim.
fn cryptcat_admin_acquire_context_s2_stub(subsystem: str) -> int {
    let _ = subsystem
    return 1
}

// ─── stub: CryptCATAdminReleaseContext (BOOL) → 1 ───
fn cryptcat_admin_release_context_s2_stub(hnd: int) -> int {
    let _ = hnd
    return 1
}

// ─── stub: CryptCATAdminCalcHashFromFileHandle (BOOL) → 1 ───
fn cryptcat_admin_calc_hash_s2_stub(file_handle: int) -> int {
    let _ = file_handle
    return 1
}

// ─── stub: CryptCATAdminEnumCatalogFromHash (HANDLE) → 1 = synthetic non-NULL ───
fn cryptcat_admin_enum_catalog_s2_stub(admin: int, hash: str) -> int {
    let _ = admin
    let _ = hash
    return 1
}

// ─── stub: CryptCATCatalogInfoFromContext (BOOL) → 1 ───
fn cryptcat_catalog_info_s2_stub(catalog_ctx: int) -> int {
    let _ = catalog_ctx
    return 1
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wintrusts2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table size = 7
    let sz = wintrust_s2_table_size()
    if sz != 7 {
        panic("win32_wintrust_stage2 FAIL [size] expected=7 got=" + to_string(sz))
    }

    // 2. lookup sanity — 각 name → "stub\tcategory\treturn_kind" 비어있지 않음
    let m1 = wintrust_s2_lookup("WinVerifyTrust")
    if !m1.contains("CodeSigning") {
        panic("win32_wintrust_stage2 FAIL [lookup WinVerifyTrust] expected=CodeSigning got=" + m1)
    }
    let m2 = wintrust_s2_lookup("CryptCATAdminAcquireContext")
    if !m2.contains("Catalog") {
        panic("win32_wintrust_stage2 FAIL [lookup CryptCATAdminAcquireContext] expected=Catalog got=" + m2)
    }
    let m_unk = wintrust_s2_lookup("DoesNotExist")
    if m_unk != "" {
        panic("win32_wintrust_stage2 FAIL [lookup unknown] expected=empty got=" + m_unk)
    }

    // 3. 모든 stub 호출 — return 값 검증
    let mut sc = 0

    let r1 = win_verify_trust_s2_stub("/tmp/Battle.net-Setup.exe")
    if r1 != 0 {
        panic("win32_wintrust_stage2 FAIL [WinVerifyTrust ret] expected=0 got=" + to_string(r1))
    }
    sc = sc + 1

    let r2 = win_verify_trust_ex_s2_stub("/tmp/Battle.net-Setup.exe")
    if r2 != 0 {
        panic("win32_wintrust_stage2 FAIL [WinVerifyTrustEx ret] expected=0 got=" + to_string(r2))
    }
    sc = sc + 1

    let r3 = cryptcat_admin_acquire_context_s2_stub("DriverVerify")
    if r3 != 1 {
        panic("win32_wintrust_stage2 FAIL [CryptCATAdminAcquireContext ret] expected=1 got=" + to_string(r3))
    }
    sc = sc + 1

    let r4 = cryptcat_admin_release_context_s2_stub(1)
    if r4 != 1 {
        panic("win32_wintrust_stage2 FAIL [CryptCATAdminReleaseContext ret] expected=1 got=" + to_string(r4))
    }
    sc = sc + 1

    let r5 = cryptcat_admin_calc_hash_s2_stub(42)
    if r5 != 1 {
        panic("win32_wintrust_stage2 FAIL [CryptCATAdminCalcHashFromFileHandle ret] expected=1 got=" + to_string(r5))
    }
    sc = sc + 1

    let r6 = cryptcat_admin_enum_catalog_s2_stub(1, "deadbeef")
    if r6 != 1 {
        panic("win32_wintrust_stage2 FAIL [CryptCATAdminEnumCatalogFromHash ret] expected=1 got=" + to_string(r6))
    }
    sc = sc + 1

    let r7 = cryptcat_catalog_info_s2_stub(1)
    if r7 != 1 {
        panic("win32_wintrust_stage2 FAIL [CryptCATCatalogInfoFromContext ret] expected=1 got=" + to_string(r7))
    }
    sc = sc + 1

    if sc != 7 {
        panic("win32_wintrust_stage2 FAIL [stub_count] expected=7 got=" + to_string(sc))
    }

    // 4. r0_emit (≥ 1)
    r0_emit("wintrust_s2_self_test",
        "\"stubbed\":" + to_string(sc)
        + ",\"WinVerifyTrust\":" + to_string(r1)
        + ",\"CryptCATAdminAcquire\":" + to_string(r3)
        + ",\"category_count\":2")

    let cnt = r0_session_count(sid)
    if cnt < 1 {
        panic("win32_wintrust_stage2 FAIL [emit count] expected=>=1 got=" + to_string(cnt))
    }

    // 5. PASS
    println("  ✅ win32_wintrust_stage2 self_test PASS (" + to_string(sc) + " stubbed, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            let lines = wintrust_s2_table().split("\n")
            let i = 0
            while i < len(lines) {
                if lines[i] != "" {
                    let parts = lines[i].split("\t")
                    if len(parts) >= 4 {
                        println(parts[0] + "\t" + parts[2] + "\t" + parts[3])
                    }
                }
                i = i + 1
            }
            return
        }
    }
    println("usage: hexa run win32_wintrust_stage2.hexa { self-test | list }")
}
