// lib/loader/pe_iat_dlsym_routing_real.hexa — cycle 81 phase 10
// IAT Win32 → POSIX/Foundation symbol routing tracker
//
// phase 10 — Win32 import name 마다 helper IPC kind=5 dlsym(handle, posix_name) 호출.
//   매핑 예: kernel32!GetCurrentThreadId → libSystem pthread_mach_thread_np
//            kernel32!GetTickCount        → libSystem mach_absolute_time
//            user32!CreateWindowEx        → AppKit NSWindow alloc/initWith
// own1: 자체 mapping table — Wine / CrossOver / community 코드 0 줄.
//
// 본 module 은 routing tracker — 실제 dlsym 호출 / IAT patch X (helper IPC kind=5 외).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// win32_dll_kind code:
//   1 = kernel32
//   2 = user32
//   3 = advapi32
//   4 = gdi32
//   5 = ole32
//
// posix_target_kind code:
//   1 = libSystem
//   2 = Foundation
//   3 = AppKit
//   4 = CoreGraphics
//   5 = Metal
//   6 = stub_constant
//
// persist schema (TSV — routes.tsv):
//   route_id<int> \t win32_dll_kind<int> \t posix_target_kind<int> \t patched<int>
//
// prefix `pidr_real_` — pidr 는 cycle 81 에 사용 중

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pidr_real_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_iat_dlsym_routing_real"
}

fn pidr_real_routes_path() -> str {
    return pidr_real_dir() + "/routes.tsv"
}

fn pidr_real_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pidr_real_dir() + "'")
}

fn cleanup_pidr_real() -> void {
    pidr_real_ensure_dir()
    let _ = exec("rm -f '" + pidr_real_routes_path() + "'")
}

// ─── 공통 file IO ───
fn pidr_real_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pidr_real_append_row(path: str, row: str) -> void {
    pidr_real_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_route: Win32 → POSIX routing 1 건 기록 ───
fn record_route(route_id: int, win32_dll_kind: int, posix_target_kind: int, patched: int) -> void {
    if route_id <= 0 {
        panic("pe_iat_dlsym_routing_real FAIL [record_route] expected=route_id>0 got=" + to_string(route_id))
    }
    if win32_dll_kind < 1 {
        panic("pe_iat_dlsym_routing_real FAIL [record_route] expected=win32_dll_kind>=1 got=" + to_string(win32_dll_kind))
    }
    if win32_dll_kind > 5 {
        panic("pe_iat_dlsym_routing_real FAIL [record_route] expected=win32_dll_kind<=5 got=" + to_string(win32_dll_kind))
    }
    if posix_target_kind < 1 {
        panic("pe_iat_dlsym_routing_real FAIL [record_route] expected=posix_target_kind>=1 got=" + to_string(posix_target_kind))
    }
    if posix_target_kind > 6 {
        panic("pe_iat_dlsym_routing_real FAIL [record_route] expected=posix_target_kind<=6 got=" + to_string(posix_target_kind))
    }
    if patched < 0 {
        panic("pe_iat_dlsym_routing_real FAIL [record_route] expected=patched>=0 got=" + to_string(patched))
    }
    if patched > 1 {
        panic("pe_iat_dlsym_routing_real FAIL [record_route] expected=patched<=1 got=" + to_string(patched))
    }
    let row = to_string(route_id) + "\t" + to_string(win32_dll_kind)
        + "\t" + to_string(posix_target_kind) + "\t" + to_string(patched) + "\n"
    pidr_real_append_row(pidr_real_routes_path(), row)
}

// ─── route_count: total route 수 ───
fn route_count() -> int {
    let t = pidr_real_read_table(pidr_real_routes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_win32_dll_kind: 특정 win32 dll_kind 의 route 수 ───
fn count_by_win32_dll_kind(kind: int) -> int {
    let t = pidr_real_read_table(pidr_real_routes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_posix_target_kind: 특정 posix target_kind 의 route 수 ───
fn count_by_posix_target_kind(kind: int) -> int {
    let t = pidr_real_read_table(pidr_real_routes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── patched_count: patched=1 인 route 수 ───
fn patched_count() -> int {
    let t = pidr_real_read_table(pidr_real_routes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── kernel32_count: count_by_win32_dll_kind(1) alias ───
fn kernel32_count() -> int {
    return count_by_win32_dll_kind(1)
}

// ─── route_patched: 특정 route_id 의 patched flag (없으면 -1) ───
fn route_patched(route_id: int) -> int {
    let t = pidr_real_read_table(pidr_real_routes_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == route_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pidr_real_stats: [route_count, patched_count, kernel32_count, count_by_posix_target_kind(1)] ───
fn pidr_real_stats() -> array {
    let mut out = []
    out.push(route_count())
    out.push(patched_count())
    out.push(kernel32_count())
    out.push(count_by_posix_target_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pidr-real-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pidr_real()

    // 2. record 6 routes covering 4 win32_dll_kinds and 4 posix_target_kinds
    //    win32: kernel32 x2, user32 x2, advapi32 x1, gdi32 x1
    //    posix: libSystem x2, Foundation x1, AppKit x1, CoreGraphics x1, stub_constant x1
    //    patched: 4 success, 2 fallback
    record_route(130001, 1, 1, 1) // kernel32!GetCurrentThreadId → libSystem pthread_mach_thread_np
    r0_emit("pe_iat_dlsym_routing_real_record",
        "\"route_id\":130001,\"win32_dll_kind\":1,\"posix_target_kind\":1,\"map\":\"GetCurrentThreadId->pthread_mach_thread_np\",\"patched\":1")

    record_route(130002, 1, 1, 1) // kernel32!GetTickCount → libSystem mach_absolute_time
    r0_emit("pe_iat_dlsym_routing_real_record",
        "\"route_id\":130002,\"win32_dll_kind\":1,\"posix_target_kind\":1,\"map\":\"GetTickCount->mach_absolute_time\",\"patched\":1")

    record_route(130003, 2, 3, 1) // user32!CreateWindowEx → AppKit NSWindow alloc/initWith
    r0_emit("pe_iat_dlsym_routing_real_record",
        "\"route_id\":130003,\"win32_dll_kind\":2,\"posix_target_kind\":3,\"map\":\"CreateWindowEx->NSWindow.alloc.initWith\",\"patched\":1")

    record_route(130004, 2, 6, 0) // user32!SetWindowTextW → stub_constant (fallback)
    r0_emit("pe_iat_dlsym_routing_real_record",
        "\"route_id\":130004,\"win32_dll_kind\":2,\"posix_target_kind\":6,\"map\":\"SetWindowTextW->stub_constant\",\"patched\":0")

    record_route(130005, 3, 2, 1) // advapi32!RegOpenKeyExW → Foundation NSUserDefaults
    r0_emit("pe_iat_dlsym_routing_real_record",
        "\"route_id\":130005,\"win32_dll_kind\":3,\"posix_target_kind\":2,\"map\":\"RegOpenKeyExW->NSUserDefaults\",\"patched\":1")

    record_route(130006, 4, 4, 0) // gdi32!CreateCompatibleDC → CoreGraphics CGContext (fallback)
    r0_emit("pe_iat_dlsym_routing_real_record",
        "\"route_id\":130006,\"win32_dll_kind\":4,\"posix_target_kind\":4,\"map\":\"CreateCompatibleDC->CGContext\",\"patched\":0")

    // 3. route_count = 6
    let c = route_count()
    if c != 6 {
        panic("pe_iat_dlsym_routing_real FAIL [route_count] expected=6 got=" + to_string(c))
    }

    // 4. patched_count = 4
    let pc = patched_count()
    if pc != 4 {
        panic("pe_iat_dlsym_routing_real FAIL [patched_count] expected=4 got=" + to_string(pc))
    }

    // 5. count_by_win32_dll_kind sanity (≥3 kinds covered)
    let w1 = count_by_win32_dll_kind(1)
    if w1 != 2 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_win32_dll_kind(1)] expected=2 got=" + to_string(w1))
    }
    let w2 = count_by_win32_dll_kind(2)
    if w2 != 2 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_win32_dll_kind(2)] expected=2 got=" + to_string(w2))
    }
    let w3 = count_by_win32_dll_kind(3)
    if w3 != 1 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_win32_dll_kind(3)] expected=1 got=" + to_string(w3))
    }
    let w4 = count_by_win32_dll_kind(4)
    if w4 != 1 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_win32_dll_kind(4)] expected=1 got=" + to_string(w4))
    }
    let w5 = count_by_win32_dll_kind(5)
    if w5 != 0 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_win32_dll_kind(5)] expected=0 got=" + to_string(w5))
    }

    // 6. count_by_posix_target_kind sanity (≥3 kinds covered)
    let p1 = count_by_posix_target_kind(1)
    if p1 != 2 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_posix_target_kind(1)] expected=2 got=" + to_string(p1))
    }
    let p2 = count_by_posix_target_kind(2)
    if p2 != 1 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_posix_target_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_posix_target_kind(3)
    if p3 != 1 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_posix_target_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_posix_target_kind(4)
    if p4 != 1 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_posix_target_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_posix_target_kind(5)
    if p5 != 0 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_posix_target_kind(5)] expected=0 got=" + to_string(p5))
    }
    let p6 = count_by_posix_target_kind(6)
    if p6 != 1 {
        panic("pe_iat_dlsym_routing_real FAIL [count_by_posix_target_kind(6)] expected=1 got=" + to_string(p6))
    }

    // 7. kernel32_count alias
    let kc = kernel32_count()
    if kc != 2 {
        panic("pe_iat_dlsym_routing_real FAIL [kernel32_count] expected=2 got=" + to_string(kc))
    }

    // 8. route_patched lookup
    let rp1 = route_patched(130001)
    if rp1 != 1 {
        panic("pe_iat_dlsym_routing_real FAIL [route_patched(130001)] expected=1 got=" + to_string(rp1))
    }
    let rp4 = route_patched(130004)
    if rp4 != 0 {
        panic("pe_iat_dlsym_routing_real FAIL [route_patched(130004)] expected=0 got=" + to_string(rp4))
    }
    let rpx = route_patched(999999)
    if rpx != -1 {
        panic("pe_iat_dlsym_routing_real FAIL [route_patched(missing)] expected=-1 got=" + to_string(rpx))
    }

    // 9. pidr_real_stats() = [6, 4, 2, 2]
    let s = pidr_real_stats()
    if len(s) != 4 {
        panic("pe_iat_dlsym_routing_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_iat_dlsym_routing_real FAIL [stats route_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_iat_dlsym_routing_real FAIL [stats patched_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_iat_dlsym_routing_real FAIL [stats kernel32_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_iat_dlsym_routing_real FAIL [stats libSystem_count] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_iat_dlsym_routing_real_stats",
        "\"route_count\":" + to_string(s[0])
        + ",\"patched_count\":" + to_string(s[1])
        + ",\"kernel32_count\":" + to_string(s[2])
        + ",\"libSystem_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_iat_dlsym_routing_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pidr_real()
    let s2 = pidr_real_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_iat_dlsym_routing_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_iat_dlsym_routing_real self_test PASS (routes=" + to_string(s[0])
        + ", patched=" + to_string(s[1]) + ", kernel32=" + to_string(s[2])
        + ", libSystem=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pidr_real_stats()
            println("route_count\t" + to_string(s[0]))
            println("patched_count\t" + to_string(s[1]))
            println("kernel32_count\t" + to_string(s[2]))
            println("libSystem_count\t" + to_string(s[3]))
            return
        }
        if sub == "count-win32" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_win32_dll_kind\t" + to_string(count_by_win32_dll_kind(kind)))
                return
            }
            println("usage: hexa run pe_iat_dlsym_routing_real.hexa count-win32 <win32_dll_kind>")
            return
        }
        if sub == "count-posix" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_posix_target_kind\t" + to_string(count_by_posix_target_kind(kind)))
                return
            }
            println("usage: hexa run pe_iat_dlsym_routing_real.hexa count-posix <posix_target_kind>")
            return
        }
        if sub == "patched" {
            if len(a) >= 4 {
                let rid = to_int(a[3])
                println("route_patched\t" + to_string(route_patched(rid)))
                return
            }
            println("usage: hexa run pe_iat_dlsym_routing_real.hexa patched <route_id>")
            return
        }
        if sub == "cleanup" {
            cleanup_pidr_real()
            println("cleaned: " + pidr_real_dir())
            return
        }
        if sub == "dir" {
            println(pidr_real_dir())
            return
        }
    }
    println("usage: hexa run pe_iat_dlsym_routing_real.hexa { self-test | stats | count-win32 <kind> | count-posix <kind> | patched <route_id> | cleanup | dir }")
}
