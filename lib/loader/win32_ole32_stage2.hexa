// lib/loader/win32_ole32_stage2.hexa — Battle.net Setup ole32 imports coverage
//
// Battle.net 의 COM (Component Object Model) 함수 — CoInitialize, CoCreateInstance,
// CoUninitialize, CoTaskMemAlloc 등. stage1 base 위에 Battle.net 특이 imports 추가.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 Win32 COM API spec:
//     - CoInitialize / CoInitializeEx / CoUninitialize:
//         https://learn.microsoft.com/en-us/windows/win32/api/objbase/
//         https://learn.microsoft.com/en-us/windows/win32/api/combaseapi/
//     - CoTaskMemAlloc / CoTaskMemRealloc:
//         https://learn.microsoft.com/en-us/windows/win32/api/combaseapi/nf-combaseapi-cotaskmemalloc
//     - CoCreateGuid / CLSIDFromString / StringFromGUID2:
//         https://learn.microsoft.com/en-us/windows/win32/api/combaseapi/
//     - OleInitialize / OleUninitialize:
//         https://learn.microsoft.com/en-us/windows/win32/api/ole2/
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제: ole32s2_self_test)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("win32_ole32_stage2 FAIL [<sub>] expected=X got=Y")
//
// 실측 Battle.net-Setup.exe ole32 imports (DLL index 10):
//   CoTaskMemFree     ← stage1 covered
//   CoCreateInstance  ← stage1 covered
//
// 위 두 함수는 stage1 (win32_ole32.hexa) 에 이미 매핑됨. stage2 는 COM runtime
// 호출 그래프 확장 — installer 가 CoCreateInstance 진입 직전 CoInitialize(Ex),
// CoCreateInstance 결과 free 시 CoTaskMemFree 외에도 CoTaskMemAlloc/Realloc,
// 그리고 GUID conversion / Ole shell hook 등 호출. stage2 = stage1 missing 보강.
//
// Stub semantics (Phase 1 skeleton — installer dialog flow 통과만 목표):
//   HRESULT 반환  → 0 (S_OK)
//   LPVOID 반환   → 0 (NULL pointer placeholder)
//   BOOL 반환     → 1 (TRUE)
//   void 반환     → no return
//
// 향후 Phase 2 에서는 GUID table 등록 + CoCreateInstance 결과 vtable wiring 으로
// upgrade 예정. 현재 stage2 는 stage1 보완 + 호출 추적 (r0_emit) 만.

use "../perf/r0_common"

// ─── stage2 stub registry ───
//   format: "name\trettype\n"
//   rettype ∈ { hresult, lpvoid, bool, void }
fn ole32_stage2_table() -> str {
    let t = ""
    t = t + "CoInitialize\thresult\n"
    t = t + "CoInitializeEx\thresult\n"
    t = t + "CoUninitialize\tvoid\n"
    t = t + "CoTaskMemAlloc\tlpvoid\n"
    t = t + "CoTaskMemRealloc\tlpvoid\n"
    t = t + "CoCreateGuid\thresult\n"
    t = t + "CoGetClassObject\thresult\n"
    t = t + "CLSIDFromString\thresult\n"
    t = t + "CLSIDFromProgID\thresult\n"
    t = t + "StringFromGUID2\thresult\n"
    t = t + "StringFromCLSID\thresult\n"
    t = t + "OleInitialize\thresult\n"
    t = t + "OleUninitialize\tvoid\n"
    return t
}

fn ole32_stage2_table_size() -> int {
    let lines = ole32_stage2_table().split("\n")
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_stub(name: str) -> str {
    let lines = ole32_stage2_table().split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 2 && parts[0] == name {
                return parts[1]
            }
        }
        i = i + 1
    }
    return ""
}

// ─── stub bodies ───
//   각 stub 은 spec 의 rettype 에 따른 default 값 반환.
//   인자는 모두 무시 (skeleton — Phase 2 에서 의미 부여 예정).

// HRESULT CoInitialize(LPVOID pvReserved) — S_OK
fn co_initialize(reserved: int) -> int {
    let _ = reserved
    return 0
}

// HRESULT CoInitializeEx(LPVOID pvReserved, DWORD dwCoInit) — S_OK
fn co_initialize_ex(reserved: int, dw_co_init: int) -> int {
    let _ = reserved
    let _ = dw_co_init
    return 0
}

// void CoUninitialize(void)
fn co_uninitialize() -> void {
    return
}

// LPVOID CoTaskMemAlloc(SIZE_T cb) — NULL placeholder
fn co_task_mem_alloc(cb: int) -> int {
    let _ = cb
    return 0
}

// LPVOID CoTaskMemRealloc(LPVOID pv, SIZE_T cb) — NULL placeholder
fn co_task_mem_realloc(pv: int, cb: int) -> int {
    let _ = pv
    let _ = cb
    return 0
}

// HRESULT CoCreateGuid(GUID* pguid) — S_OK
fn co_create_guid(pguid: int) -> int {
    let _ = pguid
    return 0
}

// HRESULT CoGetClassObject(REFCLSID rclsid, DWORD dwClsContext, LPVOID pvReserved, REFIID riid, LPVOID* ppv) — S_OK
fn co_get_class_object(rclsid: int, dw_cls_context: int, reserved: int, riid: int, ppv: int) -> int {
    let _ = rclsid
    let _ = dw_cls_context
    let _ = reserved
    let _ = riid
    let _ = ppv
    return 0
}

// HRESULT CLSIDFromString(LPCOLESTR lpsz, LPCLSID pclsid) — S_OK
fn clsid_from_string(lpsz: int, pclsid: int) -> int {
    let _ = lpsz
    let _ = pclsid
    return 0
}

// HRESULT CLSIDFromProgID(LPCOLESTR lpszProgID, LPCLSID lpclsid) — S_OK
fn clsid_from_prog_id(lpsz_prog_id: int, lpclsid: int) -> int {
    let _ = lpsz_prog_id
    let _ = lpclsid
    return 0
}

// int StringFromGUID2(REFGUID rguid, LPOLESTR lpsz, int cchMax) — HRESULT-like (S_OK 0)
fn string_from_guid2(rguid: int, lpsz: int, cch_max: int) -> int {
    let _ = rguid
    let _ = lpsz
    let _ = cch_max
    return 0
}

// HRESULT StringFromCLSID(REFCLSID rclsid, LPOLESTR* lplpsz) — S_OK
fn string_from_clsid(rclsid: int, lplpsz: int) -> int {
    let _ = rclsid
    let _ = lplpsz
    return 0
}

// HRESULT OleInitialize(LPVOID pvReserved) — S_OK
fn ole_initialize(reserved: int) -> int {
    let _ = reserved
    return 0
}

// void OleUninitialize(void)
fn ole_uninitialize() -> void {
    return
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ole32s2-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = ole32_stage2_table_size()
    if sz < 13 {
        panic("win32_ole32_stage2 FAIL [size] expected=>=13 got=" + to_string(sz))
    }

    // lookup sanity
    let l1 = lookup_stub("CoInitialize")
    if l1 != "hresult" {
        panic("win32_ole32_stage2 FAIL [lookup CoInitialize] expected=hresult got=" + l1)
    }
    let l2 = lookup_stub("CoTaskMemAlloc")
    if l2 != "lpvoid" {
        panic("win32_ole32_stage2 FAIL [lookup CoTaskMemAlloc] expected=lpvoid got=" + l2)
    }
    let l3 = lookup_stub("CoUninitialize")
    if l3 != "void" {
        panic("win32_ole32_stage2 FAIL [lookup CoUninitialize] expected=void got=" + l3)
    }
    let l4 = lookup_stub("Unknown")
    if l4 != "" {
        panic("win32_ole32_stage2 FAIL [lookup unknown] expected=empty got=" + l4)
    }

    // call each stub — verify default returns
    let r1 = co_initialize(0)
    if r1 != 0 {
        panic("win32_ole32_stage2 FAIL [CoInitialize] expected=0 got=" + to_string(r1))
    }

    let r2 = co_initialize_ex(0, 2)
    if r2 != 0 {
        panic("win32_ole32_stage2 FAIL [CoInitializeEx] expected=0 got=" + to_string(r2))
    }

    co_uninitialize()  // void

    let r3 = co_task_mem_alloc(64)
    if r3 != 0 {
        panic("win32_ole32_stage2 FAIL [CoTaskMemAlloc] expected=0 got=" + to_string(r3))
    }

    let r4 = co_task_mem_realloc(0, 128)
    if r4 != 0 {
        panic("win32_ole32_stage2 FAIL [CoTaskMemRealloc] expected=0 got=" + to_string(r4))
    }

    let r5 = co_create_guid(0)
    if r5 != 0 {
        panic("win32_ole32_stage2 FAIL [CoCreateGuid] expected=0 got=" + to_string(r5))
    }

    let r6 = co_get_class_object(0, 1, 0, 0, 0)
    if r6 != 0 {
        panic("win32_ole32_stage2 FAIL [CoGetClassObject] expected=0 got=" + to_string(r6))
    }

    let r7 = clsid_from_string(0, 0)
    if r7 != 0 {
        panic("win32_ole32_stage2 FAIL [CLSIDFromString] expected=0 got=" + to_string(r7))
    }

    let r8 = clsid_from_prog_id(0, 0)
    if r8 != 0 {
        panic("win32_ole32_stage2 FAIL [CLSIDFromProgID] expected=0 got=" + to_string(r8))
    }

    let r9 = string_from_guid2(0, 0, 39)
    if r9 != 0 {
        panic("win32_ole32_stage2 FAIL [StringFromGUID2] expected=0 got=" + to_string(r9))
    }

    let r10 = string_from_clsid(0, 0)
    if r10 != 0 {
        panic("win32_ole32_stage2 FAIL [StringFromCLSID] expected=0 got=" + to_string(r10))
    }

    let r11 = ole_initialize(0)
    if r11 != 0 {
        panic("win32_ole32_stage2 FAIL [OleInitialize] expected=0 got=" + to_string(r11))
    }

    ole_uninitialize()  // void

    r0_emit("ole32s2_self_test",
        "\"stubbed\":" + to_string(sz)
        + ",\"sid\":\"" + sid + "\"")

    let emit_n = r0_session_count(sid)
    if emit_n < 1 {
        panic("win32_ole32_stage2 FAIL [r0 emit count] expected=>=1 got=" + to_string(emit_n))
    }

    println("  ✅ win32_ole32_stage2 self_test PASS (" + to_string(sz) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            println(ole32_stage2_table())
            return
        }
    }
    println("usage: hexa run win32_ole32_stage2.hexa { self-test | list }")
}
