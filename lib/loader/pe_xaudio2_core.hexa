// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pxa_count_rows(pxa_syscall_invoke_path(), 4)
}

fn engine_event_count() -> int {
    return pxa_count_rows(pxa_engine_event_path(), 5)
}

fn voice_event_count() -> int {
    return pxa_count_rows(pxa_voice_event_path(), 5)
}

fn effects_event_count() -> int {
    return pxa_count_rows(pxa_effects_event_path(), 5)
}

fn pxa_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(engine_event_count())
    out.push(voice_event_count())
    out.push(effects_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pxa-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pxa()

    // ─── 1. syscall_invoke × 10 (one per fn, 3 group coverage) ───
    //   ENGINE group (3)
    record_syscall_invoke(1, 0, "XAudio2Create", "PARTIAL")
    println("__XAUDIO2__ PARTIAL XAudio2Create")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"XAudio2Create\",\"fn_group\":\"engine\",\"status\":\"PARTIAL\",\"flags\":\"0x00000000\",\"processor\":\"XAUDIO2_DEFAULT_PROCESSOR_0xFFFFFFFF\",\"iid_synth\":\"IID_IXAudio2_8BCF1F58\",\"iid_synth_bytes\":16,\"engine_out_hex\":\"0x95000000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(2, 1, "IXAudio2_CreateMasteringVoice", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2_CreateMasteringVoice")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"IXAudio2_CreateMasteringVoice\",\"fn_group\":\"engine\",\"status\":\"PARTIAL\",\"engine_hex\":\"0x95000000\",\"InputChannels\":2,\"InputSampleRate\":44100,\"Flags\":\"0x00000000\",\"DeviceIndex\":0,\"mastering_voice_out_hex\":\"0x95010000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(3, 2, "IXAudio2_CreateSourceVoice", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2_CreateSourceVoice")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"IXAudio2_CreateSourceVoice\",\"fn_group\":\"engine\",\"status\":\"PARTIAL\",\"engine_hex\":\"0x95000000\",\"pSourceFormat\":\"WAVEFORMATEX_18B_PCM_44100_2ch_16bit\",\"Flags\":\"0x00000000\",\"MaxFrequencyRatio\":\"2.0_synth\",\"source_voice_out_hex\":\"0x95020000\",\"hresult\":\"0x00000000\"")

    //   VOICE group (4)
    record_syscall_invoke(4, 3, "IXAudio2SourceVoice_SubmitSourceBuffer", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2SourceVoice_SubmitSourceBuffer")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"IXAudio2SourceVoice_SubmitSourceBuffer\",\"fn_group\":\"voice\",\"status\":\"PARTIAL\",\"source_voice_hex\":\"0x95020000\",\"pBuffer_synth\":\"XAUDIO2_BUFFER_44B\",\"struct_bytes\":44,\"AudioBytes\":65536,\"pAudioData_hex\":\"0x95010100\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(5, 4, "IXAudio2SourceVoice_Start", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2SourceVoice_Start")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"IXAudio2SourceVoice_Start\",\"fn_group\":\"voice\",\"status\":\"PARTIAL\",\"source_voice_hex\":\"0x95020000\",\"Flags\":\"0x00000000\",\"OperationSet\":\"XAUDIO2_COMMIT_NOW_0\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(6, 5, "IXAudio2SourceVoice_Stop", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2SourceVoice_Stop")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"IXAudio2SourceVoice_Stop\",\"fn_group\":\"voice\",\"status\":\"PARTIAL\",\"source_voice_hex\":\"0x95020000\",\"Flags\":\"XAUDIO2_PLAY_TAILS_0x0020\",\"OperationSet\":\"XAUDIO2_COMMIT_NOW_0\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(7, 6, "IXAudio2SourceVoice_SetVolume", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2SourceVoice_SetVolume")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"IXAudio2SourceVoice_SetVolume\",\"fn_group\":\"voice\",\"status\":\"PARTIAL\",\"source_voice_hex\":\"0x95020000\",\"Volume_synth\":\"0.75_float_3F400000\",\"OperationSet\":\"XAUDIO2_COMMIT_NOW_0\",\"hresult\":\"0x00000000\"")

    //   EFFECTS group (3)
    record_syscall_invoke(8, 7, "IXAudio2SourceVoice_SetEffectChain", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2SourceVoice_SetEffectChain")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"IXAudio2SourceVoice_SetEffectChain\",\"fn_group\":\"effects\",\"status\":\"PARTIAL\",\"source_voice_hex\":\"0x95020000\",\"pEffectChain_synth\":\"XAUDIO2_EFFECT_CHAIN_count_2_reverb_eq\",\"effect_count\":2,\"hresult\":\"0x00000000\"")
    record_syscall_invoke(9, 8, "IXAudio2SubmixVoice_SetEffectParameters", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2SubmixVoice_SetEffectParameters")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"IXAudio2SubmixVoice_SetEffectParameters\",\"fn_group\":\"effects\",\"status\":\"PARTIAL\",\"submix_voice_hex\":\"0x95030000\",\"EffectIndex\":0,\"pParameters_synth\":\"FXREVERB_PARAMETERS_8B\",\"ParametersByteSize\":8,\"OperationSet\":\"XAUDIO2_COMMIT_NOW_0\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(10, 9, "IXAudio2MasteringVoice_SetVolume", "PARTIAL")
    println("__XAUDIO2__ PARTIAL IXAudio2MasteringVoice_SetVolume")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"IXAudio2MasteringVoice_SetVolume\",\"fn_group\":\"effects\",\"status\":\"PARTIAL\",\"mastering_voice_hex\":\"0x95010000\",\"Volume_synth\":\"1.0_float_3F800000\",\"OperationSet\":\"XAUDIO2_COMMIT_NOW_0\",\"hresult\":\"0x00000000\"")

    // ─── 2. engine_event × 3 (XAudio2Create / mastering / source) ───
    record_engine_event(1, "engine_create_default", "IID_IXAudio2_8BCF1F58", "0x95000000", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"engine_event\",\"evt_id\":1,\"e_kind\":\"engine_create_default\",\"iid_synth\":\"IID_IXAudio2_8BCF1F58\",\"iid_synth_bytes\":16,\"flags\":\"0x00000000\",\"processor\":\"XAUDIO2_DEFAULT_PROCESSOR\",\"engine_hex\":\"0x95000000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_engine_event(2, "create_mastering_2ch_44100", "MasteringVoice_2ch_44100", "0x95010000", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"engine_event\",\"evt_id\":2,\"e_kind\":\"create_mastering_2ch_44100\",\"InputChannels\":2,\"InputSampleRate\":44100,\"mastering_voice_hex\":\"0x95010000\",\"voice_details_synth\":\"XAUDIO2_VOICE_DETAILS_16B\",\"struct_bytes\":16,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_engine_event(3, "create_source_pcm_44100", "SourceVoice_pcm_44100", "0x95020000", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"engine_event\",\"evt_id\":3,\"e_kind\":\"create_source_pcm_44100\",\"format_synth\":\"WAVEFORMATEX_18B_PCM_44100_2ch_16bit\",\"struct_bytes\":18,\"source_voice_hex\":\"0x95020000\",\"voice_details_synth\":\"XAUDIO2_VOICE_DETAILS_16B\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── 3. voice_event × 4 (submit/start/stop/set_volume) ───
    record_voice_event(1, "submit_buffer_64KB", "0x95020000", "XAUDIO2_BUFFER_44B_AudioBytes_65536", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"voice_event\",\"evt_id\":1,\"v_kind\":\"submit_buffer_64KB\",\"voice_hex\":\"0x95020000\",\"buffer_synth\":\"XAUDIO2_BUFFER_44B_AudioBytes_65536\",\"struct_bytes\":44,\"AudioBytes\":65536,\"pAudioData_hex\":\"0x95010100\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_voice_event(2, "start_play", "0x95020000", "Flags_0x0_OperationSet_0", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"voice_event\",\"evt_id\":2,\"v_kind\":\"start_play\",\"voice_hex\":\"0x95020000\",\"buffer_synth\":\"Flags_0x0_OperationSet_0\",\"flags\":\"0x00000000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_voice_event(3, "stop_play_tails", "0x95020000", "XAUDIO2_PLAY_TAILS_0x0020", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"voice_event\",\"evt_id\":3,\"v_kind\":\"stop_play_tails\",\"voice_hex\":\"0x95020000\",\"buffer_synth\":\"XAUDIO2_PLAY_TAILS_0x0020\",\"flags\":\"0x00000020\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_voice_event(4, "set_volume_0_75", "0x95020000", "Volume_0.75_float_3F400000", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"voice_event\",\"evt_id\":4,\"v_kind\":\"set_volume_0_75\",\"voice_hex\":\"0x95020000\",\"buffer_synth\":\"Volume_0.75_float_3F400000\",\"volume_float\":0.75,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── 4. effects_event × 3 (set_chain/set_params/master_volume) ───
    record_effects_event(1, "set_effect_chain_2effects", "0x95020000", "XAUDIO2_EFFECT_CHAIN_count_2_reverb_eq", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"effects_event\",\"evt_id\":1,\"ef_kind\":\"set_effect_chain_2effects\",\"voice_hex\":\"0x95020000\",\"effect_synth\":\"XAUDIO2_EFFECT_CHAIN_count_2_reverb_eq\",\"effect_count\":2,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_effects_event(2, "set_effect_parameters_reverb_8B", "0x95030000", "FXREVERB_PARAMETERS_8B", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"effects_event\",\"evt_id\":2,\"ef_kind\":\"set_effect_parameters_reverb_8B\",\"voice_hex\":\"0x95030000\",\"effect_synth\":\"FXREVERB_PARAMETERS_8B\",\"effect_index\":0,\"parameters_byte_size\":8,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_effects_event(3, "master_volume_1_0", "0x95010000", "Volume_1.0_float_3F800000", "PARTIAL")
    r0_emit("pe_xaudio2_core_record", "\"kind\":\"effects_event\",\"evt_id\":3,\"ef_kind\":\"master_volume_1_0\",\"voice_hex\":\"0x95010000\",\"effect_synth\":\"Volume_1.0_float_3F800000\",\"volume_float\":1.0,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_xaudio2_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let ee = engine_event_count()
    if ee != 3 {
        panic("pe_xaudio2_core FAIL [engine_event_count] expected=3 got=" + to_string(ee))
    }
    let ve = voice_event_count()
    if ve != 4 {
        panic("pe_xaudio2_core FAIL [voice_event_count] expected=4 got=" + to_string(ve))
    }
    let efe = effects_event_count()
    if efe != 3 {
        panic("pe_xaudio2_core FAIL [effects_event_count] expected=3 got=" + to_string(efe))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "XAudio2Create" { panic("pe_xaudio2_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(1) != "IXAudio2_CreateMasteringVoice" { panic("pe_xaudio2_core FAIL [fn_kind_name(1)]") }
    if fn_kind_name(3) != "IXAudio2SourceVoice_SubmitSourceBuffer" { panic("pe_xaudio2_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(7) != "IXAudio2SourceVoice_SetEffectChain" { panic("pe_xaudio2_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(9) != "IXAudio2MasteringVoice_SetVolume" { panic("pe_xaudio2_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_xaudio2_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "engine" { panic("pe_xaudio2_core FAIL [fn_group_name(0)]") }
    if fn_group_name(3) != "voice" { panic("pe_xaudio2_core FAIL [fn_group_name(3)]") }
    if fn_group_name(7) != "effects" { panic("pe_xaudio2_core FAIL [fn_group_name(7)]") }
    if fn_group_name(99) != "unknown" { panic("pe_xaudio2_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pxa_stats()
    if len(s) != 4 { panic("pe_xaudio2_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_xaudio2_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 3 { panic("pe_xaudio2_core FAIL [stats engine_event_count] expected=3 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_xaudio2_core FAIL [stats voice_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_xaudio2_core FAIL [stats effects_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_xaudio2_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"engine_event_count\":" + to_string(s[1])
        + ",\"voice_event_count\":" + to_string(s[2])
        + ",\"effects_event_count\":" + to_string(s[3]))

    r0_emit("pe_xaudio2_core_summary",
        "\"target\":\"XAudio2.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"engine\",\"voice\",\"effects\"],\"iid_guid_synth_bytes\":16,\"voice_details_synth_bytes\":16,\"buffer_synth_bytes\":44,\"d2r_d4_audio_engine_prerequisite\":true,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_xaudio2_core_kpi",
        "\"engine_emits\":3,\"voice_emits\":4,\"effects_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_d4_game_audio_prerequisite_partial\":true,\"xaudio2_sdk_binding\":false,\"coreaudio_audiounit_avaudioengine_binding\":false")

    // ─── cycle 40 → 41 XAudio2 coverage progression evidence emit ───
    r0_emit("pe_xaudio2_core_coverage_progression",
        "\"surface\":\"XAudio2_full_435_fn\",\"cycle_40_count\":188,\"cycle_41_count\":198,\"delta\":10,\"cycle_40_percent\":43.22,\"cycle_41_percent\":45.52,\"cycle_41_module\":\"pe_xaudio2_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_am2_cycle_increment\":10,\"track_am_bundled_part_2_of_4\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_xaudio2_core_round_trip_matrix",
        "\"surface\":\"XAudio2_core_10_fn\",\"fn_partial\":10,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real XAudio2Create + CreateMasteringVoice + SubmitSourceBuffer = AudioUnit + AVAudioEngine + AudioToolbox bridge pending separate cycle (long-horizon)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"d2r_d4_audio_engine_prerequisite\":\"XAudio2 IXAudio2 + Voice baseline = D2R/D4 game audio dependency\"")

    // ─── Track AM2 expansion emit (cycle 41, XAudio2 +10 fn) ───
    r0_emit("pe_xaudio2_core_am2_expansion",
        "\"track\":\"AM2\",\"cycle\":41,\"surface\":\"XAudio2_new\",\"new_fn\":10,\"groups\":[\"engine\",\"voice\",\"effects\"],\"engine_count\":3,\"voice_count\":4,\"effects_count\":3,\"emit_format\":\"__XAUDIO2__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_am_bundled_part_2_of_4\":true,\"50pct_threshold_target\":true,\"d2r_d4_audio_engine_prerequisite_partial\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_xaudio2_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pxa()
    let s2 = pxa_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_xaudio2_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_xaudio2_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", engine_event=" + to_string(s[1])
        + ", voice_event=" + to_string(s[2]) + ", effects_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pxa_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("engine_event_count\t" + to_string(s[1]))
            println("voice_event_count\t" + to_string(s[2]))
            println("effects_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_xaudio2_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_xaudio2_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pxa()
            println("cleaned: " + pxa_dir())
            return
        }
        if sub == "dir" {
            println(pxa_dir())
            return
        }
    }
    println("usage: hexa run pe_xaudio2_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
