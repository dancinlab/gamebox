// lib/loader/pe_xaudio2_core.hexa — XAudio2.dll game audio engine surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine xaudio2 source 측 코드 인용 0. xaudio2.dll 직접 binding 0. XAudio2 SDK / DirectX
//       SDK / DirectXTK / xaudio2redist binding 0. CoreAudio AudioUnit AudioToolbox AVAudioEngine
//       직접 binding 0. NOTE: XAudio2 는 D2R/D4 game audio engine prerequisite, 본 module 측
//       IXAudio2 + Voice (mastering/source/submix) + effect chain baseline (long-horizon
//       production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH/AM parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AM2 — XAudio2 (xaudio2.dll) game audio engine surface coverage 10 fn (skeleton row 만).
// Track AM1 predecessor (WINMM 12 fn cycle 40) 후 본 Track AM2 는 XAudio2 측 engine + voice +
// effects baseline land. cycle 40 측 188/435 (~43.22%) → cycle 41 측 ~198/435 (~45.52%)
// coverage progression (+10 fn 신규, Track AM bundled cycle 40-43 측 AM2 row, 2번째 row,
// D2R/D4 audio engine prerequisite).
//
// 대상 fn (10 fn — 3 group, fn_kind 0..9 canonical map):
//   ENGINE   (3): XAudio2Create(0) / IXAudio2_CreateMasteringVoice(1) /
//                 IXAudio2_CreateSourceVoice(2)
//   VOICE    (4): IXAudio2SourceVoice_SubmitSourceBuffer(3) / IXAudio2SourceVoice_Start(4) /
//                 IXAudio2SourceVoice_Stop(5) / IXAudio2SourceVoice_SetVolume(6)
//   EFFECTS  (3): IXAudio2SourceVoice_SetEffectChain(7) /
//                 IXAudio2SubmixVoice_SetEffectParameters(8) /
//                 IXAudio2MasteringVoice_SetVolume(9)
//
// synthetic IID 16 byte LE GUID:
//   IID_IXAudio2              "8BCF1F58-9FE7-4583-8AC6-E2ADC465C8BB"
//   IID_IXAudio2MasteringVoice (no IID, virtual interface)
//   IID_IXAudio2SourceVoice    (no IID, virtual interface)
// synthetic XAUDIO2_VOICE_DETAILS (16 byte): CreationFlags 0x00000000 + ActiveFlags 0x00000000 +
//   InputChannels 2 + InputSampleRate 0x0000AC44 (44100).
// synthetic XAUDIO2_BUFFER (44 byte): Flags 0x00000000 + AudioBytes 0x00010000 (65536) +
//   pAudioData 0x95010100 + PlayBegin 0 + PlayLength 0 + LoopBegin 0 + LoopLength 0 +
//   LoopCount 0 + pContext 0.
// synthetic IXAudio2/Voice handles family:
//   IXAudio2*           0x95000000   IXAudio2MasteringVoice* 0x95010000
//   IXAudio2SourceVoice* 0x95020000  IXAudio2SubmixVoice*    0x95030000
//   AudioBuffer_data*   0x95010100
//
// persist schema (TSV — 4 table): syscall_invoke / engine_event / voice_event / effects_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pxa_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_xaudio2_core"
}

fn pxa_syscall_invoke_path() -> str {
    return pxa_dir() + "/syscall_invoke.tsv"
}

fn pxa_engine_event_path() -> str {
    return pxa_dir() + "/engine_event.tsv"
}

fn pxa_voice_event_path() -> str {
    return pxa_dir() + "/voice_event.tsv"
}

fn pxa_effects_event_path() -> str {
    return pxa_dir() + "/effects_event.tsv"
}

fn pxa_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pxa_dir() + "'")
}

fn cleanup_pxa() -> void {
    pxa_ensure_dir()
    let _ = exec("rm -f '" + pxa_syscall_invoke_path() + "' '" + pxa_engine_event_path()
        + "' '" + pxa_voice_event_path() + "' '" + pxa_effects_event_path() + "'")
}

// ─── 공통 file IO ───
fn pxa_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pxa_append_row(path: str, row: str) -> void {
    pxa_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pxa_count_rows(path: str, min_cols: int) -> int {
    let t = pxa_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "XAudio2Create" }
    if k == 1 { return "IXAudio2_CreateMasteringVoice" }
    if k == 2 { return "IXAudio2_CreateSourceVoice" }
    if k == 3 { return "IXAudio2SourceVoice_SubmitSourceBuffer" }
    if k == 4 { return "IXAudio2SourceVoice_Start" }
    if k == 5 { return "IXAudio2SourceVoice_Stop" }
    if k == 6 { return "IXAudio2SourceVoice_SetVolume" }
    if k == 7 { return "IXAudio2SourceVoice_SetEffectChain" }
    if k == 8 { return "IXAudio2SubmixVoice_SetEffectParameters" }
    if k == 9 { return "IXAudio2MasteringVoice_SetVolume" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "engine"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "voice"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "effects"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: XAudio2 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_xaudio2_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_xaudio2_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_xaudio2_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_xaudio2_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_xaudio2_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pxa_append_row(pxa_syscall_invoke_path(), row)
}

// ─── record_engine_event: XAudio2Create / CreateMasteringVoice / CreateSourceVoice row ───
fn record_engine_event(evt_id: int, e_kind: str, iid_or_voice: str, handle_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_xaudio2_core FAIL [record_engine_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if e_kind == "" {
        panic("pe_xaudio2_core FAIL [record_engine_event] expected=e_kind!=empty got=empty")
    }
    if iid_or_voice == "" {
        panic("pe_xaudio2_core FAIL [record_engine_event] expected=iid_or_voice!=empty got=empty")
    }
    if handle_hex == "" {
        panic("pe_xaudio2_core FAIL [record_engine_event] expected=handle_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_xaudio2_core FAIL [record_engine_event] expected=status!=empty got=empty")
