// lib/loader/pe_msvcp_core.hexa — MSVCP140.dll MSVC C++ runtime stdlib surface (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine msvcp source 인용 0.
//       msvcp140.dll / vcruntime140.dll / msvcp_win.dll 직접 binding 0.
//       macOS libc++ std::__1::basic_string / std::__1::vector / std::__1::cout /
//       std::__1::cerr / std::__1::endl / std::__1::runtime_error / std::__1::exception
//       libc++abi __cxa_throw 직접 binding 0. NOTE: MSVCP 측 D2R/D4 native game runtime
//       std::string player_name + std::vector<inventory_item> + std::cout debug log +
//       std::runtime_error save corruption + Battle.net Agent C++ stdlib core round-trip
//       baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BP2 — MSVCP std::string/vector/iostream/exception surface 13 fn skeleton-tier.
// cycle 60 410/435 (~94.25%) → cycle 61 ~423/435 (~97.24%) (+13 fn, BP bundled part 2/3).
// **95% threshold breach milestone** at cycle 61 via BP2 MSVCP (cumulative 423/435 97.24%).
//
// 대상 fn (13 fn — 4 group, fn_kind 0..12):
//   STRING    (4): std__string_ctor(0) / std__string_dtor(1) /
//                  std__string_append(2) / std__string_compare(3)
//   VECTOR    (4): std__vector_ctor(4) / std__vector_push_back(5) /
//                  std__vector_pop_back(6) / std__vector_dtor(7)
//   IOSTREAM  (3): std__cout(8) / std__cerr(9) / std__endl(10)
//   EXCEPTION (2): std__exception_what(11) / std__runtime_error_ctor(12)
//
// synthetic struct families:
//   std::string opaque 32B (MSVC SSO short-string-opt, 16B inline + size + cap) /
//               heap-allocated buffer (size > 15) 24B header + 16B aligned ptr.
//   std::vector<T> opaque 24B (begin / end / cap_end pointer triplet) (MSVC layout).
//   std::cout / std::cerr global stream synth 0xC1010100 / 0xC1010200 (basic_ostream<char>).
//   std::endl synth manipulator fn ptr (writes '\n' + flush).
//   std::exception synth vtable 32B (4 slot × 8B): dtor / what / get_class / etc.
//   std::runtime_error inherits std::exception, what() returns const char* whatStr.
//   synthetic vtable: NOT real msvcp140.dll vtable layout — synth pattern only.
//
// persist schema (TSV — 5 table):
//   syscall_invoke / string_event / vector_event / iostream_event / exception_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_msvcp_core"
}

fn pmp_syscall_invoke_path() -> str {
    return pmp_dir() + "/syscall_invoke.tsv"
}

fn pmp_string_event_path() -> str {
    return pmp_dir() + "/string_event.tsv"
}

fn pmp_vector_event_path() -> str {
    return pmp_dir() + "/vector_event.tsv"
}

fn pmp_iostream_event_path() -> str {
    return pmp_dir() + "/iostream_event.tsv"
}

fn pmp_exception_event_path() -> str {
    return pmp_dir() + "/exception_event.tsv"
}

fn pmp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmp_dir() + "'")
}

fn cleanup_pmp() -> void {
    pmp_ensure_dir()
    let _ = exec("rm -f '" + pmp_syscall_invoke_path() + "' '" + pmp_string_event_path()
        + "' '" + pmp_vector_event_path() + "' '" + pmp_iostream_event_path()
        + "' '" + pmp_exception_event_path() + "'")
}

// ─── 공통 file IO ───
fn pmp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmp_append_row(path: str, row: str) -> void {
    pmp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pmp_count_rows(path: str, min_cols: int) -> int {
    let t = pmp_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (13 fn coverage, fn_kind 0..12) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "std__string_ctor" }
    if k == 1 { return "std__string_dtor" }
    if k == 2 { return "std__string_append" }
    if k == 3 { return "std__string_compare" }
    if k == 4 { return "std__vector_ctor" }
    if k == 5 { return "std__vector_push_back" }
    if k == 6 { return "std__vector_pop_back" }
    if k == 7 { return "std__vector_dtor" }
    if k == 8 { return "std__cout" }
    if k == 9 { return "std__cerr" }
    if k == 10 { return "std__endl" }
    if k == 11 { return "std__exception_what" }
    if k == 12 { return "std__runtime_error_ctor" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "string"
        }
    }
    if k >= 4 {
        if k <= 7 {
            return "vector"
        }
    }
    if k >= 8 {
        if k <= 10 {
            return "iostream"
        }
    }
    if k >= 11 {
        if k <= 12 {
            return "exception"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: MSVCP fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_msvcp_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_msvcp_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 12 {
        panic("pe_msvcp_core FAIL [record_syscall_invoke] expected=fn_kind<=12 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_msvcp_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_msvcp_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pmp_append_row(pmp_syscall_invoke_path(), row)
}

// ─── record_string_event: std::string ctor/dtor/append/compare row ───
fn record_string_event(evt_id: int, s_kind: str, str_synth: str, body_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_msvcp_core FAIL [record_string_event] evt_id<=0") }
    if s_kind == "" { panic("pe_msvcp_core FAIL [record_string_event] s_kind=empty") }
    if str_synth == "" { panic("pe_msvcp_core FAIL [record_string_event] str_synth=empty") }
    if body_synth == "" { panic("pe_msvcp_core FAIL [record_string_event] body_synth=empty") }
    if status == "" { panic("pe_msvcp_core FAIL [record_string_event] status=empty") }
    let row = to_string(evt_id) + "\t" + s_kind + "\t" + str_synth + "\t" + body_synth + "\t" + status + "\n"
    pmp_append_row(pmp_string_event_path(), row)
}

// ─── record_vector_event: std::vector ctor/push_back/pop_back/dtor row ───
fn record_vector_event(evt_id: int, v_kind: str, vec_synth: str, item_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_msvcp_core FAIL [record_vector_event] evt_id<=0") }
