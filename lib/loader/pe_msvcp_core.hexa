    if vec_synth == "" { panic("pe_msvcp_core FAIL [record_vector_event] vec_synth=empty") }
    if item_synth == "" { panic("pe_msvcp_core FAIL [record_vector_event] item_synth=empty") }
    if status == "" { panic("pe_msvcp_core FAIL [record_vector_event] status=empty") }
    let row = to_string(evt_id) + "\t" + v_kind + "\t" + vec_synth + "\t" + item_synth + "\t" + status + "\n"
    pmp_append_row(pmp_vector_event_path(), row)
}

// ─── record_iostream_event: std::cout/cerr/endl row ───
fn record_iostream_event(evt_id: int, i_kind: str, stream_synth: str, payload_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_msvcp_core FAIL [record_iostream_event] evt_id<=0") }
    if i_kind == "" { panic("pe_msvcp_core FAIL [record_iostream_event] i_kind=empty") }
    if stream_synth == "" { panic("pe_msvcp_core FAIL [record_iostream_event] stream_synth=empty") }
    if payload_synth == "" { panic("pe_msvcp_core FAIL [record_iostream_event] payload_synth=empty") }
