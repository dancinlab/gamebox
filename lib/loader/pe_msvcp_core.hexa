// ─── record_exception_event: std::exception::what / std::runtime_error::ctor row ───
fn record_exception_event(evt_id: int, e_kind: str, exc_synth: str, what_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_msvcp_core FAIL [record_exception_event] evt_id<=0") }
    if e_kind == "" { panic("pe_msvcp_core FAIL [record_exception_event] e_kind=empty") }
    if exc_synth == "" { panic("pe_msvcp_core FAIL [record_exception_event] exc_synth=empty") }
    if what_synth == "" { panic("pe_msvcp_core FAIL [record_exception_event] what_synth=empty") }
    if status == "" { panic("pe_msvcp_core FAIL [record_exception_event] status=empty") }
    let row = to_string(evt_id) + "\t" + e_kind + "\t" + exc_synth + "\t" + what_synth + "\t" + status + "\n"
    pmp_append_row(pmp_exception_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pmp_count_rows(pmp_syscall_invoke_path(), 4)
}

fn string_event_count() -> int {
    return pmp_count_rows(pmp_string_event_path(), 5)
}

fn vector_event_count() -> int {
    return pmp_count_rows(pmp_vector_event_path(), 5)
}

fn iostream_event_count() -> int {
    return pmp_count_rows(pmp_iostream_event_path(), 5)
}

fn exception_event_count() -> int {
    return pmp_count_rows(pmp_exception_event_path(), 5)
}

fn pmp_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(string_event_count())
    out.push(vector_event_count())
    out.push(iostream_event_count())
    out.push(exception_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pmp-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pmp()

    // ─── 1. syscall_invoke × 13 (one per fn, 4 group coverage) ───
    //   STRING group (4)
    record_syscall_invoke(1, 0, "std__string_ctor", "PARTIAL")
    println("__MSVCP__ PARTIAL std__string_ctor")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"std__string_ctor\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"this\":\"0xD1010100_std_string\",\"src_cstr\":\"d2r_player_DEMETRIUS\",\"len\":15,\"sso_inline\":true,\"struct_bytes\":32")
    record_syscall_invoke(2, 1, "std__string_dtor", "PARTIAL")
    println("__MSVCP__ PARTIAL std__string_dtor")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"std__string_dtor\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"this\":\"0xD1010100_std_string\",\"heap_freed\":false,\"sso_path\":true,\"d2r_player_name_lifecycle_baseline\":true")
    record_syscall_invoke(3, 2, "std__string_append", "PARTIAL")
    println("__MSVCP__ PARTIAL std__string_append")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"std__string_append\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"this\":\"0xD1010100\",\"appended_cstr\":\"_lvl99_pala\",\"new_len\":26,\"sso_to_heap_promotion\":true,\"heap_buf\":\"0xD1010200_heap_32B_aligned\"")
    record_syscall_invoke(4, 3, "std__string_compare", "PARTIAL")
    println("__MSVCP__ PARTIAL std__string_compare")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"std__string_compare\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"this\":\"0xD1010100\",\"other\":\"0xD1010300\",\"return_int\":0,\"equal\":true,\"d2r_savegame_player_match_baseline\":true")

    //   VECTOR group (4)
    record_syscall_invoke(5, 4, "std__vector_ctor", "PARTIAL")
    println("__MSVCP__ PARTIAL std__vector_ctor")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"std__vector_ctor\",\"fn_group\":\"vector\",\"status\":\"PARTIAL\",\"this\":\"0xD1020100_std_vector_inventory_item\",\"begin\":\"NULL\",\"end\":\"NULL\",\"cap_end\":\"NULL\",\"struct_bytes\":24,\"d2r_inventory_vector_baseline\":true")
    record_syscall_invoke(6, 5, "std__vector_push_back", "PARTIAL")
    println("__MSVCP__ PARTIAL std__vector_push_back")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"std__vector_push_back\",\"fn_group\":\"vector\",\"status\":\"PARTIAL\",\"this\":\"0xD1020100\",\"item\":\"0xD1020200_inventory_item_unique_ring\",\"new_size\":1,\"new_cap\":4,\"realloc\":true,\"d4_inventory_unique_ring_synth\":true")
    record_syscall_invoke(7, 6, "std__vector_pop_back", "PARTIAL")
    println("__MSVCP__ PARTIAL std__vector_pop_back")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"std__vector_pop_back\",\"fn_group\":\"vector\",\"status\":\"PARTIAL\",\"this\":\"0xD1020100\",\"new_size\":0,\"item_dtor\":true,\"d2r_inventory_drop_baseline\":true")
    record_syscall_invoke(8, 7, "std__vector_dtor", "PARTIAL")
    println("__MSVCP__ PARTIAL std__vector_dtor")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"std__vector_dtor\",\"fn_group\":\"vector\",\"status\":\"PARTIAL\",\"this\":\"0xD1020100\",\"heap_freed\":true,\"items_dtor_count\":0,\"d2r_session_end_baseline\":true")

    //   IOSTREAM group (3)
    record_syscall_invoke(9, 8, "std__cout", "PARTIAL")
    println("__MSVCP__ PARTIAL std__cout")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"std__cout\",\"fn_group\":\"iostream\",\"status\":\"PARTIAL\",\"global_synth\":\"0xC1010100_std_cout\",\"payload\":\"D2R_init_phase_3_log\",\"std_basic_ostream_char\":true,\"d2r_debug_log_baseline\":true")
    record_syscall_invoke(10, 9, "std__cerr", "PARTIAL")
    println("__MSVCP__ PARTIAL std__cerr")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"std__cerr\",\"fn_group\":\"iostream\",\"status\":\"PARTIAL\",\"global_synth\":\"0xC1010200_std_cerr\",\"payload\":\"D2R_warn_savegame_v1_64_corrupt\",\"unbuffered\":true,\"d2r_warn_log_baseline\":true")
    record_syscall_invoke(11, 10, "std__endl", "PARTIAL")
    println("__MSVCP__ PARTIAL std__endl")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"std__endl\",\"fn_group\":\"iostream\",\"status\":\"PARTIAL\",\"manipulator_synth\":\"0xC1010300_std_endl\",\"action\":\"write_LF_then_flush\",\"target_stream\":\"std_cout_or_cerr\",\"newline_byte\":\"0x0A\"")

    //   EXCEPTION group (2)
    record_syscall_invoke(12, 11, "std__exception_what", "PARTIAL")
    println("__MSVCP__ PARTIAL std__exception_what")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"std__exception_what\",\"fn_group\":\"exception\",\"status\":\"PARTIAL\",\"this\":\"0xD1030100_std_exception\",\"vtable_slot\":1,\"vtable_bytes\":32,\"return_const_char\":\"std::exception\",\"d2r_d4_exception_baseline\":true")
    record_syscall_invoke(13, 12, "std__runtime_error_ctor", "PARTIAL")
    println("__MSVCP__ PARTIAL std__runtime_error_ctor")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":13,\"fn_kind\":12,\"fn_name\":\"std__runtime_error_ctor\",\"fn_group\":\"exception\",\"status\":\"PARTIAL\",\"this\":\"0xD1030200_std_runtime_error\",\"what_synth\":\"d2r_savegame_corruption_byte_0x42_offset_0x317F\",\"inherits_std_exception\":true,\"d2r_savegame_corruption_baseline\":true")

    // ─── 2. string_event × 4 (ctor/dtor/append/compare) ───
    record_string_event(1, "ctor_d2r_player_DEMETRIUS_15B", "0xD1010100_std_string_32B", "DEMETRIUS_sso_inline_15B", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"string_event\",\"evt_id\":1,\"s_kind\":\"ctor_d2r_player_DEMETRIUS_15B\",\"str_synth\":\"0xD1010100_std_string_32B\",\"body_synth\":\"DEMETRIUS_sso_inline_15B\",\"sso_inline\":true,\"d2r_player_name_baseline\":true,\"status\":\"PARTIAL\"")
    record_string_event(2, "dtor_clean_sso_path", "0xD1010100", "no_heap_free_path", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"string_event\",\"evt_id\":2,\"s_kind\":\"dtor_clean_sso_path\",\"str_synth\":\"0xD1010100\",\"body_synth\":\"no_heap_free_path\",\"d2r_player_name_lifecycle_baseline\":true,\"status\":\"PARTIAL\"")
    record_string_event(3, "append_lvl99_pala_promote_heap", "0xD1010100", "DEMETRIUS_lvl99_pala_26B_heap_promote", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"string_event\",\"evt_id\":3,\"s_kind\":\"append_lvl99_pala_promote_heap\",\"str_synth\":\"0xD1010100\",\"body_synth\":\"DEMETRIUS_lvl99_pala_26B_heap_promote\",\"sso_to_heap_promotion\":true,\"d2r_class_label_baseline\":true,\"status\":\"PARTIAL\"")
    record_string_event(4, "compare_savegame_player_match", "0xD1010100", "match_eq_0", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"string_event\",\"evt_id\":4,\"s_kind\":\"compare_savegame_player_match\",\"str_synth\":\"0xD1010100\",\"body_synth\":\"match_eq_0\",\"d2r_savegame_player_match_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── 3. vector_event × 4 (ctor/push_back/pop_back/dtor) ───
    record_vector_event(1, "ctor_inventory_empty", "0xD1020100_std_vector_24B", "begin_end_cap_NULL", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"vector_event\",\"evt_id\":1,\"v_kind\":\"ctor_inventory_empty\",\"vec_synth\":\"0xD1020100_std_vector_24B\",\"item_synth\":\"begin_end_cap_NULL\",\"d2r_inventory_vector_baseline\":true,\"status\":\"PARTIAL\"")
    record_vector_event(2, "push_back_unique_ring_realloc_4", "0xD1020100", "0xD1020200_unique_ring_synth", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"vector_event\",\"evt_id\":2,\"v_kind\":\"push_back_unique_ring_realloc_4\",\"vec_synth\":\"0xD1020100\",\"item_synth\":\"0xD1020200_unique_ring_synth\",\"d4_inventory_unique_ring_synth\":true,\"status\":\"PARTIAL\"")
    record_vector_event(3, "pop_back_drop_item", "0xD1020100", "size_1_to_0", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"vector_event\",\"evt_id\":3,\"v_kind\":\"pop_back_drop_item\",\"vec_synth\":\"0xD1020100\",\"item_synth\":\"size_1_to_0\",\"d2r_inventory_drop_baseline\":true,\"status\":\"PARTIAL\"")
    record_vector_event(4, "dtor_session_end_heap_free", "0xD1020100", "heap_free_4_slot", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"vector_event\",\"evt_id\":4,\"v_kind\":\"dtor_session_end_heap_free\",\"vec_synth\":\"0xD1020100\",\"item_synth\":\"heap_free_4_slot\",\"d2r_session_end_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── 4. iostream_event × 3 (cout/cerr/endl) ───
    record_iostream_event(1, "cout_d2r_init_phase_3_log", "0xC1010100_std_cout", "D2R_init_phase_3_log_synth", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"iostream_event\",\"evt_id\":1,\"i_kind\":\"cout_d2r_init_phase_3_log\",\"stream_synth\":\"0xC1010100_std_cout\",\"payload_synth\":\"D2R_init_phase_3_log_synth\",\"d2r_debug_log_baseline\":true,\"status\":\"PARTIAL\"")
    record_iostream_event(2, "cerr_d2r_warn_savegame_corrupt", "0xC1010200_std_cerr", "D2R_warn_savegame_v1_64_corrupt_synth", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"iostream_event\",\"evt_id\":2,\"i_kind\":\"cerr_d2r_warn_savegame_corrupt\",\"stream_synth\":\"0xC1010200_std_cerr\",\"payload_synth\":\"D2R_warn_savegame_v1_64_corrupt_synth\",\"unbuffered\":true,\"d2r_warn_log_baseline\":true,\"status\":\"PARTIAL\"")
    record_iostream_event(3, "endl_LF_flush_synth", "0xC1010300_std_endl", "write_LF_0x0A_flush_synth", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"iostream_event\",\"evt_id\":3,\"i_kind\":\"endl_LF_flush_synth\",\"stream_synth\":\"0xC1010300_std_endl\",\"payload_synth\":\"write_LF_0x0A_flush_synth\",\"manipulator_chain\":true,\"status\":\"PARTIAL\"")

    // ─── 5. exception_event × 2 (what/runtime_error_ctor) ───
    record_exception_event(1, "what_std_exception_const_char", "0xD1030100_std_exception", "std__exception_const_char_synth", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"exception_event\",\"evt_id\":1,\"e_kind\":\"what_std_exception_const_char\",\"exc_synth\":\"0xD1030100_std_exception\",\"what_synth\":\"std__exception_const_char_synth\",\"vtable_bytes\":32,\"vtable_slot\":1,\"d2r_d4_exception_baseline\":true,\"status\":\"PARTIAL\"")
    record_exception_event(2, "runtime_error_ctor_savegame_corruption", "0xD1030200_std_runtime_error", "d2r_savegame_corruption_byte_0x42_offset_0x317F", "PARTIAL")
    r0_emit("pe_msvcp_core_record", "\"kind\":\"exception_event\",\"evt_id\":2,\"e_kind\":\"runtime_error_ctor_savegame_corruption\",\"exc_synth\":\"0xD1030200_std_runtime_error\",\"what_synth\":\"d2r_savegame_corruption_byte_0x42_offset_0x317F\",\"inherits_std_exception\":true,\"d2r_savegame_corruption_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 13 {
        panic("pe_msvcp_core FAIL [syscall_invoke_count] expected=13 got=" + to_string(si))
    }
    let se = string_event_count()
    if se != 4 {
        panic("pe_msvcp_core FAIL [string_event_count] expected=4 got=" + to_string(se))
    }
    let ve = vector_event_count()
    if ve != 4 {
        panic("pe_msvcp_core FAIL [vector_event_count] expected=4 got=" + to_string(ve))
    }
    let ie = iostream_event_count()
    if ie != 3 {
        panic("pe_msvcp_core FAIL [iostream_event_count] expected=3 got=" + to_string(ie))
    }
    let ee = exception_event_count()
    if ee != 2 {
        panic("pe_msvcp_core FAIL [exception_event_count] expected=2 got=" + to_string(ee))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "std__string_ctor" { panic("pe_msvcp_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(3) != "std__string_compare" { panic("pe_msvcp_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(5) != "std__vector_push_back" { panic("pe_msvcp_core FAIL [fn_kind_name(5)]") }
    if fn_kind_name(8) != "std__cout" { panic("pe_msvcp_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(12) != "std__runtime_error_ctor" { panic("pe_msvcp_core FAIL [fn_kind_name(12)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_msvcp_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "string" { panic("pe_msvcp_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "vector" { panic("pe_msvcp_core FAIL [fn_group_name(4)]") }
    if fn_group_name(8) != "iostream" { panic("pe_msvcp_core FAIL [fn_group_name(8)]") }
    if fn_group_name(11) != "exception" { panic("pe_msvcp_core FAIL [fn_group_name(11)]") }
    if fn_group_name(99) != "unknown" { panic("pe_msvcp_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pmp_stats()
    if len(s) != 5 { panic("pe_msvcp_core FAIL [stats len] expected=5 got=" + to_string(len(s))) }
    if s[0] != 13 { panic("pe_msvcp_core FAIL [stats syscall_invoke_count] expected=13 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_msvcp_core FAIL [stats string_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_msvcp_core FAIL [stats vector_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_msvcp_core FAIL [stats iostream_event_count] expected=3 got=" + to_string(s[3])) }
    if s[4] != 2 { panic("pe_msvcp_core FAIL [stats exception_event_count] expected=2 got=" + to_string(s[4])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_msvcp_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"string_event_count\":" + to_string(s[1])
        + ",\"vector_event_count\":" + to_string(s[2])
        + ",\"iostream_event_count\":" + to_string(s[3])
        + ",\"exception_event_count\":" + to_string(s[4]))

    r0_emit("pe_msvcp_core_summary",
        "\"target\":\"MSVCP140.dll\",\"fn_total\":13,\"fn_emit_partial\":13,\"groups\":[\"string\",\"vector\",\"iostream\",\"exception\"],\"std_string_synth\":\"0xD1010100\",\"std_vector_synth\":\"0xD1020100\",\"std_cout_synth\":\"0xC1010100\",\"std_cerr_synth\":\"0xC1010200\",\"std_endl_synth\":\"0xC1010300\",\"std_exception_synth\":\"0xD1030100\",\"std_runtime_error_synth\":\"0xD1030200\",\"vtable_bytes\":32,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_msvcp_core_kpi",
        "\"string_emits\":4,\"vector_emits\":4,\"iostream_emits\":3,\"exception_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_player_name_baseline\":true,\"d2r_d4_inventory_vector_baseline\":true,\"d2r_debug_log_baseline\":true,\"d2r_savegame_corruption_runtime_error_baseline\":true,\"libcxx_basic_string_basic_ostream_runtime_error_binding\":false,\"libcxxabi_cxa_throw_binding\":false")

    // ─── cycle 60 → 61 MSVCP coverage progression evidence emit ───
    r0_emit("pe_msvcp_core_coverage_progression",
        "\"surface\":\"MSVCP_full_435_fn\",\"cycle_60_count\":410,\"cycle_61_count\":423,\"delta\":13,\"cycle_60_percent\":94.25,\"cycle_61_percent\":97.24,\"cycle_61_module\":\"pe_msvcp_core.hexa\",\"long_horizon_cycles_remaining\":\"few (full ~435 fn = nearing completion)\",\"track_bp2_cycle_increment\":13,\"track_bp_bundled_part_2_of_3\":true,\"threshold_95pct_breach_at_cycle_61\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_msvcp_core_round_trip_matrix",
        "\"surface\":\"MSVCP_core_13_fn\",\"fn_partial\":13,\"fn_groups\":4,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real std::string ctor + std::vector push_back + std::cout operator<< + std::runtime_error ctor + std::exception::what = libc++ std::__1::basic_string ctor + std::__1::vector push_back + std::__1::cout/cerr operator<< + std::__1::runtime_error ctor + libc++abi __cxa_throw bridge pending separate cycle (long-horizon C++ stdlib pipeline)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    // ─── Track BP2 expansion emit (cycle 61, MSVCP +13 fn) ───
    r0_emit("pe_msvcp_core_bp2_expansion",
        "\"track\":\"BP2\",\"cycle\":61,\"surface\":\"MSVCP_new\",\"new_fn\":13,\"groups\":[\"string\",\"vector\",\"iostream\",\"exception\"],\"string_count\":4,\"vector_count\":4,\"iostream_count\":3,\"exception_count\":2,\"emit_format\":\"__MSVCP__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_3_evidence_augment\":true,\"track_bp_bundled_part_2_of_3\":true,\"msvc_cpp_runtime_stdlib_family\":true,\"threshold_95pct_breach_module\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_msvcp_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pmp()
    let s2 = pmp_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_msvcp_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_msvcp_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", string_event=" + to_string(s[1])
        + ", vector_event=" + to_string(s[2]) + ", iostream_event=" + to_string(s[3])
        + ", exception_event=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmp_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("string_event_count\t" + to_string(s[1]))
            println("vector_event_count\t" + to_string(s[2]))
            println("iostream_event_count\t" + to_string(s[3]))
            println("exception_event_count\t" + to_string(s[4]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_msvcp_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_msvcp_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmp()
            println("cleaned: " + pmp_dir())
            return
        }
        if sub == "dir" {
            println(pmp_dir())
            return
        }
    }
    println("usage: hexa run pe_msvcp_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
