// lib/loader/pe_input_latency_track.hexa — cycle 67 input → display latency tracker skeleton
//
// docker hexa input event → display present 사이 elapsed_us 추적. native helper
// (Phase 1 stage2) 가 raw event 를 host 에서 sample → docker hexa 로 전달되면
// 이 module 이 schema 화 (실 측정 X — stage 화).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 input latency tracker — IOKit / HID 직접 접근 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// input_kind code:
//   1 = mouse
//   2 = keyboard
//   3 = gamepad
//   4 = touch
//
// persist schema (TSV — inputs.tsv):
//   input_id<int> \t input_kind<int> \t elapsed_us<int> \t frame_id<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pilt_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_input_latency_track"
}

fn pilt_inputs_path() -> str {
    return pilt_dir() + "/inputs.tsv"
}

fn pilt_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pilt_dir() + "'")
}

fn cleanup_pilt() -> void {
    pilt_ensure_dir()
    let _ = exec("rm -f '" + pilt_inputs_path() + "'")
}

// ─── 공통 file IO ───
fn pilt_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pilt_append_row(path: str, row: str) -> void {
    pilt_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_input: input latency 1 건 기록 ───
fn record_input(input_id: int, input_kind: int, elapsed_us: int, frame_id: int) -> void {
    if input_id <= 0 {
        panic("pe_input_latency_track FAIL [record_input] expected=input_id>0 got=" + to_string(input_id))
    }
    if input_kind < 1 {
        panic("pe_input_latency_track FAIL [record_input] expected=input_kind>=1 got=" + to_string(input_kind))
    }
    if input_kind > 4 {
        panic("pe_input_latency_track FAIL [record_input] expected=input_kind<=4 got=" + to_string(input_kind))
    }
    if elapsed_us < 0 {
        panic("pe_input_latency_track FAIL [record_input] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    if frame_id < 0 {
        panic("pe_input_latency_track FAIL [record_input] expected=frame_id>=0 got=" + to_string(frame_id))
    }
    let row = to_string(input_id) + "\t" + to_string(input_kind)
        + "\t" + to_string(elapsed_us) + "\t" + to_string(frame_id) + "\n"
    pilt_append_row(pilt_inputs_path(), row)
}

// ─── input_count: total input 수 ───
fn input_count() -> int {
    let t = pilt_read_table(pilt_inputs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_elapsed_us: 모든 input elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = pilt_read_table(pilt_inputs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_kind: 특정 input_kind 의 input 수 ───
fn count_by_kind(kind: int) -> int {
    let t = pilt_read_table(pilt_inputs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── max_elapsed_us: elapsed_us 최댓값 (없으면 0) ───
fn max_elapsed_us() -> int {
    let t = pilt_read_table(pilt_inputs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut best = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let v = to_int(parts[2])
                if v > best {
                    best = v
                }
            }
        }
        i = i + 1
    }
    return best
}

// ─── input_elapsed_us: 특정 input_id 의 elapsed_us (없으면 0) ───
fn input_elapsed_us(input_id: int) -> int {
    let t = pilt_read_table(pilt_inputs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == input_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pilt_stats: [input_count, total_elapsed_us, max_elapsed_us, count_by_kind(2)] ───
fn pilt_stats() -> array {
    let mut out = []
    out.push(input_count())
    out.push(total_elapsed_us())
    out.push(max_elapsed_us())
    out.push(count_by_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pilt-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pilt()

    // 2. record 5 inputs spanning ≥3 kinds (mouse, keyboard, gamepad, touch, keyboard)
    record_input(670001, 1, 1200, 9001)
    r0_emit("pe_input_latency_track_record",
        "\"input_id\":670001,\"input_kind\":1,\"elapsed_us\":1200,\"frame_id\":9001,\"target\":\"mouse\"")

    record_input(670002, 2, 2500, 9002)
    r0_emit("pe_input_latency_track_record",
        "\"input_id\":670002,\"input_kind\":2,\"elapsed_us\":2500,\"frame_id\":9002,\"target\":\"keyboard\"")

    record_input(670003, 3, 4800, 9003)
    r0_emit("pe_input_latency_track_record",
        "\"input_id\":670003,\"input_kind\":3,\"elapsed_us\":4800,\"frame_id\":9003,\"target\":\"gamepad\"")

    record_input(670004, 4, 3300, 9004)
    r0_emit("pe_input_latency_track_record",
        "\"input_id\":670004,\"input_kind\":4,\"elapsed_us\":3300,\"frame_id\":9004,\"target\":\"touch\"")

    record_input(670005, 2, 1700, 9005)
    r0_emit("pe_input_latency_track_record",
        "\"input_id\":670005,\"input_kind\":2,\"elapsed_us\":1700,\"frame_id\":9005,\"target\":\"keyboard\"")

    // 3. input_count = 5
    let c = input_count()
    if c != 5 {
        panic("pe_input_latency_track FAIL [input_count] expected=5 got=" + to_string(c))
    }

    // 4. total_elapsed_us = 13500
    let te = total_elapsed_us()
    if te != 13500 {
        panic("pe_input_latency_track FAIL [total_elapsed_us] expected=13500 got=" + to_string(te))
    }

    // 5. count_by_kind sanity (mouse=1, keyboard=2, gamepad=1, touch=1)
    let k1 = count_by_kind(1)
    if k1 != 1 {
        panic("pe_input_latency_track FAIL [count_by_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_kind(2)
    if k2 != 2 {
        panic("pe_input_latency_track FAIL [count_by_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_kind(3)
    if k3 != 1 {
        panic("pe_input_latency_track FAIL [count_by_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_kind(4)
    if k4 != 1 {
        panic("pe_input_latency_track FAIL [count_by_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_kind(99)
    if k99 != 0 {
        panic("pe_input_latency_track FAIL [count_by_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. max_elapsed_us = 4800 (gamepad)
    let mx = max_elapsed_us()
    if mx != 4800 {
        panic("pe_input_latency_track FAIL [max_elapsed_us] expected=4800 got=" + to_string(mx))
    }

    // 7. input_elapsed_us sanity
    let e2 = input_elapsed_us(670002)
    if e2 != 2500 {
        panic("pe_input_latency_track FAIL [input_elapsed_us(670002)] expected=2500 got=" + to_string(e2))
    }
    let e3 = input_elapsed_us(670003)
    if e3 != 4800 {
        panic("pe_input_latency_track FAIL [input_elapsed_us(670003)] expected=4800 got=" + to_string(e3))
    }
    let e_miss = input_elapsed_us(9999)
    if e_miss != 0 {
        panic("pe_input_latency_track FAIL [input_elapsed_us(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 8. pilt_stats() = [5, 13500, 4800, 2]
    let s = pilt_stats()
    if len(s) != 4 {
        panic("pe_input_latency_track FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_input_latency_track FAIL [stats input_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 13500 {
        panic("pe_input_latency_track FAIL [stats total_elapsed_us] expected=13500 got=" + to_string(s[1]))
    }
    if s[2] != 4800 {
        panic("pe_input_latency_track FAIL [stats max_elapsed_us] expected=4800 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_input_latency_track FAIL [stats count_kind(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_input_latency_track_stats",
        "\"input_count\":" + to_string(s[0])
        + ",\"total_elapsed_us\":" + to_string(s[1])
        + ",\"max_elapsed_us\":" + to_string(s[2])
        + ",\"kind_keyboard\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_input_latency_track FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pilt()
    let s2 = pilt_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_input_latency_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_input_latency_track self_test PASS (inputs=" + to_string(s[0])
        + ", total_us=" + to_string(s[1]) + ", max_us=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pilt_stats()
            println("input_count\t" + to_string(s[0]))
            println("total_elapsed_us\t" + to_string(s[1]))
            println("max_elapsed_us\t" + to_string(s[2]))
            println("count_kind_keyboard\t" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let iid = to_int(a[3])
                println("input_elapsed_us\t" + to_string(input_elapsed_us(iid)))
                return
            }
            println("usage: hexa run pe_input_latency_track.hexa elapsed <input_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_kind\t" + to_string(count_by_kind(kind)))
                return
            }
            println("usage: hexa run pe_input_latency_track.hexa count <input_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pilt()
            println("cleaned: " + pilt_dir())
            return
        }
        if sub == "dir" {
            println(pilt_dir())
            return
        }
    }
    println("usage: hexa run pe_input_latency_track.hexa { self-test | stats | elapsed <input_id> | count <kind> | cleanup | dir }")
}
