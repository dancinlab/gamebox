// lib/loader/pe_com_apartment.hexa — cycle 77 COM apartment thread message dispatch telemetry
//
// Windows COM apartment model — STA (single-threaded apartment) 는 message
// pump 를 통한 cross-apartment marshalling, MTA (multi-threaded apartment)
// 는 worker thread pool 직접 호출. 본 module 은 dispatch event 를
// per-apartment / per-msg_kind 통계로 기록 — 실 COM runtime hook 은 X
// (telemetry tracker only).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 dispatch tracker — 실 CoInitialize / PeekMessage / DispatchMessage
//   호출 X (후속 stage).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// apartment_kind code:
//   1 = sta  (single-threaded apartment, wnd msg pump)
//   2 = mta  (multi-threaded apartment, worker thread pool)
//
// msg_kind code:
//   1 = cross_apartment_call
//   2 = callback
//   3 = window_msg
//   4 = apc
//   5 = timer
//
// persist schema (TSV — dispatches.tsv):
//   dispatch_id<int> \t apartment_kind<int> \t msg_kind<int> \t elapsed_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pca_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_com_apartment"
}

fn pca_dispatches_path() -> str {
    return pca_dir() + "/dispatches.tsv"
}

fn pca_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pca_dir() + "'")
}

fn cleanup_pca() -> void {
    pca_ensure_dir()
    let _ = exec("rm -f '" + pca_dispatches_path() + "'")
}

// ─── 공통 file IO ───
fn pca_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pca_append_row(path: str, row: str) -> void {
    pca_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dispatch: dispatch 1 건 기록 ───
fn record_dispatch(dispatch_id: int, apartment_kind: int, msg_kind: int, elapsed_us: int) -> void {
    if dispatch_id <= 0 {
        panic("pe_com_apartment FAIL [record_dispatch] expected=dispatch_id>0 got=" + to_string(dispatch_id))
    }
    if apartment_kind < 1 {
        panic("pe_com_apartment FAIL [record_dispatch] expected=apartment_kind>=1 got=" + to_string(apartment_kind))
    }
    if apartment_kind > 2 {
        panic("pe_com_apartment FAIL [record_dispatch] expected=apartment_kind<=2 got=" + to_string(apartment_kind))
    }
    if msg_kind < 1 {
        panic("pe_com_apartment FAIL [record_dispatch] expected=msg_kind>=1 got=" + to_string(msg_kind))
    }
    if msg_kind > 5 {
        panic("pe_com_apartment FAIL [record_dispatch] expected=msg_kind<=5 got=" + to_string(msg_kind))
    }
    if elapsed_us < 0 {
        panic("pe_com_apartment FAIL [record_dispatch] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    let row = to_string(dispatch_id) + "\t" + to_string(apartment_kind)
        + "\t" + to_string(msg_kind) + "\t" + to_string(elapsed_us) + "\n"
    pca_append_row(pca_dispatches_path(), row)
}

// ─── dispatch_count: total dispatch 수 ───
fn dispatch_count() -> int {
    let t = pca_read_table(pca_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_elapsed_us: 모든 dispatch elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = pca_read_table(pca_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_apartment: 특정 apartment_kind 의 dispatch 수 ───
fn count_by_apartment(apartment_kind: int) -> int {
    let t = pca_read_table(pca_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == apartment_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_msg_kind: 특정 msg_kind 의 dispatch 수 ───
fn count_by_msg_kind(msg_kind: int) -> int {
    let t = pca_read_table(pca_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == msg_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── dispatch_elapsed_us: 특정 dispatch_id 의 elapsed_us (없으면 0) ───
fn dispatch_elapsed_us(dispatch_id: int) -> int {
    let t = pca_read_table(pca_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == dispatch_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pca_stats: [dispatch_count, total_elapsed_us, count_by_apartment(1), count_by_msg_kind(1)] ───
fn pca_stats() -> array {
    let mut out = []
    out.push(dispatch_count())
    out.push(total_elapsed_us())
    out.push(count_by_apartment(1))
    out.push(count_by_msg_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pca-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pca()

    // 2. record 5 dispatches across both apartments and ≥3 msg_kinds
    //    apartment 1 (sta) — 3 건: cross_apartment_call, window_msg, timer
    //    apartment 2 (mta) — 2 건: cross_apartment_call, callback
    record_dispatch(770001, 1, 1, 120)
    r0_emit("pe_com_apartment_record",
        "\"dispatch_id\":770001,\"apartment_kind\":1,\"msg_kind\":1,\"elapsed_us\":120,\"target\":\"sta_cross_call\"")

    record_dispatch(770002, 1, 3, 45)
    r0_emit("pe_com_apartment_record",
        "\"dispatch_id\":770002,\"apartment_kind\":1,\"msg_kind\":3,\"elapsed_us\":45,\"target\":\"sta_window_msg\"")

    record_dispatch(770003, 2, 1, 80)
    r0_emit("pe_com_apartment_record",
        "\"dispatch_id\":770003,\"apartment_kind\":2,\"msg_kind\":1,\"elapsed_us\":80,\"target\":\"mta_cross_call\"")

    record_dispatch(770004, 2, 2, 60)
    r0_emit("pe_com_apartment_record",
        "\"dispatch_id\":770004,\"apartment_kind\":2,\"msg_kind\":2,\"elapsed_us\":60,\"target\":\"mta_callback\"")

    record_dispatch(770005, 1, 5, 200)
    r0_emit("pe_com_apartment_record",
        "\"dispatch_id\":770005,\"apartment_kind\":1,\"msg_kind\":5,\"elapsed_us\":200,\"target\":\"sta_timer\"")

    // 3. dispatch_count = 5
    let c = dispatch_count()
    if c != 5 {
        panic("pe_com_apartment FAIL [dispatch_count] expected=5 got=" + to_string(c))
    }

    // 4. total_elapsed_us = 120+45+80+60+200 = 505
    let te = total_elapsed_us()
    if te != 505 {
        panic("pe_com_apartment FAIL [total_elapsed_us] expected=505 got=" + to_string(te))
    }

    // 5. count_by_apartment sanity (sta=3, mta=2)
    let a1 = count_by_apartment(1)
    if a1 != 3 {
        panic("pe_com_apartment FAIL [count_by_apartment(1)] expected=3 got=" + to_string(a1))
    }
    let a2 = count_by_apartment(2)
    if a2 != 2 {
        panic("pe_com_apartment FAIL [count_by_apartment(2)] expected=2 got=" + to_string(a2))
    }
    let a99 = count_by_apartment(99)
    if a99 != 0 {
        panic("pe_com_apartment FAIL [count_by_apartment(99)] expected=0 got=" + to_string(a99))
    }

    // 6. count_by_msg_kind sanity (1=2, 2=1, 3=1, 4=0, 5=1)
    let m1 = count_by_msg_kind(1)
    if m1 != 2 {
        panic("pe_com_apartment FAIL [count_by_msg_kind(1)] expected=2 got=" + to_string(m1))
    }
    let m2 = count_by_msg_kind(2)
    if m2 != 1 {
        panic("pe_com_apartment FAIL [count_by_msg_kind(2)] expected=1 got=" + to_string(m2))
    }
    let m3 = count_by_msg_kind(3)
    if m3 != 1 {
        panic("pe_com_apartment FAIL [count_by_msg_kind(3)] expected=1 got=" + to_string(m3))
    }
    let m4 = count_by_msg_kind(4)
    if m4 != 0 {
        panic("pe_com_apartment FAIL [count_by_msg_kind(4)] expected=0 got=" + to_string(m4))
    }
    let m5 = count_by_msg_kind(5)
    if m5 != 1 {
        panic("pe_com_apartment FAIL [count_by_msg_kind(5)] expected=1 got=" + to_string(m5))
    }

    // 7. dispatch_elapsed_us sanity
    let e1 = dispatch_elapsed_us(770001)
    if e1 != 120 {
        panic("pe_com_apartment FAIL [dispatch_elapsed_us(770001)] expected=120 got=" + to_string(e1))
    }
    let e5 = dispatch_elapsed_us(770005)
    if e5 != 200 {
        panic("pe_com_apartment FAIL [dispatch_elapsed_us(770005)] expected=200 got=" + to_string(e5))
    }
    let e_miss = dispatch_elapsed_us(9999)
    if e_miss != 0 {
        panic("pe_com_apartment FAIL [dispatch_elapsed_us(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 8. pca_stats() = [5, 505, 3, 2]
    let s = pca_stats()
    if len(s) != 4 {
        panic("pe_com_apartment FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_com_apartment FAIL [stats dispatch_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 505 {
        panic("pe_com_apartment FAIL [stats total_elapsed_us] expected=505 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_com_apartment FAIL [stats count_apt_sta] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_com_apartment FAIL [stats count_msg_cross] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_com_apartment_stats",
        "\"dispatch_count\":" + to_string(s[0])
        + ",\"total_elapsed_us\":" + to_string(s[1])
        + ",\"count_apt_sta\":" + to_string(s[2])
        + ",\"count_msg_cross\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_com_apartment FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pca()
    let s2 = pca_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_com_apartment FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_com_apartment self_test PASS (dispatches=" + to_string(s[0])
        + ", elapsed_us=" + to_string(s[1]) + ", sta=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pca_stats()
            println("dispatch_count\t" + to_string(s[0]))
            println("total_elapsed_us\t" + to_string(s[1]))
            println("count_apt_sta\t" + to_string(s[2]))
            println("count_msg_cross\t" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("dispatch_elapsed_us\t" + to_string(dispatch_elapsed_us(did)))
                return
            }
            println("usage: hexa run pe_com_apartment.hexa elapsed <dispatch_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let bucket = a[3]
                let kind = to_int(a[4])
                if bucket == "apt" {
                    println("count_by_apartment\t" + to_string(count_by_apartment(kind)))
                    return
                }
                if bucket == "msg" {
                    println("count_by_msg_kind\t" + to_string(count_by_msg_kind(kind)))
                    return
                }
            }
            println("usage: hexa run pe_com_apartment.hexa count { apt <apartment_kind> | msg <msg_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pca()
            println("cleaned: " + pca_dir())
            return
        }
        if sub == "dir" {
            println(pca_dir())
            return
        }
    }
    println("usage: hexa run pe_com_apartment.hexa { self-test | stats | elapsed <dispatch_id> | count apt <apartment_kind> | count msg <msg_kind> | cleanup | dir }")
}
