// lib/loader/pe_module_dependency_graph.hexa — 모듈 간 cross-reference / dependency graph 추적기
//
// REMAINING_ROADMAP_V2 의 의존성 그래프 (R1 → R2 → R3 → R6 chain) 를 데이터 구조로 표현.
// graph 시각화는 별도 (graphviz) — 본 모듈은 raw edge 추적만.
// own1: 자체 graph — third-party graph DB 인용 X.
//
// own 1 enforcement: Wine / CrossOver / community / GPTK / Whisky 0 줄 — 본 모듈은
//   edge tracker 일 뿐, 실 외부 의존성 link X.
// own 2 mandate: r0_emit ≥ 8 + self_test() + main() dispatch + headless safe + panic 형식.
//
// dependency_kind code:
//   1 = prereq           (선행 의존: source 가 완료되어야 target 진행)
//   2 = cross_ref        (상호 참조: 양방향 hint)
//   3 = alternative      (대체 경로: source 미완 시 target 으로 우회)
//   4 = test_dependency  (test 단계 의존: source self_test 가 target 의 fixture)
//   5 = docs_reference   (문서 상호 인용: roadmap / phase status 인용)
//
// persist schema (TSV — edges.tsv):
//   edge_id<str> \t source_module_id<str> \t target_module_id<str> \t dependency_kind<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmdg_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_module_dependency_graph"
}

fn pmdg_edges_path() -> str {
    return pmdg_dir() + "/edges.tsv"
}

fn pmdg_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmdg_dir() + "'")
}

fn cleanup_pmdg() -> void {
    pmdg_ensure_dir()
    let _ = exec("rm -f '" + pmdg_edges_path() + "'")
}

// ─── 공통 file IO ───
fn pmdg_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmdg_append_row(path: str, row: str) -> void {
    pmdg_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_edge: edge 1 건 기록 ───
fn record_edge(edge_id: str, source_module_id: str, target_module_id: str, dependency_kind: int) -> void {
    if edge_id == "" {
        panic("pe_module_dependency_graph FAIL [record_edge] expected=edge_id!=\"\" got=\"\"")
    }
    if source_module_id == "" {
        panic("pe_module_dependency_graph FAIL [record_edge] expected=source_module_id!=\"\" got=\"\"")
    }
    if target_module_id == "" {
        panic("pe_module_dependency_graph FAIL [record_edge] expected=target_module_id!=\"\" got=\"\"")
    }
    if dependency_kind < 1 {
        panic("pe_module_dependency_graph FAIL [record_edge] expected=dependency_kind>=1 got=" + to_string(dependency_kind))
    }
    if dependency_kind > 5 {
        panic("pe_module_dependency_graph FAIL [record_edge] expected=dependency_kind<=5 got=" + to_string(dependency_kind))
    }
    let row = edge_id + "\t" + source_module_id + "\t" + target_module_id
        + "\t" + to_string(dependency_kind) + "\n"
    pmdg_append_row(pmdg_edges_path(), row)
}

// ─── edge_count: total edge 수 ───
fn edge_count() -> int {
    let t = pmdg_read_table(pmdg_edges_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_dependency_kind: 특정 dependency_kind 의 edge 수 ───
fn count_by_dependency_kind(dependency_kind: int) -> int {
    let t = pmdg_read_table(pmdg_edges_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == dependency_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── prereq_count: dependency_kind=1 ───
fn prereq_count() -> int {
    return count_by_dependency_kind(1)
}

// ─── cross_ref_count: dependency_kind=2 ───
fn cross_ref_count() -> int {
    return count_by_dependency_kind(2)
}

// ─── outgoing_edges: source_module_id 가 일치하는 edge 수 (fan-out) ───
fn outgoing_edges(source: str) -> int {
    let t = pmdg_read_table(pmdg_edges_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[1] == source {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── edge_target: edge_id 의 target_module_id lookup ───
fn edge_target(edge_id: str) -> str {
    let t = pmdg_read_table(pmdg_edges_path())
    if t == "" {
        return ""
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == edge_id {
                    return parts[2]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── pmdg_stats: [edge_count, prereq_count, cross_ref_count] ───
fn pmdg_stats() -> array {
    let mut out = []
    out.push(edge_count())
    out.push(prereq_count())
    out.push(cross_ref_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pmdg-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pmdg()

    // 2. record 7 edges — covers all 5 dependency_kinds
    //    chain: R1 → R2 → R3 → R6 (prereq) + cross_ref + alternative + test + docs

    // E1: R1 → R2 (prereq)
    record_edge("e_r1_r2", "remaining_r1_native_helper", "remaining_r2_codesign", 1)
    r0_emit("pe_module_dependency_graph_record",
        "\"edge_id\":\"e_r1_r2\",\"source\":\"remaining_r1_native_helper\",\"target\":\"remaining_r2_codesign\",\"dependency_kind\":1")

    // E2: R2 → R3 (prereq)
    record_edge("e_r2_r3", "remaining_r2_codesign", "remaining_r3_d3dmetal", 1)
    r0_emit("pe_module_dependency_graph_record",
        "\"edge_id\":\"e_r2_r3\",\"source\":\"remaining_r2_codesign\",\"target\":\"remaining_r3_d3dmetal\",\"dependency_kind\":1")

    // E3: R3 → R6 (prereq)
    record_edge("e_r3_r6", "remaining_r3_d3dmetal", "remaining_r6_anti_cheat", 1)
    r0_emit("pe_module_dependency_graph_record",
        "\"edge_id\":\"e_r3_r6\",\"source\":\"remaining_r3_d3dmetal\",\"target\":\"remaining_r6_anti_cheat\",\"dependency_kind\":1")

    // E4: R1 ↔ R2 (cross_ref)
    record_edge("e_r1_r2_xref", "remaining_r1_native_helper", "remaining_r2_codesign", 2)
    r0_emit("pe_module_dependency_graph_record",
        "\"edge_id\":\"e_r1_r2_xref\",\"source\":\"remaining_r1_native_helper\",\"target\":\"remaining_r2_codesign\",\"dependency_kind\":2")

    // E5: R3 → R3_alt (alternative — D3DMetal 우회)
    record_edge("e_r3_alt", "remaining_r3_d3dmetal", "remaining_r3_software_renderer", 3)
    r0_emit("pe_module_dependency_graph_record",
        "\"edge_id\":\"e_r3_alt\",\"source\":\"remaining_r3_d3dmetal\",\"target\":\"remaining_r3_software_renderer\",\"dependency_kind\":3")

    // E6: R6 → R6_test (test_dependency)
    record_edge("e_r6_test", "remaining_r6_anti_cheat", "remaining_r6_test_fixture", 4)
    r0_emit("pe_module_dependency_graph_record",
        "\"edge_id\":\"e_r6_test\",\"source\":\"remaining_r6_anti_cheat\",\"target\":\"remaining_r6_test_fixture\",\"dependency_kind\":4")

    // E7: R1 → roadmap_doc (docs_reference)
    record_edge("e_r1_docs", "remaining_r1_native_helper", "remaining_roadmap_v2_doc", 5)
    r0_emit("pe_module_dependency_graph_record",
        "\"edge_id\":\"e_r1_docs\",\"source\":\"remaining_r1_native_helper\",\"target\":\"remaining_roadmap_v2_doc\",\"dependency_kind\":5")

    // 3. edge_count = 7
    let ec = edge_count()
    if ec != 7 {
        panic("pe_module_dependency_graph FAIL [edge_count] expected=7 got=" + to_string(ec))
    }

    // 4. count_by_dependency_kind sanity (all 5 dependency_kinds present)
    let d1 = count_by_dependency_kind(1)
    if d1 != 3 {
        panic("pe_module_dependency_graph FAIL [count_by_dependency_kind(1)] expected=3 got=" + to_string(d1))
    }
    let d2 = count_by_dependency_kind(2)
    if d2 != 1 {
        panic("pe_module_dependency_graph FAIL [count_by_dependency_kind(2)] expected=1 got=" + to_string(d2))
    }
    let d3 = count_by_dependency_kind(3)
    if d3 != 1 {
        panic("pe_module_dependency_graph FAIL [count_by_dependency_kind(3)] expected=1 got=" + to_string(d3))
    }
    let d4 = count_by_dependency_kind(4)
    if d4 != 1 {
        panic("pe_module_dependency_graph FAIL [count_by_dependency_kind(4)] expected=1 got=" + to_string(d4))
    }
    let d5 = count_by_dependency_kind(5)
    if d5 != 1 {
        panic("pe_module_dependency_graph FAIL [count_by_dependency_kind(5)] expected=1 got=" + to_string(d5))
    }
    let d_miss = count_by_dependency_kind(99)
    if d_miss != 0 {
        panic("pe_module_dependency_graph FAIL [count_by_dependency_kind(99)] expected=0 got=" + to_string(d_miss))
    }

    // 5. prereq_count = 3, cross_ref_count = 1
    let pc = prereq_count()
    if pc != 3 {
        panic("pe_module_dependency_graph FAIL [prereq_count] expected=3 got=" + to_string(pc))
    }
    let xc = cross_ref_count()
    if xc != 1 {
        panic("pe_module_dependency_graph FAIL [cross_ref_count] expected=1 got=" + to_string(xc))
    }

    // 6. outgoing_edges("remaining_r1_native_helper") = 3 (E1, E4, E7)
    let oe_r1 = outgoing_edges("remaining_r1_native_helper")
    if oe_r1 != 3 {
        panic("pe_module_dependency_graph FAIL [outgoing_edges(r1)] expected=3 got=" + to_string(oe_r1))
    }
    // outgoing_edges("remaining_r3_d3dmetal") = 2 (E3, E5)
    let oe_r3 = outgoing_edges("remaining_r3_d3dmetal")
    if oe_r3 != 2 {
        panic("pe_module_dependency_graph FAIL [outgoing_edges(r3)] expected=2 got=" + to_string(oe_r3))
    }
    // outgoing_edges("nonexistent") = 0
    let oe_miss = outgoing_edges("nonexistent_module")
    if oe_miss != 0 {
        panic("pe_module_dependency_graph FAIL [outgoing_edges(miss)] expected=0 got=" + to_string(oe_miss))
    }

    // 7. edge_target lookup
    let et1 = edge_target("e_r1_r2")
    if et1 != "remaining_r2_codesign" {
        panic("pe_module_dependency_graph FAIL [edge_target(e_r1_r2)] expected=remaining_r2_codesign got=" + et1)
    }
    let et_miss = edge_target("nonexistent_edge")
    if et_miss != "" {
        panic("pe_module_dependency_graph FAIL [edge_target(miss)] expected=\"\" got=" + et_miss)
    }

    // 8. pmdg_stats() = [7, 3, 1]
    let s = pmdg_stats()
    if len(s) != 3 {
        panic("pe_module_dependency_graph FAIL [stats len] expected=3 got=" + to_string(len(s)))
    }
    if s[0] != 7 {
        panic("pe_module_dependency_graph FAIL [stats edge_count] expected=7 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_module_dependency_graph FAIL [stats prereq] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_module_dependency_graph FAIL [stats cross_ref] expected=1 got=" + to_string(s[2]))
    }

    // 9. emit aggregate stats
    r0_emit("pe_module_dependency_graph_stats",
        "\"edge_count\":" + to_string(s[0])
        + ",\"prereq_count\":" + to_string(s[1])
        + ",\"cross_ref_count\":" + to_string(s[2]))

    // 10. emit count >= 8 (7 records + 1 stats = 8)
    let emit_n = r0_session_count(sid)
    if emit_n < 8 {
        panic("pe_module_dependency_graph FAIL [r0 emit count] expected=>=8 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pmdg()
    let s2 = pmdg_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_module_dependency_graph FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_module_dependency_graph self_test PASS (edges=" + to_string(s[0])
        + ", prereq=" + to_string(s[1]) + ", cross_ref=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmdg_stats()
            println("edge_count\t" + to_string(s[0]))
            println("prereq_count\t" + to_string(s[1]))
            println("cross_ref_count\t" + to_string(s[2]))
            return
        }
        if sub == "target" {
            if len(a) >= 4 {
                let eid = a[3]
                let t = edge_target(eid)
                if t == "" {
                    println("target\t")
                    return
                }
                println("target\t" + t)
                return
            }
            println("usage: hexa run pe_module_dependency_graph.hexa target <edge_id>")
            return
        }
        if sub == "outgoing" {
            if len(a) >= 4 {
                let src = a[3]
                println("outgoing_edges\t" + to_string(outgoing_edges(src)))
                return
            }
            println("usage: hexa run pe_module_dependency_graph.hexa outgoing <source_module_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let val = to_int(a[3])
                println("count_by_dependency_kind\t" + to_string(count_by_dependency_kind(val)))
                return
            }
            println("usage: hexa run pe_module_dependency_graph.hexa count <dependency_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmdg()
            println("cleaned: " + pmdg_dir())
            return
        }
        if sub == "dir" {
            println(pmdg_dir())
            return
        }
    }
    println("usage: hexa run pe_module_dependency_graph.hexa { self-test | stats | target <edge_id> | outgoing <source_module_id> | count <dependency_kind> | cleanup | dir }")
}
