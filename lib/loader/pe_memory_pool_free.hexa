// lib/loader/pe_memory_pool_free.hexa — cycle66 memory pool free-list tracker skeleton
//
// PE loader / runtime 의 memory pool 에서 해제(free) 된 영역을 추적한다.
// pool 별 누적 해제 byte, 인접 free block 의 coalesce 발생 횟수를 기록 — 추후
// fragmentation 분석 / GC 정책 튜닝 input.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 free event tracker — 실 free() / VirtualFree() 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// coalesced flag:
//   0 = standalone free (인접 block 없음)
//   1 = 인접 free block 과 합쳐짐
//
// persist schema (TSV — frees.tsv):
//   free_id<int> \t pool_id<int> \t size_bytes<int> \t coalesced<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmpf_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_memory_pool_free"
}

fn pmpf_frees_path() -> str {
    return pmpf_dir() + "/frees.tsv"
}

fn pmpf_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmpf_dir() + "'")
}

fn cleanup_pmpf() -> void {
    pmpf_ensure_dir()
    let _ = exec("rm -f '" + pmpf_frees_path() + "'")
}

// ─── 공통 file IO ───
fn pmpf_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmpf_append_row(path: str, row: str) -> void {
    pmpf_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_free: free event 1 건 기록 ───
fn record_free(free_id: int, pool_id: int, size_bytes: int, coalesced: int) -> void {
    if free_id <= 0 {
        panic("pe_memory_pool_free FAIL [record_free] expected=free_id>0 got=" + to_string(free_id))
    }
    if pool_id <= 0 {
        panic("pe_memory_pool_free FAIL [record_free] expected=pool_id>0 got=" + to_string(pool_id))
    }
    if size_bytes < 0 {
        panic("pe_memory_pool_free FAIL [record_free] expected=size_bytes>=0 got=" + to_string(size_bytes))
    }
    if coalesced < 0 {
        panic("pe_memory_pool_free FAIL [record_free] expected=coalesced>=0 got=" + to_string(coalesced))
    }
    if coalesced > 1 {
        panic("pe_memory_pool_free FAIL [record_free] expected=coalesced<=1 got=" + to_string(coalesced))
    }
    let row = to_string(free_id) + "\t" + to_string(pool_id)
        + "\t" + to_string(size_bytes) + "\t" + to_string(coalesced) + "\n"
    pmpf_append_row(pmpf_frees_path(), row)
}

// ─── free_count: total free event 수 ───
fn free_count() -> int {
    let t = pmpf_read_table(pmpf_frees_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_freed_bytes: 모든 free size_bytes 합 ───
fn total_freed_bytes() -> int {
    let t = pmpf_read_table(pmpf_frees_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── coalesced_count: coalesced=1 인 free 수 ───
fn coalesced_count() -> int {
    let t = pmpf_read_table(pmpf_frees_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_pool: 특정 pool_id 의 free 수 ───
fn count_by_pool(pool_id: int) -> int {
    let t = pmpf_read_table(pmpf_frees_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == pool_id {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── free_size: 특정 free_id 의 size_bytes (없으면 0) ───
fn free_size(free_id: int) -> int {
    let t = pmpf_read_table(pmpf_frees_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == free_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pmpf_stats: [free_count, total_freed_bytes, coalesced_count, count_by_pool(1)] ───
fn pmpf_stats() -> array {
    let mut out = []
    out.push(free_count())
    out.push(total_freed_bytes())
    out.push(coalesced_count())
    out.push(count_by_pool(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pmpf-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pmpf()

    // 2. record 5 frees across 2 pools (pool 1: 3 frees, pool 2: 2 frees)
    //    coalesced: free_id 660002, 660004 → coalesced_count = 2
    record_free(660001, 1, 64, 0)
    r0_emit("pe_memory_pool_free_record",
        "\"free_id\":660001,\"pool_id\":1,\"size_bytes\":64,\"coalesced\":0")

    record_free(660002, 1, 128, 1)
    r0_emit("pe_memory_pool_free_record",
        "\"free_id\":660002,\"pool_id\":1,\"size_bytes\":128,\"coalesced\":1")

    record_free(660003, 2, 256, 0)
    r0_emit("pe_memory_pool_free_record",
        "\"free_id\":660003,\"pool_id\":2,\"size_bytes\":256,\"coalesced\":0")

    record_free(660004, 2, 512, 1)
    r0_emit("pe_memory_pool_free_record",
        "\"free_id\":660004,\"pool_id\":2,\"size_bytes\":512,\"coalesced\":1")

    record_free(660005, 1, 32, 0)
    r0_emit("pe_memory_pool_free_record",
        "\"free_id\":660005,\"pool_id\":1,\"size_bytes\":32,\"coalesced\":0")

    // 3. free_count = 5
    let c = free_count()
    if c != 5 {
        panic("pe_memory_pool_free FAIL [free_count] expected=5 got=" + to_string(c))
    }

    // 4. total_freed_bytes = 64+128+256+512+32 = 992
    let tb = total_freed_bytes()
    if tb != 992 {
        panic("pe_memory_pool_free FAIL [total_freed_bytes] expected=992 got=" + to_string(tb))
    }

    // 5. coalesced_count = 2
    let cc = coalesced_count()
    if cc != 2 {
        panic("pe_memory_pool_free FAIL [coalesced_count] expected=2 got=" + to_string(cc))
    }

    // 6. count_by_pool sanity
    let p1 = count_by_pool(1)
    if p1 != 3 {
        panic("pe_memory_pool_free FAIL [count_by_pool(1)] expected=3 got=" + to_string(p1))
    }
    let p2 = count_by_pool(2)
    if p2 != 2 {
        panic("pe_memory_pool_free FAIL [count_by_pool(2)] expected=2 got=" + to_string(p2))
    }
    let p99 = count_by_pool(99)
    if p99 != 0 {
        panic("pe_memory_pool_free FAIL [count_by_pool(99)] expected=0 got=" + to_string(p99))
    }

    // 7. free_size sanity
    let s2 = free_size(660002)
    if s2 != 128 {
        panic("pe_memory_pool_free FAIL [free_size(660002)] expected=128 got=" + to_string(s2))
    }
    let s4 = free_size(660004)
    if s4 != 512 {
        panic("pe_memory_pool_free FAIL [free_size(660004)] expected=512 got=" + to_string(s4))
    }
    let s_miss = free_size(9999)
    if s_miss != 0 {
        panic("pe_memory_pool_free FAIL [free_size(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 8. pmpf_stats() = [5, 992, 2, 3]
    let st = pmpf_stats()
    if len(st) != 4 {
        panic("pe_memory_pool_free FAIL [stats len] expected=4 got=" + to_string(len(st)))
    }
    if st[0] != 5 {
        panic("pe_memory_pool_free FAIL [stats free_count] expected=5 got=" + to_string(st[0]))
    }
    if st[1] != 992 {
        panic("pe_memory_pool_free FAIL [stats total_freed_bytes] expected=992 got=" + to_string(st[1]))
    }
    if st[2] != 2 {
        panic("pe_memory_pool_free FAIL [stats coalesced_count] expected=2 got=" + to_string(st[2]))
    }
    if st[3] != 3 {
        panic("pe_memory_pool_free FAIL [stats count_pool(1)] expected=3 got=" + to_string(st[3]))
    }

    // 9. emit stats
    r0_emit("pe_memory_pool_free_stats",
        "\"free_count\":" + to_string(st[0])
        + ",\"total_freed_bytes\":" + to_string(st[1])
        + ",\"coalesced_count\":" + to_string(st[2])
        + ",\"pool1_count\":" + to_string(st[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_memory_pool_free FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pmpf()
    let st2 = pmpf_stats()
    let i = 0
    while i < len(st2) {
        if st2[i] != 0 {
            panic("pe_memory_pool_free FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(st2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_memory_pool_free self_test PASS (frees=" + to_string(st[0])
        + ", bytes=" + to_string(st[1]) + ", coalesced=" + to_string(st[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmpf_stats()
            println("free_count\t" + to_string(s[0]))
            println("total_freed_bytes\t" + to_string(s[1]))
            println("coalesced_count\t" + to_string(s[2]))
            println("count_pool_1\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let fid = to_int(a[3])
                println("free_size\t" + to_string(free_size(fid)))
                return
            }
            println("usage: hexa run pe_memory_pool_free.hexa size <free_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                println("count_by_pool\t" + to_string(count_by_pool(pid)))
                return
            }
            println("usage: hexa run pe_memory_pool_free.hexa count <pool_id>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmpf()
            println("cleaned: " + pmpf_dir())
            return
        }
        if sub == "dir" {
            println(pmpf_dir())
            return
        }
    }
    println("usage: hexa run pe_memory_pool_free.hexa { self-test | stats | size <free_id> | count <pool_id> | cleanup | dir }")
}
