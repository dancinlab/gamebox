fn RegCreateKeyExA(key: int, sub: int, rsv: int, cls: int, opts: int, access: int, sa: int, out: int, disp: int) -> int { return 0 }
fn RegDeleteValueA(key: int, name: int) -> int { return 0 }
fn RegisterEventSourceA(server: int, src: int) -> int { return 1 }
