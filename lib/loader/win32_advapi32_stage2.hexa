fn CryptReleaseContext(prov: int, flags: int) -> int { return 1 }
fn CryptSetHashParam(hash: int, param: int, data: int, flags: int) -> int { return 1 }
fn CryptSignHashA(hash: int, spec: int, desc: int, flags: int, sig: int, slen: int) -> int { return 1 }
fn DeregisterEventSource(src: int) -> int { return 1 }
fn DuplicateToken(src: int, level: int, dst: int) -> int { return 1 }
fn DuplicateTokenEx(src: int, access: int, sa: int, level: int, kind: int, dst: int) -> int { return 1 }
fn GetFileSecurityW(name: int, info: int, sd: int, sz: int, need: int) -> int { return 1 }
fn GetNamedSecurityInfoW(name: int, kind: int, info: int, owner: int, group: int, dacl: int, sacl: int, sd: int) -> int { return 0 }
