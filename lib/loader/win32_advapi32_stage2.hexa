// lib/loader/win32_advapi32_stage2.hexa — Battle.net Setup ADVAPI32 imports coverage
//
// Battle.net 의 registry / cert / service / token 함수. RegOpenKeyEx,
// RegQueryValueEx, OpenSCManager, OpenProcessToken 등. stage1 base 위에 추가.
//
// own 1: only `use "../perf/r0_common"` (POSIX equivalent — Wine 0 줄).
// own 2: fn self_test() + main() dispatch, headless,
//        panic("win32_advapi32_stage2 FAIL [<sub>] expected=X got=Y").
//
// Coverage matrix (Battle.net ~53 ADVAPI32 imports):
//   stage1 covers : GetTokenInformation OpenProcessToken AdjustTokenPrivileges
//                   CryptAcquireContextW CryptCreateHash CryptHashData
//                   CryptGetHashParam CryptDestroyHash
//                   RegOpenKeyExW RegQueryValueExW RegSetValueExW RegCloseKey
//                   RegGetValueW                                                  (13)
//   stage2 stubs  : 40 missing imports below (typed defaults).
//
// Return value convention:
//   HANDLE / SC_HANDLE / HKEY     → 1   (fake non-null)
//   BOOL                          → 1   (TRUE)
//   LONG / HRESULT / DWORD        → 0   (ERROR_SUCCESS)
//   void                          → 0   (no return semantic)
//
// 모든 stub 은 parameter 를 int 로 받음 — pointer 도 stage2 simulation 에선 단순 word.
// 예약어 회피: type→kind, mod→hmod, handle→hnd, resume→wake.

use "../perf/r0_common"

// ─── stage2 stubs (40 functions, alphabetical) ───

fn AccessCheck(sd: int, tok: int, access: int, mapping: int, ps: int, pssz: int, granted: int, status: int) -> int { return 1 }
fn AllocateAndInitializeSid(auth: int, count: int, s0: int, s1: int, s2: int, s3: int, s4: int, s5: int, s6: int, s7: int, sid: int) -> int { return 1 }
fn BuildTrusteeWithSidW(trustee: int, sid: int) -> int { return 0 }
fn ConvertSecurityDescriptorToStringSecurityDescriptorW(sd: int, rev: int, info: int, str: int, sz: int) -> int { return 1 }
