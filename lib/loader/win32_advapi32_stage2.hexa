fn CryptDestroyKey(key: int) -> int { return 1 }
fn CryptEncrypt(key: int, hash: int, final: int, flags: int, data: int, dlen: int, dsz: int) -> int { return 1 }
fn CryptEnumProvidersA(idx: int, rsv: int, flags: int, kind: int, name: int, nsz: int) -> int { return 1 }
fn CryptExportKey(key: int, exp: int, blob: int, flags: int, data: int, dlen: int) -> int { return 1 }
fn CryptGenRandom(prov: int, len: int, buf: int) -> int { return 1 }
