// lib/loader/pe_dungeon_fighter_track.hexa — Dungeon & Fighter (던파) 전용 entry/loader 추적.
//
// Dungeon & Fighter (Nexon, 던파) 는 2D 액션 MMORPG 로 Neople 자체 엔진 + DX9 로 build.
// 런처 chain (own2 자체 추적):
//   process_attach     — DnFRunner.exe entry, NT TLS_CALLBACK array fire
//   neople_engine_init — Neople custom 2D engine bootstrap (sprite/animation/scene mgr)
//   gameguard_init     — nProtect GameGuard kernel driver attach + anti-cheat IPC
//   login              — 계정 인증 (Nexon Passport / Channel-1 auth)
//   channel_select     — 채널 선택 (서버 부하 분산)
//   character_select   — 캐릭터 선택 (직업 sprite preload)
//   town_load          — 마을 진입 (Sprite atlas + DX9 device init)
//   first_frame        — DX9 Present 첫 호출
// own1: 던파 공개 정보 + binary observation 만. Wine wrapper / community fix 인용 X
//
// own 1 enforcement: 타사 Wine/CrossOver/community 코드 0 줄.
//   본 module 은 Dungeon & Fighter phase tracker — 실 DnFRunner.exe 실행 X.
//   nProtect GameGuard 는 kernel driver → Apple Silicon Hypervisor 에서 차단됨.
//   따라서 skeleton-only — phase 추적 schema 만 정의, 실 anti-cheat bypass X.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = process_attach     (DnFRunner.exe entry + TLS_CALLBACK)
//   2 = neople_engine_init (Neople custom 2D engine bootstrap)
//   3 = gameguard_init     (nProtect GameGuard driver attach)
//   4 = login              (Nexon Passport auth)
//   5 = channel_select     (server channel pick)
//   6 = character_select   (character class sprite preload)
//   7 = town_load          (town sprite atlas + DX9 device)
//   8 = first_frame        (DX9 Present first call)
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t dll_loaded<int> \t gameguard_active<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdfgt_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dungeon_fighter_track"
}

fn pdfgt_steps_path() -> str {
    return pdfgt_dir() + "/steps.tsv"
}

fn pdfgt_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdfgt_dir() + "'")
}

fn cleanup_pdfgt() -> void {
    pdfgt_ensure_dir()
    let _ = exec("rm -f '" + pdfgt_steps_path() + "'")
}

// ─── 공통 file IO ───
fn pdfgt_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdfgt_append_row(path: str, row: str) -> void {
    pdfgt_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_step: 던파 launch step 1 건 기록 ───
fn record_step(step_id: int, phase_kind: int, dll_loaded: int, gameguard_active: int) -> void {
    if step_id <= 0 {
        panic("pe_dungeon_fighter_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_dungeon_fighter_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 8 {
        panic("pe_dungeon_fighter_track FAIL [record_step] expected=phase_kind<=8 got=" + to_string(phase_kind))
    }
    if dll_loaded < 0 {
        panic("pe_dungeon_fighter_track FAIL [record_step] expected=dll_loaded>=0 got=" + to_string(dll_loaded))
    }
    if dll_loaded > 1 {
        panic("pe_dungeon_fighter_track FAIL [record_step] expected=dll_loaded<=1 got=" + to_string(dll_loaded))
    }
    if gameguard_active < 0 {
        panic("pe_dungeon_fighter_track FAIL [record_step] expected=gameguard_active>=0 got=" + to_string(gameguard_active))
    }
    if gameguard_active > 1 {
        panic("pe_dungeon_fighter_track FAIL [record_step] expected=gameguard_active<=1 got=" + to_string(gameguard_active))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(dll_loaded) + "\t" + to_string(gameguard_active) + "\n"
    pdfgt_append_row(pdfgt_steps_path(), row)
}

// ─── step_count: total step 수 ───
fn step_count() -> int {
    let t = pdfgt_read_table(pdfgt_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 step 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = pdfgt_read_table(pdfgt_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── loaded_count: dll_loaded=1 인 step 수 ───
fn loaded_count() -> int {
    let t = pdfgt_read_table(pdfgt_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── gameguard_active_count: gameguard_active=1 인 step 수 ───
fn gameguard_active_count() -> int {
    let t = pdfgt_read_table(pdfgt_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── town_load_count: phase_kind=7 step 수 (≥1 이면 town 도달) ───
fn town_load_count() -> int {
    return count_by_phase_kind(7)
}

// ─── step_dll_loaded: 특정 step_id 의 dll_loaded (없으면 0) ───
fn step_dll_loaded(step_id: int) -> int {
    let t = pdfgt_read_table(pdfgt_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdfgt_stats: [step_count, loaded_count, gameguard_active_count, town_load_count, count_by_phase_kind(3)] ───
fn pdfgt_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(loaded_count())
    out.push(gameguard_active_count())
    out.push(town_load_count())
    out.push(count_by_phase_kind(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdfgt-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdfgt()

    // 2. record 8 steps — 던파 launch chain 전체, phase_kind 1..8 각 1건
    //   id 140001: phase 1 process_attach     dll=0 gg=0  (DnFRunner.exe entry, TLS_CALLBACK)
    //   id 140002: phase 2 neople_engine_init dll=1 gg=0  (Neople custom 2D engine)
    //   id 140003: phase 3 gameguard_init     dll=1 gg=1  (nProtect GameGuard kernel driver)
    //   id 140004: phase 4 login              dll=0 gg=1  (Nexon Passport auth)
    //   id 140005: phase 5 channel_select     dll=0 gg=1  (server channel pick)
    //   id 140006: phase 6 character_select   dll=1 gg=1  (class sprite preload)
    //   id 140007: phase 7 town_load          dll=1 gg=1  (town sprite atlas + DX9 device)
    //   id 140008: phase 8 first_frame        dll=0 gg=1  (DX9 Present first)
    //   sums: steps=8, loaded=4, gameguard_active=6, town_load=1, count_kind(3)=1
    record_step(140001, 1, 0, 0)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140001,\"phase_kind\":1,\"dll_loaded\":0,\"gameguard_active\":0,\"target\":\"process_attach\"")

    record_step(140002, 2, 1, 0)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140002,\"phase_kind\":2,\"dll_loaded\":1,\"gameguard_active\":0,\"target\":\"neople_engine_init\"")

    record_step(140003, 3, 1, 1)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140003,\"phase_kind\":3,\"dll_loaded\":1,\"gameguard_active\":1,\"target\":\"gameguard_init\"")

    record_step(140004, 4, 0, 1)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140004,\"phase_kind\":4,\"dll_loaded\":0,\"gameguard_active\":1,\"target\":\"login\"")

    record_step(140005, 5, 0, 1)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140005,\"phase_kind\":5,\"dll_loaded\":0,\"gameguard_active\":1,\"target\":\"channel_select\"")

    record_step(140006, 6, 1, 1)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140006,\"phase_kind\":6,\"dll_loaded\":1,\"gameguard_active\":1,\"target\":\"character_select\"")

    record_step(140007, 7, 1, 1)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140007,\"phase_kind\":7,\"dll_loaded\":1,\"gameguard_active\":1,\"target\":\"town_load\"")

    record_step(140008, 8, 0, 1)
    r0_emit("pe_dungeon_fighter_track_record",
        "\"step_id\":140008,\"phase_kind\":8,\"dll_loaded\":0,\"gameguard_active\":1,\"target\":\"first_frame\"")

    // 3. step_count = 8
    let c = step_count()
    if c != 8 {
        panic("pe_dungeon_fighter_track FAIL [step_count] expected=8 got=" + to_string(c))
    }

    // 4. count_by_phase_kind sanity — 1..8 각 1건, 99 = 0
    let p1 = count_by_phase_kind(1)
    if p1 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p6 = count_by_phase_kind(6)
    if p6 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(p6))
    }
    let p7 = count_by_phase_kind(7)
    if p7 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(7)] expected=1 got=" + to_string(p7))
    }
    let p8 = count_by_phase_kind(8)
    if p8 != 1 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(8)] expected=1 got=" + to_string(p8))
    }
    let p99 = count_by_phase_kind(99)
    if p99 != 0 {
        panic("pe_dungeon_fighter_track FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p99))
    }

    // 5. loaded_count = 4 (140002, 140003, 140006, 140007)
    let lc = loaded_count()
    if lc != 4 {
        panic("pe_dungeon_fighter_track FAIL [loaded_count] expected=4 got=" + to_string(lc))
    }

    // 6. gameguard_active_count = 6 (140003..140008)
    let gc = gameguard_active_count()
    if gc != 6 {
        panic("pe_dungeon_fighter_track FAIL [gameguard_active_count] expected=6 got=" + to_string(gc))
    }
    if gc < 3 {
        panic("pe_dungeon_fighter_track FAIL [gameguard_active>=3] got=" + to_string(gc))
    }

    // 7. town_load_count = 1
    let tl = town_load_count()
    if tl != 1 {
        panic("pe_dungeon_fighter_track FAIL [town_load_count] expected=1 got=" + to_string(tl))
    }

    // 8. step_dll_loaded sanity
    let d2 = step_dll_loaded(140002)
    if d2 != 1 {
        panic("pe_dungeon_fighter_track FAIL [step_dll_loaded(140002)] expected=1 got=" + to_string(d2))
    }
    let d4 = step_dll_loaded(140004)
    if d4 != 0 {
        panic("pe_dungeon_fighter_track FAIL [step_dll_loaded(140004)] expected=0 got=" + to_string(d4))
    }
    let d_miss = step_dll_loaded(9999)
    if d_miss != 0 {
        panic("pe_dungeon_fighter_track FAIL [step_dll_loaded(9999)] expected=0 got=" + to_string(d_miss))
    }

    // 9. pdfgt_stats() = [8, 4, 6, 1, 1]
    let s = pdfgt_stats()
    if len(s) != 5 {
        panic("pe_dungeon_fighter_track FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_dungeon_fighter_track FAIL [stats step_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_dungeon_fighter_track FAIL [stats loaded_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 6 {
        panic("pe_dungeon_fighter_track FAIL [stats gameguard_active_count] expected=6 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_dungeon_fighter_track FAIL [stats town_load_count] expected=1 got=" + to_string(s[3]))
    }
    if s[4] != 1 {
        panic("pe_dungeon_fighter_track FAIL [stats count_gameguard_init] expected=1 got=" + to_string(s[4]))
    }

    // 10. emit stats
    r0_emit("pe_dungeon_fighter_track_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"loaded_count\":" + to_string(s[1])
        + ",\"gameguard_active_count\":" + to_string(s[2])
        + ",\"town_load_count\":" + to_string(s[3])
        + ",\"count_gameguard_init\":" + to_string(s[4]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_dungeon_fighter_track FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdfgt()
    let s2 = pdfgt_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dungeon_fighter_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dungeon_fighter_track self_test PASS (steps=" + to_string(s[0])
        + ", loaded=" + to_string(s[1]) + ", gameguard_active=" + to_string(s[2])
        + ", town_load=" + to_string(s[3]) + ", gameguard_init=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdfgt_stats()
            println("step_count\t" + to_string(s[0]))
            println("loaded_count\t" + to_string(s[1]))
            println("gameguard_active_count\t" + to_string(s[2]))
            println("town_load_count\t" + to_string(s[3]))
            println("count_gameguard_init\t" + to_string(s[4]))
            return
        }
        if sub == "loaded" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_dll_loaded\t" + to_string(step_dll_loaded(sid)))
                return
            }
            println("usage: hexa run pe_dungeon_fighter_track.hexa loaded <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_dungeon_fighter_track.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdfgt()
            println("cleaned: " + pdfgt_dir())
            return
        }
        if sub == "dir" {
            println(pdfgt_dir())
            return
        }
    }
    println("usage: hexa run pe_dungeon_fighter_track.hexa { self-test | stats | loaded <step_id> | count <phase_kind> | cleanup | dir }")
}
