// lib/loader/pe_ipc_message_dispatch.hexa — stage5 IPC message dispatch skeleton
//
// IPC message 받으면 method_id 추출 → handler function dispatch. Win32 API
// 별 routing (LoadLibrary → dlopen wrapper, etc.). cycle 63 wrappers 가
// handler.

use "../perf/r0_common"

let PIMD_DIR = GAMEBOX_HOME + "/persist/pe_ipc_message_dispatch"
let PIMD_TABLE = PIMD_DIR + "/dispatch.tsv"

fn pimd_dir() -> str { return PIMD_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + PIMD_DIR + "'")
}

fn append_row(row: str) -> void {
    ensure_dir()
    let tmp = PIMD_TABLE + ".tmp"
    write_file(tmp, row + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PIMD_TABLE + "' && rm -f '" + tmp + "'")
}

fn handler_name(kind: int) -> str {
    if kind == 1 { return "mmap" }
    if kind == 2 { return "dlopen" }
    if kind == 3 { return "dlsym" }
    if kind == 4 { return "pthread" }
    if kind == 5 { return "mprotect" }
    if kind == 6 { return "Metal" }
    if kind == 7 { return "NSObject" }
    if kind == 8 { return "other" }
    return "unknown"
}

// Schema (TSV): msg_id<int> | method_id<int> | handler_kind<int> | elapsed_us<int>
fn record_dispatch(msg_id: int, method_id: int, handler_kind: int, elapsed_us: int) -> void {
    append_row(to_string(msg_id) + "\t" + to_string(method_id) + "\t" + to_string(handler_kind) + "\t" + to_string(elapsed_us))
    r0_emit("pimd_dispatch", "\"msg_id\":" + to_string(msg_id) + ",\"method_id\":" + to_string(method_id) + ",\"handler\":\"" + handler_name(handler_kind) + "\",\"elapsed_us\":" + to_string(elapsed_us))
}

fn table_exists() -> bool {
    let r = exec("test -f '" + PIMD_TABLE + "' && echo ok").trim()
    return r == "ok"
}

fn dispatch_count() -> int {
    if !table_exists() { return 0 }
    return to_int(exec("wc -l < '" + PIMD_TABLE + "' | tr -d ' '").trim())
}

fn count_by_handler_kind(kind: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$3==k {c++} END {print c+0}' '" + PIMD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn total_elapsed_us() -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END {print s+0}' '" + PIMD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn avg_elapsed_us() -> int {
    let dc = dispatch_count()
    if dc == 0 { return 0 }
    return total_elapsed_us() / dc
}

fn msg_handler_kind(msg_id: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(msg_id) + " '$1==m {print $3; exit}' '" + PIMD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn msg_elapsed_us(msg_id: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(msg_id) + " '$1==m {s+=$4} END {print s+0}' '" + PIMD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn pimd_stats() -> array {
    return [dispatch_count(), total_elapsed_us(), count_by_handler_kind(1), count_by_handler_kind(2)]
}

fn cleanup_pimd() -> void {
    let _ = exec("rm -rf '" + PIMD_DIR + "'")
}

fn self_test() -> void {
    let sid = "pimd-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pimd()

    // 5 dispatches synthesis
    record_dispatch(112001, 1, 1, 240)   // mmap dispatch
    record_dispatch(112002, 2, 2, 180)   // dlopen dispatch
    record_dispatch(112003, 3, 3, 80)    // dlsym dispatch
    record_dispatch(112004, 4, 4, 320)   // pthread dispatch
    record_dispatch(112005, 5, 5, 60)    // mprotect dispatch

    // dispatch_count
    let dc = dispatch_count()
    if dc != 5 { panic("pe_ipc_message_dispatch FAIL [dispatch_count] expected=5 got=" + to_string(dc)) }

    // total_elapsed_us
    let te = total_elapsed_us()
    if te != 880 { panic("pe_ipc_message_dispatch FAIL [total_elapsed_us] expected=880 got=" + to_string(te)) }

    // avg_elapsed_us
    let ae = avg_elapsed_us()
    if ae != 176 { panic("pe_ipc_message_dispatch FAIL [avg_elapsed_us] expected=176 got=" + to_string(ae)) }

    // count_by_handler_kind
    let c1 = count_by_handler_kind(1)
    if c1 != 1 { panic("pe_ipc_message_dispatch FAIL [count_by_handler_kind 1] expected=1 got=" + to_string(c1)) }
    let c2 = count_by_handler_kind(2)
    if c2 != 1 { panic("pe_ipc_message_dispatch FAIL [count_by_handler_kind 2] expected=1 got=" + to_string(c2)) }
    let c3 = count_by_handler_kind(3)
    if c3 != 1 { panic("pe_ipc_message_dispatch FAIL [count_by_handler_kind 3] expected=1 got=" + to_string(c3)) }
    let c4 = count_by_handler_kind(4)
    if c4 != 1 { panic("pe_ipc_message_dispatch FAIL [count_by_handler_kind 4] expected=1 got=" + to_string(c4)) }
    let c5 = count_by_handler_kind(5)
    if c5 != 1 { panic("pe_ipc_message_dispatch FAIL [count_by_handler_kind 5] expected=1 got=" + to_string(c5)) }
    let c8 = count_by_handler_kind(8)
    if c8 != 0 { panic("pe_ipc_message_dispatch FAIL [count_by_handler_kind 8] expected=0 got=" + to_string(c8)) }
    let c99 = count_by_handler_kind(99)
    if c99 != 0 { panic("pe_ipc_message_dispatch FAIL [count_by_handler_kind 99] expected=0 got=" + to_string(c99)) }

    // msg_handler_kind
    let m1 = msg_handler_kind(112001)
    if m1 != 1 { panic("pe_ipc_message_dispatch FAIL [msg_handler_kind 112001] expected=1 got=" + to_string(m1)) }
    let m5 = msg_handler_kind(112005)
    if m5 != 5 { panic("pe_ipc_message_dispatch FAIL [msg_handler_kind 112005] expected=5 got=" + to_string(m5)) }
    let m_missing = msg_handler_kind(9999)
    if m_missing != 0 { panic("pe_ipc_message_dispatch FAIL [msg_handler_kind 9999] expected=0 got=" + to_string(m_missing)) }

    // pimd_stats = [5, 880, 1, 1]
    let st = pimd_stats()
    if len(st) != 4 { panic("pe_ipc_message_dispatch FAIL [pimd_stats len] expected=4 got=" + to_string(len(st))) }
    if st[0] != 5 { panic("pe_ipc_message_dispatch FAIL [pimd_stats[0]] expected=5 got=" + to_string(st[0])) }
    if st[1] != 880 { panic("pe_ipc_message_dispatch FAIL [pimd_stats[1]] expected=880 got=" + to_string(st[1])) }
    if st[2] != 1 { panic("pe_ipc_message_dispatch FAIL [pimd_stats[2]] expected=1 got=" + to_string(st[2])) }
    if st[3] != 1 { panic("pe_ipc_message_dispatch FAIL [pimd_stats[3]] expected=1 got=" + to_string(st[3])) }

    // emit count >= 6 (5 dispatch + 1 summary)
    r0_emit("pimd_self_test", "\"dispatch_count\":5,\"total_elapsed_us\":880,\"avg_elapsed_us\":176")
    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("pe_ipc_message_dispatch FAIL [emit count] expected>=6 got=" + to_string(cnt)) }

    cleanup_pimd()

    println("  ✅ pe_ipc_message_dispatch self_test PASS (dispatch=5, total_us=880, avg_us=176, mmap=1, dlopen=1, dlsym=1, pthread=1, mprotect=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let st = pimd_stats()
            println("dispatch_count=" + to_string(st[0]) + " total_elapsed_us=" + to_string(st[1]) + " mmap=" + to_string(st[2]) + " dlopen=" + to_string(st[3]))
            return
        }
        if sub == "elapsed" && len(a) >= 4 {
            println(to_string(msg_elapsed_us(to_int(a[3]))))
            return
        }
        if sub == "count" && len(a) >= 4 {
            println(to_string(count_by_handler_kind(to_int(a[3]))))
            return
        }
        if sub == "cleanup" { cleanup_pimd(); println("cleaned"); return }
    }
    println("usage: hexa run pe_ipc_message_dispatch.hexa { self-test | stats | elapsed <msg_id> | count <handler_kind> | cleanup }")
}
