// lib/loader/pe_dxcore_core.hexa — DXCORE.dll modern D3D12 adapter enumeration prerequisite (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine dxcore source 인용 0.
//       dxcore.dll 직접 binding 0. macOS Metal MTLDevice / IOKit graphics / IORegistry /
//       CGDirectDisplay / IOServiceMatching("IOPCIDevice") / Foundation NSXPCConnection 직접 binding 0.
//       NOTE: DXCORE 측 D3D12 modern adapter enumeration prerequisite + IDXCoreAdapterFactory
//       ↔ IDXCoreAdapterList ↔ IDXCoreAdapter pattern + DXGI_ADAPTER_DESC 측 GPU LUID
//       round-trip baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BL2 — DXCORE adapter enumeration surface 10 fn skeleton-tier (factory/adapter/notify).
// cycle 56 364/435 (~83.68%) → cycle 57 ~374/435 (~85.98%) (+10 fn, BL bundled part 2/4).
//
// 대상 fn (10 fn — 3 group, fn_kind 0..9):
//   FACTORY  (3): DXCoreCreateAdapterFactory(0) /
//                 IDXCoreAdapterFactory_CreateAdapterList(1) /
//                 IDXCoreAdapterList_GetAdapter(2)
//   ADAPTER  (4): IDXCoreAdapter_GetProperty(3) / IDXCoreAdapter_IsValid(4) /
//                 IDXCoreAdapter_IsAttributeSupported(5) /
//                 IDXCoreAdapter_GetPropertySize(6)
//   NOTIFY   (3): IDXCoreAdapterFactory_RegisterEventNotification(7) /
//                 IDXCoreAdapterFactory_UnregisterEventNotification(8) /
//                 IDXCoreAdapterList_Sort(9)
//
// synthetic struct families:
//   IDXCoreAdapterFactory 0xE0010100 / IDXCoreAdapterList 0xE0020100 /
//   IDXCoreAdapter 0xE0030100 opaque interface (synthetic).
//   DXCoreAdapterPreference enum Hardware=0 MinimumPower=1 HighPerformance=2.
//   DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS GUID
//   {0F11C9F0-D17E-4F46-9CD1-2D1F4E7AE9F2} synth + DXCORE_ADAPTER_ATTRIBUTE_D3D12_CORE_COMPUTE.
//   DXCoreAdapterProperty enum InstanceLuid=0 DriverVersion=1 DriverDescription=2
//                              HardwareID=3 KmdModelVersion=4 ComputePreemptionGranularity=5
//                              GraphicsPreemptionGranularity=6 DedicatedAdapterMemory=7
//                              DedicatedSystemMemory=8 SharedSystemMemory=9 AcgCompatible=10
//                              IsHardware=11 IsIntegrated=12 IsDetachable=13.
//   LUID 8B HighPart=0 LowPart=0xABCDEF12_synth_gpu0.
//   DXGI_ADAPTER_DESC1 syn 8B vendor 0x10DE NVIDIA 0x1002 AMD 0x8086 Intel + DedicatedVideoMemory 0x80000000_2GB.
//
// persist schema (TSV — 4 table):
//   syscall_invoke / factory_event / adapter_event / notify_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn put_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dxcore_core"
}

fn put_syscall_invoke_path() -> str {
    return put_dir() + "/syscall_invoke.tsv"
}

fn put_factory_event_path() -> str {
    return put_dir() + "/factory_event.tsv"
}

fn put_adapter_event_path() -> str {
    return put_dir() + "/adapter_event.tsv"
}

fn put_notify_event_path() -> str {
    return put_dir() + "/notify_event.tsv"
}

fn put_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + put_dir() + "'")
}

fn cleanup_put() -> void {
    put_ensure_dir()
    let _ = exec("rm -f '" + put_syscall_invoke_path() + "' '" + put_factory_event_path()
        + "' '" + put_adapter_event_path() + "' '" + put_notify_event_path() + "'")
}

// ─── 공통 file IO ───
fn put_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn put_append_row(path: str, row: str) -> void {
    put_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn put_count_rows(path: str, min_cols: int) -> int {
    let t = put_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "DXCoreCreateAdapterFactory" }
    if k == 1 { return "IDXCoreAdapterFactory_CreateAdapterList" }
    if k == 2 { return "IDXCoreAdapterList_GetAdapter" }
    if k == 3 { return "IDXCoreAdapter_GetProperty" }
    if k == 4 { return "IDXCoreAdapter_IsValid" }
    if k == 5 { return "IDXCoreAdapter_IsAttributeSupported" }
    if k == 6 { return "IDXCoreAdapter_GetPropertySize" }
    if k == 7 { return "IDXCoreAdapterFactory_RegisterEventNotification" }
    if k == 8 { return "IDXCoreAdapterFactory_UnregisterEventNotification" }
    if k == 9 { return "IDXCoreAdapterList_Sort" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "factory"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "adapter"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "notify"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: DXCORE fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_dxcore_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_dxcore_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_dxcore_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_dxcore_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_dxcore_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    put_append_row(put_syscall_invoke_path(), row)
}

// ─── record_factory_event: DXCoreCreateAdapterFactory/CreateAdapterList/GetAdapter row ───
fn record_factory_event(evt_id: int, f_kind: str, factory_synth: str, list_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_dxcore_core FAIL [record_factory_event] evt_id<=0") }
    if f_kind == "" { panic("pe_dxcore_core FAIL [record_factory_event] f_kind=empty") }
    if factory_synth == "" { panic("pe_dxcore_core FAIL [record_factory_event] factory_synth=empty") }
    if list_synth == "" { panic("pe_dxcore_core FAIL [record_factory_event] list_synth=empty") }
    if status == "" { panic("pe_dxcore_core FAIL [record_factory_event] status=empty") }
    let row = to_string(evt_id) + "\t" + f_kind + "\t" + factory_synth + "\t" + list_synth + "\t" + status + "\n"
    put_append_row(put_factory_event_path(), row)
}

// ─── record_adapter_event: GetProperty/IsValid/IsAttributeSupported/GetPropertySize row ───
fn record_adapter_event(evt_id: int, a_kind: str, prop_name: str, value_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_dxcore_core FAIL [record_adapter_event] evt_id<=0") }
    if a_kind == "" { panic("pe_dxcore_core FAIL [record_adapter_event] a_kind=empty") }
    if prop_name == "" { panic("pe_dxcore_core FAIL [record_adapter_event] prop_name=empty") }
    if value_synth == "" { panic("pe_dxcore_core FAIL [record_adapter_event] value_synth=empty") }
    if status == "" { panic("pe_dxcore_core FAIL [record_adapter_event] status=empty") }
    let row = to_string(evt_id) + "\t" + a_kind + "\t" + prop_name + "\t" + value_synth + "\t" + status + "\n"
    put_append_row(put_adapter_event_path(), row)
}

// ─── record_notify_event: RegisterEventNotification/UnregisterEventNotification/Sort row ───
fn record_notify_event(evt_id: int, n_kind: str, event_type: str, cookie_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_dxcore_core FAIL [record_notify_event] evt_id<=0") }
    if n_kind == "" { panic("pe_dxcore_core FAIL [record_notify_event] n_kind=empty") }
    if event_type == "" { panic("pe_dxcore_core FAIL [record_notify_event] event_type=empty") }
    if cookie_synth == "" { panic("pe_dxcore_core FAIL [record_notify_event] cookie_synth=empty") }
    if status == "" { panic("pe_dxcore_core FAIL [record_notify_event] status=empty") }
    let row = to_string(evt_id) + "\t" + n_kind + "\t" + event_type + "\t" + cookie_synth + "\t" + status + "\n"
    put_append_row(put_notify_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return put_count_rows(put_syscall_invoke_path(), 4)
}

fn factory_event_count() -> int {
    return put_count_rows(put_factory_event_path(), 5)
}

fn adapter_event_count() -> int {
    return put_count_rows(put_adapter_event_path(), 5)
}

fn notify_event_count() -> int {
    return put_count_rows(put_notify_event_path(), 5)
}

fn put_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(factory_event_count())
    out.push(adapter_event_count())
    out.push(notify_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "put-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_put()

    // ─── 1. syscall_invoke × 10 (one per fn, 3 group coverage) ───
    //   FACTORY group (3)
    record_syscall_invoke(1, 0, "DXCoreCreateAdapterFactory", "PARTIAL")
    println("__DXCORE__ PARTIAL DXCoreCreateAdapterFactory")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"DXCoreCreateAdapterFactory\",\"fn_group\":\"factory\",\"status\":\"PARTIAL\",\"riid\":\"IID_IDXCoreAdapterFactory_synth\",\"out_ppvFactory\":\"0xE0010100_IDXCoreAdapterFactory\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(2, 1, "IDXCoreAdapterFactory_CreateAdapterList", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapterFactory_CreateAdapterList")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"IDXCoreAdapterFactory_CreateAdapterList\",\"fn_group\":\"factory\",\"status\":\"PARTIAL\",\"this\":\"0xE0010100\",\"NumAttributes\":1,\"filterAttributes\":\"DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS_GUID_synth\",\"riid\":\"IID_IDXCoreAdapterList_synth\",\"out_ppvAdapterList\":\"0xE0020100\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(3, 2, "IDXCoreAdapterList_GetAdapter", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapterList_GetAdapter")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"IDXCoreAdapterList_GetAdapter\",\"fn_group\":\"factory\",\"status\":\"PARTIAL\",\"this\":\"0xE0020100\",\"index\":0,\"riid\":\"IID_IDXCoreAdapter_synth\",\"out_ppvAdapter\":\"0xE0030100\",\"adapter_descript\":\"NVIDIA_GeForce_synth_or_AMD_Radeon_synth\",\"return_hresult\":\"S_OK_0\"")

    //   ADAPTER group (4)
    record_syscall_invoke(4, 3, "IDXCoreAdapter_GetProperty", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapter_GetProperty")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"IDXCoreAdapter_GetProperty\",\"fn_group\":\"adapter\",\"status\":\"PARTIAL\",\"this\":\"0xE0030100\",\"property\":\"DriverDescription_2\",\"bufferSize\":256,\"out_propertyData\":\"NVIDIA_GeForce_RTX_3060_synth_or_AMD_RX_synth\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(5, 4, "IDXCoreAdapter_IsValid", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapter_IsValid")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"IDXCoreAdapter_IsValid\",\"fn_group\":\"adapter\",\"status\":\"PARTIAL\",\"this\":\"0xE0030100\",\"return_bool\":\"TRUE_1\",\"adapter_state_synth\":\"present_and_enabled\"")
    record_syscall_invoke(6, 5, "IDXCoreAdapter_IsAttributeSupported", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapter_IsAttributeSupported")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"IDXCoreAdapter_IsAttributeSupported\",\"fn_group\":\"adapter\",\"status\":\"PARTIAL\",\"this\":\"0xE0030100\",\"attributeGUID\":\"DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS\",\"return_bool\":\"TRUE_1\",\"d3d12_graphics_supported\":true")
    record_syscall_invoke(7, 6, "IDXCoreAdapter_GetPropertySize", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapter_GetPropertySize")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"IDXCoreAdapter_GetPropertySize\",\"fn_group\":\"adapter\",\"status\":\"PARTIAL\",\"this\":\"0xE0030100\",\"property\":\"DedicatedAdapterMemory_7\",\"out_bufferSize\":8,\"return_hresult\":\"S_OK_0\"")

    //   NOTIFY group (3)
    record_syscall_invoke(8, 7, "IDXCoreAdapterFactory_RegisterEventNotification", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapterFactory_RegisterEventNotification")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"IDXCoreAdapterFactory_RegisterEventNotification\",\"fn_group\":\"notify\",\"status\":\"PARTIAL\",\"this\":\"0xE0010100\",\"dxCoreObject\":\"0xE0030100_adapter\",\"notificationType\":\"DXCoreNotificationType_AdapterListStale_0\",\"callback\":\"d2r_d4_renderer_relink_callback_synth\",\"context\":0,\"out_eventCookie\":4096,\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(9, 8, "IDXCoreAdapterFactory_UnregisterEventNotification", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapterFactory_UnregisterEventNotification")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"IDXCoreAdapterFactory_UnregisterEventNotification\",\"fn_group\":\"notify\",\"status\":\"PARTIAL\",\"this\":\"0xE0010100\",\"eventCookie\":4096,\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(10, 9, "IDXCoreAdapterList_Sort", "PARTIAL")
    println("__DXCORE__ PARTIAL IDXCoreAdapterList_Sort")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"IDXCoreAdapterList_Sort\",\"fn_group\":\"notify\",\"status\":\"PARTIAL\",\"this\":\"0xE0020100\",\"NumPreferences\":1,\"preferences\":\"DXCoreAdapterPreference_HighPerformance_2\",\"return_hresult\":\"S_OK_0\",\"d2r_d4_dgpu_first_baseline\":true")

    // ─── 2. factory_event × 4 (create/list/get/release) ───
    record_factory_event(1, "create_factory", "0xE0010100_IDXCoreAdapterFactory", "factory_init", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"factory_event\",\"evt_id\":1,\"f_kind\":\"create_factory\",\"factory_synth\":\"0xE0010100_IDXCoreAdapterFactory\",\"list_synth\":\"factory_init\",\"return_hresult\":\"S_OK_0\",\"d2r_d4_renderer_init_baseline\":true,\"status\":\"PARTIAL\"")
    record_factory_event(2, "create_adapter_list_d3d12_graphics", "0xE0020100_IDXCoreAdapterList", "DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS_GUID_synth", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"factory_event\",\"evt_id\":2,\"f_kind\":\"create_adapter_list_d3d12_graphics\",\"factory_synth\":\"0xE0020100_IDXCoreAdapterList\",\"list_synth\":\"DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS_GUID_synth\",\"NumAttributes\":1,\"adapter_count_synth\":2,\"d4_d3d12_prerequisite_baseline\":true,\"status\":\"PARTIAL\"")
    record_factory_event(3, "get_adapter_index_0_dgpu", "0xE0030100_IDXCoreAdapter_dgpu", "NVIDIA_GeForce_RTX_3060_synth", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"factory_event\",\"evt_id\":3,\"f_kind\":\"get_adapter_index_0_dgpu\",\"factory_synth\":\"0xE0030100_IDXCoreAdapter_dgpu\",\"list_synth\":\"NVIDIA_GeForce_RTX_3060_synth\",\"adapter_index\":0,\"d3d12_graphics_supported\":true,\"status\":\"PARTIAL\"")
    record_factory_event(4, "get_adapter_index_1_igpu", "0xE0030200_IDXCoreAdapter_igpu", "Intel_UHD_synth", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"factory_event\",\"evt_id\":4,\"f_kind\":\"get_adapter_index_1_igpu\",\"factory_synth\":\"0xE0030200_IDXCoreAdapter_igpu\",\"list_synth\":\"Intel_UHD_synth\",\"adapter_index\":1,\"d3d12_graphics_supported\":true,\"status\":\"PARTIAL\"")

    // ─── 3. adapter_event × 3 (property/valid/attribute) ───
    record_adapter_event(1, "property_driver_description", "DriverDescription_2", "NVIDIA_GeForce_RTX_3060_synth_string", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"adapter_event\",\"evt_id\":1,\"a_kind\":\"property_driver_description\",\"prop_name\":\"DriverDescription_2\",\"value_synth\":\"NVIDIA_GeForce_RTX_3060_synth_string\",\"d4_d3d12_renderer_init_baseline\":true,\"status\":\"PARTIAL\"")
    record_adapter_event(2, "property_dedicated_video_memory", "DedicatedAdapterMemory_7", "0x0000000080000000_2GB", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"adapter_event\",\"evt_id\":2,\"a_kind\":\"property_dedicated_video_memory\",\"prop_name\":\"DedicatedAdapterMemory_7\",\"value_synth\":\"0x0000000080000000_2GB\",\"property_size_bytes\":8,\"struct_bytes\":8,\"status\":\"PARTIAL\"")
    record_adapter_event(3, "is_attribute_supported_d3d12_graphics", "DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS", "TRUE_1", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"adapter_event\",\"evt_id\":3,\"a_kind\":\"is_attribute_supported_d3d12_graphics\",\"prop_name\":\"DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS\",\"value_synth\":\"TRUE_1\",\"d4_d3d12_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── 4. notify_event × 3 (register/unregister/sort) ───
    record_notify_event(1, "register_adapter_list_stale", "DXCoreNotificationType_AdapterListStale_0", "cookie_4096_synth", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"notify_event\",\"evt_id\":1,\"n_kind\":\"register_adapter_list_stale\",\"event_type\":\"DXCoreNotificationType_AdapterListStale_0\",\"cookie_synth\":\"cookie_4096_synth\",\"callback_synth\":\"d2r_d4_renderer_relink_callback\",\"d2r_d4_renderer_relink_baseline\":true,\"status\":\"PARTIAL\"")
    record_notify_event(2, "unregister_cookie_4096", "release_callback", "cookie_4096_synth", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"notify_event\",\"evt_id\":2,\"n_kind\":\"unregister_cookie_4096\",\"event_type\":\"release_callback\",\"cookie_synth\":\"cookie_4096_synth\",\"return_hresult\":\"S_OK_0\",\"status\":\"PARTIAL\"")
    record_notify_event(3, "sort_high_performance_dgpu_first", "DXCoreAdapterPreference_HighPerformance_2", "list_0xE0020100", "PARTIAL")
    r0_emit("pe_dxcore_core_record", "\"kind\":\"notify_event\",\"evt_id\":3,\"n_kind\":\"sort_high_performance_dgpu_first\",\"event_type\":\"DXCoreAdapterPreference_HighPerformance_2\",\"cookie_synth\":\"list_0xE0020100\",\"NumPreferences\":1,\"d2r_d4_dgpu_first_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_dxcore_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let fc = factory_event_count()
    if fc != 4 {
        panic("pe_dxcore_core FAIL [factory_event_count] expected=4 got=" + to_string(fc))
    }
    let ac = adapter_event_count()
    if ac != 3 {
        panic("pe_dxcore_core FAIL [adapter_event_count] expected=3 got=" + to_string(ac))
    }
    let nc = notify_event_count()
    if nc != 3 {
        panic("pe_dxcore_core FAIL [notify_event_count] expected=3 got=" + to_string(nc))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "DXCoreCreateAdapterFactory" { panic("pe_dxcore_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(3) != "IDXCoreAdapter_GetProperty" { panic("pe_dxcore_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(7) != "IDXCoreAdapterFactory_RegisterEventNotification" { panic("pe_dxcore_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(9) != "IDXCoreAdapterList_Sort" { panic("pe_dxcore_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_dxcore_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "factory" { panic("pe_dxcore_core FAIL [fn_group_name(0)]") }
    if fn_group_name(3) != "adapter" { panic("pe_dxcore_core FAIL [fn_group_name(3)]") }
    if fn_group_name(7) != "notify" { panic("pe_dxcore_core FAIL [fn_group_name(7)]") }
    if fn_group_name(99) != "unknown" { panic("pe_dxcore_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = put_stats()
    if len(s) != 4 { panic("pe_dxcore_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_dxcore_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_dxcore_core FAIL [stats factory_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_dxcore_core FAIL [stats adapter_event_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_dxcore_core FAIL [stats notify_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_dxcore_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"factory_event_count\":" + to_string(s[1])
        + ",\"adapter_event_count\":" + to_string(s[2])
        + ",\"notify_event_count\":" + to_string(s[3]))

    r0_emit("pe_dxcore_core_summary",
        "\"target\":\"DXCORE.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"factory\",\"adapter\",\"notify\"],\"factory_synth\":\"0xE0010100\",\"list_synth\":\"0xE0020100\",\"adapter_synth\":\"0xE0030100\",\"d3d12_prerequisite\":true,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_dxcore_core_kpi",
        "\"factory_emits\":3,\"adapter_emits\":4,\"notify_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_d4_renderer_init_baseline\":true,\"d4_d3d12_prerequisite_baseline\":true,\"dgpu_first_baseline\":true,\"metal_mtldevice_binding\":false,\"iokit_iopcidevice_binding\":false")

    // ─── cycle 56 → 57 DXCORE coverage progression evidence emit ───
    r0_emit("pe_dxcore_core_coverage_progression",
        "\"surface\":\"DXCORE_full_435_fn\",\"cycle_56_count\":364,\"cycle_57_count\":374,\"delta\":10,\"cycle_56_percent\":83.68,\"cycle_57_percent\":85.98,\"cycle_57_module\":\"pe_dxcore_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_bl2_cycle_increment\":10,\"track_bl_bundled_part_2_of_4\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_dxcore_core_round_trip_matrix",
        "\"surface\":\"DXCORE_core_10_fn\",\"fn_partial\":10,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.2\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real DXCoreCreateAdapterFactory + IDXCoreAdapter::GetProperty + IDXCoreAdapter::IsAttributeSupported = Metal MTLCopyAllDevices + IOKit IOServiceMatching IOPCIDevice + IORegistryEntryCreateCFProperty + CGDirectDisplay CGGetActiveDisplayList bridge pending separate cycle (long-horizon D3D12 adapter enumeration pipeline)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    // ─── Track BL2 expansion emit (cycle 57, DXCORE +10 fn) ───
    r0_emit("pe_dxcore_core_bl2_expansion",
        "\"track\":\"BL2\",\"cycle\":57,\"surface\":\"DXCORE_new\",\"new_fn\":10,\"groups\":[\"factory\",\"adapter\",\"notify\"],\"factory_count\":3,\"adapter_count\":4,\"notify_count\":3,\"emit_format\":\"__DXCORE__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_2_evidence_augment\":true,\"track_bl_bundled_part_2_of_4\":true,\"d3d12_prerequisite\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_dxcore_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_put()
    let s2 = put_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dxcore_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dxcore_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", factory_event=" + to_string(s[1])
        + ", adapter_event=" + to_string(s[2]) + ", notify_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = put_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("factory_event_count\t" + to_string(s[1]))
            println("adapter_event_count\t" + to_string(s[2]))
            println("notify_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_dxcore_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_dxcore_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_put()
            println("cleaned: " + put_dir())
            return
        }
        if sub == "dir" {
            println(put_dir())
            return
        }
    }
    println("usage: hexa run pe_dxcore_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
