// pe_msvc_rtti_typeinfo_real.hexa — MSVC RTTI TypeInfo + name decode tracker
//
// MSVC RTTI 구조 추적:
//   vfptr[-1] → RTTICompleteObjectLocator
//     COL: signature / offset / cdOffset / pTypeDescriptor / pClassDescriptor
//     TypeDescriptor: pVFTable / spare / decoratedName (".?AVCMyClass@@" 등)
//     ClassHierarchyDescriptor: signature / attributes / numBaseClasses / pBaseClassArray
//
// dynamic_cast<T>(p) / typeid(*p) 두 path 모두 RTTI walk 결과를 기록한다.
//
// own1: hexa pure, Wine 0줄 — research-G MSVC ABI reference (algorithm only).
// own2: r0_emit ≥ 14, panic, self-test, headless safe.

use "../perf/r0_common"

fn pmrt_dir() -> str { return GAMEBOX_HOME + "/persist/pe_msvc_rtti_typeinfo_real" }
fn pmrt_td_path() -> str { return pmrt_dir() + "/type_descriptor.tsv" }
fn pmrt_chd_path() -> str { return pmrt_dir() + "/class_hierarchy.tsv" }
fn pmrt_col_path() -> str { return pmrt_dir() + "/complete_object_locator.tsv" }
fn pmrt_dc_path() -> str { return pmrt_dir() + "/dynamic_cast.tsv" }
fn pmrt_tid_path() -> str { return pmrt_dir() + "/typeid_lookup.tsv" }

fn pmrt_ensure_dir() -> void { let _ = exec("mkdir -p '" + pmrt_dir() + "'") }
fn cleanup_pmrt() -> void {
    pmrt_ensure_dir()
    let _ = exec("rm -f '" + pmrt_td_path() + "' '" + pmrt_chd_path()
        + "' '" + pmrt_col_path() + "' '" + pmrt_dc_path()
        + "' '" + pmrt_tid_path() + "'")
}

fn pmrt_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" { return "" }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmrt_append_row(path: str, row: str) -> void {
    pmrt_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// MSVC TypeDescriptor: pVFTable / spare / decoratedName
fn record_type_descriptor(type_id: int, name_hash: int, decorated_name_string: str, vftable_va_hex: str) -> void {
    if type_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [type_descriptor] id>0") }
    if decorated_name_string == "" { panic("pe_msvc_rtti_typeinfo_real FAIL [type_descriptor] name non-empty") }
    if vftable_va_hex == "" { panic("pe_msvc_rtti_typeinfo_real FAIL [type_descriptor] vftable_va non-empty") }
    if name_hash < 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [type_descriptor] name_hash>=0") }
    let row = to_string(type_id) + "\t" + to_string(name_hash) + "\t" + decorated_name_string + "\t" + vftable_va_hex + "\n"
    pmrt_append_row(pmrt_td_path(), row)
}

// ClassHierarchyDescriptor: signature / attributes / numBaseClasses
fn record_class_hierarchy(hierarchy_id: int, attributes: int, base_class_count: int) -> void {
    if hierarchy_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [class_hierarchy] id>0") }
    if attributes < 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [class_hierarchy] attributes>=0") }
    if base_class_count < 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [class_hierarchy] base_class_count>=0") }
    let row = to_string(hierarchy_id) + "\t" + to_string(attributes) + "\t" + to_string(base_class_count) + "\n"
    pmrt_append_row(pmrt_chd_path(), row)
}

// CompleteObjectLocator: signature / offset / pTypeDescriptor
fn record_complete_object_locator(col_id: int, signature: int, offset: int, type_descriptor_va_hex: str) -> void {
    if col_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [col] id>0") }
    if signature < 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [col] signature>=0") }
    if offset < 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [col] offset>=0") }
    if type_descriptor_va_hex == "" { panic("pe_msvc_rtti_typeinfo_real FAIL [col] type_descriptor_va non-empty") }
    let row = to_string(col_id) + "\t" + to_string(signature) + "\t" + to_string(offset) + "\t" + type_descriptor_va_hex + "\n"
    pmrt_append_row(pmrt_col_path(), row)
}

// dynamic_cast<T>(p) — source_type_id → target_type_id walk
fn record_dynamic_cast(cast_id: int, source_type_id: int, target_type_id: int, success: int) -> void {
    if cast_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [dynamic_cast] id>0") }
    if source_type_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [dynamic_cast] source_type_id>0") }
    if target_type_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [dynamic_cast] target_type_id>0") }
    if success < 0 || success > 1 { panic("pe_msvc_rtti_typeinfo_real FAIL [dynamic_cast] success 0/1") }
    let row = to_string(cast_id) + "\t" + to_string(source_type_id) + "\t" + to_string(target_type_id) + "\t" + to_string(success) + "\n"
    pmrt_append_row(pmrt_dc_path(), row)
}

// typeid(*p) — source_va → resolved type_id + decoratedName
fn record_typeid_lookup(typeid_id: int, source_va_hex: str, type_id: int, decorated_name_string: str) -> void {
    if typeid_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [typeid_lookup] id>0") }
    if source_va_hex == "" { panic("pe_msvc_rtti_typeinfo_real FAIL [typeid_lookup] source_va non-empty") }
    if type_id <= 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [typeid_lookup] type_id>0") }
    if decorated_name_string == "" { panic("pe_msvc_rtti_typeinfo_real FAIL [typeid_lookup] name non-empty") }
    let row = to_string(typeid_id) + "\t" + source_va_hex + "\t" + to_string(type_id) + "\t" + decorated_name_string + "\n"
    pmrt_append_row(pmrt_tid_path(), row)
}

fn count_rows(path: str, min_cols: int) -> int {
    let t = pmrt_read_table(path)
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= min_cols { cnt = cnt + 1 }
        }
        i = i + 1
    }
    return cnt
}

fn type_descriptor_count() -> int { return count_rows(pmrt_td_path(), 4) }
fn class_hierarchy_count() -> int { return count_rows(pmrt_chd_path(), 3) }
fn col_count() -> int { return count_rows(pmrt_col_path(), 4) }
fn dynamic_cast_count() -> int { return count_rows(pmrt_dc_path(), 4) }
fn typeid_lookup_count() -> int { return count_rows(pmrt_tid_path(), 4) }

// MSVC decorated name 의 prefix 로 kind 추출:
//   .?AV → class
//   .?AU → struct
//   .?AW → enum
//   .?AT → union
//   .?AVI → interface (프레임워크 컨벤션, V + I-prefix 클래스명)
fn decode_name_kind_name(decorated_name_string: str) -> str {
    if decorated_name_string == "" { return "" }
    if decorated_name_string.starts_with(".?AVI") { return "interface" }
    if decorated_name_string.starts_with(".?AV") { return "class" }
    if decorated_name_string.starts_with(".?AU") { return "struct" }
    if decorated_name_string.starts_with(".?AW") { return "enum" }
    if decorated_name_string.starts_with(".?AT") { return "union" }
    return ""
}

fn pmrt_stats() -> array {
    let mut out = []
    out.push(type_descriptor_count())
    out.push(class_hierarchy_count())
    out.push(col_count())
    out.push(dynamic_cast_count())
    out.push(typeid_lookup_count())
    return out
}

fn self_test() -> void {
    let sid = "pmrt-" + exec("date +%s").trim()
    r0_session_set(sid)
    cleanup_pmrt()

    // 4 type_descriptor — 4 다른 decorated name (class/struct/interface/enum)
    record_type_descriptor(1, 0xCAFE0001, ".?AVCMyClass@@", "0x00410000"); r0_emit("pmrt_td", "\"id\":1,\"kind\":\"class\"")
    record_type_descriptor(2, 0xCAFE0002, ".?AUMyStruct@@", "0x00410100"); r0_emit("pmrt_td", "\"id\":2,\"kind\":\"struct\"")
    record_type_descriptor(3, 0xCAFE0003, ".?AVIDispatch@@", "0x00410200"); r0_emit("pmrt_td", "\"id\":3,\"kind\":\"interface\"")
    record_type_descriptor(4, 0xCAFE0004, ".?AW4ColorMode@@", "0x00410300"); r0_emit("pmrt_td", "\"id\":4,\"kind\":\"enum\"")

    // 2 class_hierarchy
    record_class_hierarchy(1, 0, 1); r0_emit("pmrt_chd", "\"id\":1,\"bases\":1")
    record_class_hierarchy(2, 1, 3); r0_emit("pmrt_chd", "\"id\":2,\"bases\":3")

    // 4 complete_object_locator
    record_complete_object_locator(1, 0, 0, "0x00420000"); r0_emit("pmrt_col", "\"id\":1")
    record_complete_object_locator(2, 0, 0, "0x00420100"); r0_emit("pmrt_col", "\"id\":2")
    record_complete_object_locator(3, 1, 8, "0x00420200"); r0_emit("pmrt_col", "\"id\":3")
    record_complete_object_locator(4, 1, 16, "0x00420300"); r0_emit("pmrt_col", "\"id\":4")

    // 3 dynamic_cast (2 success + 1 fail)
    record_dynamic_cast(1, 1, 2, 1); r0_emit("pmrt_dc", "\"id\":1,\"ok\":1")
    record_dynamic_cast(2, 3, 1, 1); r0_emit("pmrt_dc", "\"id\":2,\"ok\":1")
    record_dynamic_cast(3, 2, 4, 0); r0_emit("pmrt_dc", "\"id\":3,\"ok\":0")

    // 2 typeid_lookup
    record_typeid_lookup(1, "0x00500000", 1, ".?AVCMyClass@@"); r0_emit("pmrt_tid", "\"id\":1")
    record_typeid_lookup(2, "0x00500100", 3, ".?AVIDispatch@@"); r0_emit("pmrt_tid", "\"id\":2")

    // count assertions
    if type_descriptor_count() != 4 { panic("pe_msvc_rtti_typeinfo_real FAIL [count td] expected=4") }
    if class_hierarchy_count() != 2 { panic("pe_msvc_rtti_typeinfo_real FAIL [count chd] expected=2") }
    if col_count() != 4 { panic("pe_msvc_rtti_typeinfo_real FAIL [count col] expected=4") }
    if dynamic_cast_count() != 3 { panic("pe_msvc_rtti_typeinfo_real FAIL [count dc] expected=3") }
    if typeid_lookup_count() != 2 { panic("pe_msvc_rtti_typeinfo_real FAIL [count tid] expected=2") }

    // decode_name_kind_name 검증
    if decode_name_kind_name(".?AVCMyClass@@") != "class" { panic("pe_msvc_rtti_typeinfo_real FAIL [decode class]") }
    if decode_name_kind_name(".?AUMyStruct@@") != "struct" { panic("pe_msvc_rtti_typeinfo_real FAIL [decode struct]") }
    if decode_name_kind_name(".?AVIDispatch@@") != "interface" { panic("pe_msvc_rtti_typeinfo_real FAIL [decode interface]") }
    if decode_name_kind_name(".?AW4ColorMode@@") != "enum" { panic("pe_msvc_rtti_typeinfo_real FAIL [decode enum]") }
    if decode_name_kind_name(".?ATMyUnion@@") != "union" { panic("pe_msvc_rtti_typeinfo_real FAIL [decode union]") }
    if decode_name_kind_name("") != "" { panic("pe_msvc_rtti_typeinfo_real FAIL [decode empty]") }

    let s = pmrt_stats()
    r0_emit("pmrt_stats", "\"td\":" + to_string(s[0]) + ",\"chd\":" + to_string(s[1])
        + ",\"col\":" + to_string(s[2]) + ",\"dc\":" + to_string(s[3])
        + ",\"tid\":" + to_string(s[4]))

    let emit_n = r0_session_count(sid)
    if emit_n < 14 { panic("pe_msvc_rtti_typeinfo_real FAIL [emit count] expected>=14 got=" + to_string(emit_n)) }

    cleanup_pmrt()
    let s2 = pmrt_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 { panic("pe_msvc_rtti_typeinfo_real FAIL [cleanup]") }
        i = i + 1
    }

    println("  ✅ pe_msvc_rtti_typeinfo_real self_test PASS (td=" + to_string(s[0])
        + ", chd=" + to_string(s[1]) + ", col=" + to_string(s[2])
        + ", dc=" + to_string(s[3]) + ", tid=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = pmrt_stats()
            println("type_descriptor\t" + to_string(s[0]))
            println("class_hierarchy\t" + to_string(s[1]))
            println("col\t" + to_string(s[2]))
            println("dynamic_cast\t" + to_string(s[3]))
            println("typeid_lookup\t" + to_string(s[4]))
            return
        }
        if sub == "cleanup" { cleanup_pmrt(); println("cleaned: " + pmrt_dir()); return }
        if sub == "dir" { println(pmrt_dir()); return }
    }
    println("usage: hexa run pe_msvc_rtti_typeinfo_real.hexa { self-test | stats | cleanup | dir }")
}
