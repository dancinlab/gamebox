// lib/loader/win32_wininet.hexa — Phase 4l — wininet HTTP API
//
// own 1: Wine 0. Microsoft WININET API spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe wininet imports (실측, 11 funcs):
//   InternetOpenA, InternetCloseHandle, InternetSetStatusCallbackA
//   InternetReadFileExA, InternetSetCookieW, InternetSetOptionA
//   InternetCrackUrlA, InternetConnectA
//   HttpOpenRequestA, HttpSendRequestA, HttpQueryInfoA
//
// macOS 매핑: NSURLSession + NSURLRequest + URL parsing.
// skeleton — synthetic HTTP transactions (실 network 호출 없이 mapping table).

use "../perf/r0_common"

fn wininet_table() -> str {
    let t = ""
    // Connection (5)
    t = t + "InternetOpenA\tNSURLSession_init\tConnection\tskeleton\n"
    t = t + "InternetCloseHandle\tNSURLSession_invalidate\tConnection\tskeleton\n"
    t = t + "InternetConnectA\tNSURLConnection_init\tConnection\tskeleton\n"
    t = t + "InternetSetStatusCallbackA\tdelegate_set\tConnection\tskeleton\n"
    t = t + "InternetSetOptionA\tNSURLSessionConfig_set\tConnection\tskeleton\n"
    // HTTP request (3)
    t = t + "HttpOpenRequestA\tNSMutableURLRequest_init\tHTTP\tskeleton\n"
    t = t + "HttpSendRequestA\tdataTaskWithRequest\tHTTP\tskeleton\n"
    t = t + "HttpQueryInfoA\tHTTPURLResponse_field\tHTTP\tskeleton\n"
    // Data (2)
    t = t + "InternetReadFileExA\tdataTask_didReceiveData\tData\tskeleton\n"
    t = t + "InternetCrackUrlA\tNSURLComponents\tData\tskeleton\n"
    // Cookie (1)
    t = t + "InternetSetCookieW\tNSHTTPCookieStorage_set\tCookie\tskeleton\n"
    return t
}

fn wininet_table_size() -> int {
    let lines = wininet_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = wininet_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" { return "" }
    let parts = m.split("\t")
    if len(parts) < 2 { return "" }
    return parts[1]
}

// ─── synthetic URL parser (InternetCrackUrlA stub) ───
//   "https://us.cdn.blizzard.com/path?q=1" → scheme=https host=us.cdn.blizzard.com path=/path
fn parse_url(url: str) -> array {
    let scheme = ""
    let host = ""
    let path = "/"
    if url.contains("://") {
        let scheme_end = url.split("://")
        if len(scheme_end) >= 2 {
            scheme = scheme_end[0]
            let after = scheme_end[1]
            if after.contains("/") {
                let host_path = after.split("/")
                if len(host_path) >= 1 {
                    host = host_path[0]
                    if len(host_path) >= 2 {
                        path = "/" + host_path[1]
                    }
                }
            } else {
                host = after
            }
        }
    }
    return [scheme, host, path]
}

// ─── stats per category ───
fn wininet_stats() -> array {
    let cats = ["Connection", "HTTP", "Data", "Cookie"]
    let result = []
    let lines = wininet_table().split("\n")
    let n = len(lines)
    let c = 0
    while c < len(cats) {
        let cat = cats[c]
        let total = 0
        let i = 0
        while i < n {
            if lines[i] != "" {
                let parts = lines[i].split("\t")
                if len(parts) >= 4 && parts[2] == cat {
                    total = total + 1
                }
            }
            i = i + 1
        }
        result = result + [[cat, total]]
        c = c + 1
    }
    return result
}

fn self_test() -> void {
    let sid = "wininettest-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = wininet_table_size()
    if sz != 11 { panic("win32_wininet FAIL [size] expected=11 got=" + to_string(sz)) }

    // category lookups
    let m_open = lookup_mapping("InternetOpenA")
    if !m_open.contains("Connection") { panic("win32_wininet FAIL [InternetOpenA]") }

    let m_http = lookup_mapping("HttpSendRequestA")
    if !m_http.contains("HTTP") { panic("win32_wininet FAIL [HttpSendRequestA]") }

    let m_cookie = lookup_mapping("InternetSetCookieW")
    if !m_cookie.contains("Cookie") { panic("win32_wininet FAIL [Cookie]") }

    let unk = lookup_mapping("UnknownInternetFunc")
    if unk != "" { panic("win32_wininet FAIL [unknown]") }

    // URL parser
    let parts = parse_url("https://us.cdn.blizzard.com/path/file.tar")
    if parts[0] != "https" { panic("win32_wininet FAIL [parse scheme] got=" + parts[0]) }
    if parts[1] != "us.cdn.blizzard.com" { panic("win32_wininet FAIL [parse host] got=" + parts[1]) }
    if !parts[2].contains("/path") { panic("win32_wininet FAIL [parse path] got=" + parts[2]) }

    // category stats
    let stats = wininet_stats()
    if len(stats) != 4 { panic("win32_wininet FAIL [stats categories]") }
    let total_check = 0
    let i = 0
    while i < len(stats) {
        total_check = total_check + stats[i][1]
        i = i + 1
    }
    if total_check != 11 { panic("win32_wininet FAIL [stats total] expected=11 got=" + to_string(total_check)) }

    r0_emit("wininet_lookup", "\"name\":\"InternetOpenA\",\"category\":\"" + function_category("InternetOpenA") + "\"")
    r0_emit("wininet_stats", "\"functions\":11,\"categories\":4")

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("win32_wininet FAIL [emit count]") }

    println("  ✅ win32_wininet self_test PASS (11 funcs, 4 categories, URL parser OK, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_mapping(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
        if sub == "parse" && len(a) >= 4 {
            let p = parse_url(a[3])
            println("scheme=" + p[0] + " host=" + p[1] + " path=" + p[2])
            return
        }
    }
    println("usage: hexa run win32_wininet.hexa { self-test | lookup <name> | parse <url> }")
}
