// lib/loader/win32_winhttp.hexa — Win32 WINHTTP stage1 stub
//
// 신규 module — Battle.net Setup 의 WINHTTP imports 위해. WinHttpOpen,
// WinHttpConnect, WinHttpSendRequest, WinHttpReceiveResponse 등. WININET 와
// 비슷한 HTTPS client API.
//
// own 1: Wine 0. Microsoft WinHTTP API spec (learn.microsoft.com/.../winhttp/) 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe WINHTTP imports (pe_imports DLL idx=14, 4 funcs 실측):
//   WinHttpCloseHandle                       — BOOL
//   WinHttpGetIEProxyConfigForCurrentUser    — BOOL
//   WinHttpGetProxyForUrl                    — BOOL
//   WinHttpOpen                              — HINTERNET
//
// stage1 stub policy:
//   HINTERNET return → return 1 (non-NULL handle sentinel)
//   BOOL return      → return 1 (TRUE — success)
//   DWORD return     → return 0 (NO_ERROR)

use "../perf/r0_common"

// ─── stage1 stubs (4 funcs) ───

// HINTERNET WinHttpOpen(LPCWSTR pszAgentW, DWORD dwAccessType, ...)
fn WinHttpOpen() -> int {
    return 1
}

// BOOL WinHttpCloseHandle(HINTERNET hInternet)
fn WinHttpCloseHandle() -> int {
    return 1
}

// BOOL WinHttpGetIEProxyConfigForCurrentUser(WINHTTP_CURRENT_USER_IE_PROXY_CONFIG *pProxyConfig)
fn WinHttpGetIEProxyConfigForCurrentUser() -> int {
    return 1
}

// BOOL WinHttpGetProxyForUrl(HINTERNET hSession, LPCWSTR lpcwszUrl, ...)
fn WinHttpGetProxyForUrl() -> int {
    return 1
}

// ─── stub registry (name → return-class) ───
fn winhttp_stub_table() -> str {
    let t = ""
    t = t + "WinHttpOpen\tHINTERNET\t1\n"
    t = t + "WinHttpCloseHandle\tBOOL\t1\n"
    t = t + "WinHttpGetIEProxyConfigForCurrentUser\tBOOL\t1\n"
    t = t + "WinHttpGetProxyForUrl\tBOOL\t1\n"
    return t
}

fn winhttp_stub_count() -> int {
    let lines = winhttp_stub_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_stub(name: str) -> str {
    let lines = winhttp_stub_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 3 && parts[0] == name {
                return parts[1] + "\t" + parts[2]
            }
        }
        i = i + 1
    }
    return ""
}

fn list_stubs() -> void {
    let lines = winhttp_stub_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 3 {
                println(parts[0] + "\t" + parts[1] + "\treturn=" + parts[2])
            }
        }
        i = i + 1
    }
}

fn self_test() -> void {
    let sid = "winhttptest-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = winhttp_stub_count()
    if sz != 4 { panic("win32_winhttp FAIL [size] expected=4 got=" + to_string(sz)) }

    // Call each stub and verify return value class.
    let r_open = WinHttpOpen()
    if r_open != 1 { panic("win32_winhttp FAIL [WinHttpOpen] expected=1 got=" + to_string(r_open)) }

    let r_close = WinHttpCloseHandle()
    if r_close != 1 { panic("win32_winhttp FAIL [WinHttpCloseHandle] expected=1 got=" + to_string(r_close)) }

    let r_iecfg = WinHttpGetIEProxyConfigForCurrentUser()
    if r_iecfg != 1 { panic("win32_winhttp FAIL [WinHttpGetIEProxyConfigForCurrentUser] expected=1 got=" + to_string(r_iecfg)) }

    let r_proxy = WinHttpGetProxyForUrl()
    if r_proxy != 1 { panic("win32_winhttp FAIL [WinHttpGetProxyForUrl] expected=1 got=" + to_string(r_proxy)) }

    // Lookup table sanity.
    let m = lookup_stub("WinHttpOpen")
    if !m.contains("HINTERNET") { panic("win32_winhttp FAIL [lookup WinHttpOpen]") }

    let unk = lookup_stub("WinHttpUnknownFunc")
    if unk != "" { panic("win32_winhttp FAIL [unknown stub]") }

    r0_emit("winhttp_stub_call", "\"name\":\"WinHttpOpen\",\"ret\":" + to_string(r_open))
    r0_emit("winhttp_stub_count", "\"functions\":4")

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("win32_winhttp FAIL [emit count]") }

    println("  ✅ win32_winhttp self_test PASS (4 functions stubbed, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "list" { list_stubs(); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_stub(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_winhttp.hexa { self-test | list | lookup <name> }")
}
