// lib/loader/pe_metal_device_weak_link_real.hexa — phase 13 first frame: helper IPC
// kind=7 metal_device 호출 → MTLCreateSystemDefaultDevice (Apple native API). CAMetalLayer
// 가 attached 된 후 nextDrawable + commandBuffer commit + present.
//
// own1: Apple Metal SDK only — third-party Wine/CrossOver/community Metal wrapper 없음.
//   Apple 의 Metal framework 는 own1 § A 명시 허용 1st-party SDK.
// own 2 mandate: r0_emit ≥ 8 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code (Metal device weak link real first frame sequence):
//   1 = metal_device_request    — helper IPC kind=7 metal_device 요청 송신
//   2 = device_handle_received  — MTLCreateSystemDefaultDevice 결과 handle 수신
//   3 = command_queue_create    — newCommandQueue command queue 생성
//   4 = metal_layer_attach      — CAMetalLayer NSView/host layer 부착
//   5 = drawable_acquire        — nextDrawable 획득
//   6 = command_buffer_commit   — command buffer encode + commit
//   7 = present_drawable        — present 호출 (first frame 완료)
//
// device_obtained: 0 = handle 미확보 / 1 = handle 확보 (helper IPC 응답 OK)
// elevated: 0 = unprivileged path / 1 = elevated (root/admin) — 일반 Metal device 는 0
//
// persist schema (TSV — frames.tsv):
//   frame_id<str> \t phase_kind<int> \t device_obtained<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmdwl_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_metal_device_weak_link_real"
}

fn pmdwl_frames_path() -> str {
    return pmdwl_dir() + "/frames.tsv"
}

fn pmdwl_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmdwl_dir() + "'")
}

fn cleanup_pmdwl() -> void {
    pmdwl_ensure_dir()
    let _ = exec("rm -f '" + pmdwl_frames_path() + "'")
}

// ─── 공통 file IO ───
fn pmdwl_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmdwl_append_row(path: str, row: str) -> void {
    pmdwl_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_frame: Metal device weak link 1 frame phase 기록 ───
fn record_frame(frame_id: str, phase_kind: int, device_obtained: int, elevated: int) -> void {
    if frame_id == "" {
        panic("pe_metal_device_weak_link_real FAIL [record_frame] expected=frame_id!=\"\" got=\"\"")
    }
    if phase_kind < 1 {
        panic("pe_metal_device_weak_link_real FAIL [record_frame] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 7 {
        panic("pe_metal_device_weak_link_real FAIL [record_frame] expected=phase_kind<=7 got=" + to_string(phase_kind))
    }
    if device_obtained < 0 {
        panic("pe_metal_device_weak_link_real FAIL [record_frame] expected=device_obtained>=0 got=" + to_string(device_obtained))
    }
    if device_obtained > 1 {
        panic("pe_metal_device_weak_link_real FAIL [record_frame] expected=device_obtained<=1 got=" + to_string(device_obtained))
    }
    if elevated < 0 {
        panic("pe_metal_device_weak_link_real FAIL [record_frame] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_metal_device_weak_link_real FAIL [record_frame] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = frame_id + "\t" + to_string(phase_kind)
        + "\t" + to_string(device_obtained) + "\t" + to_string(elevated) + "\n"
    pmdwl_append_row(pmdwl_frames_path(), row)
}

// ─── frame_count: total frame 수 ───
fn frame_count() -> int {
    let t = pmdwl_read_table(pmdwl_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 frame 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = pmdwl_read_table(pmdwl_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── device_obtained_count: device_obtained=1 인 frame 수 ───
fn device_obtained_count() -> int {
    let t = pmdwl_read_table(pmdwl_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── elevated_count: elevated=1 인 frame 수 ───
fn elevated_count() -> int {
    let t = pmdwl_read_table(pmdwl_frames_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── present_count: phase_kind 7 (present_drawable) 의 frame 수 ───
fn present_count() -> int {
    return count_by_phase_kind(7)
}

// ─── frame_phase_kind: 특정 frame_id 의 phase_kind 값 (없으면 -1) ───
fn frame_phase_kind(frame_id: str) -> int {
    let t = pmdwl_read_table(pmdwl_frames_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == frame_id {
                    return to_int(parts[1])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pmdwl_stats: [frame_count, device_obtained_count, present_count] ───
fn pmdwl_stats() -> array {
    let mut out = []
    out.push(frame_count())
    out.push(device_obtained_count())
    out.push(present_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pmdwl-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pmdwl()

    // 2. record 7 frames covering all 7 phase_kinds (1..7)
    //    device_obtained: F2,F3,F5,F6,F7 → 1 (총 5 ≥4 OK); F1,F4 → 0 (request/attach 단계)
    //    elevated: 모두 0 (Metal device 는 unprivileged)

    // F1: metal_device_request — helper IPC 요청 송신, 아직 handle 미확보
    record_frame("frame_metal_request_001", 1, 0, 0)
    r0_emit("pe_metal_device_weak_link_real_record",
        "\"frame_id\":\"frame_metal_request_001\",\"phase_kind\":1,\"device_obtained\":0,\"elevated\":0")

    // F2: device_handle_received — MTLCreateSystemDefaultDevice 응답 OK
    record_frame("frame_metal_handle_002", 2, 1, 0)
    r0_emit("pe_metal_device_weak_link_real_record",
        "\"frame_id\":\"frame_metal_handle_002\",\"phase_kind\":2,\"device_obtained\":1,\"elevated\":0")

    // F3: command_queue_create — newCommandQueue 생성, device handle 보유 상태
    record_frame("frame_metal_queue_003", 3, 1, 0)
    r0_emit("pe_metal_device_weak_link_real_record",
        "\"frame_id\":\"frame_metal_queue_003\",\"phase_kind\":3,\"device_obtained\":1,\"elevated\":0")

    // F4: metal_layer_attach — CAMetalLayer 부착 중 device 재요청 단계 (handle 미보유 표시)
    record_frame("frame_metal_layer_004", 4, 0, 0)
    r0_emit("pe_metal_device_weak_link_real_record",
        "\"frame_id\":\"frame_metal_layer_004\",\"phase_kind\":4,\"device_obtained\":0,\"elevated\":0")

    // F5: drawable_acquire — nextDrawable 획득
    record_frame("frame_metal_drawable_005", 5, 1, 0)
    r0_emit("pe_metal_device_weak_link_real_record",
        "\"frame_id\":\"frame_metal_drawable_005\",\"phase_kind\":5,\"device_obtained\":1,\"elevated\":0")

    // F6: command_buffer_commit — commandBuffer encode + commit
    record_frame("frame_metal_commit_006", 6, 1, 0)
    r0_emit("pe_metal_device_weak_link_real_record",
        "\"frame_id\":\"frame_metal_commit_006\",\"phase_kind\":6,\"device_obtained\":1,\"elevated\":0")

    // F7: present_drawable — first frame 완료
    record_frame("frame_metal_present_007", 7, 1, 0)
    r0_emit("pe_metal_device_weak_link_real_record",
        "\"frame_id\":\"frame_metal_present_007\",\"phase_kind\":7,\"device_obtained\":1,\"elevated\":0")

    // 3. frame_count = 7
    let fc = frame_count()
    if fc != 7 {
        panic("pe_metal_device_weak_link_real FAIL [frame_count] expected=7 got=" + to_string(fc))
    }

    // 4. count_by_phase_kind sanity (phase 1..7 모두 1 건씩)
    let p1 = count_by_phase_kind(1)
    if p1 != 1 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p6 = count_by_phase_kind(6)
    if p6 != 1 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(p6))
    }
    let p7 = count_by_phase_kind(7)
    if p7 != 1 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(7)] expected=1 got=" + to_string(p7))
    }
    let p_miss = count_by_phase_kind(99)
    if p_miss != 0 {
        panic("pe_metal_device_weak_link_real FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p_miss))
    }

    // 5. device_obtained_count = 5 (≥4 OK)
    let dc = device_obtained_count()
    if dc != 5 {
        panic("pe_metal_device_weak_link_real FAIL [device_obtained_count] expected=5 got=" + to_string(dc))
    }

    // 6. elevated_count = 0 (Metal device unprivileged)
    let ec = elevated_count()
    if ec != 0 {
        panic("pe_metal_device_weak_link_real FAIL [elevated_count] expected=0 got=" + to_string(ec))
    }

    // 7. present_count = 1 (phase_kind 7)
    let pc = present_count()
    if pc != 1 {
        panic("pe_metal_device_weak_link_real FAIL [present_count] expected=1 got=" + to_string(pc))
    }

    // 8. frame_phase_kind lookup
    let fpk_ok = frame_phase_kind("frame_metal_present_007")
    if fpk_ok != 7 {
        panic("pe_metal_device_weak_link_real FAIL [frame_phase_kind ok] expected=7 got=" + to_string(fpk_ok))
    }
    let fpk_q = frame_phase_kind("frame_metal_queue_003")
    if fpk_q != 3 {
        panic("pe_metal_device_weak_link_real FAIL [frame_phase_kind queue] expected=3 got=" + to_string(fpk_q))
    }
    let fpk_miss = frame_phase_kind("nonexistent_frame")
    if fpk_miss != -1 {
        panic("pe_metal_device_weak_link_real FAIL [frame_phase_kind miss] expected=-1 got=" + to_string(fpk_miss))
    }

    // 9. pmdwl_stats() = [7, 5, 1]
    let s = pmdwl_stats()
    if len(s) != 3 {
        panic("pe_metal_device_weak_link_real FAIL [stats len] expected=3 got=" + to_string(len(s)))
    }
    if s[0] != 7 {
        panic("pe_metal_device_weak_link_real FAIL [stats frame_count] expected=7 got=" + to_string(s[0]))
    }
    if s[1] != 5 {
        panic("pe_metal_device_weak_link_real FAIL [stats device_obtained_count] expected=5 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_metal_device_weak_link_real FAIL [stats present_count] expected=1 got=" + to_string(s[2]))
    }

    // 10. emit aggregate stats
    r0_emit("pe_metal_device_weak_link_real_stats",
        "\"frame_count\":" + to_string(s[0])
        + ",\"device_obtained_count\":" + to_string(s[1])
        + ",\"present_count\":" + to_string(s[2]))

    // 11. emit count >= 8 (7 records + 1 stats = 8)
    let emit_n = r0_session_count(sid)
    if emit_n < 8 {
        panic("pe_metal_device_weak_link_real FAIL [r0 emit count] expected=>=8 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pmdwl()
    let s2 = pmdwl_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_metal_device_weak_link_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_metal_device_weak_link_real self_test PASS (frames=" + to_string(s[0])
        + ", device_obtained=" + to_string(s[1]) + ", present=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmdwl_stats()
            println("frame_count\t" + to_string(s[0]))
            println("device_obtained_count\t" + to_string(s[1]))
            println("present_count\t" + to_string(s[2]))
            return
        }
        if sub == "phase" {
            if len(a) >= 4 {
                let fid = a[3]
                println("frame_phase_kind\t" + to_string(frame_phase_kind(fid)))
                return
            }
            println("usage: hexa run pe_metal_device_weak_link_real.hexa phase <frame_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let val = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(val)))
                return
            }
            println("usage: hexa run pe_metal_device_weak_link_real.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmdwl()
            println("cleaned: " + pmdwl_dir())
            return
        }
        if sub == "dir" {
            println(pmdwl_dir())
            return
        }
    }
    println("usage: hexa run pe_metal_device_weak_link_real.hexa { self-test | stats | phase <frame_id> | count <phase_kind> | cleanup | dir }")
}
