// lib/loader/pe_gdi_clipping_region.hexa — cycle 78 GDI clipping region bridge skeleton
//
// Win32 GDI clipping region (CreateRectRgn / CreateEllipticRgn /
// CreateRoundRectRgn / CreatePolygonRgn / CombineRgn) → CoreGraphics
// CGContextClip / CGPathRef bridge telemetry. PE loader 가 GDI32 region
// import thunk 를 만나면 region 1 개당 row 1 건 기록.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 region op tracker — 실 GDI / CG 호출 X (stage6 native bridge).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// region_kind code:
//   1 = rect       (CreateRectRgn)
//   2 = elliptic   (CreateEllipticRgn)
//   3 = round_rect (CreateRoundRectRgn)
//   4 = polygon    (CreatePolygonRgn)
//
// combine_mode code:
//   0 = none (생성 직후, CombineRgn 미호출)
//   1 = and  (RGN_AND)
//   2 = or   (RGN_OR)
//   3 = xor  (RGN_XOR)
//   4 = diff (RGN_DIFF)
//   5 = copy (RGN_COPY)
//
// persist schema (TSV — regions.tsv):
//   region_id<int> \t region_kind<int> \t combine_mode<int> \t area_px<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pgcr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_gdi_clipping_region"
}

fn pgcr_regions_path() -> str {
    return pgcr_dir() + "/regions.tsv"
}

fn pgcr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pgcr_dir() + "'")
}

fn cleanup_pgcr() -> void {
    pgcr_ensure_dir()
    let _ = exec("rm -f '" + pgcr_regions_path() + "'")
}

// ─── 공통 file IO ───
fn pgcr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pgcr_append_row(path: str, row: str) -> void {
    pgcr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_region: clipping region 1 건 기록 ───
fn record_region(region_id: int, region_kind: int, combine_mode: int, area_px: int) -> void {
    if region_id <= 0 {
        panic("pe_gdi_clipping_region FAIL [record_region] expected=region_id>0 got=" + to_string(region_id))
    }
    if region_kind < 1 {
        panic("pe_gdi_clipping_region FAIL [record_region] expected=region_kind>=1 got=" + to_string(region_kind))
    }
    if region_kind > 4 {
        panic("pe_gdi_clipping_region FAIL [record_region] expected=region_kind<=4 got=" + to_string(region_kind))
    }
    if combine_mode < 0 {
        panic("pe_gdi_clipping_region FAIL [record_region] expected=combine_mode>=0 got=" + to_string(combine_mode))
    }
    if combine_mode > 5 {
        panic("pe_gdi_clipping_region FAIL [record_region] expected=combine_mode<=5 got=" + to_string(combine_mode))
    }
    if area_px < 0 {
        panic("pe_gdi_clipping_region FAIL [record_region] expected=area_px>=0 got=" + to_string(area_px))
    }
    let row = to_string(region_id) + "\t" + to_string(region_kind)
        + "\t" + to_string(combine_mode) + "\t" + to_string(area_px) + "\n"
    pgcr_append_row(pgcr_regions_path(), row)
}

// ─── region_count: total region 수 ───
fn region_count() -> int {
    let t = pgcr_read_table(pgcr_regions_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_area_px: 모든 region area_px 합 ───
fn total_area_px() -> int {
    let t = pgcr_read_table(pgcr_regions_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_region_kind: 특정 region_kind 의 region 수 ───
fn count_by_region_kind(kind: int) -> int {
    let t = pgcr_read_table(pgcr_regions_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_combine_mode: 특정 combine_mode 의 region 수 ───
fn count_by_combine_mode(mode: int) -> int {
    let t = pgcr_read_table(pgcr_regions_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == mode {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── region_area_px: 특정 region_id 의 area_px (없으면 0) ───
fn region_area_px(region_id: int) -> int {
    let t = pgcr_read_table(pgcr_regions_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == region_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pgcr_stats: [region_count, total_area_px, count_by_region_kind(1), count_by_combine_mode(0)] ───
fn pgcr_stats() -> array {
    let mut out = []
    out.push(region_count())
    out.push(total_area_px())
    out.push(count_by_region_kind(1))
    out.push(count_by_combine_mode(0))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pgcr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pgcr()

    // 2. record 5 regions across ≥3 region_kinds and ≥2 combine_modes
    //    (kinds: 1=rect, 2=elliptic, 3=round_rect; modes: 0=none, 2=or, 4=diff)
    record_region(880001, 1, 0, 4000)
    r0_emit("pe_gdi_clipping_region_record",
        "\"region_id\":880001,\"region_kind\":1,\"combine_mode\":0,\"area_px\":4000,\"target\":\"rect\"")

    record_region(880002, 1, 2, 6000)
    r0_emit("pe_gdi_clipping_region_record",
        "\"region_id\":880002,\"region_kind\":1,\"combine_mode\":2,\"area_px\":6000,\"target\":\"rect\"")

    record_region(880003, 2, 0, 3140)
    r0_emit("pe_gdi_clipping_region_record",
        "\"region_id\":880003,\"region_kind\":2,\"combine_mode\":0,\"area_px\":3140,\"target\":\"elliptic\"")

    record_region(880004, 3, 4, 2500)
    r0_emit("pe_gdi_clipping_region_record",
        "\"region_id\":880004,\"region_kind\":3,\"combine_mode\":4,\"area_px\":2500,\"target\":\"round_rect\"")

    record_region(880005, 2, 2, 1800)
    r0_emit("pe_gdi_clipping_region_record",
        "\"region_id\":880005,\"region_kind\":2,\"combine_mode\":2,\"area_px\":1800,\"target\":\"elliptic\"")

    // 3. region_count = 5
    let c = region_count()
    if c != 5 {
        panic("pe_gdi_clipping_region FAIL [region_count] expected=5 got=" + to_string(c))
    }

    // 4. total_area_px = 17440
    let ta = total_area_px()
    if ta != 17440 {
        panic("pe_gdi_clipping_region FAIL [total_area_px] expected=17440 got=" + to_string(ta))
    }

    // 5. count_by_region_kind sanity
    let k1 = count_by_region_kind(1)
    if k1 != 2 {
        panic("pe_gdi_clipping_region FAIL [count_by_region_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_region_kind(2)
    if k2 != 2 {
        panic("pe_gdi_clipping_region FAIL [count_by_region_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_region_kind(3)
    if k3 != 1 {
        panic("pe_gdi_clipping_region FAIL [count_by_region_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_region_kind(4)
    if k4 != 0 {
        panic("pe_gdi_clipping_region FAIL [count_by_region_kind(4)] expected=0 got=" + to_string(k4))
    }
    let k99 = count_by_region_kind(99)
    if k99 != 0 {
        panic("pe_gdi_clipping_region FAIL [count_by_region_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_combine_mode sanity
    let m0 = count_by_combine_mode(0)
    if m0 != 2 {
        panic("pe_gdi_clipping_region FAIL [count_by_combine_mode(0)] expected=2 got=" + to_string(m0))
    }
    let m2 = count_by_combine_mode(2)
    if m2 != 2 {
        panic("pe_gdi_clipping_region FAIL [count_by_combine_mode(2)] expected=2 got=" + to_string(m2))
    }
    let m4 = count_by_combine_mode(4)
    if m4 != 1 {
        panic("pe_gdi_clipping_region FAIL [count_by_combine_mode(4)] expected=1 got=" + to_string(m4))
    }
    let m1 = count_by_combine_mode(1)
    if m1 != 0 {
        panic("pe_gdi_clipping_region FAIL [count_by_combine_mode(1)] expected=0 got=" + to_string(m1))
    }
    let m99 = count_by_combine_mode(99)
    if m99 != 0 {
        panic("pe_gdi_clipping_region FAIL [count_by_combine_mode(99)] expected=0 got=" + to_string(m99))
    }

    // 7. region_area_px sanity
    let a3 = region_area_px(880003)
    if a3 != 3140 {
        panic("pe_gdi_clipping_region FAIL [region_area_px(880003)] expected=3140 got=" + to_string(a3))
    }
    let a4 = region_area_px(880004)
    if a4 != 2500 {
        panic("pe_gdi_clipping_region FAIL [region_area_px(880004)] expected=2500 got=" + to_string(a4))
    }
    let a_miss = region_area_px(9999)
    if a_miss != 0 {
        panic("pe_gdi_clipping_region FAIL [region_area_px(9999)] expected=0 got=" + to_string(a_miss))
    }

    // 8. pgcr_stats() = [5, 17440, 2, 2]
    let s = pgcr_stats()
    if len(s) != 4 {
        panic("pe_gdi_clipping_region FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_gdi_clipping_region FAIL [stats region_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 17440 {
        panic("pe_gdi_clipping_region FAIL [stats total_area_px] expected=17440 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_gdi_clipping_region FAIL [stats kind_rect] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_gdi_clipping_region FAIL [stats mode_none] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_gdi_clipping_region_stats",
        "\"region_count\":" + to_string(s[0])
        + ",\"total_area_px\":" + to_string(s[1])
        + ",\"kind_rect\":" + to_string(s[2])
        + ",\"mode_none\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_gdi_clipping_region FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pgcr()
    let s2 = pgcr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_gdi_clipping_region FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_gdi_clipping_region self_test PASS (regions=" + to_string(s[0])
        + ", area=" + to_string(s[1]) + ", kind_rect=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pgcr_stats()
            println("region_count\t" + to_string(s[0]))
            println("total_area_px\t" + to_string(s[1]))
            println("count_kind_rect\t" + to_string(s[2]))
            println("count_mode_none\t" + to_string(s[3]))
            return
        }
        if sub == "area" {
            if len(a) >= 4 {
                let rid = to_int(a[3])
                println("region_area_px\t" + to_string(region_area_px(rid)))
                return
            }
            println("usage: hexa run pe_gdi_clipping_region.hexa area <region_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let val = to_int(a[4])
                if dim == "region" {
                    println("count_by_region_kind\t" + to_string(count_by_region_kind(val)))
                    return
                }
                if dim == "mode" {
                    println("count_by_combine_mode\t" + to_string(count_by_combine_mode(val)))
                    return
                }
            }
            println("usage: hexa run pe_gdi_clipping_region.hexa count { region <region_kind> | mode <combine_mode> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pgcr()
            println("cleaned: " + pgcr_dir())
            return
        }
        if sub == "dir" {
            println(pgcr_dir())
            return
        }
    }
    println("usage: hexa run pe_gdi_clipping_region.hexa { self-test | stats | area <region_id> | count region <region_kind> | count mode <combine_mode> | cleanup | dir }")
}
