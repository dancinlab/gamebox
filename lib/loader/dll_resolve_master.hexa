// lib/loader/dll_resolve_master.hexa — Phase 1 stage1 — DLL 통합 resolve 마스터
//
// 18 DLL adapter 의 단일 lookup interface. iat_runtime_bind 는 IAT bytes 패치 담당,
// 본 모듈은 (DLL × symbol) → adapter function reference 단일 SSOT.
//
// stage1: adapter 의 hexa-level proxy — 실 호출 안 하고 metadata 만 반환.
//          stage2 에서 dlopen + dlsym 으로 macOS 실 framework address.

use "../perf/r0_common"

fn dll_aliases(dll: str) -> str {
    let d = dll.to_lower()
    if d == "kernel32" || d == "kernel32.dll" { return "kernel32" }
    if d == "ntdll" || d == "ntdll.dll" { return "ntdll" }
    if d == "msvcrt" || d == "msvcrt.dll" { return "msvcrt" }
    if d == "user32" || d == "user32.dll" { return "user32" }
    if d == "gdi32" || d == "gdi32.dll" { return "gdi32" }
    if d == "shell32" || d == "shell32.dll" { return "shell32" }
    if d == "advapi32" || d == "advapi32.dll" { return "advapi32" }
    if d == "ws2_32" || d == "ws2_32.dll" || d == "winsock" { return "ws2_32" }
    if d == "wininet" || d == "wininet.dll" { return "wininet" }
    if d == "crypt32" || d == "crypt32.dll" { return "crypt32" }
    if d == "rpcrt4" || d == "rpcrt4.dll" { return "rpcrt4" }
    if d == "ole32" || d == "ole32.dll" { return "ole32" }
    if d == "oleaut32" || d == "oleaut32.dll" { return "oleaut32" }
    if d == "wintrust" || d == "wintrust.dll" { return "wintrust" }
    if d == "version" || d == "version.dll" { return "version" }
    if d == "msimg32" || d == "msimg32.dll" { return "msimg32" }
    if d == "uiautomationcore" || d == "uiautomationcore.dll" { return "uiautomationcore" }
    return ""
}

fn dll_count() -> int { return 17 }   // 17 distinct adapters (winsock alias to ws2_32)

fn macos_framework_for(dll: str) -> str {
    let d = dll_aliases(dll)
    if d == "kernel32" { return "Foundation+CoreFoundation" }
    if d == "ntdll" { return "libsystem_kernel" }
    if d == "msvcrt" { return "libSystem.B.dylib" }
    if d == "user32" { return "AppKit" }
    if d == "gdi32" { return "CoreGraphics" }
    if d == "shell32" { return "Foundation+AppKit" }
    if d == "advapi32" { return "Security+OpenDirectory" }
    if d == "ws2_32" { return "libsystem_network" }
    if d == "wininet" { return "Foundation+CFNetwork" }
    if d == "crypt32" { return "Security" }
    if d == "rpcrt4" { return "DCE" }
    if d == "ole32" { return "(custom COM stub)" }
    if d == "oleaut32" { return "(custom Variant stub)" }
    if d == "wintrust" { return "Security" }
    if d == "version" { return "(custom version stub)" }
    if d == "msimg32" { return "CoreGraphics" }
    if d == "uiautomationcore" { return "(custom UIA stub)" }
    return ""
}

fn resolve_status(dll: str, symbol: str) -> str {
    let canon = dll_aliases(dll)
    if canon == "" { return "unknown_dll" }
    if symbol == "" { return "no_symbol" }
    let fw = macos_framework_for(canon)
    if fw == "" { return "no_framework" }
    return "stage1_metadata"
}

fn coverage_overall() -> int {
    return dll_count() * 100 / 18
}

fn self_test() -> void {
    let sid = "drm-" + exec("date +%s").trim()
    r0_session_set(sid)

    if dll_aliases("KERNEL32") != "kernel32" { panic("dll_resolve_master FAIL [alias upper]") }
    if dll_aliases("kernel32.dll") != "kernel32" { panic("dll_resolve_master FAIL [alias dll]") }
    if dll_aliases("foo") != "" { panic("dll_resolve_master FAIL [alias unknown]") }

    if dll_count() != 17 { panic("dll_resolve_master FAIL [count] expected=17") }

    if macos_framework_for("kernel32") == "" { panic("dll_resolve_master FAIL [k32 fw]") }
    if macos_framework_for("foo") != "" { panic("dll_resolve_master FAIL [unknown fw]") }

    let st = resolve_status("kernel32.dll", "CreateFileA")
    if st != "stage1_metadata" { panic("dll_resolve_master FAIL [resolve k32 ok] got=" + st) }

    let st_unk = resolve_status("foo.dll", "Bar")
    if st_unk != "unknown_dll" { panic("dll_resolve_master FAIL [resolve unknown] got=" + st_unk) }

    let st_no = resolve_status("kernel32", "")
    if st_no != "no_symbol" { panic("dll_resolve_master FAIL [resolve no sym]") }

    let cov = coverage_overall()
    if cov < 90 { panic("dll_resolve_master FAIL [coverage] got=" + to_string(cov)) }

    r0_emit("dll_resolve_master_ok", "\"adapters\":17,\"coverage_pct\":" + to_string(cov))

    println("  ✅ dll_resolve_master self_test PASS (17 distinct adapters, kernel32→Foundation+CoreFoundation, coverage=" + to_string(cov) + "%)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "resolve" && len(a) >= 5 {
            println(resolve_status(a[3], a[4]) + "\t" + macos_framework_for(a[3]))
            return
        }
        if sub == "fw" && len(a) >= 4 {
            println(macos_framework_for(a[3]))
            return
        }
    }
    println("usage: hexa run dll_resolve_master.hexa { self-test | resolve <dll> <sym> | fw <dll> }")
}
