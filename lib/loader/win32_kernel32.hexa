// lib/loader/win32_kernel32.hexa — Phase 3a — kernel32 핵심 mapping table (skeleton)
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 Win32 API spec:
//     - File I/O:  https://learn.microsoft.com/en-us/windows/win32/api/fileapi/
//     - Memory:    https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/
//     - Thread:    https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/
//     - Sync:      https://learn.microsoft.com/en-us/windows/win32/api/synchapi/
//     - Process:   https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/
//     - Module:    https://learn.microsoft.com/en-us/windows/win32/api/libloaderapi/
//     - System:    https://learn.microsoft.com/en-us/windows/win32/api/sysinfoapi/
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 2: kernel32_lookup + kernel32_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("win32_kernel32 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 3a — skeleton):
//   50 핵심 kernel32 함수의 *mapping table* 만 정의.
//   각 entry = (Win32 함수명, 대응되는 macOS syscall / libc 호출, 카테고리, status).
//   실제 implementation (mmap / pthread / dlopen 호출 trampoline) 은 Phase 3a 후속.
//
// status 값:
//   "skeleton" — mapping 만 (Phase 3a 현재 모든 entry)
//   "stub"     — default value 만 반환 (호출 시 NOERROR 또는 FALSE)
//   "impl"     — 실제 macOS syscall 실행
//
// 50 함수 카테고리 (실제 분포):
//   FileIO   10  (CreateFileW, ReadFile, WriteFile, CloseHandle, GetFileSize,
//                 SetFilePointer, FlushFileBuffers, DeleteFileW, FindFirstFileW, FindNextFileW)
//   Memory    8  (VirtualAlloc, VirtualFree, VirtualProtect, HeapAlloc,
//                 HeapFree, GetProcessHeap, MapViewOfFile, UnmapViewOfFile)
//   Thread    8  (CreateThread, ExitThread, WaitForSingleObject, GetCurrentThread,
//                 GetCurrentThreadId, SuspendThread, ResumeThread, TerminateThread)
//   Sync      8  (CreateMutexW, ReleaseMutex, CreateEvent, SetEvent,
//                 ResetEvent, EnterCriticalSection, LeaveCriticalSection, InitializeCriticalSection)
//   Process   6  (CreateProcessW, GetCurrentProcess, GetCurrentProcessId,
//                 TerminateProcess, GetStartupInfoW, GetCommandLineW)
//   Module    4  (LoadLibraryW, FreeLibrary, GetProcAddress, GetModuleHandleW)
//   System    6  (GetTickCount, QueryPerformanceCounter, Sleep, GetSystemInfo,
//                 GetEnvironmentVariableW, SetLastError)
//   ──────────
//   total    50  / 7 categories

use "../perf/r0_common"

// ─── 50 함수 mapping table (TSV — name\tmacos_equiv\tcategory\tstatus) ───
//
// 한 줄 = "<Win32 name>\t<macOS equivalent>\t<category>\t<status>"
// 줄 구분자 = "\n". 첫 줄도 의미 entry (header 없음 — 데이터 50줄).
fn kernel32_table() -> str {
    let t = ""
    // FileIO (10)
    t = t + "CreateFileW\topen\tFileIO\tskeleton\n"
    t = t + "ReadFile\tread\tFileIO\tskeleton\n"
    t = t + "WriteFile\twrite\tFileIO\tskeleton\n"
    t = t + "CloseHandle\tclose\tFileIO\tskeleton\n"
    t = t + "GetFileSize\tfstat\tFileIO\tskeleton\n"
    t = t + "SetFilePointer\tlseek\tFileIO\tskeleton\n"
    t = t + "FlushFileBuffers\tfsync\tFileIO\tskeleton\n"
    t = t + "DeleteFileW\tunlink\tFileIO\tskeleton\n"
    t = t + "FindFirstFileW\topendir\tFileIO\tskeleton\n"
    t = t + "FindNextFileW\treaddir\tFileIO\tskeleton\n"
    // Memory (8)
    t = t + "VirtualAlloc\tmmap\tMemory\tskeleton\n"
    t = t + "VirtualFree\tmunmap\tMemory\tskeleton\n"
    t = t + "VirtualProtect\tmprotect\tMemory\tskeleton\n"
    t = t + "HeapAlloc\tmalloc\tMemory\tskeleton\n"
    t = t + "HeapFree\tfree\tMemory\tskeleton\n"
    t = t + "GetProcessHeap\tmalloc_default_zone\tMemory\tskeleton\n"
    t = t + "MapViewOfFile\tmmap\tMemory\tskeleton\n"
    t = t + "UnmapViewOfFile\tmunmap\tMemory\tskeleton\n"
    // Thread (8)
    t = t + "CreateThread\tpthread_create\tThread\tskeleton\n"
    t = t + "ExitThread\tpthread_exit\tThread\tskeleton\n"
    t = t + "WaitForSingleObject\tpthread_join\tThread\tskeleton\n"
    t = t + "GetCurrentThread\tpthread_self\tThread\tskeleton\n"
    t = t + "GetCurrentThreadId\tpthread_mach_thread_np\tThread\tskeleton\n"
    t = t + "SuspendThread\tthread_suspend\tThread\tskeleton\n"
    t = t + "ResumeThread\tthread_resume\tThread\tskeleton\n"
    t = t + "TerminateThread\tpthread_cancel\tThread\tskeleton\n"
    // Sync (8)
    t = t + "CreateMutexW\tpthread_mutex_init\tSync\tskeleton\n"
    t = t + "ReleaseMutex\tpthread_mutex_unlock\tSync\tskeleton\n"
    t = t + "CreateEvent\tpthread_cond_init\tSync\tskeleton\n"
    t = t + "SetEvent\tpthread_cond_signal\tSync\tskeleton\n"
    t = t + "ResetEvent\tpthread_cond_destroy\tSync\tskeleton\n"
    t = t + "EnterCriticalSection\tpthread_mutex_lock\tSync\tskeleton\n"
    t = t + "LeaveCriticalSection\tpthread_mutex_unlock\tSync\tskeleton\n"
    t = t + "InitializeCriticalSection\tpthread_mutex_init\tSync\tskeleton\n"
    // Process (6)
    t = t + "CreateProcessW\tposix_spawn\tProcess\tskeleton\n"
    t = t + "GetCurrentProcess\tgetpid\tProcess\tskeleton\n"
    t = t + "GetCurrentProcessId\tgetpid\tProcess\tskeleton\n"
    t = t + "TerminateProcess\tkill\tProcess\tskeleton\n"
    t = t + "GetStartupInfoW\t_NSGetArgv\tProcess\tskeleton\n"
    t = t + "GetCommandLineW\t_NSGetArgv\tProcess\tskeleton\n"
    // Module (4)
    t = t + "LoadLibraryW\tdlopen\tModule\tskeleton\n"
    t = t + "FreeLibrary\tdlclose\tModule\tskeleton\n"
    t = t + "GetProcAddress\tdlsym\tModule\tskeleton\n"
    t = t + "GetModuleHandleW\tdlopen\tModule\tskeleton\n"
    // System (6)
    t = t + "GetTickCount\tmach_absolute_time\tSystem\tskeleton\n"
    t = t + "QueryPerformanceCounter\tmach_absolute_time\tSystem\tskeleton\n"
    t = t + "Sleep\tusleep\tSystem\tskeleton\n"
    t = t + "GetSystemInfo\tsysctl\tSystem\tskeleton\n"
    t = t + "GetEnvironmentVariableW\tgetenv\tSystem\tskeleton\n"
    t = t + "SetLastError\terrno_assign\tSystem\tskeleton\n"
    return t
}

// ─── table line count (entry 수 = 50) ───
fn kernel32_table_size() -> int {
    let t = kernel32_table()
    let lines = t.split("\n")
    // trailing "\n" → 마지막 빈 element 1 개. count 에서 제외.
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ─── lookup: Win32 함수명 → "<macos>\t<category>\t<status>" 또는 "" ───
fn lookup_mapping(name: str) -> str {
    let t = kernel32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── status only ───
fn function_status(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[2]
    }
    return ""
}

// ─── category only ───
fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[1]
    }
    return ""
}

// ─── macOS equivalent only ───
fn function_macos_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[0]
    }
    return ""
}

// ─── category 통계 ───
//
//   반환: array of [category_name, total_count, impl_count]
//   (hexa stage1 dict 부재 → array of array).
//   impl_count = status == "impl" 인 entry 수 (Phase 3a 현재 모두 0).
fn kernel32_stats() -> array {
    let mut cats = []
    cats.push(["FileIO", 0, 0])
    cats.push(["Memory", 0, 0])
    cats.push(["Thread", 0, 0])
    cats.push(["Sync", 0, 0])
    cats.push(["Process", 0, 0])
    cats.push(["Module", 0, 0])
    cats.push(["System", 0, 0])

    let t = kernel32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cat = parts[2]
                let st = parts[3]
                let j = 0
                while j < len(cats) {
                    if cats[j][0] == cat {
                        cats[j][1] = cats[j][1] + 1
                        if st == "impl" {
                            cats[j][2] = cats[j][2] + 1
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return cats
}

// ─── 전체 impl_count 합 (스카라) ───
fn kernel32_impl_count() -> int {
    let stats = kernel32_stats()
    let n = len(stats)
    let i = 0
    let total = 0
    while i < n {
        total = total + stats[i][2]
        i = i + 1
    }
    return total
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "k32test-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size ≥ 50
    let sz = kernel32_table_size()
    if sz < 50 {
        panic("win32_kernel32 FAIL [table_size] expected=>=50 got=" + to_string(sz))
    }
    if sz != 50 {
        panic("win32_kernel32 FAIL [table_size_exact] expected=50 got=" + to_string(sz))
    }

    // 2. lookup_mapping("CreateFileW") = "open\tFileIO\tskeleton"
    let m_create = lookup_mapping("CreateFileW")
    let exp_create = "open\tFileIO\tskeleton"
    if m_create != exp_create {
        panic("win32_kernel32 FAIL [lookup CreateFileW] expected=" + exp_create + " got=" + m_create)
    }

    // 3. lookup_mapping("VirtualAlloc") = "mmap\tMemory\tskeleton"
    let m_valloc = lookup_mapping("VirtualAlloc")
    let exp_valloc = "mmap\tMemory\tskeleton"
    if m_valloc != exp_valloc {
        panic("win32_kernel32 FAIL [lookup VirtualAlloc] expected=" + exp_valloc + " got=" + m_valloc)
    }

    // 4. lookup_mapping("Sleep") = "usleep\tSystem\tskeleton"
    let m_sleep = lookup_mapping("Sleep")
    let exp_sleep = "usleep\tSystem\tskeleton"
    if m_sleep != exp_sleep {
        panic("win32_kernel32 FAIL [lookup Sleep] expected=" + exp_sleep + " got=" + m_sleep)
    }

    // 5. function_status("CreateFileW") = "skeleton"
    let st = function_status("CreateFileW")
    if st != "skeleton" {
        panic("win32_kernel32 FAIL [function_status CreateFileW] expected=skeleton got=" + st)
    }

    // 5b. unknown name → empty
    let m_unknown = lookup_mapping("NoSuchFunction")
    if m_unknown != "" {
        panic("win32_kernel32 FAIL [lookup unknown] expected=empty got=" + m_unknown)
    }

    // 6. r0_emit "kernel32_lookup" {name, macos}
    let macos_create = function_macos_equiv("CreateFileW")
    r0_emit("kernel32_lookup",
        "\"name\":\"CreateFileW\",\"macos\":\"" + macos_create + "\"")

    // 7. kernel32_stats() ≥ 7 categories with expected counts
    let stats = kernel32_stats()
    let cat_n = len(stats)
    if cat_n < 7 {
        panic("win32_kernel32 FAIL [stats categories] expected=>=7 got=" + to_string(cat_n))
    }
    // 카테고리별 정확한 count 검증
    let i = 0
    let sum_total = 0
    let sum_impl = 0
    while i < cat_n {
        let cn = stats[i][0]
        let ct = stats[i][1]
        let ci = stats[i][2]
        sum_total = sum_total + ct
        sum_impl = sum_impl + ci
        // 카테고리별 정확 count
        if cn == "FileIO" {
            if ct != 10 {
                panic("win32_kernel32 FAIL [stats FileIO count] expected=10 got=" + to_string(ct))
            }
        }
        if cn == "Memory" {
            if ct != 8 {
                panic("win32_kernel32 FAIL [stats Memory count] expected=8 got=" + to_string(ct))
            }
        }
        if cn == "Thread" {
            if ct != 8 {
                panic("win32_kernel32 FAIL [stats Thread count] expected=8 got=" + to_string(ct))
            }
        }
        if cn == "Sync" {
            if ct != 8 {
                panic("win32_kernel32 FAIL [stats Sync count] expected=8 got=" + to_string(ct))
            }
        }
        if cn == "Process" {
            if ct != 6 {
                panic("win32_kernel32 FAIL [stats Process count] expected=6 got=" + to_string(ct))
            }
        }
        if cn == "Module" {
            if ct != 4 {
                panic("win32_kernel32 FAIL [stats Module count] expected=4 got=" + to_string(ct))
            }
        }
        if cn == "System" {
            if ct != 6 {
                panic("win32_kernel32 FAIL [stats System count] expected=6 got=" + to_string(ct))
            }
        }
        i = i + 1
    }
    if sum_total != 50 {
        panic("win32_kernel32 FAIL [stats total sum] expected=50 got=" + to_string(sum_total))
    }
    if sum_impl != 0 {
        panic("win32_kernel32 FAIL [stats impl sum] expected=0 got=" + to_string(sum_impl))
    }

    // 8. r0_emit "kernel32_stats" {table_size, categories, impl_count}
    r0_emit("kernel32_stats",
        "\"table_size\":" + to_string(sz)
        + ",\"categories\":" + to_string(cat_n)
        + ",\"impl_count\":" + to_string(sum_impl))

    // R0 emit count 검증 — 정확히 2 events (kernel32_lookup + kernel32_stats)
    let emit_n = r0_session_count(sid)
    if emit_n != 2 {
        panic("win32_kernel32 FAIL [r0 emit count] expected=2 got=" + to_string(emit_n))
    }

    println("  ✅ win32_kernel32 self_test PASS (50 functions, 7 categories, all skeleton, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "table" {
            print(kernel32_table())
            return
        }
        if sub == "lookup" {
            if len(a) >= 4 {
                let name = a[3]
                let m = lookup_mapping(name)
                if m == "" {
                    println("(not found)")
                } else {
                    println(m)
                }
                return
            }
        }
        if sub == "status" {
            if len(a) >= 4 {
                let name = a[3]
                let s = function_status(name)
                if s == "" {
                    println("(not found)")
                } else {
                    println(s)
                }
                return
            }
        }
        if sub == "stats" {
            let stats = kernel32_stats()
            let n = len(stats)
            let i = 0
            while i < n {
                println(stats[i][0]
                    + "\t" + to_string(stats[i][1])
                    + "\t" + to_string(stats[i][2]))
                i = i + 1
            }
            return
        }
        if sub == "size" {
            println(to_string(kernel32_table_size()))
            return
        }
    }
    println("usage: hexa run win32_kernel32.hexa { self-test | table | lookup <name> | status <name> | stats | size }")
}
