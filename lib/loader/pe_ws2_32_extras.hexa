}

// ─── record_misc_event: inet_pton/inet_ntop row ───
fn record_misc_event(evt_id: int, m_kind: str, addr_str: str, addr_bytes: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_ws2_32_extras FAIL [record_misc_event] evt_id<=0") }
