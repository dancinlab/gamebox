// lib/loader/pe_ws2_32_extras.hexa — WS2_32.dll Winsock advanced surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine ws2_32 source 인용 0.
//       ws2_32.dll 직접 binding 0. macOS BSD socket(2)/kqueue/Network.framework/CFSocket
//       직접 binding 0. NOTE: Track K1 pe_winsock_ws2_32.hexa (basic 20 fn) 의 advanced
//       extension — WSAIoctl/AcceptEx/IOCP overlapped 측 Battle.net D2R/D4 IOCP server
//       pattern + WSAOVERLAPPED/WSABUF/GUID_AcceptEx/sockaddr_in6 struct round-trip baseline.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track AZ2 — WS2_32 advanced/IOCP/async surface 12 fn skeleton-tier.
// cycle 44 230/435 (~52.87%) → cycle 45 ~242/435 (~55.63%) (+12 fn, AZ bundled part 2/4).
// NOTE: Distinct from Track K1 pe_winsock_ws2_32.hexa (basic API).
//
// 대상 fn (12 fn — 4 group, fn_kind 0..11):
//   IOCTL   (3): WSAIoctl(0) / WSARecvFrom(1) / WSASendTo(2)
//   OPTIONS (4): getsockopt(3) / setsockopt(4) / getpeername(5) / getsockname(6)
//   ASYNC   (3): AcceptEx(7) / ConnectEx(8) / DisconnectEx(9)
//   MISC    (2): inet_pton(10) / inet_ntop(11)
//
// synthetic struct families:
//   WSAOVERLAPPED 32B (Internal/Offset/hEvent 0x99010100/Pointer/pad).
//   WSABUF 16B (len 1500 + buf ptr 0x99010200).
//   GUID_AcceptEx 16B LE B5367DF1-CBAC-11CF (WSAID_ACCEPTEX).
//   sockaddr_in 16B: AF_INET + port 1119 BE + 24.105.62.129 Battle.net REST.
//   sockaddr_in6 28B: AF_INET6 + port 443 + addr 16B + scope_id 0.
//   IOCP_completion_port 0x99020000.
//   inet_pton/ntop "192.0.2.1" ↔ 0xC0000201 BE / "2001:db8::1" ↔ 16B LE.
//
// persist schema (TSV — 5 table): syscall_invoke/ioctl_event/option_event/async_event/misc_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwx_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ws2_32_extras"
}

fn pwx_syscall_invoke_path() -> str {
    return pwx_dir() + "/syscall_invoke.tsv"
}

fn pwx_ioctl_event_path() -> str {
    return pwx_dir() + "/ioctl_event.tsv"
}

fn pwx_option_event_path() -> str {
    return pwx_dir() + "/option_event.tsv"
}

fn pwx_async_event_path() -> str {
    return pwx_dir() + "/async_event.tsv"
}

fn pwx_misc_event_path() -> str {
    return pwx_dir() + "/misc_event.tsv"
}

fn pwx_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwx_dir() + "'")
}

fn cleanup_pwx() -> void {
    pwx_ensure_dir()
    let _ = exec("rm -f '" + pwx_syscall_invoke_path() + "' '" + pwx_ioctl_event_path()
        + "' '" + pwx_option_event_path() + "' '" + pwx_async_event_path()
        + "' '" + pwx_misc_event_path() + "'")
}

// ─── 공통 file IO ───
fn pwx_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwx_append_row(path: str, row: str) -> void {
    pwx_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pwx_count_rows(path: str, min_cols: int) -> int {
    let t = pwx_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "WSAIoctl" }
    if k == 1 { return "WSARecvFrom" }
    if k == 2 { return "WSASendTo" }
    if k == 3 { return "getsockopt" }
    if k == 4 { return "setsockopt" }
    if k == 5 { return "getpeername" }
    if k == 6 { return "getsockname" }
    if k == 7 { return "AcceptEx" }
    if k == 8 { return "ConnectEx" }
    if k == 9 { return "DisconnectEx" }
    if k == 10 { return "inet_pton" }
    if k == 11 { return "inet_ntop" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "ioctl"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "options"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "async"
        }
    }
    if k >= 10 {
        if k <= 11 {
            return "misc"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: WS2_32 advanced fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_ws2_32_extras FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_ws2_32_extras FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_ws2_32_extras FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_ws2_32_extras FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_ws2_32_extras FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pwx_append_row(pwx_syscall_invoke_path(), row)
}

// ─── record_ioctl_event: WSAIoctl/WSARecvFrom/WSASendTo row ───
fn record_ioctl_event(evt_id: int, i_kind: str, sock_synth: str, ovl_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_ws2_32_extras FAIL [record_ioctl_event] evt_id<=0") }
    if i_kind == "" { panic("pe_ws2_32_extras FAIL [record_ioctl_event] i_kind=empty") }
    if sock_synth == "" { panic("pe_ws2_32_extras FAIL [record_ioctl_event] sock_synth=empty") }
    if ovl_synth == "" { panic("pe_ws2_32_extras FAIL [record_ioctl_event] ovl_synth=empty") }
    if status == "" { panic("pe_ws2_32_extras FAIL [record_ioctl_event] status=empty") }
    let row = to_string(evt_id) + "\t" + i_kind + "\t" + sock_synth + "\t" + ovl_synth + "\t" + status + "\n"
    pwx_append_row(pwx_ioctl_event_path(), row)
}

