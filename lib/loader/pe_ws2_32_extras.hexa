// ─── record_async_event: AcceptEx/ConnectEx/DisconnectEx row ───
fn record_async_event(evt_id: int, a_kind: str, listen_sock_synth: str, async_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_ws2_32_extras FAIL [record_async_event] evt_id<=0") }
