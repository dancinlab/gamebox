// lib/loader/win32_oleaut32.hexa — Phase 4f — oleaut32 ordinal mapping
//
// own 1: Wine 0. Microsoft OLE Automation spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe oleaut32 imports (실측, 모두 ordinal):
//   #2   = SysAllocString
//   #9   = VariantInit
//   #26  = SysFreeString
//   #411 = VarUI4FromStr
//
// ordinal-based — name 없이 export ordinal index 으로 호출.
// installer 가 BSTR (Basic STRing) handle + VARIANT 으로 COM property 처리.

use "../perf/r0_common"

fn oleaut32_table() -> str {
    let t = ""
    t = t + "2\tSysAllocString\tNSString_alloc\tBSTR\tskeleton\n"
    t = t + "9\tVariantInit\tCFTypeInit\tVARIANT\tskeleton\n"
    t = t + "26\tSysFreeString\tNSString_release\tBSTR\tskeleton\n"
    t = t + "411\tVarUI4FromStr\tatoi\tVARIANT\tskeleton\n"
    return t
}

fn oleaut32_table_size() -> int {
    let lines = oleaut32_table().split("\n")
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

// ordinal → "name\tmacos\tcategory\tstatus" or ""
fn lookup_ordinal(ordinal: int) -> str {
    let lines = oleaut32_table().split("\n")
    let n = len(lines)
    let i = 0
    let target = to_string(ordinal)
    while i < n {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 5 && parts[0] == target {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3] + "\t" + parts[4]
            }
        }
        i = i + 1
    }
    return ""
}

fn ordinal_to_name(ordinal: int) -> str {
    let m = lookup_ordinal(ordinal)
    if m == "" { return "" }
    let parts = m.split("\t")
    if len(parts) < 1 { return "" }
    return parts[0]
}

fn self_test() -> void {
    let sid = "oleaut32test-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = oleaut32_table_size()
    if sz != 4 { panic("win32_oleaut32 FAIL [size] expected=4 got=" + to_string(sz)) }

    let m_2 = lookup_ordinal(2)
    if !m_2.contains("SysAllocString") { panic("win32_oleaut32 FAIL [#2] got=" + m_2) }

    let m_9 = lookup_ordinal(9)
    if !m_9.contains("VariantInit") { panic("win32_oleaut32 FAIL [#9]") }

    let m_26 = lookup_ordinal(26)
    if !m_26.contains("SysFreeString") { panic("win32_oleaut32 FAIL [#26]") }

    let m_411 = lookup_ordinal(411)
    if !m_411.contains("VarUI4FromStr") { panic("win32_oleaut32 FAIL [#411]") }

    let unk = lookup_ordinal(99999)
    if unk != "" { panic("win32_oleaut32 FAIL [unknown ordinal]") }

    let n_2 = ordinal_to_name(2)
    if n_2 != "SysAllocString" { panic("win32_oleaut32 FAIL [name #2] got=" + n_2) }

    r0_emit("oleaut32_lookup", "\"ordinal\":2,\"name\":\"" + n_2 + "\"")
    r0_emit("oleaut32_stats", "\"functions\":" + to_string(sz))

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("win32_oleaut32 FAIL [emit count]") }

    println("  ✅ win32_oleaut32 self_test PASS (4 ordinals, BSTR+VARIANT, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "table" { println(oleaut32_table()); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_ordinal(to_int(a[3]))
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_oleaut32.hexa { self-test | table | lookup <ordinal> }")
}
