// lib/loader/pe_seh_unwind.hexa — Win32 SEH stack unwind telemetry skeleton
//
// RtlUnwind / __C_specific_handler 가 frame chain 을 walk 하며 __finally /
// __except dispatcher 를 호출. C++ destructor semantics 보장의 핵심 경로.
// 본 module 은 unwind event tracker — 실제 RtlUnwind() 호출 X (cycle 70 stage1).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// unwind_kind code:
//   1 = normal (정상 함수 종료 — frame teardown)
//   2 = exception (SEH __except 발동 — exception filter 매칭)
//   3 = longjmp (setjmp/longjmp — non-local goto)
//   4 = goto_finally (__leave / goto-out-of-try — __finally chain)
//
// persist schema (TSV — unwinds.tsv):
//   unwind_id<int> \t unwind_kind<int> \t frames_walked<int> \t elapsed_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn psu_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_seh_unwind"
}

fn psu_unwinds_path() -> str {
    return psu_dir() + "/unwinds.tsv"
}

fn psu_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + psu_dir() + "'")
}

fn cleanup_psu() -> void {
    psu_ensure_dir()
    let _ = exec("rm -f '" + psu_unwinds_path() + "'")
}

// ─── 공통 file IO ───
fn psu_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn psu_append_row(path: str, row: str) -> void {
    psu_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_unwind: unwind 1 건 기록 ───
fn record_unwind(unwind_id: int, unwind_kind: int, frames_walked: int, elapsed_us: int) -> void {
    if unwind_id <= 0 {
        panic("pe_seh_unwind FAIL [record_unwind] expected=unwind_id>0 got=" + to_string(unwind_id))
    }
    if unwind_kind < 1 {
        panic("pe_seh_unwind FAIL [record_unwind] expected=unwind_kind>=1 got=" + to_string(unwind_kind))
    }
    if unwind_kind > 4 {
        panic("pe_seh_unwind FAIL [record_unwind] expected=unwind_kind<=4 got=" + to_string(unwind_kind))
    }
    if frames_walked < 0 {
        panic("pe_seh_unwind FAIL [record_unwind] expected=frames_walked>=0 got=" + to_string(frames_walked))
    }
    if elapsed_us < 0 {
        panic("pe_seh_unwind FAIL [record_unwind] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    let row = to_string(unwind_id) + "\t" + to_string(unwind_kind)
        + "\t" + to_string(frames_walked) + "\t" + to_string(elapsed_us) + "\n"
    psu_append_row(psu_unwinds_path(), row)
}

// ─── unwind_count: total unwind 수 ───
fn unwind_count() -> int {
    let t = psu_read_table(psu_unwinds_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_frames_walked: 모든 unwind frames_walked 합 ───
fn total_frames_walked() -> int {
    let t = psu_read_table(psu_unwinds_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_elapsed_us: 모든 unwind elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = psu_read_table(psu_unwinds_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_unwind_kind: 특정 unwind_kind 의 unwind 수 ───
fn count_by_unwind_kind(kind: int) -> int {
    let t = psu_read_table(psu_unwinds_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── unwind_frames: 특정 unwind_id 의 frames_walked (없으면 0) ───
fn unwind_frames(unwind_id: int) -> int {
    let t = psu_read_table(psu_unwinds_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == unwind_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── psu_stats: [unwind_count, total_frames_walked, total_elapsed_us, count_by_unwind_kind(2)] ───
fn psu_stats() -> array {
    let mut out = []
    out.push(unwind_count())
    out.push(total_frames_walked())
    out.push(total_elapsed_us())
    out.push(count_by_unwind_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "psu-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_psu()

    // 2. record 5 unwinds across ≥3 unwind_kinds (1=normal, 2=exception, 3=longjmp, 4=goto_finally)
    record_unwind(170001, 1, 3, 12)
    r0_emit("pe_seh_unwind_record",
        "\"unwind_id\":170001,\"unwind_kind\":1,\"frames_walked\":3,\"elapsed_us\":12,\"target\":\"normal\"")

    record_unwind(170002, 2, 7, 84)
    r0_emit("pe_seh_unwind_record",
        "\"unwind_id\":170002,\"unwind_kind\":2,\"frames_walked\":7,\"elapsed_us\":84,\"target\":\"exception\"")

    record_unwind(170003, 3, 5, 41)
    r0_emit("pe_seh_unwind_record",
        "\"unwind_id\":170003,\"unwind_kind\":3,\"frames_walked\":5,\"elapsed_us\":41,\"target\":\"longjmp\"")

    record_unwind(170004, 2, 4, 63)
    r0_emit("pe_seh_unwind_record",
        "\"unwind_id\":170004,\"unwind_kind\":2,\"frames_walked\":4,\"elapsed_us\":63,\"target\":\"exception\"")

    record_unwind(170005, 4, 2, 19)
    r0_emit("pe_seh_unwind_record",
        "\"unwind_id\":170005,\"unwind_kind\":4,\"frames_walked\":2,\"elapsed_us\":19,\"target\":\"goto_finally\"")

    // 3. unwind_count = 5
    let c = unwind_count()
    if c != 5 {
        panic("pe_seh_unwind FAIL [unwind_count] expected=5 got=" + to_string(c))
    }

    // 4. total_frames_walked = 21
    let tf = total_frames_walked()
    if tf != 21 {
        panic("pe_seh_unwind FAIL [total_frames_walked] expected=21 got=" + to_string(tf))
    }

    // 5. total_elapsed_us = 219
    let te = total_elapsed_us()
    if te != 219 {
        panic("pe_seh_unwind FAIL [total_elapsed_us] expected=219 got=" + to_string(te))
    }

    // 6. count_by_unwind_kind sanity
    let k1 = count_by_unwind_kind(1)
    if k1 != 1 {
        panic("pe_seh_unwind FAIL [count_by_unwind_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_unwind_kind(2)
    if k2 != 2 {
        panic("pe_seh_unwind FAIL [count_by_unwind_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_unwind_kind(3)
    if k3 != 1 {
        panic("pe_seh_unwind FAIL [count_by_unwind_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_unwind_kind(4)
    if k4 != 1 {
        panic("pe_seh_unwind FAIL [count_by_unwind_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_unwind_kind(99)
    if k99 != 0 {
        panic("pe_seh_unwind FAIL [count_by_unwind_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. unwind_frames sanity
    let f2 = unwind_frames(170002)
    if f2 != 7 {
        panic("pe_seh_unwind FAIL [unwind_frames(170002)] expected=7 got=" + to_string(f2))
    }
    let f3 = unwind_frames(170003)
    if f3 != 5 {
        panic("pe_seh_unwind FAIL [unwind_frames(170003)] expected=5 got=" + to_string(f3))
    }
    let f_miss = unwind_frames(9999)
    if f_miss != 0 {
        panic("pe_seh_unwind FAIL [unwind_frames(9999)] expected=0 got=" + to_string(f_miss))
    }

    // 8. psu_stats() = [5, 21, 219, 2]
    let s = psu_stats()
    if len(s) != 4 {
        panic("pe_seh_unwind FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_seh_unwind FAIL [stats unwind_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 21 {
        panic("pe_seh_unwind FAIL [stats total_frames_walked] expected=21 got=" + to_string(s[1]))
    }
    if s[2] != 219 {
        panic("pe_seh_unwind FAIL [stats total_elapsed_us] expected=219 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_seh_unwind FAIL [stats count_kind(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_seh_unwind_stats",
        "\"unwind_count\":" + to_string(s[0])
        + ",\"total_frames_walked\":" + to_string(s[1])
        + ",\"total_elapsed_us\":" + to_string(s[2])
        + ",\"kind_exception\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_seh_unwind FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_psu()
    let s2 = psu_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_seh_unwind FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_seh_unwind self_test PASS (unwinds=" + to_string(s[0])
        + ", frames=" + to_string(s[1]) + ", elapsed_us=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = psu_stats()
            println("unwind_count\t" + to_string(s[0]))
            println("total_frames_walked\t" + to_string(s[1]))
            println("total_elapsed_us\t" + to_string(s[2]))
            println("count_kind_exception\t" + to_string(s[3]))
            return
        }
        if sub == "frames" {
            if len(a) >= 4 {
                let uid = to_int(a[3])
                println("unwind_frames\t" + to_string(unwind_frames(uid)))
                return
            }
            println("usage: hexa run pe_seh_unwind.hexa frames <unwind_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_unwind_kind\t" + to_string(count_by_unwind_kind(kind)))
                return
            }
            println("usage: hexa run pe_seh_unwind.hexa count <unwind_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_psu()
            println("cleaned: " + psu_dir())
            return
        }
        if sub == "dir" {
            println(psu_dir())
            return
        }
    }
    println("usage: hexa run pe_seh_unwind.hexa { self-test | stats | frames <unwind_id> | count <unwind_kind> | cleanup | dir }")
}
