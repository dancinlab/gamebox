// lib/loader/pe_d4_specific_track.hexa — cycle 82 보너스: Diablo 4 전용 launch chain tracker
//
// D4-specific launch chain (own2 자체 추적):
//   process_attach        — Diablo IV.exe entry
//   fenris_init           — Fenris (D4 internal engine) startup
//   cas_storage_load      — CAS (Content Addressable Storage) — Battle.net 분산 chunk store
//   bnet_token_validate   — required online check (offline mode X)
//   dx12_device_init      — DX12 ID3D12Device + IDXGISwapChain1 (DX11 미지원)
//   pso_warm              — pipeline state precompile (cold-launch hitch 큰 영역)
//   ui_layer              — UI front-end + character select
//   first_frame           — Metal swapchain present (D3DMetal 위임)
//   D4 = DX12 only → R5 D3D12 phase 2 (cycle 81 pe_d3d12_pipeline_state) 강결합
// own1: D4 공개 정보 + binary observation. Wine D4 wrapper 인용 X
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = process_attach
//   2 = fenris_init
//   3 = cas_storage_load
//   4 = bnet_token_validate
//   5 = dx12_device_init
//   6 = pso_warm
//   7 = ui_layer
//   8 = first_frame
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t shader_count<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pd4st_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d4_specific_track"
}

fn pd4st_steps_path() -> str {
    return pd4st_dir() + "/steps.tsv"
}

fn pd4st_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pd4st_dir() + "'")
}

fn cleanup_pd4st() -> void {
    pd4st_ensure_dir()
    let _ = exec("rm -f '" + pd4st_steps_path() + "'")
}

// ─── 공통 file IO ───
fn pd4st_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pd4st_append_row(path: str, row: str) -> void {
    pd4st_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_step: D4 launch step 1 건 기록 ───
fn record_step(step_id: int, phase_kind: int, shader_count: int, elevated: int) -> void {
    if step_id <= 0 {
        panic("pe_d4_specific_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_d4_specific_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 8 {
        panic("pe_d4_specific_track FAIL [record_step] expected=phase_kind<=8 got=" + to_string(phase_kind))
    }
    if shader_count < 0 {
        panic("pe_d4_specific_track FAIL [record_step] expected=shader_count>=0 got=" + to_string(shader_count))
    }
    if elevated < 0 {
        panic("pe_d4_specific_track FAIL [record_step] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_d4_specific_track FAIL [record_step] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(shader_count) + "\t" + to_string(elevated) + "\n"
    pd4st_append_row(pd4st_steps_path(), row)
}

// ─── step_count: total step 수 ───
fn step_count() -> int {
    let t = pd4st_read_table(pd4st_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 step 수 ───
fn count_by_phase_kind(kind: int) -> int {
    let t = pd4st_read_table(pd4st_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_shader_count: 모든 step shader_count 합 ───
fn total_shader_count() -> int {
    let t = pd4st_read_table(pd4st_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── elevated_count: elevated=1 인 step 수 ───
fn elevated_count() -> int {
    let t = pd4st_read_table(pd4st_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── dx12_init_count: phase_kind=5 step 수 ───
fn dx12_init_count() -> int {
    return count_by_phase_kind(5)
}

// ─── step_shader_count: 특정 step_id 의 shader_count (없으면 0) ───
fn step_shader_count(step_id: int) -> int {
    let t = pd4st_read_table(pd4st_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pd4st_stats: [step_count, total_shader_count, elevated_count, dx12_init_count] ───
fn pd4st_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(total_shader_count())
    out.push(elevated_count())
    out.push(dx12_init_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pd4st-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pd4st()

    // 2. record 8 steps (phase_kind 1..8 모두 cover)
    record_step(820001, 1, 0, 0)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820001,\"phase_kind\":1,\"shader_count\":0,\"elevated\":0,\"target\":\"process_attach\"")

    record_step(820002, 2, 0, 0)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820002,\"phase_kind\":2,\"shader_count\":0,\"elevated\":0,\"target\":\"fenris_init\"")

    record_step(820003, 3, 0, 0)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820003,\"phase_kind\":3,\"shader_count\":0,\"elevated\":0,\"target\":\"cas_storage_load\"")

    record_step(820004, 4, 0, 1)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820004,\"phase_kind\":4,\"shader_count\":0,\"elevated\":1,\"target\":\"bnet_token_validate\"")

    record_step(820005, 5, 64, 0)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820005,\"phase_kind\":5,\"shader_count\":64,\"elevated\":0,\"target\":\"dx12_device_init\"")

    record_step(820006, 6, 1024, 0)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820006,\"phase_kind\":6,\"shader_count\":1024,\"elevated\":0,\"target\":\"pso_warm\"")

    record_step(820007, 7, 32, 0)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820007,\"phase_kind\":7,\"shader_count\":32,\"elevated\":0,\"target\":\"ui_layer\"")

    record_step(820008, 8, 16, 0)
    r0_emit("pe_d4_specific_track_record",
        "\"step_id\":820008,\"phase_kind\":8,\"shader_count\":16,\"elevated\":0,\"target\":\"first_frame\"")

    // 3. step_count = 8
    let c = step_count()
    if c != 8 {
        panic("pe_d4_specific_track FAIL [step_count] expected=8 got=" + to_string(c))
    }

    // 4. total_shader_count = 0+0+0+0+64+1024+32+16 = 1136
    let ts = total_shader_count()
    if ts != 1136 {
        panic("pe_d4_specific_track FAIL [total_shader_count] expected=1136 got=" + to_string(ts))
    }

    // 5. count_by_phase_kind sanity (각 phase_kind = 1)
    let k1 = count_by_phase_kind(1)
    if k1 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_phase_kind(2)
    if k2 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_phase_kind(3)
    if k3 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_phase_kind(4)
    if k4 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_phase_kind(5)
    if k5 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k6 = count_by_phase_kind(6)
    if k6 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(k6))
    }
    let k7 = count_by_phase_kind(7)
    if k7 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(7)] expected=1 got=" + to_string(k7))
    }
    let k8 = count_by_phase_kind(8)
    if k8 != 1 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(8)] expected=1 got=" + to_string(k8))
    }
    let k99 = count_by_phase_kind(99)
    if k99 != 0 {
        panic("pe_d4_specific_track FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. elevated_count = 1 (bnet_token_validate)
    let ec = elevated_count()
    if ec != 1 {
        panic("pe_d4_specific_track FAIL [elevated_count] expected=1 got=" + to_string(ec))
    }

    // 7. dx12_init_count = 1
    let dc = dx12_init_count()
    if dc != 1 {
        panic("pe_d4_specific_track FAIL [dx12_init_count] expected=1 got=" + to_string(dc))
    }

    // 8. step_shader_count sanity
    let sh6 = step_shader_count(820006)
    if sh6 != 1024 {
        panic("pe_d4_specific_track FAIL [step_shader_count(820006)] expected=1024 got=" + to_string(sh6))
    }
    let sh5 = step_shader_count(820005)
    if sh5 != 64 {
        panic("pe_d4_specific_track FAIL [step_shader_count(820005)] expected=64 got=" + to_string(sh5))
    }
    let sh_miss = step_shader_count(9999)
    if sh_miss != 0 {
        panic("pe_d4_specific_track FAIL [step_shader_count(9999)] expected=0 got=" + to_string(sh_miss))
    }

    // 9. pd4st_stats() = [8, 1136, 1, 1]
    let s = pd4st_stats()
    if len(s) != 4 {
        panic("pe_d4_specific_track FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_d4_specific_track FAIL [stats step_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 1136 {
        panic("pe_d4_specific_track FAIL [stats total_shader_count] expected=1136 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_d4_specific_track FAIL [stats elevated_count] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_d4_specific_track FAIL [stats dx12_init_count] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_d4_specific_track_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"total_shader_count\":" + to_string(s[1])
        + ",\"elevated_count\":" + to_string(s[2])
        + ",\"dx12_init_count\":" + to_string(s[3]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_d4_specific_track FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pd4st()
    let s2 = pd4st_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d4_specific_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d4_specific_track self_test PASS (steps=" + to_string(s[0])
        + ", shaders=" + to_string(s[1]) + ", elevated=" + to_string(s[2])
        + ", dx12=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pd4st_stats()
            println("step_count\t" + to_string(s[0]))
            println("total_shader_count\t" + to_string(s[1]))
            println("elevated_count\t" + to_string(s[2]))
            println("dx12_init_count\t" + to_string(s[3]))
            return
        }
        if sub == "shaders" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_shader_count\t" + to_string(step_shader_count(sid)))
                return
            }
            println("usage: hexa run pe_d4_specific_track.hexa shaders <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(kind)))
                return
            }
            println("usage: hexa run pe_d4_specific_track.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pd4st()
            println("cleaned: " + pd4st_dir())
            return
        }
        if sub == "dir" {
            println(pd4st_dir())
            return
        }
    }
    println("usage: hexa run pe_d4_specific_track.hexa { self-test | stats | shaders <step_id> | count <phase_kind> | cleanup | dir }")
}
