// lib/loader/win32_winsock.hexa — Phase 6 — Winsock 2 → BSD sockets mapping table (skeleton)
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 Winsock 2 / WinHTTP API spec:
//     - Winsock 2:    https://learn.microsoft.com/en-us/windows/win32/api/winsock2/
//     - WinSock:      https://learn.microsoft.com/en-us/windows/win32/api/winsock/
//     - WS2_32:       https://learn.microsoft.com/en-us/windows/win32/winsock/winsock-reference
//     - WinHTTP:      https://learn.microsoft.com/en-us/windows/win32/api/winhttp/
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 2: winsock_lookup + winsock_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("win32_winsock FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 6 — skeleton):
//   ~25 핵심 Winsock 2 + WinHTTP 함수의 *mapping table* 만 정의.
//   각 entry = (Winsock 함수명, 대응되는 macOS BSD socket / libc 호출, 카테고리, status).
//   실제 implementation (socket / sendto / curl trampoline) 은 Phase 6 후속.
//
// status 값:
//   "skeleton" — mapping 만 (Phase 6 현재 모든 entry)
//   "stub"     — default value 만 반환 (호출 시 0 / SOCKET_ERROR)
//   "impl"     — 실제 macOS BSD socket 호출 실행
//
// 25 함수 카테고리 (실제 분포):
//   Init     3   (WSAStartup, WSACleanup, WSAGetLastError)
//   Socket   5   (socket, closesocket, shutdown, ioctlsocket, setsockopt)
//   Address  5   (bind, listen, accept, connect, getpeername)
//   IO       6   (send, recv, sendto, recvfrom, select, WSARecv)
//   Resolve  4   (gethostbyname, gethostbyaddr, getaddrinfo, freeaddrinfo)
//   WinHTTP  2   (WinHttpOpen, WinHttpSendRequest)
//   ──────────
//   total   25   / 6 categories

use "../perf/r0_common"

// ─── 25 함수 mapping table (TSV — name\tmacos_equiv\tcategory\tstatus) ───
//
// 한 줄 = "<Winsock name>\t<macOS equivalent>\t<category>\t<status>"
// 줄 구분자 = "\n". 첫 줄도 의미 entry (header 없음 — 데이터 25줄).
fn winsock_table() -> str {
    let t = ""
    // Init (3)
    t = t + "WSAStartup\tnoop\tInit\tskeleton\n"
    t = t + "WSACleanup\tnoop\tInit\tskeleton\n"
    t = t + "WSAGetLastError\terrno\tInit\tskeleton\n"
    // Socket (5)
    t = t + "socket\tsocket\tSocket\tskeleton\n"
    t = t + "closesocket\tclose\tSocket\tskeleton\n"
    t = t + "shutdown\tshutdown\tSocket\tskeleton\n"
    t = t + "ioctlsocket\tioctl\tSocket\tskeleton\n"
    t = t + "setsockopt\tsetsockopt\tSocket\tskeleton\n"
    // Address (5)
    t = t + "bind\tbind\tAddress\tskeleton\n"
    t = t + "listen\tlisten\tAddress\tskeleton\n"
    t = t + "accept\taccept\tAddress\tskeleton\n"
    t = t + "connect\tconnect\tAddress\tskeleton\n"
    t = t + "getpeername\tgetpeername\tAddress\tskeleton\n"
    // IO (6)
    t = t + "send\tsend\tIO\tskeleton\n"
    t = t + "recv\trecv\tIO\tskeleton\n"
    t = t + "sendto\tsendto\tIO\tskeleton\n"
    t = t + "recvfrom\trecvfrom\tIO\tskeleton\n"
    t = t + "select\tselect\tIO\tskeleton\n"
    t = t + "WSARecv\trecvmsg\tIO\tskeleton\n"
    // Resolve (4)
    t = t + "gethostbyname\tgetaddrinfo\tResolve\tskeleton\n"
    t = t + "gethostbyaddr\tgetaddrinfo_reverse\tResolve\tskeleton\n"
    t = t + "getaddrinfo\tgetaddrinfo\tResolve\tskeleton\n"
    t = t + "freeaddrinfo\tfreeaddrinfo\tResolve\tskeleton\n"
    // WinHTTP (2)
    t = t + "WinHttpOpen\tcurl_init\tWinHTTP\tskeleton\n"
    t = t + "WinHttpSendRequest\tcurl_perform\tWinHTTP\tskeleton\n"
    return t
}

// ─── table line count (entry 수 = 25) ───
fn winsock_table_size() -> int {
    let t = winsock_table()
    let lines = t.split("\n")
    // trailing "\n" → 마지막 빈 element 1 개. count 에서 제외.
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ─── lookup: Winsock 함수명 → "<macos>\t<category>\t<status>" 또는 "" ───
fn lookup_mapping(name: str) -> str {
    let t = winsock_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── status only ───
fn function_status(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[2]
    }
    return ""
}

// ─── category only ───
fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[1]
    }
    return ""
}

// ─── macOS equivalent only ───
fn function_macos_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[0]
    }
    return ""
}

// ─── category 통계 ───
//
//   반환: array of [category_name, total_count, impl_count]
//   (hexa stage1 dict 부재 → array of array).
//   impl_count = status == "impl" 인 entry 수 (Phase 6 현재 모두 0).
fn winsock_stats() -> array {
    let mut cats = []
    cats.push(["Init", 0, 0])
    cats.push(["Socket", 0, 0])
    cats.push(["Address", 0, 0])
    cats.push(["IO", 0, 0])
    cats.push(["Resolve", 0, 0])
    cats.push(["WinHTTP", 0, 0])

    let t = winsock_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cat = parts[2]
                let st = parts[3]
                let j = 0
                while j < len(cats) {
                    if cats[j][0] == cat {
                        cats[j][1] = cats[j][1] + 1
                        if st == "impl" {
                            cats[j][2] = cats[j][2] + 1
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return cats
}

// ─── 전체 impl_count 합 (스카라) ───
fn winsock_impl_count() -> int {
    let stats = winsock_stats()
    let n = len(stats)
    let i = 0
    let total = 0
    while i < n {
        total = total + stats[i][2]
        i = i + 1
    }
    return total
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "wsktest-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size ≥ 22 (spec: ~25 — exact 25)
    let sz = winsock_table_size()
    if sz < 22 {
        panic("win32_winsock FAIL [table_size] expected=>=22 got=" + to_string(sz))
    }
    if sz != 25 {
        panic("win32_winsock FAIL [table_size_exact] expected=25 got=" + to_string(sz))
    }

    // 2. lookup_mapping("WSAStartup") = "noop\tInit\tskeleton"
    let m_wsa = lookup_mapping("WSAStartup")
    let exp_wsa = "noop\tInit\tskeleton"
    if m_wsa != exp_wsa {
        panic("win32_winsock FAIL [lookup WSAStartup] expected=" + exp_wsa + " got=" + m_wsa)
    }

    // 3. lookup_mapping("send") = "send\tIO\tskeleton"
    let m_send = lookup_mapping("send")
    let exp_send = "send\tIO\tskeleton"
    if m_send != exp_send {
        panic("win32_winsock FAIL [lookup send] expected=" + exp_send + " got=" + m_send)
    }

    // 4. lookup_mapping("getaddrinfo") = "getaddrinfo\tResolve\tskeleton"
    let m_gai = lookup_mapping("getaddrinfo")
    let exp_gai = "getaddrinfo\tResolve\tskeleton"
    if m_gai != exp_gai {
        panic("win32_winsock FAIL [lookup getaddrinfo] expected=" + exp_gai + " got=" + m_gai)
    }

    // 5. function_status("WSAStartup") = "skeleton"
    let st = function_status("WSAStartup")
    if st != "skeleton" {
        panic("win32_winsock FAIL [function_status WSAStartup] expected=skeleton got=" + st)
    }

    // 5b. unknown name → empty
    let m_unknown = lookup_mapping("NoSuchWinsockFn")
    if m_unknown != "" {
        panic("win32_winsock FAIL [lookup unknown] expected=empty got=" + m_unknown)
    }

    // 6. r0_emit "winsock_lookup" {name, macos}
    let macos_send = function_macos_equiv("send")
    r0_emit("winsock_lookup",
        "\"name\":\"send\",\"macos\":\"" + macos_send + "\"")

    // 7. winsock_stats() ≥ 5 categories with expected counts (실제 6)
    let stats = winsock_stats()
    let cat_n = len(stats)
    if cat_n < 5 {
        panic("win32_winsock FAIL [stats categories] expected=>=5 got=" + to_string(cat_n))
    }
    if cat_n != 6 {
        panic("win32_winsock FAIL [stats categories exact] expected=6 got=" + to_string(cat_n))
    }
    // 카테고리별 정확한 count 검증
    let i = 0
    let sum_total = 0
    let sum_impl = 0
    while i < cat_n {
        let cn = stats[i][0]
        let ct = stats[i][1]
        let ci = stats[i][2]
        sum_total = sum_total + ct
        sum_impl = sum_impl + ci
        // 카테고리별 정확 count
        if cn == "Init" {
            if ct != 3 {
                panic("win32_winsock FAIL [stats Init count] expected=3 got=" + to_string(ct))
            }
        }
        if cn == "Socket" {
            if ct != 5 {
                panic("win32_winsock FAIL [stats Socket count] expected=5 got=" + to_string(ct))
            }
        }
        if cn == "Address" {
            if ct != 5 {
                panic("win32_winsock FAIL [stats Address count] expected=5 got=" + to_string(ct))
            }
        }
        if cn == "IO" {
            if ct != 6 {
                panic("win32_winsock FAIL [stats IO count] expected=6 got=" + to_string(ct))
            }
        }
        if cn == "Resolve" {
            if ct != 4 {
                panic("win32_winsock FAIL [stats Resolve count] expected=4 got=" + to_string(ct))
            }
        }
        if cn == "WinHTTP" {
            if ct != 2 {
                panic("win32_winsock FAIL [stats WinHTTP count] expected=2 got=" + to_string(ct))
            }
        }
        i = i + 1
    }
    if sum_total != 25 {
        panic("win32_winsock FAIL [stats total sum] expected=25 got=" + to_string(sum_total))
    }
    if sum_impl != 0 {
        panic("win32_winsock FAIL [stats impl sum] expected=0 got=" + to_string(sum_impl))
    }

    // 8. r0_emit "winsock_stats" {table_size, categories, impl_count}
    r0_emit("winsock_stats",
        "\"table_size\":" + to_string(sz)
        + ",\"categories\":" + to_string(cat_n)
        + ",\"impl_count\":" + to_string(sum_impl))

    // R0 emit count 검증 — 정확히 2 events (winsock_lookup + winsock_stats)
    let emit_n = r0_session_count(sid)
    if emit_n != 2 {
        panic("win32_winsock FAIL [r0 emit count] expected=2 got=" + to_string(emit_n))
    }

    println("  ✅ win32_winsock self_test PASS (25 functions, 6 categories, all skeleton, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "table" {
            print(winsock_table())
            return
        }
        if sub == "lookup" {
            if len(a) >= 4 {
                let name = a[3]
                let m = lookup_mapping(name)
                if m == "" {
                    println("(not found)")
                } else {
                    println(m)
                }
                return
            }
        }
        if sub == "status" {
            if len(a) >= 4 {
                let name = a[3]
                let s = function_status(name)
                if s == "" {
                    println("(not found)")
                } else {
                    println(s)
                }
                return
            }
        }
        if sub == "stats" {
            let stats = winsock_stats()
            let n = len(stats)
            let i = 0
            while i < n {
                println(stats[i][0]
                    + "\t" + to_string(stats[i][1])
                    + "\t" + to_string(stats[i][2]))
                i = i + 1
            }
            return
        }
        if sub == "size" {
            println(to_string(winsock_table_size()))
            return
        }
    }
    println("usage: hexa run win32_winsock.hexa { self-test | table | lookup <name> | status <name> | stats | size }")
}
