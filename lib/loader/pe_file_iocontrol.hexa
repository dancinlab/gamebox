// lib/loader/pe_file_iocontrol.hexa — cycle 73 DeviceIoControl IOCTL dispatch telemetry
//
// Game / anticheat code 가 device-specific 정보 (volume info, USB device,
// mounted point info 등) 를 위해 IOCTL 을 호출. 본 module 은 IOCTL dispatch
// tracker — 실제 DeviceIoControl() 호출 X (stage6+).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// category_kind code:
//   1 = disk
//   2 = volume
//   3 = filesystem
//   4 = mountmgr
//   5 = device
//
// persist schema (TSV — ioctls.tsv):
//   ioctl_id<int> \t category_kind<int> \t input_bytes<int> \t output_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pfio_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_file_iocontrol"
}

fn pfio_ioctls_path() -> str {
    return pfio_dir() + "/ioctls.tsv"
}

fn pfio_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pfio_dir() + "'")
}

fn cleanup_pfio() -> void {
    pfio_ensure_dir()
    let _ = exec("rm -f '" + pfio_ioctls_path() + "'")
}

// ─── 공통 file IO ───
fn pfio_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pfio_append_row(path: str, row: str) -> void {
    pfio_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_ioctl: ioctl dispatch 1 건 기록 ───
fn record_ioctl(ioctl_id: int, category_kind: int, input_bytes: int, output_bytes: int) -> void {
    if ioctl_id <= 0 {
        panic("pe_file_iocontrol FAIL [record_ioctl] expected=ioctl_id>0 got=" + to_string(ioctl_id))
    }
    if category_kind < 1 {
        panic("pe_file_iocontrol FAIL [record_ioctl] expected=category_kind>=1 got=" + to_string(category_kind))
    }
    if category_kind > 5 {
        panic("pe_file_iocontrol FAIL [record_ioctl] expected=category_kind<=5 got=" + to_string(category_kind))
    }
    if input_bytes < 0 {
        panic("pe_file_iocontrol FAIL [record_ioctl] expected=input_bytes>=0 got=" + to_string(input_bytes))
    }
    if output_bytes < 0 {
        panic("pe_file_iocontrol FAIL [record_ioctl] expected=output_bytes>=0 got=" + to_string(output_bytes))
    }
    let row = to_string(ioctl_id) + "\t" + to_string(category_kind)
        + "\t" + to_string(input_bytes) + "\t" + to_string(output_bytes) + "\n"
    pfio_append_row(pfio_ioctls_path(), row)
}

// ─── ioctl_count: total ioctl 수 ───
fn ioctl_count() -> int {
    let t = pfio_read_table(pfio_ioctls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_input_bytes: 모든 ioctl input_bytes 합 ───
fn total_input_bytes() -> int {
    let t = pfio_read_table(pfio_ioctls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_output_bytes: 모든 ioctl output_bytes 합 ───
fn total_output_bytes() -> int {
    let t = pfio_read_table(pfio_ioctls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_category: 특정 category_kind 의 ioctl 수 ───
fn count_by_category(kind: int) -> int {
    let t = pfio_read_table(pfio_ioctls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── ioctl_output_bytes: 특정 ioctl_id 의 output_bytes (없으면 0) ───
fn ioctl_output_bytes(ioctl_id: int) -> int {
    let t = pfio_read_table(pfio_ioctls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == ioctl_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pfio_stats: [ioctl_count, total_input_bytes, total_output_bytes, count_by_category(2)] ───
fn pfio_stats() -> array {
    let mut out = []
    out.push(ioctl_count())
    out.push(total_input_bytes())
    out.push(total_output_bytes())
    out.push(count_by_category(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pfio-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pfio()

    // 2. record 5 ioctls across ≥3 categories (deterministic synthetic)
    //    cat 1 (disk)       : 1 row,  input=8,   output=24
    //    cat 2 (volume)     : 2 rows, input=16+0, output=64+128
    //    cat 3 (filesystem) : 1 row,  input=4,   output=32
    //    cat 5 (device)     : 1 row,  input=12,  output=256
    //    totals: input=40, output=504
    record_ioctl(730001, 1, 8, 24)
    r0_emit("pe_file_iocontrol_record",
        "\"ioctl_id\":730001,\"category_kind\":1,\"input_bytes\":8,\"output_bytes\":24,\"target\":\"disk\"")

    record_ioctl(730002, 2, 16, 64)
    r0_emit("pe_file_iocontrol_record",
        "\"ioctl_id\":730002,\"category_kind\":2,\"input_bytes\":16,\"output_bytes\":64,\"target\":\"volume\"")

    record_ioctl(730003, 3, 4, 32)
    r0_emit("pe_file_iocontrol_record",
        "\"ioctl_id\":730003,\"category_kind\":3,\"input_bytes\":4,\"output_bytes\":32,\"target\":\"filesystem\"")

    record_ioctl(730004, 2, 0, 128)
    r0_emit("pe_file_iocontrol_record",
        "\"ioctl_id\":730004,\"category_kind\":2,\"input_bytes\":0,\"output_bytes\":128,\"target\":\"volume\"")

    record_ioctl(730005, 5, 12, 256)
    r0_emit("pe_file_iocontrol_record",
        "\"ioctl_id\":730005,\"category_kind\":5,\"input_bytes\":12,\"output_bytes\":256,\"target\":\"device\"")

    // 3. ioctl_count = 5
    let c = ioctl_count()
    if c != 5 {
        panic("pe_file_iocontrol FAIL [ioctl_count] expected=5 got=" + to_string(c))
    }

    // 4. total_input_bytes = 40
    let ti = total_input_bytes()
    if ti != 40 {
        panic("pe_file_iocontrol FAIL [total_input_bytes] expected=40 got=" + to_string(ti))
    }

    // 5. total_output_bytes = 504
    let to_b = total_output_bytes()
    if to_b != 504 {
        panic("pe_file_iocontrol FAIL [total_output_bytes] expected=504 got=" + to_string(to_b))
    }

    // 6. count_by_category sanity
    let k1 = count_by_category(1)
    if k1 != 1 {
        panic("pe_file_iocontrol FAIL [count_by_category(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_category(2)
    if k2 != 2 {
        panic("pe_file_iocontrol FAIL [count_by_category(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_category(3)
    if k3 != 1 {
        panic("pe_file_iocontrol FAIL [count_by_category(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_category(4)
    if k4 != 0 {
        panic("pe_file_iocontrol FAIL [count_by_category(4)] expected=0 got=" + to_string(k4))
    }
    let k5 = count_by_category(5)
    if k5 != 1 {
        panic("pe_file_iocontrol FAIL [count_by_category(5)] expected=1 got=" + to_string(k5))
    }
    let k99 = count_by_category(99)
    if k99 != 0 {
        panic("pe_file_iocontrol FAIL [count_by_category(99)] expected=0 got=" + to_string(k99))
    }

    // 7. ioctl_output_bytes sanity
    let o2 = ioctl_output_bytes(730002)
    if o2 != 64 {
        panic("pe_file_iocontrol FAIL [ioctl_output_bytes(730002)] expected=64 got=" + to_string(o2))
    }
    let o5 = ioctl_output_bytes(730005)
    if o5 != 256 {
        panic("pe_file_iocontrol FAIL [ioctl_output_bytes(730005)] expected=256 got=" + to_string(o5))
    }
    let o_miss = ioctl_output_bytes(9999)
    if o_miss != 0 {
        panic("pe_file_iocontrol FAIL [ioctl_output_bytes(9999)] expected=0 got=" + to_string(o_miss))
    }

    // 8. pfio_stats() = [5, 40, 504, 2]
    let s = pfio_stats()
    if len(s) != 4 {
        panic("pe_file_iocontrol FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_file_iocontrol FAIL [stats ioctl_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 40 {
        panic("pe_file_iocontrol FAIL [stats total_input_bytes] expected=40 got=" + to_string(s[1]))
    }
    if s[2] != 504 {
        panic("pe_file_iocontrol FAIL [stats total_output_bytes] expected=504 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_file_iocontrol FAIL [stats count_category(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_file_iocontrol_stats",
        "\"ioctl_count\":" + to_string(s[0])
        + ",\"total_input_bytes\":" + to_string(s[1])
        + ",\"total_output_bytes\":" + to_string(s[2])
        + ",\"category_volume\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_file_iocontrol FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pfio()
    let s2 = pfio_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_file_iocontrol FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_file_iocontrol self_test PASS (ioctls=" + to_string(s[0])
        + ", in=" + to_string(s[1]) + ", out=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pfio_stats()
            println("ioctl_count\t" + to_string(s[0]))
            println("total_input_bytes\t" + to_string(s[1]))
            println("total_output_bytes\t" + to_string(s[2]))
            println("count_category_volume\t" + to_string(s[3]))
            return
        }
        if sub == "output" {
            if len(a) >= 4 {
                let iid = to_int(a[3])
                println("ioctl_output_bytes\t" + to_string(ioctl_output_bytes(iid)))
                return
            }
            println("usage: hexa run pe_file_iocontrol.hexa output <ioctl_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_category\t" + to_string(count_by_category(kind)))
                return
            }
            println("usage: hexa run pe_file_iocontrol.hexa count <category_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pfio()
            println("cleaned: " + pfio_dir())
            return
        }
        if sub == "dir" {
            println(pfio_dir())
            return
        }
    }
    println("usage: hexa run pe_file_iocontrol.hexa { self-test | stats | output <ioctl_id> | count <category_kind> | cleanup | dir }")
}
