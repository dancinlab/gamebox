// lib/loader/pe_d3d12_resource_barrier_real.hexa — cycle 81 R5 phase 2
// D3D12 ID3D12GraphicsCommandList::ResourceBarrier 추적.
//
// D3D12 ResourceBarrier → Metal automatic resource tracking (대부분 no-op).
//   D3D12_RESOURCE_BARRIER_TYPE_TRANSITION → Metal automatic hazard tracking (no-op)
//   D3D12_RESOURCE_BARRIER_TYPE_ALIASING   → Metal MTLHeap aliasing (no-op)
//   D3D12_RESOURCE_BARRIER_TYPE_UAV        → MTLResourceBarrier / MTLFence
//   states: 0=common/1=present/2=render_target/3=unordered_access/4=depth_write/5=copy_dest/6=copy_source/7=shader_resource
// own1: D3DMetal 위임 우선 + Apple Metal + MSDN ID3D12CommandList spec only
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 ResourceBarrier tracker — 실 ID3D12GraphicsCommandList 호출 X (D3DMetal 위임 stage).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// barrier_kind code:
//   1 = transition
//   2 = aliasing
//   3 = uav
//
// state code:
//   0 = common
//   1 = present
//   2 = render_target
//   3 = unordered_access
//   4 = depth_write
//   5 = copy_dest
//   6 = copy_source
//   7 = shader_resource
//
// persist schema (TSV — barriers.tsv):
//   barrier_id<int> \t barrier_kind<int> \t before_state<int> \t after_state<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdrb_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3d12_resource_barrier_real"
}

fn pdrb_barriers_path() -> str {
    return pdrb_dir() + "/barriers.tsv"
}

fn pdrb_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdrb_dir() + "'")
}

fn cleanup_pdrb() -> void {
    pdrb_ensure_dir()
    let _ = exec("rm -f '" + pdrb_barriers_path() + "'")
}

// ─── 공통 file IO ───
fn pdrb_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdrb_append_row(path: str, row: str) -> void {
    pdrb_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_barrier: ResourceBarrier 1 건 기록 ───
fn record_barrier(barrier_id: int, barrier_kind: int, before_state: int, after_state: int) -> void {
    if barrier_id <= 0 {
        panic("pe_d3d12_resource_barrier_real FAIL [record_barrier] expected=barrier_id>0 got=" + to_string(barrier_id))
    }
    if barrier_kind < 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [record_barrier] expected=barrier_kind>=1 got=" + to_string(barrier_kind))
    }
    if barrier_kind > 3 {
        panic("pe_d3d12_resource_barrier_real FAIL [record_barrier] expected=barrier_kind<=3 got=" + to_string(barrier_kind))
    }
    if before_state < 0 {
        panic("pe_d3d12_resource_barrier_real FAIL [record_barrier] expected=before_state>=0 got=" + to_string(before_state))
    }
    if before_state > 7 {
        panic("pe_d3d12_resource_barrier_real FAIL [record_barrier] expected=before_state<=7 got=" + to_string(before_state))
    }
    if after_state < 0 {
        panic("pe_d3d12_resource_barrier_real FAIL [record_barrier] expected=after_state>=0 got=" + to_string(after_state))
    }
    if after_state > 7 {
        panic("pe_d3d12_resource_barrier_real FAIL [record_barrier] expected=after_state<=7 got=" + to_string(after_state))
    }
    let row = to_string(barrier_id) + "\t" + to_string(barrier_kind)
        + "\t" + to_string(before_state) + "\t" + to_string(after_state) + "\n"
    pdrb_append_row(pdrb_barriers_path(), row)
}

// ─── barrier_count: total barrier 수 ───
fn barrier_count() -> int {
    let t = pdrb_read_table(pdrb_barriers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_barrier_kind: 특정 barrier_kind 의 barrier 수 ───
fn count_by_barrier_kind(barrier_kind: int) -> int {
    let t = pdrb_read_table(pdrb_barriers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == barrier_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_after_state: 특정 after_state 의 barrier 수 ───
fn count_by_after_state(after_state: int) -> int {
    let t = pdrb_read_table(pdrb_barriers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == after_state {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── transition_count: count_by_barrier_kind(1) ───
fn transition_count() -> int {
    return count_by_barrier_kind(1)
}

// ─── present_transition_count: after_state == 1 (present) 인 row 수 ───
fn present_transition_count() -> int {
    return count_by_after_state(1)
}

// ─── barrier_after_state: 특정 barrier_id 의 after_state (없으면 -1) ───
fn barrier_after_state(barrier_id: int) -> int {
    let t = pdrb_read_table(pdrb_barriers_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == barrier_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pdrb_stats: [barrier_count, transition_count, present_transition_count, count_by_barrier_kind(3)] ───
fn pdrb_stats() -> array {
    let mut out = []
    out.push(barrier_count())
    out.push(transition_count())
    out.push(present_transition_count())
    out.push(count_by_barrier_kind(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdrb-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdrb()

    // 2. record 6 barriers covering ≥3 barrier_kinds + ≥3 states
    //    barrier_kind: 1=transition, 2=aliasing, 3=uav
    //    state: 0=common/1=present/2=render_target/3=unordered_access/4=depth_write/5=copy_dest/6=copy_source/7=shader_resource
    record_barrier(330001, 1, 1, 2)
    r0_emit("pe_d3d12_resource_barrier_real_record",
        "\"barrier_id\":330001,\"barrier_kind\":1,\"before_state\":1,\"after_state\":2,\"target\":\"metal_automatic_tracking_noop\"")

    record_barrier(330002, 1, 2, 1)
    r0_emit("pe_d3d12_resource_barrier_real_record",
        "\"barrier_id\":330002,\"barrier_kind\":1,\"before_state\":2,\"after_state\":1,\"target\":\"metal_automatic_tracking_noop\"")

    record_barrier(330003, 1, 5, 7)
    r0_emit("pe_d3d12_resource_barrier_real_record",
        "\"barrier_id\":330003,\"barrier_kind\":1,\"before_state\":5,\"after_state\":7,\"target\":\"metal_automatic_tracking_noop\"")

    record_barrier(330004, 2, 0, 0)
    r0_emit("pe_d3d12_resource_barrier_real_record",
        "\"barrier_id\":330004,\"barrier_kind\":2,\"before_state\":0,\"after_state\":0,\"target\":\"MTLHeap_aliasing_noop\"")

    record_barrier(330005, 3, 3, 3)
    r0_emit("pe_d3d12_resource_barrier_real_record",
        "\"barrier_id\":330005,\"barrier_kind\":3,\"before_state\":3,\"after_state\":3,\"target\":\"MTLResourceBarrier\"")

    record_barrier(330006, 3, 3, 4)
    r0_emit("pe_d3d12_resource_barrier_real_record",
        "\"barrier_id\":330006,\"barrier_kind\":3,\"before_state\":3,\"after_state\":4,\"target\":\"MTLFence\"")

    // 3. barrier_count = 6
    let c = barrier_count()
    if c != 6 {
        panic("pe_d3d12_resource_barrier_real FAIL [barrier_count] expected=6 got=" + to_string(c))
    }

    // 4. transition_count = 3 (kind=1: 330001, 330002, 330003)
    let tc = transition_count()
    if tc != 3 {
        panic("pe_d3d12_resource_barrier_real FAIL [transition_count] expected=3 got=" + to_string(tc))
    }

    // 5. present_transition_count = 1 (after_state=1: 330002)
    let pc = present_transition_count()
    if pc != 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [present_transition_count] expected=1 got=" + to_string(pc))
    }

    // 6. count_by_barrier_kind sanity
    let k1 = count_by_barrier_kind(1)
    if k1 != 3 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_barrier_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_barrier_kind(2)
    if k2 != 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_barrier_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_barrier_kind(3)
    if k3 != 2 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_barrier_kind(3)] expected=2 got=" + to_string(k3))
    }
    let k99 = count_by_barrier_kind(99)
    if k99 != 0 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_barrier_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. count_by_after_state sanity
    //    after_state distribution: 2(330001), 1(330002), 7(330003), 0(330004), 3(330005), 4(330006)
    let s2 = count_by_after_state(2)
    if s2 != 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_after_state(2)] expected=1 got=" + to_string(s2))
    }
    let s7 = count_by_after_state(7)
    if s7 != 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_after_state(7)] expected=1 got=" + to_string(s7))
    }
    let s0 = count_by_after_state(0)
    if s0 != 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_after_state(0)] expected=1 got=" + to_string(s0))
    }
    let s_miss = count_by_after_state(6)
    if s_miss != 0 {
        panic("pe_d3d12_resource_barrier_real FAIL [count_by_after_state(6)] expected=0 got=" + to_string(s_miss))
    }

    // 8. barrier_after_state sanity
    let a2 = barrier_after_state(330002)
    if a2 != 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [barrier_after_state(330002)] expected=1 got=" + to_string(a2))
    }
    let a6 = barrier_after_state(330006)
    if a6 != 4 {
        panic("pe_d3d12_resource_barrier_real FAIL [barrier_after_state(330006)] expected=4 got=" + to_string(a6))
    }
    let a_miss = barrier_after_state(9999)
    if a_miss != -1 {
        panic("pe_d3d12_resource_barrier_real FAIL [barrier_after_state(9999)] expected=-1 got=" + to_string(a_miss))
    }

    // 9. pdrb_stats() = [6, 3, 1, 2]
    let s = pdrb_stats()
    if len(s) != 4 {
        panic("pe_d3d12_resource_barrier_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_d3d12_resource_barrier_real FAIL [stats barrier_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_d3d12_resource_barrier_real FAIL [stats transition_count] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_d3d12_resource_barrier_real FAIL [stats present_transition_count] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_d3d12_resource_barrier_real FAIL [stats uav_count] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_d3d12_resource_barrier_real_stats",
        "\"barrier_count\":" + to_string(s[0])
        + ",\"transition_count\":" + to_string(s[1])
        + ",\"present_transition_count\":" + to_string(s[2])
        + ",\"uav_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_d3d12_resource_barrier_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdrb()
    let s3 = pdrb_stats()
    let i = 0
    while i < len(s3) {
        if s3[i] != 0 {
            panic("pe_d3d12_resource_barrier_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s3[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3d12_resource_barrier_real self_test PASS (barriers=" + to_string(s[0])
        + ", transitions=" + to_string(s[1]) + ", present=" + to_string(s[2])
        + ", uav=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdrb_stats()
            println("barrier_count\t" + to_string(s[0]))
            println("transition_count\t" + to_string(s[1]))
            println("present_transition_count\t" + to_string(s[2]))
            println("uav_count\t" + to_string(s[3]))
            return
        }
        if sub == "after" {
            if len(a) >= 4 {
                let bid = to_int(a[3])
                println("barrier_after_state\t" + to_string(barrier_after_state(bid)))
                return
            }
            println("usage: hexa run pe_d3d12_resource_barrier_real.hexa after <barrier_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_barrier_kind\t" + to_string(count_by_barrier_kind(kind)))
                return
            }
            println("usage: hexa run pe_d3d12_resource_barrier_real.hexa count <barrier_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdrb()
            println("cleaned: " + pdrb_dir())
            return
        }
        if sub == "dir" {
            println(pdrb_dir())
            return
        }
    }
    println("usage: hexa run pe_d3d12_resource_barrier_real.hexa { self-test | stats | after <barrier_id> | count <barrier_kind> | cleanup | dir }")
}
