// lib/loader/pe_handle_table_real.hexa — Win32 user-mode HANDLE table tracker
//
// Win32 user-mode HANDLE table (Apple-native, no kernel kobject):
//   HANDLE = sequential uint64 (lo32: index, hi32: generation counter)
//   table layout: per-process malloc'd array of handle_entry { kind, native_obj, ref_count, flags }
//   CloseHandle: ref_count-- → free if 0
//   DuplicateHandle: ref_count++ + new HANDLE entry pointing same native
//   GetHandleInformation/SetHandleInformation: flags bit (HANDLE_FLAG_INHERIT 0x1, PROTECT_FROM_CLOSE 0x2)
//   inheritance: lpProcessInformation 에 BOOL bInheritHandles → POSIX dup2 + close-on-exec clear
// own1: handle table 자체 hexa 자체 구현, Wine wineserver/handle.c 인용 X
//
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// object_kind code:
//   1 = file
//   2 = event
//   3 = mutex
//   4 = semaphore
//   5 = thread
//   6 = process
//   7 = pipe
//   8 = registry
//
// inheritable: 0 / 1
//
// persist schema (TSV — handles.tsv):
//   handle_id<int> \t object_kind<int> \t ref_count<int> \t inheritable<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn phtr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_handle_table_real"
}

fn phtr_handles_path() -> str {
    return phtr_dir() + "/handles.tsv"
}

fn phtr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + phtr_dir() + "'")
}

fn cleanup_phtr() -> void {
    phtr_ensure_dir()
    let _ = exec("rm -f '" + phtr_handles_path() + "'")
}

// ─── 공통 file IO ───
fn phtr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn phtr_append_row(path: str, row: str) -> void {
    phtr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_handle: handle entry 1 건 기록 ───
fn record_handle(handle_id: int, object_kind: int, ref_count: int, inheritable: int) -> void {
    if handle_id <= 0 {
        panic("pe_handle_table_real FAIL [record_handle] expected=handle_id>0 got=" + to_string(handle_id))
    }
    if object_kind < 1 {
        panic("pe_handle_table_real FAIL [record_handle] expected=object_kind>=1 got=" + to_string(object_kind))
    }
    if object_kind > 8 {
        panic("pe_handle_table_real FAIL [record_handle] expected=object_kind<=8 got=" + to_string(object_kind))
    }
    if ref_count < 1 {
        panic("pe_handle_table_real FAIL [record_handle] expected=ref_count>=1 got=" + to_string(ref_count))
    }
    if inheritable < 0 {
        panic("pe_handle_table_real FAIL [record_handle] expected=inheritable>=0 got=" + to_string(inheritable))
    }
    if inheritable > 1 {
        panic("pe_handle_table_real FAIL [record_handle] expected=inheritable<=1 got=" + to_string(inheritable))
    }
    let row = to_string(handle_id) + "\t" + to_string(object_kind)
        + "\t" + to_string(ref_count) + "\t" + to_string(inheritable) + "\n"
    phtr_append_row(phtr_handles_path(), row)
}

// ─── handle_count: total handle 수 ───
fn handle_count() -> int {
    let t = phtr_read_table(phtr_handles_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_ref_count: 모든 row ref_count 합 ───
fn total_ref_count() -> int {
    let t = phtr_read_table(phtr_handles_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_object_kind: 특정 object_kind 의 row 수 ───
fn count_by_object_kind(kind: int) -> int {
    let t = phtr_read_table(phtr_handles_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── inheritable_count: inheritable=1 row 수 ───
fn inheritable_count() -> int {
    let t = phtr_read_table(phtr_handles_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── multi_ref_count: ref_count > 1 row 수 ───
fn multi_ref_count() -> int {
    let t = phtr_read_table(phtr_handles_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) > 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── handle_ref_count: 특정 handle_id 의 ref_count (없으면 0) ───
fn handle_ref_count(handle_id: int) -> int {
    let t = phtr_read_table(phtr_handles_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == handle_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── phtr_stats: [handle_count, total_ref_count, inheritable_count, multi_ref_count] ───
fn phtr_stats() -> array {
    let mut out = []
    out.push(handle_count())
    out.push(total_ref_count())
    out.push(inheritable_count())
    out.push(multi_ref_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "phtr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_phtr()

    // 6 handles across 5 object_kinds (file/event/mutex/thread/pipe):
    //   inheritable = 2 rows (id 220002, 220005)
    //   multi-ref   = 2 rows (id 220003 ref=3, id 220006 ref=2)
    record_handle(220001, 1, 1, 0)
    r0_emit("pe_handle_table_real_record",
        "\"handle_id\":220001,\"object_kind\":1,\"ref_count\":1,\"inheritable\":0,\"target\":\"file\"")

    record_handle(220002, 2, 1, 1)
    r0_emit("pe_handle_table_real_record",
        "\"handle_id\":220002,\"object_kind\":2,\"ref_count\":1,\"inheritable\":1,\"target\":\"event\"")

    record_handle(220003, 3, 3, 0)
    r0_emit("pe_handle_table_real_record",
        "\"handle_id\":220003,\"object_kind\":3,\"ref_count\":3,\"inheritable\":0,\"target\":\"mutex\"")

    record_handle(220004, 1, 1, 0)
    r0_emit("pe_handle_table_real_record",
        "\"handle_id\":220004,\"object_kind\":1,\"ref_count\":1,\"inheritable\":0,\"target\":\"file\"")

    record_handle(220005, 5, 1, 1)
    r0_emit("pe_handle_table_real_record",
        "\"handle_id\":220005,\"object_kind\":5,\"ref_count\":1,\"inheritable\":1,\"target\":\"thread\"")

    record_handle(220006, 7, 2, 0)
    r0_emit("pe_handle_table_real_record",
        "\"handle_id\":220006,\"object_kind\":7,\"ref_count\":2,\"inheritable\":0,\"target\":\"pipe\"")

    // handle_count = 6
    let c = handle_count()
    if c != 6 {
        panic("pe_handle_table_real FAIL [handle_count] expected=6 got=" + to_string(c))
    }

    // total_ref_count = 1+1+3+1+1+2 = 9
    let tr = total_ref_count()
    if tr != 9 {
        panic("pe_handle_table_real FAIL [total_ref_count] expected=9 got=" + to_string(tr))
    }

    // count_by_object_kind sanity
    let k1 = count_by_object_kind(1)
    if k1 != 2 {
        panic("pe_handle_table_real FAIL [count_by_object_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_object_kind(2)
    if k2 != 1 {
        panic("pe_handle_table_real FAIL [count_by_object_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_object_kind(3)
    if k3 != 1 {
        panic("pe_handle_table_real FAIL [count_by_object_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k5 = count_by_object_kind(5)
    if k5 != 1 {
        panic("pe_handle_table_real FAIL [count_by_object_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k7 = count_by_object_kind(7)
    if k7 != 1 {
        panic("pe_handle_table_real FAIL [count_by_object_kind(7)] expected=1 got=" + to_string(k7))
    }
    let k99 = count_by_object_kind(99)
    if k99 != 0 {
        panic("pe_handle_table_real FAIL [count_by_object_kind(99)] expected=0 got=" + to_string(k99))
    }

    // inheritable_count = 2 (220002, 220005)
    let ic = inheritable_count()
    if ic != 2 {
        panic("pe_handle_table_real FAIL [inheritable_count] expected=2 got=" + to_string(ic))
    }

    // multi_ref_count = 2 (220003 ref=3, 220006 ref=2)
    let mc = multi_ref_count()
    if mc != 2 {
        panic("pe_handle_table_real FAIL [multi_ref_count] expected=2 got=" + to_string(mc))
    }

    // handle_ref_count sanity
    let r3 = handle_ref_count(220003)
    if r3 != 3 {
        panic("pe_handle_table_real FAIL [handle_ref_count(220003)] expected=3 got=" + to_string(r3))
    }
    let r6 = handle_ref_count(220006)
    if r6 != 2 {
        panic("pe_handle_table_real FAIL [handle_ref_count(220006)] expected=2 got=" + to_string(r6))
    }
    let r1 = handle_ref_count(220001)
    if r1 != 1 {
        panic("pe_handle_table_real FAIL [handle_ref_count(220001)] expected=1 got=" + to_string(r1))
    }
    let r_miss = handle_ref_count(9999)
    if r_miss != 0 {
        panic("pe_handle_table_real FAIL [handle_ref_count(9999)] expected=0 got=" + to_string(r_miss))
    }

    // phtr_stats() = [6, 9, 2, 2]
    let s = phtr_stats()
    if len(s) != 4 {
        panic("pe_handle_table_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_handle_table_real FAIL [stats handle_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 9 {
        panic("pe_handle_table_real FAIL [stats total_ref_count] expected=9 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_handle_table_real FAIL [stats inheritable_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_handle_table_real FAIL [stats multi_ref_count] expected=2 got=" + to_string(s[3]))
    }

    // emit stats
    r0_emit("pe_handle_table_real_stats",
        "\"handle_count\":" + to_string(s[0])
        + ",\"total_ref_count\":" + to_string(s[1])
        + ",\"inheritable_count\":" + to_string(s[2])
        + ",\"multi_ref_count\":" + to_string(s[3]))

    // emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_handle_table_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // cleanup → stats 모두 0
    cleanup_phtr()
    let s2 = phtr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_handle_table_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_handle_table_real self_test PASS (handles=" + to_string(s[0])
        + ", refs=" + to_string(s[1]) + ", inherit=" + to_string(s[2])
        + ", multi=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = phtr_stats()
            println("handle_count\t" + to_string(s[0]))
            println("total_ref_count\t" + to_string(s[1]))
            println("inheritable_count\t" + to_string(s[2]))
            println("multi_ref_count\t" + to_string(s[3]))
            return
        }
        if sub == "refs" {
            if len(a) >= 4 {
                let hid = to_int(a[3])
                println("handle_ref_count\t" + to_string(handle_ref_count(hid)))
                return
            }
            println("usage: hexa run pe_handle_table_real.hexa refs <handle_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_object_kind\t" + to_string(count_by_object_kind(kind)))
                return
            }
            println("usage: hexa run pe_handle_table_real.hexa count <object_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_phtr()
            println("cleaned: " + phtr_dir())
            return
        }
        if sub == "dir" {
            println(phtr_dir())
            return
        }
    }
    println("usage: hexa run pe_handle_table_real.hexa { self-test | stats | refs <handle_id> | count <object_kind> | cleanup | dir }")
}
