// lib/loader/pe_d3dmetal_link_status.hexa — E4 D3DMetal binary weak link 상태 추적
//
// E4 외부 결정 — Apple Game Porting Toolkit (GPTk) 4.0+ D3DMetal binary 의 macOS dylib
//   경로 확인 + weak link. /usr/local/lib/d3dmetal/D3DMetal.dylib (예시).
//   own1 § A "Apple D3DMetal binary" 명시 허용.
//
// own 1 enforcement: 본 모듈은 Apple GPTk D3DMetal binary 를 link target 으로 둠 (own1
//   § A "Apple D3DMetal binary" 명시 허용 범위). third-party Wine/CrossOver/community
//   대체 binary 는 link_kind 4 (fallback_diy) 자리만 두되 본 self_test 에선 사용 X —
//   추적 schema 자체는 가족 친화 own DIY fallback 만 가능 표시.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code (D3DMetal weak link sequence):
//   1 = gptk_locate            — GPTk 설치 경로 (4.0/4.1/5.0) locate
//   2 = d3dmetal_dylib_path    — D3DMetal.dylib 절대경로 후보 결정
//   3 = weak_link_verify       — weak link 가능 여부 (file 존재 + arch 검증)
//   4 = metal_device_bridge    — Metal device handle bridge readiness
//   5 = binding_test           — symbol resolve 모의 binding test
//
// link_kind code (GPTk version / fallback):
//   1 = gptk_4_0
//   2 = gptk_4_1
//   3 = gptk_5_0
//   4 = fallback_diy           — Apple GPTk 미보유 시 own DIY weak link slot (가족용)
//
// persist schema (TSV — links.tsv):
//   link_id<str> \t phase_kind<int> \t link_kind<int> \t success<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdls_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3dmetal_link_status"
}

fn pdls_links_path() -> str {
    return pdls_dir() + "/links.tsv"
}

fn pdls_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdls_dir() + "'")
}

fn cleanup_pdls() -> void {
    pdls_ensure_dir()
    let _ = exec("rm -f '" + pdls_links_path() + "'")
}

// ─── 공통 file IO ───
fn pdls_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdls_append_row(path: str, row: str) -> void {
    pdls_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_link: D3DMetal weak link 시도 1 건 기록 ───
fn record_link(link_id: str, phase_kind: int, link_kind: int, success: int) -> void {
    if link_id == "" {
        panic("pe_d3dmetal_link_status FAIL [record_link] expected=link_id!=\"\" got=\"\"")
    }
    if phase_kind < 1 {
        panic("pe_d3dmetal_link_status FAIL [record_link] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 5 {
        panic("pe_d3dmetal_link_status FAIL [record_link] expected=phase_kind<=5 got=" + to_string(phase_kind))
    }
    if link_kind < 1 {
        panic("pe_d3dmetal_link_status FAIL [record_link] expected=link_kind>=1 got=" + to_string(link_kind))
    }
    if link_kind > 4 {
        panic("pe_d3dmetal_link_status FAIL [record_link] expected=link_kind<=4 got=" + to_string(link_kind))
    }
    if success < 0 {
        panic("pe_d3dmetal_link_status FAIL [record_link] expected=success>=0 got=" + to_string(success))
    }
    if success > 1 {
        panic("pe_d3dmetal_link_status FAIL [record_link] expected=success<=1 got=" + to_string(success))
    }
    let row = link_id + "\t" + to_string(phase_kind)
        + "\t" + to_string(link_kind) + "\t" + to_string(success) + "\n"
    pdls_append_row(pdls_links_path(), row)
}

// ─── link_count: total link 수 ───
fn link_count() -> int {
    let t = pdls_read_table(pdls_links_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 link 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = pdls_read_table(pdls_links_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_link_kind: 특정 link_kind (GPTk version / fallback) 의 link 수 ───
fn count_by_link_kind(link_kind: int) -> int {
    let t = pdls_read_table(pdls_links_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == link_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── success_count: success=1 인 link 수 ───
fn success_count() -> int {
    let t = pdls_read_table(pdls_links_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── gptk_5_count: link_kind 3 (gptk_5_0) ───
fn gptk_5_count() -> int {
    return count_by_link_kind(3)
}

// ─── link_success: 특정 link_id 의 success 값 (없으면 -1) ───
fn link_success(link_id: str) -> int {
    let t = pdls_read_table(pdls_links_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == link_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pdls_stats: [link_count, success_count, gptk_5_count] ───
fn pdls_stats() -> array {
    let mut out = []
    out.push(link_count())
    out.push(success_count())
    out.push(gptk_5_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdls-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdls()

    // 2. record 6 links — covers ≥4 phase_kinds (1,2,3,4,5) and ≥3 link_kinds (1,2,3)
    //    success: L1,L2,L4,L5 → 1 (총 4 success); L3,L6 → 0 (실패 케이스)

    // L1: gptk_locate / gptk_4_0 / success
    record_link("d3dmetal_locate_gptk_4_0", 1, 1, 1)
    r0_emit("pe_d3dmetal_link_status_record",
        "\"link_id\":\"d3dmetal_locate_gptk_4_0\",\"phase_kind\":1,\"link_kind\":1,\"success\":1")

    // L2: d3dmetal_dylib_path / gptk_4_1 / success
    record_link("d3dmetal_dylib_path_gptk_4_1", 2, 2, 1)
    r0_emit("pe_d3dmetal_link_status_record",
        "\"link_id\":\"d3dmetal_dylib_path_gptk_4_1\",\"phase_kind\":2,\"link_kind\":2,\"success\":1")

    // L3: weak_link_verify / gptk_5_0 / fail (예: arch mismatch)
    record_link("d3dmetal_weak_verify_gptk_5_0", 3, 3, 0)
    r0_emit("pe_d3dmetal_link_status_record",
        "\"link_id\":\"d3dmetal_weak_verify_gptk_5_0\",\"phase_kind\":3,\"link_kind\":3,\"success\":0")

    // L4: metal_device_bridge / gptk_5_0 / success
    record_link("d3dmetal_metal_bridge_gptk_5_0", 4, 3, 1)
    r0_emit("pe_d3dmetal_link_status_record",
        "\"link_id\":\"d3dmetal_metal_bridge_gptk_5_0\",\"phase_kind\":4,\"link_kind\":3,\"success\":1")

    // L5: binding_test / gptk_4_1 / success
    record_link("d3dmetal_binding_gptk_4_1", 5, 2, 1)
    r0_emit("pe_d3dmetal_link_status_record",
        "\"link_id\":\"d3dmetal_binding_gptk_4_1\",\"phase_kind\":5,\"link_kind\":2,\"success\":1")

    // L6: weak_link_verify / gptk_4_0 / fail (예: 구버전 dylib symbol 부족)
    record_link("d3dmetal_weak_verify_gptk_4_0", 3, 1, 0)
    r0_emit("pe_d3dmetal_link_status_record",
        "\"link_id\":\"d3dmetal_weak_verify_gptk_4_0\",\"phase_kind\":3,\"link_kind\":1,\"success\":0")

    // 3. link_count = 6
    let lc = link_count()
    if lc != 6 {
        panic("pe_d3dmetal_link_status FAIL [link_count] expected=6 got=" + to_string(lc))
    }

    // 4. count_by_phase_kind sanity (phase 1,2,3,4,5 → 5 phase_kinds present, ≥4 OK)
    let p1 = count_by_phase_kind(1)
    if p1 != 1 {
        panic("pe_d3dmetal_link_status FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_d3dmetal_link_status FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 2 {
        panic("pe_d3dmetal_link_status FAIL [count_by_phase_kind(3)] expected=2 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_d3dmetal_link_status FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_d3dmetal_link_status FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p_miss = count_by_phase_kind(99)
    if p_miss != 0 {
        panic("pe_d3dmetal_link_status FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p_miss))
    }

    // 5. count_by_link_kind sanity (link_kind 1,2,3 → 3 link_kinds present, ≥3 OK)
    let k1 = count_by_link_kind(1)
    if k1 != 2 {
        panic("pe_d3dmetal_link_status FAIL [count_by_link_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_link_kind(2)
    if k2 != 2 {
        panic("pe_d3dmetal_link_status FAIL [count_by_link_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_link_kind(3)
    if k3 != 2 {
        panic("pe_d3dmetal_link_status FAIL [count_by_link_kind(3)] expected=2 got=" + to_string(k3))
    }
    let k4 = count_by_link_kind(4)
    if k4 != 0 {
        panic("pe_d3dmetal_link_status FAIL [count_by_link_kind(4)] expected=0 got=" + to_string(k4))
    }

    // 6. success_count = 4 (≥4 OK)
    let sc = success_count()
    if sc != 4 {
        panic("pe_d3dmetal_link_status FAIL [success_count] expected=4 got=" + to_string(sc))
    }

    // 7. gptk_5_count = 2 (link_kind 3 hits)
    let g5 = gptk_5_count()
    if g5 != 2 {
        panic("pe_d3dmetal_link_status FAIL [gptk_5_count] expected=2 got=" + to_string(g5))
    }

    // 8. link_success lookup
    let ls_ok = link_success("d3dmetal_locate_gptk_4_0")
    if ls_ok != 1 {
        panic("pe_d3dmetal_link_status FAIL [link_success ok] expected=1 got=" + to_string(ls_ok))
    }
    let ls_ng = link_success("d3dmetal_weak_verify_gptk_5_0")
    if ls_ng != 0 {
        panic("pe_d3dmetal_link_status FAIL [link_success ng] expected=0 got=" + to_string(ls_ng))
    }
    let ls_miss = link_success("nonexistent_link")
    if ls_miss != -1 {
        panic("pe_d3dmetal_link_status FAIL [link_success miss] expected=-1 got=" + to_string(ls_miss))
    }

    // 9. pdls_stats() = [6, 4, 2]
    let s = pdls_stats()
    if len(s) != 3 {
        panic("pe_d3dmetal_link_status FAIL [stats len] expected=3 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_d3dmetal_link_status FAIL [stats link_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_d3dmetal_link_status FAIL [stats success_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_d3dmetal_link_status FAIL [stats gptk_5_count] expected=2 got=" + to_string(s[2]))
    }

    // 10. emit aggregate stats
    r0_emit("pe_d3dmetal_link_status_stats",
        "\"link_count\":" + to_string(s[0])
        + ",\"success_count\":" + to_string(s[1])
        + ",\"gptk_5_count\":" + to_string(s[2]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_d3dmetal_link_status FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdls()
    let s2 = pdls_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d3dmetal_link_status FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3dmetal_link_status self_test PASS (links=" + to_string(s[0])
        + ", success=" + to_string(s[1]) + ", gptk_5=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdls_stats()
            println("link_count\t" + to_string(s[0]))
            println("success_count\t" + to_string(s[1]))
            println("gptk_5_count\t" + to_string(s[2]))
            return
        }
        if sub == "success" {
            if len(a) >= 4 {
                let lid = a[3]
                println("link_success\t" + to_string(link_success(lid)))
                return
            }
            println("usage: hexa run pe_d3dmetal_link_status.hexa success <link_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let val = to_int(a[4])
                if dim == "phase" {
                    println("count_by_phase_kind\t" + to_string(count_by_phase_kind(val)))
                    return
                }
                if dim == "link" {
                    println("count_by_link_kind\t" + to_string(count_by_link_kind(val)))
                    return
                }
                println("usage: hexa run pe_d3dmetal_link_status.hexa count { phase | link } <kind>")
                return
            }
            println("usage: hexa run pe_d3dmetal_link_status.hexa count { phase | link } <kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdls()
            println("cleaned: " + pdls_dir())
            return
        }
        if sub == "dir" {
            println(pdls_dir())
            return
        }
    }
    println("usage: hexa run pe_d3dmetal_link_status.hexa { self-test | stats | success <link_id> | count phase <phase_kind> | count link <link_kind> | cleanup | dir }")
}
