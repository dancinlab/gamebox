// lib/loader/win32_kernel32_tier1_real.hexa — cycle 81 R6 Tier 1 KERNEL32 trivial impl tracker
//
// Tier 1 trivial KERNEL32 → Apple-native:
//   GetCurrentThreadId      → pthread_mach_thread_np(pthread_self()) (uint32)
//   GetCurrentProcessId     → getpid()
//   GetTickCount            → clock_gettime(CLOCK_MONOTONIC) ms (32bit wrap)
//   GetTickCount64          → clock_gettime(CLOCK_MONOTONIC) ms (uint64)
//   GetLastError/SetLastError → pthread_key per-thread DWORD slot
//   lstrlenW(wchar*)        → UTF-16 NUL-terminated 길이 count
//   lstrlenA(char*)         → strlen()
//   IsBadReadPtr/WritePtr   → deprecated, always return 0 (MSDN: "do not use")
//   Sleep(ms)               → usleep(ms*1000) or nanosleep
// own1: Apple SDK + MSDN reference only. Wine kernel32/heap.c/sync.c 인용 X
//
// own 1 enforcement: Wine / Reactos / CrossOver / community 코드 0 줄.
//   본 module 은 KERNEL32 Tier 1 1-line 함수 호출 tracker — 실 native dispatch X.
//   Apple-native mapping 은 docstring 만 (실 helper.mm bridge stage6).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code (KERNEL32 export):
//   1 = GetCurrentThreadId
//   2 = GetCurrentProcessId
//   3 = GetTickCount
//   4 = GetTickCount64
//   5 = GetLastError
//   6 = SetLastError
//   7 = lstrlenW
//   8 = lstrlenA
//   9 = IsBadReadPtr
//  10 = Sleep
//
// impl_status code:
//   1 = real_apple_native (pthread / clock_gettime / getpid / strlen / usleep)
//   2 = stub_constant     (deterministic constant return — Tier 1 placeholder)
//   3 = tls_slot          (pthread_key per-thread DWORD — GetLastError/SetLastError)
//   4 = deprecated_zero   (IsBadReadPtr/WritePtr — MSDN: "do not use", always 0)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t impl_status<int> \t return_value<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wkt1_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_kernel32_tier1_real"
}

fn wkt1_calls_path() -> str {
    return wkt1_dir() + "/calls.tsv"
}

fn wkt1_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wkt1_dir() + "'")
}

fn cleanup_wkt1() -> void {
    wkt1_ensure_dir()
    let _ = exec("rm -f '" + wkt1_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wkt1_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wkt1_append_row(path: str, row: str) -> void {
    wkt1_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: KERNEL32 Tier 1 호출 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, impl_status: int, return_value: int) -> void {
    if call_id <= 0 {
        panic("win32_kernel32_tier1_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_kernel32_tier1_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 10 {
        panic("win32_kernel32_tier1_real FAIL [record_call] expected=func_kind<=10 got=" + to_string(func_kind))
    }
    if impl_status < 1 {
        panic("win32_kernel32_tier1_real FAIL [record_call] expected=impl_status>=1 got=" + to_string(impl_status))
    }
    if impl_status > 4 {
        panic("win32_kernel32_tier1_real FAIL [record_call] expected=impl_status<=4 got=" + to_string(impl_status))
    }
    if return_value < 0 {
        panic("win32_kernel32_tier1_real FAIL [record_call] expected=return_value>=0 got=" + to_string(return_value))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(impl_status) + "\t" + to_string(return_value) + "\n"
    wkt1_append_row(wkt1_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wkt1_read_table(wkt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 호출 수 ───
fn count_by_func_kind(func_kind: int) -> int {
    let t = wkt1_read_table(wkt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == func_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_impl_status: 특정 impl_status 의 호출 수 ───
fn count_by_impl_status(impl_status: int) -> int {
    let t = wkt1_read_table(wkt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == impl_status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── real_apple_count: impl_status=1 (real_apple_native) 호출 수 ───
fn real_apple_count() -> int {
    return count_by_impl_status(1)
}

// ─── total_return_value: 모든 호출 return_value 합 ───
fn total_return_value() -> int {
    let t = wkt1_read_table(wkt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── call_return_value: 특정 call_id 의 return_value (없으면 0) ───
fn call_return_value(call_id: int) -> int {
    let t = wkt1_read_table(wkt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wkt1_stats: [call_count, real_apple_count, total_return_value, count_by_impl_status(4)] ───
fn wkt1_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(real_apple_count())
    out.push(total_return_value())
    out.push(count_by_impl_status(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wkt1-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wkt1()

    // 2. record 6 calls (≥4 func_kinds, all 4 impl_statuses)
    //    func_kinds: 2 (GetCurrentProcessId), 4 (GetTickCount64), 5 (GetLastError),
    //                6 (SetLastError), 8 (lstrlenA), 9 (IsBadReadPtr)
    //    impl_statuses: 1 (real_apple_native) ×3, 2 (stub_constant) ×1,
    //                   3 (tls_slot) ×1, 4 (deprecated_zero) ×1

    // call 1: GetCurrentProcessId → real_apple_native (getpid()) → pid synthetic 4321
    record_call(810001, 2, 1, 4321)
    r0_emit("win32_kernel32_tier1_real_record",
        "\"call_id\":810001,\"func_kind\":2,\"impl_status\":1,\"return_value\":4321,\"target\":\"GetCurrentProcessId\",\"native\":\"getpid\"")

    // call 2: GetTickCount64 → real_apple_native (clock_gettime) → 50000 ms
    record_call(810002, 4, 1, 50000)
    r0_emit("win32_kernel32_tier1_real_record",
        "\"call_id\":810002,\"func_kind\":4,\"impl_status\":1,\"return_value\":50000,\"target\":\"GetTickCount64\",\"native\":\"clock_gettime\"")

    // call 3: lstrlenA → real_apple_native (strlen) → 14
    record_call(810003, 8, 1, 14)
    r0_emit("win32_kernel32_tier1_real_record",
        "\"call_id\":810003,\"func_kind\":8,\"impl_status\":1,\"return_value\":14,\"target\":\"lstrlenA\",\"native\":\"strlen\"")

    // call 4: GetLastError → tls_slot (pthread_key) → 0 (no error)
    record_call(810004, 5, 3, 0)
    r0_emit("win32_kernel32_tier1_real_record",
        "\"call_id\":810004,\"func_kind\":5,\"impl_status\":3,\"return_value\":0,\"target\":\"GetLastError\",\"native\":\"pthread_getspecific\"")

    // call 5: IsBadReadPtr → deprecated_zero (always 0) → 0
    record_call(810005, 9, 4, 0)
    r0_emit("win32_kernel32_tier1_real_record",
        "\"call_id\":810005,\"func_kind\":9,\"impl_status\":4,\"return_value\":0,\"target\":\"IsBadReadPtr\",\"native\":\"deprecated\"")

    // call 6: SetLastError → stub_constant (writes value, returns 0 / void) → 0
    record_call(810006, 6, 2, 0)
    r0_emit("win32_kernel32_tier1_real_record",
        "\"call_id\":810006,\"func_kind\":6,\"impl_status\":2,\"return_value\":0,\"target\":\"SetLastError\",\"native\":\"stub\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("win32_kernel32_tier1_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (≥4 distinct)
    let fk2 = count_by_func_kind(2)
    if fk2 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(fk2))
    }
    let fk4 = count_by_func_kind(4)
    if fk4 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(fk4))
    }
    let fk5 = count_by_func_kind(5)
    if fk5 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_func_kind(5)] expected=1 got=" + to_string(fk5))
    }
    let fk6 = count_by_func_kind(6)
    if fk6 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_func_kind(6)] expected=1 got=" + to_string(fk6))
    }
    let fk8 = count_by_func_kind(8)
    if fk8 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_func_kind(8)] expected=1 got=" + to_string(fk8))
    }
    let fk9 = count_by_func_kind(9)
    if fk9 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_func_kind(9)] expected=1 got=" + to_string(fk9))
    }
    let fk7 = count_by_func_kind(7)
    if fk7 != 0 {
        panic("win32_kernel32_tier1_real FAIL [count_by_func_kind(7)] expected=0 got=" + to_string(fk7))
    }

    // 5. count_by_impl_status — all 4 covered
    let is1 = count_by_impl_status(1)
    if is1 != 3 {
        panic("win32_kernel32_tier1_real FAIL [count_by_impl_status(1)] expected=3 got=" + to_string(is1))
    }
    let is2 = count_by_impl_status(2)
    if is2 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_impl_status(2)] expected=1 got=" + to_string(is2))
    }
    let is3 = count_by_impl_status(3)
    if is3 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_impl_status(3)] expected=1 got=" + to_string(is3))
    }
    let is4 = count_by_impl_status(4)
    if is4 != 1 {
        panic("win32_kernel32_tier1_real FAIL [count_by_impl_status(4)] expected=1 got=" + to_string(is4))
    }

    // 6. real_apple_count = 3
    let rac = real_apple_count()
    if rac != 3 {
        panic("win32_kernel32_tier1_real FAIL [real_apple_count] expected=3 got=" + to_string(rac))
    }

    // 7. total_return_value = 4321 + 50000 + 14 + 0 + 0 + 0 = 54335
    let trv = total_return_value()
    if trv != 54335 {
        panic("win32_kernel32_tier1_real FAIL [total_return_value] expected=54335 got=" + to_string(trv))
    }

    // 8. call_return_value sanity
    let rv1 = call_return_value(810001)
    if rv1 != 4321 {
        panic("win32_kernel32_tier1_real FAIL [call_return_value(810001)] expected=4321 got=" + to_string(rv1))
    }
    let rv2 = call_return_value(810002)
    if rv2 != 50000 {
        panic("win32_kernel32_tier1_real FAIL [call_return_value(810002)] expected=50000 got=" + to_string(rv2))
    }
    let rv_miss = call_return_value(9999)
    if rv_miss != 0 {
        panic("win32_kernel32_tier1_real FAIL [call_return_value(9999)] expected=0 got=" + to_string(rv_miss))
    }

    // 9. wkt1_stats() = [6, 3, 54335, 1]
    let s = wkt1_stats()
    if len(s) != 4 {
        panic("win32_kernel32_tier1_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("win32_kernel32_tier1_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("win32_kernel32_tier1_real FAIL [stats real_apple_count] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 54335 {
        panic("win32_kernel32_tier1_real FAIL [stats total_return_value] expected=54335 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("win32_kernel32_tier1_real FAIL [stats deprecated_zero] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("win32_kernel32_tier1_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"real_apple_count\":" + to_string(s[1])
        + ",\"total_return_value\":" + to_string(s[2])
        + ",\"deprecated_zero_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("win32_kernel32_tier1_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_wkt1()
    let s2 = wkt1_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("win32_kernel32_tier1_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_kernel32_tier1_real self_test PASS (calls=" + to_string(s[0])
        + ", real_apple=" + to_string(s[1]) + ", total_rv=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wkt1_stats()
            println("call_count\t" + to_string(s[0]))
            println("real_apple_count\t" + to_string(s[1]))
            println("total_return_value\t" + to_string(s[2]))
            println("deprecated_zero_count\t" + to_string(s[3]))
            return
        }
        if sub == "return" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_return_value\t" + to_string(call_return_value(cid)))
                return
            }
            println("usage: hexa run win32_kernel32_tier1_real.hexa return <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let mode = a[3]
                let val = to_int(a[4])
                if mode == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if mode == "impl" {
                    println("count_by_impl_status\t" + to_string(count_by_impl_status(val)))
                    return
                }
                println("usage: hexa run win32_kernel32_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
                return
            }
            println("usage: hexa run win32_kernel32_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_wkt1()
            println("cleaned: " + wkt1_dir())
            return
        }
        if sub == "dir" {
            println(wkt1_dir())
            return
        }
    }
    println("usage: hexa run win32_kernel32_tier1_real.hexa { self-test | stats | return <call_id> | count func <func_kind> | count impl <impl_status> | cleanup | dir }")
}
