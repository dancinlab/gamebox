// lib/loader/pe_metal_buffer_pool.hexa — cycle 66 Metal buffer reuse pool tracker skeleton
//
// Metal buffer 재사용 pool — vertex/index/uniform/storage buffer 의 size, reuse_count
// 추적. 실제 MTLBuffer 할당 / reuse policy 는 native helper layer (stage 후속) 책임.
// 본 module 은 buffer event tracker — Metal API 호출 X.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// usage_kind code:
//   1 = vertex
//   2 = index
//   3 = uniform
//   4 = storage
//
// persist schema (TSV — buffers.tsv):
//   buffer_id<int> \t usage_kind<int> \t size_bytes<int> \t reuse_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmbp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_metal_buffer_pool"
}

fn pmbp_buffers_path() -> str {
    return pmbp_dir() + "/buffers.tsv"
}

fn pmbp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmbp_dir() + "'")
}

fn cleanup_pmbp() -> void {
    pmbp_ensure_dir()
    let _ = exec("rm -f '" + pmbp_buffers_path() + "'")
}

// ─── 공통 file IO ───
fn pmbp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmbp_append_row(path: str, row: str) -> void {
    pmbp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_buffer: buffer 1 건 기록 ───
fn record_buffer(buffer_id: int, usage_kind: int, size_bytes: int, reuse_count: int) -> void {
    if buffer_id <= 0 {
        panic("pe_metal_buffer_pool FAIL [record_buffer] expected=buffer_id>0 got=" + to_string(buffer_id))
    }
    if usage_kind < 1 {
        panic("pe_metal_buffer_pool FAIL [record_buffer] expected=usage_kind>=1 got=" + to_string(usage_kind))
    }
    if usage_kind > 4 {
        panic("pe_metal_buffer_pool FAIL [record_buffer] expected=usage_kind<=4 got=" + to_string(usage_kind))
    }
    if size_bytes < 0 {
        panic("pe_metal_buffer_pool FAIL [record_buffer] expected=size_bytes>=0 got=" + to_string(size_bytes))
    }
    if reuse_count < 0 {
        panic("pe_metal_buffer_pool FAIL [record_buffer] expected=reuse_count>=0 got=" + to_string(reuse_count))
    }
    let row = to_string(buffer_id) + "\t" + to_string(usage_kind)
        + "\t" + to_string(size_bytes) + "\t" + to_string(reuse_count) + "\n"
    pmbp_append_row(pmbp_buffers_path(), row)
}

// ─── buffer_count: total buffer 수 ───
fn buffer_count() -> int {
    let t = pmbp_read_table(pmbp_buffers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_size_bytes: 모든 buffer size_bytes 합 ───
fn total_size_bytes() -> int {
    let t = pmbp_read_table(pmbp_buffers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_reuses: 모든 buffer reuse_count 합 ───
fn total_reuses() -> int {
    let t = pmbp_read_table(pmbp_buffers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_usage: 특정 usage_kind 의 buffer 수 ───
fn count_by_usage(usage_kind: int) -> int {
    let t = pmbp_read_table(pmbp_buffers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == usage_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── buffer_reuses: 특정 buffer_id 의 reuse_count (없으면 0) ───
fn buffer_reuses(buffer_id: int) -> int {
    let t = pmbp_read_table(pmbp_buffers_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == buffer_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pmbp_stats: [buffer_count, total_size_bytes, total_reuses, count_by_usage(1)] ───
fn pmbp_stats() -> array {
    let mut out = []
    out.push(buffer_count())
    out.push(total_size_bytes())
    out.push(total_reuses())
    out.push(count_by_usage(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pmbp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pmbp()

    // 2. record 5 buffers across 4 usage_kinds (vertex/index/uniform/storage)
    record_buffer(660001, 1, 4096, 3)
    r0_emit("pe_metal_buffer_pool_record",
        "\"buffer_id\":660001,\"usage_kind\":1,\"size_bytes\":4096,\"reuse_count\":3,\"target\":\"vertex\"")

    record_buffer(660002, 1, 8192, 2)
    r0_emit("pe_metal_buffer_pool_record",
        "\"buffer_id\":660002,\"usage_kind\":1,\"size_bytes\":8192,\"reuse_count\":2,\"target\":\"vertex\"")

    record_buffer(660003, 2, 2048, 5)
    r0_emit("pe_metal_buffer_pool_record",
        "\"buffer_id\":660003,\"usage_kind\":2,\"size_bytes\":2048,\"reuse_count\":5,\"target\":\"index\"")

    record_buffer(660004, 3, 256, 1)
    r0_emit("pe_metal_buffer_pool_record",
        "\"buffer_id\":660004,\"usage_kind\":3,\"size_bytes\":256,\"reuse_count\":1,\"target\":\"uniform\"")

    record_buffer(660005, 4, 65536, 0)
    r0_emit("pe_metal_buffer_pool_record",
        "\"buffer_id\":660005,\"usage_kind\":4,\"size_bytes\":65536,\"reuse_count\":0,\"target\":\"storage\"")

    // 3. buffer_count = 5
    let c = buffer_count()
    if c != 5 {
        panic("pe_metal_buffer_pool FAIL [buffer_count] expected=5 got=" + to_string(c))
    }

    // 4. total_size_bytes = 4096+8192+2048+256+65536 = 80128
    let tb = total_size_bytes()
    if tb != 80128 {
        panic("pe_metal_buffer_pool FAIL [total_size_bytes] expected=80128 got=" + to_string(tb))
    }

    // 5. total_reuses = 3+2+5+1+0 = 11
    let tr = total_reuses()
    if tr != 11 {
        panic("pe_metal_buffer_pool FAIL [total_reuses] expected=11 got=" + to_string(tr))
    }

    // 6. count_by_usage sanity
    let u1 = count_by_usage(1)
    if u1 != 2 {
        panic("pe_metal_buffer_pool FAIL [count_by_usage(1)] expected=2 got=" + to_string(u1))
    }
    let u2 = count_by_usage(2)
    if u2 != 1 {
        panic("pe_metal_buffer_pool FAIL [count_by_usage(2)] expected=1 got=" + to_string(u2))
    }
    let u3 = count_by_usage(3)
    if u3 != 1 {
        panic("pe_metal_buffer_pool FAIL [count_by_usage(3)] expected=1 got=" + to_string(u3))
    }
    let u4 = count_by_usage(4)
    if u4 != 1 {
        panic("pe_metal_buffer_pool FAIL [count_by_usage(4)] expected=1 got=" + to_string(u4))
    }
    let u99 = count_by_usage(99)
    if u99 != 0 {
        panic("pe_metal_buffer_pool FAIL [count_by_usage(99)] expected=0 got=" + to_string(u99))
    }

    // 7. buffer_reuses sanity
    let r3 = buffer_reuses(660003)
    if r3 != 5 {
        panic("pe_metal_buffer_pool FAIL [buffer_reuses(660003)] expected=5 got=" + to_string(r3))
    }
    let r5 = buffer_reuses(660005)
    if r5 != 0 {
        panic("pe_metal_buffer_pool FAIL [buffer_reuses(660005)] expected=0 got=" + to_string(r5))
    }
    let r_miss = buffer_reuses(9999)
    if r_miss != 0 {
        panic("pe_metal_buffer_pool FAIL [buffer_reuses(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 8. pmbp_stats() = [5, 80128, 11, 2]
    let s = pmbp_stats()
    if len(s) != 4 {
        panic("pe_metal_buffer_pool FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_metal_buffer_pool FAIL [stats buffer_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 80128 {
        panic("pe_metal_buffer_pool FAIL [stats total_size_bytes] expected=80128 got=" + to_string(s[1]))
    }
    if s[2] != 11 {
        panic("pe_metal_buffer_pool FAIL [stats total_reuses] expected=11 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_metal_buffer_pool FAIL [stats count_usage(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_metal_buffer_pool_stats",
        "\"buffer_count\":" + to_string(s[0])
        + ",\"total_size_bytes\":" + to_string(s[1])
        + ",\"total_reuses\":" + to_string(s[2])
        + ",\"usage_vertex\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_metal_buffer_pool FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pmbp()
    let s2 = pmbp_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_metal_buffer_pool FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_metal_buffer_pool self_test PASS (buffers=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", reuses=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmbp_stats()
            println("buffer_count\t" + to_string(s[0]))
            println("total_size_bytes\t" + to_string(s[1]))
            println("total_reuses\t" + to_string(s[2]))
            println("count_usage_vertex\t" + to_string(s[3]))
            return
        }
        if sub == "reuses" {
            if len(a) >= 4 {
                let bid = to_int(a[3])
                println("buffer_reuses\t" + to_string(buffer_reuses(bid)))
                return
            }
            println("usage: hexa run pe_metal_buffer_pool.hexa reuses <buffer_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let usage_kind = to_int(a[3])
                println("count_by_usage\t" + to_string(count_by_usage(usage_kind)))
                return
            }
            println("usage: hexa run pe_metal_buffer_pool.hexa count <usage_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmbp()
            println("cleaned: " + pmbp_dir())
            return
        }
        if sub == "dir" {
            println(pmbp_dir())
            return
        }
    }
    println("usage: hexa run pe_metal_buffer_pool.hexa { self-test | stats | reuses <buffer_id> | count <usage_kind> | cleanup | dir }")
}
