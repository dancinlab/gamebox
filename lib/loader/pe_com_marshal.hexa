// lib/loader/pe_com_marshal.hexa — cycle 77 Win32 CoMarshalInterface telemetry skeleton
//
// Cross-apartment proxy/stub creation. Win32 CoMarshalInterface /
// CoUnmarshalInterface / CoReleaseMarshalData / CoGetMarshalSizeMax 호출
// 추적 — apartment 간 IUnknown 직렬화 stream 크기/context 통계.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 marshal op tracker — 실 CoMarshalInterface() 호출 X (cycle 후반).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = marshal
//   2 = unmarshal
//   3 = release
//   4 = get_marshal_size
//
// marshal_context code:
//   1 = local
//   2 = no_iid
//   3 = different_machine
//   4 = in_process_handler
//
// persist schema (TSV — marshals.tsv):
//   marshal_id<int> \t op_kind<int> \t marshal_context<int> \t stream_size_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcm_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_com_marshal"
}

fn pcm_marshals_path() -> str {
    return pcm_dir() + "/marshals.tsv"
}

fn pcm_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcm_dir() + "'")
}

fn cleanup_pcm() -> void {
    pcm_ensure_dir()
    let _ = exec("rm -f '" + pcm_marshals_path() + "'")
}

// ─── 공통 file IO ───
fn pcm_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcm_append_row(path: str, row: str) -> void {
    pcm_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_marshal: marshal op 1 건 기록 ───
fn record_marshal(marshal_id: int, op_kind: int, marshal_context: int, stream_size_bytes: int) -> void {
    if marshal_id <= 0 {
        panic("pe_com_marshal FAIL [record_marshal] expected=marshal_id>0 got=" + to_string(marshal_id))
    }
    if op_kind < 1 {
        panic("pe_com_marshal FAIL [record_marshal] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 4 {
        panic("pe_com_marshal FAIL [record_marshal] expected=op_kind<=4 got=" + to_string(op_kind))
    }
    if marshal_context < 1 {
        panic("pe_com_marshal FAIL [record_marshal] expected=marshal_context>=1 got=" + to_string(marshal_context))
    }
    if marshal_context > 4 {
        panic("pe_com_marshal FAIL [record_marshal] expected=marshal_context<=4 got=" + to_string(marshal_context))
    }
    if stream_size_bytes < 0 {
        panic("pe_com_marshal FAIL [record_marshal] expected=stream_size_bytes>=0 got=" + to_string(stream_size_bytes))
    }
    let row = to_string(marshal_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(marshal_context) + "\t" + to_string(stream_size_bytes) + "\n"
    pcm_append_row(pcm_marshals_path(), row)
}

// ─── marshal_count: total marshal op 수 ───
fn marshal_count() -> int {
    let t = pcm_read_table(pcm_marshals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_stream_bytes: 모든 marshal op stream_size_bytes 합 ───
fn total_stream_bytes() -> int {
    let t = pcm_read_table(pcm_marshals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_op_kind: 특정 op_kind 의 marshal op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = pcm_read_table(pcm_marshals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_context: 특정 marshal_context 의 marshal op 수 ───
fn count_by_context(ctx: int) -> int {
    let t = pcm_read_table(pcm_marshals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == ctx {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── marshal_stream_size: 특정 marshal_id 의 stream_size_bytes (없으면 0) ───
fn marshal_stream_size(marshal_id: int) -> int {
    let t = pcm_read_table(pcm_marshals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == marshal_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pcm_stats: [marshal_count, total_stream_bytes, count_by_op_kind(1), count_by_context(1)] ───
fn pcm_stats() -> array {
    let mut out = []
    out.push(marshal_count())
    out.push(total_stream_bytes())
    out.push(count_by_op_kind(1))
    out.push(count_by_context(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pcm-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pcm()

    // 2. record 5 marshals across ≥3 op_kinds and ≥2 contexts
    record_marshal(170001, 1, 1, 256)
    r0_emit("pe_com_marshal_record",
        "\"marshal_id\":170001,\"op_kind\":1,\"marshal_context\":1,\"stream_size_bytes\":256,\"target\":\"marshal_local\"")

    record_marshal(170002, 1, 3, 512)
    r0_emit("pe_com_marshal_record",
        "\"marshal_id\":170002,\"op_kind\":1,\"marshal_context\":3,\"stream_size_bytes\":512,\"target\":\"marshal_different_machine\"")

    record_marshal(170003, 2, 1, 256)
    r0_emit("pe_com_marshal_record",
        "\"marshal_id\":170003,\"op_kind\":2,\"marshal_context\":1,\"stream_size_bytes\":256,\"target\":\"unmarshal_local\"")

    record_marshal(170004, 4, 3, 0)
    r0_emit("pe_com_marshal_record",
        "\"marshal_id\":170004,\"op_kind\":4,\"marshal_context\":3,\"stream_size_bytes\":0,\"target\":\"get_marshal_size\"")

    record_marshal(170005, 3, 1, 0)
    r0_emit("pe_com_marshal_record",
        "\"marshal_id\":170005,\"op_kind\":3,\"marshal_context\":1,\"stream_size_bytes\":0,\"target\":\"release\"")

    // 3. marshal_count = 5
    let c = marshal_count()
    if c != 5 {
        panic("pe_com_marshal FAIL [marshal_count] expected=5 got=" + to_string(c))
    }

    // 4. total_stream_bytes = 1024
    let tb = total_stream_bytes()
    if tb != 1024 {
        panic("pe_com_marshal FAIL [total_stream_bytes] expected=1024 got=" + to_string(tb))
    }

    // 5. count_by_op_kind sanity
    let k1 = count_by_op_kind(1)
    if k1 != 2 {
        panic("pe_com_marshal FAIL [count_by_op_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 1 {
        panic("pe_com_marshal FAIL [count_by_op_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_com_marshal FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 1 {
        panic("pe_com_marshal FAIL [count_by_op_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_com_marshal FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_context sanity
    let ctx1 = count_by_context(1)
    if ctx1 != 3 {
        panic("pe_com_marshal FAIL [count_by_context(1)] expected=3 got=" + to_string(ctx1))
    }
    let ctx3 = count_by_context(3)
    if ctx3 != 2 {
        panic("pe_com_marshal FAIL [count_by_context(3)] expected=2 got=" + to_string(ctx3))
    }
    let ctx99 = count_by_context(99)
    if ctx99 != 0 {
        panic("pe_com_marshal FAIL [count_by_context(99)] expected=0 got=" + to_string(ctx99))
    }

    // 7. marshal_stream_size sanity
    let s1 = marshal_stream_size(170001)
    if s1 != 256 {
        panic("pe_com_marshal FAIL [marshal_stream_size(170001)] expected=256 got=" + to_string(s1))
    }
    let s2 = marshal_stream_size(170002)
    if s2 != 512 {
        panic("pe_com_marshal FAIL [marshal_stream_size(170002)] expected=512 got=" + to_string(s2))
    }
    let s_miss = marshal_stream_size(9999)
    if s_miss != 0 {
        panic("pe_com_marshal FAIL [marshal_stream_size(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 8. pcm_stats() = [5, 1024, 2, 3]
    let s = pcm_stats()
    if len(s) != 4 {
        panic("pe_com_marshal FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_com_marshal FAIL [stats marshal_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 1024 {
        panic("pe_com_marshal FAIL [stats total_stream_bytes] expected=1024 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_com_marshal FAIL [stats kind_marshal] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_com_marshal FAIL [stats ctx_local] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_com_marshal_stats",
        "\"marshal_count\":" + to_string(s[0])
        + ",\"total_stream_bytes\":" + to_string(s[1])
        + ",\"kind_marshal\":" + to_string(s[2])
        + ",\"ctx_local\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_com_marshal FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pcm()
    let s2_post = pcm_stats()
    let i = 0
    while i < len(s2_post) {
        if s2_post[i] != 0 {
            panic("pe_com_marshal FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2_post[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_com_marshal self_test PASS (marshals=" + to_string(s[0])
        + ", stream_bytes=" + to_string(s[1]) + ", kind_marshal=" + to_string(s[2])
        + ", ctx_local=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcm_stats()
            println("marshal_count\t" + to_string(s[0]))
            println("total_stream_bytes\t" + to_string(s[1]))
            println("kind_marshal\t" + to_string(s[2]))
            println("ctx_local\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let mid = to_int(a[3])
                println("marshal_stream_size\t" + to_string(marshal_stream_size(mid)))
                return
            }
            println("usage: hexa run pe_com_marshal.hexa size <marshal_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_com_marshal.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcm()
            println("cleaned: " + pcm_dir())
            return
        }
        if sub == "dir" {
            println(pcm_dir())
            return
        }
    }
    println("usage: hexa run pe_com_marshal.hexa { self-test | stats | size <marshal_id> | count <op_kind> | cleanup | dir }")
}
