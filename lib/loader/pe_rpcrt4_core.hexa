// lib/loader/pe_rpcrt4_core.hexa — RPCRT4.dll RPC runtime surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine rpcrt4 source 인용 0.
//       rpcrt4.dll 직접 binding 0. macOS XPC / NSXPCConnection / mach_msg /
//       mach_port_allocate / launchd / Foundation NSConnection 직접 binding 0.
//       NOTE: RPCRT4 측 Battle.net Agent IPC + Warden long-horizon RPC binding +
//       D2R/D4 service IPC; RpcStringBindingComposeW/RpcServerListen/NdrClientCall2/
//       RpcBindingSetAuthInfoExW 측 RPC_BINDING_HANDLE/RPC_AUTH_IDENTITY round-trip
//       baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BH4 — RPCRT4 binding/server/client/auth surface 14 fn skeleton-tier.
// cycle 54 338/435 (~77.70%) → cycle 55 ~352/435 (~80.92%) (+14 fn, BH bundled part 4/4).
// **80% threshold breach milestone** at cycle 55 via BH4 RPCRT4.
// Mission spec target ~340/435 (~78%) — actual reaches 352/435 (~80.92%).
//
// 대상 fn (14 fn — 4 group, fn_kind 0..13):
//   BINDING (4): RpcStringBindingComposeW(0) / RpcBindingFromStringBindingW(1) /
//                RpcBindingFree(2) / RpcStringFreeW(3)
//   SERVER  (4): RpcServerListen(4) / RpcServerUseProtseqEpW(5) /
//                RpcServerRegisterIf(6) / RpcMgmtStopServerListening(7)
//   CLIENT  (3): NdrClientCall2(8) / NdrClientCall3(9) / RpcAsyncInitializeHandle(10)
//   AUTH    (3): RpcBindingSetAuthInfoExW(11) / RpcImpersonateClient(12) / RpcRevertToSelf(13)
//
// synthetic struct families:
//   RPC_BINDING_HANDLE 0xD0010100 opaque binding handle (synth).
//   RPC_STRING_BINDING_W "ncalrpc:[BattleNet_Agent_RPC_endpoint_synth]" WCHAR LE.
//   RPC_SERVER_INTERFACE 96B Length 96 + InterfaceId UUID 16B + TransferSyntax UUID 16B +
//     DispatchTable + RpcProtseqEndpointCount 1 + RpcProtseqEndpoint + DefaultManagerEpv +
//     InterpreterInfo + Flags 0.
//   RPC_AUTH_IDENTITY_HANDLE 0xD0020100 opaque (synth).
//   SEC_WINNT_AUTH_IDENTITY_W 32B User + UserLength + Domain + DomainLength + Password +
//     PasswordLength + Flags SEC_WINNT_AUTH_IDENTITY_UNICODE_2.
//   MIDL_STUB_DESC 80B + MIDL_STUB_MESSAGE 96B + RPC_CLIENT_INTERFACE 88B for NdrClientCall pattern.
//   RPC_ASYNC_STATE 88B Size 88 + Signature 0xACE0FEE0 + Lock 0 + Flags + StubInfo +
//     UserInfo + RuntimeInfo + Event + NotificationType + Reserved.
//   RPC_PROTSEQ_VECTOR_W "ncalrpc" / "ncacn_np" / "ncacn_ip_tcp:24.105.62.129[443]" battle_net.
//
// persist schema (TSV — 5 table):
//   syscall_invoke / binding_event / server_event / client_event / auth_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn prp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_rpcrt4_core"
}

fn prp_syscall_invoke_path() -> str {
    return prp_dir() + "/syscall_invoke.tsv"
}

fn prp_binding_event_path() -> str {
    return prp_dir() + "/binding_event.tsv"
}

fn prp_server_event_path() -> str {
    return prp_dir() + "/server_event.tsv"
}

fn prp_client_event_path() -> str {
    return prp_dir() + "/client_event.tsv"
}

fn prp_auth_event_path() -> str {
    return prp_dir() + "/auth_event.tsv"
}

fn prp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + prp_dir() + "'")
}

fn cleanup_prp() -> void {
    prp_ensure_dir()
    let _ = exec("rm -f '" + prp_syscall_invoke_path() + "' '" + prp_binding_event_path()
        + "' '" + prp_server_event_path() + "' '" + prp_client_event_path()
        + "' '" + prp_auth_event_path() + "'")
}

// ─── 공통 file IO ───
fn prp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn prp_append_row(path: str, row: str) -> void {
    prp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn prp_count_rows(path: str, min_cols: int) -> int {
    let t = prp_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (14 fn coverage, fn_kind 0..13) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "RpcStringBindingComposeW" }
    if k == 1 { return "RpcBindingFromStringBindingW" }
    if k == 2 { return "RpcBindingFree" }
    if k == 3 { return "RpcStringFreeW" }
    if k == 4 { return "RpcServerListen" }
    if k == 5 { return "RpcServerUseProtseqEpW" }
    if k == 6 { return "RpcServerRegisterIf" }
    if k == 7 { return "RpcMgmtStopServerListening" }
    if k == 8 { return "NdrClientCall2" }
    if k == 9 { return "NdrClientCall3" }
    if k == 10 { return "RpcAsyncInitializeHandle" }
    if k == 11 { return "RpcBindingSetAuthInfoExW" }
    if k == 12 { return "RpcImpersonateClient" }
    if k == 13 { return "RpcRevertToSelf" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "binding"
        }
    }
    if k >= 4 {
        if k <= 7 {
            return "server"
        }
    }
    if k >= 8 {
        if k <= 10 {
            return "client"
        }
    }
    if k >= 11 {
        if k <= 13 {
            return "auth"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: RPCRT4 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_rpcrt4_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_rpcrt4_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 13 {
        panic("pe_rpcrt4_core FAIL [record_syscall_invoke] expected=fn_kind<=13 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_rpcrt4_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_rpcrt4_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    prp_append_row(prp_syscall_invoke_path(), row)
}

// ─── record_binding_event: StringBindingCompose/FromStringBinding/BindingFree/StringFree row ───
fn record_binding_event(evt_id: int, b_kind: str, binding_str: str, handle_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_rpcrt4_core FAIL [record_binding_event] evt_id<=0") }
    if b_kind == "" { panic("pe_rpcrt4_core FAIL [record_binding_event] b_kind=empty") }
    if binding_str == "" { panic("pe_rpcrt4_core FAIL [record_binding_event] binding_str=empty") }
    if handle_synth == "" { panic("pe_rpcrt4_core FAIL [record_binding_event] handle_synth=empty") }
    if status == "" { panic("pe_rpcrt4_core FAIL [record_binding_event] status=empty") }
    let row = to_string(evt_id) + "\t" + b_kind + "\t" + binding_str + "\t" + handle_synth + "\t" + status + "\n"
    prp_append_row(prp_binding_event_path(), row)
}

// ─── record_server_event: ServerListen/UseProtseqEp/RegisterIf/StopListening row ───
fn record_server_event(evt_id: int, s_kind: str, protseq: str, iface_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_rpcrt4_core FAIL [record_server_event] evt_id<=0") }
    if s_kind == "" { panic("pe_rpcrt4_core FAIL [record_server_event] s_kind=empty") }
    if protseq == "" { panic("pe_rpcrt4_core FAIL [record_server_event] protseq=empty") }
    if iface_synth == "" { panic("pe_rpcrt4_core FAIL [record_server_event] iface_synth=empty") }
    if status == "" { panic("pe_rpcrt4_core FAIL [record_server_event] status=empty") }
    let row = to_string(evt_id) + "\t" + s_kind + "\t" + protseq + "\t" + iface_synth + "\t" + status + "\n"
    prp_append_row(prp_server_event_path(), row)
}

// ─── record_client_event: NdrClientCall2/NdrClientCall3/AsyncInit row ───
fn record_client_event(evt_id: int, c_kind: str, stub_synth: str, async_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_rpcrt4_core FAIL [record_client_event] evt_id<=0") }
    if c_kind == "" { panic("pe_rpcrt4_core FAIL [record_client_event] c_kind=empty") }
    if stub_synth == "" { panic("pe_rpcrt4_core FAIL [record_client_event] stub_synth=empty") }
    if async_synth == "" { panic("pe_rpcrt4_core FAIL [record_client_event] async_synth=empty") }
