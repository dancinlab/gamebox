    let row = to_string(evt_id) + "\t" + c_kind + "\t" + stub_synth + "\t" + async_synth + "\t" + status + "\n"
    prp_append_row(prp_client_event_path(), row)
}

// ─── record_auth_event: SetAuthInfoEx/ImpersonateClient/RevertToSelf row ───
fn record_auth_event(evt_id: int, a_kind: str, auth_svc: str, identity_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_rpcrt4_core FAIL [record_auth_event] evt_id<=0") }
    if a_kind == "" { panic("pe_rpcrt4_core FAIL [record_auth_event] a_kind=empty") }
    if auth_svc == "" { panic("pe_rpcrt4_core FAIL [record_auth_event] auth_svc=empty") }
    if identity_synth == "" { panic("pe_rpcrt4_core FAIL [record_auth_event] identity_synth=empty") }
    if status == "" { panic("pe_rpcrt4_core FAIL [record_auth_event] status=empty") }
    let row = to_string(evt_id) + "\t" + a_kind + "\t" + auth_svc + "\t" + identity_synth + "\t" + status + "\n"
