// lib/loader/pe_wait_for_multiple_object.hexa — cycle 71 WaitForMultipleObjects(Ex)
//
// Win32 WaitForMultipleObjects / WaitForMultipleObjectsEx dispatch telemetry.
// WaitAll vs WaitAny semantics; up to MAXIMUM_WAIT_OBJECTS (= 64) handles per call.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 wait dispatch tracker — 실 WaitForMultipleObjects() 호출 X.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// wait_mode code:
//   1 = wait_all   (모든 handle signaled 시 return)
//   2 = wait_any   (1 개 이상 signaled 시 return)
//
// signaled_index:
//   0 .. handle_count-1 = signaled object index (WAIT_OBJECT_0 + idx)
//   -1                  = WAIT_TIMEOUT
//
// persist schema (TSV — waits.tsv):
//   wait_id<int> \t wait_mode<int> \t handle_count<int> \t signaled_index<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwfmo_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_wait_for_multiple_object"
}

fn pwfmo_waits_path() -> str {
    return pwfmo_dir() + "/waits.tsv"
}

fn pwfmo_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwfmo_dir() + "'")
}

fn cleanup_pwfmo() -> void {
    pwfmo_ensure_dir()
    let _ = exec("rm -f '" + pwfmo_waits_path() + "'")
}

// ─── 공통 file IO ───
fn pwfmo_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwfmo_append_row(path: str, row: str) -> void {
    pwfmo_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_wait: WaitForMultipleObjects 호출 1 건 기록 ───
fn record_wait(wait_id: int, wait_mode: int, handle_count: int, signaled_index: int) -> void {
    if wait_id <= 0 {
        panic("pe_wait_for_multiple_object FAIL [record_wait] expected=wait_id>0 got=" + to_string(wait_id))
    }
    if wait_mode < 1 {
        panic("pe_wait_for_multiple_object FAIL [record_wait] expected=wait_mode>=1 got=" + to_string(wait_mode))
    }
    if wait_mode > 2 {
        panic("pe_wait_for_multiple_object FAIL [record_wait] expected=wait_mode<=2 got=" + to_string(wait_mode))
    }
    if handle_count < 1 {
        panic("pe_wait_for_multiple_object FAIL [record_wait] expected=handle_count>=1 got=" + to_string(handle_count))
    }
    if handle_count > 64 {
        panic("pe_wait_for_multiple_object FAIL [record_wait] expected=handle_count<=64 got=" + to_string(handle_count))
    }
    if signaled_index < -1 {
        panic("pe_wait_for_multiple_object FAIL [record_wait] expected=signaled_index>=-1 got=" + to_string(signaled_index))
    }
    if signaled_index >= handle_count {
        panic("pe_wait_for_multiple_object FAIL [record_wait] expected=signaled_index<handle_count got="
            + to_string(signaled_index) + "/" + to_string(handle_count))
    }
    let row = to_string(wait_id) + "\t" + to_string(wait_mode)
        + "\t" + to_string(handle_count) + "\t" + to_string(signaled_index) + "\n"
    pwfmo_append_row(pwfmo_waits_path(), row)
}

// ─── wait_count: total wait 수 ───
fn wait_count() -> int {
    let t = pwfmo_read_table(pwfmo_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_handles: 모든 wait 의 handle_count 합 ───
fn total_handles() -> int {
    let t = pwfmo_read_table(pwfmo_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── wait_all_count: wait_mode == 1 인 wait 수 ───
fn wait_all_count() -> int {
    let t = pwfmo_read_table(pwfmo_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── wait_any_count: wait_mode == 2 인 wait 수 ───
fn wait_any_count() -> int {
    let t = pwfmo_read_table(pwfmo_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == 2 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── timeout_count: signaled_index == -1 인 wait 수 ───
fn timeout_count() -> int {
    let t = pwfmo_read_table(pwfmo_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == -1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── wait_signaled_index: 특정 wait_id 의 signaled_index (없으면 -1) ───
fn wait_signaled_index(wait_id: int) -> int {
    let t = pwfmo_read_table(pwfmo_waits_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == wait_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pwfmo_stats: [wait_count, total_handles, wait_all_count, wait_any_count, timeout_count] ───
fn pwfmo_stats() -> array {
    let mut out = []
    out.push(wait_count())
    out.push(total_handles())
    out.push(wait_all_count())
    out.push(wait_any_count())
    out.push(timeout_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pwfmo-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pwfmo()

    // 2. record 6 waits — mix of wait_modes, ≥1 timeout
    //    layout: 4 wait_any + 2 wait_all, 2 timeouts (one of each mode)
    record_wait(710001, 2, 4, 0)
    r0_emit("pe_wait_for_multiple_object_record",
        "\"wait_id\":710001,\"wait_mode\":2,\"handle_count\":4,\"signaled_index\":0,\"target\":\"wait_any\"")

    record_wait(710002, 1, 8, 7)
    r0_emit("pe_wait_for_multiple_object_record",
        "\"wait_id\":710002,\"wait_mode\":1,\"handle_count\":8,\"signaled_index\":7,\"target\":\"wait_all\"")

    record_wait(710003, 2, 16, -1)
    r0_emit("pe_wait_for_multiple_object_record",
        "\"wait_id\":710003,\"wait_mode\":2,\"handle_count\":16,\"signaled_index\":-1,\"target\":\"wait_any_timeout\"")

    record_wait(710004, 2, 2, 1)
    r0_emit("pe_wait_for_multiple_object_record",
        "\"wait_id\":710004,\"wait_mode\":2,\"handle_count\":2,\"signaled_index\":1,\"target\":\"wait_any\"")

    record_wait(710005, 1, 64, -1)
    r0_emit("pe_wait_for_multiple_object_record",
        "\"wait_id\":710005,\"wait_mode\":1,\"handle_count\":64,\"signaled_index\":-1,\"target\":\"wait_all_timeout\"")

    record_wait(710006, 2, 6, 3)
    r0_emit("pe_wait_for_multiple_object_record",
        "\"wait_id\":710006,\"wait_mode\":2,\"handle_count\":6,\"signaled_index\":3,\"target\":\"wait_any\"")

    // 3. wait_count = 6
    let c = wait_count()
    if c != 6 {
        panic("pe_wait_for_multiple_object FAIL [wait_count] expected=6 got=" + to_string(c))
    }

    // 4. total_handles = 4+8+16+2+64+6 = 100
    let th = total_handles()
    if th != 100 {
        panic("pe_wait_for_multiple_object FAIL [total_handles] expected=100 got=" + to_string(th))
    }

    // 5. wait_all_count = 2
    let wac = wait_all_count()
    if wac != 2 {
        panic("pe_wait_for_multiple_object FAIL [wait_all_count] expected=2 got=" + to_string(wac))
    }

    // 6. wait_any_count = 4
    let wyc = wait_any_count()
    if wyc != 4 {
        panic("pe_wait_for_multiple_object FAIL [wait_any_count] expected=4 got=" + to_string(wyc))
    }

    // 7. timeout_count = 2
    let tc = timeout_count()
    if tc != 2 {
        panic("pe_wait_for_multiple_object FAIL [timeout_count] expected=2 got=" + to_string(tc))
    }

    // 8. wait_signaled_index sanity
    let si2 = wait_signaled_index(710002)
    if si2 != 7 {
        panic("pe_wait_for_multiple_object FAIL [wait_signaled_index(710002)] expected=7 got=" + to_string(si2))
    }
    let si3 = wait_signaled_index(710003)
    if si3 != -1 {
        panic("pe_wait_for_multiple_object FAIL [wait_signaled_index(710003)] expected=-1 got=" + to_string(si3))
    }
    let si_miss = wait_signaled_index(9999)
    if si_miss != -1 {
        panic("pe_wait_for_multiple_object FAIL [wait_signaled_index(9999)] expected=-1 got=" + to_string(si_miss))
    }

    // 9. pwfmo_stats() = [6, 100, 2, 4, 2]
    let s = pwfmo_stats()
    if len(s) != 5 {
        panic("pe_wait_for_multiple_object FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_wait_for_multiple_object FAIL [stats wait_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 100 {
        panic("pe_wait_for_multiple_object FAIL [stats total_handles] expected=100 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_wait_for_multiple_object FAIL [stats wait_all_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 4 {
        panic("pe_wait_for_multiple_object FAIL [stats wait_any_count] expected=4 got=" + to_string(s[3]))
    }
    if s[4] != 2 {
        panic("pe_wait_for_multiple_object FAIL [stats timeout_count] expected=2 got=" + to_string(s[4]))
    }

    // 10. emit stats
    r0_emit("pe_wait_for_multiple_object_stats",
        "\"wait_count\":" + to_string(s[0])
        + ",\"total_handles\":" + to_string(s[1])
        + ",\"wait_all\":" + to_string(s[2])
        + ",\"wait_any\":" + to_string(s[3])
        + ",\"timeout\":" + to_string(s[4]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_wait_for_multiple_object FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pwfmo()
    let s2 = pwfmo_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_wait_for_multiple_object FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_wait_for_multiple_object self_test PASS (waits=" + to_string(s[0])
        + ", handles=" + to_string(s[1]) + ", all=" + to_string(s[2])
        + ", any=" + to_string(s[3]) + ", timeout=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pwfmo_stats()
            println("wait_count\t" + to_string(s[0]))
            println("total_handles\t" + to_string(s[1]))
            println("wait_all_count\t" + to_string(s[2]))
            println("wait_any_count\t" + to_string(s[3]))
            println("timeout_count\t" + to_string(s[4]))
            return
        }
        if sub == "index" {
            if len(a) >= 4 {
                let wid = to_int(a[3])
                println("wait_signaled_index\t" + to_string(wait_signaled_index(wid)))
                return
            }
            println("usage: hexa run pe_wait_for_multiple_object.hexa index <wait_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let which = a[3]
                if which == "all" {
                    println("wait_all_count\t" + to_string(wait_all_count()))
                    return
                }
                if which == "any" {
                    println("wait_any_count\t" + to_string(wait_any_count()))
                    return
                }
                if which == "timeout" {
                    println("timeout_count\t" + to_string(timeout_count()))
                    return
                }
                println("usage: hexa run pe_wait_for_multiple_object.hexa count { all | any | timeout }")
                return
            }
            println("usage: hexa run pe_wait_for_multiple_object.hexa count { all | any | timeout }")
            return
        }
        if sub == "cleanup" {
            cleanup_pwfmo()
            println("cleaned: " + pwfmo_dir())
            return
        }
        if sub == "dir" {
            println(pwfmo_dir())
            return
        }
    }
    println("usage: hexa run pe_wait_for_multiple_object.hexa { self-test | stats | index <wait_id> | count all|any|timeout | cleanup | dir }")
}
