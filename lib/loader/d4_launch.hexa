// lib/loader/d4_launch.hexa — Phase 10 — D4 (Diablo IV) launch path skeleton
//
// own 1 enforcement: Wine / CrossOver / dxvk / vkd3d / Battle.net launcher /
//   community reverse 코드 0 줄.
//   참조 only — 공식 spec / 공개 학술 자료:
//     - D4 system requirements (Blizzard 공식):
//         https://us.battle.net/support/article/000380687
//     - D3D12 + DXR runtime (Microsoft Learn):
//         https://learn.microsoft.com/en-us/windows/win32/direct3d12/direct3d-12-raytracing
//     - DXGI swapchain (Microsoft Learn):
//         https://learn.microsoft.com/en-us/windows/win32/api/dxgi1_4/
//     - Winsock (online auth, Microsoft Learn):
//         https://learn.microsoft.com/en-us/windows/win32/api/winsock2/
//     - CRYPT32 (TLS handshake, Microsoft Learn):
//         https://learn.microsoft.com/en-us/windows/win32/api/wincrypt/
//     - Apple Metal raytracing (developer.apple.com):
//         https://developer.apple.com/documentation/metal/ray_tracing
//   Wine / CrossOver / dxvk / vkd3d / battle.net-launcher 단 1 줄 import 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 = 3: d4_info + d4_dxr_check + d4_phase_deps)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만 — 실 D4 binary 호출 없음, skeleton level)
//   - panic("d4_launch FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 10 — skeleton):
//   D4 launch path 의 *static description* 만 정의.
//     - DLL dependencies (KERNEL32 + USER32 + D3D12 + DXGI + WS2_32 + CRYPT32 + anti_cheat?)
//     - phase 의존성 (pe_parser → pe_loader → win32_kernel32 → ... → dx_d3d12 → ...)
//     - DirectX requirements (DX12 + DXR + 8GB+ GPU)
//     - DXR availability (macOS 14+ Apple Silicon — dx_d3d12::dxr_supported() 와 정합)
//     - online-auth blocker (Battle.net + BattlEye)
//     - launch scenarios (title → login → character_select → sanctuary → ...)
//     - validate_d4_path: PE 존재성 + d3d12 imports 확인 (skeleton — exec test)
//
//   실제 D4 process spawn / Battle.net auth tunnel / BattlEye bypass 는
//   phase 10 의 후속 sub-phase 또는 scope-out (auth/anti-cheat 은 own 2 외).
//
// D2R 와의 대조 — 더 복잡:
//   - D2R: DX11 (no raytracing), single-player offline 가능, anti-cheat 없음
//   - D4 : DX12 + DXR (mandatory), online-only auth (오프라인 X), BattlEye 필수
//
// Phase 10 plugin.json 진척도: phase_10_d4_first_frame = "planned" → "skeleton"

use "../perf/r0_common"

// ─── d4 정보 ───
//
//   여러 줄 string. self_test 는 substring "Diablo IV", "DX12", "DXR",
//   "x86_64" 가 모두 포함되어 있는지 검증.
fn d4_info() -> str {
    let s = "name=Diablo IV"
        + "\ndx_path=DX12+DXR"
        + "\nplatform=x86_64"
        + "\ndll_deps=KERNEL32+USER32+D3D12+DXGI+WS2_32+CRYPT32+anti_cheat?"
    return s
}

// ─── phase 의존성 (≥ 7) ───
//
//   D4 launch 가 성공하기 위해 우선 실행/검증되어야 하는 phase 모듈들.
//   순서는 일반적인 dependency order (PE 파싱 → loader → win32 → DX → online).
fn d4_phase_deps() -> array {
    let mut deps = []
    deps.push("pe_parser")
    deps.push("pe_loader")
    deps.push("pe_relocations")
    deps.push("pe_imports")
    deps.push("win32_kernel32")
    deps.push("win32_user32")
    deps.push("win32_ntdll")
    deps.push("win32_advapi32")
    deps.push("dx_d3d12")
    deps.push("win32_winsock")
    return deps
}

// ─── DirectX 요구사항 ───
//
//   substring "DirectX 12" + "DXR" 포함.
fn d4_dx_requirements() -> str {
    return "DirectX 12 + DXR (raytracing) + GPU 8GB+ VRAM (Blizzard official minimum)"
}

// ─── DXR 지원 여부 (자체 검사 — dx_d3d12::dxr_supported() 와 정합) ───
//
//   own 2 (only `use "../perf/r0_common"`) 제약 → dx_d3d12 import 금지.
//   동일 로직을 inline 로 복제 (Apple Metal raytracing 요구사항):
//     - arch == arm64 (Apple Silicon)
//     - macOS major ≥ 14 (Sonoma+)
//   둘 다 만족 시 true, 아니면 false.
//   참조: https://developer.apple.com/documentation/metal/mtldevice/3553988-supportsraytracing
fn d4_dxr_check() -> bool {
    let arch = exec("uname -m").trim()
    if arch != "arm64" {
        return false
    }
    let major = exec("sw_vers -productVersion 2>/dev/null | cut -d. -f1").trim()
    if major == "" {
        return false
    }
    let mj = to_int(major)
    if mj < 14 {
        return false
    }
    return true
}

// ─── auth blockers ───
//
//   D4 는 online-only (오프라인 single-player 없음). auth 우회 / anti-cheat
//   bypass 는 own 2 scope 외 — 명시적 declaration.
//   substring "online auth" + "anti-cheat" 포함.
fn d4_auth_blockers() -> str {
    return "Battle.net online auth + BattlEye anti-cheat — bypass scope 외"
}

// ─── launch scenarios (≥ 4) ───
//
//   D4 의 의미 있는 launch milestone phase 들.
//   각 element 는 array (title 1 개) — kernel32 stats 와 동형 구조.
fn d4_scenarios() -> array {
    let mut sc = []
    sc.push(["title_screen"])
    sc.push(["login"])
    sc.push(["character_select"])
    sc.push(["sanctuary_open_world"])
    sc.push(["dungeon_instance"])
    sc.push(["pvp_zone"])
    return sc
}

// ─── d4 binary 검증 (PE 존재성 + d3d12 imports — skeleton level) ───
//
//   반환: [exists, is_pe, has_d3d12_imports]  — 각 0 or 1
//     exists              — file 존재 (test -f)
//     is_pe               — DOS magic "MZ" (xxd head 2 byte) 검증
//     has_d3d12_imports   — strings | grep "d3d12.dll" hit
//
//   own 1: 외부 PE 파서 라이브러리 import 금지. shell 만 사용.
//   own 2: pe_parser import 금지 — d4_launch 는 r0_common 만 use.
fn validate_d4_path(d4_exe: str) -> array {
    let mut r = []
    // 1. exists
    let exists_str = exec("test -f '" + d4_exe + "' && echo yes || echo no").trim()
    let exists = exists_str == "yes"
    r.push(exists)
    // 2. is_pe — DOS magic "MZ" 검증 (skeleton — DOS e_lfanew 의 PE\0\0 검사는 후속).
    let is_pe = false
    if exists {
        let mz = exec("head -c 2 '" + d4_exe + "' 2>/dev/null").trim()
        if mz == "MZ" {
            // is_pe = true (skeleton — Phase 10 후속에서 pe_parser 호출로 교체)
        }
    }
    r.push(is_pe)
    // 3. has_d3d12_imports — IAT 에 D3D12.DLL import 포함 여부.
    //    skeleton: 실제 IAT 파싱 부재 → strings | grep 으로 fallback.
    //    Phase 10 후속에서 pe_imports module 호출로 교체.
    let mut has_d3d12 = false
    if exists {
        let has = exec("strings '" + d4_exe + "' 2>/dev/null | grep -ic 'd3d12\\.dll' || true").trim()
        if has != "" && has != "0" {
            has_d3d12 = true
        }
    }
    r.push(has_d3d12)
    return r
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "d4test-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. d4_info() contains "Diablo IV" + "DX12" + "DXR" + "x86_64"
    let info = d4_info()
    if info.index_of("Diablo IV") < 0 {
        panic("d4_launch FAIL [info Diablo IV] expected=substring got=missing")
    }
    if info.index_of("DX12") < 0 {
        panic("d4_launch FAIL [info DX12] expected=substring got=missing")
    }
    if info.index_of("DXR") < 0 {
        panic("d4_launch FAIL [info DXR] expected=substring got=missing")
    }
    if info.index_of("x86_64") < 0 {
        panic("d4_launch FAIL [info x86_64] expected=substring got=missing")
    }

    // 2. d4_phase_deps() ≥ 7 (DirectX 12 포함)
    let deps = d4_phase_deps()
    let dn = len(deps)
    if dn < 7 {
        panic("d4_launch FAIL [phase_deps count] expected=>=7 got=" + to_string(dn))
    }
    let i = 0
    let has_d3d12 = false
    while i < dn {
        if deps[i] == "dx_d3d12" {
            has_d3d12 = true
        }
        i = i + 1
    }
    if !has_d3d12 {
        panic("d4_launch FAIL [phase_deps dx_d3d12] expected=present got=absent")
    }

    // 3. d4_dx_requirements() contains "DirectX 12" + "DXR"
    let dx = d4_dx_requirements()
    if dx.index_of("DirectX 12") < 0 {
        panic("d4_launch FAIL [dx_req DirectX 12] expected=substring got=missing")
    }
    if dx.index_of("DXR") < 0 {
        panic("d4_launch FAIL [dx_req DXR] expected=substring got=missing")
    }

    // 4. d4_dxr_check() → bool (test 환경 따라 false 가능 — 그래도 OK)
    let dxr_ok = d4_dxr_check()
    let dxr_str = "false"
    if dxr_ok { dxr_str = "true" }

    // 5. d4_auth_blockers() contains "online auth" + "anti-cheat"
    let auth = d4_auth_blockers()
    if auth.index_of("online auth") < 0 {
        panic("d4_launch FAIL [auth online auth] expected=substring got=missing")
    }
    if auth.index_of("anti-cheat") < 0 {
        panic("d4_launch FAIL [auth anti-cheat] expected=substring got=missing")
    }

    // 6. d4_scenarios() ≥ 4
    let sc = d4_scenarios()
    let sn = len(sc)
    if sn < 4 {
        panic("d4_launch FAIL [scenarios count] expected=>=4 got=" + to_string(sn))
    }

    // 7. r0_emit "d4_info" + "d4_dxr_check" + "d4_phase_deps"
    r0_emit("d4_info",
        "\"name\":\"Diablo IV\""
        + ",\"dx\":\"DX12+DXR\""
        + ",\"platform\":\"x86_64\"")

    let arch = exec("uname -m").trim()
    let macos_ver = exec("sw_vers -productVersion 2>/dev/null").trim()
    r0_emit("d4_dxr_check",
        "\"arch\":\"" + arch + "\""
        + ",\"macos\":\"" + macos_ver + "\""
        + ",\"supported\":" + dxr_str)

    r0_emit("d4_phase_deps",
        "\"count\":" + to_string(dn)
        + ",\"scenarios\":" + to_string(sn))

    // R0 emit count 검증 — 정확히 3 events
    let emit_n = r0_session_count(sid)
    if emit_n != 3 {
        panic("d4_launch FAIL [r0 emit count] expected=3 got=" + to_string(emit_n))
    }

    println("  ✅ d4_launch self_test PASS (" + to_string(dn) + " phase deps, "
        + to_string(sn) + " scenarios, DXR support=" + dxr_str
        + ", arch=" + arch + ", macOS=" + macos_ver
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "info" {
            println(d4_info())
            return
        }
        if sub == "deps" {
            let deps = d4_phase_deps()
            let n = len(deps)
            let i = 0
            while i < n {
                println(deps[i])
                i = i + 1
            }
            return
        }
        if sub == "dx-req" {
            println(d4_dx_requirements())
            return
        }
        if sub == "dxr-check" {
            let ok = d4_dxr_check()
            if ok {
                println("true")
            } else {
                println("false")
            }
            return
        }
        if sub == "auth" {
            println(d4_auth_blockers())
            return
        }
        if sub == "scenarios" {
            let sc = d4_scenarios()
            let n = len(sc)
            let i = 0
            while i < n {
                println(sc[i][0])
                i = i + 1
            }
            return
        }
        if sub == "validate" {
            if len(a) >= 4 {
                let path = a[3]
                let r = validate_d4_path(path)
                let e_s = "false"
                if r[0] { e_s = "true" }
                let p_s = "false"
                if r[1] { p_s = "true" }
                let d_s = "false"
                if r[2] { d_s = "true" }
                println("exists=" + e_s + "\tis_pe=" + p_s + "\thas_d3d12_imports=" + d_s)
                return
            }
        }
    }
    println("usage: hexa run d4_launch.hexa { self-test | info | deps | dx-req | dxr-check | auth | scenarios | validate <path> }")
}
