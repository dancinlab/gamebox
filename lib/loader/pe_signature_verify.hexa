// lib/loader/pe_signature_verify.hexa — stage3 PE Authenticode signature verify skeleton
//
// PE 의 Certificate Table: PKCS#7 SignedData with embedded cert chain.
// Authenticode hash (.text 영역의 SHA256) + 발급자 cert chain → root CA.
// macOS Security.framework SecCMSDecoder 통해 chain validation.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   Apple Security.framework + CMS API doc 만 참조.
// own 2 mandate: r0_emit ≥ 5 + self_test() + main() dispatch + headless safe + panic 형식.
//
// hash_alg:
//   1 = SHA1
//   2 = SHA256
//   3 = SHA384
//   4 = SHA512
//
// persist schema (TSV — verify_history.tsv):
//   pe_id<int> \t hash_alg<int> \t chain_depth<int> \t valid<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn psv_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_signature_verify"
}

fn psv_history_path() -> str {
    return psv_dir() + "/verify_history.tsv"
}

fn psv_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + psv_dir() + "'")
}

fn cleanup_psv() -> void {
    psv_ensure_dir()
    let _ = exec("rm -f '" + psv_history_path() + "'")
}

// ─── 공통 file IO ───
fn psv_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn psv_append_row(path: str, row: str) -> void {
    psv_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_verify: PE Authenticode verify 1건 기록 ───
//   stage4 에서 실 SecCMSDecoder + SecTrustEvaluate 로 교체.
fn record_verify(pe_id: int, hash_alg: int, chain_depth: int, valid: int) -> void {
    if pe_id <= 0 {
        panic("pe_signature_verify FAIL [record_verify] expected=pe_id>0 got=" + to_string(pe_id))
    }
    if hash_alg < 1 {
        panic("pe_signature_verify FAIL [record_verify] expected=hash_alg>=1 got=" + to_string(hash_alg))
    }
    if hash_alg > 4 {
        panic("pe_signature_verify FAIL [record_verify] expected=hash_alg<=4 got=" + to_string(hash_alg))
    }
    if chain_depth <= 0 {
        panic("pe_signature_verify FAIL [record_verify] expected=chain_depth>0 got=" + to_string(chain_depth))
    }
    if valid < 0 {
        panic("pe_signature_verify FAIL [record_verify] expected=valid>=0 got=" + to_string(valid))
    }
    if valid > 1 {
        panic("pe_signature_verify FAIL [record_verify] expected=valid<=1 got=" + to_string(valid))
    }
    let row = to_string(pe_id) + "\t" + to_string(hash_alg)
        + "\t" + to_string(chain_depth) + "\t" + to_string(valid) + "\n"
    psv_append_row(psv_history_path(), row)
}

// ─── verify_count: 총 verify 수 ───
fn verify_count() -> int {
    let mut cnt = 0
    let t = psv_read_table(psv_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── valid_count: valid=1 건수 ───
fn valid_count() -> int {
    let mut cnt = 0
    let t = psv_read_table(psv_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── invalid_count: valid=0 건수 ───
fn invalid_count() -> int {
    let mut cnt = 0
    let t = psv_read_table(psv_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_hash_alg: 특정 hash_alg 의 verify 수 ───
fn count_by_hash_alg(alg: int) -> int {
    let mut cnt = 0
    let t = psv_read_table(psv_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == alg {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── pe_chain_depth: 특정 pe_id 의 chain_depth ───
fn pe_chain_depth(pe_id: int) -> int {
    let mut depth = 0
    let t = psv_read_table(psv_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == pe_id {
                    depth = to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return depth
}

// ─── psv_stats: [verify_count, valid_count, count_by_hash_alg(2), count_by_hash_alg(1)] ───
fn psv_stats() -> array {
    let mut out = []
    out.push(verify_count())
    out.push(valid_count())
    out.push(count_by_hash_alg(2))
    out.push(count_by_hash_alg(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "psigver-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_psv()

    // 2. record 4 verifies (Battle.net Setup / D2R.exe / Old PE / Self-signed)
    record_verify(92001, 2, 4, 1)
    r0_emit("pe_signature_verify_record",
        "\"pe_id\":92001,\"hash_alg\":2,\"chain_depth\":4,\"valid\":1,\"label\":\"battlenet_setup_sha256\"")

    record_verify(92002, 2, 3, 1)
    r0_emit("pe_signature_verify_record",
        "\"pe_id\":92002,\"hash_alg\":2,\"chain_depth\":3,\"valid\":1,\"label\":\"d2r_exe_sha256\"")

    record_verify(92003, 1, 3, 0)
    r0_emit("pe_signature_verify_record",
        "\"pe_id\":92003,\"hash_alg\":1,\"chain_depth\":3,\"valid\":0,\"label\":\"old_pe_sha1_revoked\"")

    record_verify(92004, 2, 2, 1)
    r0_emit("pe_signature_verify_record",
        "\"pe_id\":92004,\"hash_alg\":2,\"chain_depth\":2,\"valid\":1,\"label\":\"selfsigned_sha256\"")

    // 3. verify_count = 4
    let vc = verify_count()
    if vc != 4 {
        panic("pe_signature_verify FAIL [verify_count] expected=4 got=" + to_string(vc))
    }

    // 4. valid_count = 3
    let vlc = valid_count()
    if vlc != 3 {
        panic("pe_signature_verify FAIL [valid_count] expected=3 got=" + to_string(vlc))
    }

    // 5. invalid_count = 1
    let ivc = invalid_count()
    if ivc != 1 {
        panic("pe_signature_verify FAIL [invalid_count] expected=1 got=" + to_string(ivc))
    }

    // 6. count_by_hash_alg
    let h1 = count_by_hash_alg(1)
    if h1 != 1 {
        panic("pe_signature_verify FAIL [count_by_hash_alg(1)] expected=1 got=" + to_string(h1))
    }
    let h2 = count_by_hash_alg(2)
    if h2 != 3 {
        panic("pe_signature_verify FAIL [count_by_hash_alg(2)] expected=3 got=" + to_string(h2))
    }
    let h3 = count_by_hash_alg(3)
    if h3 != 0 {
        panic("pe_signature_verify FAIL [count_by_hash_alg(3)] expected=0 got=" + to_string(h3))
    }
    let h99 = count_by_hash_alg(99)
    if h99 != 0 {
        panic("pe_signature_verify FAIL [count_by_hash_alg(99)] expected=0 got=" + to_string(h99))
    }

    // 7. pe_chain_depth
    let d1 = pe_chain_depth(92001)
    if d1 != 4 {
        panic("pe_signature_verify FAIL [pe_chain_depth(92001)] expected=4 got=" + to_string(d1))
    }
    let d2 = pe_chain_depth(92002)
    if d2 != 3 {
        panic("pe_signature_verify FAIL [pe_chain_depth(92002)] expected=3 got=" + to_string(d2))
    }
    let d0 = pe_chain_depth(9999)
    if d0 != 0 {
        panic("pe_signature_verify FAIL [pe_chain_depth(9999)] expected=0 got=" + to_string(d0))
    }

    // 8. psv_stats() = [4, 3, 3, 1]
    let s = psv_stats()
    if len(s) != 4 {
        panic("pe_signature_verify FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 4 {
        panic("pe_signature_verify FAIL [stats verify_count] expected=4 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_signature_verify FAIL [stats valid_count] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_signature_verify FAIL [stats count_by_hash_alg(2)] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_signature_verify FAIL [stats count_by_hash_alg(1)] expected=1 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_signature_verify_stats",
        "\"verify_count\":" + to_string(s[0])
        + ",\"valid_count\":" + to_string(s[1])
        + ",\"count_sha256\":" + to_string(s[2])
        + ",\"count_sha1\":" + to_string(s[3]))

    // 10. emit count >= 5 (실제: 4 records + 1 stats = 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("pe_signature_verify FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_psv()
    let s2 = psv_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_signature_verify FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_signature_verify self_test PASS (4 verifies, valid=" + to_string(s[1])
        + ", invalid=" + to_string(ivc) + ", sha256=" + to_string(s[2])
        + ", sha1=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = psv_stats()
            println("verify_count\t" + to_string(s[0]))
            println("valid_count\t" + to_string(s[1]))
            println("count_by_hash_alg(2)\t" + to_string(s[2]))
            println("count_by_hash_alg(1)\t" + to_string(s[3]))
            return
        }
        if sub == "chain" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                println("pe_chain_depth(" + to_string(pid) + ")\t" + to_string(pe_chain_depth(pid)))
                return
            }
            println("usage: hexa run pe_signature_verify.hexa chain <pe_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println("count_by_hash_alg(" + to_string(k) + ")\t" + to_string(count_by_hash_alg(k)))
                return
            }
            println("usage: hexa run pe_signature_verify.hexa count <hash_alg>")
            return
        }
        if sub == "cleanup" {
            cleanup_psv()
            println("cleaned: " + psv_dir())
            return
        }
        if sub == "dir" {
            println(psv_dir())
            return
        }
    }
    println("usage: hexa run pe_signature_verify.hexa { self-test | stats | chain <pe_id> | count <hash_alg> | cleanup | dir }")
}
