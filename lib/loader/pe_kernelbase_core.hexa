    r0_emit("pe_kernelbase_core_record", "\"kind\":\"process_modern_event\",\"evt_id\":3,\"p_kind\":\"get_mitigation_signature\",\"policy_synth\":\"ProcessSignaturePolicy_8\",\"target_synth\":\"PROCESS_MITIGATION_BINARY_SIGNATURE_POLICY_4B\",\"struct_bytes\":4,\"battlenet_signature_check_baseline\":true,\"status\":\"PARTIAL\"")
    record_process_modern_event(4, "createprocess_as_user_d4_launcher", "STARTUPINFOEX_112B", "d4_launcher_exe", "PARTIAL")
    r0_emit("pe_kernelbase_core_record", "\"kind\":\"process_modern_event\",\"evt_id\":4,\"p_kind\":\"createprocess_as_user_d4_launcher\",\"policy_synth\":\"STARTUPINFOEX_112B\",\"target_synth\":\"d4_launcher_exe\",\"struct_bytes\":112,\"hToken\":\"0xC0070100_HTOKEN_user_synth\",\"out_pid\":2048,\"out_tid\":2049,\"d4_launcher_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 12 {
        panic("pe_kernelbase_core FAIL [syscall_invoke_count] expected=12 got=" + to_string(si))
    }
    let fe = file_extras_event_count()
    if fe != 4 {
        panic("pe_kernelbase_core FAIL [file_extras_event_count] expected=4 got=" + to_string(fe))
    }
    let me = memory_event_count()
    if me != 4 {
        panic("pe_kernelbase_core FAIL [memory_event_count] expected=4 got=" + to_string(me))
    }
    let pme = process_modern_event_count()
    if pme != 4 {
        panic("pe_kernelbase_core FAIL [process_modern_event_count] expected=4 got=" + to_string(pme))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "GetFileInformationByHandleEx" { panic("pe_kernelbase_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "CopyFile2" { panic("pe_kernelbase_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(4) != "VirtualAlloc2" { panic("pe_kernelbase_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(8) != "CreateRemoteThreadEx" { panic("pe_kernelbase_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(11) != "CreateProcessAsUserW" { panic("pe_kernelbase_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_kernelbase_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "file_extras" { panic("pe_kernelbase_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "memory" { panic("pe_kernelbase_core FAIL [fn_group_name(4)]") }
    if fn_group_name(8) != "process_modern" { panic("pe_kernelbase_core FAIL [fn_group_name(8)]") }
    if fn_group_name(99) != "unknown" { panic("pe_kernelbase_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = put_stats()
    if len(s) != 4 { panic("pe_kernelbase_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 12 { panic("pe_kernelbase_core FAIL [stats syscall_invoke_count] expected=12 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_kernelbase_core FAIL [stats file_extras_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_kernelbase_core FAIL [stats memory_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 4 { panic("pe_kernelbase_core FAIL [stats process_modern_event_count] expected=4 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_kernelbase_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"file_extras_event_count\":" + to_string(s[1])
        + ",\"memory_event_count\":" + to_string(s[2])
        + ",\"process_modern_event_count\":" + to_string(s[3]))

    r0_emit("pe_kernelbase_core_summary",
        "\"target\":\"KERNELBASE.dll\",\"fn_total\":12,\"fn_emit_partial\":12,\"groups\":[\"file_extras\",\"memory\",\"process_modern\"],\"hfile_synth\":\"0xC0010100\",\"file_basic_info_bytes\":40,\"copyfile2_ext_params_bytes\":40,\"win32_find_dataw_bytes\":592,\"mem_extended_param_bytes\":16,\"startupinfoex_bytes\":112,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_kernelbase_core_kpi",
        "\"file_extras_emits\":4,\"memory_emits\":4,\"process_modern_emits\":4,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_savegame_baseline\":true,\"d4_launcher_baseline\":true,\"battlenet_install_baseline\":true,\"posix_bridge_binding\":false,\"mach_vm_binding\":false,\"nsfilemanager_binding\":false")

    // ─── cycle 55 → 56 KERNELBASE coverage progression evidence emit ───
    r0_emit("pe_kernelbase_core_coverage_progression",
        "\"surface\":\"KERNELBASE_full_435_fn\",\"cycle_55_count\":352,\"cycle_56_count\":364,\"delta\":12,\"cycle_55_percent\":80.92,\"cycle_56_percent\":83.68,\"cycle_56_module\":\"pe_kernelbase_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_bl1_cycle_increment\":12,\"track_bl_bundled_part_1_of_4\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_kernelbase_core_round_trip_matrix",
        "\"surface\":\"KERNELBASE_core_12_fn\",\"fn_partial\":12,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real GetFileInformationByHandleEx + VirtualAlloc2 + CreateRemoteThreadEx = POSIX fstat/mmap_named/dispatch_io + Mach VM vm_allocate/vm_protect + pthread_create_in_target_task bridge pending separate cycle (long-horizon modern split API pipeline)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    // ─── Track BL1 expansion emit (cycle 56, KERNELBASE +12 fn) ───
    r0_emit("pe_kernelbase_core_bl1_expansion",
        "\"track\":\"BL1\",\"cycle\":56,\"surface\":\"KERNELBASE_new\",\"new_fn\":12,\"groups\":[\"file_extras\",\"memory\",\"process_modern\"],\"file_extras_count\":4,\"memory_count\":4,\"process_modern_count\":4,\"emit_format\":\"__KERNELBASE__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_bl_bundled_part_1_of_4\":true,\"kernel32_split_modern_family\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 16 {
        panic("pe_kernelbase_core FAIL [r0 emit count] expected=>=16 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_put()
    let s2 = put_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_kernelbase_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_kernelbase_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", file_extras_event=" + to_string(s[1])
        + ", memory_event=" + to_string(s[2]) + ", process_modern_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = put_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("file_extras_event_count\t" + to_string(s[1]))
            println("memory_event_count\t" + to_string(s[2]))
            println("process_modern_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_kernelbase_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_kernelbase_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_put()
            println("cleaned: " + put_dir())
            return
        }
        if sub == "dir" {
            println(put_dir())
            return
        }
    }
    println("usage: hexa run pe_kernelbase_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
