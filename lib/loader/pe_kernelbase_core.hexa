    println("__KERNELBASE__ PARTIAL SetFileInformationByHandle")
    r0_emit("pe_kernelbase_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"SetFileInformationByHandle\",\"fn_group\":\"file_extras\",\"status\":\"PARTIAL\",\"hFile\":\"0xC0010100_HFILE\",\"FileInformationClass\":\"FileEndOfFileInfo_6\",\"lpFileInformation\":\"FILE_END_OF_FILE_INFO_8B_synth\",\"dwBufferSize\":8,\"return_bool\":\"TRUE_1\"")
