    r0_emit("pe_kernelbase_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"FindFirstFileExW\",\"fn_group\":\"file_extras\",\"status\":\"PARTIAL\",\"lpFileName\":\"d4_install_root_search_pattern\",\"fInfoLevelId\":\"FindExInfoBasic_1\",\"lpFindFileData\":\"WIN32_FIND_DATAW_592B\",\"struct_bytes\":592,\"fSearchOp\":\"FindExSearchNameMatch_0\",\"out_HANDLE\":\"0xC0020100_HFIND\",\"return_handle\":\"0xC0020100\"")

