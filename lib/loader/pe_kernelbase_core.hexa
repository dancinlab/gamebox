// lib/loader/pe_kernelbase_core.hexa — KERNELBASE.dll modern Win32 forward-only API surface (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine kernelbase source 인용 0.
//       kernelbase.dll 직접 binding 0. macOS POSIX bridge / Mach VM / dispatch_io / Foundation
//       NSFileManager·NSData·NSURL·NSDictionary·NSURLSession 직접 binding 0.
//       NOTE: KERNELBASE 측 KERNEL32 split fn 측 modern Win32 API 측 forward-only surface
//       baseline; GetFileInformationByHandleEx + VirtualAlloc2 + CreateRemoteThreadEx 측
//       BY_HANDLE_FILE_INFORMATION_EX / MEM_EXTENDED_PARAMETER / PROCESS_MITIGATION_POLICY
//       round-trip (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 16 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BL1 — KERNELBASE modern split surface 12 fn skeleton-tier (file/memory/process modern).
// cycle 55 352/435 (~80.92%) → cycle 56 ~364/435 (~83.68%) (+12 fn, BL bundled part 1/4).
//
// 대상 fn (12 fn — 3 group, fn_kind 0..11):
//   FILE_EXTRAS    (4): GetFileInformationByHandleEx(0) / SetFileInformationByHandle(1) /
//                       CopyFile2(2) / FindFirstFileExW(3)
//   MEMORY         (4): VirtualAlloc2(4) / MapViewOfFile3(5) / CreateFileMappingFromApp(6) /
//                       VirtualLock(7)
//   PROCESS_MODERN (4): CreateRemoteThreadEx(8) / SetProcessMitigationPolicy(9) /
//                       GetProcessMitigationPolicy(10) / CreateProcessAsUserW(11)
//
// synthetic struct families:
//   FILE_BASIC_INFO 40B / FILE_STANDARD_INFO 24B / FILE_NAME_INFO_var d2r_savegame_d2s.
//   COPYFILE2_EXTENDED_PARAMETERS 40B dwSize=40 dwCopyFlags 0x00000001 COPY_FILE_FAIL_IF_EXISTS.
//   WIN32_FIND_DATAW 592B d4_install_root.
//   MEM_EXTENDED_PARAMETER 16B Type=2 ULONG64 NumaNode + MEM_RESERVE_PLACEHOLDER 0x40000.
//   PROCESS_MITIGATION_POLICY enum DEP=0 ASLR=1 ControlFlowGuard=7 BinarySignature=8.
//   STARTUPINFOEX 112B + LPPROC_THREAD_ATTRIBUTE_LIST 0xC0010100 synth.
//
// persist schema (TSV — 4 table):
//   syscall_invoke / file_extras_event / memory_event / process_modern_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn put_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_kernelbase_core"
}

fn put_syscall_invoke_path() -> str {
    return put_dir() + "/syscall_invoke.tsv"
}

fn put_file_extras_event_path() -> str {
    return put_dir() + "/file_extras_event.tsv"
}

fn put_memory_event_path() -> str {
    return put_dir() + "/memory_event.tsv"
}

fn put_process_modern_event_path() -> str {
    return put_dir() + "/process_modern_event.tsv"
}

fn put_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + put_dir() + "'")
}

fn cleanup_put() -> void {
    put_ensure_dir()
    let _ = exec("rm -f '" + put_syscall_invoke_path() + "' '" + put_file_extras_event_path()
        + "' '" + put_memory_event_path() + "' '" + put_process_modern_event_path() + "'")
}

// ─── 공통 file IO ───
fn put_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn put_append_row(path: str, row: str) -> void {
    put_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn put_count_rows(path: str, min_cols: int) -> int {
    let t = put_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "GetFileInformationByHandleEx" }
    if k == 1 { return "SetFileInformationByHandle" }
    if k == 2 { return "CopyFile2" }
    if k == 3 { return "FindFirstFileExW" }
    if k == 4 { return "VirtualAlloc2" }
    if k == 5 { return "MapViewOfFile3" }
    if k == 6 { return "CreateFileMappingFromApp" }
    if k == 7 { return "VirtualLock" }
    if k == 8 { return "CreateRemoteThreadEx" }
    if k == 9 { return "SetProcessMitigationPolicy" }
    if k == 10 { return "GetProcessMitigationPolicy" }
    if k == 11 { return "CreateProcessAsUserW" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "file_extras"
        }
    }
    if k >= 4 {
        if k <= 7 {
            return "memory"
        }
    }
    if k >= 8 {
        if k <= 11 {
            return "process_modern"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: KERNELBASE fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_kernelbase_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_kernelbase_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_kernelbase_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_kernelbase_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_kernelbase_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    put_append_row(put_syscall_invoke_path(), row)
}

// ─── record_file_extras_event: GetFileInformationByHandleEx/SetFileInformationByHandle/CopyFile2/FindFirstFileExW row ───
fn record_file_extras_event(evt_id: int, f_kind: str, info_class: str, file_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_kernelbase_core FAIL [record_file_extras_event] evt_id<=0") }
    if f_kind == "" { panic("pe_kernelbase_core FAIL [record_file_extras_event] f_kind=empty") }
    if info_class == "" { panic("pe_kernelbase_core FAIL [record_file_extras_event] info_class=empty") }
    if file_synth == "" { panic("pe_kernelbase_core FAIL [record_file_extras_event] file_synth=empty") }
    if status == "" { panic("pe_kernelbase_core FAIL [record_file_extras_event] status=empty") }
    let row = to_string(evt_id) + "\t" + f_kind + "\t" + info_class + "\t" + file_synth + "\t" + status + "\n"
    put_append_row(put_file_extras_event_path(), row)
}

// ─── record_memory_event: VirtualAlloc2/MapViewOfFile3/CreateFileMappingFromApp/VirtualLock row ───
fn record_memory_event(evt_id: int, m_kind: str, addr_synth: str, size_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_kernelbase_core FAIL [record_memory_event] evt_id<=0") }
    if m_kind == "" { panic("pe_kernelbase_core FAIL [record_memory_event] m_kind=empty") }
    if addr_synth == "" { panic("pe_kernelbase_core FAIL [record_memory_event] addr_synth=empty") }
    if size_synth == "" { panic("pe_kernelbase_core FAIL [record_memory_event] size_synth=empty") }
    if status == "" { panic("pe_kernelbase_core FAIL [record_memory_event] status=empty") }
    let row = to_string(evt_id) + "\t" + m_kind + "\t" + addr_synth + "\t" + size_synth + "\t" + status + "\n"
    put_append_row(put_memory_event_path(), row)
}

// ─── record_process_modern_event: CreateRemoteThreadEx/(Set|Get)ProcessMitigationPolicy/CreateProcessAsUserW row ───
fn record_process_modern_event(evt_id: int, p_kind: str, policy_synth: str, target_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_kernelbase_core FAIL [record_process_modern_event] evt_id<=0") }
    if p_kind == "" { panic("pe_kernelbase_core FAIL [record_process_modern_event] p_kind=empty") }
    if policy_synth == "" { panic("pe_kernelbase_core FAIL [record_process_modern_event] policy_synth=empty") }
    if target_synth == "" { panic("pe_kernelbase_core FAIL [record_process_modern_event] target_synth=empty") }
    if status == "" { panic("pe_kernelbase_core FAIL [record_process_modern_event] status=empty") }
    let row = to_string(evt_id) + "\t" + p_kind + "\t" + policy_synth + "\t" + target_synth + "\t" + status + "\n"
    put_append_row(put_process_modern_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return put_count_rows(put_syscall_invoke_path(), 4)
}

fn file_extras_event_count() -> int {
    return put_count_rows(put_file_extras_event_path(), 5)
}

fn memory_event_count() -> int {
    return put_count_rows(put_memory_event_path(), 5)
}

fn process_modern_event_count() -> int {
    return put_count_rows(put_process_modern_event_path(), 5)
}

fn put_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(file_extras_event_count())
    out.push(memory_event_count())
    out.push(process_modern_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 16 ───
fn self_test() -> void {
    let sid = "put-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_put()

    // ─── 1. syscall_invoke × 12 (one per fn, 3 group coverage) ───
    //   FILE_EXTRAS group (4)
    record_syscall_invoke(1, 0, "GetFileInformationByHandleEx", "PARTIAL")
    println("__KERNELBASE__ PARTIAL GetFileInformationByHandleEx")
    r0_emit("pe_kernelbase_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"GetFileInformationByHandleEx\",\"fn_group\":\"file_extras\",\"status\":\"PARTIAL\",\"hFile\":\"0xC0010100_HFILE\",\"FileInformationClass\":\"FileBasicInfo_0\",\"out_lpFileInformation\":\"FILE_BASIC_INFO_40B\",\"dwBufferSize\":40,\"return_bool\":\"TRUE_1\"")
