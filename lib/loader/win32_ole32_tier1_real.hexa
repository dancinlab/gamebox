// lib/loader/win32_ole32_tier1_real.hexa — cycle 81 R6 Tier 1 OLE32 trivial impl tracker
//
// Tier 1 trivial OLE32 → Apple-native:
//   CoInitialize / CoInitializeEx       → cycle 77 pe_com_initialize 추적기 + per-thread apartment slot
//   CoUninitialize                      → apartment slot decrement
//   CoCreateInstance                    → CLSID lookup table (skeleton — known D2R/Battle.net CLSID 만)
//   CoTaskMemAlloc / CoTaskMemFree      → malloc / free
//   CoCreateGuid                        → uuid_generate (Apple)
//   CLSIDFromString / StringFromCLSID   → uuid_parse / uuid_unparse
//   PropVariantInit                     → memset 0 sentinel
// own1: Apple Foundation + MSDN. Wine ole32/compobj.c 인용 X
//
// own 1 enforcement: Wine / Reactos / CrossOver / community 코드 0 줄.
//   본 module 은 OLE32 Tier 1 1-line 함수 호출 tracker — 실 native dispatch X.
//   Apple-native mapping 은 docstring 만 (실 helper.mm bridge stage6).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code (OLE32 export):
//   1  = CoInitialize
//   2  = CoInitializeEx
//   3  = CoUninitialize
//   4  = CoCreateInstance
//   5  = CoTaskMemAlloc
//   6  = CoTaskMemFree
//   7  = CoCreateGuid
//   8  = CLSIDFromString
//   9  = StringFromCLSID
//  10  = PropVariantInit
//
// impl_status code:
//   1 = real_apartment_table  (cycle 77 pe_com_initialize tracker + per-thread apartment slot)
//   2 = stub_no_op            (deterministic no-op — Tier 1 placeholder)
//   3 = stub_malloc           (malloc / free passthrough)
//   4 = uuid_real             (uuid_generate / uuid_parse / uuid_unparse — Apple libuuid)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t impl_status<int> \t hresult<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wot1_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_ole32_tier1_real"
}

fn wot1_calls_path() -> str {
    return wot1_dir() + "/calls.tsv"
}

fn wot1_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wot1_dir() + "'")
}

fn cleanup_wot1() -> void {
    wot1_ensure_dir()
    let _ = exec("rm -f '" + wot1_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wot1_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wot1_append_row(path: str, row: str) -> void {
    wot1_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: OLE32 Tier 1 호출 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, impl_status: int, hresult: int) -> void {
    if call_id <= 0 {
        panic("win32_ole32_tier1_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_ole32_tier1_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 10 {
        panic("win32_ole32_tier1_real FAIL [record_call] expected=func_kind<=10 got=" + to_string(func_kind))
    }
    if impl_status < 1 {
        panic("win32_ole32_tier1_real FAIL [record_call] expected=impl_status>=1 got=" + to_string(impl_status))
    }
    if impl_status > 4 {
        panic("win32_ole32_tier1_real FAIL [record_call] expected=impl_status<=4 got=" + to_string(impl_status))
    }
    if hresult < 0 {
        panic("win32_ole32_tier1_real FAIL [record_call] expected=hresult>=0 got=" + to_string(hresult))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(impl_status) + "\t" + to_string(hresult) + "\n"
    wot1_append_row(wot1_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wot1_read_table(wot1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 호출 수 ───
fn count_by_func_kind(func_kind: int) -> int {
    let t = wot1_read_table(wot1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == func_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_impl_status: 특정 impl_status 의 호출 수 ───
fn count_by_impl_status(impl_status: int) -> int {
    let t = wot1_read_table(wot1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == impl_status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── success_hresult_count: hresult == 0 (S_OK) 인 호출 수 ───
fn success_hresult_count() -> int {
    let t = wot1_read_table(wot1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_hresult: 모든 호출 hresult 합 ───
fn total_hresult() -> int {
    let t = wot1_read_table(wot1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── call_hresult: 특정 call_id 의 hresult (없으면 0) ───
fn call_hresult(call_id: int) -> int {
    let t = wot1_read_table(wot1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wot1_stats: [call_count, success_hresult_count, total_hresult, count_by_impl_status(4)] ───
fn wot1_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(success_hresult_count())
    out.push(total_hresult())
    out.push(count_by_impl_status(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wot1-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wot1()

    // 2. record 6 calls (≥4 func_kinds, ≥3 impl_statuses)
    //    func_kinds: 1 (CoInitialize), 2 (CoInitializeEx), 3 (CoUninitialize),
    //                5 (CoTaskMemAlloc), 7 (CoCreateGuid), 8 (CLSIDFromString) = 6 distinct
    //    impl_statuses: 1 (real_apartment_table) ×3, 3 (stub_malloc) ×1,
    //                   4 (uuid_real) ×2 = 3 distinct
    //    hresult: S_OK (0) ×5, S_FALSE (1) ×1 → success_hresult_count=5, total_hresult=1

    // call 1: CoInitialize → real_apartment_table → S_OK (0)
    record_call(811001, 1, 1, 0)
    r0_emit("win32_ole32_tier1_real_record",
        "\"call_id\":811001,\"func_kind\":1,\"impl_status\":1,\"hresult\":0,\"target\":\"CoInitialize\",\"native\":\"apartment_slot_inc\"")

    // call 2: CoInitializeEx → real_apartment_table → S_OK (0)
    record_call(811002, 2, 1, 0)
    r0_emit("win32_ole32_tier1_real_record",
        "\"call_id\":811002,\"func_kind\":2,\"impl_status\":1,\"hresult\":0,\"target\":\"CoInitializeEx\",\"native\":\"apartment_slot_inc\"")

    // call 3: CoUninitialize → real_apartment_table → S_OK (0)
    record_call(811003, 3, 1, 0)
    r0_emit("win32_ole32_tier1_real_record",
        "\"call_id\":811003,\"func_kind\":3,\"impl_status\":1,\"hresult\":0,\"target\":\"CoUninitialize\",\"native\":\"apartment_slot_dec\"")

    // call 4: CoTaskMemAlloc → stub_malloc → S_OK (0)
    record_call(811004, 5, 3, 0)
    r0_emit("win32_ole32_tier1_real_record",
        "\"call_id\":811004,\"func_kind\":5,\"impl_status\":3,\"hresult\":0,\"target\":\"CoTaskMemAlloc\",\"native\":\"malloc\"")

    // call 5: CoCreateGuid → uuid_real → S_OK (0)
    record_call(811005, 7, 4, 0)
    r0_emit("win32_ole32_tier1_real_record",
        "\"call_id\":811005,\"func_kind\":7,\"impl_status\":4,\"hresult\":0,\"target\":\"CoCreateGuid\",\"native\":\"uuid_generate\"")

    // call 6: CLSIDFromString → uuid_real → S_FALSE (1) (non-success synthetic)
    record_call(811006, 8, 4, 1)
    r0_emit("win32_ole32_tier1_real_record",
        "\"call_id\":811006,\"func_kind\":8,\"impl_status\":4,\"hresult\":1,\"target\":\"CLSIDFromString\",\"native\":\"uuid_parse\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("win32_ole32_tier1_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (6 distinct)
    let fk1 = count_by_func_kind(1)
    if fk1 != 1 {
        panic("win32_ole32_tier1_real FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(fk1))
    }
    let fk2 = count_by_func_kind(2)
    if fk2 != 1 {
        panic("win32_ole32_tier1_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(fk2))
    }
    let fk3 = count_by_func_kind(3)
    if fk3 != 1 {
        panic("win32_ole32_tier1_real FAIL [count_by_func_kind(3)] expected=1 got=" + to_string(fk3))
    }
    let fk5 = count_by_func_kind(5)
    if fk5 != 1 {
        panic("win32_ole32_tier1_real FAIL [count_by_func_kind(5)] expected=1 got=" + to_string(fk5))
    }
    let fk7 = count_by_func_kind(7)
    if fk7 != 1 {
        panic("win32_ole32_tier1_real FAIL [count_by_func_kind(7)] expected=1 got=" + to_string(fk7))
    }
    let fk8 = count_by_func_kind(8)
    if fk8 != 1 {
        panic("win32_ole32_tier1_real FAIL [count_by_func_kind(8)] expected=1 got=" + to_string(fk8))
    }
    let fk4 = count_by_func_kind(4)
    if fk4 != 0 {
        panic("win32_ole32_tier1_real FAIL [count_by_func_kind(4)] expected=0 got=" + to_string(fk4))
    }

    // 5. count_by_impl_status — 3 distinct (1 ×3, 3 ×1, 4 ×2)
    let is1 = count_by_impl_status(1)
    if is1 != 3 {
        panic("win32_ole32_tier1_real FAIL [count_by_impl_status(1)] expected=3 got=" + to_string(is1))
    }
    let is2 = count_by_impl_status(2)
    if is2 != 0 {
        panic("win32_ole32_tier1_real FAIL [count_by_impl_status(2)] expected=0 got=" + to_string(is2))
    }
    let is3 = count_by_impl_status(3)
    if is3 != 1 {
        panic("win32_ole32_tier1_real FAIL [count_by_impl_status(3)] expected=1 got=" + to_string(is3))
    }
    let is4 = count_by_impl_status(4)
    if is4 != 2 {
        panic("win32_ole32_tier1_real FAIL [count_by_impl_status(4)] expected=2 got=" + to_string(is4))
    }

    // 6. success_hresult_count = 5 (5 rows with hresult=0)
    let shc = success_hresult_count()
    if shc != 5 {
        panic("win32_ole32_tier1_real FAIL [success_hresult_count] expected=5 got=" + to_string(shc))
    }

    // 7. total_hresult = 0+0+0+0+0+1 = 1
    let th = total_hresult()
    if th != 1 {
        panic("win32_ole32_tier1_real FAIL [total_hresult] expected=1 got=" + to_string(th))
    }

    // 8. call_hresult sanity
    let hr1 = call_hresult(811001)
    if hr1 != 0 {
        panic("win32_ole32_tier1_real FAIL [call_hresult(811001)] expected=0 got=" + to_string(hr1))
    }
    let hr6 = call_hresult(811006)
    if hr6 != 1 {
        panic("win32_ole32_tier1_real FAIL [call_hresult(811006)] expected=1 got=" + to_string(hr6))
    }
    let hr_miss = call_hresult(9999)
    if hr_miss != 0 {
        panic("win32_ole32_tier1_real FAIL [call_hresult(9999)] expected=0 got=" + to_string(hr_miss))
    }

    // 9. wot1_stats() = [6, 5, 1, 2]
    let s = wot1_stats()
    if len(s) != 4 {
        panic("win32_ole32_tier1_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("win32_ole32_tier1_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 5 {
        panic("win32_ole32_tier1_real FAIL [stats success_hresult_count] expected=5 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("win32_ole32_tier1_real FAIL [stats total_hresult] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("win32_ole32_tier1_real FAIL [stats uuid_real_count] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("win32_ole32_tier1_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"success_hresult_count\":" + to_string(s[1])
        + ",\"total_hresult\":" + to_string(s[2])
        + ",\"uuid_real_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("win32_ole32_tier1_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_wot1()
    let s2 = wot1_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("win32_ole32_tier1_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_ole32_tier1_real self_test PASS (calls=" + to_string(s[0])
        + ", success=" + to_string(s[1]) + ", total_hr=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wot1_stats()
            println("call_count\t" + to_string(s[0]))
            println("success_hresult_count\t" + to_string(s[1]))
            println("total_hresult\t" + to_string(s[2]))
            println("uuid_real_count\t" + to_string(s[3]))
            return
        }
        if sub == "hresult" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_hresult\t" + to_string(call_hresult(cid)))
                return
            }
            println("usage: hexa run win32_ole32_tier1_real.hexa hresult <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let mode = a[3]
                let val = to_int(a[4])
                if mode == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if mode == "impl" {
                    println("count_by_impl_status\t" + to_string(count_by_impl_status(val)))
                    return
                }
                println("usage: hexa run win32_ole32_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
                return
            }
            println("usage: hexa run win32_ole32_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_wot1()
            println("cleaned: " + wot1_dir())
            return
        }
        if sub == "dir" {
            println(wot1_dir())
            return
        }
    }
    println("usage: hexa run win32_ole32_tier1_real.hexa { self-test | stats | hresult <call_id> | count func <func_kind> | count impl <impl_status> | cleanup | dir }")
}
