// lib/loader/dx_d3d12_stage2.hexa — Phase 5b stage2 — D3D12 DXR commands (D4 필수)
//
// own 1 enforcement: Wine / CrossOver / dxvk / vkd3d / community 코드 0 줄.
//   참조 only — Microsoft 공식 D3D12 / DXR API spec:
//     - BuildRaytracingAccelerationStructure:
//         https://learn.microsoft.com/en-us/windows/win32/api/d3d12/nf-d3d12-id3d12graphicscommandlist4-buildraytracingaccelerationstructure
//     - DispatchRays:
//         https://learn.microsoft.com/en-us/windows/win32/api/d3d12/nf-d3d12-id3d12graphicscommandlist4-dispatchrays
//     - ExecuteIndirect (DispatchRays variant):
//         https://learn.microsoft.com/en-us/windows/win32/api/d3d12/nf-d3d12-id3d12graphicscommandlist-executeindirect
//     - Shader Binding Table (D3D12_DISPATCH_RAYS_DESC):
//         https://learn.microsoft.com/en-us/windows/win32/api/d3d12/ns-d3d12-d3d12_dispatch_rays_desc
//     - PIX_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PERFORM_UPDATE (refit):
//         https://microsoft.github.io/DirectX-Specs/d3d/Raytracing.html
//   참조 only — Apple Metal Raytracing (macOS 14+) developer.apple.com.
//   Wine / DXVK / VKD3D source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 5
//     (실제: d3d12s2_blas_build + d3d12s2_tlas_build + d3d12s2_refit
//          + d3d12s2_dispatch_rays × 2 + d3d12s2_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("dx_d3d12_stage2 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 5b stage2 — DXR command recording):
//   stage1 = handle table (synthetic ID 부여 + state machine).
//   stage2 = 실제 DXR commands 단계 — synthetic execution recording.
//   stage1 의 accel_struct_table.tsv 위에 build_history / dispatch_history
//   / shader_table 의 추가 table 을 build.
//
// handle table 구조 (stage1 의 d3d12_handles/ 디렉토리에 추가):
//   build_history.tsv        — "build_id\tas_id\tgeom_count\tinstance_count\tts"
//   ray_dispatch_history.tsv — "dispatch_id\tpso_id\twidth\theight\tdepth\tts"
//   shader_table_table.tsv   — "shader_table_id\tmiss_shaders\thit_shaders\tcallable_shaders"
//   shader_table_slots.tsv   — "shader_table_id\tslot\tshader_id"
//
// handle id 범위 (stage1 의 1xxx-7xxx 와 충돌 회피):
//   build_history    = 8xxx   (8000+)
//   ray_dispatch     = 9xxx   (9000+)
//   shader_table     = 10xxx  (10000+)
//
// AS build vs refit:
//   build (BLAS/TLAS) = full rebuild — geom_count / instance_count 새로 기록.
//   refit             = D3D12_RAYTRACING_AS_BUILD_FLAG_PERFORM_UPDATE — cheaper,
//                       기존 as_id 유지하되 build_history 에 geom=-1 / instance=-1 행 추가.
//
// dispatch:
//   dispatch_rays_with_table   = inline width/height/depth (synchronous record).
//   dispatch_rays_indirect     = args buffer 참조 — width/height/depth 는 GPU 가 결정.
//                                indirect 는 width=-1, height=-1, depth=-1 로 기록.

use "../perf/r0_common"

// ─── handle table 디렉토리 (stage1 와 동일) ───
fn handle_dir() -> str {
    return GAMEBOX_HOME + "/persist/d3d12_handles"
}

fn build_history_path() -> str {
    return handle_dir() + "/build_history.tsv"
}

fn ray_dispatch_history_path() -> str {
    return handle_dir() + "/ray_dispatch_history.tsv"
}

fn shader_table_table_path() -> str {
    return handle_dir() + "/shader_table_table.tsv"
}

fn shader_table_slots_path() -> str {
    return handle_dir() + "/shader_table_slots.tsv"
}

fn accel_struct_table_path() -> str {
    return handle_dir() + "/accel_struct_table.tsv"
}

fn ensure_handle_dir() -> void {
    let _ = exec("mkdir -p '" + handle_dir() + "'")
}

fn cleanup() -> void {
    ensure_handle_dir()
    let _ = exec("rm -f '" + build_history_path()
        + "' '" + ray_dispatch_history_path()
        + "' '" + shader_table_table_path()
        + "' '" + shader_table_slots_path()
        + "' '" + accel_struct_table_path() + "'")
}

// ─── 공통 file IO ───
fn read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn append_row(path: str, row: str) -> void {
    ensure_handle_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── next handle id (table 의 max + 1; empty → base) ───
fn next_id_for(path: str, base: int) -> int {
    let t = read_table(path)
    if t == "" {
        return base
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut max_h = base - 1
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 1 {
                let h = to_int(parts[0])
                if h > max_h {
                    max_h = h
                }
            }
        }
        i = i + 1
    }
    return max_h + 1
}

fn count_rows(path: str) -> int {
    let t = read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        if lines[i] != "" {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ─── lookup: row id 가 table 에 존재하는지 ───
fn id_exists(path: str, hnd: int) -> bool {
    let t = read_table(path)
    if t == "" {
        return false
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let key = to_string(hnd)
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 1 {
                if parts[0] == key {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

// ─── timestamp (synthetic — POSIX seconds) ───
fn now_ts() -> int {
    return to_int(exec("date +%s").trim())
}

// ─── stage1 의 accel_struct_table 을 직접 append (BLAS/TLAS 구분) ───
//   row format: "as_id\tgeom_count\tinstance_count\ttype"   (type = 0 BLAS, 1 TLAS)
fn append_as_row(as_id: int, geom_count: int, instance_count: int, as_type: int) -> void {
    let row = to_string(as_id) + "\t" + to_string(geom_count)
        + "\t" + to_string(instance_count) + "\t" + to_string(as_type) + "\n"
    append_row(accel_struct_table_path(), row)
}

// ─── ID3D12GraphicsCommandList4::BuildRaytracingAccelerationStructure (BLAS) ───
//   D3D12_RAYTRACING_AS_TYPE_BOTTOM_LEVEL.
//   geom_count > 0, vertex_count > 0 필수.
//   as_id (7xxx) 은 stage1 의 accel_struct_table id 공간에 새로 할당.
//   build_id (8xxx) 는 build_history 에 기록.
//   handle (반환값) = build_id.
fn build_blas(geom_count: int, vertex_count: int) -> int {
    if geom_count <= 0 {
        return -1
    }
    if vertex_count <= 0 {
        return -1
    }
    // 새 as_id 할당 (accel_struct_table 의 max + 1, base 7000)
    let as_id = next_id_for(accel_struct_table_path(), 7000)
    // accel_struct_table 에 BLAS row append (type=0 BLAS, instance_count=0)
    append_as_row(as_id, geom_count, 0, 0)
    // build_history 에 기록 (instance_count = 0 = BLAS 식별)
    let build_id = next_id_for(build_history_path(), 8000)
    let row = to_string(build_id) + "\t" + to_string(as_id)
        + "\t" + to_string(geom_count) + "\t0\t" + to_string(now_ts()) + "\n"
    append_row(build_history_path(), row)
    return build_id
}

// ─── ID3D12GraphicsCommandList4::BuildRaytracingAccelerationStructure (TLAS) ───
//   D3D12_RAYTRACING_AS_TYPE_TOP_LEVEL.
//   instance_count > 0, blas_refs 의 모든 id 가 accel_struct_table 에 존재해야 함.
//   handle = build_id (8xxx).
fn build_tlas(instance_count: int, blas_refs: array) -> int {
    if instance_count <= 0 {
        return -1
    }
    if len(blas_refs) <= 0 {
        return -1
    }
    // 모든 BLAS reference 가 accel_struct_table 에 존재
    let i = 0
    while i < len(blas_refs) {
        if !id_exists(accel_struct_table_path(), blas_refs[i]) {
            return -1
        }
        i = i + 1
    }
    // 새 as_id 할당 (TLAS — type=1)
    let as_id = next_id_for(accel_struct_table_path(), 7000)
    append_as_row(as_id, 0, instance_count, 1)
    // build_history 에 기록 (geom_count=0, instance_count=N = TLAS 식별)
    let build_id = next_id_for(build_history_path(), 8000)
    let row = to_string(build_id) + "\t" + to_string(as_id)
        + "\t0\t" + to_string(instance_count) + "\t" + to_string(now_ts()) + "\n"
    append_row(build_history_path(), row)
    return build_id
}

// ─── refit AS — D3D12_RAYTRACING_AS_BUILD_FLAG_PERFORM_UPDATE ───
//   기존 as_id 가 accel_struct_table 에 존재해야 함.
//   refit 은 build_history 에 geom_count=-1, instance_count=-1 의 sentinel row 로 기록.
fn refit_acceleration_structure(as_id: int) -> bool {
    if !id_exists(accel_struct_table_path(), as_id) {
        return false
    }
    let build_id = next_id_for(build_history_path(), 8000)
    // sentinel: geom=-1, instance=-1 → refit 식별자
    let row = to_string(build_id) + "\t" + to_string(as_id)
        + "\t-1\t-1\t" + to_string(now_ts()) + "\n"
    append_row(build_history_path(), row)
    return true
}

// ─── Shader Binding Table 생성 (D3D12_DISPATCH_RAYS_DESC 의 SBT region) ───
//   miss/hit/callable shader count >= 0 (raygen 은 항상 1, 별도 slot).
//   handle = shader_table_id (10xxx).
fn create_shader_table(miss_shaders: int, hit_shaders: int, callable_shaders: int) -> int {
    if miss_shaders < 0 {
        return -1
    }
    if hit_shaders < 0 {
        return -1
    }
    if callable_shaders < 0 {
        return -1
    }
    let h = next_id_for(shader_table_table_path(), 10000)
    let row = to_string(h) + "\t" + to_string(miss_shaders)
        + "\t" + to_string(hit_shaders) + "\t" + to_string(callable_shaders) + "\n"
    append_row(shader_table_table_path(), row)
    return h
}

// ─── shader_table 의 slot 에 shader id (예: 0xRAYGEN) 기록 ───
//   table_id 가 shader_table_table 에 존재해야 함.
//   slot >= 0.
fn update_shader_table(table_id: int, slot: int, shader_id: int) -> bool {
    if !id_exists(shader_table_table_path(), table_id) {
        return false
    }
    if slot < 0 {
        return false
    }
    let row = to_string(table_id) + "\t" + to_string(slot)
        + "\t" + to_string(shader_id) + "\n"
    append_row(shader_table_slots_path(), row)
    return true
}

// ─── ID3D12GraphicsCommandList4::DispatchRays (with shader table) ───
//   table_id 가 존재해야 함. width/height/depth 모두 > 0.
//   handle = dispatch_id (9xxx).
//   pso_id = table_id 의 owning PSO (synthetic — table_id 사용).
fn dispatch_rays_with_table(table_id: int, width: int, height: int, depth: int) -> int {
    if !id_exists(shader_table_table_path(), table_id) {
        return -1
    }
    if width <= 0 {
        return -1
    }
    if height <= 0 {
        return -1
    }
    if depth <= 0 {
        return -1
    }
    let dispatch_id = next_id_for(ray_dispatch_history_path(), 9000)
    let row = to_string(dispatch_id) + "\t" + to_string(table_id)
        + "\t" + to_string(width) + "\t" + to_string(height)
        + "\t" + to_string(depth) + "\t" + to_string(now_ts()) + "\n"
    append_row(ray_dispatch_history_path(), row)
    return dispatch_id
}

// ─── ID3D12GraphicsCommandList4::ExecuteIndirect (DispatchRays variant) ───
//   args_buffer 는 GPU buffer handle (5xxx) — width/height/depth 는 GPU 가 read.
//   여기서는 args_buffer >= 0 의 sanity check 만.
//   width/height/depth = -1 sentinel 로 indirect 식별.
//   handle = dispatch_id (9xxx).
fn dispatch_rays_indirect(args_buffer: int) -> int {
    if args_buffer < 0 {
        return -1
    }
    let dispatch_id = next_id_for(ray_dispatch_history_path(), 9000)
    // pso_id 는 args_buffer 로 기록 (indirect — 실제 PSO 는 GPU 가 결정)
    let row = to_string(dispatch_id) + "\t" + to_string(args_buffer)
        + "\t-1\t-1\t-1\t" + to_string(now_ts()) + "\n"
    append_row(ray_dispatch_history_path(), row)
    return dispatch_id
}

// ─── stats: [total_blas, total_tlas, total_refits, total_dispatches] ───
//   build_history 의 행 분류:
//     geom > 0, instance == 0  → BLAS
//     geom == 0, instance > 0  → TLAS
//     geom == -1, instance == -1 → refit
fn build_stats() -> array {
    let mut out = []
    let mut blas_n = 0
    let mut tlas_n = 0
    let mut refit_n = 0
    let t = read_table(build_history_path())
    if t != "" {
        let lines = t.split("\n")
        let n = len(lines)
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    let g = to_int(parts[2])
                    let inst = to_int(parts[3])
                    if g == -1 {
                        if inst == -1 {
                            refit_n = refit_n + 1
                        }
                    } else {
                        if g > 0 {
                            if inst == 0 {
                                blas_n = blas_n + 1
                            }
                        } else {
                            if inst > 0 {
                                tlas_n = tlas_n + 1
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    let dispatch_n = count_rows(ray_dispatch_history_path())
    out.push(blas_n)
    out.push(tlas_n)
    out.push(refit_n)
    out.push(dispatch_n)
    return out
}

// ─── ray_throughput: width*height*depth 합 (indirect 의 -1 행은 제외) ───
fn ray_throughput() -> int {
    let t = read_table(ray_dispatch_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 5 {
                let w = to_int(parts[2])
                let hh = to_int(parts[3])
                let d = to_int(parts[4])
                if w > 0 {
                    if hh > 0 {
                        if d > 0 {
                            sum = sum + (w * hh * d)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return sum
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "d3d12s2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup()

    // 2. blas1 = build_blas(geom=100, vertex=10000) > 0
    let blas1 = build_blas(100, 10000)
    if blas1 <= 0 {
        panic("dx_d3d12_stage2 FAIL [build_blas blas1] expected=>0 got=" + to_string(blas1))
    }
    if blas1 < 8000 {
        panic("dx_d3d12_stage2 FAIL [blas1 id range] expected=>=8000 got=" + to_string(blas1))
    }

    // 2b. invalid: geom=0
    let bad_blas = build_blas(0, 100)
    if bad_blas != -1 {
        panic("dx_d3d12_stage2 FAIL [build_blas bad geom] expected=-1 got=" + to_string(bad_blas))
    }
    // 2c. invalid: vertex=0
    let bad_blas2 = build_blas(10, 0)
    if bad_blas2 != -1 {
        panic("dx_d3d12_stage2 FAIL [build_blas bad vertex] expected=-1 got=" + to_string(bad_blas2))
    }

    // emit 1: d3d12s2_blas_build (blas1 의 as_id 는 stage1 accel_struct_table 의 7xxx)
    r0_emit("d3d12s2_blas_build",
        "\"build_id\":" + to_string(blas1)
        + ",\"geom_count\":100,\"vertex_count\":10000,\"as_type\":\"BLAS\"")

    // 3. blas2 = build_blas(geom=50, vertex=5000) > 0
    let blas2 = build_blas(50, 5000)
    if blas2 <= 0 {
        panic("dx_d3d12_stage2 FAIL [build_blas blas2] expected=>0 got=" + to_string(blas2))
    }
    if blas2 <= blas1 {
        panic("dx_d3d12_stage2 FAIL [blas2 id ordering] expected=>"
            + to_string(blas1) + " got=" + to_string(blas2))
    }

    // emit 2: d3d12s2_blas_build (blas2)
    r0_emit("d3d12s2_blas_build",
        "\"build_id\":" + to_string(blas2)
        + ",\"geom_count\":50,\"vertex_count\":5000,\"as_type\":\"BLAS\"")

    // 4. tlas1 = build_tlas(instance=2, [blas1's as_id, blas2's as_id])
    //    blas1/blas2 는 build_id; AS id 는 7000, 7001 (cleanup 후 새로 시작).
    //    accel_struct_table 의 row 0 = 7000 (blas1 의 as), row 1 = 7001 (blas2 의 as).
    let tlas1 = build_tlas(2, [7000, 7001])
    if tlas1 <= 0 {
        panic("dx_d3d12_stage2 FAIL [build_tlas tlas1] expected=>0 got=" + to_string(tlas1))
    }
    if tlas1 <= blas2 {
        panic("dx_d3d12_stage2 FAIL [tlas1 id ordering] expected=>"
            + to_string(blas2) + " got=" + to_string(tlas1))
    }

    // 4b. invalid: instance=0
    let bad_tlas = build_tlas(0, [7000])
    if bad_tlas != -1 {
        panic("dx_d3d12_stage2 FAIL [build_tlas bad instance] expected=-1 got=" + to_string(bad_tlas))
    }
    // 4c. invalid: empty refs
    let bad_tlas2 = build_tlas(1, [])
    if bad_tlas2 != -1 {
        panic("dx_d3d12_stage2 FAIL [build_tlas empty refs] expected=-1 got=" + to_string(bad_tlas2))
    }
    // 4d. invalid: bad blas ref (id 99999 doesn't exist)
    let bad_tlas3 = build_tlas(1, [99999])
    if bad_tlas3 != -1 {
        panic("dx_d3d12_stage2 FAIL [build_tlas bad ref] expected=-1 got=" + to_string(bad_tlas3))
    }

    // emit 3: d3d12s2_tlas_build
    r0_emit("d3d12s2_tlas_build",
        "\"build_id\":" + to_string(tlas1)
        + ",\"instance_count\":2,\"blas_refs\":[7000,7001],\"as_type\":\"TLAS\"")

    // 5. refit_acceleration_structure(7000)  (blas1's as_id) → true
    let refit_ok = refit_acceleration_structure(7000)
    if !refit_ok {
        panic("dx_d3d12_stage2 FAIL [refit] expected=true got=false")
    }

    // 5b. refit invalid id → false
    let refit_bad = refit_acceleration_structure(99999)
    if refit_bad {
        panic("dx_d3d12_stage2 FAIL [refit bad id] expected=false got=true")
    }

    // emit 4: d3d12s2_refit
    r0_emit("d3d12s2_refit",
        "\"as_id\":7000,\"flag\":\"PERFORM_UPDATE\",\"result\":\"S_OK\"")

    // 6. table = create_shader_table(miss=2, hit=4, callable=1) > 0
    let table = create_shader_table(2, 4, 1)
    if table <= 0 {
        panic("dx_d3d12_stage2 FAIL [create_shader_table] expected=>0 got=" + to_string(table))
    }
    if table < 10000 {
        panic("dx_d3d12_stage2 FAIL [shader_table id range] expected=>=10000 got=" + to_string(table))
    }

    // 6b. invalid: negative miss
    let bad_st = create_shader_table(-1, 0, 0)
    if bad_st != -1 {
        panic("dx_d3d12_stage2 FAIL [shader_table bad miss] expected=-1 got=" + to_string(bad_st))
    }

    // 7. update_shader_table(table, 0, 0xDEADBEEF)  (RAYGEN slot)
    let upd_ok = update_shader_table(table, 0, 0xDEADBEEF)
    if !upd_ok {
        panic("dx_d3d12_stage2 FAIL [update_shader_table] expected=true got=false")
    }

    // 7b. update invalid table → false
    let upd_bad = update_shader_table(99999, 0, 0)
    if upd_bad {
        panic("dx_d3d12_stage2 FAIL [update_shader_table bad id] expected=false got=true")
    }
    // 7c. update invalid slot → false
    let upd_bad2 = update_shader_table(table, -1, 0)
    if upd_bad2 {
        panic("dx_d3d12_stage2 FAIL [update_shader_table bad slot] expected=false got=true")
    }

    // 8. dispatch1 = dispatch_rays_with_table(table, 1920, 1080, 1) > 0
    let dispatch1 = dispatch_rays_with_table(table, 1920, 1080, 1)
    if dispatch1 <= 0 {
        panic("dx_d3d12_stage2 FAIL [dispatch1] expected=>0 got=" + to_string(dispatch1))
    }
    if dispatch1 < 9000 {
        panic("dx_d3d12_stage2 FAIL [dispatch id range] expected=>=9000 got=" + to_string(dispatch1))
    }

    // 8b. invalid: bad table id
    let bad_d = dispatch_rays_with_table(99999, 1920, 1080, 1)
    if bad_d != -1 {
        panic("dx_d3d12_stage2 FAIL [dispatch bad table] expected=-1 got=" + to_string(bad_d))
    }
    // 8c. invalid: width=0
    let bad_d2 = dispatch_rays_with_table(table, 0, 1080, 1)
    if bad_d2 != -1 {
        panic("dx_d3d12_stage2 FAIL [dispatch bad width] expected=-1 got=" + to_string(bad_d2))
    }
    // 8d. invalid: height=0
    let bad_d3 = dispatch_rays_with_table(table, 1920, 0, 1)
    if bad_d3 != -1 {
        panic("dx_d3d12_stage2 FAIL [dispatch bad height] expected=-1 got=" + to_string(bad_d3))
    }
    // 8e. invalid: depth=0
    let bad_d4 = dispatch_rays_with_table(table, 1920, 1080, 0)
    if bad_d4 != -1 {
        panic("dx_d3d12_stage2 FAIL [dispatch bad depth] expected=-1 got=" + to_string(bad_d4))
    }

    // emit 5: d3d12s2_dispatch_rays
    r0_emit("d3d12s2_dispatch_rays",
        "\"dispatch_id\":" + to_string(dispatch1)
        + ",\"table\":" + to_string(table)
        + ",\"width\":1920,\"height\":1080,\"depth\":1,\"result\":\"S_OK\"")

    // 9. dispatch2 = dispatch_rays_with_table(table, 800, 600, 1) > 0
    let dispatch2 = dispatch_rays_with_table(table, 800, 600, 1)
    if dispatch2 <= 0 {
        panic("dx_d3d12_stage2 FAIL [dispatch2] expected=>0 got=" + to_string(dispatch2))
    }
    if dispatch2 <= dispatch1 {
        panic("dx_d3d12_stage2 FAIL [dispatch2 id ordering] expected=>"
            + to_string(dispatch1) + " got=" + to_string(dispatch2))
    }

    // emit 6: d3d12s2_dispatch_rays
    r0_emit("d3d12s2_dispatch_rays",
        "\"dispatch_id\":" + to_string(dispatch2)
        + ",\"table\":" + to_string(table)
        + ",\"width\":800,\"height\":600,\"depth\":1,\"result\":\"S_OK\"")

    // 9b. dispatch_rays_indirect (sanity — args_buffer = synthetic 5000)
    let dispatch_i = dispatch_rays_indirect(5000)
    if dispatch_i <= 0 {
        panic("dx_d3d12_stage2 FAIL [dispatch_indirect] expected=>0 got=" + to_string(dispatch_i))
    }
    // 9c. indirect invalid → -1
    let bad_di = dispatch_rays_indirect(-1)
    if bad_di != -1 {
        panic("dx_d3d12_stage2 FAIL [dispatch_indirect bad args] expected=-1 got=" + to_string(bad_di))
    }

    // 10. stats = build_stats() → [2, 1, 1, 3]   (indirect 도 dispatch 에 포함됨)
    let stats = build_stats()
    if len(stats) != 4 {
        panic("dx_d3d12_stage2 FAIL [stats len] expected=4 got=" + to_string(len(stats)))
    }
    if stats[0] != 2 {
        panic("dx_d3d12_stage2 FAIL [stats blas] expected=2 got=" + to_string(stats[0]))
    }
    if stats[1] != 1 {
        panic("dx_d3d12_stage2 FAIL [stats tlas] expected=1 got=" + to_string(stats[1]))
    }
    if stats[2] != 1 {
        panic("dx_d3d12_stage2 FAIL [stats refits] expected=1 got=" + to_string(stats[2]))
    }
    if stats[3] != 3 {
        panic("dx_d3d12_stage2 FAIL [stats dispatches] expected=3 got=" + to_string(stats[3]))
    }

    // 11. ray_throughput → 1920*1080 + 800*600 = 2073600 + 480000 = 2553600
    //     (indirect 의 -1 행은 제외)
    let throughput = ray_throughput()
    let expected_tp = (1920 * 1080) + (800 * 600)
    if throughput != expected_tp {
        panic("dx_d3d12_stage2 FAIL [ray_throughput] expected="
            + to_string(expected_tp) + " got=" + to_string(throughput))
    }

    // emit 7: d3d12s2_stats
    r0_emit("d3d12s2_stats",
        "\"blas\":2,\"tlas\":1,\"refits\":1,\"dispatches\":3,\"throughput\":"
        + to_string(throughput))

    // 12. r0_emit count 검증 (≥ 5; 실제 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("dx_d3d12_stage2 FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 13. cleanup
    cleanup()

    // 13b. cleanup 후 stats 모두 0
    let stats_after = build_stats()
    let i = 0
    while i < len(stats_after) {
        if stats_after[i] != 0 {
            panic("dx_d3d12_stage2 FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(stats_after[i]))
        }
        i = i + 1
    }
    if ray_throughput() != 0 {
        panic("dx_d3d12_stage2 FAIL [cleanup throughput] expected=0 got="
            + to_string(ray_throughput()))
    }

    // 14. PASS
    println("  ✅ dx_d3d12_stage2 self_test PASS (2 BLAS + 1 TLAS + 1 refit + "
        + to_string(stats[3]) + " dispatches, throughput=" + to_string(throughput)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = build_stats()
            println("blas\t" + to_string(s[0]))
            println("tlas\t" + to_string(s[1]))
            println("refits\t" + to_string(s[2]))
            println("dispatches\t" + to_string(s[3]))
            println("throughput\t" + to_string(ray_throughput()))
            return
        }
        if sub == "cleanup" {
            cleanup()
            println("cleaned: " + handle_dir())
            return
        }
        if sub == "dir" {
            println(handle_dir())
            return
        }
    }
    println("usage: hexa run dx_d3d12_stage2.hexa { self-test | stats | cleanup | dir }")
}
