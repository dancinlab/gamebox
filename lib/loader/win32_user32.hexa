// lib/loader/win32_user32.hexa — Phase 4a — user32 mapping skeleton
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 user32 API spec:
//     - Window:   https://learn.microsoft.com/en-us/windows/win32/api/winuser/
//     - Message:  https://learn.microsoft.com/en-us/windows/win32/api/winuser/
//     - Input:    https://learn.microsoft.com/en-us/windows/win32/api/winuser/
//     - Dialog:   https://learn.microsoft.com/en-us/windows/win32/api/winuser/
//     - Class:    https://learn.microsoft.com/en-us/windows/win32/api/winuser/
//     - DC:       https://learn.microsoft.com/en-us/windows/win32/api/winuser/
//   Cocoa / AppKit equivalent 은 developer.apple.com 만 참조.
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 2: user32_lookup + user32_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만 — MessageBoxW = stdout fallback)
//   - panic("win32_user32 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 4a — skeleton):
//   30 핵심 user32 함수의 *mapping table* + headless MessageBox fallback.
//   각 entry = (Win32 함수명, 대응되는 Cocoa/AppKit 호출, 카테고리, status).
//   실제 NSWindow alloc / NSEvent loop / NSAlert binding 은 Phase 4a 후속.
//
// status 값:
//   "skeleton" — mapping 만 (Phase 4a 현재 모든 entry)
//   "stub"     — default value 만 반환 (호출 시 NULL 또는 0)
//   "impl"     — 실제 Cocoa/AppKit 호출 수행
//
// 30 함수 카테고리 (실제 분포):
//   Window   8  (CreateWindowExW, DestroyWindow, ShowWindow, UpdateWindow,
//                MoveWindow, SetWindowTextW, GetWindowTextW, SetWindowPos)
//   Message  6  (GetMessage, PeekMessage, TranslateMessage, DispatchMessage,
//                DefWindowProc, PostMessage)
//   Input    5  (GetCursorPos, SetCursorPos, GetKeyState, GetAsyncKeyState,
//                GetMouseMovePointsEx)
//   Dialog   4  (MessageBoxW, DialogBoxParamW, EndDialog, CreateDialogParamW)
//   Class    4  (RegisterClassW, UnregisterClassW, GetClassInfoW, GetClassNameW)
//   DC       3  (GetDC, ReleaseDC, GetWindowDC)
//   ──────────
//   total   30  / 6 categories

use "../perf/r0_common"

// ─── 30 함수 mapping table (TSV — name\tcocoa_equiv\tcategory\tstatus) ───
//
// 한 줄 = "<Win32 name>\t<Cocoa/AppKit equivalent>\t<category>\t<status>"
// 줄 구분자 = "\n". 첫 줄도 의미 entry (header 없음 — 데이터 30 줄).
fn user32_table() -> str {
    let t = ""
    // Window (8)
    t = t + "CreateWindowExW\tNSWindow\tWindow\tskeleton\n"
    t = t + "DestroyWindow\tNSWindow_close\tWindow\tskeleton\n"
    t = t + "ShowWindow\torderFront\tWindow\tskeleton\n"
    t = t + "UpdateWindow\tdisplayIfNeeded\tWindow\tskeleton\n"
    t = t + "MoveWindow\tsetFrame\tWindow\tskeleton\n"
    t = t + "SetWindowTextW\tsetTitle\tWindow\tskeleton\n"
    t = t + "GetWindowTextW\ttitle\tWindow\tskeleton\n"
    t = t + "SetWindowPos\tsetFrameOrigin\tWindow\tskeleton\n"
    // Message (6)
    t = t + "GetMessage\tNSEvent_loop\tMessage\tskeleton\n"
    t = t + "PeekMessage\tnextEventMatchingMask\tMessage\tskeleton\n"
    t = t + "TranslateMessage\tNSEvent_charactersIgnoringModifiers\tMessage\tskeleton\n"
    t = t + "DispatchMessage\tNSApp_sendEvent\tMessage\tskeleton\n"
    t = t + "DefWindowProc\tNSResponder_default\tMessage\tskeleton\n"
    t = t + "PostMessage\tNSApp_postEvent\tMessage\tskeleton\n"
    // Input (5)
    t = t + "GetCursorPos\tNSEvent_mouseLocation\tInput\tskeleton\n"
    t = t + "SetCursorPos\tCGWarpMouseCursorPosition\tInput\tskeleton\n"
    t = t + "GetKeyState\tNSEvent_modifierFlags\tInput\tskeleton\n"
    t = t + "GetAsyncKeyState\tCGEventSourceKeyState\tInput\tskeleton\n"
    t = t + "GetMouseMovePointsEx\tNSEvent_mouseLocation_history\tInput\tskeleton\n"
    // Dialog (4)
    t = t + "MessageBoxW\tNSAlert\tDialog\tskeleton\n"
    t = t + "DialogBoxParamW\tNSPanel_runModal\tDialog\tskeleton\n"
    t = t + "EndDialog\tstopModalWithCode\tDialog\tskeleton\n"
    t = t + "CreateDialogParamW\tNSPanel\tDialog\tskeleton\n"
    // Class (4)
    t = t + "RegisterClassW\tNSWindow_subclass_register\tClass\tskeleton\n"
    t = t + "UnregisterClassW\tNSWindow_subclass_unregister\tClass\tskeleton\n"
    t = t + "GetClassInfoW\tNSWindow_subclass_info\tClass\tskeleton\n"
    t = t + "GetClassNameW\tNSObject_className\tClass\tskeleton\n"
    // DC (3)
    t = t + "GetDC\tNSGraphicsContext\tDC\tskeleton\n"
    t = t + "ReleaseDC\tNSGraphicsContext_restore\tDC\tskeleton\n"
    t = t + "GetWindowDC\tNSWindow_graphicsContext\tDC\tskeleton\n"
    return t
}

// ─── table line count (entry 수 = 30) ───
fn user32_table_size() -> int {
    let t = user32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ─── lookup: Win32 함수명 → "<cocoa>\t<category>\t<status>" 또는 "" ───
fn lookup_mapping(name: str) -> str {
    let t = user32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── status only ───
fn function_status(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[2]
    }
    return ""
}

// ─── category only ───
fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[1]
    }
    return ""
}

// ─── Cocoa / AppKit equivalent only ───
fn function_cocoa_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[0]
    }
    return ""
}

// ─── category 통계 ───
//
//   반환: array of [category_name, total_count, impl_count]
//   (hexa stage1 dict 부재 → array of array).
//   impl_count = status == "impl" 인 entry 수 (Phase 4a 현재 모두 0).
fn user32_stats() -> array {
    let mut cats = []
    cats.push(["Window", 0, 0])
    cats.push(["Message", 0, 0])
    cats.push(["Input", 0, 0])
    cats.push(["Dialog", 0, 0])
    cats.push(["Class", 0, 0])
    cats.push(["DC", 0, 0])

    let t = user32_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cat = parts[2]
                let st = parts[3]
                let j = 0
                while j < len(cats) {
                    if cats[j][0] == cat {
                        cats[j][1] = cats[j][1] + 1
                        if st == "impl" {
                            cats[j][2] = cats[j][2] + 1
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return cats
}

// ─── 전체 impl_count 합 (스카라) ───
fn user32_impl_count() -> int {
    let stats = user32_stats()
    let n = len(stats)
    let i = 0
    let total = 0
    while i < n {
        total = total + stats[i][2]
        i = i + 1
    }
    return total
}

// ─── headless MessageBoxW fallback ───
//
// own 2 (c) headless mandate: GUI 안 띄움. stdout 으로 출력만.
// 실제 NSAlert binding 은 Phase 4a 후속 (with --gui flag).
// 반환값 1 = IDOK (winuser.h MessageBox return values).
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/winuser/nf-winuser-messageboxw
fn headless_messagebox(text: str, caption: str) -> int {
    println("[MessageBoxW headless] caption=\"" + caption + "\" text=\"" + text + "\"")
    return 1
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "u32test-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size ≥ 30 (실제 정확히 30)
    let sz = user32_table_size()
    if sz < 30 {
        panic("win32_user32 FAIL [table_size] expected=>=30 got=" + to_string(sz))
    }
    if sz != 30 {
        panic("win32_user32 FAIL [table_size_exact] expected=30 got=" + to_string(sz))
    }

    // 2. lookup_mapping("MessageBoxW") = "NSAlert\tDialog\tskeleton"
    let m_msgbox = lookup_mapping("MessageBoxW")
    let exp_msgbox = "NSAlert\tDialog\tskeleton"
    if m_msgbox != exp_msgbox {
        panic("win32_user32 FAIL [lookup MessageBoxW] expected=" + exp_msgbox + " got=" + m_msgbox)
    }

    // 3. lookup_mapping("CreateWindowExW") = "NSWindow\tWindow\tskeleton"
    let m_create = lookup_mapping("CreateWindowExW")
    let exp_create = "NSWindow\tWindow\tskeleton"
    if m_create != exp_create {
        panic("win32_user32 FAIL [lookup CreateWindowExW] expected=" + exp_create + " got=" + m_create)
    }

    // 4. lookup_mapping("GetMessage") = "NSEvent_loop\tMessage\tskeleton"
    let m_getmsg = lookup_mapping("GetMessage")
    let exp_getmsg = "NSEvent_loop\tMessage\tskeleton"
    if m_getmsg != exp_getmsg {
        panic("win32_user32 FAIL [lookup GetMessage] expected=" + exp_getmsg + " got=" + m_getmsg)
    }

    // 5. function_status("MessageBoxW") = "skeleton"
    let st = function_status("MessageBoxW")
    if st != "skeleton" {
        panic("win32_user32 FAIL [function_status MessageBoxW] expected=skeleton got=" + st)
    }

    // 5b. unknown name → empty
    let m_unknown = lookup_mapping("NoSuchFunction")
    if m_unknown != "" {
        panic("win32_user32 FAIL [lookup unknown] expected=empty got=" + m_unknown)
    }

    // 6. r0_emit "user32_lookup" {name, cocoa}
    let cocoa_msgbox = function_cocoa_equiv("MessageBoxW")
    r0_emit("user32_lookup",
        "\"name\":\"MessageBoxW\",\"cocoa\":\"" + cocoa_msgbox + "\"")

    // 7. user32_stats() ≥ 6 categories with expected counts
    let stats = user32_stats()
    let cat_n = len(stats)
    if cat_n < 6 {
        panic("win32_user32 FAIL [stats categories] expected=>=6 got=" + to_string(cat_n))
    }
    // 카테고리별 정확한 count 검증
    let i = 0
    let sum_total = 0
    let sum_impl = 0
    while i < cat_n {
        let cn = stats[i][0]
        let ct = stats[i][1]
        let ci = stats[i][2]
        sum_total = sum_total + ct
        sum_impl = sum_impl + ci
        if cn == "Window" {
            if ct != 8 {
                panic("win32_user32 FAIL [stats Window count] expected=8 got=" + to_string(ct))
            }
        }
        if cn == "Message" {
            if ct != 6 {
                panic("win32_user32 FAIL [stats Message count] expected=6 got=" + to_string(ct))
            }
        }
        if cn == "Input" {
            if ct != 5 {
                panic("win32_user32 FAIL [stats Input count] expected=5 got=" + to_string(ct))
            }
        }
        if cn == "Dialog" {
            if ct != 4 {
                panic("win32_user32 FAIL [stats Dialog count] expected=4 got=" + to_string(ct))
            }
        }
        if cn == "Class" {
            if ct != 4 {
                panic("win32_user32 FAIL [stats Class count] expected=4 got=" + to_string(ct))
            }
        }
        if cn == "DC" {
            if ct != 3 {
                panic("win32_user32 FAIL [stats DC count] expected=3 got=" + to_string(ct))
            }
        }
        i = i + 1
    }
    if sum_total != 30 {
        panic("win32_user32 FAIL [stats total sum] expected=30 got=" + to_string(sum_total))
    }
    if sum_impl != 0 {
        panic("win32_user32 FAIL [stats impl sum] expected=0 got=" + to_string(sum_impl))
    }

    // 8. headless_messagebox("test", "title") = 1 (stdout fallback, GUI 안 띄움)
    let mb = headless_messagebox("test", "title")
    if mb != 1 {
        panic("win32_user32 FAIL [headless_messagebox] expected=1 got=" + to_string(mb))
    }

    // 9. r0_emit "user32_stats" {table_size, categories}
    r0_emit("user32_stats",
        "\"table_size\":" + to_string(sz)
        + ",\"categories\":" + to_string(cat_n)
        + ",\"impl_count\":" + to_string(sum_impl))

    // R0 emit count 검증 — 정확히 2 events (user32_lookup + user32_stats)
    let emit_n = r0_session_count(sid)
    if emit_n != 2 {
        panic("win32_user32 FAIL [r0 emit count] expected=2 got=" + to_string(emit_n))
    }

    println("  ✅ win32_user32 self_test PASS (30 functions, 6 categories, headless MessageBox=stdout, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "table" {
            print(user32_table())
            return
        }
        if sub == "lookup" {
            if len(a) >= 4 {
                let name = a[3]
                let m = lookup_mapping(name)
                if m == "" {
                    println("(not found)")
                } else {
                    println(m)
                }
                return
            }
        }
        if sub == "status" {
            if len(a) >= 4 {
                let name = a[3]
                let s = function_status(name)
                if s == "" {
                    println("(not found)")
                } else {
                    println(s)
                }
                return
            }
        }
        if sub == "stats" {
            let stats = user32_stats()
            let n = len(stats)
            let i = 0
            while i < n {
                println(stats[i][0]
                    + "\t" + to_string(stats[i][1])
                    + "\t" + to_string(stats[i][2]))
                i = i + 1
            }
            return
        }
        if sub == "size" {
            println(to_string(user32_table_size()))
            return
        }
        if sub == "messagebox" {
            let text = "test"
            let caption = "title"
            if len(a) >= 4 { text = a[3] }
            if len(a) >= 5 { caption = a[4] }
            let rc = headless_messagebox(text, caption)
            println("rc=" + to_string(rc))
            return
        }
    }
    println("usage: hexa run win32_user32.hexa { self-test | table | lookup <name> | status <name> | stats | size | messagebox [text] [caption] }")
}
