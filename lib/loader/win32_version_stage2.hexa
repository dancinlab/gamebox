// lib/loader/win32_version_stage2.hexa — Battle.net Setup VERSION imports coverage
//
// Battle.net 의 file version info 함수. GetFileVersionInfoSize/W,
// GetFileVersionInfoW, VerQueryValueW 등. stage1 base 위에 추가.

fn stub_GetFileVersionInfoSizeW() -> int {
    return 0
}

fn stub_VerQueryValueW() -> int {
    return 1
}

fn stub_GetFileVersionInfoW() -> int {
    return 1
}

fn stage2_table() -> str {
    let t = ""
    t = t + "GetFileVersionInfoSizeW\tDWORD\tstub\n"
    t = t + "VerQueryValueW\tBOOL\tstub\n"
    t = t + "GetFileVersionInfoW\tBOOL\tstub\n"
    return t
}

fn stage2_count() -> int {
    let lines = stage2_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn list_stubs() -> void {
    let lines = stage2_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" { println(lines[i]) }
        i = i + 1
    }
}

fn self_test() -> void {
    let n = stage2_count()
    if n != 3 { panic("win32_version_stage2 FAIL [count] expected=3 got=" + to_string(n)) }

    let r1 = stub_GetFileVersionInfoSizeW()
    if r1 != 0 { panic("win32_version_stage2 FAIL [GetFileVersionInfoSizeW]") }

    let r2 = stub_VerQueryValueW()
    if r2 != 1 { panic("win32_version_stage2 FAIL [VerQueryValueW]") }

    let r3 = stub_GetFileVersionInfoW()
    if r3 != 1 { panic("win32_version_stage2 FAIL [GetFileVersionInfoW]") }

    println("  ✅ win32_version_stage2 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "list" { list_stubs(); return }
    }
    println("usage: hexa run win32_version_stage2.hexa { self-test | list }")
}
