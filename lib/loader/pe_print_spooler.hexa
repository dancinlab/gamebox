// lib/loader/pe_print_spooler.hexa — cycle 78 Win32 print spooler bridge skeleton
//
// Win32 OpenPrinter / StartDocPrinter / WritePrinter API → macOS CUPS / lp
// bridge — print job 1 건 당 telemetry row 1 개 기록. 실 spool / lp(1) 호출은
// stage 후속 단계에서 native helper 가 담당하며, 본 module 은 job 분류 +
// 누적 페이지/byte 집계만 책임진다.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 print job tracker — winspool.drv / spoolss 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// job_kind code:
//   1 = raw
//   2 = text
//   3 = postscript
//   4 = pdf
//   5 = xps
//
// persist schema (TSV — jobs.tsv):
//   job_id<int> \t job_kind<int> \t doc_pages<int> \t bytes_spooled<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pps_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_print_spooler"
}

fn pps_jobs_path() -> str {
    return pps_dir() + "/jobs.tsv"
}

fn pps_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pps_dir() + "'")
}

fn cleanup_pps() -> void {
    pps_ensure_dir()
    let _ = exec("rm -f '" + pps_jobs_path() + "'")
}

// ─── 공통 file IO ───
fn pps_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pps_append_row(path: str, row: str) -> void {
    pps_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_job: print job 1 건 기록 ───
fn record_job(job_id: int, job_kind: int, doc_pages: int, bytes_spooled: int) -> void {
    if job_id <= 0 {
        panic("pe_print_spooler FAIL [record_job] expected=job_id>0 got=" + to_string(job_id))
    }
    if job_kind < 1 {
        panic("pe_print_spooler FAIL [record_job] expected=job_kind>=1 got=" + to_string(job_kind))
    }
    if job_kind > 5 {
        panic("pe_print_spooler FAIL [record_job] expected=job_kind<=5 got=" + to_string(job_kind))
    }
    if doc_pages < 0 {
        panic("pe_print_spooler FAIL [record_job] expected=doc_pages>=0 got=" + to_string(doc_pages))
    }
    if bytes_spooled < 0 {
        panic("pe_print_spooler FAIL [record_job] expected=bytes_spooled>=0 got=" + to_string(bytes_spooled))
    }
    let row = to_string(job_id) + "\t" + to_string(job_kind)
        + "\t" + to_string(doc_pages) + "\t" + to_string(bytes_spooled) + "\n"
    pps_append_row(pps_jobs_path(), row)
}

// ─── job_count: total job 수 ───
fn job_count() -> int {
    let t = pps_read_table(pps_jobs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_doc_pages: 모든 job doc_pages 합 ───
fn total_doc_pages() -> int {
    let t = pps_read_table(pps_jobs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_bytes_spooled: 모든 job bytes_spooled 합 ───
fn total_bytes_spooled() -> int {
    let t = pps_read_table(pps_jobs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_job_kind: 특정 job_kind 의 job 수 ───
fn count_by_job_kind(job_kind: int) -> int {
    let t = pps_read_table(pps_jobs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == job_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── job_bytes: 특정 job_id 의 bytes_spooled (없으면 0) ───
fn job_bytes(job_id: int) -> int {
    let t = pps_read_table(pps_jobs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == job_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pps_stats: [job_count, total_doc_pages, total_bytes_spooled, count_by_job_kind(4)] ───
fn pps_stats() -> array {
    let mut out = []
    out.push(job_count())
    out.push(total_doc_pages())
    out.push(total_bytes_spooled())
    out.push(count_by_job_kind(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pps-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pps()

    // 2. record 5 print jobs across ≥3 job_kinds (raw, text, postscript, pdf, pdf)
    record_job(120001, 1, 1, 4096)
    r0_emit("pe_print_spooler_record",
        "\"job_id\":120001,\"job_kind\":1,\"doc_pages\":1,\"bytes_spooled\":4096,\"target\":\"raw\"")

    record_job(120002, 2, 3, 8192)
    r0_emit("pe_print_spooler_record",
        "\"job_id\":120002,\"job_kind\":2,\"doc_pages\":3,\"bytes_spooled\":8192,\"target\":\"text\"")

    record_job(120003, 3, 5, 16384)
    r0_emit("pe_print_spooler_record",
        "\"job_id\":120003,\"job_kind\":3,\"doc_pages\":5,\"bytes_spooled\":16384,\"target\":\"postscript\"")

    record_job(120004, 4, 12, 65536)
    r0_emit("pe_print_spooler_record",
        "\"job_id\":120004,\"job_kind\":4,\"doc_pages\":12,\"bytes_spooled\":65536,\"target\":\"pdf\"")

    record_job(120005, 4, 7, 32768)
    r0_emit("pe_print_spooler_record",
        "\"job_id\":120005,\"job_kind\":4,\"doc_pages\":7,\"bytes_spooled\":32768,\"target\":\"pdf\"")

    // 3. job_count = 5
    let c = job_count()
    if c != 5 {
        panic("pe_print_spooler FAIL [job_count] expected=5 got=" + to_string(c))
    }

    // 4. total_doc_pages = 1+3+5+12+7 = 28
    let tp = total_doc_pages()
    if tp != 28 {
        panic("pe_print_spooler FAIL [total_doc_pages] expected=28 got=" + to_string(tp))
    }

    // 5. total_bytes_spooled = 4096+8192+16384+65536+32768 = 126976
    let tb = total_bytes_spooled()
    if tb != 126976 {
        panic("pe_print_spooler FAIL [total_bytes_spooled] expected=126976 got=" + to_string(tb))
    }

    // 6. count_by_job_kind sanity
    let k1 = count_by_job_kind(1)
    if k1 != 1 {
        panic("pe_print_spooler FAIL [count_by_job_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_job_kind(2)
    if k2 != 1 {
        panic("pe_print_spooler FAIL [count_by_job_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_job_kind(3)
    if k3 != 1 {
        panic("pe_print_spooler FAIL [count_by_job_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_job_kind(4)
    if k4 != 2 {
        panic("pe_print_spooler FAIL [count_by_job_kind(4)] expected=2 got=" + to_string(k4))
    }
    let k5 = count_by_job_kind(5)
    if k5 != 0 {
        panic("pe_print_spooler FAIL [count_by_job_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_job_kind(99)
    if k99 != 0 {
        panic("pe_print_spooler FAIL [count_by_job_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. job_bytes sanity
    let b3 = job_bytes(120003)
    if b3 != 16384 {
        panic("pe_print_spooler FAIL [job_bytes(120003)] expected=16384 got=" + to_string(b3))
    }
    let b4 = job_bytes(120004)
    if b4 != 65536 {
        panic("pe_print_spooler FAIL [job_bytes(120004)] expected=65536 got=" + to_string(b4))
    }
    let b_miss = job_bytes(9999)
    if b_miss != 0 {
        panic("pe_print_spooler FAIL [job_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 8. pps_stats() = [5, 28, 126976, 2]
    let s = pps_stats()
    if len(s) != 4 {
        panic("pe_print_spooler FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_print_spooler FAIL [stats job_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 28 {
        panic("pe_print_spooler FAIL [stats total_doc_pages] expected=28 got=" + to_string(s[1]))
    }
    if s[2] != 126976 {
        panic("pe_print_spooler FAIL [stats total_bytes_spooled] expected=126976 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_print_spooler FAIL [stats count_kind(4)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_print_spooler_stats",
        "\"job_count\":" + to_string(s[0])
        + ",\"total_doc_pages\":" + to_string(s[1])
        + ",\"total_bytes_spooled\":" + to_string(s[2])
        + ",\"kind_pdf\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_print_spooler FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pps()
    let s2 = pps_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_print_spooler FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_print_spooler self_test PASS (jobs=" + to_string(s[0])
        + ", pages=" + to_string(s[1]) + ", bytes=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pps_stats()
            println("job_count\t" + to_string(s[0]))
            println("total_doc_pages\t" + to_string(s[1]))
            println("total_bytes_spooled\t" + to_string(s[2]))
            println("count_kind_pdf\t" + to_string(s[3]))
            return
        }
        if sub == "bytes" {
            if len(a) >= 4 {
                let jid = to_int(a[3])
                println("job_bytes\t" + to_string(job_bytes(jid)))
                return
            }
            println("usage: hexa run pe_print_spooler.hexa bytes <job_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_job_kind\t" + to_string(count_by_job_kind(kind)))
                return
            }
            println("usage: hexa run pe_print_spooler.hexa count <job_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pps()
            println("cleaned: " + pps_dir())
            return
        }
        if sub == "dir" {
            println(pps_dir())
            return
        }
    }
    println("usage: hexa run pe_print_spooler.hexa { self-test | stats | bytes <job_id> | count <job_kind> | cleanup | dir }")
}
