// lib/loader/win32_rpcrt4.hexa — Phase 4j — rpcrt4 minimal (UUID only)
//
// own 1: Wine 0. Microsoft RPC API spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe rpcrt4 imports (실측):
//   UuidCreate, UuidToStringA, RpcStringFreeA
//
// 전체 RPC framework X — UUID generation 만 필요. macOS 의 uuidgen / posix
// uuid_generate 매핑.

use "../perf/r0_common"

fn rpcrt4_table() -> str {
    let t = ""
    t = t + "UuidCreate\tuuid_generate\tUUID\tskeleton\n"
    t = t + "UuidToStringA\tuuid_unparse\tUUID\tskeleton\n"
    t = t + "RpcStringFreeA\tfree\tUUID\tskeleton\n"
    return t
}

fn rpcrt4_table_size() -> int {
    let lines = rpcrt4_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = rpcrt4_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

// uuid_generate stub — uuidgen CLI 호출 (macOS posix uuid 매핑)
fn uuid_create_stub() -> str {
    let r = exec("uuidgen 2>/dev/null").trim()
    if r == "" { return "00000000-0000-0000-0000-000000000000" }
    return r
}

fn self_test() -> void {
    let sid = "rpcrt4test-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = rpcrt4_table_size()
    if sz != 3 { panic("win32_rpcrt4 FAIL [size] expected=3 got=" + to_string(sz)) }

    let m = lookup_mapping("UuidCreate")
    if !m.contains("uuid_generate") { panic("win32_rpcrt4 FAIL [lookup]") }

    let unk = lookup_mapping("UnknownRpcFunc")
    if unk != "" { panic("win32_rpcrt4 FAIL [unknown]") }

    let u = uuid_create_stub()
    if len(u) < 30 { panic("win32_rpcrt4 FAIL [uuid format] got=" + u) }

    r0_emit("rpcrt4_uuid", "\"uuid\":\"" + u + "\"")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_rpcrt4 FAIL [emit count]") }

    println("  ✅ win32_rpcrt4 self_test PASS (3 funcs, UUID via uuidgen, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "uuid" {
            println(uuid_create_stub())
            return
        }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_mapping(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_rpcrt4.hexa { self-test | uuid | lookup <name> }")
}
