// lib/loader/pe_perf_metalfx_upscale.hexa — MetalFX upscaler tracker.
// own1: Apple MetalFX framework only. NVIDIA DLSS / AMD FSR 인용 X.
// schema: upscale_id<int> \t scaler_kind<int> \t input_resolution<int> \t output_resolution<int>

use "../perf/r0_common"

fn pmfu_dir() -> str { return GAMEBOX_HOME + "/persist/pe_perf_metalfx_upscale" }
fn pmfu_upscales_path() -> str { return pmfu_dir() + "/upscales.tsv" }
fn pmfu_ensure_dir() -> void { let _ = exec("mkdir -p '" + pmfu_dir() + "'") }
fn cleanup_pmfu() -> void { pmfu_ensure_dir(); let _ = exec("rm -f '" + pmfu_upscales_path() + "'") }

fn pmfu_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" { return "" }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmfu_append_row(path: str, row: str) -> void {
    pmfu_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn record_upscale(upscale_id: int, scaler_kind: int, input_resolution: int, output_resolution: int) -> void {
    if upscale_id <= 0 { panic("pe_perf_metalfx_upscale FAIL [record] upscale_id>0 got=" + to_string(upscale_id)) }
    if scaler_kind < 1 { panic("pe_perf_metalfx_upscale FAIL [record] scaler>=1 got=" + to_string(scaler_kind)) }
    if scaler_kind > 3 { panic("pe_perf_metalfx_upscale FAIL [record] scaler<=3 got=" + to_string(scaler_kind)) }
    if input_resolution <= 0 { panic("pe_perf_metalfx_upscale FAIL [record] input>0 got=" + to_string(input_resolution)) }
    if output_resolution <= 0 { panic("pe_perf_metalfx_upscale FAIL [record] output>0 got=" + to_string(output_resolution)) }
    let row = to_string(upscale_id) + "\t" + to_string(scaler_kind)
        + "\t" + to_string(input_resolution) + "\t" + to_string(output_resolution) + "\n"
    pmfu_append_row(pmfu_upscales_path(), row)
}

fn upscale_count() -> int {
    let t = pmfu_read_table(pmfu_upscales_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { cnt = cnt + 1 }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_scaler_kind(scaler_kind: int) -> int {
    let t = pmfu_read_table(pmfu_upscales_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == scaler_kind { cnt = cnt + 1 }
            }
        }
        i = i + 1
    }
    return cnt
}

fn total_input_resolution() -> int {
    let t = pmfu_read_table(pmfu_upscales_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { sum = sum + to_int(parts[2]) }
        }
        i = i + 1
    }
    return sum
}

fn total_output_resolution() -> int {
    let t = pmfu_read_table(pmfu_upscales_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { sum = sum + to_int(parts[3]) }
        }
        i = i + 1
    }
    return sum
}

fn temporal_count() -> int {
    return count_by_scaler_kind(2) + count_by_scaler_kind(3)
}

fn upscale_output_resolution(upscale_id: int) -> int {
    let t = pmfu_read_table(pmfu_upscales_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == upscale_id { return to_int(parts[3]) }
            }
        }
        i = i + 1
    }
    return 0
}

fn pmfu_stats() -> array {
    let mut out = []
    out.push(upscale_count())
    out.push(total_input_resolution())
    out.push(total_output_resolution())
    out.push(temporal_count())
    out.push(count_by_scaler_kind(1))
    return out
}

fn self_test() -> void {
    let sid = "pmfu-" + exec("date +%s").trim()
    r0_session_set(sid)
    cleanup_pmfu()

    record_upscale(210001, 1, 720, 1080)
    r0_emit("pe_perf_metalfx_upscale_record", "\"id\":210001,\"scaler\":1,\"in\":720,\"out\":1080")
    record_upscale(210002, 2, 1080, 1440)
    r0_emit("pe_perf_metalfx_upscale_record", "\"id\":210002,\"scaler\":2,\"in\":1080,\"out\":1440")
    record_upscale(210003, 3, 1080, 2160)
    r0_emit("pe_perf_metalfx_upscale_record", "\"id\":210003,\"scaler\":3,\"in\":1080,\"out\":2160")
    record_upscale(210004, 2, 1440, 2160)
    r0_emit("pe_perf_metalfx_upscale_record", "\"id\":210004,\"scaler\":2,\"in\":1440,\"out\":2160")
    record_upscale(210005, 1, 720, 1440)
    r0_emit("pe_perf_metalfx_upscale_record", "\"id\":210005,\"scaler\":1,\"in\":720,\"out\":1440")

    let c = upscale_count()
    if c != 5 { panic("pe_perf_metalfx_upscale FAIL [upscale_count] expected=5 got=" + to_string(c)) }
    let ti = total_input_resolution()
    if ti != 720+1080+1080+1440+720 { panic("pe_perf_metalfx_upscale FAIL [total_input] expected=5040 got=" + to_string(ti)) }
    let tc = temporal_count()
    if tc != 3 { panic("pe_perf_metalfx_upscale FAIL [temporal_count] expected=3 got=" + to_string(tc)) }

    let s = pmfu_stats()
    if len(s) != 5 { panic("pe_perf_metalfx_upscale FAIL [stats len] expected=5 got=" + to_string(len(s))) }
    r0_emit("pe_perf_metalfx_upscale_stats",
        "\"upscales\":" + to_string(s[0]) + ",\"in\":" + to_string(s[1])
        + ",\"out\":" + to_string(s[2]) + ",\"temporal\":" + to_string(s[3]))

    let emit_n = r0_session_count(sid)
    if emit_n < 6 { panic("pe_perf_metalfx_upscale FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n)) }

    cleanup_pmfu()
    let s2 = pmfu_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 { panic("pe_perf_metalfx_upscale FAIL [cleanup stats[" + to_string(i) + "]] expected=0 got=" + to_string(s2[i])) }
        i = i + 1
    }

    println("  ✅ pe_perf_metalfx_upscale self_test PASS (upscales=" + to_string(s[0])
        + ", in=" + to_string(s[1]) + ", out=" + to_string(s[2])
        + ", temporal=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = pmfu_stats()
            println("upscale_count\t" + to_string(s[0]))
            println("total_input\t" + to_string(s[1]))
            println("total_output\t" + to_string(s[2]))
            println("temporal_count\t" + to_string(s[3]))
            println("spatial_count\t" + to_string(s[4]))
            return
        }
        if sub == "cleanup" { cleanup_pmfu(); println("cleaned: " + pmfu_dir()); return }
        if sub == "dir" { println(pmfu_dir()); return }
    }
    println("usage: hexa run pe_perf_metalfx_upscale.hexa { self-test | stats | cleanup | dir }")
}
