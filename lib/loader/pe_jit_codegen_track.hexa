// lib/loader/pe_jit_codegen_track.hexa — JIT x86_64 → arm64 codegen telemetry skeleton
//
// Rosetta-style instrumentation tracker — x86_64 PE basic block → arm64 native
// code generation 통계 수집. cycle 67 — 실 JIT codegen X (그건 stage7+),
// 본 module 은 codegen event 를 TSV 로 누적/집계.
//
// own 1 enforcement: Wine / CrossOver / Whisky / GPTK / community 코드 0 줄.
//   본 module 은 codegen op tracker — 실 BB translate / asm emit 호출 X.
// own 2 mandate: r0_emit ≥ 5 + self_test() + main() dispatch + headless safe + panic 형식.
//
// expansion_ratio_pct semantics:
//   = (total_output_bytes * 100) / total_input_bytes
//   x86_64 → arm64 보통 1.2 ~ 2.0× (variable-length → fixed 4B). 0-guard: input=0 → 0.
//
// persist schema (TSV — codegens.tsv):
//   codegen_id<int> \t input_bytes<int> \t output_bytes<int> \t elapsed_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pjct_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_jit_codegen_track"
}

fn pjct_codegens_path() -> str {
    return pjct_dir() + "/codegens.tsv"
}

fn pjct_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pjct_dir() + "'")
}

fn cleanup_pjct() -> void {
    pjct_ensure_dir()
    let _ = exec("rm -f '" + pjct_codegens_path() + "'")
}

// ─── 공통 file IO ───
fn pjct_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pjct_append_row(path: str, row: str) -> void {
    pjct_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_codegen: codegen op 1 건 기록 ───
fn record_codegen(codegen_id: int, input_bytes: int, output_bytes: int, elapsed_us: int) -> void {
    if codegen_id <= 0 {
        panic("pe_jit_codegen_track FAIL [record_codegen] expected=codegen_id>0 got=" + to_string(codegen_id))
    }
    if input_bytes < 0 {
        panic("pe_jit_codegen_track FAIL [record_codegen] expected=input_bytes>=0 got=" + to_string(input_bytes))
    }
    if output_bytes < 0 {
        panic("pe_jit_codegen_track FAIL [record_codegen] expected=output_bytes>=0 got=" + to_string(output_bytes))
    }
    if elapsed_us < 0 {
        panic("pe_jit_codegen_track FAIL [record_codegen] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    let row = to_string(codegen_id) + "\t" + to_string(input_bytes)
        + "\t" + to_string(output_bytes) + "\t" + to_string(elapsed_us) + "\n"
    pjct_append_row(pjct_codegens_path(), row)
}

// ─── codegen_count: total codegen 수 ───
fn codegen_count() -> int {
    let t = pjct_read_table(pjct_codegens_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_input_bytes: 모든 codegen input_bytes 합 ───
fn total_input_bytes() -> int {
    let t = pjct_read_table(pjct_codegens_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_output_bytes: 모든 codegen output_bytes 합 ───
fn total_output_bytes() -> int {
    let t = pjct_read_table(pjct_codegens_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_elapsed_us: 모든 codegen elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = pjct_read_table(pjct_codegens_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── expansion_ratio_pct: (out * 100) / in (0-guard) ───
fn expansion_ratio_pct() -> int {
    let ib = total_input_bytes()
    if ib == 0 {
        return 0
    }
    let ob = total_output_bytes()
    return (ob * 100) / ib
}

// ─── codegen_elapsed_us: 특정 codegen_id 의 elapsed_us (없으면 0) ───
fn codegen_elapsed_us(codegen_id: int) -> int {
    let t = pjct_read_table(pjct_codegens_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == codegen_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pjct_stats: [codegen_count, total_input_bytes, total_output_bytes, total_elapsed_us, expansion_ratio_pct] ───
fn pjct_stats() -> array {
    let mut out = []
    out.push(codegen_count())
    out.push(total_input_bytes())
    out.push(total_output_bytes())
    out.push(total_elapsed_us())
    out.push(expansion_ratio_pct())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pjct-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pjct()

    // 2. record 4 codegens (deterministic synthetic, varying input/output)
    //    expected aggregates:
    //      input_total  = 100 + 200 + 50 + 400 = 750
    //      output_total = 150 + 320 + 90 + 640 = 1200
    //      elapsed_total= 80 + 160 + 40 + 240  = 520
    //      ratio_pct    = (1200 * 100) / 750   = 160
    record_codegen(670001, 100, 150, 80)
    r0_emit("pe_jit_codegen_track_record",
        "\"codegen_id\":670001,\"input_bytes\":100,\"output_bytes\":150,\"elapsed_us\":80")

    record_codegen(670002, 200, 320, 160)
    r0_emit("pe_jit_codegen_track_record",
        "\"codegen_id\":670002,\"input_bytes\":200,\"output_bytes\":320,\"elapsed_us\":160")

    record_codegen(670003, 50, 90, 40)
    r0_emit("pe_jit_codegen_track_record",
        "\"codegen_id\":670003,\"input_bytes\":50,\"output_bytes\":90,\"elapsed_us\":40")

    record_codegen(670004, 400, 640, 240)
    r0_emit("pe_jit_codegen_track_record",
        "\"codegen_id\":670004,\"input_bytes\":400,\"output_bytes\":640,\"elapsed_us\":240")

    // 3. codegen_count = 4
    let c = codegen_count()
    if c != 4 {
        panic("pe_jit_codegen_track FAIL [codegen_count] expected=4 got=" + to_string(c))
    }

    // 4. total_input_bytes = 750
    let tib = total_input_bytes()
    if tib != 750 {
        panic("pe_jit_codegen_track FAIL [total_input_bytes] expected=750 got=" + to_string(tib))
    }

    // 5. total_output_bytes = 1200
    let tob = total_output_bytes()
    if tob != 1200 {
        panic("pe_jit_codegen_track FAIL [total_output_bytes] expected=1200 got=" + to_string(tob))
    }

    // 6. total_elapsed_us = 520
    let teu = total_elapsed_us()
    if teu != 520 {
        panic("pe_jit_codegen_track FAIL [total_elapsed_us] expected=520 got=" + to_string(teu))
    }

    // 7. expansion_ratio_pct = 160
    let ratio = expansion_ratio_pct()
    if ratio != 160 {
        panic("pe_jit_codegen_track FAIL [expansion_ratio_pct] expected=160 got=" + to_string(ratio))
    }

    // 8. codegen_elapsed_us sanity
    let e2 = codegen_elapsed_us(670002)
    if e2 != 160 {
        panic("pe_jit_codegen_track FAIL [codegen_elapsed_us(670002)] expected=160 got=" + to_string(e2))
    }
    let e4 = codegen_elapsed_us(670004)
    if e4 != 240 {
        panic("pe_jit_codegen_track FAIL [codegen_elapsed_us(670004)] expected=240 got=" + to_string(e4))
    }
    let e_miss = codegen_elapsed_us(9999)
    if e_miss != 0 {
        panic("pe_jit_codegen_track FAIL [codegen_elapsed_us(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 9. pjct_stats() = [4, 750, 1200, 520, 160]
    let s = pjct_stats()
    if len(s) != 5 {
        panic("pe_jit_codegen_track FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 4 {
        panic("pe_jit_codegen_track FAIL [stats codegen_count] expected=4 got=" + to_string(s[0]))
    }
    if s[1] != 750 {
        panic("pe_jit_codegen_track FAIL [stats total_input_bytes] expected=750 got=" + to_string(s[1]))
    }
    if s[2] != 1200 {
        panic("pe_jit_codegen_track FAIL [stats total_output_bytes] expected=1200 got=" + to_string(s[2]))
    }
    if s[3] != 520 {
        panic("pe_jit_codegen_track FAIL [stats total_elapsed_us] expected=520 got=" + to_string(s[3]))
    }
    if s[4] != 160 {
        panic("pe_jit_codegen_track FAIL [stats expansion_ratio_pct] expected=160 got=" + to_string(s[4]))
    }

    // 10. emit stats
    r0_emit("pe_jit_codegen_track_stats",
        "\"codegen_count\":" + to_string(s[0])
        + ",\"total_input_bytes\":" + to_string(s[1])
        + ",\"total_output_bytes\":" + to_string(s[2])
        + ",\"total_elapsed_us\":" + to_string(s[3])
        + ",\"expansion_ratio_pct\":" + to_string(s[4]))

    // 11. emit count >= 5 (4 records + 1 stats = 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("pe_jit_codegen_track FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pjct()
    let s2 = pjct_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_jit_codegen_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_jit_codegen_track self_test PASS (codegens=" + to_string(s[0])
        + ", in=" + to_string(s[1]) + ", out=" + to_string(s[2])
        + ", elapsed_us=" + to_string(s[3]) + ", ratio_pct=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pjct_stats()
            println("codegen_count\t" + to_string(s[0]))
            println("total_input_bytes\t" + to_string(s[1]))
            println("total_output_bytes\t" + to_string(s[2]))
            println("total_elapsed_us\t" + to_string(s[3]))
            println("expansion_ratio_pct\t" + to_string(s[4]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("codegen_elapsed_us\t" + to_string(codegen_elapsed_us(cid)))
                return
            }
            println("usage: hexa run pe_jit_codegen_track.hexa elapsed <codegen_id>")
            return
        }
        if sub == "ratio" {
            println("expansion_ratio_pct\t" + to_string(expansion_ratio_pct()))
            return
        }
        if sub == "cleanup" {
            cleanup_pjct()
            println("cleaned: " + pjct_dir())
            return
        }
        if sub == "dir" {
            println(pjct_dir())
            return
        }
    }
    println("usage: hexa run pe_jit_codegen_track.hexa { self-test | stats | elapsed <codegen_id> | ratio | cleanup | dir }")
}
