// lib/loader/pe_external_dep_e1_e2_status.hexa — 외부 결정 4건 (E1-E4) 진척 추적기
//
// 외부 결정 4건 (E1-E4) 진척 추적기. 사용자가 helper.mm Xcode build 단계 진행 시
// 본 모듈에 task record. EXTERNAL_DECISIONS_GUIDE.md cross-ref. own1: 자체 추적기.
//
//   E1 = helper.mm Xcode build              (dep_kind 1)
//   E2 = codesign + entitlement plist       (dep_kind 2)
//   E3 = pe_to_macho transpiler 외부 채택   (dep_kind 3)
//   E4 = D3DMetal binary link               (dep_kind 4)
//
// own 1 enforcement: Wine / CrossOver / community / GPTK / Whisky 0 줄 — 본 모듈은
//   외부 결정 진척 TSV 추적기일 뿐, 실 외부 의존성 link X.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// dep_kind code:
//   1 = e1_helper_build
//   2 = e2_codesign
//   3 = e3_pe_to_macho
//   4 = e4_d3dmetal
//
// phase_kind code:
//   1 = preflight
//   2 = in_progress
//   3 = verify
//   4 = installed
//   5 = blocked
//
// persist schema (TSV — tasks.tsv):
//   task_id<str> \t dep_kind<int> \t phase_kind<int> \t completed<int 0|1>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn peds_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_external_dep_e1_e2_status"
}

fn peds_tasks_path() -> str {
    return peds_dir() + "/tasks.tsv"
}

fn peds_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + peds_dir() + "'")
}

fn cleanup_peds() -> void {
    peds_ensure_dir()
    let _ = exec("rm -f '" + peds_tasks_path() + "'")
}

// ─── 공통 file IO ───
fn peds_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn peds_append_row(path: str, row: str) -> void {
    peds_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_task: task 1 건 기록 ───
fn record_task(task_id: str, dep_kind: int, phase_kind: int, completed: int) -> void {
    if task_id == "" {
        panic("pe_external_dep_e1_e2_status FAIL [record_task] expected=task_id!=\"\" got=\"\"")
    }
    if dep_kind < 1 {
        panic("pe_external_dep_e1_e2_status FAIL [record_task] expected=dep_kind>=1 got=" + to_string(dep_kind))
    }
    if dep_kind > 4 {
        panic("pe_external_dep_e1_e2_status FAIL [record_task] expected=dep_kind<=4 got=" + to_string(dep_kind))
    }
    if phase_kind < 1 {
        panic("pe_external_dep_e1_e2_status FAIL [record_task] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 5 {
        panic("pe_external_dep_e1_e2_status FAIL [record_task] expected=phase_kind<=5 got=" + to_string(phase_kind))
    }
    if completed < 0 {
        panic("pe_external_dep_e1_e2_status FAIL [record_task] expected=completed>=0 got=" + to_string(completed))
    }
    if completed > 1 {
        panic("pe_external_dep_e1_e2_status FAIL [record_task] expected=completed<=1 got=" + to_string(completed))
    }
    let row = task_id + "\t" + to_string(dep_kind)
        + "\t" + to_string(phase_kind) + "\t" + to_string(completed) + "\n"
    peds_append_row(peds_tasks_path(), row)
}

// ─── task_count: total task 수 ───
fn task_count() -> int {
    let t = peds_read_table(peds_tasks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_dep_kind: 특정 dep_kind 의 task 수 ───
fn count_by_dep_kind(dep_kind: int) -> int {
    let t = peds_read_table(peds_tasks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == dep_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 task 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = peds_read_table(peds_tasks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── completed_count: completed=1 인 task 수 ───
fn completed_count() -> int {
    let t = peds_read_table(peds_tasks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── e1_e2_progress: dep_kind 1+2 의 completed 비율 (% int 0-100) ───
//   분모 0 시 0 반환 (panic X — observation only)
fn e1_e2_progress() -> int {
    let t = peds_read_table(peds_tasks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut total = 0
    let mut done = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let dk = to_int(parts[1])
                if dk == 1 {
                    total = total + 1
                    if to_int(parts[3]) == 1 {
                        done = done + 1
                    }
                }
                if dk == 2 {
                    total = total + 1
                    if to_int(parts[3]) == 1 {
                        done = done + 1
                    }
                }
            }
        }
        i = i + 1
    }
    if total == 0 {
        return 0
    }
    return done * 100 / total
}

// ─── task_completed: 특정 task_id 의 completed 값 (없으면 -1) ───
fn task_completed(task_id: str) -> int {
    let t = peds_read_table(peds_tasks_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == task_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── peds_stats: [task_count, completed_count, e1_e2_progress, blocked_count] ───
fn peds_stats() -> array {
    let mut out = []
    out.push(task_count())
    out.push(completed_count())
    out.push(e1_e2_progress())
    out.push(count_by_phase_kind(5))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "peds-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_peds()

    // 2. record 8 tasks — covers 4 dep_kinds and 5 phase_kinds with ≥4 completed
    //    dep_kind 1 (E1 helper.mm build): 3 tasks, 2 completed
    //    dep_kind 2 (E2 codesign):        2 tasks, 1 completed
    //    dep_kind 3 (E3 pe_to_macho):     2 tasks, 1 completed
    //    dep_kind 4 (E4 d3dmetal):        1 task,  0 completed
    //    → completed_count = 4
    //    → e1_e2_progress = (2+1)/(3+2)*100 = 60

    // T1: E1 / preflight / done
    record_task("e1_helper_mm_xcode_workspace_open", 1, 1, 1)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e1_helper_mm_xcode_workspace_open\",\"dep_kind\":1,\"phase_kind\":1,\"completed\":1")

    // T2: E1 / in_progress / done
    record_task("e1_helper_mm_objc_compile", 1, 2, 1)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e1_helper_mm_objc_compile\",\"dep_kind\":1,\"phase_kind\":2,\"completed\":1")

    // T3: E1 / verify / not done
    record_task("e1_helper_mm_link_verify", 1, 3, 0)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e1_helper_mm_link_verify\",\"dep_kind\":1,\"phase_kind\":3,\"completed\":0")

    // T4: E2 / preflight / done
    record_task("e2_codesign_identity_pick", 2, 1, 1)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e2_codesign_identity_pick\",\"dep_kind\":2,\"phase_kind\":1,\"completed\":1")

    // T5: E2 / in_progress / not done
    record_task("e2_entitlement_plist_author", 2, 2, 0)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e2_entitlement_plist_author\",\"dep_kind\":2,\"phase_kind\":2,\"completed\":0")

    // T6: E3 / preflight / done
    record_task("e3_pe_to_macho_tool_pick", 3, 1, 1)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e3_pe_to_macho_tool_pick\",\"dep_kind\":3,\"phase_kind\":1,\"completed\":1")

    // T7: E3 / installed / not done
    record_task("e3_pe_to_macho_install_verify", 3, 4, 0)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e3_pe_to_macho_install_verify\",\"dep_kind\":3,\"phase_kind\":4,\"completed\":0")

    // T8: E4 / blocked / not done
    record_task("e4_d3dmetal_binary_pending_apple", 4, 5, 0)
    r0_emit("pe_external_dep_e1_e2_status_record",
        "\"task_id\":\"e4_d3dmetal_binary_pending_apple\",\"dep_kind\":4,\"phase_kind\":5,\"completed\":0")

    // 3. task_count = 8
    let tc = task_count()
    if tc != 8 {
        panic("pe_external_dep_e1_e2_status FAIL [task_count] expected=8 got=" + to_string(tc))
    }

    // 4. count_by_dep_kind sanity (4 dep_kinds present)
    let d1 = count_by_dep_kind(1)
    if d1 != 3 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_dep_kind(1)] expected=3 got=" + to_string(d1))
    }
    let d2 = count_by_dep_kind(2)
    if d2 != 2 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_dep_kind(2)] expected=2 got=" + to_string(d2))
    }
    let d3 = count_by_dep_kind(3)
    if d3 != 2 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_dep_kind(3)] expected=2 got=" + to_string(d3))
    }
    let d4 = count_by_dep_kind(4)
    if d4 != 1 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_dep_kind(4)] expected=1 got=" + to_string(d4))
    }
    let d_miss = count_by_dep_kind(99)
    if d_miss != 0 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_dep_kind(99)] expected=0 got=" + to_string(d_miss))
    }

    // 5. count_by_phase_kind sanity (≥3 phase_kinds present — actual: 1,2,3,4,5 all hit)
    let p1 = count_by_phase_kind(1)
    if p1 != 3 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_phase_kind(1)] expected=3 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 2 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_phase_kind(2)] expected=2 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p_miss = count_by_phase_kind(99)
    if p_miss != 0 {
        panic("pe_external_dep_e1_e2_status FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p_miss))
    }

    // 6. completed_count = 4 (T1, T2, T4, T6)
    let cc = completed_count()
    if cc != 4 {
        panic("pe_external_dep_e1_e2_status FAIL [completed_count] expected=4 got=" + to_string(cc))
    }

    // 7. e1_e2_progress = (2+1)/(3+2)*100 = 60
    let prog = e1_e2_progress()
    if prog != 60 {
        panic("pe_external_dep_e1_e2_status FAIL [e1_e2_progress] expected=60 got=" + to_string(prog))
    }

    // 8. task_completed lookups
    let tc_t1 = task_completed("e1_helper_mm_xcode_workspace_open")
    if tc_t1 != 1 {
        panic("pe_external_dep_e1_e2_status FAIL [task_completed(T1)] expected=1 got=" + to_string(tc_t1))
    }
    let tc_t3 = task_completed("e1_helper_mm_link_verify")
    if tc_t3 != 0 {
        panic("pe_external_dep_e1_e2_status FAIL [task_completed(T3)] expected=0 got=" + to_string(tc_t3))
    }
    let tc_miss = task_completed("nonexistent_task_xyz")
    if tc_miss != -1 {
        panic("pe_external_dep_e1_e2_status FAIL [task_completed(miss)] expected=-1 got=" + to_string(tc_miss))
    }

    // 9. peds_stats() = [8, 4, 60, 1]
    let s = peds_stats()
    if len(s) != 4 {
        panic("pe_external_dep_e1_e2_status FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_external_dep_e1_e2_status FAIL [stats task_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_external_dep_e1_e2_status FAIL [stats completed_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 60 {
        panic("pe_external_dep_e1_e2_status FAIL [stats e1_e2_progress] expected=60 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_external_dep_e1_e2_status FAIL [stats blocked_count] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit aggregate stats
    r0_emit("pe_external_dep_e1_e2_status_stats",
        "\"task_count\":" + to_string(s[0])
        + ",\"completed_count\":" + to_string(s[1])
        + ",\"e1_e2_progress\":" + to_string(s[2])
        + ",\"blocked_count\":" + to_string(s[3]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_external_dep_e1_e2_status FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_peds()
    let s2 = peds_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_external_dep_e1_e2_status FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_external_dep_e1_e2_status self_test PASS (tasks=" + to_string(s[0])
        + ", completed=" + to_string(s[1]) + ", e1_e2_progress=" + to_string(s[2])
        + "%, blocked=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = peds_stats()
            println("task_count\t" + to_string(s[0]))
            println("completed_count\t" + to_string(s[1]))
            println("e1_e2_progress\t" + to_string(s[2]))
            println("blocked_count\t" + to_string(s[3]))
            return
        }
        if sub == "progress" {
            println("e1_e2_progress\t" + to_string(e1_e2_progress()))
            return
        }
        if sub == "completed" {
            if len(a) >= 4 {
                let tid = a[3]
                println("completed\t" + to_string(task_completed(tid)))
                return
            }
            println("usage: hexa run pe_external_dep_e1_e2_status.hexa completed <task_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let val = to_int(a[4])
                if dim == "dep" {
                    println("count_by_dep_kind\t" + to_string(count_by_dep_kind(val)))
                    return
                }
                if dim == "phase" {
                    println("count_by_phase_kind\t" + to_string(count_by_phase_kind(val)))
                    return
                }
                println("usage: hexa run pe_external_dep_e1_e2_status.hexa count { dep | phase } <kind>")
                return
            }
            println("usage: hexa run pe_external_dep_e1_e2_status.hexa count { dep | phase } <kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_peds()
            println("cleaned: " + peds_dir())
            return
        }
        if sub == "dir" {
            println(peds_dir())
            return
        }
    }
    println("usage: hexa run pe_external_dep_e1_e2_status.hexa { self-test | stats | progress | completed <task_id> | count dep <dep_kind> | count phase <phase_kind> | cleanup | dir }")
}
