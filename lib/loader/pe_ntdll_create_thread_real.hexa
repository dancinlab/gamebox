// lib/loader/pe_ntdll_create_thread_real.hexa — NTDLL NtCreateThreadEx 실 호출 추적 (cycle 84)
//
// NTDLL NtCreateThreadEx / NtTerminateThread / NtSuspendThread / NtResumeThread 실 호출 → Apple pthread bridge:
//   NtCreateThreadEx(out ThreadHandle, DesiredAccess, ObjectAttributes, ProcessHandle,
//                    StartRoutine, Argument, CreateFlags, ZeroBits, StackSize, MaxStackSize, AttributeList)
//     → pthread_create(&tid, &attr, start_routine, arg) + qos_class_self() inheritance
//   CREATE_SUSPENDED (0x1)        → pthread_create + 즉시 sigwait/condvar gate (resume 시 signal)
//   THREAD_CREATE_FLAGS_HIDE_FROM_DEBUGGER (0x4) → anti-debug 표적 — Battle.net / D2R / D4 자주 사용
//   NtTerminateThread             → pthread_cancel (target=current 면 pthread_exit)
//   NtSuspendThread / NtResumeThread → SIGSTOP/SIGCONT 사용 X (POSIX undefined) — condvar gate 사용
//   NtAlertThread                 → pthread_kill(SIGUSR1) + per-thread alert flag
// own1: NTDLL spec + Apple pthread only. Wine ntdll/thread.c / loader/thread.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 NT API call tracker — 실 NtCreateThreadEx / pthread_create 호출 X (native bridge stage).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//   1 = NtCreateThreadEx
//   2 = NtTerminateThread
//   3 = NtSuspendThread
//   4 = NtResumeThread
//   5 = NtAlertThread
//
// flags bitmask (decimal — stored as int):
//   1 = CREATE_SUSPENDED
//   4 = THREAD_CREATE_FLAGS_HIDE_FROM_DEBUGGER  (anti-debug 표적)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t thread_id<int> \t flags<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pnctr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ntdll_create_thread_real"
}

fn pnctr_calls_path() -> str {
    return pnctr_dir() + "/calls.tsv"
}

fn pnctr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pnctr_dir() + "'")
}

fn cleanup_pnctr() -> void {
    pnctr_ensure_dir()
    let _ = exec("rm -f '" + pnctr_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pnctr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pnctr_append_row(path: str, row: str) -> void {
    pnctr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: NT API call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, thread_id: int, flags: int) -> void {
    if call_id <= 0 {
        panic("pe_ntdll_create_thread_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("pe_ntdll_create_thread_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 5 {
        panic("pe_ntdll_create_thread_real FAIL [record_call] expected=func_kind<=5 got=" + to_string(func_kind))
    }
    if thread_id < 0 {
        panic("pe_ntdll_create_thread_real FAIL [record_call] expected=thread_id>=0 got=" + to_string(thread_id))
    }
    if flags < 0 {
        panic("pe_ntdll_create_thread_real FAIL [record_call] expected=flags>=0 got=" + to_string(flags))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(thread_id) + "\t" + to_string(flags) + "\n"
    pnctr_append_row(pnctr_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = pnctr_read_table(pnctr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = pnctr_read_table(pnctr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_flag_bit: 특정 flag bit 가 set 된 call 수 (bitwise AND) ───
fn count_by_flag_bit(bit: int) -> int {
    let t = pnctr_read_table(pnctr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let f = to_int(parts[3])
                // bitwise AND via integer division (no bitwise op assumed in hexa)
                // bit ∈ {1,2,4,8,16,...} — check if (f / bit) is odd
                if bit > 0 {
                    let q = f / bit
                    let r = q - ((q / 2) * 2)
                    if r == 1 {
                        cnt = cnt + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_threads: 등장한 unique thread_id 수 (thread_id == 0 제외) ───
fn distinct_threads() -> int {
    let t = pnctr_read_table(pnctr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let tid = to_int(parts[2])
                if tid > 0 {
                    let m = len(seen)
                    let j = 0
                    let mut found = 0
                    while j < m {
                        if seen[j] == tid {
                            found = 1
                        }
                        j = j + 1
                    }
                    if found == 0 {
                        seen.push(tid)
                    }
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── hidden_count: HIDE_FROM_DEBUGGER (0x4) flag bit set 된 call 수 ───
fn hidden_count() -> int {
    return count_by_flag_bit(4)
}

// ─── call_thread_id: 특정 call_id 의 thread_id (없으면 -1) ───
fn call_thread_id(call_id: int) -> int {
    let t = pnctr_read_table(pnctr_calls_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pnctr_stats: [call_count, count_by_func_kind(1), distinct_threads, hidden_count] ───
fn pnctr_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(count_by_func_kind(1))
    out.push(distinct_threads())
    out.push(hidden_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pnctr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pnctr()

    // 2. record 5 calls — covers ≥3 func_kinds, ≥2 hidden
    //    NtCreateThreadEx tid=4001 CREATE_SUSPENDED|HIDE_FROM_DEBUGGER (Battle.net anti-debug)
    record_call(140001, 1, 4001, 5)
    r0_emit("pe_ntdll_create_thread_real_record",
        "\"call_id\":140001,\"func_kind\":1,\"thread_id\":4001,\"flags\":5,\"target\":\"NtCreateThreadEx\"")

    //    NtCreateThreadEx tid=4002 HIDE_FROM_DEBUGGER (D2R worker)
    record_call(140002, 1, 4002, 4)
    r0_emit("pe_ntdll_create_thread_real_record",
        "\"call_id\":140002,\"func_kind\":1,\"thread_id\":4002,\"flags\":4,\"target\":\"NtCreateThreadEx\"")

    //    NtSuspendThread tid=4001 (no flags)
    record_call(140003, 3, 4001, 0)
    r0_emit("pe_ntdll_create_thread_real_record",
        "\"call_id\":140003,\"func_kind\":3,\"thread_id\":4001,\"flags\":0,\"target\":\"NtSuspendThread\"")

    //    NtResumeThread tid=4001
    record_call(140004, 4, 4001, 0)
    r0_emit("pe_ntdll_create_thread_real_record",
        "\"call_id\":140004,\"func_kind\":4,\"thread_id\":4001,\"flags\":0,\"target\":\"NtResumeThread\"")

    //    NtTerminateThread tid=4002
    record_call(140005, 2, 4002, 0)
    r0_emit("pe_ntdll_create_thread_real_record",
        "\"call_id\":140005,\"func_kind\":2,\"thread_id\":4002,\"flags\":0,\"target\":\"NtTerminateThread\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("pe_ntdll_create_thread_real FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (≥3 func_kinds covered: 1, 2, 3, 4)
    let f1 = count_by_func_kind(1)
    if f1 != 2 {
        panic("pe_ntdll_create_thread_real FAIL [count_by_func_kind(1)] expected=2 got=" + to_string(f1))
    }
    let f2 = count_by_func_kind(2)
    if f2 != 1 {
        panic("pe_ntdll_create_thread_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(f2))
    }
    let f3 = count_by_func_kind(3)
    if f3 != 1 {
        panic("pe_ntdll_create_thread_real FAIL [count_by_func_kind(3)] expected=1 got=" + to_string(f3))
    }
    let f4 = count_by_func_kind(4)
    if f4 != 1 {
        panic("pe_ntdll_create_thread_real FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(f4))
    }
    let f99 = count_by_func_kind(99)
    if f99 != 0 {
        panic("pe_ntdll_create_thread_real FAIL [count_by_func_kind(99)] expected=0 got=" + to_string(f99))
    }

    // 5. count_by_flag_bit sanity
    //    CREATE_SUSPENDED (1) → 1 call (140001 has flags=5=1|4)
    let b1 = count_by_flag_bit(1)
    if b1 != 1 {
        panic("pe_ntdll_create_thread_real FAIL [count_by_flag_bit(1)] expected=1 got=" + to_string(b1))
    }
    //    HIDE_FROM_DEBUGGER (4) → 2 calls (140001 flags=5, 140002 flags=4)
    let b4 = count_by_flag_bit(4)
    if b4 != 2 {
        panic("pe_ntdll_create_thread_real FAIL [count_by_flag_bit(4)] expected=2 got=" + to_string(b4))
    }

    // 6. hidden_count = 2 (== count_by_flag_bit(4))
    let hc = hidden_count()
    if hc != 2 {
        panic("pe_ntdll_create_thread_real FAIL [hidden_count] expected=2 got=" + to_string(hc))
    }

    // 7. distinct_threads = 2 (4001, 4002)
    let dt = distinct_threads()
    if dt != 2 {
        panic("pe_ntdll_create_thread_real FAIL [distinct_threads] expected=2 got=" + to_string(dt))
    }

    // 8. call_thread_id sanity
    let t1 = call_thread_id(140001)
    if t1 != 4001 {
        panic("pe_ntdll_create_thread_real FAIL [call_thread_id(140001)] expected=4001 got=" + to_string(t1))
    }
    let t5 = call_thread_id(140005)
    if t5 != 4002 {
        panic("pe_ntdll_create_thread_real FAIL [call_thread_id(140005)] expected=4002 got=" + to_string(t5))
    }
    let t_miss = call_thread_id(9999)
    if t_miss != -1 {
        panic("pe_ntdll_create_thread_real FAIL [call_thread_id(9999)] expected=-1 got=" + to_string(t_miss))
    }

    // 9. pnctr_stats() = [5, 2, 2, 2]
    let s = pnctr_stats()
    if len(s) != 4 {
        panic("pe_ntdll_create_thread_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_ntdll_create_thread_real FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_ntdll_create_thread_real FAIL [stats func_kind(1)] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_ntdll_create_thread_real FAIL [stats distinct_threads] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_ntdll_create_thread_real FAIL [stats hidden] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats (6th r0_emit)
    r0_emit("pe_ntdll_create_thread_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"create_ex\":" + to_string(s[1])
        + ",\"distinct_threads\":" + to_string(s[2])
        + ",\"hidden\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_ntdll_create_thread_real FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0 (post-cleanup zero)
    cleanup_pnctr()
    let s2 = pnctr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ntdll_create_thread_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ntdll_create_thread_real self_test PASS (calls=" + to_string(s[0])
        + ", create_ex=" + to_string(s[1]) + ", distinct=" + to_string(s[2])
        + ", hidden=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pnctr_stats()
            println("call_count\t" + to_string(s[0]))
            println("count_func_kind_create_ex\t" + to_string(s[1]))
            println("distinct_threads\t" + to_string(s[2]))
            println("hidden_count\t" + to_string(s[3]))
            return
        }
        if sub == "tid" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_thread_id\t" + to_string(call_thread_id(cid)))
                return
            }
            println("usage: hexa run pe_ntdll_create_thread_real.hexa tid <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let what = a[3]
                let val = to_int(a[4])
                if what == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if what == "flag" {
                    println("count_by_flag_bit\t" + to_string(count_by_flag_bit(val)))
                    return
                }
            }
            println("usage: hexa run pe_ntdll_create_thread_real.hexa count { func <func_kind> | flag <bit> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pnctr()
            println("cleaned: " + pnctr_dir())
            return
        }
        if sub == "dir" {
            println(pnctr_dir())
            return
        }
    }
    println("usage: hexa run pe_ntdll_create_thread_real.hexa { self-test | stats | tid <call_id> | count func <func_kind> | count flag <bit> | cleanup | dir }")
}
