// lib/loader/pe_dxgi_swapchain.hexa — cycle76 DXGI IDXGISwapChain telemetry skeleton
//
// IDXGISwapChain::Present(SyncInterval, Flags) / Present1 / ResizeBuffers /
// SetFullscreenState / GetFrameStatistics op tracker. 실 D3D / DXGI 호출 X —
// op-id 별 sync_interval / present_flags 만 기록.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 swapchain op tracker — IDXGISwapChain 인스턴스 생성 / Present 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = present
//   2 = present1
//   3 = resize_buffers
//   4 = set_fullscreen_state
//   5 = get_frame_statistics
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t sync_interval<int> \t present_flags<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdsc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dxgi_swapchain"
}

fn pdsc_ops_path() -> str {
    return pdsc_dir() + "/ops.tsv"
}

fn pdsc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdsc_dir() + "'")
}

fn cleanup_pdsc() -> void {
    pdsc_ensure_dir()
    let _ = exec("rm -f '" + pdsc_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pdsc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdsc_append_row(path: str, row: str) -> void {
    pdsc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: swapchain op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, sync_interval: int, present_flags: int) -> void {
    if op_id <= 0 {
        panic("pe_dxgi_swapchain FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_dxgi_swapchain FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 5 {
        panic("pe_dxgi_swapchain FAIL [record_op] expected=op_kind<=5 got=" + to_string(op_kind))
    }
    if sync_interval < 0 {
        panic("pe_dxgi_swapchain FAIL [record_op] expected=sync_interval>=0 got=" + to_string(sync_interval))
    }
    if present_flags < 0 {
        panic("pe_dxgi_swapchain FAIL [record_op] expected=present_flags>=0 got=" + to_string(present_flags))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(sync_interval) + "\t" + to_string(present_flags) + "\n"
    pdsc_append_row(pdsc_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pdsc_read_table(pdsc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_sync_interval: 모든 op sync_interval 합 ───
fn total_sync_interval() -> int {
    let t = pdsc_read_table(pdsc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = pdsc_read_table(pdsc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_present_flags: present_flags == flags_mask 인 op 수 ───
fn count_by_present_flags(flags_mask: int) -> int {
    let t = pdsc_read_table(pdsc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == flags_mask {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_sync_interval: 특정 op_id 의 sync_interval (없으면 0) ───
fn op_sync_interval(op_id: int) -> int {
    let t = pdsc_read_table(pdsc_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdsc_stats: [op_count, total_sync_interval, count_by_op_kind(1), count_by_present_flags(0)] ───
fn pdsc_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_sync_interval())
    out.push(count_by_op_kind(1))
    out.push(count_by_present_flags(0))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdsc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdsc()

    // 2. record 5 ops across 4 op_kinds (1,2,3,4)
    record_op(760001, 1, 1, 0)
    r0_emit("pe_dxgi_swapchain_record",
        "\"op_id\":760001,\"op_kind\":1,\"sync_interval\":1,\"present_flags\":0,\"target\":\"present\"")

    record_op(760002, 1, 0, 512)
    r0_emit("pe_dxgi_swapchain_record",
        "\"op_id\":760002,\"op_kind\":1,\"sync_interval\":0,\"present_flags\":512,\"target\":\"present\"")

    record_op(760003, 2, 2, 0)
    r0_emit("pe_dxgi_swapchain_record",
        "\"op_id\":760003,\"op_kind\":2,\"sync_interval\":2,\"present_flags\":0,\"target\":\"present1\"")

    record_op(760004, 3, 0, 0)
    r0_emit("pe_dxgi_swapchain_record",
        "\"op_id\":760004,\"op_kind\":3,\"sync_interval\":0,\"present_flags\":0,\"target\":\"resize_buffers\"")

    record_op(760005, 4, 0, 1)
    r0_emit("pe_dxgi_swapchain_record",
        "\"op_id\":760005,\"op_kind\":4,\"sync_interval\":0,\"present_flags\":1,\"target\":\"set_fullscreen_state\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_dxgi_swapchain FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_sync_interval = 1+0+2+0+0 = 3
    let tsi = total_sync_interval()
    if tsi != 3 {
        panic("pe_dxgi_swapchain FAIL [total_sync_interval] expected=3 got=" + to_string(tsi))
    }

    // 5. count_by_op_kind sanity
    let k1 = count_by_op_kind(1)
    if k1 != 2 {
        panic("pe_dxgi_swapchain FAIL [count_by_op_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 1 {
        panic("pe_dxgi_swapchain FAIL [count_by_op_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_dxgi_swapchain FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 1 {
        panic("pe_dxgi_swapchain FAIL [count_by_op_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_op_kind(5)
    if k5 != 0 {
        panic("pe_dxgi_swapchain FAIL [count_by_op_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_dxgi_swapchain FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_present_flags sanity
    let f0 = count_by_present_flags(0)
    if f0 != 3 {
        panic("pe_dxgi_swapchain FAIL [count_by_present_flags(0)] expected=3 got=" + to_string(f0))
    }
    let f1 = count_by_present_flags(1)
    if f1 != 1 {
        panic("pe_dxgi_swapchain FAIL [count_by_present_flags(1)] expected=1 got=" + to_string(f1))
    }
    let f512 = count_by_present_flags(512)
    if f512 != 1 {
        panic("pe_dxgi_swapchain FAIL [count_by_present_flags(512)] expected=1 got=" + to_string(f512))
    }
    let f_miss = count_by_present_flags(9999)
    if f_miss != 0 {
        panic("pe_dxgi_swapchain FAIL [count_by_present_flags(9999)] expected=0 got=" + to_string(f_miss))
    }

    // 7. op_sync_interval sanity
    let s1 = op_sync_interval(760001)
    if s1 != 1 {
        panic("pe_dxgi_swapchain FAIL [op_sync_interval(760001)] expected=1 got=" + to_string(s1))
    }
    let s3 = op_sync_interval(760003)
    if s3 != 2 {
        panic("pe_dxgi_swapchain FAIL [op_sync_interval(760003)] expected=2 got=" + to_string(s3))
    }
    let s_miss = op_sync_interval(9999)
    if s_miss != 0 {
        panic("pe_dxgi_swapchain FAIL [op_sync_interval(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 8. pdsc_stats() = [5, 3, 2, 3]
    let s = pdsc_stats()
    if len(s) != 4 {
        panic("pe_dxgi_swapchain FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_dxgi_swapchain FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_dxgi_swapchain FAIL [stats total_sync_interval] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_dxgi_swapchain FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_dxgi_swapchain FAIL [stats count_flags(0)] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_dxgi_swapchain_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_sync_interval\":" + to_string(s[1])
        + ",\"kind_present\":" + to_string(s[2])
        + ",\"flags_zero\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_dxgi_swapchain FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdsc()
    let s2 = pdsc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dxgi_swapchain FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dxgi_swapchain self_test PASS (ops=" + to_string(s[0])
        + ", sync=" + to_string(s[1]) + ", present=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdsc_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_sync_interval\t" + to_string(s[1]))
            println("count_kind_present\t" + to_string(s[2]))
            println("count_flags_zero\t" + to_string(s[3]))
            return
        }
        if sub == "sync" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_sync_interval\t" + to_string(op_sync_interval(oid)))
                return
            }
            println("usage: hexa run pe_dxgi_swapchain.hexa sync <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_dxgi_swapchain.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdsc()
            println("cleaned: " + pdsc_dir())
            return
        }
        if sub == "dir" {
            println(pdsc_dir())
            return
        }
    }
    println("usage: hexa run pe_dxgi_swapchain.hexa { self-test | stats | sync <op_id> | count <op_kind> | cleanup | dir }")
}
