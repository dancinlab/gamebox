// lib/loader/pe_iat_resolve_stage2.hexa — stage2 IAT pointer fixup skeleton
//
// stage1 (pe_imports) = parse import table. stage2 = walk imports + lookup
// stub address + patch IAT slot. 본 파일은 instrumentation — actual ptr fixup
// 은 stage3.
//
// own 1 enforcement: Wine / CrossOver / community PE loader 코드 0 줄.
//   참조 only — Microsoft PE/COFF spec (learn.microsoft.com).
// own 2 mandate:
//   - r0_emit ≥ 4 (resolve_dll_imports + record_resolution × 3)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("pe_iat_resolve_stage2 FAIL [<sub>] expected=X got=Y")
//
// table schema (TSV, 4-key — fn_count + resolved aggregate stub_used):
//   pir_log.tsv     — "pe_id\tdll_id\tfn_count\tresolved\n"
//
// 동작 흐름 (skeleton):
//   1. resolve_dll_imports(pe_path, dll_name) — pe_imports 의 list_dependencies
//      위에서 dll_name 만 매칭 (실제 함수 이름 lookup 은 stage3).
//      반환: [function_count, resolved_count, stub_count, ordinal_count]
//   2. record_resolution(pe_id, dll_id, fn_count, resolved, stub_used)
//      pir_log.tsv 에 행 append.
//   3. pir_stats() — log 의 행 수 + fn_count/resolved/stub_used 합.

use "./pe_imports"
use "../perf/r0_common"

// ─── persist 디렉토리 (4-key 작업 영역) ───
fn pir_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_iat_resolve_stage2"
}

fn pir_log_path() -> str {
    return pir_dir() + "/pir_log.tsv"
}

fn ensure_pir_dir() -> void {
    let _ = exec("mkdir -p '" + pir_dir() + "'")
}

fn cleanup_pir() -> void {
    ensure_pir_dir()
    let _ = exec("rm -f '" + pir_log_path() + "'")
}

// ─── 공통 file IO ───
fn pir_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pir_append_row(path: str, row: str) -> void {
    ensure_pir_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── resolve_dll_imports (skeleton) ───
//   pe_imports.list_dependencies 결과에서 dll_name 매칭 — 실제 함수 이름
//   lookup 은 stage3. skeleton 은 dependency 가 존재하면
//   [function_count, resolved_count, stub_count, ordinal_count] 자리잡는 placeholder
//   를 반환 (현재 구현: 매칭 dll 발견 시 [0,0,0,0], 미발견 시 [-1,-1,-1,-1]).
fn resolve_dll_imports(pe_path: str, dll_name: str) -> array {
    let exists = exec("test -f '" + pe_path + "' && echo y || echo n").trim()
    if exists != "y" {
        return [-1, -1, -1, -1]
    }
    let deps = list_dependencies(pe_path)
    let target = dll_name.to_lower()
    let i = 0
    let mut found = false
    while i < len(deps) {
        if deps[i].to_lower() == target {
            found = true
        }
        i = i + 1
    }
    if !found {
        return [-1, -1, -1, -1]
    }
    // skeleton placeholder — stage3 will populate actual counts via
    // parse_imported_names + stub adapter dispatch.
    return [0, 0, 0, 0]
}

// ─── record_resolution: pir_log.tsv 행 추가 + r0_emit ───
fn record_resolution(pe_id: int, dll_id: int, fn_count: int, resolved: int, stub_used: int) -> void {
    let row = to_string(pe_id) + "\t" + to_string(dll_id)
        + "\t" + to_string(fn_count) + "\t" + to_string(resolved) + "\n"
    pir_append_row(pir_log_path(), row)
    r0_emit("pir_record",
        "\"pe_id\":" + to_string(pe_id)
        + ",\"dll_id\":" + to_string(dll_id)
        + ",\"fn_count\":" + to_string(fn_count)
        + ",\"resolved\":" + to_string(resolved)
        + ",\"stub_used\":" + to_string(stub_used))
}

// ─── pir_stats: [resolution_count, total_functions, total_resolved, total_stub_used] ───
//   stub_used 는 schema 4-key 단순화에서 별도로 보관하지 않으므로 자리만 유지 (= 0).
fn pir_stats() -> array {
    let mut out = []
    let mut row_n = 0
    let mut sum_fn = 0
    let mut sum_res = 0
    let mut sum_stub = 0
    let t = pir_read_table(pir_log_path())
    if t != "" {
        let lines = t.split("\n")
        let n = len(lines)
        let i = 0
        while i < n {
            let line = lines[i]
            if line != "" {
                let parts = line.split("\t")
                if len(parts) >= 4 {
                    row_n = row_n + 1
                    sum_fn = sum_fn + to_int(parts[2])
                    sum_res = sum_res + to_int(parts[3])
                }
            }
            i = i + 1
        }
    }
    out.push(row_n)
    out.push(sum_fn)
    out.push(sum_res)
    out.push(sum_stub)
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pir-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup → log empty
    cleanup_pir()
    let s0 = pir_stats()
    if s0[0] != 0 {
        panic("pe_iat_resolve_stage2 FAIL [stats[0] init] expected=0 got=" + to_string(s0[0]))
    }

    // 2. record 3 resolutions for Battle.net (pe_id=73001)
    //    KERNEL32 (dll_id=5) — 224 fn fully resolved
    //    USER32   (dll_id=6) — 50 fn fully resolved
    //    ADVAPI32 (dll_id=8) — 53 fn fully resolved
    record_resolution(73001, 5, 224, 224, 224)
    record_resolution(73001, 6, 50, 50, 50)
    record_resolution(73001, 8, 53, 53, 53)

    // 3. stats 검증 — [3, 327, 327, 0]
    let s = pir_stats()
    if len(s) != 4 {
        panic("pe_iat_resolve_stage2 FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 3 {
        panic("pe_iat_resolve_stage2 FAIL [resolution_count] expected=3 got=" + to_string(s[0]))
    }
    if s[1] != 327 {
        panic("pe_iat_resolve_stage2 FAIL [total_functions] expected=327 got=" + to_string(s[1]))
    }
    if s[2] != 327 {
        panic("pe_iat_resolve_stage2 FAIL [total_resolved] expected=327 got=" + to_string(s[2]))
    }
    if s[3] != 0 {
        panic("pe_iat_resolve_stage2 FAIL [total_stub_used] expected=0 got=" + to_string(s[3]))
    }

    // 4. resolve_dll_imports — PE 미존재 경로 → [-1,-1,-1,-1]
    let r_missing = resolve_dll_imports("/nonexistent/no_such.exe", "kernel32.dll")
    if r_missing[0] != -1 {
        panic("pe_iat_resolve_stage2 FAIL [resolve missing] expected=-1 got=" + to_string(r_missing[0]))
    }

    // 4b. resolve_dll_imports on real PE — Battle.net 있을 때만
    let bnet = exec("ls /Users/ghost/core/airgenome-gamebox/tool/bench/Battle.net-Setup.exe 2>/dev/null").trim()
    if bnet != "" {
        let r_real = resolve_dll_imports(bnet, "KERNEL32.dll")
        // skeleton 은 매칭 시 [0,0,0,0] 반환 (placeholder).
        if r_real[0] < 0 {
            panic("pe_iat_resolve_stage2 FAIL [resolve real] expected=>=0 got=" + to_string(r_real[0]))
        }
        r0_emit("pir_resolve_real",
            "\"pe\":\"battlenet\",\"dll\":\"KERNEL32.dll\",\"fn_count\":"
            + to_string(r_real[0]))
    } else {
        r0_emit("pir_resolve_skip", "\"reason\":\"no_pe_sample\"")
    }

    // 5. r0_emit count ≥ 4 (3 record + 1 resolve_real|skip)
    let emit_n = r0_session_count(sid)
    if emit_n < 4 {
        panic("pe_iat_resolve_stage2 FAIL [r0 emit count] expected=>=4 got=" + to_string(emit_n))
    }

    // 6. cleanup → stats reset
    cleanup_pir()
    let s_after = pir_stats()
    let j = 0
    while j < len(s_after) {
        if s_after[j] != 0 {
            panic("pe_iat_resolve_stage2 FAIL [cleanup stats[" + to_string(j)
                + "]] expected=0 got=" + to_string(s_after[j]))
        }
        j = j + 1
    }

    println("  ✅ pe_iat_resolve_stage2 self_test PASS (3 resolutions, 327 fn, sid="
        + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pir_stats()
            println("resolution_count\t" + to_string(s[0]))
            println("total_functions\t" + to_string(s[1]))
            println("total_resolved\t" + to_string(s[2]))
            println("total_stub_used\t" + to_string(s[3]))
            return
        }
        if sub == "resolve" {
            if len(a) >= 4 {
                let pe = a[3]
                let dll = "kernel32.dll"
                if len(a) >= 5 {
                    dll = a[4]
                }
                let r = resolve_dll_imports(pe, dll)
                println("fn_count\t" + to_string(r[0]))
                println("resolved\t" + to_string(r[1]))
                println("stub_count\t" + to_string(r[2]))
                println("ordinal_count\t" + to_string(r[3]))
                return
            }
        }
        if sub == "cleanup" {
            cleanup_pir()
            println("cleaned: " + pir_dir())
            return
        }
        if sub == "dir" {
            println(pir_dir())
            return
        }
    }
    println("usage: hexa run pe_iat_resolve_stage2.hexa { self-test | stats | resolve <pe_path> [dll] | cleanup | dir }")
}
