// lib/loader/pe_d3d12_command_queue_real.hexa — cycle 81 R5 phase 2
// D3D12 ID3D12CommandQueue (ExecuteCommandLists/Signal/Wait) → MTLCommandQueue bridge.
//
// D3D12 ExecuteCommandLists → MTLCommandBuffer commit. Signal/Wait → MTLEvent.
// priority high → MTLCommandQueue qos:userInteractive.
// own1: D3DMetal + MSDN ID3D12CommandQueue.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 command queue tracker — 실 ID3D12CommandQueue 호출 X (D3DMetal 위임 stage).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = create
//   2 = execute_command_lists
//   3 = signal
//   4 = wait
//   5 = update_tile_mappings
//
// priority code:
//   1 = normal
//   2 = high
//   3 = global_realtime
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t cmd_list_count<int> \t priority<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdcq_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3d12_command_queue_real"
}

fn pdcq_ops_path() -> str {
    return pdcq_dir() + "/ops.tsv"
}

fn pdcq_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdcq_dir() + "'")
}

fn cleanup_pdcq() -> void {
    pdcq_ensure_dir()
    let _ = exec("rm -f '" + pdcq_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pdcq_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdcq_append_row(path: str, row: str) -> void {
    pdcq_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: command queue op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, cmd_list_count: int, priority: int) -> void {
    if op_id <= 0 {
        panic("pe_d3d12_command_queue_real FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_d3d12_command_queue_real FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 5 {
        panic("pe_d3d12_command_queue_real FAIL [record_op] expected=op_kind<=5 got=" + to_string(op_kind))
    }
    if cmd_list_count < 0 {
        panic("pe_d3d12_command_queue_real FAIL [record_op] expected=cmd_list_count>=0 got=" + to_string(cmd_list_count))
    }
    if priority < 1 {
        panic("pe_d3d12_command_queue_real FAIL [record_op] expected=priority>=1 got=" + to_string(priority))
    }
    if priority > 3 {
        panic("pe_d3d12_command_queue_real FAIL [record_op] expected=priority<=3 got=" + to_string(priority))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(cmd_list_count) + "\t" + to_string(priority) + "\n"
    pdcq_append_row(pdcq_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pdcq_read_table(pdcq_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(op_kind: int) -> int {
    let t = pdcq_read_table(pdcq_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == op_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_priority: 특정 priority 의 op 수 ───
fn count_by_priority(priority: int) -> int {
    let t = pdcq_read_table(pdcq_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == priority {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_cmd_list_count: 모든 op cmd_list_count 합 ───
fn total_cmd_list_count() -> int {
    let t = pdcq_read_table(pdcq_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── execute_count: count_by_op_kind(2) ───
fn execute_count() -> int {
    return count_by_op_kind(2)
}

// ─── op_cmd_list_count: 특정 op_id 의 cmd_list_count (없으면 0) ───
fn op_cmd_list_count(op_id: int) -> int {
    let t = pdcq_read_table(pdcq_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdcq_stats: [op_count, total_cmd_list_count, execute_count, high_priority_count] ───
fn pdcq_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_cmd_list_count())
    out.push(execute_count())
    out.push(count_by_priority(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdcq-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdcq()

    // 2. record 6 ops covering ≥3 op_kinds and ≥2 priorities
    //    op_kind: 1=create, 2=execute_command_lists, 3=signal, 4=wait, 5=update_tile_mappings
    //    priority: 1=normal, 2=high, 3=global_realtime
    record_op(330001, 1, 0, 2)
    r0_emit("pe_d3d12_command_queue_real_record",
        "\"op_id\":330001,\"op_kind\":1,\"cmd_list_count\":0,\"priority\":2,\"target\":\"MTLCommandQueue qos:userInteractive\"")

    record_op(330002, 2, 4, 2)
    r0_emit("pe_d3d12_command_queue_real_record",
        "\"op_id\":330002,\"op_kind\":2,\"cmd_list_count\":4,\"priority\":2,\"target\":\"MTLCommandBuffer commit\"")

    record_op(330003, 2, 8, 1)
    r0_emit("pe_d3d12_command_queue_real_record",
        "\"op_id\":330003,\"op_kind\":2,\"cmd_list_count\":8,\"priority\":1,\"target\":\"MTLCommandBuffer commit\"")

    record_op(330004, 3, 0, 1)
    r0_emit("pe_d3d12_command_queue_real_record",
        "\"op_id\":330004,\"op_kind\":3,\"cmd_list_count\":0,\"priority\":1,\"target\":\"MTLEvent signal\"")

    record_op(330005, 4, 0, 2)
    r0_emit("pe_d3d12_command_queue_real_record",
        "\"op_id\":330005,\"op_kind\":4,\"cmd_list_count\":0,\"priority\":2,\"target\":\"MTLEvent wait\"")

    record_op(330006, 2, 2, 3)
    r0_emit("pe_d3d12_command_queue_real_record",
        "\"op_id\":330006,\"op_kind\":2,\"cmd_list_count\":2,\"priority\":3,\"target\":\"MTLCommandBuffer commit (global_realtime)\"")

    // 3. op_count = 6
    let c = op_count()
    if c != 6 {
        panic("pe_d3d12_command_queue_real FAIL [op_count] expected=6 got=" + to_string(c))
    }

    // 4. total_cmd_list_count = 0+4+8+0+0+2 = 14
    let tcl = total_cmd_list_count()
    if tcl != 14 {
        panic("pe_d3d12_command_queue_real FAIL [total_cmd_list_count] expected=14 got=" + to_string(tcl))
    }

    // 5. count_by_op_kind sanity
    let k1 = count_by_op_kind(1)
    if k1 != 1 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_op_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 3 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_op_kind(2)] expected=3 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 1 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_op_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_op_kind(5)
    if k5 != 0 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_op_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_priority sanity
    let p1 = count_by_priority(1)
    if p1 != 2 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_priority(1)] expected=2 got=" + to_string(p1))
    }
    let p2 = count_by_priority(2)
    if p2 != 3 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_priority(2)] expected=3 got=" + to_string(p2))
    }
    let p3 = count_by_priority(3)
    if p3 != 1 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_priority(3)] expected=1 got=" + to_string(p3))
    }
    let p99 = count_by_priority(99)
    if p99 != 0 {
        panic("pe_d3d12_command_queue_real FAIL [count_by_priority(99)] expected=0 got=" + to_string(p99))
    }

    // 7. execute_count = 3
    let ec = execute_count()
    if ec != 3 {
        panic("pe_d3d12_command_queue_real FAIL [execute_count] expected=3 got=" + to_string(ec))
    }

    // 8. op_cmd_list_count sanity
    let cl3 = op_cmd_list_count(330003)
    if cl3 != 8 {
        panic("pe_d3d12_command_queue_real FAIL [op_cmd_list_count(330003)] expected=8 got=" + to_string(cl3))
    }
    let cl6 = op_cmd_list_count(330006)
    if cl6 != 2 {
        panic("pe_d3d12_command_queue_real FAIL [op_cmd_list_count(330006)] expected=2 got=" + to_string(cl6))
    }
    let cl_miss = op_cmd_list_count(9999)
    if cl_miss != 0 {
        panic("pe_d3d12_command_queue_real FAIL [op_cmd_list_count(9999)] expected=0 got=" + to_string(cl_miss))
    }

    // 9. pdcq_stats() = [6, 14, 3, 3]
    let s = pdcq_stats()
    if len(s) != 4 {
        panic("pe_d3d12_command_queue_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_d3d12_command_queue_real FAIL [stats op_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 14 {
        panic("pe_d3d12_command_queue_real FAIL [stats total_cmd_list_count] expected=14 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_d3d12_command_queue_real FAIL [stats execute_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_d3d12_command_queue_real FAIL [stats high_priority_count] expected=3 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_d3d12_command_queue_real_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_cmd_list_count\":" + to_string(s[1])
        + ",\"execute_count\":" + to_string(s[2])
        + ",\"high_priority_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_d3d12_command_queue_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdcq()
    let s2 = pdcq_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d3d12_command_queue_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3d12_command_queue_real self_test PASS (ops=" + to_string(s[0])
        + ", cmd_lists=" + to_string(s[1]) + ", executes=" + to_string(s[2])
        + ", high=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdcq_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_cmd_list_count\t" + to_string(s[1]))
            println("execute_count\t" + to_string(s[2]))
            println("high_priority_count\t" + to_string(s[3]))
            return
        }
        if sub == "cmd_list" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_cmd_list_count\t" + to_string(op_cmd_list_count(oid)))
                return
            }
            println("usage: hexa run pe_d3d12_command_queue_real.hexa cmd_list <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_d3d12_command_queue_real.hexa count <op_kind>")
            return
        }
        if sub == "priority" {
            if len(a) >= 4 {
                let pri = to_int(a[3])
                println("count_by_priority\t" + to_string(count_by_priority(pri)))
                return
            }
            println("usage: hexa run pe_d3d12_command_queue_real.hexa priority <priority>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdcq()
            println("cleaned: " + pdcq_dir())
            return
        }
        if sub == "dir" {
            println(pdcq_dir())
            return
        }
    }
    println("usage: hexa run pe_d3d12_command_queue_real.hexa { self-test | stats | cmd_list <op_id> | count <op_kind> | priority <priority> | cleanup | dir }")
}
