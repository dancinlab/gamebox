// lib/loader/pe_entry_stage2.hexa — stage2 entry point dispatch skeleton
//
// Final step in PE loader: Entry RVA + ImageBase → entry function call.
// EXE: WinMain (or main for console). DLL: DllMain (DLL_PROCESS_ATTACH).
// CRT init (msvcrt initialization) → entry → WinMain (user code).
//
// own 1: only `use "../perf/r0_common"`. Wine / community port 0 line.
// own 2: fn record_entry / count_by_kind / total_*_us / pes_stats /
//        cleanup_pes / self_test() + main() dispatch, headless,
//        panic("pe_entry_stage2 FAIL [<sub>] expected=X got=Y").
//
// Entry kind taxonomy:
//   1 = exe_winmain   (PE 의 SUBSYSTEM_WINDOWS_GUI — WinMain)
//   2 = exe_console   (PE 의 SUBSYSTEM_WINDOWS_CUI — int main)
//   3 = dll_dllmain   (PE 의 IMAGE_FILE_DLL — DllMain DLL_PROCESS_ATTACH)
//
// Schema (TSV): pe_id<int> | entry_kind<int> | crt_init_us<int> | winmain_us<int>
//
// Persist dir: $GAMEBOX_HOME/persist/pe_entry_stage2/

use "../perf/r0_common"

let PES_DIR = GAMEBOX_HOME + "/persist/pe_entry_stage2"
let ENTRY_LOG = PES_DIR + "/entries.tsv"

fn pes_dir() -> str { return PES_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + PES_DIR + "'")
}

// ─── record_entry — entry dispatch result 한 행 append ───
//   pe_id        : PE logical id (path hash 등 host 측 식별자).
//   entry_kind   : 1=exe_winmain, 2=exe_console, 3=dll_dllmain.
//   crt_init_us  : CRT (msvcrt) initialization 소요 마이크로초.
//   winmain_us   : entry function (WinMain/main/DllMain) body 소요 마이크로초.
fn record_entry(pe_id: int, entry_kind: int, crt_init_us: int, winmain_us: int) -> void {
    ensure_dir()
    let line = to_string(pe_id) + "\t" + to_string(entry_kind)
        + "\t" + to_string(crt_init_us) + "\t" + to_string(winmain_us)
    let tmp = ENTRY_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + ENTRY_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("pe_entry_stage2_record",
        "\"pe\":" + to_string(pe_id)
        + ",\"kind\":" + to_string(entry_kind)
        + ",\"crt_us\":" + to_string(crt_init_us)
        + ",\"winmain_us\":" + to_string(winmain_us))
}

// ─── entry_count — 등록된 entry 행 수 ───
fn entry_count() -> int {
    let exists = exec("test -f '" + ENTRY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + ENTRY_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── count_by_kind — entry_kind 별 행 수 ───
fn count_by_kind(kind: int) -> int {
    let exists = exec("test -f '" + ENTRY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$2==k {c++} END{print c+0}' '" + ENTRY_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_crt_init_us — 모든 entry 의 crt_init_us 합 ───
fn total_crt_init_us() -> int {
    let exists = exec("test -f '" + ENTRY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + ENTRY_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_winmain_us — 모든 entry 의 winmain_us 합 ───
fn total_winmain_us() -> int {
    let exists = exec("test -f '" + ENTRY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + ENTRY_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── pe_entry_total_us — 그 PE 의 crt_init_us + winmain_us (없으면 0) ───
fn pe_entry_total_us(pe_id: int) -> int {
    let exists = exec("test -f '" + ENTRY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v p=" + to_string(pe_id) + " '$1==p {s+=$3+$4} END{print s+0}' '" + ENTRY_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── pes_stats — [entry_count, total_crt_init_us, total_winmain_us, count_by_kind(1)] ───
fn pes_stats() -> array {
    return [entry_count(), total_crt_init_us(), total_winmain_us(), count_by_kind(1)]
}

fn cleanup_pes() -> void {
    let _ = exec("rm -rf '" + PES_DIR + "'")
}

fn self_test() -> void {
    let sid = "pes-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pes()

    // 합성 entry 3종 (Battle.net install/launch + D2R):
    //   79001 = Battle.net-Setup.exe winmain (installer GUI)
    //   79002 = Battle.net.exe winmain (post-install client)
    //   79003 = D2R.exe winmain (game)
    record_entry(79001, 1, 480000, 1200000)
    record_entry(79002, 1, 320000, 800000)
    record_entry(79003, 1, 240000, 2400000)

    // entry_count = 3
    let ec = entry_count()
    if ec != 3 { panic("pe_entry_stage2 FAIL [entry_count] expected=3 got=" + to_string(ec)) }

    // count_by_kind 분포
    let k1 = count_by_kind(1)
    if k1 != 3 { panic("pe_entry_stage2 FAIL [count_by_kind 1] expected=3 got=" + to_string(k1)) }
    let k2 = count_by_kind(2)
    if k2 != 0 { panic("pe_entry_stage2 FAIL [count_by_kind 2] expected=0 got=" + to_string(k2)) }
    let k3 = count_by_kind(3)
    if k3 != 0 { panic("pe_entry_stage2 FAIL [count_by_kind 3] expected=0 got=" + to_string(k3)) }

    // total_crt_init_us = 480000+320000+240000 = 1040000
    let tc = total_crt_init_us()
    if tc != 1040000 { panic("pe_entry_stage2 FAIL [total_crt_init_us] expected=1040000 got=" + to_string(tc)) }

    // total_winmain_us = 1200000+800000+2400000 = 4400000
    let tw = total_winmain_us()
    if tw != 4400000 { panic("pe_entry_stage2 FAIL [total_winmain_us] expected=4400000 got=" + to_string(tw)) }

    // pe_entry_total_us 개별 검증
    let p1 = pe_entry_total_us(79001)
    if p1 != 1680000 { panic("pe_entry_stage2 FAIL [pe_entry_total 79001] expected=1680000 got=" + to_string(p1)) }
    let p2 = pe_entry_total_us(79002)
    if p2 != 1120000 { panic("pe_entry_stage2 FAIL [pe_entry_total 79002] expected=1120000 got=" + to_string(p2)) }
    let p3 = pe_entry_total_us(79003)
    if p3 != 2640000 { panic("pe_entry_stage2 FAIL [pe_entry_total 79003] expected=2640000 got=" + to_string(p3)) }
    // 미등록 pe_id 는 0
    let p4 = pe_entry_total_us(9999)
    if p4 != 0 { panic("pe_entry_stage2 FAIL [pe_entry_total unknown] expected=0 got=" + to_string(p4)) }

    // pes_stats() = [3, 1040000, 4400000, 3]
    let stats = pes_stats()
    if stats[0] != 3 { panic("pe_entry_stage2 FAIL [stats entry_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 1040000 { panic("pe_entry_stage2 FAIL [stats crt_us] expected=1040000 got=" + to_string(stats[1])) }
    if stats[2] != 4400000 { panic("pe_entry_stage2 FAIL [stats winmain_us] expected=4400000 got=" + to_string(stats[2])) }
    if stats[3] != 3 { panic("pe_entry_stage2 FAIL [stats kind1] expected=3 got=" + to_string(stats[3])) }

    r0_emit("pe_entry_stage2_summary",
        "\"entries\":" + to_string(stats[0])
        + ",\"crt_us\":" + to_string(stats[1])
        + ",\"winmain_us\":" + to_string(stats[2])
        + ",\"winmain_count\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("pe_entry_stage2 FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    cleanup_pes()

    println("  ✅ pe_entry_stage2 self_test PASS (3 entries, kind1=3, crt_us=1040000, winmain_us=4400000, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = pes_stats()
            println("entries=" + to_string(s[0]) + " crt_us=" + to_string(s[1]) + " winmain_us=" + to_string(s[2]) + " winmain_count=" + to_string(s[3]))
            return
        }
        if sub == "entry" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                let us = pe_entry_total_us(pid)
                println(to_string(us))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                let c = count_by_kind(k)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_pes(); println("cleaned"); return }
    }
    println("usage: hexa run pe_entry_stage2.hexa { self-test | stats | entry <pe_id> | count <kind> | cleanup }")
}
