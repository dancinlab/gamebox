        panic("pe_oleaut32_core FAIL [record_safearray_event] expected=c_elements>=0 got=" + to_string(c_elements))
    }
    if status == "" {
        panic("pe_oleaut32_core FAIL [record_safearray_event] expected=status!=empty got=empty")
