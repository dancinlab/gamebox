// ─── record_idispatch_vtable: GetIDsOfNames/Invoke/GetTypeInfo vtable row ───
fn record_idispatch_vtable(vt_id: int, slot_kind: str, slot_addr_hex: str, dispid_synth: str, status: str) -> void {
    if vt_id <= 0 {
        panic("pe_oleaut32_core FAIL [record_idispatch_vtable] expected=vt_id>0 got=" + to_string(vt_id))
    }
    if slot_kind == "" {
        panic("pe_oleaut32_core FAIL [record_idispatch_vtable] expected=slot_kind!=empty got=empty")
    }
    if slot_addr_hex == "" {
        panic("pe_oleaut32_core FAIL [record_idispatch_vtable] expected=slot_addr_hex!=empty got=empty")
    }
    if dispid_synth == "" {
        panic("pe_oleaut32_core FAIL [record_idispatch_vtable] expected=dispid_synth!=empty got=empty")
    }
    if status == "" {
        panic("pe_oleaut32_core FAIL [record_idispatch_vtable] expected=status!=empty got=empty")
    }
    let row = to_string(vt_id) + "\t" + slot_kind + "\t" + slot_addr_hex + "\t"
        + dispid_synth + "\t" + status + "\n"
    polea_append_row(polea_idispatch_vtable_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return polea_count_rows(polea_syscall_invoke_path(), 4)
}

fn variant_event_count() -> int {
    return polea_count_rows(polea_variant_event_path(), 5)
}

fn safearray_event_count() -> int {
    return polea_count_rows(polea_safearray_event_path(), 5)
}

fn idispatch_vtable_count() -> int {
    return polea_count_rows(polea_idispatch_vtable_path(), 5)
}

fn polea_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(variant_event_count())
    out.push(safearray_event_count())
    out.push(idispatch_vtable_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "polea-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_polea()

    // ─── 1. syscall_invoke × 11 (one per fn, 3 group coverage) ───
    //   VARIANT group (4)
    record_syscall_invoke(1, 0, "VariantInit", "PARTIAL")
    println("__OLEAUT32__ PARTIAL VariantInit")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"VariantInit\",\"fn_group\":\"variant\",\"status\":\"PARTIAL\",\"variant_synth_bytes\":16,\"vt_init\":\"0x0000\",\"vt_init_kind\":\"VT_EMPTY\",\"variant_addr_hex\":\"0x80020100\"")
    record_syscall_invoke(2, 1, "VariantClear", "PARTIAL")
    println("__OLEAUT32__ PARTIAL VariantClear")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"VariantClear\",\"fn_group\":\"variant\",\"status\":\"PARTIAL\",\"variant_addr_hex\":\"0x80020100\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(3, 2, "VariantCopy", "PARTIAL")
    println("__OLEAUT32__ PARTIAL VariantCopy")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"VariantCopy\",\"fn_group\":\"variant\",\"status\":\"PARTIAL\",\"src_hex\":\"0x80020100\",\"dst_hex\":\"0x80020200\",\"vt\":\"0x0003\",\"vt_kind\":\"VT_I4\",\"value_hex\":\"7B000000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(4, 3, "VariantChangeType", "PARTIAL")
    println("__OLEAUT32__ PARTIAL VariantChangeType")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"VariantChangeType\",\"fn_group\":\"variant\",\"status\":\"PARTIAL\",\"src_vt\":\"0x0003\",\"dst_vt\":\"0x0008\",\"src_vt_kind\":\"VT_I4\",\"dst_vt_kind\":\"VT_BSTR\",\"hresult\":\"0x00000000\"")

    //   SafeArray group (4)
    record_syscall_invoke(5, 4, "SafeArrayCreate", "PARTIAL")
    println("__OLEAUT32__ PARTIAL SafeArrayCreate")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"SafeArrayCreate\",\"fn_group\":\"safearray\",\"status\":\"PARTIAL\",\"vt\":\"0x0003\",\"c_dims\":1,\"safearraybound_synth_bytes\":8,\"c_elements\":10,\"l_lbound\":0,\"sa_addr_hex\":\"0x80040000\"")
    record_syscall_invoke(6, 5, "SafeArrayDestroy", "PARTIAL")
    println("__OLEAUT32__ PARTIAL SafeArrayDestroy")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"SafeArrayDestroy\",\"fn_group\":\"safearray\",\"status\":\"PARTIAL\",\"sa_addr_hex\":\"0x80040000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(7, 6, "SafeArrayGetElement", "PARTIAL")
    println("__OLEAUT32__ PARTIAL SafeArrayGetElement")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"SafeArrayGetElement\",\"fn_group\":\"safearray\",\"status\":\"PARTIAL\",\"sa_addr_hex\":\"0x80040000\",\"index\":3,\"value_hex\":\"7B000000\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(8, 7, "SafeArrayPutElement", "PARTIAL")
    println("__OLEAUT32__ PARTIAL SafeArrayPutElement")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"SafeArrayPutElement\",\"fn_group\":\"safearray\",\"status\":\"PARTIAL\",\"sa_addr_hex\":\"0x80040000\",\"index\":5,\"value_hex\":\"FF000000\",\"hresult\":\"0x00000000\"")

    //   IDispatch group (3: vtable simulation slot 4/5/6 → GetTypeInfo/GetIDsOfNames/Invoke)
    record_syscall_invoke(9, 8, "GetIDsOfNames", "PARTIAL")
    println("__OLEAUT32__ PARTIAL GetIDsOfNames")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"GetIDsOfNames\",\"fn_group\":\"idispatch\",\"status\":\"PARTIAL\",\"vtable_slot\":5,\"vtable_addr_hex\":\"0x80010030\",\"this_hex\":\"0x80050000\",\"name_synth\":\"Save\",\"dispid_synth\":\"0x00000060\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(10, 9, "Invoke", "PARTIAL")
    println("__OLEAUT32__ PARTIAL Invoke")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"Invoke\",\"fn_group\":\"idispatch\",\"status\":\"PARTIAL\",\"vtable_slot\":6,\"vtable_addr_hex\":\"0x80010038\",\"this_hex\":\"0x80050000\",\"dispid_synth\":\"0x00000060\",\"flags\":\"0x00000001\",\"flags_kind\":\"DISPATCH_METHOD\",\"dispparams_synth_bytes\":24,\"hresult\":\"0x00000000\"")
    record_syscall_invoke(11, 10, "GetTypeInfo", "PARTIAL")
    println("__OLEAUT32__ PARTIAL GetTypeInfo")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"GetTypeInfo\",\"fn_group\":\"idispatch\",\"status\":\"PARTIAL\",\"vtable_slot\":4,\"vtable_addr_hex\":\"0x80010028\",\"this_hex\":\"0x80050000\",\"index\":0,\"lcid\":\"0x00000409\",\"type_info_out_hex\":\"0x80060000\",\"hresult\":\"0x00000000\"")

    // ─── 2. variant_event × 4 (init/clear/copy/change_type) ───
    record_variant_event(1, "v_init", "0x0000", "0000000000000000", "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"variant_event\",\"evt_id\":1,\"var_kind\":\"v_init\",\"vt\":\"0x0000\",\"vt_kind\":\"VT_EMPTY\",\"value_hex\":\"0000000000000000\",\"variant_synth_bytes\":16,\"variant_addr_hex\":\"0x80020100\",\"status\":\"PARTIAL\"")
    record_variant_event(2, "v_assign_i4", "0x0003", "7B00000000000000", "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"variant_event\",\"evt_id\":2,\"var_kind\":\"v_assign_i4\",\"vt\":\"0x0003\",\"vt_kind\":\"VT_I4\",\"value_hex\":\"7B00000000000000\",\"value_int\":123,\"status\":\"PARTIAL\"")
    record_variant_event(3, "v_assign_bstr", "0x0008", "0000028000000000", "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"variant_event\",\"evt_id\":3,\"var_kind\":\"v_assign_bstr\",\"vt\":\"0x0008\",\"vt_kind\":\"VT_BSTR\",\"bstr_ptr_hex\":\"0x80020000\",\"bstr_synth\":\"D2R\\u0000\",\"status\":\"PARTIAL\"")
    record_variant_event(4, "v_clear", "0x0000", "0000000000000000", "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"variant_event\",\"evt_id\":4,\"var_kind\":\"v_clear\",\"vt\":\"0x0000\",\"vt_kind\":\"VT_EMPTY\",\"value_hex\":\"0000000000000000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── 3. safearray_event × 4 (create/get/put/destroy) ───
    record_safearray_event(1, "sa_create", "0x80040000", 10, "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"safearray_event\",\"evt_id\":1,\"sa_kind\":\"sa_create\",\"sa_addr_hex\":\"0x80040000\",\"c_elements\":10,\"c_dims\":1,\"vt\":\"0x0003\",\"safearraybound_synth_bytes\":8,\"l_lbound\":0,\"status\":\"PARTIAL\"")
    record_safearray_event(2, "sa_put_element", "0x80040000", 10, "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"safearray_event\",\"evt_id\":2,\"sa_kind\":\"sa_put_element\",\"sa_addr_hex\":\"0x80040000\",\"c_elements\":10,\"index\":5,\"value_hex\":\"FF000000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_safearray_event(3, "sa_get_element", "0x80040000", 10, "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"safearray_event\",\"evt_id\":3,\"sa_kind\":\"sa_get_element\",\"sa_addr_hex\":\"0x80040000\",\"c_elements\":10,\"index\":3,\"value_hex\":\"7B000000\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_safearray_event(4, "sa_destroy", "0x80040000", 0, "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"safearray_event\",\"evt_id\":4,\"sa_kind\":\"sa_destroy\",\"sa_addr_hex\":\"0x80040000\",\"c_elements\":0,\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── 4. idispatch_vtable × 3 (slot 4/5/6 — GetTypeInfo/GetIDsOfNames/Invoke) ───
    record_idispatch_vtable(1, "GetTypeInfo", "0x80010028", "DISPID_VOID", "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"idispatch_vtable\",\"vt_id\":1,\"slot_kind\":\"GetTypeInfo\",\"slot_index\":4,\"slot_addr_hex\":\"0x80010028\",\"dispid_synth\":\"DISPID_VOID\",\"this_hex\":\"0x80050000\",\"status\":\"PARTIAL\"")
    record_idispatch_vtable(2, "GetIDsOfNames", "0x80010030", "0x00000060", "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"idispatch_vtable\",\"vt_id\":2,\"slot_kind\":\"GetIDsOfNames\",\"slot_index\":5,\"slot_addr_hex\":\"0x80010030\",\"dispid_synth\":\"0x00000060\",\"name_synth\":\"Save\",\"this_hex\":\"0x80050000\",\"status\":\"PARTIAL\"")
    record_idispatch_vtable(3, "Invoke", "0x80010038", "0x00000060", "PARTIAL")
    r0_emit("pe_oleaut32_core_record", "\"kind\":\"idispatch_vtable\",\"vt_id\":3,\"slot_kind\":\"Invoke\",\"slot_index\":6,\"slot_addr_hex\":\"0x80010038\",\"dispid_synth\":\"0x00000060\",\"flags\":\"DISPATCH_METHOD\",\"dispparams_synth_bytes\":24,\"this_hex\":\"0x80050000\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 11 {
        panic("pe_oleaut32_core FAIL [syscall_invoke_count] expected=11 got=" + to_string(si))
    }
    let ve = variant_event_count()
    if ve != 4 {
        panic("pe_oleaut32_core FAIL [variant_event_count] expected=4 got=" + to_string(ve))
    }
    let sae = safearray_event_count()
    if sae != 4 {
        panic("pe_oleaut32_core FAIL [safearray_event_count] expected=4 got=" + to_string(sae))
    }
    let idi = idispatch_vtable_count()
    if idi != 3 {
        panic("pe_oleaut32_core FAIL [idispatch_vtable_count] expected=3 got=" + to_string(idi))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "VariantInit" { panic("pe_oleaut32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(3) != "VariantChangeType" { panic("pe_oleaut32_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(4) != "SafeArrayCreate" { panic("pe_oleaut32_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(7) != "SafeArrayPutElement" { panic("pe_oleaut32_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(8) != "GetIDsOfNames" { panic("pe_oleaut32_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(10) != "GetTypeInfo" { panic("pe_oleaut32_core FAIL [fn_kind_name(10)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_oleaut32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "variant" { panic("pe_oleaut32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "safearray" { panic("pe_oleaut32_core FAIL [fn_group_name(4)]") }
    if fn_group_name(8) != "idispatch" { panic("pe_oleaut32_core FAIL [fn_group_name(8)]") }
    if fn_group_name(99) != "unknown" { panic("pe_oleaut32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = polea_stats()
    if len(s) != 4 { panic("pe_oleaut32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 11 { panic("pe_oleaut32_core FAIL [stats syscall_invoke_count] expected=11 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_oleaut32_core FAIL [stats variant_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_oleaut32_core FAIL [stats safearray_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_oleaut32_core FAIL [stats idispatch_vtable_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_oleaut32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"variant_event_count\":" + to_string(s[1])
        + ",\"safearray_event_count\":" + to_string(s[2])
        + ",\"idispatch_vtable_count\":" + to_string(s[3]))

    r0_emit("pe_oleaut32_core_summary",
        "\"target\":\"OLEAUT32.dll\",\"fn_total\":11,\"fn_emit_partial\":11,\"groups\":[\"variant\",\"safearray\",\"idispatch\"],\"variant_synth_bytes\":16,\"safearraybound_synth_bytes\":8,\"safearray_synth_bytes\":16,\"idispatch_vtable_slots\":3,\"vt_kinds_supported\":[\"VT_EMPTY\",\"VT_I4\",\"VT_R8\",\"VT_BSTR\"],\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_oleaut32_core_kpi",
        "\"variant_emits\":4,\"safearray_emits\":4,\"idispatch_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"automation_dependency_unblock_partial\":true")

    // ─── cycle 34 → 35 OLEAUT32 coverage progression evidence emit ───
    r0_emit("pe_oleaut32_core_coverage_progression",
        "\"surface\":\"OLEAUT32_full_435_fn\",\"cycle_34_count\":121,\"cycle_35_count\":132,\"delta\":11,\"cycle_34_percent\":27.82,\"cycle_35_percent\":30.34,\"cycle_35_module\":\"pe_oleaut32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_w4_cycle_increment\":11,\"track_w_bundled_total_delta\":53")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_oleaut32_core_round_trip_matrix",
        "\"surface\":\"OLEAUT32_core_11_fn\",\"fn_partial\":11,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real VariantInit + SafeArrayCreate + IDispatch::Invoke = NSValue + NSArray + NSObject performSelector pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"automation_layer_dependency\":\"OLEAUT32_IDispatch_Invoke_prerequisite_for_OLE_automation\"")

    // ─── Track W4 expansion emit (cycle 35, OLEAUT32 +11 fn) ───
    r0_emit("pe_oleaut32_core_w4_expansion",
        "\"track\":\"W4\",\"cycle\":35,\"surface\":\"OLEAUT32_new\",\"new_fn\":11,\"groups\":[\"variant\",\"safearray\",\"idispatch\"],\"variant_count\":4,\"safearray_count\":4,\"idispatch_count\":3,\"emit_format\":\"__OLEAUT32__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_w_bundled_complete\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_oleaut32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_polea()
    let s2 = polea_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_oleaut32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_oleaut32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", variant_event=" + to_string(s[1])
        + ", safearray_event=" + to_string(s[2]) + ", idispatch_vtable=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = polea_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("variant_event_count\t" + to_string(s[1]))
            println("safearray_event_count\t" + to_string(s[2]))
            println("idispatch_vtable_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_oleaut32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_oleaut32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_polea()
            println("cleaned: " + polea_dir())
            return
        }
        if sub == "dir" {
            println(polea_dir())
            return
        }
    }
    println("usage: hexa run pe_oleaut32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
