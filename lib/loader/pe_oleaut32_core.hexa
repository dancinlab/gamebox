// lib/loader/pe_oleaut32_core.hexa — OLEAUT32.dll IDispatch + Variant + SafeArray surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine oleaut32 source 측 코드 인용 0. oleaut32.dll 직접 binding 0. CoreFoundation
//       CFArray / CFNumber / NSValue 직접 binding 0. oaidl.h / oleauto.h reference shape 만
//       (HRESULT / VARIANT / VARTYPE / SAFEARRAY / SAFEARRAYBOUND / DISPID / DISPPARAMS). 실
//       VariantInit / 실 SafeArrayCreate / 실 GetIDsOfNames / 실 Invoke = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track W4 — OLEAUT32 (oleaut32.dll) IDispatch + Variant + SafeArray surface coverage 11 fn
// (skeleton row 만). Track W3 predecessor (OLE32 COM apartment 12 fn) 후 본 Track W4 는
// OLEAUT32 측 VARIANT marshal + SafeArray + IDispatch baseline land. cycle 34 측 121/435
// (~27.82%) → cycle 35 측 ~132/435 (~30.34%) coverage progression (+11 fn 신규, Track W bundled
// cycle 32-35 측 W4 row, 최종 row).
//
// 대상 fn (11 fn — 3 group, fn_kind 0..10 canonical map):
//   VARIANT (4):     VariantInit(0) / VariantClear(1) / VariantCopy(2) / VariantChangeType(3)
//   SafeArray (4):   SafeArrayCreate(4) / SafeArrayDestroy(5) / SafeArrayGetElement(6) /
//                    SafeArrayPutElement(7)
//   IDispatch (3):   GetIDsOfNames(8) / Invoke(9) / GetTypeInfo(10) [vtable simulation rows]
//
// synthetic VARIANT (16 byte = VARTYPE vt 2 byte + reserved1/2/3 6 byte + value 8 byte):
//   VT_I4 (3) + value LE 0x0000007B (123 decimal)
//   VT_BSTR (8) + ptr ref 0x80020000 → BSTR_synth "D2R\0" UTF-16 LE
//   VT_R8 (5) + value LE 0x401C000000000000 (7.0 double)
// synthetic SAFEARRAYBOUND (8 byte = ULONG cElements + LONG lLbound) at 0x80030000:
//   cElements 0x0000000A (10), lLbound 0x00000000.
// synthetic SAFEARRAY (16 byte = USHORT cDims + USHORT fFeatures + ULONG cbElements + ...):
//   cDims 1, fFeatures 0x0080 (FADF_HAVEVARTYPE), cbElements 4 (VT_I4 element).
// synthetic IDispatch vtable (extends IUnknown, slot 4..6): GetTypeInfoCount@0x80010020,
//   GetTypeInfo@0x80010028, GetIDsOfNames@0x80010030, Invoke@0x80010038.
// HRESULT LE: S_OK 0x00000000, DISP_E_UNKNOWNNAME 0x80020006, DISP_E_BADVARTYPE 0x80020008,
//   DISP_E_TYPEMISMATCH 0x80020005.
//
// persist schema (TSV — 4 table): syscall_invoke / variant_event / safearray_event / idispatch_vtable.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn polea_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_oleaut32_core"
}

fn polea_syscall_invoke_path() -> str {
    return polea_dir() + "/syscall_invoke.tsv"
}

fn polea_variant_event_path() -> str {
    return polea_dir() + "/variant_event.tsv"
}

fn polea_safearray_event_path() -> str {
    return polea_dir() + "/safearray_event.tsv"
}

fn polea_idispatch_vtable_path() -> str {
    return polea_dir() + "/idispatch_vtable.tsv"
}

fn polea_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + polea_dir() + "'")
}

fn cleanup_polea() -> void {
    polea_ensure_dir()
    let _ = exec("rm -f '" + polea_syscall_invoke_path() + "' '" + polea_variant_event_path()
        + "' '" + polea_safearray_event_path() + "' '" + polea_idispatch_vtable_path() + "'")
}

// ─── 공통 file IO ───
fn polea_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn polea_append_row(path: str, row: str) -> void {
    polea_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn polea_count_rows(path: str, min_cols: int) -> int {
    let t = polea_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (11 fn coverage, fn_kind 0..10) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "VariantInit" }
    if k == 1 { return "VariantClear" }
    if k == 2 { return "VariantCopy" }
    if k == 3 { return "VariantChangeType" }
    if k == 4 { return "SafeArrayCreate" }
    if k == 5 { return "SafeArrayDestroy" }
    if k == 6 { return "SafeArrayGetElement" }
    if k == 7 { return "SafeArrayPutElement" }
    if k == 8 { return "GetIDsOfNames" }
    if k == 9 { return "Invoke" }
    if k == 10 { return "GetTypeInfo" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "variant"
        }
    }
    if k >= 4 {
        if k <= 7 {
            return "safearray"
        }
    }
    if k >= 8 {
        if k <= 10 {
            return "idispatch"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: OLEAUT32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_oleaut32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_oleaut32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 10 {
        panic("pe_oleaut32_core FAIL [record_syscall_invoke] expected=fn_kind<=10 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_oleaut32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_oleaut32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    polea_append_row(polea_syscall_invoke_path(), row)
}

// ─── record_variant_event: VariantInit/Clear/Copy/ChangeType row ───
fn record_variant_event(evt_id: int, var_kind: str, vt_hex: str, value_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_oleaut32_core FAIL [record_variant_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if var_kind == "" {
        panic("pe_oleaut32_core FAIL [record_variant_event] expected=var_kind!=empty got=empty")
    }
    if vt_hex == "" {
        panic("pe_oleaut32_core FAIL [record_variant_event] expected=vt_hex!=empty got=empty")
    }
    if value_hex == "" {
        panic("pe_oleaut32_core FAIL [record_variant_event] expected=value_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_oleaut32_core FAIL [record_variant_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + var_kind + "\t" + vt_hex + "\t"
        + value_hex + "\t" + status + "\n"
    polea_append_row(polea_variant_event_path(), row)
}

// ─── record_safearray_event: SafeArrayCreate/Destroy/GetElement/PutElement row ───
fn record_safearray_event(evt_id: int, sa_kind: str, sa_addr_hex: str, c_elements: int, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_oleaut32_core FAIL [record_safearray_event] expected=evt_id>0 got=" + to_string(evt_id))
