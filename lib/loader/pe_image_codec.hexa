// lib/loader/pe_image_codec.hexa — cycle 78 PE image codec telemetry skeleton
//
// Win32 WIC IWICImagingFactory::CreateDecoderFromFilename → ImageIO bridge.
// PE bitmap / icon / texture asset 가 LoadImageW / WIC 를 통해 decode 될 때,
// host 측에선 ImageIO (CGImageSourceCreateWithURL) 로 routing. 본 module 은
// decode op tracker — 실 WIC / ImageIO 호출 X. format/size aggregate 만 기록.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// format_kind code:
//   1 = png
//   2 = jpeg
//   3 = bmp
//   4 = tiff
//   5 = gif
//   6 = webp
//   7 = heic
//
// persist schema (TSV — decodes.tsv):
//   decode_id<int> \t format_kind<int> \t width_px<int> \t height_px<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pic_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_image_codec"
}

fn pic_decodes_path() -> str {
    return pic_dir() + "/decodes.tsv"
}

fn pic_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pic_dir() + "'")
}

fn cleanup_pic() -> void {
    pic_ensure_dir()
    let _ = exec("rm -f '" + pic_decodes_path() + "'")
}

// ─── 공통 file IO ───
fn pic_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pic_append_row(path: str, row: str) -> void {
    pic_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_decode: image decode 1 건 기록 ───
fn record_decode(decode_id: int, format_kind: int, width_px: int, height_px: int) -> void {
    if decode_id <= 0 {
        panic("pe_image_codec FAIL [record_decode] expected=decode_id>0 got=" + to_string(decode_id))
    }
    if format_kind < 1 {
        panic("pe_image_codec FAIL [record_decode] expected=format_kind>=1 got=" + to_string(format_kind))
    }
    if format_kind > 7 {
        panic("pe_image_codec FAIL [record_decode] expected=format_kind<=7 got=" + to_string(format_kind))
    }
    if width_px <= 0 {
        panic("pe_image_codec FAIL [record_decode] expected=width_px>0 got=" + to_string(width_px))
    }
    if height_px <= 0 {
        panic("pe_image_codec FAIL [record_decode] expected=height_px>0 got=" + to_string(height_px))
    }
    let row = to_string(decode_id) + "\t" + to_string(format_kind)
        + "\t" + to_string(width_px) + "\t" + to_string(height_px) + "\n"
    pic_append_row(pic_decodes_path(), row)
}

// ─── decode_count: total decode 수 ───
fn decode_count() -> int {
    let t = pic_read_table(pic_decodes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_pixel_count: width_px * height_px 합 ───
fn total_pixel_count() -> int {
    let t = pic_read_table(pic_decodes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2]) * to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_format_kind: 특정 format_kind 의 decode 수 ───
fn count_by_format_kind(kind: int) -> int {
    let t = pic_read_table(pic_decodes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── largest_image: width*height 최대 decode_id (없으면 0) ───
fn largest_image() -> int {
    let t = pic_read_table(pic_decodes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut best_id = 0
    let mut best_area = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let area = to_int(parts[2]) * to_int(parts[3])
                if area > best_area {
                    best_area = area
                    best_id = to_int(parts[0])
                }
            }
        }
        i = i + 1
    }
    return best_id
}

// ─── decode_width_px: 특정 decode_id 의 width_px (없으면 0) ───
fn decode_width_px(decode_id: int) -> int {
    let t = pic_read_table(pic_decodes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == decode_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pic_stats: [decode_count, total_pixel_count, largest_image, count_by_format_kind(1)] ───
fn pic_stats() -> array {
    let mut out = []
    out.push(decode_count())
    out.push(total_pixel_count())
    out.push(largest_image())
    out.push(count_by_format_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pic-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pic()

    // 2. record 5 decodes across ≥3 format_kinds (png/jpeg/bmp/webp/heic)
    record_decode(780001, 1, 256, 256)
    r0_emit("pe_image_codec_record",
        "\"decode_id\":780001,\"format_kind\":1,\"width_px\":256,\"height_px\":256,\"target\":\"png\"")

    record_decode(780002, 2, 1920, 1080)
    r0_emit("pe_image_codec_record",
        "\"decode_id\":780002,\"format_kind\":2,\"width_px\":1920,\"height_px\":1080,\"target\":\"jpeg\"")

    record_decode(780003, 3, 64, 64)
    r0_emit("pe_image_codec_record",
        "\"decode_id\":780003,\"format_kind\":3,\"width_px\":64,\"height_px\":64,\"target\":\"bmp\"")

    record_decode(780004, 1, 512, 512)
    r0_emit("pe_image_codec_record",
        "\"decode_id\":780004,\"format_kind\":1,\"width_px\":512,\"height_px\":512,\"target\":\"png\"")

    record_decode(780005, 6, 128, 128)
    r0_emit("pe_image_codec_record",
        "\"decode_id\":780005,\"format_kind\":6,\"width_px\":128,\"height_px\":128,\"target\":\"webp\"")

    // 3. decode_count = 5
    let c = decode_count()
    if c != 5 {
        panic("pe_image_codec FAIL [decode_count] expected=5 got=" + to_string(c))
    }

    // 4. total_pixel_count = 256*256 + 1920*1080 + 64*64 + 512*512 + 128*128
    //                     = 65536 + 2073600 + 4096 + 262144 + 16384 = 2421760
    let tp = total_pixel_count()
    if tp != 2421760 {
        panic("pe_image_codec FAIL [total_pixel_count] expected=2421760 got=" + to_string(tp))
    }

    // 5. count_by_format_kind sanity
    let k1 = count_by_format_kind(1)
    if k1 != 2 {
        panic("pe_image_codec FAIL [count_by_format_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_format_kind(2)
    if k2 != 1 {
        panic("pe_image_codec FAIL [count_by_format_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_format_kind(3)
    if k3 != 1 {
        panic("pe_image_codec FAIL [count_by_format_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k6 = count_by_format_kind(6)
    if k6 != 1 {
        panic("pe_image_codec FAIL [count_by_format_kind(6)] expected=1 got=" + to_string(k6))
    }
    let k7 = count_by_format_kind(7)
    if k7 != 0 {
        panic("pe_image_codec FAIL [count_by_format_kind(7)] expected=0 got=" + to_string(k7))
    }

    // 6. largest_image = 780002 (1920*1080 = 2073600)
    let li = largest_image()
    if li != 780002 {
        panic("pe_image_codec FAIL [largest_image] expected=780002 got=" + to_string(li))
    }

    // 7. decode_width_px sanity
    let w2 = decode_width_px(780002)
    if w2 != 1920 {
        panic("pe_image_codec FAIL [decode_width_px(780002)] expected=1920 got=" + to_string(w2))
    }
    let w4 = decode_width_px(780004)
    if w4 != 512 {
        panic("pe_image_codec FAIL [decode_width_px(780004)] expected=512 got=" + to_string(w4))
    }
    let w_miss = decode_width_px(9999)
    if w_miss != 0 {
        panic("pe_image_codec FAIL [decode_width_px(9999)] expected=0 got=" + to_string(w_miss))
    }

    // 8. pic_stats() = [5, 2421760, 780002, 2]
    let s = pic_stats()
    if len(s) != 4 {
        panic("pe_image_codec FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_image_codec FAIL [stats decode_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2421760 {
        panic("pe_image_codec FAIL [stats total_pixel_count] expected=2421760 got=" + to_string(s[1]))
    }
    if s[2] != 780002 {
        panic("pe_image_codec FAIL [stats largest_image] expected=780002 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_image_codec FAIL [stats count_kind(png)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_image_codec_stats",
        "\"decode_count\":" + to_string(s[0])
        + ",\"total_pixel_count\":" + to_string(s[1])
        + ",\"largest_image\":" + to_string(s[2])
        + ",\"kind_png\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_image_codec FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pic()
    let s2 = pic_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_image_codec FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_image_codec self_test PASS (decodes=" + to_string(s[0])
        + ", pixels=" + to_string(s[1]) + ", largest=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pic_stats()
            println("decode_count\t" + to_string(s[0]))
            println("total_pixel_count\t" + to_string(s[1]))
            println("largest_image\t" + to_string(s[2]))
            println("count_kind_png\t" + to_string(s[3]))
            return
        }
        if sub == "width" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("decode_width_px\t" + to_string(decode_width_px(did)))
                return
            }
            println("usage: hexa run pe_image_codec.hexa width <decode_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_format_kind\t" + to_string(count_by_format_kind(kind)))
                return
            }
            println("usage: hexa run pe_image_codec.hexa count <format_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pic()
            println("cleaned: " + pic_dir())
            return
        }
        if sub == "dir" {
            println(pic_dir())
            return
        }
    }
    println("usage: hexa run pe_image_codec.hexa { self-test | stats | width <decode_id> | count <format_kind> | cleanup | dir }")
}
