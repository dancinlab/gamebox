// lib/loader/pe_call_conv_x64_ms.hexa — cycle68 Microsoft x64 calling convention adapter telemetry skeleton
//
// Microsoft x64 ABI: 첫 4 개 정수/포인터 인자는 RCX/RDX/R8/R9 register 로 전달,
// caller 가 register 인자에 대해서도 32-byte shadow space (4 reg slots × 8B)
// 를 stack 에 예약 (callee 가 home 영역으로 사용 가능). 나머지 인자는 그
// 위쪽 stack 으로 전달 (right-to-left, caller cleans). arm64 AAPCS adapter 는
// int_regs 를 x0..x7 로 매핑하고 shadow_bytes 는 미사용 (AAPCS 는 shadow 없음),
// stack_args 는 sp 정렬 (16B align) 후 spill.
// 본 module 은 call site adapter telemetry tracker — 실제 register read /
// stack walk 호출 X (cycle69+).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   reg/shadow/stack 분류 logic 은 Microsoft x64 ABI spec 기반 자체 구현.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// int_reg_count 범위: 0 (모두 stack) ~ 4 (RCX+RDX+R8+R9 모두 사용)
// shadow_bytes 는 항상 32 (4 × 8B) — caller 가 reg 인자 사용 여부와 무관하게 예약
// stack_args_bytes = max(0, param_count - 4) × 8 (정수/포인터 기준 8B align)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t int_reg_count<int> \t shadow_bytes<int> \t stack_args_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pccx_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_call_conv_x64_ms"
}

fn pccx_calls_path() -> str {
    return pccx_dir() + "/calls.tsv"
}

fn pccx_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pccx_dir() + "'")
}

fn cleanup_pccx() -> void {
    pccx_ensure_dir()
    let _ = exec("rm -f '" + pccx_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pccx_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pccx_append_row(path: str, row: str) -> void {
    pccx_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: x64 MS call site 1 건 기록 ───
fn record_call(call_id: int, int_reg_count: int, shadow_bytes: int, stack_args_bytes: int) -> void {
    if call_id <= 0 {
        panic("pe_call_conv_x64_ms FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if int_reg_count < 0 {
        panic("pe_call_conv_x64_ms FAIL [record_call] expected=int_reg_count>=0 got=" + to_string(int_reg_count))
    }
    if int_reg_count > 4 {
        panic("pe_call_conv_x64_ms FAIL [record_call] expected=int_reg_count<=4 got=" + to_string(int_reg_count))
    }
    if shadow_bytes != 32 {
        panic("pe_call_conv_x64_ms FAIL [record_call] expected=shadow_bytes==32 got=" + to_string(shadow_bytes))
    }
    if stack_args_bytes < 0 {
        panic("pe_call_conv_x64_ms FAIL [record_call] expected=stack_args_bytes>=0 got=" + to_string(stack_args_bytes))
    }
    let row = to_string(call_id) + "\t" + to_string(int_reg_count)
        + "\t" + to_string(shadow_bytes) + "\t" + to_string(stack_args_bytes) + "\n"
    pccx_append_row(pccx_calls_path(), row)
}

// ─── call_count: total call site 수 ───
fn call_count() -> int {
    let t = pccx_read_table(pccx_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_int_regs: 모든 call 의 int_reg_count 합 ───
fn total_int_regs() -> int {
    let t = pccx_read_table(pccx_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_shadow_bytes: 모든 call 의 shadow_bytes 합 ───
fn total_shadow_bytes() -> int {
    let t = pccx_read_table(pccx_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_stack_args_bytes: 모든 call 의 stack_args_bytes 합 ───
fn total_stack_args_bytes() -> int {
    let t = pccx_read_table(pccx_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_int_regs: 특정 int_reg_count 의 call 수 ───
fn count_by_int_regs(rc: int) -> int {
    let t = pccx_read_table(pccx_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == rc {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_stack_args_bytes: 특정 call_id 의 stack_args_bytes (없으면 0) ───
fn call_stack_args_bytes(call_id: int) -> int {
    let t = pccx_read_table(pccx_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pccx_stats: [call_count, total_int_regs, total_shadow_bytes, total_stack_args_bytes] ───
fn pccx_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_int_regs())
    out.push(total_shadow_bytes())
    out.push(total_stack_args_bytes())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pccx-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pccx()

    // 2. record 5 x64 MS call sites — int_reg_count 0..4 모두 포함, shadow=32 고정
    //   call 681001: 0 reg, shadow=32, stack=0   — void()
    //   call 681002: 1 reg, shadow=32, stack=0   — RCX only
    //   call 681003: 2 reg, shadow=32, stack=0   — RCX+RDX
    //   call 681004: 3 reg, shadow=32, stack=0   — RCX+RDX+R8
    //   call 681005: 4 reg, shadow=32, stack=16  — RCX+RDX+R8+R9 + 2 stack args (2*8B)
    record_call(681001, 0, 32, 0)
    r0_emit("pe_call_conv_x64_ms_record",
        "\"call_id\":681001,\"int_reg_count\":0,\"shadow_bytes\":32,\"stack_args_bytes\":0,\"target\":\"void\"")

    record_call(681002, 1, 32, 0)
    r0_emit("pe_call_conv_x64_ms_record",
        "\"call_id\":681002,\"int_reg_count\":1,\"shadow_bytes\":32,\"stack_args_bytes\":0,\"target\":\"rcx\"")

    record_call(681003, 2, 32, 0)
    r0_emit("pe_call_conv_x64_ms_record",
        "\"call_id\":681003,\"int_reg_count\":2,\"shadow_bytes\":32,\"stack_args_bytes\":0,\"target\":\"rcx_rdx\"")

    record_call(681004, 3, 32, 0)
    r0_emit("pe_call_conv_x64_ms_record",
        "\"call_id\":681004,\"int_reg_count\":3,\"shadow_bytes\":32,\"stack_args_bytes\":0,\"target\":\"rcx_rdx_r8\"")

    record_call(681005, 4, 32, 16)
    r0_emit("pe_call_conv_x64_ms_record",
        "\"call_id\":681005,\"int_reg_count\":4,\"shadow_bytes\":32,\"stack_args_bytes\":16,\"target\":\"rcx_rdx_r8_r9_stk2\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("pe_call_conv_x64_ms FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. total_int_regs = 0+1+2+3+4 = 10
    let tir = total_int_regs()
    if tir != 10 {
        panic("pe_call_conv_x64_ms FAIL [total_int_regs] expected=10 got=" + to_string(tir))
    }

    // 5. total_shadow_bytes = 5 * 32 = 160
    let tsb = total_shadow_bytes()
    if tsb != 160 {
        panic("pe_call_conv_x64_ms FAIL [total_shadow_bytes] expected=160 got=" + to_string(tsb))
    }

    // 6. total_stack_args_bytes = 0+0+0+0+16 = 16
    let tsa = total_stack_args_bytes()
    if tsa != 16 {
        panic("pe_call_conv_x64_ms FAIL [total_stack_args_bytes] expected=16 got=" + to_string(tsa))
    }

    // 7. count_by_int_regs sanity
    let r0 = count_by_int_regs(0)
    if r0 != 1 {
        panic("pe_call_conv_x64_ms FAIL [count_by_int_regs(0)] expected=1 got=" + to_string(r0))
    }
    let r1 = count_by_int_regs(1)
    if r1 != 1 {
        panic("pe_call_conv_x64_ms FAIL [count_by_int_regs(1)] expected=1 got=" + to_string(r1))
    }
    let r2 = count_by_int_regs(2)
    if r2 != 1 {
        panic("pe_call_conv_x64_ms FAIL [count_by_int_regs(2)] expected=1 got=" + to_string(r2))
    }
    let r3 = count_by_int_regs(3)
    if r3 != 1 {
        panic("pe_call_conv_x64_ms FAIL [count_by_int_regs(3)] expected=1 got=" + to_string(r3))
    }
    let r4 = count_by_int_regs(4)
    if r4 != 1 {
        panic("pe_call_conv_x64_ms FAIL [count_by_int_regs(4)] expected=1 got=" + to_string(r4))
    }
    let r99 = count_by_int_regs(99)
    if r99 != 0 {
        panic("pe_call_conv_x64_ms FAIL [count_by_int_regs(99)] expected=0 got=" + to_string(r99))
    }

    // 8. call_stack_args_bytes sanity
    let sa5 = call_stack_args_bytes(681005)
    if sa5 != 16 {
        panic("pe_call_conv_x64_ms FAIL [call_stack_args_bytes(681005)] expected=16 got=" + to_string(sa5))
    }
    let sa3 = call_stack_args_bytes(681003)
    if sa3 != 0 {
        panic("pe_call_conv_x64_ms FAIL [call_stack_args_bytes(681003)] expected=0 got=" + to_string(sa3))
    }
    let sa_miss = call_stack_args_bytes(9999)
    if sa_miss != 0 {
        panic("pe_call_conv_x64_ms FAIL [call_stack_args_bytes(9999)] expected=0 got=" + to_string(sa_miss))
    }

    // 9. pccx_stats() = [5, 10, 160, 16]
    let s = pccx_stats()
    if len(s) != 4 {
        panic("pe_call_conv_x64_ms FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_call_conv_x64_ms FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 10 {
        panic("pe_call_conv_x64_ms FAIL [stats total_int_regs] expected=10 got=" + to_string(s[1]))
    }
    if s[2] != 160 {
        panic("pe_call_conv_x64_ms FAIL [stats total_shadow_bytes] expected=160 got=" + to_string(s[2]))
    }
    if s[3] != 16 {
        panic("pe_call_conv_x64_ms FAIL [stats total_stack_args_bytes] expected=16 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_call_conv_x64_ms_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_int_regs\":" + to_string(s[1])
        + ",\"total_shadow_bytes\":" + to_string(s[2])
        + ",\"total_stack_args_bytes\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_call_conv_x64_ms FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pccx()
    let s2 = pccx_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_call_conv_x64_ms FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_call_conv_x64_ms self_test PASS (calls=" + to_string(s[0])
        + ", int_regs=" + to_string(s[1]) + ", shadow=" + to_string(s[2])
        + ", stack=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pccx_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_int_regs\t" + to_string(s[1]))
            println("total_shadow_bytes\t" + to_string(s[2]))
            println("total_stack_args_bytes\t" + to_string(s[3]))
            return
        }
        if sub == "stack" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_stack_args_bytes\t" + to_string(call_stack_args_bytes(cid)))
                return
            }
            println("usage: hexa run pe_call_conv_x64_ms.hexa stack <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let rc = to_int(a[3])
                println("count_by_int_regs\t" + to_string(count_by_int_regs(rc)))
                return
            }
            println("usage: hexa run pe_call_conv_x64_ms.hexa count <int_regs>")
            return
        }
        if sub == "cleanup" {
            cleanup_pccx()
            println("cleaned: " + pccx_dir())
            return
        }
        if sub == "dir" {
            println(pccx_dir())
            return
        }
    }
    println("usage: hexa run pe_call_conv_x64_ms.hexa { self-test | stats | stack <call_id> | count <int_regs> | cleanup | dir }")
}
