// lib/loader/pe_xaudio2_voice.hexa — XAudio2 voice → AVAudioEngine bridge skeleton
//
// XAudio2 IXAudio2SourceVoice / IXAudio2SubmixVoice / IXAudio2MasteringVoice →
// macOS AVAudioEngine voice bridge telemetry. docker hexa 측은 voice 등록 +
// sample_rate / channels 집계만 담당 (실 audio frame 송출은 native helper).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 voice tracker — 실 IXAudio2 COM 호출 X (stage6 native bridge).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// voice_kind code:
//   1 = source     (IXAudio2SourceVoice)
//   2 = submix     (IXAudio2SubmixVoice)
//   3 = mastering  (IXAudio2MasteringVoice)
//
// persist schema (TSV — voices.tsv):
//   voice_id<int> \t voice_kind<int> \t sample_rate<int> \t channels<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pxv_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_xaudio2_voice"
}

fn pxv_voices_path() -> str {
    return pxv_dir() + "/voices.tsv"
}

fn pxv_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pxv_dir() + "'")
}

fn cleanup_pxv() -> void {
    pxv_ensure_dir()
    let _ = exec("rm -f '" + pxv_voices_path() + "'")
}

// ─── 공통 file IO ───
fn pxv_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pxv_append_row(path: str, row: str) -> void {
    pxv_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_voice: voice 1 건 등록 ───
fn record_voice(voice_id: int, voice_kind: int, sample_rate: int, channels: int) -> void {
    if voice_id <= 0 {
        panic("pe_xaudio2_voice FAIL [record_voice] expected=voice_id>0 got=" + to_string(voice_id))
    }
    if voice_kind < 1 {
        panic("pe_xaudio2_voice FAIL [record_voice] expected=voice_kind>=1 got=" + to_string(voice_kind))
    }
    if voice_kind > 3 {
        panic("pe_xaudio2_voice FAIL [record_voice] expected=voice_kind<=3 got=" + to_string(voice_kind))
    }
    if sample_rate < 0 {
        panic("pe_xaudio2_voice FAIL [record_voice] expected=sample_rate>=0 got=" + to_string(sample_rate))
    }
    if channels < 0 {
        panic("pe_xaudio2_voice FAIL [record_voice] expected=channels>=0 got=" + to_string(channels))
    }
    let row = to_string(voice_id) + "\t" + to_string(voice_kind)
        + "\t" + to_string(sample_rate) + "\t" + to_string(channels) + "\n"
    pxv_append_row(pxv_voices_path(), row)
}

// ─── voice_count: 등록된 voice 수 ───
fn voice_count() -> int {
    let t = pxv_read_table(pxv_voices_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_sample_rate: 모든 voice sample_rate 합 ───
fn total_sample_rate() -> int {
    let t = pxv_read_table(pxv_voices_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_channels: 모든 voice channels 합 ───
fn total_channels() -> int {
    let t = pxv_read_table(pxv_voices_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_voice_kind: 특정 voice_kind 의 voice 수 ───
fn count_by_voice_kind(kind: int) -> int {
    let t = pxv_read_table(pxv_voices_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── voice_sample_rate: 특정 voice_id 의 sample_rate (없으면 0) ───
fn voice_sample_rate(voice_id: int) -> int {
    let t = pxv_read_table(pxv_voices_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == voice_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pxv_stats: [voice_count, total_sample_rate, total_channels, count_by_voice_kind(1)] ───
fn pxv_stats() -> array {
    let mut out = []
    out.push(voice_count())
    out.push(total_sample_rate())
    out.push(total_channels())
    out.push(count_by_voice_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pxv-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pxv()

    // 2. record 5 voices across all 3 voice_kinds
    record_voice(220001, 1, 44100, 2)
    r0_emit("pe_xaudio2_voice_record",
        "\"voice_id\":220001,\"voice_kind\":1,\"sample_rate\":44100,\"channels\":2,\"target\":\"source\"")

    record_voice(220002, 1, 48000, 2)
    r0_emit("pe_xaudio2_voice_record",
        "\"voice_id\":220002,\"voice_kind\":1,\"sample_rate\":48000,\"channels\":2,\"target\":\"source\"")

    record_voice(220003, 1, 22050, 1)
    r0_emit("pe_xaudio2_voice_record",
        "\"voice_id\":220003,\"voice_kind\":1,\"sample_rate\":22050,\"channels\":1,\"target\":\"source\"")

    record_voice(220004, 2, 48000, 2)
    r0_emit("pe_xaudio2_voice_record",
        "\"voice_id\":220004,\"voice_kind\":2,\"sample_rate\":48000,\"channels\":2,\"target\":\"submix\"")

    record_voice(220005, 3, 48000, 6)
    r0_emit("pe_xaudio2_voice_record",
        "\"voice_id\":220005,\"voice_kind\":3,\"sample_rate\":48000,\"channels\":6,\"target\":\"mastering\"")

    // 3. voice_count = 5
    let c = voice_count()
    if c != 5 {
        panic("pe_xaudio2_voice FAIL [voice_count] expected=5 got=" + to_string(c))
    }

    // 4. total_sample_rate = 44100 + 48000 + 22050 + 48000 + 48000 = 210150
    let tsr = total_sample_rate()
    if tsr != 210150 {
        panic("pe_xaudio2_voice FAIL [total_sample_rate] expected=210150 got=" + to_string(tsr))
    }

    // 5. total_channels = 2 + 2 + 1 + 2 + 6 = 13
    let tc = total_channels()
    if tc != 13 {
        panic("pe_xaudio2_voice FAIL [total_channels] expected=13 got=" + to_string(tc))
    }

    // 6. count_by_voice_kind sanity
    let k1 = count_by_voice_kind(1)
    if k1 != 3 {
        panic("pe_xaudio2_voice FAIL [count_by_voice_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_voice_kind(2)
    if k2 != 1 {
        panic("pe_xaudio2_voice FAIL [count_by_voice_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_voice_kind(3)
    if k3 != 1 {
        panic("pe_xaudio2_voice FAIL [count_by_voice_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k99 = count_by_voice_kind(99)
    if k99 != 0 {
        panic("pe_xaudio2_voice FAIL [count_by_voice_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. voice_sample_rate sanity
    let r2 = voice_sample_rate(220002)
    if r2 != 48000 {
        panic("pe_xaudio2_voice FAIL [voice_sample_rate(220002)] expected=48000 got=" + to_string(r2))
    }
    let r3 = voice_sample_rate(220003)
    if r3 != 22050 {
        panic("pe_xaudio2_voice FAIL [voice_sample_rate(220003)] expected=22050 got=" + to_string(r3))
    }
    let r_miss = voice_sample_rate(9999)
    if r_miss != 0 {
        panic("pe_xaudio2_voice FAIL [voice_sample_rate(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 8. pxv_stats() = [5, 210150, 13, 3]
    let s = pxv_stats()
    if len(s) != 4 {
        panic("pe_xaudio2_voice FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_xaudio2_voice FAIL [stats voice_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 210150 {
        panic("pe_xaudio2_voice FAIL [stats total_sample_rate] expected=210150 got=" + to_string(s[1]))
    }
    if s[2] != 13 {
        panic("pe_xaudio2_voice FAIL [stats total_channels] expected=13 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_xaudio2_voice FAIL [stats count_kind(1)] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_xaudio2_voice_stats",
        "\"voice_count\":" + to_string(s[0])
        + ",\"total_sample_rate\":" + to_string(s[1])
        + ",\"total_channels\":" + to_string(s[2])
        + ",\"kind_source\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_xaudio2_voice FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pxv()
    let s2 = pxv_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_xaudio2_voice FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_xaudio2_voice self_test PASS (voices=" + to_string(s[0])
        + ", sample_rate=" + to_string(s[1]) + ", channels=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pxv_stats()
            println("voice_count\t" + to_string(s[0]))
            println("total_sample_rate\t" + to_string(s[1]))
            println("total_channels\t" + to_string(s[2]))
            println("count_kind_source\t" + to_string(s[3]))
            return
        }
        if sub == "rate" {
            if len(a) >= 4 {
                let vid = to_int(a[3])
                println("voice_sample_rate\t" + to_string(voice_sample_rate(vid)))
                return
            }
            println("usage: hexa run pe_xaudio2_voice.hexa rate <voice_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_voice_kind\t" + to_string(count_by_voice_kind(kind)))
                return
            }
            println("usage: hexa run pe_xaudio2_voice.hexa count <voice_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pxv()
            println("cleaned: " + pxv_dir())
            return
        }
        if sub == "dir" {
            println(pxv_dir())
            return
        }
    }
    println("usage: hexa run pe_xaudio2_voice.hexa { self-test | stats | rate <voice_id> | count <voice_kind> | cleanup | dir }")
}
