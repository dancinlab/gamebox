// lib/loader/pe_skeleton_phase_status.hexa — cycle 64-82 모듈 phase status 추적기
//
// Skeleton phase status tracker (cycle 64-82 ~250 모듈 dashboard):
//   phase 1 skeleton              — TSV 추적만, 실 syscall X
//   phase 2 real_invoke           — IPC frame 호출 path 정의 (cycle 80+ '_real' 모듈)
//   phase 3 external_dep_helper   — helper.mm 패치 + Xcode build 필요
//   phase 4 external_dep_codesign — ad-hoc codesign + entitlement plist 필요
//   phase 5 external_dep_d3dmetal — Apple D3DMetal binary link 필요
//   phase 6 blocked_by_external   — kernel-mode anti-cheat 등 차단 영역
//   self_test 는 sample 8 모듈 manual entry — 실 250 모듈은 별도 운영 cycle
// own1: 자체 dashboard, third-party CMS 인용 X
//
// own 1 enforcement: Wine / CrossOver / community / GPTK / Whisky 0 줄 — 본 모듈은
//   phase status 추적기일 뿐, 실 외부 의존성 link X.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = skeleton
//   2 = real_invoke
//   3 = external_dep_helper
//   4 = external_dep_codesign
//   5 = external_dep_d3dmetal
//   6 = blocked_by_external
//
// category_kind code:
//   1 = ipc, 2 = memory, 3 = perf, 4 = abi, 5 = nt, 6 = seh,
//   7 = sync, 8 = runtime, 9 = fs, 10 = proc, 11 = net, 12 = dx,
//   13 = com, 14 = gdi, 15 = i18n, 16 = stage7, 17 = game_specific, 18 = other
//
// persist schema (TSV — modules.tsv):
//   module_id<str> \t phase_kind<int> \t category_kind<int> \t elevated_priority<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn psps_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_skeleton_phase_status"
}

fn psps_modules_path() -> str {
    return psps_dir() + "/modules.tsv"
}

fn psps_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + psps_dir() + "'")
}

fn cleanup_psps() -> void {
    psps_ensure_dir()
    let _ = exec("rm -f '" + psps_modules_path() + "'")
}

// ─── 공통 file IO ───
fn psps_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn psps_append_row(path: str, row: str) -> void {
    psps_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_module: module phase 1 건 기록 ───
fn record_module(module_id: str, phase_kind: int, category_kind: int, elevated_priority: int) -> void {
    if module_id == "" {
        panic("pe_skeleton_phase_status FAIL [record_module] expected=module_id!=\"\" got=\"\"")
    }
    if phase_kind < 1 {
        panic("pe_skeleton_phase_status FAIL [record_module] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 6 {
        panic("pe_skeleton_phase_status FAIL [record_module] expected=phase_kind<=6 got=" + to_string(phase_kind))
    }
    if category_kind < 1 {
        panic("pe_skeleton_phase_status FAIL [record_module] expected=category_kind>=1 got=" + to_string(category_kind))
    }
    if category_kind > 18 {
        panic("pe_skeleton_phase_status FAIL [record_module] expected=category_kind<=18 got=" + to_string(category_kind))
    }
    if elevated_priority < 0 {
        panic("pe_skeleton_phase_status FAIL [record_module] expected=elevated_priority>=0 got=" + to_string(elevated_priority))
    }
    if elevated_priority > 1 {
        panic("pe_skeleton_phase_status FAIL [record_module] expected=elevated_priority<=1 got=" + to_string(elevated_priority))
    }
    let row = module_id + "\t" + to_string(phase_kind)
        + "\t" + to_string(category_kind) + "\t" + to_string(elevated_priority) + "\n"
    psps_append_row(psps_modules_path(), row)
}

// ─── module_count: total module 수 ───
fn module_count() -> int {
    let t = psps_read_table(psps_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 module 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = psps_read_table(psps_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_category_kind: 특정 category_kind 의 module 수 ───
fn count_by_category_kind(category_kind: int) -> int {
    let t = psps_read_table(psps_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == category_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── external_dep_count: phase 3 + 4 + 5 합 ───
fn external_dep_count() -> int {
    return count_by_phase_kind(3) + count_by_phase_kind(4) + count_by_phase_kind(5)
}

// ─── elevated_priority_count: elevated_priority=1 인 module 수 ───
fn elevated_priority_count() -> int {
    let t = psps_read_table(psps_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── blocked_count: phase 6 ───
fn blocked_count() -> int {
    return count_by_phase_kind(6)
}

// ─── psps_stats: [module_count, external_dep_count, blocked_count, elevated_priority_count] ───
fn psps_stats() -> array {
    let mut out = []
    out.push(module_count())
    out.push(external_dep_count())
    out.push(blocked_count())
    out.push(elevated_priority_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "psps-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_psps()

    // 2. record 8 modules — covers 6 phase_kinds and 6 category_kinds
    //    (phase 1,2,3,4,5,6 all hit; category 1,2,4,12,16,17 all hit)

    // M1: skeleton / ipc / non-priority
    record_module("pe_ipc_unix_socket", 1, 1, 0)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_ipc_unix_socket\",\"phase_kind\":1,\"category_kind\":1,\"elevated_priority\":0")

    // M2: skeleton / memory / non-priority
    record_module("pe_virtual_alloc", 1, 2, 0)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_virtual_alloc\",\"phase_kind\":1,\"category_kind\":2,\"elevated_priority\":0")

    // M3: real_invoke / abi / priority
    record_module("pe_call_conv_x64_ms_real", 2, 4, 1)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_call_conv_x64_ms_real\",\"phase_kind\":2,\"category_kind\":4,\"elevated_priority\":1")

    // M4: external_dep_helper / dx / priority
    record_module("pe_dx_d3d11_helper", 3, 12, 1)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_dx_d3d11_helper\",\"phase_kind\":3,\"category_kind\":12,\"elevated_priority\":1")

    // M5: external_dep_codesign / dx / priority
    record_module("pe_dx_codesign_metal", 4, 12, 1)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_dx_codesign_metal\",\"phase_kind\":4,\"category_kind\":12,\"elevated_priority\":1")

    // M6: external_dep_d3dmetal / dx / priority
    record_module("pe_d3dmetal_link", 5, 12, 1)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_d3dmetal_link\",\"phase_kind\":5,\"category_kind\":12,\"elevated_priority\":1")

    // M7: blocked_by_external / game_specific / non-priority
    record_module("pe_anti_cheat_kernel_block", 6, 17, 0)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_anti_cheat_kernel_block\",\"phase_kind\":6,\"category_kind\":17,\"elevated_priority\":0")

    // M8: skeleton / stage7 / non-priority
    record_module("pe_stage7_inventory", 1, 16, 0)
    r0_emit("pe_skeleton_phase_status_record",
        "\"module_id\":\"pe_stage7_inventory\",\"phase_kind\":1,\"category_kind\":16,\"elevated_priority\":0")

    // 3. module_count = 8
    let mc = module_count()
    if mc != 8 {
        panic("pe_skeleton_phase_status FAIL [module_count] expected=8 got=" + to_string(mc))
    }

    // 4. count_by_phase_kind sanity (≥5 phase_kinds present)
    let p1 = count_by_phase_kind(1)
    if p1 != 3 {
        panic("pe_skeleton_phase_status FAIL [count_by_phase_kind(1)] expected=3 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p6 = count_by_phase_kind(6)
    if p6 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(p6))
    }
    let p_miss = count_by_phase_kind(99)
    if p_miss != 0 {
        panic("pe_skeleton_phase_status FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p_miss))
    }

    // 5. count_by_category_kind sanity (≥5 category_kinds present)
    let c1 = count_by_category_kind(1)
    if c1 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_category_kind(1)] expected=1 got=" + to_string(c1))
    }
    let c2 = count_by_category_kind(2)
    if c2 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_category_kind(2)] expected=1 got=" + to_string(c2))
    }
    let c4 = count_by_category_kind(4)
    if c4 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_category_kind(4)] expected=1 got=" + to_string(c4))
    }
    let c12 = count_by_category_kind(12)
    if c12 != 3 {
        panic("pe_skeleton_phase_status FAIL [count_by_category_kind(12)] expected=3 got=" + to_string(c12))
    }
    let c16 = count_by_category_kind(16)
    if c16 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_category_kind(16)] expected=1 got=" + to_string(c16))
    }
    let c17 = count_by_category_kind(17)
    if c17 != 1 {
        panic("pe_skeleton_phase_status FAIL [count_by_category_kind(17)] expected=1 got=" + to_string(c17))
    }
    let c_miss = count_by_category_kind(7)
    if c_miss != 0 {
        panic("pe_skeleton_phase_status FAIL [count_by_category_kind(7)] expected=0 got=" + to_string(c_miss))
    }

    // 6. external_dep_count = 3 (phase 3+4+5)
    let edc = external_dep_count()
    if edc != 3 {
        panic("pe_skeleton_phase_status FAIL [external_dep_count] expected=3 got=" + to_string(edc))
    }

    // 7. blocked_count = 1
    let bc = blocked_count()
    if bc != 1 {
        panic("pe_skeleton_phase_status FAIL [blocked_count] expected=1 got=" + to_string(bc))
    }

    // 8. elevated_priority_count = 4 (M3,M4,M5,M6)
    let epc = elevated_priority_count()
    if epc != 4 {
        panic("pe_skeleton_phase_status FAIL [elevated_priority_count] expected=4 got=" + to_string(epc))
    }

    // 9. psps_stats() = [8, 3, 1, 4]
    let s = psps_stats()
    if len(s) != 4 {
        panic("pe_skeleton_phase_status FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_skeleton_phase_status FAIL [stats module_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_skeleton_phase_status FAIL [stats external_dep] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_skeleton_phase_status FAIL [stats blocked] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 4 {
        panic("pe_skeleton_phase_status FAIL [stats elevated_priority] expected=4 got=" + to_string(s[3]))
    }

    // 10. emit aggregate stats
    r0_emit("pe_skeleton_phase_status_stats",
        "\"module_count\":" + to_string(s[0])
        + ",\"external_dep_count\":" + to_string(s[1])
        + ",\"blocked_count\":" + to_string(s[2])
        + ",\"elevated_priority_count\":" + to_string(s[3]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_skeleton_phase_status FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_psps()
    let s2 = psps_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_skeleton_phase_status FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_skeleton_phase_status self_test PASS (modules=" + to_string(s[0])
        + ", external_dep=" + to_string(s[1]) + ", blocked=" + to_string(s[2])
        + ", elevated=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = psps_stats()
            println("module_count\t" + to_string(s[0]))
            println("external_dep_count\t" + to_string(s[1]))
            println("blocked_count\t" + to_string(s[2]))
            println("elevated_priority_count\t" + to_string(s[3]))
            return
        }
        if sub == "category" {
            if len(a) >= 4 {
                let mid = a[3]
                let t = psps_read_table(psps_modules_path())
                if t == "" {
                    println("category\t0")
                    return
                }
                let lines = t.split("\n")
                let n = len(lines)
                let i = 0
                while i < n {
                    let line = lines[i]
                    if line != "" {
                        let parts = line.split("\t")
                        if len(parts) >= 4 {
                            if parts[0] == mid {
                                println("category\t" + parts[2])
                                return
                            }
                        }
                    }
                    i = i + 1
                }
                println("category\t0")
                return
            }
            println("usage: hexa run pe_skeleton_phase_status.hexa category <module_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let val = to_int(a[4])
                if dim == "phase" {
                    println("count_by_phase_kind\t" + to_string(count_by_phase_kind(val)))
                    return
                }
                if dim == "cat" {
                    println("count_by_category_kind\t" + to_string(count_by_category_kind(val)))
                    return
                }
                println("usage: hexa run pe_skeleton_phase_status.hexa count { phase | cat } <kind>")
                return
            }
            println("usage: hexa run pe_skeleton_phase_status.hexa count { phase | cat } <kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_psps()
            println("cleaned: " + psps_dir())
            return
        }
        if sub == "dir" {
            println(psps_dir())
            return
        }
    }
    println("usage: hexa run pe_skeleton_phase_status.hexa { self-test | stats | category <module_id> | count phase <phase_kind> | count cat <category_kind> | cleanup | dir }")
}
