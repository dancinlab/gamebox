    record_ldr_event(2, "ldr_get_proc", "LdrGetProcedureAddress", "0008010000000000", "PARTIAL")
    r0_emit("pe_ntdll_core_record", "\"kind\":\"ldr_event\",\"evt_id\":2,\"ldr_kind\":\"ldr_get_proc\",\"fn_name\":\"LdrGetProcedureAddress\",\"dll_handle_hex\":\"0x60000600\",\"proc_name_synth\":\"CreateFileW\",\"proc_addr_hex\":\"0x60010800\",\"ntstatus\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_ldr_event(3, "ldr_unload", "LdrUnloadDll", "0006000000000000", "PARTIAL")
    r0_emit("pe_ntdll_core_record", "\"kind\":\"ldr_event\",\"evt_id\":3,\"ldr_kind\":\"ldr_unload\",\"fn_name\":\"LdrUnloadDll\",\"dll_handle_hex\":\"0x60000600\",\"ntstatus\":\"0x00000000\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 15 {
        panic("pe_ntdll_core FAIL [syscall_invoke_count] expected=15 got=" + to_string(si))
    }
    let ni = nt_io_round_trip_count()
    if ni != 4 {
        panic("pe_ntdll_core FAIL [nt_io_round_trip_count] expected=4 got=" + to_string(ni))
    }
    let rl = rtl_lifecycle_count()
    if rl != 4 {
        panic("pe_ntdll_core FAIL [rtl_lifecycle_count] expected=4 got=" + to_string(rl))
    }
    let le = ldr_event_count()
    if le != 3 {
        panic("pe_ntdll_core FAIL [ldr_event_count] expected=3 got=" + to_string(le))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "NtCreateFile" { panic("pe_ntdll_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(7) != "NtFreeVirtualMemory" { panic("pe_ntdll_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(8) != "RtlInitUnicodeString" { panic("pe_ntdll_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(11) != "RtlGetLastWin32Error" { panic("pe_ntdll_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(12) != "LdrLoadDll" { panic("pe_ntdll_core FAIL [fn_kind_name(12)]") }
    if fn_kind_name(14) != "LdrUnloadDll" { panic("pe_ntdll_core FAIL [fn_kind_name(14)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_ntdll_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "nt_core" { panic("pe_ntdll_core FAIL [fn_group_name(0)]") }
    if fn_group_name(8) != "rtl_utility" { panic("pe_ntdll_core FAIL [fn_group_name(8)]") }
    if fn_group_name(12) != "ldr" { panic("pe_ntdll_core FAIL [fn_group_name(12)]") }
    if fn_group_name(99) != "unknown" { panic("pe_ntdll_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pntdll_stats()
    if len(s) != 4 { panic("pe_ntdll_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 15 { panic("pe_ntdll_core FAIL [stats syscall_invoke_count] expected=15 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_ntdll_core FAIL [stats nt_io_round_trip_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_ntdll_core FAIL [stats rtl_lifecycle_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_ntdll_core FAIL [stats ldr_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_ntdll_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"nt_io_round_trip_count\":" + to_string(s[1])
        + ",\"rtl_lifecycle_count\":" + to_string(s[2])
        + ",\"ldr_event_count\":" + to_string(s[3]))

    r0_emit("pe_ntdll_core_summary",
        "\"target\":\"NTDLL.dll\",\"fn_total\":15,\"fn_emit_partial\":15,\"groups\":[\"nt_core\",\"rtl_utility\",\"ldr\"],\"file_handle_synth\":\"0x40000400\",\"heap_handle_synth\":\"0x50000500\",\"dll_handle_synth\":\"0x60000600\",\"unicode_string_synth_bytes\":8,\"object_attributes_synth_bytes\":24,\"io_status_block_synth_bytes\":16,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_ntdll_core_kpi",
        "\"nt_core_emits\":8,\"rtl_utility_emits\":4,\"ldr_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"ntdll_bridge_to_macos_posix\":\"pending_separate_cycle\"")

    // ─── cycle 31 → 33 NTDLL coverage progression evidence emit ───
    r0_emit("pe_ntdll_core_coverage_progression",
        "\"surface\":\"NTDLL_full_435_fn\",\"cycle_31_count\":79,\"cycle_33_count\":109,\"delta\":15,\"cycle_31_percent\":18.16,\"cycle_33_percent\":25.06,\"cycle_33_module\":\"pe_ntdll_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_w2_cycle_increment\":15")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_ntdll_core_round_trip_matrix",
        "\"surface\":\"NTDLL_core_15_fn\",\"fn_partial\":15,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real NtCreateFile + NtReadFile + RtlAllocateHeap + LdrLoadDll = macOS posix syscall pass-through pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"track_w2_direct_predecessor\":\"track_w1_kernel32_extend\"")

    // ─── Track W2 expansion emit (cycle 33, NTDLL +15 fn) ───
    r0_emit("pe_ntdll_core_w2_expansion",
        "\"track\":\"W2\",\"cycle\":33,\"surface\":\"NTDLL_new\",\"new_fn\":15,\"groups\":[\"nt_core\",\"rtl_utility\",\"ldr\"],\"nt_core_count\":8,\"rtl_utility_count\":4,\"ldr_count\":3,\"emit_format\":\"__NTDLL__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_3_evidence_augment\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_ntdll_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pntdll()
    let s2 = pntdll_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ntdll_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ntdll_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", nt_io_round_trip=" + to_string(s[1])
        + ", rtl_lifecycle=" + to_string(s[2]) + ", ldr_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pntdll_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("nt_io_round_trip_count\t" + to_string(s[1]))
            println("rtl_lifecycle_count\t" + to_string(s[2]))
            println("ldr_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_ntdll_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_ntdll_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pntdll()
            println("cleaned: " + pntdll_dir())
            return
        }
        if sub == "dir" {
            println(pntdll_dir())
            return
        }
    }
    println("usage: hexa run pe_ntdll_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
