// lib/loader/pe_ntdll_core.hexa — NTDLL.dll Nt*/Rtl*/Ldr core syscall surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine ntdll source 측 코드 인용 0. ntdll.dll 직접 binding 0. winternl.h / ntstatus.h /
//       ntdef.h reference shape 만 (NTSTATUS / UNICODE_STRING / OBJECT_ATTRIBUTES /
//       IO_STATUS_BLOCK / HANDLE / PVOID). 실 NtCreateFile / 실 NtReadFile / 실 RtlAllocateHeap /
//       실 LdrLoadDll = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track W2 — NTDLL (ntdll.dll) Nt*/Rtl*/Ldr core syscall bridge surface coverage 15 fn (skeleton row).
// Track Q predecessor (USER32 + GDI32 + ADVAPI32) 후 본 Track W2 는 NTDLL Nt* core syscall bridge
// 측 baseline land — kernel32 → ntdll → macOS posix syscall pass-through 측 hexa-native 측
// indirect skeleton. cycle 31 측 79/435 (~18.16%) → cycle 33 측 ~109/435 (~25.06%) coverage
// progression (+15 fn 신규, Track W bundled 4-cycle 측 W2 row). Track K mirror style (3 network DLL
// skeleton-tier) + Track O mirror style (KERNEL32 18 fn 4 group baseline).
//
// 대상 fn (15 fn — 3 group, fn_kind 0..14 canonical map):
//   Nt* core (8):    NtCreateFile(0) / NtReadFile(1) / NtWriteFile(2) / NtClose(3) /
//                    NtQueryInformationFile(4) / NtSetInformationFile(5) /
//                    NtAllocateVirtualMemory(6) / NtFreeVirtualMemory(7)
//   Rtl* utility (4): RtlInitUnicodeString(8) / RtlAllocateHeap(9) / RtlFreeHeap(10) /
//                     RtlGetLastWin32Error(11)
//   LDR (3):         LdrLoadDll(12) / LdrGetProcedureAddress(13) / LdrUnloadDll(14)
//
// synthetic UNICODE_STRING (8 byte = USHORT Length + USHORT MaximumLength + PWSTR Buffer pointer
//   ref shape): Length 0x002C (44 byte), MaxLength 0x002E, Buffer_ref 0x40000200.
// synthetic OBJECT_ATTRIBUTES (24 byte = ULONG Length + HANDLE RootDirectory + PUNICODE_STRING
//   ObjectName + ULONG Attributes + PVOID SecurityDescriptor + PVOID SecurityQualityOfService):
//   Length 0x18, attr 0x00000040 (OBJ_CASE_INSENSITIVE), root 0x00000000.
// synthetic IO_STATUS_BLOCK (16 byte = NTSTATUS Status + ULONG_PTR Information): Status 0x00000000
//   (STATUS_SUCCESS), Information 0x00000400 (1024 byte transferred).
// synthetic HANDLE file: 0x40000400. synthetic heap_handle 0x50000500. synthetic dll_handle
//   0x60000600. NTSTATUS LE: SUCCESS 0x00000000, INVALID_PARAMETER 0xC000000D, ACCESS_DENIED
//   0xC0000022, OBJECT_NAME_NOT_FOUND 0xC0000034.
//
// persist schema (TSV — 4 table): syscall_invoke / nt_io_round_trip / rtl_lifecycle / ldr_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pntdll_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ntdll_core"
}

fn pntdll_syscall_invoke_path() -> str {
    return pntdll_dir() + "/syscall_invoke.tsv"
}

fn pntdll_nt_io_round_trip_path() -> str {
    return pntdll_dir() + "/nt_io_round_trip.tsv"
}

fn pntdll_rtl_lifecycle_path() -> str {
    return pntdll_dir() + "/rtl_lifecycle.tsv"
}

fn pntdll_ldr_event_path() -> str {
    return pntdll_dir() + "/ldr_event.tsv"
}

fn pntdll_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pntdll_dir() + "'")
}

fn cleanup_pntdll() -> void {
    pntdll_ensure_dir()
    let _ = exec("rm -f '" + pntdll_syscall_invoke_path() + "' '" + pntdll_nt_io_round_trip_path()
        + "' '" + pntdll_rtl_lifecycle_path() + "' '" + pntdll_ldr_event_path() + "'")
}

// ─── 공통 file IO ───
fn pntdll_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pntdll_append_row(path: str, row: str) -> void {
    pntdll_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pntdll_count_rows(path: str, min_cols: int) -> int {
    let t = pntdll_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (15 fn coverage, fn_kind 0..14) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "NtCreateFile" }
    if k == 1 { return "NtReadFile" }
    if k == 2 { return "NtWriteFile" }
    if k == 3 { return "NtClose" }
    if k == 4 { return "NtQueryInformationFile" }
    if k == 5 { return "NtSetInformationFile" }
    if k == 6 { return "NtAllocateVirtualMemory" }
    if k == 7 { return "NtFreeVirtualMemory" }
    if k == 8 { return "RtlInitUnicodeString" }
    if k == 9 { return "RtlAllocateHeap" }
    if k == 10 { return "RtlFreeHeap" }
    if k == 11 { return "RtlGetLastWin32Error" }
    if k == 12 { return "LdrLoadDll" }
    if k == 13 { return "LdrGetProcedureAddress" }
    if k == 14 { return "LdrUnloadDll" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 7 {
            return "nt_core"
        }
    }
    if k >= 8 {
        if k <= 11 {
            return "rtl_utility"
        }
    }
    if k >= 12 {
        if k <= 14 {
            return "ldr"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: NTDLL fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_ntdll_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_ntdll_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 14 {
        panic("pe_ntdll_core FAIL [record_syscall_invoke] expected=fn_kind<=14 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_ntdll_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_ntdll_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pntdll_append_row(pntdll_syscall_invoke_path(), row)
}

// ─── record_nt_io_round_trip: NtCreateFile / NtReadFile / NtWriteFile / NtClose synthetic ───
fn record_nt_io_round_trip(io_id: int, op_id: str, handle_hex: str, ntstatus_hex: str, info_synth: int, status: str) -> void {
    if io_id <= 0 {
        panic("pe_ntdll_core FAIL [record_nt_io_round_trip] expected=io_id>0 got=" + to_string(io_id))
    }
    if op_id == "" {
        panic("pe_ntdll_core FAIL [record_nt_io_round_trip] expected=op_id!=empty got=empty")
    }
    if handle_hex == "" {
        panic("pe_ntdll_core FAIL [record_nt_io_round_trip] expected=handle_hex!=empty got=empty")
    }
    if ntstatus_hex == "" {
        panic("pe_ntdll_core FAIL [record_nt_io_round_trip] expected=ntstatus_hex!=empty got=empty")
    }
    if info_synth < 0 {
        panic("pe_ntdll_core FAIL [record_nt_io_round_trip] expected=info_synth>=0 got=" + to_string(info_synth))
    }
    if status == "" {
        panic("pe_ntdll_core FAIL [record_nt_io_round_trip] expected=status!=empty got=empty")
    }
    let row = to_string(io_id) + "\t" + op_id + "\t" + handle_hex + "\t"
        + ntstatus_hex + "\t" + to_string(info_synth) + "\t" + status + "\n"
    pntdll_append_row(pntdll_nt_io_round_trip_path(), row)
}

// ─── record_rtl_lifecycle: Rtl* utility fn (Init/Allocate/Free/Get) row ───
fn record_rtl_lifecycle(life_id: int, rtl_kind: str, ptr_hex: str, size_synth: int, status: str) -> void {
    if life_id <= 0 {
        panic("pe_ntdll_core FAIL [record_rtl_lifecycle] expected=life_id>0 got=" + to_string(life_id))
    }
    if rtl_kind == "" {
        panic("pe_ntdll_core FAIL [record_rtl_lifecycle] expected=rtl_kind!=empty got=empty")
    }
    if ptr_hex == "" {
        panic("pe_ntdll_core FAIL [record_rtl_lifecycle] expected=ptr_hex!=empty got=empty")
    }
    if size_synth < 0 {
        panic("pe_ntdll_core FAIL [record_rtl_lifecycle] expected=size_synth>=0 got=" + to_string(size_synth))
    }
    if status == "" {
        panic("pe_ntdll_core FAIL [record_rtl_lifecycle] expected=status!=empty got=empty")
    }
    let row = to_string(life_id) + "\t" + rtl_kind + "\t" + ptr_hex + "\t"
        + to_string(size_synth) + "\t" + status + "\n"
    pntdll_append_row(pntdll_rtl_lifecycle_path(), row)
}

// ─── record_ldr_event: LdrLoadDll / LdrGetProcedureAddress / LdrUnloadDll row ───
fn record_ldr_event(evt_id: int, ldr_kind: str, fn_name: str, payload_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_ntdll_core FAIL [record_ldr_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if ldr_kind == "" {
        panic("pe_ntdll_core FAIL [record_ldr_event] expected=ldr_kind!=empty got=empty")
    }
    if fn_name == "" {
        panic("pe_ntdll_core FAIL [record_ldr_event] expected=fn_name!=empty got=empty")
    }
    if payload_hex == "" {
        panic("pe_ntdll_core FAIL [record_ldr_event] expected=payload_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_ntdll_core FAIL [record_ldr_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + ldr_kind + "\t" + fn_name + "\t"
        + payload_hex + "\t" + status + "\n"
    pntdll_append_row(pntdll_ldr_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pntdll_count_rows(pntdll_syscall_invoke_path(), 4)
}

fn nt_io_round_trip_count() -> int {
    return pntdll_count_rows(pntdll_nt_io_round_trip_path(), 6)
}

fn rtl_lifecycle_count() -> int {
    return pntdll_count_rows(pntdll_rtl_lifecycle_path(), 5)
}

fn ldr_event_count() -> int {
    return pntdll_count_rows(pntdll_ldr_event_path(), 5)
}

fn pntdll_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(nt_io_round_trip_count())
    out.push(rtl_lifecycle_count())
    out.push(ldr_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pntdll-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pntdll()

    // ─── 1. syscall_invoke × 15 (one per fn, 3 group coverage) ───
