    r0_emit("pe_ntdll_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"NtCreateFile\",\"fn_group\":\"nt_core\",\"status\":\"PARTIAL\",\"obj_attr_synth_bytes\":24,\"unicode_string_synth_bytes\":8,\"object_name_w_synth\":\"\\\\??\\\\C:\\\\Battle.net\\\\D2R\\\\Save\\\\test.d2s\",\"desired_access\":\"0x80100080\",\"create_disposition\":\"0x00000001\",\"ntstatus\":\"0x00000000\"")
    record_syscall_invoke(2, 1, "NtReadFile", "PARTIAL")
