    record_rtl_lifecycle(4, "rtl_last_error", "0x00000000", 0, "PARTIAL")
    r0_emit("pe_ntdll_core_record", "\"kind\":\"rtl_lifecycle\",\"life_id\":4,\"rtl_kind\":\"rtl_last_error\",\"ptr_hex\":\"0x00000000\",\"win32_error\":\"0x00000000\",\"status\":\"PARTIAL\"")

