    // ─── 3. rtl_lifecycle × 4 (init unicode + alloc + free + last error) ───
    record_rtl_lifecycle(1, "rtl_init_unicode", "0x40000200", 44, "PARTIAL")
    r0_emit("pe_ntdll_core_record", "\"kind\":\"rtl_lifecycle\",\"life_id\":1,\"rtl_kind\":\"rtl_init_unicode\",\"buffer_ref_hex\":\"0x40000200\",\"length\":44,\"max_length\":46,\"unicode_string_synth_bytes\":8,\"status\":\"PARTIAL\"")
