// lib/loader/pe_pe_install_coverage_v2.hexa — PE install coverage tracker v2
//
// Coverage tracker v2 — supersedes lib/perf/c_pe_install_coverage.hexa
//   v1 (perf/c_pe_install_coverage.hexa) 의 module_path_for() / is_covered() glob 패턴 한계:
//     - cycle 58-80 신규 143 모듈 (pe_ipc_*, pe_native_*_real, pe_section_*, pe_iat_*, ...) 미반영
//   v2 (본 모듈, lib/loader 위치) — skeleton-aware tracker
//     - 20 category 분류
//     - module_id → category_kind → line_count → covered (실 PE binary 에서 호출 됨?)
//     - largest_module: dispatch.hexa 같은 hub identification
// own1: hexa 자체 구현 — third-party coverage tool 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// category_kind code:
//   1  = pe_loader
//   2  = win32_dll
//   3  = dx
//   4  = ipc
//   5  = memory
//   6  = perf
//   7  = abi
//   8  = nt_syscall
//   9  = seh
//   10 = sync
//   11 = runtime
//   12 = fs
//   13 = proc
//   14 = net
//   15 = directx
//   16 = com
//   17 = gdi
//   18 = i18n
//   19 = stage7_real
//   20 = other
//
// persist schema (TSV — modules.tsv):
//   module_id<str> \t category_kind<int> \t line_count<int> \t covered<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ppic2_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_pe_install_coverage_v2"
}

fn ppic2_modules_path() -> str {
    return ppic2_dir() + "/modules.tsv"
}

fn ppic2_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ppic2_dir() + "'")
}

fn cleanup_ppic2() -> void {
    ppic2_ensure_dir()
    let _ = exec("rm -f '" + ppic2_modules_path() + "'")
}

// ─── 공통 file IO ───
fn ppic2_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ppic2_append_row(path: str, row: str) -> void {
    ppic2_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_module: module 1 건 기록 ───
fn record_module(module_id: str, category_kind: int, line_count: int, covered: int) -> void {
    if module_id == "" {
        panic("pe_pe_install_coverage_v2 FAIL [record_module] expected=module_id!='' got=''")
    }
    if category_kind < 1 {
        panic("pe_pe_install_coverage_v2 FAIL [record_module] expected=category_kind>=1 got=" + to_string(category_kind))
    }
    if category_kind > 20 {
        panic("pe_pe_install_coverage_v2 FAIL [record_module] expected=category_kind<=20 got=" + to_string(category_kind))
    }
    if line_count < 0 {
        panic("pe_pe_install_coverage_v2 FAIL [record_module] expected=line_count>=0 got=" + to_string(line_count))
    }
    if covered < 0 {
        panic("pe_pe_install_coverage_v2 FAIL [record_module] expected=covered>=0 got=" + to_string(covered))
    }
    if covered > 1 {
        panic("pe_pe_install_coverage_v2 FAIL [record_module] expected=covered<=1 got=" + to_string(covered))
    }
    let row = module_id + "\t" + to_string(category_kind)
        + "\t" + to_string(line_count) + "\t" + to_string(covered) + "\n"
    ppic2_append_row(ppic2_modules_path(), row)
}

// ─── module_count: total module 수 ───
fn module_count() -> int {
    let t = ppic2_read_table(ppic2_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_lines: 모든 module line_count 합 ───
fn total_lines() -> int {
    let t = ppic2_read_table(ppic2_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── covered_count: covered=1 인 module 수 ───
fn covered_count() -> int {
    let t = ppic2_read_table(ppic2_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── coverage_pct: covered_count * 100 / module_count (0-guard) ───
fn coverage_pct() -> int {
    let mc = module_count()
    if mc == 0 {
        return 0
    }
    let cc = covered_count()
    return (cc * 100) / mc
}

// ─── count_by_category_kind: 특정 category_kind 의 module 수 ───
fn count_by_category_kind(kind: int) -> int {
    let t = ppic2_read_table(ppic2_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── largest_module: line_count max 인 module_id (없으면 "") ───
fn largest_module() -> str {
    let t = ppic2_read_table(ppic2_modules_path())
    if t == "" {
        return ""
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut best_id = ""
    let mut best_lc = -1
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let lc = to_int(parts[2])
                if lc > best_lc {
                    best_lc = lc
                    best_id = parts[0]
                }
            }
        }
        i = i + 1
    }
    return best_id
}

// ─── module_lines: 특정 module_id 의 line_count (없으면 0) ───
fn module_lines(module_id: str) -> int {
    let t = ppic2_read_table(ppic2_modules_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == module_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── ppic2_stats: [module_count, total_lines, covered_count, coverage_pct] ───
fn ppic2_stats() -> array {
    let mut out = []
    out.push(module_count())
    out.push(total_lines())
    out.push(covered_count())
    out.push(coverage_pct())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ppic2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ppic2()

    // 2. record 6 modules covering ≥4 category_kinds, ≥4 covered
    //    kinds used: 1 (pe_loader), 4 (ipc), 6 (perf), 19 (stage7_real), 20 (other)
    record_module("pe_loader_dispatch", 1, 1200, 1)
    r0_emit("pe_pe_install_coverage_v2_record",
        "\"module_id\":\"pe_loader_dispatch\",\"category_kind\":1,\"line_count\":1200,\"covered\":1")

    record_module("pe_ipc_unix_socket", 4, 388, 1)
    r0_emit("pe_pe_install_coverage_v2_record",
        "\"module_id\":\"pe_ipc_unix_socket\",\"category_kind\":4,\"line_count\":388,\"covered\":1")

    record_module("pe_ipc_shared_mem", 4, 240, 1)
    r0_emit("pe_pe_install_coverage_v2_record",
        "\"module_id\":\"pe_ipc_shared_mem\",\"category_kind\":4,\"line_count\":240,\"covered\":1")

    record_module("c_pe_install_coverage", 6, 320, 1)
    r0_emit("pe_pe_install_coverage_v2_record",
        "\"module_id\":\"c_pe_install_coverage\",\"category_kind\":6,\"line_count\":320,\"covered\":1")

    record_module("pe_native_open_real", 19, 180, 0)
    r0_emit("pe_pe_install_coverage_v2_record",
        "\"module_id\":\"pe_native_open_real\",\"category_kind\":19,\"line_count\":180,\"covered\":0")

    record_module("pe_misc_misc", 20, 90, 0)
    r0_emit("pe_pe_install_coverage_v2_record",
        "\"module_id\":\"pe_misc_misc\",\"category_kind\":20,\"line_count\":90,\"covered\":0")

    // 3. module_count = 6
    let mc = module_count()
    if mc != 6 {
        panic("pe_pe_install_coverage_v2 FAIL [module_count] expected=6 got=" + to_string(mc))
    }

    // 4. total_lines = 1200+388+240+320+180+90 = 2418
    let tl = total_lines()
    if tl != 2418 {
        panic("pe_pe_install_coverage_v2 FAIL [total_lines] expected=2418 got=" + to_string(tl))
    }

    // 5. covered_count = 4
    let cc = covered_count()
    if cc != 4 {
        panic("pe_pe_install_coverage_v2 FAIL [covered_count] expected=4 got=" + to_string(cc))
    }

    // 6. coverage_pct = 4*100/6 = 66
    let cp = coverage_pct()
    if cp != 66 {
        panic("pe_pe_install_coverage_v2 FAIL [coverage_pct] expected=66 got=" + to_string(cp))
    }

    // 7. count_by_category_kind sanity
    let k1 = count_by_category_kind(1)
    if k1 != 1 {
        panic("pe_pe_install_coverage_v2 FAIL [count_by_category_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k4 = count_by_category_kind(4)
    if k4 != 2 {
        panic("pe_pe_install_coverage_v2 FAIL [count_by_category_kind(4)] expected=2 got=" + to_string(k4))
    }
    let k6 = count_by_category_kind(6)
    if k6 != 1 {
        panic("pe_pe_install_coverage_v2 FAIL [count_by_category_kind(6)] expected=1 got=" + to_string(k6))
    }
    let k19 = count_by_category_kind(19)
    if k19 != 1 {
        panic("pe_pe_install_coverage_v2 FAIL [count_by_category_kind(19)] expected=1 got=" + to_string(k19))
    }
    let k20 = count_by_category_kind(20)
    if k20 != 1 {
        panic("pe_pe_install_coverage_v2 FAIL [count_by_category_kind(20)] expected=1 got=" + to_string(k20))
    }
    let k7 = count_by_category_kind(7)
    if k7 != 0 {
        panic("pe_pe_install_coverage_v2 FAIL [count_by_category_kind(7)] expected=0 got=" + to_string(k7))
    }

    // 8. largest_module = "pe_loader_dispatch" (1200 lines)
    let lm = largest_module()
    if lm != "pe_loader_dispatch" {
        panic("pe_pe_install_coverage_v2 FAIL [largest_module] expected=pe_loader_dispatch got=" + lm)
    }

    // 9. module_lines sanity
    let ml1 = module_lines("pe_ipc_unix_socket")
    if ml1 != 388 {
        panic("pe_pe_install_coverage_v2 FAIL [module_lines(pe_ipc_unix_socket)] expected=388 got=" + to_string(ml1))
    }
    let ml2 = module_lines("c_pe_install_coverage")
    if ml2 != 320 {
        panic("pe_pe_install_coverage_v2 FAIL [module_lines(c_pe_install_coverage)] expected=320 got=" + to_string(ml2))
    }
    let ml_miss = module_lines("nonexistent_module")
    if ml_miss != 0 {
        panic("pe_pe_install_coverage_v2 FAIL [module_lines(nonexistent)] expected=0 got=" + to_string(ml_miss))
    }

    // 10. ppic2_stats() = [6, 2418, 4, 66]
    let s = ppic2_stats()
    if len(s) != 4 {
        panic("pe_pe_install_coverage_v2 FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_pe_install_coverage_v2 FAIL [stats module_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2418 {
        panic("pe_pe_install_coverage_v2 FAIL [stats total_lines] expected=2418 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_pe_install_coverage_v2 FAIL [stats covered_count] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 66 {
        panic("pe_pe_install_coverage_v2 FAIL [stats coverage_pct] expected=66 got=" + to_string(s[3]))
    }

    // 11. emit stats
    r0_emit("pe_pe_install_coverage_v2_stats",
        "\"module_count\":" + to_string(s[0])
        + ",\"total_lines\":" + to_string(s[1])
        + ",\"covered_count\":" + to_string(s[2])
        + ",\"coverage_pct\":" + to_string(s[3])
        + ",\"largest_module\":\"" + lm + "\"")

    // 12. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_pe_install_coverage_v2 FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 13. cleanup → stats 모두 0
    cleanup_ppic2()
    let s2 = ppic2_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_pe_install_coverage_v2 FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }
    let lm2 = largest_module()
    if lm2 != "" {
        panic("pe_pe_install_coverage_v2 FAIL [cleanup largest_module] expected='' got=" + lm2)
    }

    println("  ✅ pe_pe_install_coverage_v2 self_test PASS (modules=" + to_string(s[0])
        + ", lines=" + to_string(s[1]) + ", covered=" + to_string(s[2])
        + ", pct=" + to_string(s[3]) + ", largest=" + lm
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ppic2_stats()
            println("module_count\t" + to_string(s[0]))
            println("total_lines\t" + to_string(s[1]))
            println("covered_count\t" + to_string(s[2]))
            println("coverage_pct\t" + to_string(s[3]))
            println("largest_module\t" + largest_module())
            return
        }
        if sub == "lines" {
            if len(a) >= 4 {
                let mid = a[3]
                println("module_lines\t" + to_string(module_lines(mid)))
                return
            }
            println("usage: hexa run pe_pe_install_coverage_v2.hexa lines <module_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_category_kind\t" + to_string(count_by_category_kind(kind)))
                return
            }
            println("usage: hexa run pe_pe_install_coverage_v2.hexa count <category_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ppic2()
            println("cleaned: " + ppic2_dir())
            return
        }
        if sub == "dir" {
            println(ppic2_dir())
            return
        }
    }
    println("usage: hexa run pe_pe_install_coverage_v2.hexa { self-test | stats | lines <module_id> | count <category_kind> | cleanup | dir }")
}
