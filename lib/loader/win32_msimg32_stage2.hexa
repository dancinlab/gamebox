// lib/loader/win32_msimg32_stage2.hexa — Phase 4i stage2 — msimg32 stub DLL
//
// own 1: Wine 0. Microsoft GDI Image extension spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe MSIMG32 imports (실측 via pe_imports DLL #1):
//   AlphaBlend  → BOOL → 1
//
// stage2: signature stub table 만 보유. 실제 호출 시 stage3 (CGContext bridge)
// 가 mapping. 여기서는 prototype + return value 명세만.

use "../perf/r0_common"

fn stub_table() -> str {
    let t = ""
    // name \t return_kind \t return_value \t notes
    t = t + "AlphaBlend\tBOOL\t1\tHDC,int,int,int,int,HDC,int,int,int,int,BLENDFUNCTION\n"
    return t
}

fn stub_count() -> int {
    let lines = stub_table().split("\n")
    let i = 0
    let n = 0
    while i < len(lines) {
        if lines[i] != "" { n = n + 1 }
        i = i + 1
    }
    return n
}

fn stub_lookup(name: str) -> str {
    let lines = stub_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

// AlphaBlend stub — BOOL → TRUE (1). 실제 alpha blend X.
fn AlphaBlend_stub() -> int {
    return 1
}

fn self_test() -> void {
    let sid = "msimg32stage2-" + exec("date +%s").trim()
    r0_session_set(sid)

    let n = stub_count()
    if n != 1 { panic("win32_msimg32_stage2 FAIL [size] expected=1 got=" + to_string(n)) }

    let s = stub_lookup("AlphaBlend")
    if !s.contains("BOOL") { panic("win32_msimg32_stage2 FAIL [lookup AlphaBlend]") }

    let rv = AlphaBlend_stub()
    if rv != 1 { panic("win32_msimg32_stage2 FAIL [AlphaBlend rv] got=" + to_string(rv)) }

    let unk = stub_lookup("NotAStub")
    if unk != "" { panic("win32_msimg32_stage2 FAIL [unknown should be empty]") }

    r0_emit("msimg32_stage2_stub", "\"name\":\"AlphaBlend\",\"rv\":1")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_msimg32_stage2 FAIL [emit count]") }

    println("  ✅ win32_msimg32_stage2 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "count" { println(to_string(stub_count())); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = stub_lookup(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_msimg32_stage2.hexa { self-test | count | lookup <name> }")
}
