// lib/loader/win32_ntdll.hexa — Phase 3b — ntdll 핵심 NT API mapping (skeleton)
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 Windows Internals / WDK ntdll 문서:
//     - NT File:    https://learn.microsoft.com/en-us/windows/win32/api/winternl/
//     - NT Memory:  https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/
//     - RTL:        https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/ntddk/
//     - NT Process: https://learn.microsoft.com/en-us/windows/win32/api/winternl/
//     - NT Sync:    https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 2: ntdll_lookup + ntdll_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("win32_ntdll FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 3b — skeleton):
//   30 핵심 ntdll 함수의 *mapping table* 만 정의.
//   각 entry = (NT 함수명, 대응되는 macOS syscall / libc 호출, 카테고리, status).
//   실제 implementation 은 Phase 3b 후속.
//
// status 값:
//   "skeleton" — mapping 만 (Phase 3b 현재 모든 entry)
//   "stub"     — default value 만 반환 (호출 시 STATUS_SUCCESS 또는 STATUS_NOT_IMPLEMENTED)
//   "impl"     — 실제 macOS syscall 실행
//
// 30 함수 카테고리 (실제 분포):
//   File     8  (NtCreateFile, NtReadFile, NtWriteFile, NtClose,
//                NtDeleteFile, NtQueryInformationFile,
//                NtSetInformationFile, NtFlushBuffersFile)
//   Memory   5  (NtAllocateVirtualMemory, NtFreeVirtualMemory,
//                NtProtectVirtualMemory, NtMapViewOfSection,
//                NtUnmapViewOfSection)
//   Rtl      8  (RtlGetVersion, RtlInitUnicodeString, RtlAllocateHeap,
//                RtlFreeHeap, RtlZeroMemory, RtlCopyMemory,
//                RtlCompareMemory, RtlMoveMemory)
//   Process  5  (NtCreateProcess, NtTerminateProcess,
//                NtQueryInformationProcess, NtSuspendProcess, NtResumeProcess)
//   Sync     4  (NtCreateMutant, NtReleaseMutant,
//                NtWaitForSingleObject, NtCreateEvent)
//   ──────────
//   total   30  / 5 categories

use "../perf/r0_common"

// ─── 30 함수 mapping table (TSV — name\tmacos_equiv\tcategory\tstatus) ───
//
// 한 줄 = "<NT name>\t<macOS equivalent>\t<category>\t<status>"
// 줄 구분자 = "\n". 첫 줄도 의미 entry (header 없음 — 데이터 30줄).
fn ntdll_table() -> str {
    let t = ""
    // File (8)
    t = t + "NtCreateFile\topen\tFile\tskeleton\n"
    t = t + "NtReadFile\tread\tFile\tskeleton\n"
    t = t + "NtWriteFile\twrite\tFile\tskeleton\n"
    t = t + "NtClose\tclose\tFile\tskeleton\n"
    t = t + "NtDeleteFile\tunlink\tFile\tskeleton\n"
    t = t + "NtQueryInformationFile\tfstat\tFile\tskeleton\n"
    t = t + "NtSetInformationFile\tfcntl\tFile\tskeleton\n"
    t = t + "NtFlushBuffersFile\tfsync\tFile\tskeleton\n"
    // Memory (5)
    t = t + "NtAllocateVirtualMemory\tmmap\tMemory\tskeleton\n"
    t = t + "NtFreeVirtualMemory\tmunmap\tMemory\tskeleton\n"
    t = t + "NtProtectVirtualMemory\tmprotect\tMemory\tskeleton\n"
    t = t + "NtMapViewOfSection\tmmap\tMemory\tskeleton\n"
    t = t + "NtUnmapViewOfSection\tmunmap\tMemory\tskeleton\n"
    // Rtl (8)
    t = t + "RtlGetVersion\tsw_vers\tRtl\tskeleton\n"
    t = t + "RtlInitUnicodeString\tstrcpy_s\tRtl\tskeleton\n"
    t = t + "RtlAllocateHeap\tmalloc\tRtl\tskeleton\n"
    t = t + "RtlFreeHeap\tfree\tRtl\tskeleton\n"
    t = t + "RtlZeroMemory\tmemset_zero\tRtl\tskeleton\n"
    t = t + "RtlCopyMemory\tmemcpy\tRtl\tskeleton\n"
    t = t + "RtlCompareMemory\tmemcmp\tRtl\tskeleton\n"
    t = t + "RtlMoveMemory\tmemmove\tRtl\tskeleton\n"
    // Process (5)
    t = t + "NtCreateProcess\tfork+exec\tProcess\tskeleton\n"
    t = t + "NtTerminateProcess\tkill\tProcess\tskeleton\n"
    t = t + "NtQueryInformationProcess\tsysctl\tProcess\tskeleton\n"
    t = t + "NtSuspendProcess\tkill_STOP\tProcess\tskeleton\n"
    t = t + "NtResumeProcess\tkill_CONT\tProcess\tskeleton\n"
    // Sync (4)
    t = t + "NtCreateMutant\tpthread_mutex_init\tSync\tskeleton\n"
    t = t + "NtReleaseMutant\tpthread_mutex_unlock\tSync\tskeleton\n"
    t = t + "NtWaitForSingleObject\tpthread_mutex_lock\tSync\tskeleton\n"
    t = t + "NtCreateEvent\tpthread_cond_init\tSync\tskeleton\n"
    return t
}

// ─── table line count (entry 수 = 30) ───
fn ntdll_table_size() -> int {
    let t = ntdll_table()
    let lines = t.split("\n")
    // trailing "\n" → 마지막 빈 element 1 개. count 에서 제외.
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ─── lookup: NT 함수명 → "<macos>\t<category>\t<status>" 또는 "" ───
fn lookup_mapping(name: str) -> str {
    let t = ntdll_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── status only ───
fn function_status(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[2]
    }
    return ""
}

// ─── category only ───
fn function_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[1]
    }
    return ""
}

// ─── macOS equivalent only ───
fn function_macos_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[0]
    }
    return ""
}

// ─── category 통계 ───
//
//   반환: array of [category_name, total_count, impl_count]
//   (hexa stage1 dict 부재 → array of array).
//   impl_count = status == "impl" 인 entry 수 (Phase 3b 현재 모두 0).
fn ntdll_stats() -> array {
    let mut cats = []
    cats.push(["File", 0, 0])
    cats.push(["Memory", 0, 0])
    cats.push(["Rtl", 0, 0])
    cats.push(["Process", 0, 0])
    cats.push(["Sync", 0, 0])

    let t = ntdll_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cat = parts[2]
                let st = parts[3]
                let j = 0
                while j < len(cats) {
                    if cats[j][0] == cat {
                        cats[j][1] = cats[j][1] + 1
                        if st == "impl" {
                            cats[j][2] = cats[j][2] + 1
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return cats
}

// ─── 전체 impl_count 합 (스카라) ───
fn ntdll_impl_count() -> int {
    let stats = ntdll_stats()
    let n = len(stats)
    let i = 0
    let total = 0
    while i < n {
        total = total + stats[i][2]
        i = i + 1
    }
    return total
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "ntdll-test-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size ≥ 25 (실제 == 30)
    let sz = ntdll_table_size()
    if sz < 25 {
        panic("win32_ntdll FAIL [table_size] expected=>=25 got=" + to_string(sz))
    }
    if sz != 30 {
        panic("win32_ntdll FAIL [table_size_exact] expected=30 got=" + to_string(sz))
    }

    // 2. lookup_mapping("NtCreateFile") = "open\tFile\tskeleton"
    let m_create = lookup_mapping("NtCreateFile")
    let exp_create = "open\tFile\tskeleton"
    if m_create != exp_create {
        panic("win32_ntdll FAIL [lookup NtCreateFile] expected=" + exp_create + " got=" + m_create)
    }

    // 3. lookup_mapping("RtlGetVersion") = "sw_vers\tRtl\tskeleton"
    let m_rtlver = lookup_mapping("RtlGetVersion")
    let exp_rtlver = "sw_vers\tRtl\tskeleton"
    if m_rtlver != exp_rtlver {
        panic("win32_ntdll FAIL [lookup RtlGetVersion] expected=" + exp_rtlver + " got=" + m_rtlver)
    }

    // 4. lookup_mapping("NtAllocateVirtualMemory") = "mmap\tMemory\tskeleton"
    let m_valloc = lookup_mapping("NtAllocateVirtualMemory")
    let exp_valloc = "mmap\tMemory\tskeleton"
    if m_valloc != exp_valloc {
        panic("win32_ntdll FAIL [lookup NtAllocateVirtualMemory] expected=" + exp_valloc + " got=" + m_valloc)
    }

    // 5. function_status("NtCreateFile") = "skeleton"
    let st = function_status("NtCreateFile")
    if st != "skeleton" {
        panic("win32_ntdll FAIL [function_status NtCreateFile] expected=skeleton got=" + st)
    }

    // 5b. unknown name → empty
    let m_unknown = lookup_mapping("NoSuchNtFunction")
    if m_unknown != "" {
        panic("win32_ntdll FAIL [lookup unknown] expected=empty got=" + m_unknown)
    }

    // 6. r0_emit "ntdll_lookup" {name, macos}
    let macos_create = function_macos_equiv("NtCreateFile")
    r0_emit("ntdll_lookup",
        "\"name\":\"NtCreateFile\",\"macos\":\"" + macos_create + "\"")

    // 7. ntdll_stats() ≥ 5 categories with expected counts
    let stats = ntdll_stats()
    let cat_n = len(stats)
    if cat_n < 5 {
        panic("win32_ntdll FAIL [stats categories] expected=>=5 got=" + to_string(cat_n))
    }
    // 카테고리별 정확한 count 검증
    let i = 0
    let sum_total = 0
    let sum_impl = 0
    while i < cat_n {
        let cn = stats[i][0]
        let ct = stats[i][1]
        let ci = stats[i][2]
        sum_total = sum_total + ct
        sum_impl = sum_impl + ci
        // 카테고리별 정확 count
        if cn == "File" {
            if ct != 8 {
                panic("win32_ntdll FAIL [stats File count] expected=8 got=" + to_string(ct))
            }
        }
        if cn == "Memory" {
            if ct != 5 {
                panic("win32_ntdll FAIL [stats Memory count] expected=5 got=" + to_string(ct))
            }
        }
        if cn == "Rtl" {
            if ct != 8 {
                panic("win32_ntdll FAIL [stats Rtl count] expected=8 got=" + to_string(ct))
            }
        }
        if cn == "Process" {
            if ct != 5 {
                panic("win32_ntdll FAIL [stats Process count] expected=5 got=" + to_string(ct))
            }
        }
        if cn == "Sync" {
            if ct != 4 {
                panic("win32_ntdll FAIL [stats Sync count] expected=4 got=" + to_string(ct))
            }
        }
        i = i + 1
    }
    if sum_total != 30 {
        panic("win32_ntdll FAIL [stats total sum] expected=30 got=" + to_string(sum_total))
    }
    if sum_impl != 0 {
        panic("win32_ntdll FAIL [stats impl sum] expected=0 got=" + to_string(sum_impl))
    }

    // 8. r0_emit "ntdll_stats" {table_size, categories, impl_count}
    r0_emit("ntdll_stats",
        "\"table_size\":" + to_string(sz)
        + ",\"categories\":" + to_string(cat_n)
        + ",\"impl_count\":" + to_string(sum_impl))

    // R0 emit count 검증 — 정확히 2 events (ntdll_lookup + ntdll_stats)
    let emit_n = r0_session_count(sid)
    if emit_n != 2 {
        panic("win32_ntdll FAIL [r0 emit count] expected=2 got=" + to_string(emit_n))
    }

    println("  ✅ win32_ntdll self_test PASS (30 functions, 5 categories, all skeleton, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "table" {
            print(ntdll_table())
            return
        }
        if sub == "lookup" {
            if len(a) >= 4 {
                let name = a[3]
                let m = lookup_mapping(name)
                if m == "" {
                    println("(not found)")
                } else {
                    println(m)
                }
                return
            }
        }
        if sub == "status" {
            if len(a) >= 4 {
                let name = a[3]
                let s = function_status(name)
                if s == "" {
                    println("(not found)")
                } else {
                    println(s)
                }
                return
            }
        }
        if sub == "stats" {
            let stats = ntdll_stats()
            let n = len(stats)
            let i = 0
            while i < n {
                println(stats[i][0]
                    + "\t" + to_string(stats[i][1])
                    + "\t" + to_string(stats[i][2]))
                i = i + 1
            }
            return
        }
        if sub == "size" {
            println(to_string(ntdll_table_size()))
            return
        }
    }
    println("usage: hexa run win32_ntdll.hexa { self-test | table | lookup <name> | status <name> | stats | size }")
}
