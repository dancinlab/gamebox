// lib/loader/pe_process_protection.hexa — cycle 74 Win32 process mitigation telemetry skeleton
//
// Game/anticheat 가 SetProcessMitigationPolicy / DEP / ASLR / CFG /
// ArbitraryCodeGuard / BinarySignature 를 점점 강하게 강제. 본 module 은
// process mitigation policy tracker — 실제 SetProcessMitigationPolicy()
// 호출 X (stage6 native bridge).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// mitigation_kind code:
//   1 = dep
//   2 = aslr
//   3 = cfg
//   4 = arbitrary_code_guard
//   5 = binary_signature
//
// persist schema (TSV — policies.tsv):
//   policy_id<int> \t mitigation_kind<int> \t enabled<int> \t audit_only<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ppp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_process_protection"
}

fn ppp_policies_path() -> str {
    return ppp_dir() + "/policies.tsv"
}

fn ppp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ppp_dir() + "'")
}

fn cleanup_ppp() -> void {
    ppp_ensure_dir()
    let _ = exec("rm -f '" + ppp_policies_path() + "'")
}

// ─── 공통 file IO ───
fn ppp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ppp_append_row(path: str, row: str) -> void {
    ppp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_policy: mitigation policy 1 건 기록 ───
fn record_policy(policy_id: int, mitigation_kind: int, enabled: int, audit_only: int) -> void {
    if policy_id <= 0 {
        panic("pe_process_protection FAIL [record_policy] expected=policy_id>0 got=" + to_string(policy_id))
    }
    if mitigation_kind < 1 {
        panic("pe_process_protection FAIL [record_policy] expected=mitigation_kind>=1 got=" + to_string(mitigation_kind))
    }
    if mitigation_kind > 5 {
        panic("pe_process_protection FAIL [record_policy] expected=mitigation_kind<=5 got=" + to_string(mitigation_kind))
    }
    if enabled < 0 {
        panic("pe_process_protection FAIL [record_policy] expected=enabled>=0 got=" + to_string(enabled))
    }
    if enabled > 1 {
        panic("pe_process_protection FAIL [record_policy] expected=enabled<=1 got=" + to_string(enabled))
    }
    if audit_only < 0 {
        panic("pe_process_protection FAIL [record_policy] expected=audit_only>=0 got=" + to_string(audit_only))
    }
    if audit_only > 1 {
        panic("pe_process_protection FAIL [record_policy] expected=audit_only<=1 got=" + to_string(audit_only))
    }
    let row = to_string(policy_id) + "\t" + to_string(mitigation_kind)
        + "\t" + to_string(enabled) + "\t" + to_string(audit_only) + "\n"
    ppp_append_row(ppp_policies_path(), row)
}

// ─── policy_count: total policy 수 ───
fn policy_count() -> int {
    let t = ppp_read_table(ppp_policies_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── enabled_count: enabled=1 인 policy 수 ───
fn enabled_count() -> int {
    let t = ppp_read_table(ppp_policies_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── audit_only_count: audit_only=1 인 policy 수 ───
fn audit_only_count() -> int {
    let t = ppp_read_table(ppp_policies_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_mitigation: 특정 mitigation_kind 의 policy 수 ───
fn count_by_mitigation(mitigation_kind: int) -> int {
    let t = ppp_read_table(ppp_policies_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == mitigation_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── policy_enabled: 특정 policy_id 의 enabled (없으면 0) ───
fn policy_enabled(policy_id: int) -> int {
    let t = ppp_read_table(ppp_policies_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == policy_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── ppp_stats: [policy_count, enabled_count, audit_only_count, count_by_mitigation(3)] ───
fn ppp_stats() -> array {
    let mut out = []
    out.push(policy_count())
    out.push(enabled_count())
    out.push(audit_only_count())
    out.push(count_by_mitigation(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ppp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ppp()

    // 2. record 5 policies covering 4 mitigation_kinds (1,2,3,4) with 3 enabled
    record_policy(740001, 1, 1, 0)
    r0_emit("pe_process_protection_record",
        "\"policy_id\":740001,\"mitigation_kind\":1,\"enabled\":1,\"audit_only\":0,\"target\":\"dep\"")

    record_policy(740002, 2, 1, 0)
    r0_emit("pe_process_protection_record",
        "\"policy_id\":740002,\"mitigation_kind\":2,\"enabled\":1,\"audit_only\":0,\"target\":\"aslr\"")

    record_policy(740003, 3, 1, 0)
    r0_emit("pe_process_protection_record",
        "\"policy_id\":740003,\"mitigation_kind\":3,\"enabled\":1,\"audit_only\":0,\"target\":\"cfg\"")

    record_policy(740004, 3, 0, 1)
    r0_emit("pe_process_protection_record",
        "\"policy_id\":740004,\"mitigation_kind\":3,\"enabled\":0,\"audit_only\":1,\"target\":\"cfg\"")

    record_policy(740005, 4, 0, 1)
    r0_emit("pe_process_protection_record",
        "\"policy_id\":740005,\"mitigation_kind\":4,\"enabled\":0,\"audit_only\":1,\"target\":\"arbitrary_code_guard\"")

    // 3. policy_count = 5
    let c = policy_count()
    if c != 5 {
        panic("pe_process_protection FAIL [policy_count] expected=5 got=" + to_string(c))
    }

    // 4. enabled_count = 3
    let ec = enabled_count()
    if ec != 3 {
        panic("pe_process_protection FAIL [enabled_count] expected=3 got=" + to_string(ec))
    }

    // 5. audit_only_count = 2
    let ac = audit_only_count()
    if ac != 2 {
        panic("pe_process_protection FAIL [audit_only_count] expected=2 got=" + to_string(ac))
    }

    // 6. count_by_mitigation sanity (4 distinct kinds: 1,2,3,4)
    let m1 = count_by_mitigation(1)
    if m1 != 1 {
        panic("pe_process_protection FAIL [count_by_mitigation(1)] expected=1 got=" + to_string(m1))
    }
    let m2 = count_by_mitigation(2)
    if m2 != 1 {
        panic("pe_process_protection FAIL [count_by_mitigation(2)] expected=1 got=" + to_string(m2))
    }
    let m3 = count_by_mitigation(3)
    if m3 != 2 {
        panic("pe_process_protection FAIL [count_by_mitigation(3)] expected=2 got=" + to_string(m3))
    }
    let m4 = count_by_mitigation(4)
    if m4 != 1 {
        panic("pe_process_protection FAIL [count_by_mitigation(4)] expected=1 got=" + to_string(m4))
    }
    let m5 = count_by_mitigation(5)
    if m5 != 0 {
        panic("pe_process_protection FAIL [count_by_mitigation(5)] expected=0 got=" + to_string(m5))
    }
    let m99 = count_by_mitigation(99)
    if m99 != 0 {
        panic("pe_process_protection FAIL [count_by_mitigation(99)] expected=0 got=" + to_string(m99))
    }

    // 7. policy_enabled sanity
    let e1 = policy_enabled(740001)
    if e1 != 1 {
        panic("pe_process_protection FAIL [policy_enabled(740001)] expected=1 got=" + to_string(e1))
    }
    let e4 = policy_enabled(740004)
    if e4 != 0 {
        panic("pe_process_protection FAIL [policy_enabled(740004)] expected=0 got=" + to_string(e4))
    }
    let e_miss = policy_enabled(9999)
    if e_miss != 0 {
        panic("pe_process_protection FAIL [policy_enabled(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 8. ppp_stats() = [5, 3, 2, 2]
    let s = ppp_stats()
    if len(s) != 4 {
        panic("pe_process_protection FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_process_protection FAIL [stats policy_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_process_protection FAIL [stats enabled_count] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_process_protection FAIL [stats audit_only_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_process_protection FAIL [stats count_kind(3)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_process_protection_stats",
        "\"policy_count\":" + to_string(s[0])
        + ",\"enabled_count\":" + to_string(s[1])
        + ",\"audit_only_count\":" + to_string(s[2])
        + ",\"kind_cfg\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_process_protection FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_ppp()
    let s2 = ppp_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_process_protection FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_process_protection self_test PASS (policies=" + to_string(s[0])
        + ", enabled=" + to_string(s[1]) + ", audit=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ppp_stats()
            println("policy_count\t" + to_string(s[0]))
            println("enabled_count\t" + to_string(s[1]))
            println("audit_only_count\t" + to_string(s[2]))
            println("count_kind_cfg\t" + to_string(s[3]))
            return
        }
        if sub == "enabled" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                println("policy_enabled\t" + to_string(policy_enabled(pid)))
                return
            }
            println("usage: hexa run pe_process_protection.hexa enabled <policy_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_mitigation\t" + to_string(count_by_mitigation(kind)))
                return
            }
            println("usage: hexa run pe_process_protection.hexa count <mitigation_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ppp()
            println("cleaned: " + ppp_dir())
            return
        }
        if sub == "dir" {
            println(ppp_dir())
            return
        }
    }
    println("usage: hexa run pe_process_protection.hexa { self-test | stats | enabled <policy_id> | count <mitigation_kind> | cleanup | dir }")
}
