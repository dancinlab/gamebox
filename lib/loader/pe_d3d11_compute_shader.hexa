// lib/loader/pe_d3d11_compute_shader.hexa — D3D11 compute shader Dispatch telemetry skeleton
//
// airgenome-gamebox cycle 76 — ID3D11DeviceContext::Dispatch /
// DispatchIndirect / DispatchMesh telemetry. Compute shader thread group
// counts (X*Y*Z) per dispatch event. dispatch_kind:
//   1 = direct      (Dispatch(x,y,z))
//   2 = indirect    (DispatchIndirect(buffer,offset))
//   3 = mesh        (DispatchMesh — tier-shifted, optional path)
// elevated: 0/1 (admin / GPU privileged context flag — observed only).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 dispatch event tracker — 실 D3D11 함수 호출 X (stage6+).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// persist schema (TSV — dispatches.tsv):
//   dispatch_id<int> \t dispatch_kind<int> \t thread_groups<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdcs_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3d11_compute_shader"
}

fn pdcs_dispatches_path() -> str {
    return pdcs_dir() + "/dispatches.tsv"
}

fn pdcs_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdcs_dir() + "'")
}

fn cleanup_pdcs() -> void {
    pdcs_ensure_dir()
    let _ = exec("rm -f '" + pdcs_dispatches_path() + "'")
}

// ─── 공통 file IO ───
fn pdcs_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdcs_append_row(path: str, row: str) -> void {
    pdcs_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dispatch: dispatch event 1 건 기록 ───
fn record_dispatch(dispatch_id: int, dispatch_kind: int, thread_groups: int, elevated: int) -> void {
    if dispatch_id <= 0 {
        panic("pe_d3d11_compute_shader FAIL [record_dispatch] expected=dispatch_id>0 got=" + to_string(dispatch_id))
    }
    if dispatch_kind < 1 {
        panic("pe_d3d11_compute_shader FAIL [record_dispatch] expected=dispatch_kind>=1 got=" + to_string(dispatch_kind))
    }
    if dispatch_kind > 3 {
        panic("pe_d3d11_compute_shader FAIL [record_dispatch] expected=dispatch_kind<=3 got=" + to_string(dispatch_kind))
    }
    if thread_groups < 0 {
        panic("pe_d3d11_compute_shader FAIL [record_dispatch] expected=thread_groups>=0 got=" + to_string(thread_groups))
    }
    if elevated < 0 {
        panic("pe_d3d11_compute_shader FAIL [record_dispatch] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_d3d11_compute_shader FAIL [record_dispatch] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(dispatch_id) + "\t" + to_string(dispatch_kind)
        + "\t" + to_string(thread_groups) + "\t" + to_string(elevated) + "\n"
    pdcs_append_row(pdcs_dispatches_path(), row)
}

// ─── dispatch_count: total dispatch 수 ───
fn dispatch_count() -> int {
    let t = pdcs_read_table(pdcs_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_thread_groups: 모든 dispatch 의 thread_groups 합 ───
fn total_thread_groups() -> int {
    let t = pdcs_read_table(pdcs_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_dispatch_kind: 특정 dispatch_kind 의 dispatch 수 ───
fn count_by_dispatch_kind(dispatch_kind: int) -> int {
    let t = pdcs_read_table(pdcs_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == dispatch_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── elevated_count: elevated=1 인 dispatch 수 ───
fn elevated_count() -> int {
    let t = pdcs_read_table(pdcs_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── dispatch_thread_groups: 특정 dispatch_id 의 thread_groups (없으면 0) ───
fn dispatch_thread_groups(dispatch_id: int) -> int {
    let t = pdcs_read_table(pdcs_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == dispatch_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdcs_stats: [dispatch_count, total_thread_groups, elevated_count, count_by_dispatch_kind(1)] ───
fn pdcs_stats() -> array {
    let mut out = []
    out.push(dispatch_count())
    out.push(total_thread_groups())
    out.push(elevated_count())
    out.push(count_by_dispatch_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdcs-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdcs()

    // 2. record 5 dispatches across ≥2 dispatch_kinds (1=direct, 2=indirect, 3=mesh)
    record_dispatch(120001, 1, 64, 0)
    r0_emit("pe_d3d11_compute_shader_record",
        "\"dispatch_id\":120001,\"dispatch_kind\":1,\"thread_groups\":64,\"elevated\":0,\"target\":\"direct\"")

    record_dispatch(120002, 1, 256, 0)
    r0_emit("pe_d3d11_compute_shader_record",
        "\"dispatch_id\":120002,\"dispatch_kind\":1,\"thread_groups\":256,\"elevated\":0,\"target\":\"direct\"")

    record_dispatch(120003, 2, 128, 1)
    r0_emit("pe_d3d11_compute_shader_record",
        "\"dispatch_id\":120003,\"dispatch_kind\":2,\"thread_groups\":128,\"elevated\":1,\"target\":\"indirect\"")

    record_dispatch(120004, 2, 512, 0)
    r0_emit("pe_d3d11_compute_shader_record",
        "\"dispatch_id\":120004,\"dispatch_kind\":2,\"thread_groups\":512,\"elevated\":0,\"target\":\"indirect\"")

    record_dispatch(120005, 3, 32, 1)
    r0_emit("pe_d3d11_compute_shader_record",
        "\"dispatch_id\":120005,\"dispatch_kind\":3,\"thread_groups\":32,\"elevated\":1,\"target\":\"mesh\"")

    // 3. dispatch_count = 5
    let c = dispatch_count()
    if c != 5 {
        panic("pe_d3d11_compute_shader FAIL [dispatch_count] expected=5 got=" + to_string(c))
    }

    // 4. total_thread_groups = 992
    let tg = total_thread_groups()
    if tg != 992 {
        panic("pe_d3d11_compute_shader FAIL [total_thread_groups] expected=992 got=" + to_string(tg))
    }

    // 5. count_by_dispatch_kind sanity
    let k1 = count_by_dispatch_kind(1)
    if k1 != 2 {
        panic("pe_d3d11_compute_shader FAIL [count_by_dispatch_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_dispatch_kind(2)
    if k2 != 2 {
        panic("pe_d3d11_compute_shader FAIL [count_by_dispatch_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_dispatch_kind(3)
    if k3 != 1 {
        panic("pe_d3d11_compute_shader FAIL [count_by_dispatch_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k99 = count_by_dispatch_kind(99)
    if k99 != 0 {
        panic("pe_d3d11_compute_shader FAIL [count_by_dispatch_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. elevated_count = 2
    let ec = elevated_count()
    if ec != 2 {
        panic("pe_d3d11_compute_shader FAIL [elevated_count] expected=2 got=" + to_string(ec))
    }

    // 7. dispatch_thread_groups sanity
    let g2 = dispatch_thread_groups(120002)
    if g2 != 256 {
        panic("pe_d3d11_compute_shader FAIL [dispatch_thread_groups(120002)] expected=256 got=" + to_string(g2))
    }
    let g4 = dispatch_thread_groups(120004)
    if g4 != 512 {
        panic("pe_d3d11_compute_shader FAIL [dispatch_thread_groups(120004)] expected=512 got=" + to_string(g4))
    }
    let g_miss = dispatch_thread_groups(9999)
    if g_miss != 0 {
        panic("pe_d3d11_compute_shader FAIL [dispatch_thread_groups(9999)] expected=0 got=" + to_string(g_miss))
    }

    // 8. pdcs_stats() = [5, 992, 2, 2]
    let s = pdcs_stats()
    if len(s) != 4 {
        panic("pe_d3d11_compute_shader FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_d3d11_compute_shader FAIL [stats dispatch_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 992 {
        panic("pe_d3d11_compute_shader FAIL [stats total_thread_groups] expected=992 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_d3d11_compute_shader FAIL [stats elevated_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_d3d11_compute_shader FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_d3d11_compute_shader_stats",
        "\"dispatch_count\":" + to_string(s[0])
        + ",\"total_thread_groups\":" + to_string(s[1])
        + ",\"elevated_count\":" + to_string(s[2])
        + ",\"kind_direct\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_d3d11_compute_shader FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdcs()
    let s2 = pdcs_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d3d11_compute_shader FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3d11_compute_shader self_test PASS (dispatches=" + to_string(s[0])
        + ", thread_groups=" + to_string(s[1]) + ", elevated=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdcs_stats()
            println("dispatch_count\t" + to_string(s[0]))
            println("total_thread_groups\t" + to_string(s[1]))
            println("elevated_count\t" + to_string(s[2]))
            println("count_kind_direct\t" + to_string(s[3]))
            return
        }
        if sub == "groups" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("dispatch_thread_groups\t" + to_string(dispatch_thread_groups(did)))
                return
            }
            println("usage: hexa run pe_d3d11_compute_shader.hexa groups <dispatch_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let dk = to_int(a[3])
                println("count_by_dispatch_kind\t" + to_string(count_by_dispatch_kind(dk)))
                return
            }
            println("usage: hexa run pe_d3d11_compute_shader.hexa count <dispatch_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdcs()
            println("cleaned: " + pdcs_dir())
            return
        }
        if sub == "dir" {
            println(pdcs_dir())
            return
        }
    }
    println("usage: hexa run pe_d3d11_compute_shader.hexa { self-test | stats | groups <dispatch_id> | count <dispatch_kind> | cleanup | dir }")
}
