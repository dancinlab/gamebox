// lib/loader/pe_semaphore_object.hexa — cycle 71 Win32 Semaphore → POSIX sem_t bridge skeleton
//
// Win32 CreateSemaphore / ReleaseSemaphore / WaitForSingleObject(sem) →
// POSIX sem_t (sem_init / sem_post / sem_wait / sem_timedwait) 매핑 tracker.
// release_count = ReleaseSemaphore(lReleaseCount), prior_count = 직전 sem
// count (Win32 lpPreviousCount out-param semantics).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 semaphore op tracker — 실 sem_init() / sem_post() / sem_wait() 호출 X (다음 cycle).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = create        (CreateSemaphore)
//   2 = release       (ReleaseSemaphore)
//   3 = wait_succeed  (WaitForSingleObject → WAIT_OBJECT_0)
//   4 = wait_timeout  (WaitForSingleObject → WAIT_TIMEOUT)
//
// persist schema (TSV — ops.tsv):
//   sem_id<int> \t op_kind<int> \t release_count<int> \t prior_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pso_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_semaphore_object"
}

fn pso_ops_path() -> str {
    return pso_dir() + "/ops.tsv"
}

fn pso_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pso_dir() + "'")
}

fn cleanup_pso() -> void {
    pso_ensure_dir()
    let _ = exec("rm -f '" + pso_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pso_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pso_append_row(path: str, row: str) -> void {
    pso_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: semaphore op 1 건 기록 ───
fn record_op(sem_id: int, op_kind: int, release_count: int, prior_count: int) -> void {
    if sem_id <= 0 {
        panic("pe_semaphore_object FAIL [record_op] expected=sem_id>0 got=" + to_string(sem_id))
    }
    if op_kind < 1 {
        panic("pe_semaphore_object FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 4 {
        panic("pe_semaphore_object FAIL [record_op] expected=op_kind<=4 got=" + to_string(op_kind))
    }
    if release_count < 0 {
        panic("pe_semaphore_object FAIL [record_op] expected=release_count>=0 got=" + to_string(release_count))
    }
    if prior_count < 0 {
        panic("pe_semaphore_object FAIL [record_op] expected=prior_count>=0 got=" + to_string(prior_count))
    }
    let row = to_string(sem_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(release_count) + "\t" + to_string(prior_count) + "\n"
    pso_append_row(pso_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pso_read_table(pso_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_releases: 모든 op release_count 합 ───
fn total_releases() -> int {
    let t = pso_read_table(pso_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = pso_read_table(pso_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── wait_timeout_count: op_kind=4 (wait_timeout) 인 op 수 ───
fn wait_timeout_count() -> int {
    return count_by_op_kind(4)
}

// ─── sem_prior_count: 특정 sem_id 의 prior_count 합 ───
fn sem_prior_count(sem_id: int) -> int {
    let t = pso_read_table(pso_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == sem_id {
                    sum = sum + to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return sum
}

// ─── pso_stats: [op_count, total_releases, wait_timeout_count, count_by_op_kind(2)] ───
fn pso_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_releases())
    out.push(wait_timeout_count())
    out.push(count_by_op_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pso-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pso()

    // 2. record 6 semaphore ops across 4 op_kinds, ≥1 timeout
    //    sem_id=1 lifecycle: create → release(1) → wait_succeed(prior=1) →
    //                        release(2) → wait_timeout → wait_succeed(prior=2)
    record_op(1, 1, 0, 0)
    r0_emit("pe_semaphore_object_record",
        "\"sem_id\":1,\"op_kind\":1,\"release_count\":0,\"prior_count\":0,\"target\":\"create\"")

    record_op(1, 2, 1, 0)
    r0_emit("pe_semaphore_object_record",
        "\"sem_id\":1,\"op_kind\":2,\"release_count\":1,\"prior_count\":0,\"target\":\"release\"")

    record_op(1, 3, 0, 1)
    r0_emit("pe_semaphore_object_record",
        "\"sem_id\":1,\"op_kind\":3,\"release_count\":0,\"prior_count\":1,\"target\":\"wait_succeed\"")

    record_op(1, 2, 2, 0)
    r0_emit("pe_semaphore_object_record",
        "\"sem_id\":1,\"op_kind\":2,\"release_count\":2,\"prior_count\":0,\"target\":\"release\"")

    record_op(1, 4, 0, 0)
    r0_emit("pe_semaphore_object_record",
        "\"sem_id\":1,\"op_kind\":4,\"release_count\":0,\"prior_count\":0,\"target\":\"wait_timeout\"")

    record_op(1, 3, 0, 2)
    r0_emit("pe_semaphore_object_record",
        "\"sem_id\":1,\"op_kind\":3,\"release_count\":0,\"prior_count\":2,\"target\":\"wait_succeed\"")

    // 3. op_count = 6
    let c = op_count()
    if c != 6 {
        panic("pe_semaphore_object FAIL [op_count] expected=6 got=" + to_string(c))
    }

    // 4. total_releases = 1 + 2 = 3
    let tr = total_releases()
    if tr != 3 {
        panic("pe_semaphore_object FAIL [total_releases] expected=3 got=" + to_string(tr))
    }

    // 5. count_by_op_kind sanity
    let k1 = count_by_op_kind(1)
    if k1 != 1 {
        panic("pe_semaphore_object FAIL [count_by_op_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 2 {
        panic("pe_semaphore_object FAIL [count_by_op_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 2 {
        panic("pe_semaphore_object FAIL [count_by_op_kind(3)] expected=2 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 1 {
        panic("pe_semaphore_object FAIL [count_by_op_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_semaphore_object FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. wait_timeout_count = 1 (≥1 timeout)
    let wt = wait_timeout_count()
    if wt != 1 {
        panic("pe_semaphore_object FAIL [wait_timeout_count] expected=1 got=" + to_string(wt))
    }

    // 7. sem_prior_count(1) = 0+0+1+0+0+2 = 3
    let sp1 = sem_prior_count(1)
    if sp1 != 3 {
        panic("pe_semaphore_object FAIL [sem_prior_count(1)] expected=3 got=" + to_string(sp1))
    }
    let sp_miss = sem_prior_count(9999)
    if sp_miss != 0 {
        panic("pe_semaphore_object FAIL [sem_prior_count(9999)] expected=0 got=" + to_string(sp_miss))
    }

    // 8. pso_stats() = [6, 3, 1, 2]
    let s = pso_stats()
    if len(s) != 4 {
        panic("pe_semaphore_object FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_semaphore_object FAIL [stats op_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_semaphore_object FAIL [stats total_releases] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_semaphore_object FAIL [stats wait_timeout_count] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_semaphore_object FAIL [stats count_kind(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_semaphore_object_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_releases\":" + to_string(s[1])
        + ",\"wait_timeout_count\":" + to_string(s[2])
        + ",\"kind_release\":" + to_string(s[3]))

    // 10. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_semaphore_object FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pso()
    let s2 = pso_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_semaphore_object FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_semaphore_object self_test PASS (ops=" + to_string(s[0])
        + ", releases=" + to_string(s[1]) + ", timeouts=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pso_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_releases\t" + to_string(s[1]))
            println("wait_timeout_count\t" + to_string(s[2]))
            println("count_kind_release\t" + to_string(s[3]))
            return
        }
        if sub == "prior" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("sem_prior_count\t" + to_string(sem_prior_count(sid)))
                return
            }
            println("usage: hexa run pe_semaphore_object.hexa prior <sem_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_semaphore_object.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pso()
            println("cleaned: " + pso_dir())
            return
        }
        if sub == "dir" {
            println(pso_dir())
            return
        }
    }
    println("usage: hexa run pe_semaphore_object.hexa { self-test | stats | prior <sem_id> | count <op_kind> | cleanup | dir }")
}
