// lib/loader/pe_i386_relocation_highlow.hexa — i386 IMAGE_REL_BASED_HIGHLOW (type 3): 32bit absolute address patch.
//
// Battle.net-Setup.exe imagebase=0x400000 (lo=4194304), if remapped to 0x10000000 → delta=0xFC00000,
// all HIGHLOW entries += delta. x64 DIR64 (type 10) 64bit absolute (cycle 80 pe_reloc_applier_real cross-ref).
// own1: PE spec only.
//
// IMAGE_BASE_RELOCATION block walking (i386 PE32):
//   block.SizeOfBlock - sizeof(BLOCK) → entry array (uint16: kind<<12 | offset[12])
//   IMAGE_REL_BASED_HIGHLOW (3) — PE32 32bit absolute (i386 binary), delta 적용
//   IMAGE_REL_BASED_HIGH (1) — high 16 bits
//   IMAGE_REL_BASED_LOW (2) — low 16 bits
//   IMAGE_REL_BASED_ABSOLUTE (0) — padding, skip
//   IMAGE_REL_BASED_MIPS_JMPADDR16 (5) — MIPS only (보통 i386 부재)
// own1: PE spec only, Wine relocate.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// relocation_kind code (PE spec §6.6 Base Relocation Block):
//   0  = IMAGE_REL_BASED_ABSOLUTE       (padding, skip)
//   1  = IMAGE_REL_BASED_HIGH           (high 16 bits)
//   2  = IMAGE_REL_BASED_LOW            (low 16 bits)
//   3  = IMAGE_REL_BASED_HIGHLOW        (PE32 32bit absolute — i386 본 module 주 대상)
//   5  = IMAGE_REL_BASED_MIPS_JMPADDR16 (MIPS only)
//   10 = IMAGE_REL_BASED_DIR64          (PE32+ 64bit absolute, 본 module 범위 외)
//
// persist schema (TSV — blocks.tsv):
//   block_id<int> \t relocation_kind<int> \t entry_count<int> \t rva_base<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pirh_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_i386_relocation_highlow"
}

fn pirh_blocks_path() -> str {
    return pirh_dir() + "/blocks.tsv"
}

fn pirh_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pirh_dir() + "'")
}

fn cleanup_pirh() -> void {
    pirh_ensure_dir()
    let _ = exec("rm -f '" + pirh_blocks_path() + "'")
}

// ─── 공통 file IO ───
fn pirh_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pirh_append_row(path: str, row: str) -> void {
    pirh_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_block: i386 IMAGE_BASE_RELOCATION block 1 건 기록 ───
fn record_block(block_id: int, relocation_kind: int, entry_count: int, rva_base: int) -> void {
    if block_id <= 0 {
        panic("pe_i386_relocation_highlow FAIL [record_block] expected=block_id>0 got=" + to_string(block_id))
    }
    if relocation_kind < 0 {
        panic("pe_i386_relocation_highlow FAIL [record_block] expected=relocation_kind>=0 got=" + to_string(relocation_kind))
    }
    if relocation_kind > 10 {
        panic("pe_i386_relocation_highlow FAIL [record_block] expected=relocation_kind<=10 got=" + to_string(relocation_kind))
    }
    if entry_count < 0 {
        panic("pe_i386_relocation_highlow FAIL [record_block] expected=entry_count>=0 got=" + to_string(entry_count))
    }
    if rva_base < 0 {
        panic("pe_i386_relocation_highlow FAIL [record_block] expected=rva_base>=0 got=" + to_string(rva_base))
    }
    let row = to_string(block_id) + "\t" + to_string(relocation_kind)
        + "\t" + to_string(entry_count) + "\t" + to_string(rva_base) + "\n"
    pirh_append_row(pirh_blocks_path(), row)
}

// ─── block_count: total block 수 ───
fn block_count() -> int {
    let t = pirh_read_table(pirh_blocks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_entry_count: 모든 block entry_count 합 ───
fn total_entry_count() -> int {
    let t = pirh_read_table(pirh_blocks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_relocation_kind: 특정 relocation_kind 의 block 수 ───
fn count_by_relocation_kind(kind: int) -> int {
    let t = pirh_read_table(pirh_blocks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── highlow_count: IMAGE_REL_BASED_HIGHLOW(3) — i386 PE32 주 대상 ───
fn highlow_count() -> int {
    return count_by_relocation_kind(3)
}

// ─── block_entry_count: 특정 block_id 의 entry_count (없으면 0) ───
fn block_entry_count(block_id: int) -> int {
    let t = pirh_read_table(pirh_blocks_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == block_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pirh_stats: [block_count, total_entry_count, highlow_count, count_by_relocation_kind(0)] ───
fn pirh_stats() -> array {
    let mut out = []
    out.push(block_count())
    out.push(total_entry_count())
    out.push(highlow_count())
    out.push(count_by_relocation_kind(0))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pirh-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pirh()

    // 2. record 5 blocks covering ≥3 relocation_kinds (HIGHLOW=3, ABSOLUTE=0, HIGH=1)
    //    realistic rva_base values per i386 PE32 .reloc directory layout.
    //    Battle.net-Setup.exe imagebase=0x400000 → HIGHLOW entries 32bit absolute patch.
    record_block(310001, 3, 256, 4096)   // 0x1000 — HIGHLOW (i386 PE32)
    r0_emit("pe_i386_relocation_highlow_record",
        "\"block_id\":310001,\"relocation_kind\":3,\"entry_count\":256,\"rva_base\":4096,\"target\":\"HIGHLOW\"")

    record_block(310002, 3, 128, 8192)   // 0x2000 — HIGHLOW (i386 PE32)
    r0_emit("pe_i386_relocation_highlow_record",
        "\"block_id\":310002,\"relocation_kind\":3,\"entry_count\":128,\"rva_base\":8192,\"target\":\"HIGHLOW\"")

    record_block(310003, 0, 1, 12288)    // 0x3000 — ABSOLUTE padding
    r0_emit("pe_i386_relocation_highlow_record",
        "\"block_id\":310003,\"relocation_kind\":0,\"entry_count\":1,\"rva_base\":12288,\"target\":\"ABSOLUTE\"")

    record_block(310004, 3, 64, 16384)   // 0x4000 — HIGHLOW (i386 PE32)
    r0_emit("pe_i386_relocation_highlow_record",
        "\"block_id\":310004,\"relocation_kind\":3,\"entry_count\":64,\"rva_base\":16384,\"target\":\"HIGHLOW\"")

    record_block(310005, 1, 4, 20480)    // 0x5000 — HIGH (rare, but PE spec valid)
    r0_emit("pe_i386_relocation_highlow_record",
        "\"block_id\":310005,\"relocation_kind\":1,\"entry_count\":4,\"rva_base\":20480,\"target\":\"HIGH\"")

    // 3. block_count = 5
    let c = block_count()
    if c != 5 {
        panic("pe_i386_relocation_highlow FAIL [block_count] expected=5 got=" + to_string(c))
    }

    // 4. total_entry_count = 256 + 128 + 1 + 64 + 4 = 453
    let te = total_entry_count()
    if te != 453 {
        panic("pe_i386_relocation_highlow FAIL [total_entry_count] expected=453 got=" + to_string(te))
    }

    // 5. count_by_relocation_kind sanity
    let k0 = count_by_relocation_kind(0)
    if k0 != 1 {
        panic("pe_i386_relocation_highlow FAIL [count_by_relocation_kind(0)] expected=1 got=" + to_string(k0))
    }
    let k1 = count_by_relocation_kind(1)
    if k1 != 1 {
        panic("pe_i386_relocation_highlow FAIL [count_by_relocation_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k3 = count_by_relocation_kind(3)
    if k3 != 3 {
        panic("pe_i386_relocation_highlow FAIL [count_by_relocation_kind(3)] expected=3 got=" + to_string(k3))
    }
    let k10 = count_by_relocation_kind(10)
    if k10 != 0 {
        panic("pe_i386_relocation_highlow FAIL [count_by_relocation_kind(10)] expected=0 got=" + to_string(k10))
    }
    let k99 = count_by_relocation_kind(99)
    if k99 != 0 {
        panic("pe_i386_relocation_highlow FAIL [count_by_relocation_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. highlow_count = 3 (i386 PE32 주 대상)
    let hl = highlow_count()
    if hl != 3 {
        panic("pe_i386_relocation_highlow FAIL [highlow_count] expected=3 got=" + to_string(hl))
    }

    // 7. block_entry_count sanity
    let e1 = block_entry_count(310001)
    if e1 != 256 {
        panic("pe_i386_relocation_highlow FAIL [block_entry_count(310001)] expected=256 got=" + to_string(e1))
    }
    let e3 = block_entry_count(310003)
    if e3 != 1 {
        panic("pe_i386_relocation_highlow FAIL [block_entry_count(310003)] expected=1 got=" + to_string(e3))
    }
    let e_miss = block_entry_count(9999)
    if e_miss != 0 {
        panic("pe_i386_relocation_highlow FAIL [block_entry_count(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 8. pirh_stats() = [5, 453, 3, 1]
    let s = pirh_stats()
    if len(s) != 4 {
        panic("pe_i386_relocation_highlow FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_i386_relocation_highlow FAIL [stats block_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 453 {
        panic("pe_i386_relocation_highlow FAIL [stats total_entry_count] expected=453 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_i386_relocation_highlow FAIL [stats highlow_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_i386_relocation_highlow FAIL [stats absolute_count] expected=1 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_i386_relocation_highlow_stats",
        "\"block_count\":" + to_string(s[0])
        + ",\"total_entry_count\":" + to_string(s[1])
        + ",\"highlow_count\":" + to_string(s[2])
        + ",\"absolute_count\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_i386_relocation_highlow FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pirh()
    let s2 = pirh_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_i386_relocation_highlow FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_i386_relocation_highlow self_test PASS (blocks=" + to_string(s[0])
        + ", entries=" + to_string(s[1]) + ", highlow=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pirh_stats()
            println("block_count\t" + to_string(s[0]))
            println("total_entry_count\t" + to_string(s[1]))
            println("highlow_count\t" + to_string(s[2]))
            println("absolute_count\t" + to_string(s[3]))
            return
        }
        if sub == "entries" {
            if len(a) >= 4 {
                let bid = to_int(a[3])
                println("block_entry_count\t" + to_string(block_entry_count(bid)))
                return
            }
            println("usage: hexa run pe_i386_relocation_highlow.hexa entries <block_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_relocation_kind\t" + to_string(count_by_relocation_kind(kind)))
                return
            }
            println("usage: hexa run pe_i386_relocation_highlow.hexa count <relocation_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pirh()
            println("cleaned: " + pirh_dir())
            return
        }
        if sub == "dir" {
            println(pirh_dir())
            return
        }
    }
    println("usage: hexa run pe_i386_relocation_highlow.hexa { self-test | stats | entries <block_id> | count <relocation_kind> | cleanup | dir }")
}
