// lib/loader/pe_gdi_dc_compatible.hexa — stage1 GDI CreateCompatibleDC bridge skeleton
//
// Win32 GDI CreateCompatibleDC/CreateCompatibleBitmap → CGBitmapContextCreate
// bridge telemetry. dc_id 별 width/height/dc_kind 추적 — 실 CGBitmapContext 호출
// X (stage2). bridge planner 가 메모리 footprint, dc_kind 분포 분석에 사용.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 GDI DC tracker — 실 CreateCompatibleDC()/CGBitmapContextCreate()
//   호출 X (stage2).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// dc_kind code:
//   1 = display    (screen DC — root)
//   2 = memory     (CreateCompatibleDC — offscreen)
//   3 = printer    (CreateDC printer)
//   4 = metafile   (CreateMetaFile / CreateEnhMetaFile)
//   5 = info       (CreateIC — info-only)
//
// persist schema (TSV — dcs.tsv):
//   dc_id<int> \t dc_kind<int> \t width_px<int> \t height_px<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pgdc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_gdi_dc_compatible"
}

fn pgdc_dcs_path() -> str {
    return pgdc_dir() + "/dcs.tsv"
}

fn pgdc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pgdc_dir() + "'")
}

fn cleanup_pgdc() -> void {
    pgdc_ensure_dir()
    let _ = exec("rm -f '" + pgdc_dcs_path() + "'")
}

// ─── 공통 file IO ───
fn pgdc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pgdc_append_row(path: str, row: str) -> void {
    pgdc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dc: DC 1 건 기록 ───
fn record_dc(dc_id: int, dc_kind: int, width_px: int, height_px: int) -> void {
    if dc_id <= 0 {
        panic("pe_gdi_dc_compatible FAIL [record_dc] expected=dc_id>0 got=" + to_string(dc_id))
    }
    if dc_kind < 1 {
        panic("pe_gdi_dc_compatible FAIL [record_dc] expected=dc_kind>=1 got=" + to_string(dc_kind))
    }
    if dc_kind > 5 {
        panic("pe_gdi_dc_compatible FAIL [record_dc] expected=dc_kind<=5 got=" + to_string(dc_kind))
    }
    if width_px < 0 {
        panic("pe_gdi_dc_compatible FAIL [record_dc] expected=width_px>=0 got=" + to_string(width_px))
    }
    if height_px < 0 {
        panic("pe_gdi_dc_compatible FAIL [record_dc] expected=height_px>=0 got=" + to_string(height_px))
    }
    let row = to_string(dc_id) + "\t" + to_string(dc_kind)
        + "\t" + to_string(width_px) + "\t" + to_string(height_px) + "\n"
    pgdc_append_row(pgdc_dcs_path(), row)
}

// ─── dc_count: total DC 수 ───
fn dc_count() -> int {
    let t = pgdc_read_table(pgdc_dcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_pixel_count: 모든 DC width_px*height_px 합 ───
fn total_pixel_count() -> int {
    let t = pgdc_read_table(pgdc_dcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2]) * to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_dc_kind: 특정 dc_kind 의 DC 수 ───
fn count_by_dc_kind(dc_kind: int) -> int {
    let t = pgdc_read_table(pgdc_dcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == dc_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── largest_dc: width_px*height_px 최대 dc_id (없으면 0) ───
fn largest_dc() -> int {
    let t = pgdc_read_table(pgdc_dcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut best_id = 0
    let mut best_px = -1
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let px = to_int(parts[2]) * to_int(parts[3])
                if px > best_px {
                    best_px = px
                    best_id = to_int(parts[0])
                }
            }
        }
        i = i + 1
    }
    return best_id
}

// ─── dc_width_px: 특정 dc_id 의 width_px (없으면 0) ───
fn dc_width_px(dc_id: int) -> int {
    let t = pgdc_read_table(pgdc_dcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == dc_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pgdc_stats: [dc_count, total_pixel_count, largest_dc, count_by_dc_kind(2)] ───
fn pgdc_stats() -> array {
    let mut out = []
    out.push(dc_count())
    out.push(total_pixel_count())
    out.push(largest_dc())
    out.push(count_by_dc_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pgdc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pgdc()

    // 2. record 5 DCs across ≥3 dc_kinds (display, memory x2, printer, info)
    //    pixel counts: 1920*1080=2073600, 800*600=480000, 1280*720=921600,
    //                  2480*3508=8699840, 1024*768=786432
    //    total = 12961472, largest = dc_id=400004 (printer 2480*3508)
    record_dc(400001, 1, 1920, 1080)
    r0_emit("pe_gdi_dc_compatible_record",
        "\"dc_id\":400001,\"dc_kind\":1,\"width_px\":1920,\"height_px\":1080,\"target\":\"display\"")

    record_dc(400002, 2, 800, 600)
    r0_emit("pe_gdi_dc_compatible_record",
        "\"dc_id\":400002,\"dc_kind\":2,\"width_px\":800,\"height_px\":600,\"target\":\"memory\"")

    record_dc(400003, 2, 1280, 720)
    r0_emit("pe_gdi_dc_compatible_record",
        "\"dc_id\":400003,\"dc_kind\":2,\"width_px\":1280,\"height_px\":720,\"target\":\"memory\"")

    record_dc(400004, 3, 2480, 3508)
    r0_emit("pe_gdi_dc_compatible_record",
        "\"dc_id\":400004,\"dc_kind\":3,\"width_px\":2480,\"height_px\":3508,\"target\":\"printer\"")

    record_dc(400005, 5, 1024, 768)
    r0_emit("pe_gdi_dc_compatible_record",
        "\"dc_id\":400005,\"dc_kind\":5,\"width_px\":1024,\"height_px\":768,\"target\":\"info\"")

    // 3. dc_count = 5
    let c = dc_count()
    if c != 5 {
        panic("pe_gdi_dc_compatible FAIL [dc_count] expected=5 got=" + to_string(c))
    }

    // 4. total_pixel_count = 12961472
    let tp = total_pixel_count()
    if tp != 12961472 {
        panic("pe_gdi_dc_compatible FAIL [total_pixel_count] expected=12961472 got=" + to_string(tp))
    }

    // 5. count_by_dc_kind sanity
    let k1 = count_by_dc_kind(1)
    if k1 != 1 {
        panic("pe_gdi_dc_compatible FAIL [count_by_dc_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_dc_kind(2)
    if k2 != 2 {
        panic("pe_gdi_dc_compatible FAIL [count_by_dc_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_dc_kind(3)
    if k3 != 1 {
        panic("pe_gdi_dc_compatible FAIL [count_by_dc_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_dc_kind(4)
    if k4 != 0 {
        panic("pe_gdi_dc_compatible FAIL [count_by_dc_kind(4)] expected=0 got=" + to_string(k4))
    }
    let k5 = count_by_dc_kind(5)
    if k5 != 1 {
        panic("pe_gdi_dc_compatible FAIL [count_by_dc_kind(5)] expected=1 got=" + to_string(k5))
    }

    // 6. largest_dc = 400004 (2480*3508 = 8700320)
    let ld = largest_dc()
    if ld != 400004 {
        panic("pe_gdi_dc_compatible FAIL [largest_dc] expected=400004 got=" + to_string(ld))
    }

    // 7. dc_width_px sanity
    let w1 = dc_width_px(400001)
    if w1 != 1920 {
        panic("pe_gdi_dc_compatible FAIL [dc_width_px(400001)] expected=1920 got=" + to_string(w1))
    }
    let w4 = dc_width_px(400004)
    if w4 != 2480 {
        panic("pe_gdi_dc_compatible FAIL [dc_width_px(400004)] expected=2480 got=" + to_string(w4))
    }
    let w_miss = dc_width_px(9999)
    if w_miss != 0 {
        panic("pe_gdi_dc_compatible FAIL [dc_width_px(9999)] expected=0 got=" + to_string(w_miss))
    }

    // 8. pgdc_stats() = [5, 12961472, 400004, 2]
    let s = pgdc_stats()
    if len(s) != 4 {
        panic("pe_gdi_dc_compatible FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_gdi_dc_compatible FAIL [stats dc_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 12961472 {
        panic("pe_gdi_dc_compatible FAIL [stats total_pixel_count] expected=12961472 got=" + to_string(s[1]))
    }
    if s[2] != 400004 {
        panic("pe_gdi_dc_compatible FAIL [stats largest_dc] expected=400004 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_gdi_dc_compatible FAIL [stats count_kind(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_gdi_dc_compatible_stats",
        "\"dc_count\":" + to_string(s[0])
        + ",\"total_pixel_count\":" + to_string(s[1])
        + ",\"largest_dc\":" + to_string(s[2])
        + ",\"kind_memory\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_gdi_dc_compatible FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pgdc()
    let s2 = pgdc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_gdi_dc_compatible FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_gdi_dc_compatible self_test PASS (dcs=" + to_string(s[0])
        + ", pixels=" + to_string(s[1]) + ", largest=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pgdc_stats()
            println("dc_count\t" + to_string(s[0]))
            println("total_pixel_count\t" + to_string(s[1]))
            println("largest_dc\t" + to_string(s[2]))
            println("count_kind_memory\t" + to_string(s[3]))
            return
        }
        if sub == "width" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("dc_width_px\t" + to_string(dc_width_px(did)))
                return
            }
            println("usage: hexa run pe_gdi_dc_compatible.hexa width <dc_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_dc_kind\t" + to_string(count_by_dc_kind(kind)))
                return
            }
            println("usage: hexa run pe_gdi_dc_compatible.hexa count <dc_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pgdc()
            println("cleaned: " + pgdc_dir())
            return
        }
        if sub == "dir" {
            println(pgdc_dir())
            return
        }
    }
    println("usage: hexa run pe_gdi_dc_compatible.hexa { self-test | stats | width <dc_id> | count <dc_kind> | cleanup | dir }")
}
