// lib/loader/win32_version_tier1_real.hexa — cycle 81 R6 Tier 1 VERSION.dll trivial impl tracker
//
// Tier 1 trivial VERSION → Apple-native:
//   GetFileVersionInfoSizeW  → PE Resource VS_VERSION_INFO size 추출 (cycle 79 pe_resource_string cross-ref)
//   GetFileVersionInfoW      → VS_VERSION_INFO + VS_FIXEDFILEINFO struct copy
//   VerQueryValueW           → "\\StringFileInfo\\<lang>\\<name>" path lookup
//   VerLanguageNameW         → LCID → ISO 639 + 매핑 테이블 (1042=ko-KR/1041=ja-JP/...)
// own1: PE/COFF + MSDN VS_VERSION_INFO spec only. Wine version/info.c 인용 X
//
// own 1 enforcement: Wine / Reactos / CrossOver / community 코드 0 줄.
//   본 module 은 VERSION Tier 1 trivial 함수 호출 tracker — 실 native dispatch X.
//   Apple-native mapping 은 docstring 만 (실 PE resource walker stage6).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code (VERSION.dll export):
//   1 = GetFileVersionInfoSizeW
//   2 = GetFileVersionInfoW
//   3 = VerQueryValueW
//   4 = VerLanguageNameW
//
// impl_status code:
//   1 = real_pe_resource (PE .rsrc walker — VS_VERSION_INFO/VS_FIXEDFILEINFO struct copy)
//   2 = stub_constant    (deterministic constant return — Tier 1 placeholder)
//   3 = stub_string      (StringFileInfo path lookup placeholder)
//   4 = deprecated_zero  (invalid LCID / unknown path — always 0)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t impl_status<int> \t return_value<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wvt1_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_version_tier1_real"
}

fn wvt1_calls_path() -> str {
    return wvt1_dir() + "/calls.tsv"
}

fn wvt1_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wvt1_dir() + "'")
}

fn cleanup_wvt1() -> void {
    wvt1_ensure_dir()
    let _ = exec("rm -f '" + wvt1_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wvt1_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wvt1_append_row(path: str, row: str) -> void {
    wvt1_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: VERSION Tier 1 호출 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, impl_status: int, return_value: int) -> void {
    if call_id <= 0 {
        panic("win32_version_tier1_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_version_tier1_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 4 {
        panic("win32_version_tier1_real FAIL [record_call] expected=func_kind<=4 got=" + to_string(func_kind))
    }
    if impl_status < 1 {
        panic("win32_version_tier1_real FAIL [record_call] expected=impl_status>=1 got=" + to_string(impl_status))
    }
    if impl_status > 4 {
        panic("win32_version_tier1_real FAIL [record_call] expected=impl_status<=4 got=" + to_string(impl_status))
    }
    if return_value < 0 {
        panic("win32_version_tier1_real FAIL [record_call] expected=return_value>=0 got=" + to_string(return_value))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(impl_status) + "\t" + to_string(return_value) + "\n"
    wvt1_append_row(wvt1_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wvt1_read_table(wvt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 호출 수 ───
fn count_by_func_kind(func_kind: int) -> int {
    let t = wvt1_read_table(wvt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == func_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_impl_status: 특정 impl_status 의 호출 수 ───
fn count_by_impl_status(impl_status: int) -> int {
    let t = wvt1_read_table(wvt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == impl_status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── real_pe_resource_count: impl_status=1 (real_pe_resource) 호출 수 ───
fn real_pe_resource_count() -> int {
    return count_by_impl_status(1)
}

// ─── total_return_value: 모든 호출 return_value 합 ───
fn total_return_value() -> int {
    let t = wvt1_read_table(wvt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── call_return_value: 특정 call_id 의 return_value (없으면 0) ───
fn call_return_value(call_id: int) -> int {
    let t = wvt1_read_table(wvt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wvt1_stats: [call_count, real_pe_resource_count, total_return_value, count_by_impl_status(4)] ───
fn wvt1_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(real_pe_resource_count())
    out.push(total_return_value())
    out.push(count_by_impl_status(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wvt1-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wvt1()

    // 2. record 5 calls — all 4 func_kinds + all 4 impl_statuses covered
    //    func_kinds: 1 (GetFileVersionInfoSizeW), 2 (GetFileVersionInfoW),
    //                3 (VerQueryValueW), 4 (VerLanguageNameW) ×2
    //    impl_statuses: 1 (real_pe_resource) ×2, 2 (stub_constant) ×1,
    //                   3 (stub_string) ×1, 4 (deprecated_zero) ×1

    // call 1: GetFileVersionInfoSizeW → real_pe_resource (PE .rsrc VS_VERSION_INFO size) → 1024 bytes
    record_call(820001, 1, 1, 1024)
    r0_emit("win32_version_tier1_real_record",
        "\"call_id\":820001,\"func_kind\":1,\"impl_status\":1,\"return_value\":1024,\"target\":\"GetFileVersionInfoSizeW\",\"native\":\"pe_rsrc_vs_version_info_size\"")

    // call 2: GetFileVersionInfoW → real_pe_resource (VS_FIXEDFILEINFO struct copy) → 1 (BOOL TRUE)
    record_call(820002, 2, 1, 1)
    r0_emit("win32_version_tier1_real_record",
        "\"call_id\":820002,\"func_kind\":2,\"impl_status\":1,\"return_value\":1,\"target\":\"GetFileVersionInfoW\",\"native\":\"pe_rsrc_vs_fixedfileinfo_copy\"")

    // call 3: VerQueryValueW → stub_string ("\\StringFileInfo\\040904E4\\ProductName" lookup) → 1 (BOOL TRUE)
    record_call(820003, 3, 3, 1)
    r0_emit("win32_version_tier1_real_record",
        "\"call_id\":820003,\"func_kind\":3,\"impl_status\":3,\"return_value\":1,\"target\":\"VerQueryValueW\",\"native\":\"stringfileinfo_path_lookup\"")

    // call 4: VerLanguageNameW(1042) → stub_constant (LCID 1042 → "ko-KR") → 5 chars copied
    record_call(820004, 4, 2, 5)
    r0_emit("win32_version_tier1_real_record",
        "\"call_id\":820004,\"func_kind\":4,\"impl_status\":2,\"return_value\":5,\"target\":\"VerLanguageNameW\",\"native\":\"lcid_1042_ko_KR\"")

    // call 5: VerLanguageNameW(0xFFFF) → deprecated_zero (invalid LCID — always 0) → 0
    record_call(820005, 4, 4, 0)
    r0_emit("win32_version_tier1_real_record",
        "\"call_id\":820005,\"func_kind\":4,\"impl_status\":4,\"return_value\":0,\"target\":\"VerLanguageNameW\",\"native\":\"invalid_lcid_zero\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("win32_version_tier1_real FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (all 4 covered)
    let fk1 = count_by_func_kind(1)
    if fk1 != 1 {
        panic("win32_version_tier1_real FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(fk1))
    }
    let fk2 = count_by_func_kind(2)
    if fk2 != 1 {
        panic("win32_version_tier1_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(fk2))
    }
    let fk3 = count_by_func_kind(3)
    if fk3 != 1 {
        panic("win32_version_tier1_real FAIL [count_by_func_kind(3)] expected=1 got=" + to_string(fk3))
    }
    let fk4 = count_by_func_kind(4)
    if fk4 != 2 {
        panic("win32_version_tier1_real FAIL [count_by_func_kind(4)] expected=2 got=" + to_string(fk4))
    }

    // 5. count_by_impl_status — all 4 covered
    let is1 = count_by_impl_status(1)
    if is1 != 2 {
        panic("win32_version_tier1_real FAIL [count_by_impl_status(1)] expected=2 got=" + to_string(is1))
    }
    let is2 = count_by_impl_status(2)
    if is2 != 1 {
        panic("win32_version_tier1_real FAIL [count_by_impl_status(2)] expected=1 got=" + to_string(is2))
    }
    let is3 = count_by_impl_status(3)
    if is3 != 1 {
        panic("win32_version_tier1_real FAIL [count_by_impl_status(3)] expected=1 got=" + to_string(is3))
    }
    let is4 = count_by_impl_status(4)
    if is4 != 1 {
        panic("win32_version_tier1_real FAIL [count_by_impl_status(4)] expected=1 got=" + to_string(is4))
    }

    // 6. real_pe_resource_count = 2
    let rpc = real_pe_resource_count()
    if rpc != 2 {
        panic("win32_version_tier1_real FAIL [real_pe_resource_count] expected=2 got=" + to_string(rpc))
    }

    // 7. total_return_value = 1024 + 1 + 1 + 5 + 0 = 1031
    let trv = total_return_value()
    if trv != 1031 {
        panic("win32_version_tier1_real FAIL [total_return_value] expected=1031 got=" + to_string(trv))
    }

    // 8. call_return_value sanity
    let rv1 = call_return_value(820001)
    if rv1 != 1024 {
        panic("win32_version_tier1_real FAIL [call_return_value(820001)] expected=1024 got=" + to_string(rv1))
    }
    let rv4 = call_return_value(820004)
    if rv4 != 5 {
        panic("win32_version_tier1_real FAIL [call_return_value(820004)] expected=5 got=" + to_string(rv4))
    }
    let rv_miss = call_return_value(9999)
    if rv_miss != 0 {
        panic("win32_version_tier1_real FAIL [call_return_value(9999)] expected=0 got=" + to_string(rv_miss))
    }

    // 9. wvt1_stats() = [5, 2, 1031, 1]
    let s = wvt1_stats()
    if len(s) != 4 {
        panic("win32_version_tier1_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("win32_version_tier1_real FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("win32_version_tier1_real FAIL [stats real_pe_resource_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 1031 {
        panic("win32_version_tier1_real FAIL [stats total_return_value] expected=1031 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("win32_version_tier1_real FAIL [stats deprecated_zero] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("win32_version_tier1_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"real_pe_resource_count\":" + to_string(s[1])
        + ",\"total_return_value\":" + to_string(s[2])
        + ",\"deprecated_zero_count\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("win32_version_tier1_real FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_wvt1()
    let s2 = wvt1_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("win32_version_tier1_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_version_tier1_real self_test PASS (calls=" + to_string(s[0])
        + ", real_pe_resource=" + to_string(s[1]) + ", total_rv=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wvt1_stats()
            println("call_count\t" + to_string(s[0]))
            println("real_pe_resource_count\t" + to_string(s[1]))
            println("total_return_value\t" + to_string(s[2]))
            println("deprecated_zero_count\t" + to_string(s[3]))
            return
        }
        if sub == "return" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_return_value\t" + to_string(call_return_value(cid)))
                return
            }
            println("usage: hexa run win32_version_tier1_real.hexa return <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let mode = a[3]
                let val = to_int(a[4])
                if mode == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if mode == "impl" {
                    println("count_by_impl_status\t" + to_string(count_by_impl_status(val)))
                    return
                }
                println("usage: hexa run win32_version_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
                return
            }
            println("usage: hexa run win32_version_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_wvt1()
            println("cleaned: " + wvt1_dir())
            return
        }
        if sub == "dir" {
            println(wvt1_dir())
            return
        }
    }
    println("usage: hexa run win32_version_tier1_real.hexa { self-test | stats | return <call_id> | count func <func_kind> | count impl <impl_status> | cleanup | dir }")
}
