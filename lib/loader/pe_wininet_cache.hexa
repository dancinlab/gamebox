// lib/loader/pe_wininet_cache.hexa — stage1 Win32 WinINet cache telemetry skeleton
//
// Win32 WinINet API (InternetOpenUrl / InternetReadFile / DeleteUrlCacheEntry)
// 의 URL cache entry 를 추적. 본 module 은 entry tracker — 실 wininet.dll
// 호출 X (stage 후속).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// entry_kind code:
//   1 = normal
//   2 = sticky
//   3 = cookie
//   4 = history
//   5 = ie5_offline
//
// hit code: 0 = miss, 1 = hit
//
// persist schema (TSV — entries.tsv):
//   entry_id<int> \t entry_kind<int> \t size_bytes<int> \t hit<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwic_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_wininet_cache"
}

fn pwic_entries_path() -> str {
    return pwic_dir() + "/entries.tsv"
}

fn pwic_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwic_dir() + "'")
}

fn cleanup_pwic() -> void {
    pwic_ensure_dir()
    let _ = exec("rm -f '" + pwic_entries_path() + "'")
}

// ─── 공통 file IO ───
fn pwic_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwic_append_row(path: str, row: str) -> void {
    pwic_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_entry: cache entry 1 건 기록 ───
fn record_entry(entry_id: int, entry_kind: int, size_bytes: int, hit: int) -> void {
    if entry_id <= 0 {
        panic("pe_wininet_cache FAIL [record_entry] expected=entry_id>0 got=" + to_string(entry_id))
    }
    if entry_kind < 1 {
        panic("pe_wininet_cache FAIL [record_entry] expected=entry_kind>=1 got=" + to_string(entry_kind))
    }
    if entry_kind > 5 {
        panic("pe_wininet_cache FAIL [record_entry] expected=entry_kind<=5 got=" + to_string(entry_kind))
    }
    if size_bytes < 0 {
        panic("pe_wininet_cache FAIL [record_entry] expected=size_bytes>=0 got=" + to_string(size_bytes))
    }
    if hit < 0 {
        panic("pe_wininet_cache FAIL [record_entry] expected=hit>=0 got=" + to_string(hit))
    }
    if hit > 1 {
        panic("pe_wininet_cache FAIL [record_entry] expected=hit<=1 got=" + to_string(hit))
    }
    let row = to_string(entry_id) + "\t" + to_string(entry_kind)
        + "\t" + to_string(size_bytes) + "\t" + to_string(hit) + "\n"
    pwic_append_row(pwic_entries_path(), row)
}

// ─── entry_count: total entry 수 ───
fn entry_count() -> int {
    let t = pwic_read_table(pwic_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_size_bytes: 모든 entry size_bytes 합 ───
fn total_size_bytes() -> int {
    let t = pwic_read_table(pwic_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── hit_count: hit=1 인 entry 수 ───
fn hit_count() -> int {
    let t = pwic_read_table(pwic_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_entry_kind: 특정 entry_kind 의 entry 수 ───
fn count_by_entry_kind(entry_kind: int) -> int {
    let t = pwic_read_table(pwic_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == entry_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── entry_size: 특정 entry_id 의 size_bytes (없으면 0) ───
fn entry_size(entry_id: int) -> int {
    let t = pwic_read_table(pwic_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == entry_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pwic_stats: [entry_count, total_size_bytes, hit_count, count_by_entry_kind(1)] ───
fn pwic_stats() -> array {
    let mut out = []
    out.push(entry_count())
    out.push(total_size_bytes())
    out.push(hit_count())
    out.push(count_by_entry_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pwic-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pwic()

    // 2. record 5 entries across ≥3 entry_kinds with ≥2 hits
    record_entry(120001, 1, 4096, 1)
    r0_emit("pe_wininet_cache_record",
        "\"entry_id\":120001,\"entry_kind\":1,\"size_bytes\":4096,\"hit\":1,\"target\":\"normal\"")

    record_entry(120002, 1, 8192, 0)
    r0_emit("pe_wininet_cache_record",
        "\"entry_id\":120002,\"entry_kind\":1,\"size_bytes\":8192,\"hit\":0,\"target\":\"normal\"")

    record_entry(120003, 2, 16384, 1)
    r0_emit("pe_wininet_cache_record",
        "\"entry_id\":120003,\"entry_kind\":2,\"size_bytes\":16384,\"hit\":1,\"target\":\"sticky\"")

    record_entry(120004, 3, 512, 0)
    r0_emit("pe_wininet_cache_record",
        "\"entry_id\":120004,\"entry_kind\":3,\"size_bytes\":512,\"hit\":0,\"target\":\"cookie\"")

    record_entry(120005, 4, 2048, 0)
    r0_emit("pe_wininet_cache_record",
        "\"entry_id\":120005,\"entry_kind\":4,\"size_bytes\":2048,\"hit\":0,\"target\":\"history\"")

    // 3. entry_count = 5
    let c = entry_count()
    if c != 5 {
        panic("pe_wininet_cache FAIL [entry_count] expected=5 got=" + to_string(c))
    }

    // 4. total_size_bytes = 31232
    let ts = total_size_bytes()
    if ts != 31232 {
        panic("pe_wininet_cache FAIL [total_size_bytes] expected=31232 got=" + to_string(ts))
    }

    // 5. count_by_entry_kind sanity
    let k1 = count_by_entry_kind(1)
    if k1 != 2 {
        panic("pe_wininet_cache FAIL [count_by_entry_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_entry_kind(2)
    if k2 != 1 {
        panic("pe_wininet_cache FAIL [count_by_entry_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_entry_kind(3)
    if k3 != 1 {
        panic("pe_wininet_cache FAIL [count_by_entry_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_entry_kind(4)
    if k4 != 1 {
        panic("pe_wininet_cache FAIL [count_by_entry_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_entry_kind(5)
    if k5 != 0 {
        panic("pe_wininet_cache FAIL [count_by_entry_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_entry_kind(99)
    if k99 != 0 {
        panic("pe_wininet_cache FAIL [count_by_entry_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. hit_count = 2
    let hc = hit_count()
    if hc != 2 {
        panic("pe_wininet_cache FAIL [hit_count] expected=2 got=" + to_string(hc))
    }

    // 7. entry_size sanity
    let s2 = entry_size(120002)
    if s2 != 8192 {
        panic("pe_wininet_cache FAIL [entry_size(120002)] expected=8192 got=" + to_string(s2))
    }
    let s3 = entry_size(120003)
    if s3 != 16384 {
        panic("pe_wininet_cache FAIL [entry_size(120003)] expected=16384 got=" + to_string(s3))
    }
    let s_miss = entry_size(9999)
    if s_miss != 0 {
        panic("pe_wininet_cache FAIL [entry_size(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 8. pwic_stats() = [5, 31232, 2, 2]
    let s = pwic_stats()
    if len(s) != 4 {
        panic("pe_wininet_cache FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_wininet_cache FAIL [stats entry_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 31232 {
        panic("pe_wininet_cache FAIL [stats total_size_bytes] expected=31232 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_wininet_cache FAIL [stats hit_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_wininet_cache FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_wininet_cache_stats",
        "\"entry_count\":" + to_string(s[0])
        + ",\"total_size_bytes\":" + to_string(s[1])
        + ",\"hit_count\":" + to_string(s[2])
        + ",\"kind_normal\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_wininet_cache FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pwic()
    let s_post = pwic_stats()
    let i = 0
    while i < len(s_post) {
        if s_post[i] != 0 {
            panic("pe_wininet_cache FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s_post[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_wininet_cache self_test PASS (entries=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", hits=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pwic_stats()
            println("entry_count\t" + to_string(s[0]))
            println("total_size_bytes\t" + to_string(s[1]))
            println("hit_count\t" + to_string(s[2]))
            println("count_kind_normal\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let eid = to_int(a[3])
                println("entry_size\t" + to_string(entry_size(eid)))
                return
            }
            println("usage: hexa run pe_wininet_cache.hexa size <entry_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_entry_kind\t" + to_string(count_by_entry_kind(kind)))
                return
            }
            println("usage: hexa run pe_wininet_cache.hexa count <entry_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pwic()
            println("cleaned: " + pwic_dir())
            return
        }
        if sub == "dir" {
            println(pwic_dir())
            return
        }
    }
    println("usage: hexa run pe_wininet_cache.hexa { self-test | stats | size <entry_id> | count <entry_kind> | cleanup | dir }")
}
