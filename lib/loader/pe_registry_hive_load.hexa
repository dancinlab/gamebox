// lib/loader/pe_registry_hive_load.hexa — Win32 RegLoadKey/RegUnLoadKey/RegSaveKey hive op tracker
//
// Battle.net installer 가 SOFTWARE / SAM hive subtree 를 mount/unmount 하는
// 흐름을 추적. RegLoadKey / RegUnLoadKey / RegSaveKey / RegReplaceKey 의
// op 1 건을 행 단위로 persist 한다. 실 hive file IO 는 stage 후속.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 hive op tracker — 실 RegLoadKey() 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// hive_kind code:
//   1 = software
//   2 = system
//   3 = sam
//   4 = security
//   5 = user
//
// operation code:
//   1 = load
//   2 = unload
//   3 = save
//   4 = replace
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t hive_kind<int> \t operation<int> \t hive_size_kb<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn prhl_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_registry_hive_load"
}

fn prhl_ops_path() -> str {
    return prhl_dir() + "/ops.tsv"
}

fn prhl_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + prhl_dir() + "'")
}

fn cleanup_prhl() -> void {
    prhl_ensure_dir()
    let _ = exec("rm -f '" + prhl_ops_path() + "'")
}

// ─── 공통 file IO ───
fn prhl_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn prhl_append_row(path: str, row: str) -> void {
    prhl_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: hive op 1 건 기록 ───
fn record_op(op_id: int, hive_kind: int, operation: int, hive_size_kb: int) -> void {
    if op_id <= 0 {
        panic("pe_registry_hive_load FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if hive_kind < 1 {
        panic("pe_registry_hive_load FAIL [record_op] expected=hive_kind>=1 got=" + to_string(hive_kind))
    }
    if hive_kind > 5 {
        panic("pe_registry_hive_load FAIL [record_op] expected=hive_kind<=5 got=" + to_string(hive_kind))
    }
    if operation < 1 {
        panic("pe_registry_hive_load FAIL [record_op] expected=operation>=1 got=" + to_string(operation))
    }
    if operation > 4 {
        panic("pe_registry_hive_load FAIL [record_op] expected=operation<=4 got=" + to_string(operation))
    }
    if hive_size_kb < 0 {
        panic("pe_registry_hive_load FAIL [record_op] expected=hive_size_kb>=0 got=" + to_string(hive_size_kb))
    }
    let row = to_string(op_id) + "\t" + to_string(hive_kind)
        + "\t" + to_string(operation) + "\t" + to_string(hive_size_kb) + "\n"
    prhl_append_row(prhl_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = prhl_read_table(prhl_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_size_kb: 모든 op hive_size_kb 합 ───
fn total_size_kb() -> int {
    let t = prhl_read_table(prhl_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_hive_kind: 특정 hive_kind 의 op 수 ───
fn count_by_hive_kind(hive_kind: int) -> int {
    let t = prhl_read_table(prhl_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == hive_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_operation: 특정 operation 의 op 수 ───
fn count_by_operation(operation: int) -> int {
    let t = prhl_read_table(prhl_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == operation {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_size_kb: 특정 op_id 의 hive_size_kb (없으면 0) ───
fn op_size_kb(op_id: int) -> int {
    let t = prhl_read_table(prhl_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── prhl_stats: [op_count, total_size_kb, count_by_hive_kind(1), count_by_operation(1)] ───
fn prhl_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_size_kb())
    out.push(count_by_hive_kind(1))
    out.push(count_by_operation(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "prhl-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_prhl()

    // 2. record 5 ops across ≥3 hive_kinds and ≥2 operations
    record_op(720001, 1, 1, 512)
    r0_emit("pe_registry_hive_load_record",
        "\"op_id\":720001,\"hive_kind\":1,\"operation\":1,\"hive_size_kb\":512,\"target\":\"software_load\"")

    record_op(720002, 3, 1, 64)
    r0_emit("pe_registry_hive_load_record",
        "\"op_id\":720002,\"hive_kind\":3,\"operation\":1,\"hive_size_kb\":64,\"target\":\"sam_load\"")

    record_op(720003, 1, 3, 768)
    r0_emit("pe_registry_hive_load_record",
        "\"op_id\":720003,\"hive_kind\":1,\"operation\":3,\"hive_size_kb\":768,\"target\":\"software_save\"")

    record_op(720004, 2, 1, 1024)
    r0_emit("pe_registry_hive_load_record",
        "\"op_id\":720004,\"hive_kind\":2,\"operation\":1,\"hive_size_kb\":1024,\"target\":\"system_load\"")

    record_op(720005, 3, 2, 0)
    r0_emit("pe_registry_hive_load_record",
        "\"op_id\":720005,\"hive_kind\":3,\"operation\":2,\"hive_size_kb\":0,\"target\":\"sam_unload\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_registry_hive_load FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_size_kb = 512 + 64 + 768 + 1024 + 0 = 2368
    let ts = total_size_kb()
    if ts != 2368 {
        panic("pe_registry_hive_load FAIL [total_size_kb] expected=2368 got=" + to_string(ts))
    }

    // 5. count_by_hive_kind sanity
    let h1 = count_by_hive_kind(1)
    if h1 != 2 {
        panic("pe_registry_hive_load FAIL [count_by_hive_kind(1)] expected=2 got=" + to_string(h1))
    }
    let h2 = count_by_hive_kind(2)
    if h2 != 1 {
        panic("pe_registry_hive_load FAIL [count_by_hive_kind(2)] expected=1 got=" + to_string(h2))
    }
    let h3 = count_by_hive_kind(3)
    if h3 != 2 {
        panic("pe_registry_hive_load FAIL [count_by_hive_kind(3)] expected=2 got=" + to_string(h3))
    }
    let h4 = count_by_hive_kind(4)
    if h4 != 0 {
        panic("pe_registry_hive_load FAIL [count_by_hive_kind(4)] expected=0 got=" + to_string(h4))
    }
    let h5 = count_by_hive_kind(5)
    if h5 != 0 {
        panic("pe_registry_hive_load FAIL [count_by_hive_kind(5)] expected=0 got=" + to_string(h5))
    }

    // 6. count_by_operation sanity
    let o1 = count_by_operation(1)
    if o1 != 3 {
        panic("pe_registry_hive_load FAIL [count_by_operation(1)] expected=3 got=" + to_string(o1))
    }
    let o2 = count_by_operation(2)
    if o2 != 1 {
        panic("pe_registry_hive_load FAIL [count_by_operation(2)] expected=1 got=" + to_string(o2))
    }
    let o3 = count_by_operation(3)
    if o3 != 1 {
        panic("pe_registry_hive_load FAIL [count_by_operation(3)] expected=1 got=" + to_string(o3))
    }
    let o4 = count_by_operation(4)
    if o4 != 0 {
        panic("pe_registry_hive_load FAIL [count_by_operation(4)] expected=0 got=" + to_string(o4))
    }

    // 7. op_size_kb sanity
    let s1 = op_size_kb(720001)
    if s1 != 512 {
        panic("pe_registry_hive_load FAIL [op_size_kb(720001)] expected=512 got=" + to_string(s1))
    }
    let s4 = op_size_kb(720004)
    if s4 != 1024 {
        panic("pe_registry_hive_load FAIL [op_size_kb(720004)] expected=1024 got=" + to_string(s4))
    }
    let s_miss = op_size_kb(9999)
    if s_miss != 0 {
        panic("pe_registry_hive_load FAIL [op_size_kb(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 8. prhl_stats() = [5, 2368, 2, 3]
    let s = prhl_stats()
    if len(s) != 4 {
        panic("pe_registry_hive_load FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_registry_hive_load FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2368 {
        panic("pe_registry_hive_load FAIL [stats total_size_kb] expected=2368 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_registry_hive_load FAIL [stats hive_software] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_registry_hive_load FAIL [stats op_load] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_registry_hive_load_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_size_kb\":" + to_string(s[1])
        + ",\"hive_software\":" + to_string(s[2])
        + ",\"op_load\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_registry_hive_load FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_prhl()
    let s2 = prhl_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_registry_hive_load FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_registry_hive_load self_test PASS (ops=" + to_string(s[0])
        + ", size_kb=" + to_string(s[1]) + ", load=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = prhl_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_size_kb\t" + to_string(s[1]))
            println("count_hive_software\t" + to_string(s[2]))
            println("count_op_load\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_size_kb\t" + to_string(op_size_kb(oid)))
                return
            }
            println("usage: hexa run pe_registry_hive_load.hexa size <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let what = a[3]
                let val = to_int(a[4])
                if what == "hive" {
                    println("count_by_hive_kind\t" + to_string(count_by_hive_kind(val)))
                    return
                }
                if what == "op" {
                    println("count_by_operation\t" + to_string(count_by_operation(val)))
                    return
                }
            }
            println("usage: hexa run pe_registry_hive_load.hexa count { hive <hive_kind> | op <operation> }")
            return
        }
        if sub == "cleanup" {
            cleanup_prhl()
            println("cleaned: " + prhl_dir())
            return
        }
        if sub == "dir" {
            println(prhl_dir())
            return
        }
    }
    println("usage: hexa run pe_registry_hive_load.hexa { self-test | stats | size <op_id> | count hive <hive_kind> | count op <operation> | cleanup | dir }")
}
