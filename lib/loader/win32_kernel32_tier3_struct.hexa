// lib/loader/win32_kernel32_tier3_struct.hexa — cycle 82 R6 Tier 3 KERNEL32 struct marshal tracker
//
// Tier 3 KERNEL32 struct marshal:
//   GetSystemInfo(SYSTEM_INFO*)   → sysctl(hw.ncpu) + sysctl(hw.physmem) + page_size + ...
//   GetSystemTime(SYSTEMTIME*)    → clock_gettime(CLOCK_REALTIME) → struct tm → SYSTEMTIME
//   GetSystemTimeAsFileTime(FILETIME*) → 100ns since Jan 1 1601 UTC
//   GetVersionEx(OSVERSIONINFOEXW*) → 6.2 (Win8) or 10.0 (Win10) sentinel + Apple uname
//   GlobalMemoryStatusEx(MEMORYSTATUSEX*) → host_statistics64(HOST_VM_INFO64) + total/free RAM
//   GetNativeSystemInfo            → GetSystemInfo + WoW64 처리 (arm64에서 x64 emulation 시 다름)
//   GetLogicalProcessorInformation → sysctl hw.cacheconfig + perflevels (M-series 분류)
//   GetSystemDirectoryW("C:\Windows\System32") → 가짜 path or NSWorkspace alias
// own1: Apple sysctl/host_info + MSDN OSVERSIONINFOEX struct only
//
// own 1 enforcement: Wine / Reactos / CrossOver / community 코드 0 줄.
//   본 module 은 KERNEL32 Tier 3 struct marshal 호출 tracker — 실 native dispatch X.
//   Apple sysctl/host_statistics64 mapping 은 docstring 만 (실 helper.mm bridge stage6).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code (KERNEL32 struct marshal export):
//   1 = GetSystemInfo
//   2 = GetSystemTime
//   3 = GetSystemTimeAsFileTime
//   4 = GetVersionEx
//   5 = GlobalMemoryStatusEx
//   6 = GetNativeSystemInfo
//   7 = GetLogicalProcessorInformation
//   8 = GetSystemDirectoryW
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t struct_size_bytes<int> \t field_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wkt3_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_kernel32_tier3_struct"
}

fn wkt3_calls_path() -> str {
    return wkt3_dir() + "/calls.tsv"
}

fn wkt3_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wkt3_dir() + "'")
}

fn cleanup_wkt3() -> void {
    wkt3_ensure_dir()
    let _ = exec("rm -f '" + wkt3_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wkt3_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wkt3_append_row(path: str, row: str) -> void {
    wkt3_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: Tier 3 struct marshal call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, struct_size_bytes: int, field_count: int) -> void {
    if call_id <= 0 {
        panic("win32_kernel32_tier3_struct FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_kernel32_tier3_struct FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 8 {
        panic("win32_kernel32_tier3_struct FAIL [record_call] expected=func_kind<=8 got=" + to_string(func_kind))
    }
    if struct_size_bytes <= 0 {
        panic("win32_kernel32_tier3_struct FAIL [record_call] expected=struct_size_bytes>0 got=" + to_string(struct_size_bytes))
    }
    if field_count <= 0 {
        panic("win32_kernel32_tier3_struct FAIL [record_call] expected=field_count>0 got=" + to_string(field_count))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(struct_size_bytes) + "\t" + to_string(field_count) + "\n"
    wkt3_append_row(wkt3_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wkt3_read_table(wkt3_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_struct_size_bytes: 모든 call struct_size 합 ───
fn total_struct_size_bytes() -> int {
    let t = wkt3_read_table(wkt3_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_field_count: 모든 call field_count 합 ───
fn total_field_count() -> int {
    let t = wkt3_read_table(wkt3_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = wkt3_read_table(wkt3_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── largest_struct_call: struct_size_bytes 최대 call_id (없으면 0) ───
fn largest_struct_call() -> int {
    let t = wkt3_read_table(wkt3_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut best_id = 0
    let mut best_size = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let sz = to_int(parts[2])
                if sz > best_size {
                    best_size = sz
                    best_id = to_int(parts[0])
                }
            }
        }
        i = i + 1
    }
    return best_id
}

// ─── call_field_count: 특정 call_id 의 field_count (없으면 0) ───
fn call_field_count(call_id: int) -> int {
    let t = wkt3_read_table(wkt3_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wkt3_stats: [call_count, total_struct_size_bytes, total_field_count, largest_struct_call] ───
fn wkt3_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_struct_size_bytes())
    out.push(total_field_count())
    out.push(largest_struct_call())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wkt3-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wkt3()

    // 2. record 5 struct marshal calls across 5 distinct func_kinds (≥4)
    //    realistic Win32 struct sizes:
    //      SYSTEM_INFO        = 80 bytes  (10 fields: dwOemId/PageSize/MinAppAddr/MaxAppAddr/
    //                                      ActiveProcMask/NumberOfProcessors/ProcessorType/
    //                                      AllocationGranularity/ProcessorLevel/ProcessorRevision)
    //      SYSTEMTIME         = 16 bytes  (8 WORD fields: Year/Month/DayOfWeek/Day/Hour/Min/Sec/MilliSec)
    //      OSVERSIONINFOEXW   = 284 bytes (13 fields: dwOSVersionInfoSize/MajorVer/MinorVer/BuildNum/
    //                                      PlatformId/szCSDVersion[128]/wServicePackMajor/Minor/
    //                                      wSuiteMask/wProductType/wReserved + 2 trailing)
    //      MEMORYSTATUSEX     = 64 bytes  (8 fields: dwLength/dwMemoryLoad/ullTotalPhys/ullAvailPhys/
    //                                      ullTotalPageFile/ullAvailPageFile/ullTotalVirtual/ullAvailVirtual)
    //      FILETIME           = 8 bytes   (2 DWORD fields: dwLowDateTime/dwHighDateTime)
    record_call(820001, 1, 80, 10)
    r0_emit("win32_kernel32_tier3_struct_record",
        "\"call_id\":820001,\"func_kind\":1,\"struct_size_bytes\":80,\"field_count\":10,\"target\":\"GetSystemInfo\"")

    record_call(820002, 2, 16, 8)
    r0_emit("win32_kernel32_tier3_struct_record",
        "\"call_id\":820002,\"func_kind\":2,\"struct_size_bytes\":16,\"field_count\":8,\"target\":\"GetSystemTime\"")

    record_call(820003, 4, 284, 13)
    r0_emit("win32_kernel32_tier3_struct_record",
        "\"call_id\":820003,\"func_kind\":4,\"struct_size_bytes\":284,\"field_count\":13,\"target\":\"GetVersionEx\"")

    record_call(820004, 5, 64, 8)
    r0_emit("win32_kernel32_tier3_struct_record",
        "\"call_id\":820004,\"func_kind\":5,\"struct_size_bytes\":64,\"field_count\":8,\"target\":\"GlobalMemoryStatusEx\"")

    record_call(820005, 3, 8, 2)
    r0_emit("win32_kernel32_tier3_struct_record",
        "\"call_id\":820005,\"func_kind\":3,\"struct_size_bytes\":8,\"field_count\":2,\"target\":\"GetSystemTimeAsFileTime\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("win32_kernel32_tier3_struct FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. total_struct_size_bytes = 80 + 16 + 284 + 64 + 8 = 452
    let tsz = total_struct_size_bytes()
    if tsz != 452 {
        panic("win32_kernel32_tier3_struct FAIL [total_struct_size_bytes] expected=452 got=" + to_string(tsz))
    }

    // 5. total_field_count = 10 + 8 + 13 + 8 + 2 = 41
    let tfc = total_field_count()
    if tfc != 41 {
        panic("win32_kernel32_tier3_struct FAIL [total_field_count] expected=41 got=" + to_string(tfc))
    }

    // 6. count_by_func_kind sanity (5 distinct kinds: 1,2,3,4,5)
    let k1 = count_by_func_kind(1)
    if k1 != 1 {
        panic("win32_kernel32_tier3_struct FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_func_kind(2)
    if k2 != 1 {
        panic("win32_kernel32_tier3_struct FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_func_kind(3)
    if k3 != 1 {
        panic("win32_kernel32_tier3_struct FAIL [count_by_func_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_func_kind(4)
    if k4 != 1 {
        panic("win32_kernel32_tier3_struct FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_func_kind(5)
    if k5 != 1 {
        panic("win32_kernel32_tier3_struct FAIL [count_by_func_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k6 = count_by_func_kind(6)
    if k6 != 0 {
        panic("win32_kernel32_tier3_struct FAIL [count_by_func_kind(6)] expected=0 got=" + to_string(k6))
    }
    let k99 = count_by_func_kind(99)
    if k99 != 0 {
        panic("win32_kernel32_tier3_struct FAIL [count_by_func_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. largest_struct_call = 820003 (OSVERSIONINFOEXW = 284 bytes)
    let lg = largest_struct_call()
    if lg != 820003 {
        panic("win32_kernel32_tier3_struct FAIL [largest_struct_call] expected=820003 got=" + to_string(lg))
    }

    // 8. call_field_count sanity
    let f1 = call_field_count(820001)
    if f1 != 10 {
        panic("win32_kernel32_tier3_struct FAIL [call_field_count(820001)] expected=10 got=" + to_string(f1))
    }
    let f3 = call_field_count(820003)
    if f3 != 13 {
        panic("win32_kernel32_tier3_struct FAIL [call_field_count(820003)] expected=13 got=" + to_string(f3))
    }
    let f_miss = call_field_count(9999)
    if f_miss != 0 {
        panic("win32_kernel32_tier3_struct FAIL [call_field_count(9999)] expected=0 got=" + to_string(f_miss))
    }

    // 9. wkt3_stats() = [5, 452, 41, 820003]
    let s = wkt3_stats()
    if len(s) != 4 {
        panic("win32_kernel32_tier3_struct FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("win32_kernel32_tier3_struct FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 452 {
        panic("win32_kernel32_tier3_struct FAIL [stats total_struct_size_bytes] expected=452 got=" + to_string(s[1]))
    }
    if s[2] != 41 {
        panic("win32_kernel32_tier3_struct FAIL [stats total_field_count] expected=41 got=" + to_string(s[2]))
    }
    if s[3] != 820003 {
        panic("win32_kernel32_tier3_struct FAIL [stats largest_struct_call] expected=820003 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("win32_kernel32_tier3_struct_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_struct_size_bytes\":" + to_string(s[1])
        + ",\"total_field_count\":" + to_string(s[2])
        + ",\"largest_struct_call\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("win32_kernel32_tier3_struct FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_wkt3()
    let s2 = wkt3_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("win32_kernel32_tier3_struct FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_kernel32_tier3_struct self_test PASS (calls=" + to_string(s[0])
        + ", struct_bytes=" + to_string(s[1]) + ", fields=" + to_string(s[2])
        + ", largest_call=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wkt3_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_struct_size_bytes\t" + to_string(s[1]))
            println("total_field_count\t" + to_string(s[2]))
            println("largest_struct_call\t" + to_string(s[3]))
            return
        }
        if sub == "fields" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_field_count\t" + to_string(call_field_count(cid)))
                return
            }
            println("usage: hexa run win32_kernel32_tier3_struct.hexa fields <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_func_kind\t" + to_string(count_by_func_kind(kind)))
                return
            }
            println("usage: hexa run win32_kernel32_tier3_struct.hexa count <func_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_wkt3()
            println("cleaned: " + wkt3_dir())
            return
        }
        if sub == "dir" {
            println(wkt3_dir())
            return
        }
    }
    println("usage: hexa run win32_kernel32_tier3_struct.hexa { self-test | stats | fields <call_id> | count <func_kind> | cleanup | dir }")
}
