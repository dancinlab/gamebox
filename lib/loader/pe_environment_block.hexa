// lib/loader/pe_environment_block.hexa — cycle 72 PE environment block telemetry
//
// Win32 GetEnvironmentStrings / SetEnvironmentVariable / FreeEnvironmentStrings
// 추적기. env block 은 double-NUL terminated UTF-16 ("KEY=VAL\0KEY2=VAL2\0\0").
// per-process env table 의 op 를 tsv 로 기록 — 실제 Win32 호출 X (telemetry only).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 env op tracker — kernel32 API 호출 X (stage6 native bridge 책임).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = get_strings        (GetEnvironmentStringsW)
//   2 = set_var            (SetEnvironmentVariableW)
//   3 = delete_var         (SetEnvironmentVariableW with NULL value)
//   4 = expand_strings     (ExpandEnvironmentStringsW)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t var_count<int> \t total_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn peb_env_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_environment_block"
}

fn peb_env_ops_path() -> str {
    return peb_env_dir() + "/ops.tsv"
}

fn peb_env_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + peb_env_dir() + "'")
}

fn cleanup_peb_env() -> void {
    peb_env_ensure_dir()
    let _ = exec("rm -f '" + peb_env_ops_path() + "'")
}

// ─── 공통 file IO ───
fn peb_env_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn peb_env_append_row(path: str, row: str) -> void {
    peb_env_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: env op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, var_count: int, total_bytes_in: int) -> void {
    if op_id <= 0 {
        panic("pe_environment_block FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_environment_block FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 4 {
        panic("pe_environment_block FAIL [record_op] expected=op_kind<=4 got=" + to_string(op_kind))
    }
    if var_count < 0 {
        panic("pe_environment_block FAIL [record_op] expected=var_count>=0 got=" + to_string(var_count))
    }
    if total_bytes_in < 0 {
        panic("pe_environment_block FAIL [record_op] expected=total_bytes>=0 got=" + to_string(total_bytes_in))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(var_count) + "\t" + to_string(total_bytes_in) + "\n"
    peb_env_append_row(peb_env_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = peb_env_read_table(peb_env_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_var_count: 모든 op var_count 합 ───
fn total_var_count() -> int {
    let t = peb_env_read_table(peb_env_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_bytes: 모든 op total_bytes 합 ───
fn total_bytes() -> int {
    let t = peb_env_read_table(peb_env_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = peb_env_read_table(peb_env_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_total_bytes: 특정 op_id 의 total_bytes (없으면 0) ───
fn op_total_bytes(op_id: int) -> int {
    let t = peb_env_read_table(peb_env_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── peb_env_stats: [op_count, total_var_count, total_bytes, count_by_op_kind(2)] ───
fn peb_env_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_var_count())
    out.push(total_bytes())
    out.push(count_by_op_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "peb_env-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_peb_env()

    // 2. record 5 ops across ≥3 op_kinds (1=get_strings, 2=set_var x2, 3=delete_var, 4=expand_strings)
    //    expected aggregates: op_count=5, total_var_count=64+1+1+1+8=75, total_bytes=8192+96+0+64+512=8864
    record_op(120001, 1, 64, 8192)
    r0_emit("pe_environment_block_record",
        "\"op_id\":120001,\"op_kind\":1,\"var_count\":64,\"total_bytes\":8192,\"target\":\"get_strings\"")

    record_op(120002, 2, 1, 96)
    r0_emit("pe_environment_block_record",
        "\"op_id\":120002,\"op_kind\":2,\"var_count\":1,\"total_bytes\":96,\"target\":\"set_var\"")

    record_op(120003, 3, 1, 0)
    r0_emit("pe_environment_block_record",
        "\"op_id\":120003,\"op_kind\":3,\"var_count\":1,\"total_bytes\":0,\"target\":\"delete_var\"")

    record_op(120004, 2, 1, 64)
    r0_emit("pe_environment_block_record",
        "\"op_id\":120004,\"op_kind\":2,\"var_count\":1,\"total_bytes\":64,\"target\":\"set_var\"")

    record_op(120005, 4, 8, 512)
    r0_emit("pe_environment_block_record",
        "\"op_id\":120005,\"op_kind\":4,\"var_count\":8,\"total_bytes\":512,\"target\":\"expand_strings\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_environment_block FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_var_count = 75
    let tv = total_var_count()
    if tv != 75 {
        panic("pe_environment_block FAIL [total_var_count] expected=75 got=" + to_string(tv))
    }

    // 5. total_bytes = 8864
    let tb = total_bytes()
    if tb != 8864 {
        panic("pe_environment_block FAIL [total_bytes] expected=8864 got=" + to_string(tb))
    }

    // 6. count_by_op_kind sanity (3 distinct kinds present: 1,2,3,4 → actually 4 kinds)
    let k1 = count_by_op_kind(1)
    if k1 != 1 {
        panic("pe_environment_block FAIL [count_by_op_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 2 {
        panic("pe_environment_block FAIL [count_by_op_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_environment_block FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 1 {
        panic("pe_environment_block FAIL [count_by_op_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_environment_block FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. op_total_bytes sanity
    let b1 = op_total_bytes(120001)
    if b1 != 8192 {
        panic("pe_environment_block FAIL [op_total_bytes(120001)] expected=8192 got=" + to_string(b1))
    }
    let b5 = op_total_bytes(120005)
    if b5 != 512 {
        panic("pe_environment_block FAIL [op_total_bytes(120005)] expected=512 got=" + to_string(b5))
    }
    let b_miss = op_total_bytes(9999)
    if b_miss != 0 {
        panic("pe_environment_block FAIL [op_total_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 8. peb_env_stats() = [5, 75, 8864, 2]
    let s = peb_env_stats()
    if len(s) != 4 {
        panic("pe_environment_block FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_environment_block FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 75 {
        panic("pe_environment_block FAIL [stats total_var_count] expected=75 got=" + to_string(s[1]))
    }
    if s[2] != 8864 {
        panic("pe_environment_block FAIL [stats total_bytes] expected=8864 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_environment_block FAIL [stats count_kind(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_environment_block_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_var_count\":" + to_string(s[1])
        + ",\"total_bytes\":" + to_string(s[2])
        + ",\"kind_set_var\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_environment_block FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_peb_env()
    let s2 = peb_env_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_environment_block FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_environment_block self_test PASS (ops=" + to_string(s[0])
        + ", vars=" + to_string(s[1]) + ", bytes=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = peb_env_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_var_count\t" + to_string(s[1]))
            println("total_bytes\t" + to_string(s[2]))
            println("count_kind_set_var\t" + to_string(s[3]))
            return
        }
        if sub == "bytes" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_total_bytes\t" + to_string(op_total_bytes(oid)))
                return
            }
            println("usage: hexa run pe_environment_block.hexa bytes <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_environment_block.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_peb_env()
            println("cleaned: " + peb_env_dir())
            return
        }
        if sub == "dir" {
            println(peb_env_dir())
            return
        }
    }
    println("usage: hexa run pe_environment_block.hexa { self-test | stats | bytes <op_id> | count <op_kind> | cleanup | dir }")
}
