// lib/loader/pe_entry_call.hexa — Phase 1 stage1 — PE entry point 호출 simulator
//
// PE map + IAT bind 후 entry point (AddressOfEntryPoint = ImageBase + entry_rva) 호출.
// stage1: 호출 가능 여부만 검증 (entry RVA 유효, section RX, IAT resolved).
//          stage2 에서 native helper 로 실제 호출 + 반환값 캡처.
//
// closure path B Phase 1 의 실 milestone — entry call 성공 = 첫 i386 instruction 실행.

use "./pe_loader_stage1"
use "./pe_runtime_map"
use "../perf/r0_common"

fn entry_rva(pe_path: str) -> int {
    let lfa = s1_e_lfanew(pe_path)
    return s1_entry_rva(pe_path, lfa)
}

fn entry_va(pe_path: str) -> int {
    let lfa = s1_e_lfanew(pe_path)
    let opt_magic = s1_opt_magic(pe_path, lfa)
    let base = s1_image_base_lo(pe_path, lfa, opt_magic)
    return base + entry_rva(pe_path)
}

// entry RVA 가 어느 section 에 속하는지 검증
fn entry_in_section(pe_path: str) -> int {
    let n = layout_section_count(pe_path)
    let e = entry_rva(pe_path)
    let i = 0
    while i < n {
        let rva = layout_section_rva(pe_path, i)
        let sz = layout_section_vsize_aligned(pe_path, i)
        if e >= rva && e < rva + sz { return i }
        i = i + 1
    }
    return -1
}

fn entry_section_executable(pe_path: str) -> bool {
    let idx = entry_in_section(pe_path)
    if idx < 0 { return false }
    let prot = layout_section_prot(pe_path, idx)
    return prot.contains("X")
}

fn entry_callable(pe_path: str) -> bool {
    let e = entry_rva(pe_path)
    if e == 0 { return false }
    if entry_in_section(pe_path) < 0 { return false }
    if !entry_section_executable(pe_path) { return false }
    return true
}

fn self_test() -> void {
    let sid = "pec-" + exec("date +%s").trim()
    r0_session_set(sid)

    let bnet = exec("ls /Users/ghost/core/airgenome-gamebox/tool/bench/Battle.net-Setup.exe 2>/dev/null").trim()
    if bnet != "" {
        let e = entry_rva(bnet)
        if e <= 0 { panic("pe_entry_call FAIL [entry_rva] got=" + to_string(e)) }

        let va = entry_va(bnet)
        if va <= 0 { panic("pe_entry_call FAIL [entry_va]") }

        let sec = entry_in_section(bnet)
        if sec < 0 { panic("pe_entry_call FAIL [section]") }

        let exe = entry_section_executable(bnet)
        if !exe { panic("pe_entry_call FAIL [executable]") }

        let callable = entry_callable(bnet)
        if !callable { panic("pe_entry_call FAIL [callable]") }

        r0_emit("pe_entry_call_ok", "\"entry_rva\":" + to_string(e) + ",\"section\":" + to_string(sec))
        println("  ✅ pe_entry_call self_test PASS (Bnet-Setup entry_rva=0x" + to_string(e) + " section=" + to_string(sec) + " executable=true)")
    } else {
        r0_emit("pe_entry_call_skip", "\"reason\":\"no_pe_sample\"")
        println("  ✅ pe_entry_call self_test PASS (logic only — no PE sample)")
    }
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "info" && len(a) >= 4 {
            let p = a[3]
            println("entry_rva=0x" + to_string(entry_rva(p)) + " entry_va=0x" + to_string(entry_va(p)) + " section=" + to_string(entry_in_section(p)) + " callable=" + to_string(entry_callable(p)))
            return
        }
    }
    println("usage: hexa run pe_entry_call.hexa { self-test | info <pe_path> }")
}
