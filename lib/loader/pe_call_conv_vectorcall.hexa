// lib/loader/pe_call_conv_vectorcall.hexa — cycle68 x86_64 __vectorcall adapter telemetry skeleton
//
// Microsoft __vectorcall ABI (x86_64): 첫 4 개 정수/포인터 인자는 RCX/RDX/R8/R9
// 로 전달, 첫 6 개 vector/floating-point 인자는 XMM0..XMM5 로 전달, 나머지는
// stack 으로 spill (16-byte aligned, shadow space 32 bytes 포함). arm64 adapter
// 는 int_reg → x0..x3 으로 매핑하고 xmm_reg → NEON v0..v5 (q0..q5) 로 매핑,
// stack 영역은 sp-relative frame 으로 spill. 본 module 은 call site adapter
// telemetry tracker — 실제 register read / NEON spill 호출 X (cycle69+).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   reg/xmm/stack 분류 logic 은 Microsoft __vectorcall ABI spec 기반 자체 구현.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// int_reg_used 범위: 0 (모두 stack) ~ 4 (RCX+RDX+R8+R9 모두 사용)
// xmm_reg_used 범위: 0 (vector 인자 없음) ~ 6 (XMM0..XMM5 모두 사용)
// stack_bytes: 0 이상 (shadow space 외 spill 영역 byte 수)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t int_reg_used<int> \t xmm_reg_used<int> \t stack_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pccv_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_call_conv_vectorcall"
}

fn pccv_calls_path() -> str {
    return pccv_dir() + "/calls.tsv"
}

fn pccv_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pccv_dir() + "'")
}

fn cleanup_pccv() -> void {
    pccv_ensure_dir()
    let _ = exec("rm -f '" + pccv_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pccv_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pccv_append_row(path: str, row: str) -> void {
    pccv_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: vectorcall site 1 건 기록 ───
fn record_call(call_id: int, int_reg_used: int, xmm_reg_used: int, stack_bytes: int) -> void {
    if call_id <= 0 {
        panic("pe_call_conv_vectorcall FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if int_reg_used < 0 {
        panic("pe_call_conv_vectorcall FAIL [record_call] expected=int_reg_used>=0 got=" + to_string(int_reg_used))
    }
    if int_reg_used > 4 {
        panic("pe_call_conv_vectorcall FAIL [record_call] expected=int_reg_used<=4 got=" + to_string(int_reg_used))
    }
    if xmm_reg_used < 0 {
        panic("pe_call_conv_vectorcall FAIL [record_call] expected=xmm_reg_used>=0 got=" + to_string(xmm_reg_used))
    }
    if xmm_reg_used > 6 {
        panic("pe_call_conv_vectorcall FAIL [record_call] expected=xmm_reg_used<=6 got=" + to_string(xmm_reg_used))
    }
    if stack_bytes < 0 {
        panic("pe_call_conv_vectorcall FAIL [record_call] expected=stack_bytes>=0 got=" + to_string(stack_bytes))
    }
    let row = to_string(call_id) + "\t" + to_string(int_reg_used)
        + "\t" + to_string(xmm_reg_used) + "\t" + to_string(stack_bytes) + "\n"
    pccv_append_row(pccv_calls_path(), row)
}

// ─── call_count: total call site 수 ───
fn call_count() -> int {
    let t = pccv_read_table(pccv_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_int_regs: 모든 call 의 int_reg_used 합 ───
fn total_int_regs() -> int {
    let t = pccv_read_table(pccv_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_xmm_regs: 모든 call 의 xmm_reg_used 합 ───
fn total_xmm_regs() -> int {
    let t = pccv_read_table(pccv_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_stack_bytes: 모든 call 의 stack_bytes 합 ───
fn total_stack_bytes() -> int {
    let t = pccv_read_table(pccv_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_xmm_used: 특정 xmm_reg_used 의 call 수 ───
fn count_by_xmm_used(xu: int) -> int {
    let t = pccv_read_table(pccv_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == xu {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_xmm_regs: 특정 call_id 의 xmm_reg_used (없으면 0) ───
fn call_xmm_regs(call_id: int) -> int {
    let t = pccv_read_table(pccv_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pccv_stats: [call_count, total_int_regs, total_xmm_regs, total_stack_bytes] ───
fn pccv_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_int_regs())
    out.push(total_xmm_regs())
    out.push(total_stack_bytes())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pccv-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pccv()

    // 2. record 5 vectorcall sites — int_reg/xmm_reg 다양, stack spill 포함
    //   call 680101: int=0 xmm=0 stack=0   — void()
    //   call 680102: int=4 xmm=0 stack=0   — int4 (RCX+RDX+R8+R9)
    //   call 680103: int=0 xmm=6 stack=0   — vec6 (XMM0..XMM5)
    //   call 680104: int=2 xmm=3 stack=0   — int2 + vec3 (mixed)
    //   call 680105: int=4 xmm=6 stack=64  — full reg + 64B stack spill
    record_call(680101, 0, 0, 0)
    r0_emit("pe_call_conv_vectorcall_record",
        "\"call_id\":680101,\"int_reg_used\":0,\"xmm_reg_used\":0,\"stack_bytes\":0,\"target\":\"void\"")

    record_call(680102, 4, 0, 0)
    r0_emit("pe_call_conv_vectorcall_record",
        "\"call_id\":680102,\"int_reg_used\":4,\"xmm_reg_used\":0,\"stack_bytes\":0,\"target\":\"int4\"")

    record_call(680103, 0, 6, 0)
    r0_emit("pe_call_conv_vectorcall_record",
        "\"call_id\":680103,\"int_reg_used\":0,\"xmm_reg_used\":6,\"stack_bytes\":0,\"target\":\"vec6\"")

    record_call(680104, 2, 3, 0)
    r0_emit("pe_call_conv_vectorcall_record",
        "\"call_id\":680104,\"int_reg_used\":2,\"xmm_reg_used\":3,\"stack_bytes\":0,\"target\":\"int2_vec3\"")

    record_call(680105, 4, 6, 64)
    r0_emit("pe_call_conv_vectorcall_record",
        "\"call_id\":680105,\"int_reg_used\":4,\"xmm_reg_used\":6,\"stack_bytes\":64,\"target\":\"full_spill64\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("pe_call_conv_vectorcall FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. total_int_regs = 0+4+0+2+4 = 10
    let tir = total_int_regs()
    if tir != 10 {
        panic("pe_call_conv_vectorcall FAIL [total_int_regs] expected=10 got=" + to_string(tir))
    }

    // 5. total_xmm_regs = 0+0+6+3+6 = 15
    let txr = total_xmm_regs()
    if txr != 15 {
        panic("pe_call_conv_vectorcall FAIL [total_xmm_regs] expected=15 got=" + to_string(txr))
    }

    // 6. total_stack_bytes = 0+0+0+0+64 = 64
    let tsb = total_stack_bytes()
    if tsb != 64 {
        panic("pe_call_conv_vectorcall FAIL [total_stack_bytes] expected=64 got=" + to_string(tsb))
    }

    // 7. count_by_xmm_used sanity
    let x0 = count_by_xmm_used(0)
    if x0 != 2 {
        panic("pe_call_conv_vectorcall FAIL [count_by_xmm_used(0)] expected=2 got=" + to_string(x0))
    }
    let x3 = count_by_xmm_used(3)
    if x3 != 1 {
        panic("pe_call_conv_vectorcall FAIL [count_by_xmm_used(3)] expected=1 got=" + to_string(x3))
    }
    let x6 = count_by_xmm_used(6)
    if x6 != 2 {
        panic("pe_call_conv_vectorcall FAIL [count_by_xmm_used(6)] expected=2 got=" + to_string(x6))
    }
    let x99 = count_by_xmm_used(99)
    if x99 != 0 {
        panic("pe_call_conv_vectorcall FAIL [count_by_xmm_used(99)] expected=0 got=" + to_string(x99))
    }

    // 8. call_xmm_regs sanity
    let xr3 = call_xmm_regs(680103)
    if xr3 != 6 {
        panic("pe_call_conv_vectorcall FAIL [call_xmm_regs(680103)] expected=6 got=" + to_string(xr3))
    }
    let xr4 = call_xmm_regs(680104)
    if xr4 != 3 {
        panic("pe_call_conv_vectorcall FAIL [call_xmm_regs(680104)] expected=3 got=" + to_string(xr4))
    }
    let xr1 = call_xmm_regs(680101)
    if xr1 != 0 {
        panic("pe_call_conv_vectorcall FAIL [call_xmm_regs(680101)] expected=0 got=" + to_string(xr1))
    }
    let xr_miss = call_xmm_regs(9999)
    if xr_miss != 0 {
        panic("pe_call_conv_vectorcall FAIL [call_xmm_regs(9999)] expected=0 got=" + to_string(xr_miss))
    }

    // 9. pccv_stats() = [5, 10, 15, 64]
    let s = pccv_stats()
    if len(s) != 4 {
        panic("pe_call_conv_vectorcall FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_call_conv_vectorcall FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 10 {
        panic("pe_call_conv_vectorcall FAIL [stats total_int_regs] expected=10 got=" + to_string(s[1]))
    }
    if s[2] != 15 {
        panic("pe_call_conv_vectorcall FAIL [stats total_xmm_regs] expected=15 got=" + to_string(s[2]))
    }
    if s[3] != 64 {
        panic("pe_call_conv_vectorcall FAIL [stats total_stack_bytes] expected=64 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_call_conv_vectorcall_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_int_regs\":" + to_string(s[1])
        + ",\"total_xmm_regs\":" + to_string(s[2])
        + ",\"total_stack_bytes\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_call_conv_vectorcall FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pccv()
    let s2 = pccv_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_call_conv_vectorcall FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_call_conv_vectorcall self_test PASS (calls=" + to_string(s[0])
        + ", int=" + to_string(s[1]) + ", xmm=" + to_string(s[2])
        + ", stack=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pccv_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_int_regs\t" + to_string(s[1]))
            println("total_xmm_regs\t" + to_string(s[2]))
            println("total_stack_bytes\t" + to_string(s[3]))
            return
        }
        if sub == "xmm" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_xmm_regs\t" + to_string(call_xmm_regs(cid)))
                return
            }
            println("usage: hexa run pe_call_conv_vectorcall.hexa xmm <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let xu = to_int(a[3])
                println("count_by_xmm_used\t" + to_string(count_by_xmm_used(xu)))
                return
            }
            println("usage: hexa run pe_call_conv_vectorcall.hexa count <xmm_used>")
            return
        }
        if sub == "cleanup" {
            cleanup_pccv()
            println("cleaned: " + pccv_dir())
            return
        }
        if sub == "dir" {
            println(pccv_dir())
            return
        }
    }
    println("usage: hexa run pe_call_conv_vectorcall.hexa { self-test | stats | xmm <call_id> | count <xmm_used> | cleanup | dir }")
}
