// lib/loader/win32_gdi32_tier1_real.hexa — cycle 81 R6 Tier 1 GDI32 trivial 함수 tracker
//
// Tier 1 trivial GDI32 → Apple-native:
//   GetDeviceCaps(HORZRES/VERTRES) → CGDisplayPixelsWide/High
//   GetDeviceCaps(LOGPIXELSX/Y)    → 96 * NSScreen.backingScaleFactor
//   GetDIBColorTable               → return 0 (DIB color tables not used in modern apps)
//   GetCurrentObject               → DC current handle table lookup
//   GetStockObject(WHITE_BRUSH 등) → static handle 8 sentinel (Win32 standard stock)
//   GetTextExtentPoint32W          → CTLineGetTypographicBounds
//   GetTextMetrics                 → CTFontGetAscent/Descent/Leading
//   SetTextColor / SetBkColor      → CGContextSetRGBFillColor (DC state cache)
//   SetBkMode(TRANSPARENT/OPAQUE)  → 1bit DC state slot
//   DeleteObject                   → handle table free
// own1: Apple CoreGraphics + CoreText + MSDN. Wine gdi32/dc.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 GDI32 Tier 1 call tracker — 실 CoreGraphics/CoreText 호출 X (R6+).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//    1 = GetDeviceCaps
//    2 = GetDIBColorTable
//    3 = GetCurrentObject
//    4 = GetStockObject
//    5 = GetTextExtentPoint32W
//    6 = GetTextMetrics
//    7 = SetTextColor
//    8 = SetBkColor
//    9 = SetBkMode
//   10 = DeleteObject
//
// impl_status code:
//   1 = real_core_graphics    (CGDisplayPixelsWide / CTFontGetAscent / handle free 등 실 Apple-native 매핑)
//   2 = stub_constant         (DC state cache 의 직전값 반환 — 0/0/OPAQUE 등)
//   3 = stock_handle_table    (GetStockObject sentinel 8)
//   4 = deprecated_zero       (GetDIBColorTable 등 modern app 미사용 → 0)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t impl_status<int> \t return_value<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wgt1_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_gdi32_tier1_real"
}

fn wgt1_calls_path() -> str {
    return wgt1_dir() + "/calls.tsv"
}

fn wgt1_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wgt1_dir() + "'")
}

fn cleanup_wgt1() -> void {
    wgt1_ensure_dir()
    let _ = exec("rm -f '" + wgt1_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wgt1_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wgt1_append_row(path: str, row: str) -> void {
    wgt1_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: GDI32 Tier 1 call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, impl_status: int, return_value: int) -> void {
    if call_id <= 0 {
        panic("win32_gdi32_tier1_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_gdi32_tier1_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 10 {
        panic("win32_gdi32_tier1_real FAIL [record_call] expected=func_kind<=10 got=" + to_string(func_kind))
    }
    if impl_status < 1 {
        panic("win32_gdi32_tier1_real FAIL [record_call] expected=impl_status>=1 got=" + to_string(impl_status))
    }
    if impl_status > 4 {
        panic("win32_gdi32_tier1_real FAIL [record_call] expected=impl_status<=4 got=" + to_string(impl_status))
    }
    if return_value < 0 {
        panic("win32_gdi32_tier1_real FAIL [record_call] expected=return_value>=0 got=" + to_string(return_value))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(impl_status) + "\t" + to_string(return_value) + "\n"
    wgt1_append_row(wgt1_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wgt1_read_table(wgt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = wgt1_read_table(wgt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_impl_status: 특정 impl_status 의 call 수 ───
fn count_by_impl_status(status: int) -> int {
    let t = wgt1_read_table(wgt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == status {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── real_core_graphics_count: impl_status=1 인 call 수 ───
fn real_core_graphics_count() -> int {
    return count_by_impl_status(1)
}

// ─── total_return_value: 모든 call 의 return_value 합 ───
fn total_return_value() -> int {
    let t = wgt1_read_table(wgt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── call_return_value: 특정 call_id 의 return_value (없으면 0) ───
fn call_return_value(call_id: int) -> int {
    let t = wgt1_read_table(wgt1_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wgt1_stats: [call_count, real_core_graphics_count, total_return_value, count_by_func_kind(1)] ───
fn wgt1_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(real_core_graphics_count())
    out.push(total_return_value())
    out.push(count_by_func_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wgt1-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wgt1()

    // 2. record 6 calls across 6 distinct func_kinds (>=4) and ALL 4 impl_statuses.
    //    func_kinds used: {1, 4, 2, 7, 10, 9} = 6 distinct
    //    impl_statuses used: {1, 3, 4, 2, 1, 2} → covers {1, 2, 3, 4}

    // call 1: GetDeviceCaps(HORZRES) → CGDisplayPixelsWide → 1920
    record_call(190001, 1, 1, 1920)
    r0_emit("win32_gdi32_tier1_real_record",
        "\"call_id\":190001,\"func_kind\":1,\"impl_status\":1,\"return_value\":1920,\"target\":\"GetDeviceCaps_HORZRES\"")

    // call 2: GetStockObject(WHITE_BRUSH) → static handle 8 sentinel
    record_call(190002, 4, 3, 8)
    r0_emit("win32_gdi32_tier1_real_record",
        "\"call_id\":190002,\"func_kind\":4,\"impl_status\":3,\"return_value\":8,\"target\":\"GetStockObject_WHITE_BRUSH\"")

    // call 3: GetDIBColorTable → deprecated_zero (modern apps 미사용)
    record_call(190003, 2, 4, 0)
    r0_emit("win32_gdi32_tier1_real_record",
        "\"call_id\":190003,\"func_kind\":2,\"impl_status\":4,\"return_value\":0,\"target\":\"GetDIBColorTable\"")

    // call 4: SetTextColor → DC state cache 의 직전값 (initial=0, CLR_INVALID 회피)
    record_call(190004, 7, 2, 0)
    r0_emit("win32_gdi32_tier1_real_record",
        "\"call_id\":190004,\"func_kind\":7,\"impl_status\":2,\"return_value\":0,\"target\":\"SetTextColor\"")

    // call 5: DeleteObject → handle table free → TRUE (1)
    record_call(190005, 10, 1, 1)
    r0_emit("win32_gdi32_tier1_real_record",
        "\"call_id\":190005,\"func_kind\":10,\"impl_status\":1,\"return_value\":1,\"target\":\"DeleteObject\"")

    // call 6: SetBkMode(TRANSPARENT) → 직전 mode OPAQUE(2) 반환 (DC state slot 1bit)
    record_call(190006, 9, 2, 2)
    r0_emit("win32_gdi32_tier1_real_record",
        "\"call_id\":190006,\"func_kind\":9,\"impl_status\":2,\"return_value\":2,\"target\":\"SetBkMode_TRANSPARENT\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("win32_gdi32_tier1_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (6 distinct kinds, each 1)
    let f1 = count_by_func_kind(1)
    if f1 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(f1))
    }
    let f2 = count_by_func_kind(2)
    if f2 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(f2))
    }
    let f4 = count_by_func_kind(4)
    if f4 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(f4))
    }
    let f7 = count_by_func_kind(7)
    if f7 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_func_kind(7)] expected=1 got=" + to_string(f7))
    }
    let f9 = count_by_func_kind(9)
    if f9 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_func_kind(9)] expected=1 got=" + to_string(f9))
    }
    let f10 = count_by_func_kind(10)
    if f10 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_func_kind(10)] expected=1 got=" + to_string(f10))
    }
    let f3 = count_by_func_kind(3)
    if f3 != 0 {
        panic("win32_gdi32_tier1_real FAIL [count_by_func_kind(3)] expected=0 got=" + to_string(f3))
    }

    // 5. distinct func_kind 수 >= 4
    let mut distinct_kinds = 0
    let mut k = 1
    while k <= 10 {
        if count_by_func_kind(k) > 0 {
            distinct_kinds = distinct_kinds + 1
        }
        k = k + 1
    }
    if distinct_kinds < 4 {
        panic("win32_gdi32_tier1_real FAIL [distinct func_kinds] expected=>=4 got=" + to_string(distinct_kinds))
    }

    // 6. count_by_impl_status — ALL 4 statuses non-zero
    let s1 = count_by_impl_status(1)
    if s1 != 2 {
        panic("win32_gdi32_tier1_real FAIL [count_by_impl_status(1)] expected=2 got=" + to_string(s1))
    }
    let s2 = count_by_impl_status(2)
    if s2 != 2 {
        panic("win32_gdi32_tier1_real FAIL [count_by_impl_status(2)] expected=2 got=" + to_string(s2))
    }
    let s3 = count_by_impl_status(3)
    if s3 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_impl_status(3)] expected=1 got=" + to_string(s3))
    }
    let s4 = count_by_impl_status(4)
    if s4 != 1 {
        panic("win32_gdi32_tier1_real FAIL [count_by_impl_status(4)] expected=1 got=" + to_string(s4))
    }

    // 7. real_core_graphics_count = 2
    let rc = real_core_graphics_count()
    if rc != 2 {
        panic("win32_gdi32_tier1_real FAIL [real_core_graphics_count] expected=2 got=" + to_string(rc))
    }

    // 8. total_return_value = 1920+8+0+0+1+2 = 1931
    let trv = total_return_value()
    if trv != 1931 {
        panic("win32_gdi32_tier1_real FAIL [total_return_value] expected=1931 got=" + to_string(trv))
    }

    // 9. call_return_value sanity
    let r1 = call_return_value(190001)
    if r1 != 1920 {
        panic("win32_gdi32_tier1_real FAIL [call_return_value(190001)] expected=1920 got=" + to_string(r1))
    }
    let r2 = call_return_value(190002)
    if r2 != 8 {
        panic("win32_gdi32_tier1_real FAIL [call_return_value(190002)] expected=8 got=" + to_string(r2))
    }
    let r_miss = call_return_value(999999)
    if r_miss != 0 {
        panic("win32_gdi32_tier1_real FAIL [call_return_value(999999)] expected=0 got=" + to_string(r_miss))
    }

    // 10. wgt1_stats() = [6, 2, 1931, 1]
    let s = wgt1_stats()
    if len(s) != 4 {
        panic("win32_gdi32_tier1_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("win32_gdi32_tier1_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("win32_gdi32_tier1_real FAIL [stats real_core_graphics_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 1931 {
        panic("win32_gdi32_tier1_real FAIL [stats total_return_value] expected=1931 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("win32_gdi32_tier1_real FAIL [stats kind_GetDeviceCaps] expected=1 got=" + to_string(s[3]))
    }

    // 11. emit stats (records=6 + stats=1 = 7 emits)
    r0_emit("win32_gdi32_tier1_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"real_core_graphics_count\":" + to_string(s[1])
        + ",\"total_return_value\":" + to_string(s[2])
        + ",\"kind_GetDeviceCaps\":" + to_string(s[3])
        + ",\"distinct_func_kinds\":" + to_string(distinct_kinds))

    // 12. emit count >= 7
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("win32_gdi32_tier1_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 13. cleanup → stats 모두 0
    cleanup_wgt1()
    let s2_post = wgt1_stats()
    let i = 0
    while i < len(s2_post) {
        if s2_post[i] != 0 {
            panic("win32_gdi32_tier1_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2_post[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_gdi32_tier1_real self_test PASS (calls=" + to_string(s[0])
        + ", real_cg=" + to_string(s[1]) + ", return_sum=" + to_string(s[2])
        + ", kinds=" + to_string(distinct_kinds)
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wgt1_stats()
            println("call_count\t" + to_string(s[0]))
            println("real_core_graphics_count\t" + to_string(s[1]))
            println("total_return_value\t" + to_string(s[2]))
            println("kind_GetDeviceCaps\t" + to_string(s[3]))
            return
        }
        if sub == "return" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_return_value\t" + to_string(call_return_value(cid)))
                return
            }
            println("usage: hexa run win32_gdi32_tier1_real.hexa return <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let mode = a[3]
                let key = to_int(a[4])
                if mode == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(key)))
                    return
                }
                if mode == "impl" {
                    println("count_by_impl_status\t" + to_string(count_by_impl_status(key)))
                    return
                }
            }
            println("usage: hexa run win32_gdi32_tier1_real.hexa count { func <func_kind> | impl <impl_status> }")
            return
        }
        if sub == "cleanup" {
            cleanup_wgt1()
            println("cleaned: " + wgt1_dir())
            return
        }
        if sub == "dir" {
            println(wgt1_dir())
            return
        }
    }
    println("usage: hexa run win32_gdi32_tier1_real.hexa { self-test | stats | return <call_id> | count func <func_kind> | count impl <impl_status> | cleanup | dir }")
}
