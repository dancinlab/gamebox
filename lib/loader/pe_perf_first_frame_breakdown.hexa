// lib/loader/pe_perf_first_frame_breakdown.hexa — cold launch first frame timing breakdown.
//
// First frame breakdown (own2 자체 perf measurement):
//   pe_load               — PE binary mmap + section map
//   iat_resolve           — IAT direct + forwarder + delay-load
//   tls_init              — TLS_CALLBACK array fire
//   entry_call            — main entry instruction
//   stub_init             — DLL stub address table populate
//   ddraw_init            — DirectDraw / DXGI factory
//   swapchain_create      — IDXGISwapChain + CAMetalLayer
//   pso_compile           — PSO precompile (D4/UE5 hot)
//   first_draw            — first MTLRenderCommandEncoder draw
//   first_present         — first CAMetalLayer presentDrawable
// own1: 자체 perf measurement, third-party tracer 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 11 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1=pe_load 2=iat_resolve 3=tls_init 4=entry_call 5=stub_init
//   6=ddraw_init 7=swapchain_create 8=pso_compile 9=first_draw 10=first_present
//
// persist schema (TSV — breakdowns.tsv):
//   breakdown_id<int> \t phase_kind<int> \t elevated<int> \t elapsed_us<int>

use "../perf/r0_common"

fn pffb_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_perf_first_frame_breakdown"
}

fn pffb_breakdowns_path() -> str {
    return pffb_dir() + "/breakdowns.tsv"
}

fn pffb_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pffb_dir() + "'")
}

fn cleanup_pffb() -> void {
    pffb_ensure_dir()
    let _ = exec("rm -f '" + pffb_breakdowns_path() + "'")
}

fn pffb_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pffb_append_row(path: str, row: str) -> void {
    pffb_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn record_breakdown(breakdown_id: int, phase_kind: int, elevated: int, elapsed_us: int) -> void {
    if breakdown_id <= 0 {
        panic("pe_perf_first_frame_breakdown FAIL [record] expected=breakdown_id>0 got=" + to_string(breakdown_id))
    }
    if phase_kind < 1 {
        panic("pe_perf_first_frame_breakdown FAIL [record] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 10 {
        panic("pe_perf_first_frame_breakdown FAIL [record] expected=phase_kind<=10 got=" + to_string(phase_kind))
    }
    if elevated < 0 {
        panic("pe_perf_first_frame_breakdown FAIL [record] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_perf_first_frame_breakdown FAIL [record] expected=elevated<=1 got=" + to_string(elevated))
    }
    if elapsed_us < 0 {
        panic("pe_perf_first_frame_breakdown FAIL [record] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    let row = to_string(breakdown_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(elevated) + "\t" + to_string(elapsed_us) + "\n"
    pffb_append_row(pffb_breakdowns_path(), row)
}

fn breakdown_count() -> int {
    let t = pffb_read_table(pffb_breakdowns_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_phase_kind(phase_kind: int) -> int {
    let t = pffb_read_table(pffb_breakdowns_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn total_elapsed_us() -> int {
    let t = pffb_read_table(pffb_breakdowns_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

fn elevated_count() -> int {
    let t = pffb_read_table(pffb_breakdowns_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn slowest_phase() -> int {
    let t = pffb_read_table(pffb_breakdowns_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut max_us = -1
    let mut max_id = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let us = to_int(parts[3])
                if us > max_us {
                    max_us = us
                    max_id = to_int(parts[0])
                }
            }
        }
        i = i + 1
    }
    return max_id
}

fn breakdown_elapsed_us(breakdown_id: int) -> int {
    let t = pffb_read_table(pffb_breakdowns_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == breakdown_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn pffb_stats() -> array {
    let mut out = []
    out.push(breakdown_count())
    out.push(total_elapsed_us())
    out.push(elevated_count())
    out.push(slowest_phase())
    out.push(count_by_phase_kind(8))
    return out
}

fn self_test() -> void {
    let sid = "pffb-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pffb()

    record_breakdown(180001, 1, 0, 12000)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180001,\"phase\":1,\"elapsed_us\":12000")
    record_breakdown(180002, 2, 0, 8500)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180002,\"phase\":2,\"elapsed_us\":8500")
    record_breakdown(180003, 3, 0, 1200)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180003,\"phase\":3,\"elapsed_us\":1200")
    record_breakdown(180004, 4, 0, 800)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180004,\"phase\":4,\"elapsed_us\":800")
    record_breakdown(180005, 5, 0, 4500)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180005,\"phase\":5,\"elapsed_us\":4500")
    record_breakdown(180006, 6, 1, 25000)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180006,\"phase\":6,\"elapsed_us\":25000")
    record_breakdown(180007, 7, 1, 16000)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180007,\"phase\":7,\"elapsed_us\":16000")
    record_breakdown(180008, 8, 1, 850000)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180008,\"phase\":8,\"elapsed_us\":850000")
    record_breakdown(180009, 9, 0, 3200)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180009,\"phase\":9,\"elapsed_us\":3200")
    record_breakdown(180010, 10, 0, 5500)
    r0_emit("pe_perf_first_frame_breakdown_record",
        "\"id\":180010,\"phase\":10,\"elapsed_us\":5500")

    let c = breakdown_count()
    if c != 10 {
        panic("pe_perf_first_frame_breakdown FAIL [breakdown_count] expected=10 got=" + to_string(c))
    }
    let total = total_elapsed_us()
    let expected_total = 12000 + 8500 + 1200 + 800 + 4500 + 25000 + 16000 + 850000 + 3200 + 5500
    if total != expected_total {
        panic("pe_perf_first_frame_breakdown FAIL [total_elapsed_us] expected=" + to_string(expected_total) + " got=" + to_string(total))
    }
    let ec = elevated_count()
    if ec != 3 {
        panic("pe_perf_first_frame_breakdown FAIL [elevated_count] expected=3 got=" + to_string(ec))
    }
    let sp = slowest_phase()
    if sp != 180008 {
        panic("pe_perf_first_frame_breakdown FAIL [slowest_phase] expected=180008 got=" + to_string(sp))
    }
    let p99 = count_by_phase_kind(99)
    if p99 != 0 {
        panic("pe_perf_first_frame_breakdown FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p99))
    }
    let bm = breakdown_elapsed_us(9999)
    if bm != 0 {
        panic("pe_perf_first_frame_breakdown FAIL [breakdown_elapsed_us(9999)] expected=0 got=" + to_string(bm))
    }

    let s = pffb_stats()
    if len(s) != 5 {
        panic("pe_perf_first_frame_breakdown FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }

    r0_emit("pe_perf_first_frame_breakdown_stats",
        "\"breakdown_count\":" + to_string(s[0])
        + ",\"total_elapsed_us\":" + to_string(s[1])
        + ",\"elevated_count\":" + to_string(s[2])
        + ",\"slowest_phase\":" + to_string(s[3])
        + ",\"pso_compile_count\":" + to_string(s[4]))

    let emit_n = r0_session_count(sid)
    if emit_n < 11 {
        panic("pe_perf_first_frame_breakdown FAIL [r0 emit count] expected=>=11 got=" + to_string(emit_n))
    }

    cleanup_pffb()
    let s2 = pffb_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_perf_first_frame_breakdown FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_perf_first_frame_breakdown self_test PASS (breakdowns=" + to_string(s[0])
        + ", total_us=" + to_string(s[1]) + ", elevated=" + to_string(s[2])
        + ", slowest=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pffb_stats()
            println("breakdown_count\t" + to_string(s[0]))
            println("total_elapsed_us\t" + to_string(s[1]))
            println("elevated_count\t" + to_string(s[2]))
            println("slowest_phase\t" + to_string(s[3]))
            println("pso_compile_count\t" + to_string(s[4]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let bid = to_int(a[3])
                println("breakdown_elapsed_us\t" + to_string(breakdown_elapsed_us(bid)))
                return
            }
            println("usage: hexa run pe_perf_first_frame_breakdown.hexa elapsed <breakdown_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_perf_first_frame_breakdown.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pffb()
            println("cleaned: " + pffb_dir())
            return
        }
        if sub == "dir" {
            println(pffb_dir())
            return
        }
    }
    println("usage: hexa run pe_perf_first_frame_breakdown.hexa { self-test | stats | elapsed <breakdown_id> | count <phase_kind> | cleanup | dir }")
}
