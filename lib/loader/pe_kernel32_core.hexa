// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pkernel_count_rows(pkernel_syscall_invoke_path(), 4)
}

fn file_io_round_trip_count() -> int {
    return pkernel_count_rows(pkernel_file_io_round_trip_path(), 5)
}

fn memory_lifecycle_count() -> int {
    return pkernel_count_rows(pkernel_memory_lifecycle_path(), 5)
}

fn proc_sys_event_count() -> int {
    return pkernel_count_rows(pkernel_proc_sys_event_path(), 5)
}

fn ext_event_count() -> int {
    return pkernel_count_rows(pkernel_ext_event_path(), 5)
}

fn pkernel_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(file_io_round_trip_count())
    out.push(memory_lifecycle_count())
    out.push(proc_sys_event_count())
    out.push(ext_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pkernel-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pkernel()

    // ─── 1. syscall_invoke × 17 (one per fn, 4 group coverage) ───
    //   File I/O group (5)
    record_syscall_invoke(1, 0, "CreateFileW", "PARTIAL")
    println("__KERNEL32__ PARTIAL CreateFileW")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"CreateFileW\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"path_w_synth\":\"C:\\\\Battle.net\\\\D2R\\\\Save\\\\test.d2s\",\"access_kind\":\"0xC0000000\",\"create_kind\":\"0x00000003\"")
    record_syscall_invoke(2, 1, "CreateFileA", "PARTIAL")
    println("__KERNEL32__ PARTIAL CreateFileA")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"CreateFileA\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"path_a_synth\":\"C:\\\\temp\\\\bn_log.txt\",\"access_kind\":\"0x40000000\"")
    record_syscall_invoke(3, 2, "ReadFile", "PARTIAL")
    println("__KERNEL32__ PARTIAL ReadFile")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"ReadFile\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"bytes_synth\":1024,\"handle_hex\":\"0x00000400\"")
    record_syscall_invoke(4, 3, "WriteFile", "PARTIAL")
    println("__KERNEL32__ PARTIAL WriteFile")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"WriteFile\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"bytes_synth\":2048,\"handle_hex\":\"0x00000400\"")
    record_syscall_invoke(5, 4, "CloseHandle", "PARTIAL")
    println("__KERNEL32__ PARTIAL CloseHandle")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"CloseHandle\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"handle_hex\":\"0x00000400\"")

    //   Memory group (5)
    record_syscall_invoke(6, 5, "HeapAlloc", "PARTIAL")
    println("__KERNEL32__ PARTIAL HeapAlloc")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"HeapAlloc\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"size_synth\":4096,\"heap_base\":\"0x10000000\",\"flags\":\"0x00000008\"")
    record_syscall_invoke(7, 6, "HeapFree", "PARTIAL")
    println("__KERNEL32__ PARTIAL HeapFree")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"HeapFree\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"ptr_hex\":\"0x10001000\"")
    record_syscall_invoke(8, 7, "VirtualAlloc", "PARTIAL")
    println("__KERNEL32__ PARTIAL VirtualAlloc")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"VirtualAlloc\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"size_synth\":65536,\"region_kind\":\"0x00003000\",\"protect_kind\":\"0x00000004\"")
    record_syscall_invoke(9, 8, "VirtualFree", "PARTIAL")
    println("__KERNEL32__ PARTIAL VirtualFree")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"VirtualFree\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"ptr_hex\":\"0x20000000\",\"region_kind\":\"0x00008000\"")
    record_syscall_invoke(10, 9, "GetProcessHeap", "PARTIAL")
    println("__KERNEL32__ PARTIAL GetProcessHeap")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"GetProcessHeap\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"heap_base\":\"0x10000000\"")

    //   Process group (5: CreateProcessW + OpenProcess + GetCurrentProcess + TerminateProcess + WaitForSingleObject)
    record_syscall_invoke(11, 10, "CreateProcessW", "PARTIAL")
    println("__KERNEL32__ PARTIAL CreateProcessW")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"CreateProcessW\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"image_path_w_synth\":\"C:\\\\Battle.net\\\\Agent.exe\",\"pi_synth_bytes\":16")
    record_syscall_invoke(12, 11, "OpenProcess", "PARTIAL")
    println("__KERNEL32__ PARTIAL OpenProcess")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"OpenProcess\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"pid_synth\":\"0x00001234\",\"access_kind\":\"0x001F0FFF\"")
    record_syscall_invoke(13, 12, "GetCurrentProcess", "PARTIAL")
    println("__KERNEL32__ PARTIAL GetCurrentProcess")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":13,\"fn_kind\":12,\"fn_name\":\"GetCurrentProcess\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"pseudo_handle_hex\":\"0xFFFFFFFF\"")
    record_syscall_invoke(14, 13, "TerminateProcess", "PARTIAL")
    println("__KERNEL32__ PARTIAL TerminateProcess")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":14,\"fn_kind\":13,\"fn_name\":\"TerminateProcess\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"exit_code\":0,\"handle_hex\":\"0x00000800\"")
    record_syscall_invoke(15, 14, "WaitForSingleObject", "PARTIAL")
    println("__KERNEL32__ PARTIAL WaitForSingleObject")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":15,\"fn_kind\":14,\"fn_name\":\"WaitForSingleObject\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"timeout_ms\":5000,\"handle_hex\":\"0x00000800\"")

    //   System group (3: GetSystemTime + GetTickCount64 + Sleep — note Sleep uses fn_kind 17)
    record_syscall_invoke(16, 15, "GetSystemTime", "PARTIAL")
    println("__KERNEL32__ PARTIAL GetSystemTime")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":16,\"fn_kind\":15,\"fn_name\":\"GetSystemTime\",\"fn_group\":\"system\",\"status\":\"PARTIAL\",\"systemtime_hex\":\"EA0705000000030000000C0000000000\",\"year\":2026,\"month\":5,\"day\":3")
    record_syscall_invoke(17, 16, "GetTickCount64", "PARTIAL")
    println("__KERNEL32__ PARTIAL GetTickCount64")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":17,\"fn_kind\":16,\"fn_name\":\"GetTickCount64\",\"fn_group\":\"system\",\"status\":\"PARTIAL\",\"tick_synth\":\"0x000000010A2C8B40\"")
    record_syscall_invoke(18, 17, "Sleep", "PARTIAL")
    println("__KERNEL32__ PARTIAL Sleep")
    r0_emit("pe_kernel32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":18,\"fn_kind\":17,\"fn_name\":\"Sleep\",\"fn_group\":\"system\",\"status\":\"PARTIAL\",\"ms\":1000")

    // ─── cycle 32 W1 expansion: sync_primitive group (5: 18..22) ───
    record_syscall_invoke(19, 18, "InitializeCriticalSection", "PARTIAL")
