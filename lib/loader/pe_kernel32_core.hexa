// lib/loader/pe_kernel32_core.hexa — KERNEL32.dll core syscall surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine kernel32 source 측 코드 인용 0. WindowsBase / msvcrt / ntdll 직접 binding 0.
//       windows.h / winbase.h / fileapi.h / heapapi.h / processthreadsapi.h reference shape
//       만 (HANDLE / DWORD / SYSTEMTIME / PROCESS_INFORMATION). 실 CreateFileW / 실 ReadFile /
//       실 HeapAlloc / 실 CreateProcessW / 실 GetSystemTime = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track O — KERNEL32 (kernel32.dll) core syscall surface coverage 18 fn (skeleton row 만).
// Track K predecessor (3 network DLL skeleton-tier) 후 본 Track O 는 KERNEL32 측 핵심 system
// primitive 측 4 group 측 baseline land — file I/O + memory + process + system. cycle 27 측
// 8/435 (~1.8%) → cycle 28 측 26/435 (~5.98%) coverage progression (+18 fn 신규).
//
// Track W1 (cycle 32, 2026-05-04) — additive extension. 4 new group (15 fn 추가, additive_only):
// sync_primitive(5) + locale(3) + file_extras(4) + thread(3). 기존 18 fn 0 라인 변경. cycle 28 26
// → cycle 32 41/435 (~9.43%, KERNEL32 모듈 자체만 18 → 33 fn). 5 번째 TSV table ext_event 추가.
//
// 대상 fn (33 fn — 8 group, fn_kind 0..32 canonical map see fn_kind_name() below):
//   File I/O (5):       CreateFileW(0) / CreateFileA(1) / ReadFile(2) / WriteFile(3) / CloseHandle(4)
//   Memory (5):         HeapAlloc(5) / HeapFree(6) / VirtualAlloc(7) / VirtualFree(8) / GetProcessHeap(9)
//   Process (5):        CreateProcessW(10) / OpenProcess(11) / GetCurrentProcess(12) /
//                       TerminateProcess(13) / WaitForSingleObject(14)
//   System (3):         GetSystemTime(15) / GetTickCount64(16) / Sleep(17)
//   Sync primitive (5): InitializeCriticalSection(18) / EnterCriticalSection(19) /
//                       LeaveCriticalSection(20) / DeleteCriticalSection(21) / CreateMutexW(22)
//   Locale (3):         GetLocaleInfoW(23) / SetThreadLocale(24) / GetSystemDefaultLCID(25)
//   File extras (4):    GetFileAttributesW(26) / SetFileAttributesW(27) / DeleteFileW(28) /
//                       MoveFileExW(29)
//   Thread (3):         CreateThread(30) / GetCurrentThreadId(31) / ResumeThread(32)
//
// synthetic FILE_HANDLE: handle_hex "0x00000400", path_w_synth "C:\\Battle.net\\D2R\\Save\\test.d2s",
//   access_kind 0xC0000000 (GENERIC_READ|WRITE), create_kind 0x00000003 (OPEN_EXISTING).
// synthetic PROCESS_INFORMATION (16 byte): hProcess 0x00000800 / hThread 0x00000804 /
//   dwProcessId 0x00001234 / dwThreadId 0x00001238.
// synthetic SYSTEMTIME (16 byte = 8 × WORD): 2026-05-03 12:00:00 UTC encoded LE.
// synthetic heap shape: heap_base 0x10000000, alloc_size 4096, region_kind 0x00003000
//   (MEM_COMMIT|RESERVE), protect_kind 0x00000004 (PAGE_READWRITE).
// synthetic CRITICAL_SECTION (40 byte ref shape) at 0x30000100. synthetic mutex_handle 0x00000C00,
//   thread_handle 0x00000D00, tid 0x00001238. synthetic LCID 0x00000412 (ko-KR) / 0x00000409 (en-US).
//
// persist schema (TSV — 5 table): syscall_invoke / file_io_round_trip / memory_lifecycle /
//   proc_sys_event / ext_event (Track W1 cycle 32 추가).
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pkernel_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_kernel32_core"
}

fn pkernel_syscall_invoke_path() -> str {
    return pkernel_dir() + "/syscall_invoke.tsv"
}

fn pkernel_file_io_round_trip_path() -> str {
    return pkernel_dir() + "/file_io_round_trip.tsv"
}

fn pkernel_memory_lifecycle_path() -> str {
    return pkernel_dir() + "/memory_lifecycle.tsv"
}

fn pkernel_proc_sys_event_path() -> str {
    return pkernel_dir() + "/proc_sys_event.tsv"
}

// ─── cycle 32 W1 expansion: ext_event TSV table (sync_primitive / locale / file_extras / thread) ───
fn pkernel_ext_event_path() -> str {
    return pkernel_dir() + "/ext_event.tsv"
}

fn pkernel_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pkernel_dir() + "'")
}

fn cleanup_pkernel() -> void {
    pkernel_ensure_dir()
    let _ = exec("rm -f '" + pkernel_syscall_invoke_path() + "' '" + pkernel_file_io_round_trip_path()
        + "' '" + pkernel_memory_lifecycle_path() + "' '" + pkernel_proc_sys_event_path()
        + "' '" + pkernel_ext_event_path() + "'")
}

// ─── 공통 file IO ───
fn pkernel_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pkernel_append_row(path: str, row: str) -> void {
    pkernel_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pkernel_count_rows(path: str, min_cols: int) -> int {
    let t = pkernel_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (33 fn coverage, fn_kind 0..32) ───
//   cycle 28 baseline (Track O): fn_kind 0..17 (18 fn, 4 group)
//   cycle 32 W1 expansion (Track W1): fn_kind 18..32 (15 fn, 4 new group)
//     Sync primitive (5): InitializeCriticalSection / EnterCriticalSection /
//                         LeaveCriticalSection / DeleteCriticalSection / CreateMutexW
//     Locale (3):         GetLocaleInfoW / SetThreadLocale / GetSystemDefaultLCID
//     File extras (4):    GetFileAttributesW / SetFileAttributesW / DeleteFileW / MoveFileExW
//     Thread (3):         CreateThread / GetCurrentThreadId / ResumeThread
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "CreateFileW" }
    if k == 1 { return "CreateFileA" }
    if k == 2 { return "ReadFile" }
    if k == 3 { return "WriteFile" }
    if k == 4 { return "CloseHandle" }
    if k == 5 { return "HeapAlloc" }
    if k == 6 { return "HeapFree" }
    if k == 7 { return "VirtualAlloc" }
    if k == 8 { return "VirtualFree" }
    if k == 9 { return "GetProcessHeap" }
    if k == 10 { return "CreateProcessW" }
    if k == 11 { return "OpenProcess" }
    if k == 12 { return "GetCurrentProcess" }
    if k == 13 { return "TerminateProcess" }
    if k == 14 { return "WaitForSingleObject" }
    if k == 15 { return "GetSystemTime" }
    if k == 16 { return "GetTickCount64" }
    if k == 17 { return "Sleep" }
    // ─── cycle 32 W1 expansion (sync_primitive 18..22) ───
    if k == 18 { return "InitializeCriticalSection" }
    if k == 19 { return "EnterCriticalSection" }
    if k == 20 { return "LeaveCriticalSection" }
    if k == 21 { return "DeleteCriticalSection" }
    if k == 22 { return "CreateMutexW" }
    // ─── cycle 32 W1 expansion (locale 23..25) ───
    if k == 23 { return "GetLocaleInfoW" }
    if k == 24 { return "SetThreadLocale" }
    if k == 25 { return "GetSystemDefaultLCID" }
    // ─── cycle 32 W1 expansion (file_extras 26..29) ───
    if k == 26 { return "GetFileAttributesW" }
    if k == 27 { return "SetFileAttributesW" }
    if k == 28 { return "DeleteFileW" }
    if k == 29 { return "MoveFileExW" }
    // ─── cycle 32 W1 expansion (thread 30..32) ───
    if k == 30 { return "CreateThread" }
    if k == 31 { return "GetCurrentThreadId" }
    if k == 32 { return "ResumeThread" }
    return "unknown"
}

// ─── helper: fn_group_name (8 group classification — 4 baseline + 4 W1 expansion) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 4 {
            return "file_io"
        }
    }
    if k >= 5 {
        if k <= 9 {
            return "memory"
        }
    }
    if k >= 10 {
        if k <= 14 {
            return "process"
        }
    }
    if k >= 15 {
        if k <= 17 {
            return "system"
        }
    }
    if k >= 18 {
        if k <= 22 {
            return "sync_primitive"
        }
    }
    if k >= 23 {
        if k <= 25 {
            return "locale"
        }
    }
    if k >= 26 {
        if k <= 29 {
            return "file_extras"
        }
    }
    if k >= 30 {
        if k <= 32 {
            return "thread"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: KERNEL32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_kernel32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_kernel32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 32 {
        panic("pe_kernel32_core FAIL [record_syscall_invoke] expected=fn_kind<=32 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_kernel32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_kernel32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pkernel_append_row(pkernel_syscall_invoke_path(), row)
}

// ─── record_file_io_round_trip: CreateFile / ReadFile / WriteFile / CloseHandle synthetic byte counter ───
fn record_file_io_round_trip(io_id: int, op_id: str, handle_hex: str, bytes_synth: int, status: str) -> void {
    if io_id <= 0 {
        panic("pe_kernel32_core FAIL [record_file_io_round_trip] expected=io_id>0 got=" + to_string(io_id))
    }
