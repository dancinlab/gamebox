        "\"surface\":\"KERNEL32_core_33_fn\",\"fn_partial\":33,\"fn_groups\":8,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real CreateFileW + ReadFile + HeapAlloc + CreateProcessW + EnterCriticalSection + CreateMutexW + CreateThread pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"track_w1_cross_link\":\"KERNEL32_extended + NTDLL_W2 + OLE32_W3 + OLEAUT32_W4 = bundled cycle 32-35\"")

