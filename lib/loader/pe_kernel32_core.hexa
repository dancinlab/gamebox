    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_kernel32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pkernel()
    let s2 = pkernel_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_kernel32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_kernel32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", file_io_round_trip=" + to_string(s[1])
        + ", memory_lifecycle=" + to_string(s[2]) + ", proc_sys_event=" + to_string(s[3])
        + ", ext_event=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pkernel_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("file_io_round_trip_count\t" + to_string(s[1]))
            println("memory_lifecycle_count\t" + to_string(s[2]))
            println("proc_sys_event_count\t" + to_string(s[3]))
            println("ext_event_count\t" + to_string(s[4]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_kernel32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_kernel32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pkernel()
            println("cleaned: " + pkernel_dir())
            return
        }
        if sub == "dir" {
            println(pkernel_dir())
            return
        }
    }
    println("usage: hexa run pe_kernel32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
