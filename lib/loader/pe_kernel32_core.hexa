    }
    if handle_hex == "" {
        panic("pe_kernel32_core FAIL [record_file_io_round_trip] expected=handle_hex!=empty got=empty")
    }
    if bytes_synth < 0 {
        panic("pe_kernel32_core FAIL [record_file_io_round_trip] expected=bytes_synth>=0 got=" + to_string(bytes_synth))
    }
    if status == "" {
        panic("pe_kernel32_core FAIL [record_file_io_round_trip] expected=status!=empty got=empty")
    }
    let row = to_string(io_id) + "\t" + op_id + "\t" + handle_hex + "\t"
        + to_string(bytes_synth) + "\t" + status + "\n"
    pkernel_append_row(pkernel_file_io_round_trip_path(), row)
}

