    if fn_group_name(99) != "unknown" { panic("pe_kernel32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pkernel_stats()
    if len(s) != 5 { panic("pe_kernel32_core FAIL [stats len] expected=5 got=" + to_string(len(s))) }
