// ─── lookup by name → "<dll>\t<category>\t<rettype>\t<argc>" or "" ───
fn stub_lookup(name: str) -> str {
    let table = stub_table()
    let lines = table.split("\n")
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 5 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3] + "\t" + parts[4]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── default value (string) per Win32 return-type ───
// Microsoft Win32 API spec — failure-default values:
//   BOOL    → 0      (FALSE)
//   HANDLE  → -1     (INVALID_HANDLE_VALUE per CreateFile docs)
//   DWORD   → 0
//   LPVOID  → null
//   HRESULT → 0      (S_OK; 음수 = FAILED. stub default = success no-op.)
//   void    → "void"
//   ELSE    → 0
fn stub_default_value(rettype: str) -> str {
    if rettype == "BOOL"    { return "0" }
    if rettype == "HANDLE"  { return "-1" }
    if rettype == "LPVOID"  { return "null" }
    if rettype == "void"    { return "void" }
    if rettype == "HRESULT" { return "0" }
    // HWND/HDC/HMODULE/HINSTANCE/HMENU/HICON/HCURSOR/HBRUSH/HFONT/HBITMAP — handle-like → 0
    if rettype == "HWND"    { return "0" }
    if rettype == "HDC"     { return "0" }
    if rettype == "HMODULE" { return "0" }
    if rettype == "HINSTANCE" { return "0" }
    if rettype == "HMENU"   { return "0" }
    if rettype == "HICON"   { return "0" }
    if rettype == "HCURSOR" { return "0" }
    if rettype == "HBRUSH"  { return "0" }
    if rettype == "HFONT"   { return "0" }
    if rettype == "HBITMAP" { return "0" }
    // numeric scalars
    if rettype == "DWORD"   { return "0" }
    if rettype == "LRESULT" { return "0" }
    if rettype == "LONG"    { return "0" }
    if rettype == "INT"     { return "0" }
    if rettype == "ATOM"    { return "0" }
    if rettype == "UINT"    { return "0" }
    if rettype == "SHORT"   { return "0" }
    if rettype == "WORD"    { return "0" }
    if rettype == "BYTE"    { return "0" }
    return "0"
}

// ─── stub_call — emits "stub_call" event + returns "STUB:<name>(<args>) -> <default>" ───
fn stub_call(name: str, args_summary: str) -> str {
    let info = stub_lookup(name)
    if info == "" {
        // unknown — emit anyway for observability, default 0
        r0_emit("stub_call",
            "\"name\":\"" + name + "\""
            + ",\"dll\":\"unknown\""
            + ",\"category\":\"unknown\""
            + ",\"rettype\":\"unknown\""
            + ",\"argc\":-1"
            + ",\"args\":\"" + args_summary + "\""
            + ",\"default\":\"0\"")
        return "STUB:" + name + "(" + args_summary + ") -> 0"
    }
    let parts = info.split("\t")
    let dll = parts[0]
    let cat = parts[1]
    let rt = parts[2]
    let argc = parts[3]
    let dv = stub_default_value(rt)
    r0_emit("stub_call",
        "\"name\":\"" + name + "\""
        + ",\"dll\":\"" + dll + "\""
        + ",\"category\":\"" + cat + "\""
        + ",\"rettype\":\"" + rt + "\""
        + ",\"argc\":" + argc
        + ",\"args\":\"" + args_summary + "\""
        + ",\"default\":\"" + dv + "\"")
    return "STUB:" + name + "(" + args_summary + ") -> " + dv
}

// ─── category counts — returns array of [category, count] ───
fn category_counts() -> array {
    let table = stub_table()
    let lines = table.split("\n")
    let cats = []
    let counts = []
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 5 {
                let c = parts[2]
                // find existing
                let j = 0
                let found = -1
                while j < len(cats) {
                    if cats[j] == c {
                        found = j
                    }
                    j = j + 1
                }
                if found < 0 {
                    cats.push(c)
                    counts.push(1)
                } else {
                    counts[found] = counts[found] + 1
                }
            }
        }
        i = i + 1
    }
    let result = []
    let k = 0
    while k < len(cats) {
        result.push([cats[k], counts[k]])
        k = k + 1
    }
    return result
}

// ─── dll counts — returns array of [dll, count] ───
fn dll_counts() -> array {
    let table = stub_table()
    let lines = table.split("\n")
    let dlls = []
    let counts = []
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 5 {
                let d = parts[1]
                let j = 0
                let found = -1
                while j < len(dlls) {
                    if dlls[j] == d {
                        found = j
                    }
                    j = j + 1
                }
                if found < 0 {
                    dlls.push(d)
                    counts.push(1)
                } else {
                    counts[found] = counts[found] + 1
                }
            }
        }
        i = i + 1
    }
    let result = []
    let k = 0
    while k < len(dlls) {
        result.push([dlls[k], counts[k]])
        k = k + 1
    }
    return result
}

// ─── total non-empty row count ───
fn stub_table_size() -> int {
    let table = stub_table()
    let lines = table.split("\n")
    let n = 0
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "stubtest-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size ≥ 150 (lower bound for "200 핵심" — viable subset)
    let size = stub_table_size()
    if size < 150 {
        panic("win32_stubs FAIL [table_size] expected=>=150 got=" + to_string(size))
    }

    // 2. lookup CreateFileW → "kernel32\tfile\tHANDLE\t7"
    let info = stub_lookup("CreateFileW")
    let expected = "kernel32\tfile\tHANDLE\t7"
    if info != expected {
        panic("win32_stubs FAIL [lookup CreateFileW] expected=" + expected + " got=" + info)
    }

    // 3. lookup unknown → ""
    let none = stub_lookup("UnknownFunction")
    if none != "" {
        panic("win32_stubs FAIL [lookup unknown] expected= got=" + none)
    }

    // 4. stub_call CreateFileW (HANDLE → -1) — also produces 1st r0_emit "stub_call"
    let r = stub_call("CreateFileW", "test.txt")
    let exp_r = "STUB:CreateFileW(test.txt) -> -1"
    if r != exp_r {
        panic("win32_stubs FAIL [stub_call CreateFileW] expected=" + exp_r + " got=" + r)
    }

    // 4b. stub_call ReadFile (BOOL → 0)
    let r2 = stub_call("ReadFile", "h,buf,n")
    let exp_r2 = "STUB:ReadFile(h,buf,n) -> 0"
    if r2 != exp_r2 {
        panic("win32_stubs FAIL [stub_call ReadFile] expected=" + exp_r2 + " got=" + r2)
    }

    // 4c. stub_call VirtualAlloc (LPVOID → null)
    let r3 = stub_call("VirtualAlloc", "0,4096,MEM_COMMIT,PAGE_RW")
    let exp_r3 = "STUB:VirtualAlloc(0,4096,MEM_COMMIT,PAGE_RW) -> null"
    if r3 != exp_r3 {
        panic("win32_stubs FAIL [stub_call VirtualAlloc] expected=" + exp_r3 + " got=" + r3)
    }

    // 4d. stub_call Sleep (void → void)
    let r4 = stub_call("Sleep", "100")
    let exp_r4 = "STUB:Sleep(100) -> void"
    if r4 != exp_r4 {
        panic("win32_stubs FAIL [stub_call Sleep] expected=" + exp_r4 + " got=" + r4)
    }

    // 5. category_counts ≥ 5 distinct categories
    let cats = category_counts()
    if len(cats) < 5 {
        panic("win32_stubs FAIL [category count] expected=>=5 got=" + to_string(len(cats)))
    }

    // 6. dll_counts ≥ 4 DLLs (kernel32 + user32 + gdi32 + advapi32)
    let dlls = dll_counts()
    if len(dlls) < 4 {
        panic("win32_stubs FAIL [dll count] expected=>=4 got=" + to_string(len(dlls)))
    }
    // 6b. each of the 4 core DLLs present
    let i = 0
    let has_k = false
    let has_u = false
    let has_g = false
    let has_a = false
    while i < len(dlls) {
        let row = dlls[i]
        if row[0] == "kernel32" { has_k = true }
        if row[0] == "user32"   { has_u = true }
        if row[0] == "gdi32"    { has_g = true }
        if row[0] == "advapi32" { has_a = true }
        i = i + 1
    }
    if has_k == false {
        panic("win32_stubs FAIL [dll kernel32] expected=present got=absent")
    }
    if has_u == false {
        panic("win32_stubs FAIL [dll user32] expected=present got=absent")
    }
    if has_g == false {
        panic("win32_stubs FAIL [dll gdi32] expected=present got=absent")
    }
    if has_a == false {
        panic("win32_stubs FAIL [dll advapi32] expected=present got=absent")
    }

    // 7. summary emit (own 2 ≥ 2 events: 4 stub_call + 1 summary already > 2)
    r0_emit("stub_table_summary",
        "\"table_size\":" + to_string(size)
        + ",\"categories\":" + to_string(len(cats))
        + ",\"dlls\":" + to_string(len(dlls)))

    // 8. r0 emit count check — ≥ 2 (own 2 mandate; we emit 4 stub_call + 1 summary = 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 2 {
        panic("win32_stubs FAIL [r0 emit count] expected=>=2 got=" + to_string(emit_n))
    }

    println("  ✅ win32_stubs self_test PASS (table_size=" + to_string(size)
        + ", " + to_string(len(cats)) + " categories"
        + ", " + to_string(len(dlls)) + " DLLs"
        + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "size" {
            println(to_string(stub_table_size()))
            return
        }
        if sub == "lookup" {
            if len(a) >= 4 {
                let info = stub_lookup(a[3])
                if info == "" {
                    println("(not found)")
                } else {
                    println(info)
                }
                return
            }
            println("usage: lookup <name>")
            return
        }
        if sub == "call" {
            if len(a) >= 4 {
                let argsum = ""
                if len(a) >= 5 { argsum = a[4] }
                println(stub_call(a[3], argsum))
                return
            }
            println("usage: call <name> [args_summary]")
            return
        }
        if sub == "categories" {
            let cats = category_counts()
            let i = 0
            while i < len(cats) {
                let row = cats[i]
                println(row[0] + "\t" + to_string(row[1]))
                i = i + 1
            }
            return
        }
        if sub == "dlls" {
            let dlls = dll_counts()
            let i = 0
            while i < len(dlls) {
                let row = dlls[i]
                println(row[0] + "\t" + to_string(row[1]))
                i = i + 1
            }
            return
        }
        if sub == "table" {
            println(stub_table())
            return
        }
    }
    println("usage: hexa run win32_stubs.hexa { self-test | size | lookup <name> | call <name> [args] | categories | dlls | table }")
}
