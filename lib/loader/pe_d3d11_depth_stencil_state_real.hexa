// lib/loader/pe_d3d11_depth_stencil_state_real.hexa — D3D11 depth stencil state → MTLDepthStencilDescriptor
//
// ID3D11Device::CreateDepthStencilState 호출의 D3D11_DEPTH_STENCIL_DESC 매핑 추적기.
// 본 module 은 depth stencil state descriptor record/aggregate 만 — 실
// ID3D11Device::CreateDepthStencilState / ID3D11DeviceContext::OMSetDepthStencilState
// → MTLDevice newDepthStencilStateWithDescriptor / MTLRenderCommandEncoder
// setDepthStencilState 호출은 stage2 native helper(D3DMetal binary 위임) 에서 처리.
//
// D3D11_DEPTH_STENCIL_DESC → MTLDepthStencilDescriptor + MTLCompareFunction:
//   D3D11_COMPARISON_NEVER         (1) → MTLCompareFunctionNever
//   D3D11_COMPARISON_LESS          (2) → MTLCompareFunctionLess
//   D3D11_COMPARISON_EQUAL         (3) → MTLCompareFunctionEqual
//   D3D11_COMPARISON_LESS_EQUAL    (4) → MTLCompareFunctionLessEqual
//   D3D11_COMPARISON_GREATER       (5) → MTLCompareFunctionGreater
//   D3D11_COMPARISON_NOT_EQUAL     (6) → MTLCompareFunctionNotEqual
//   D3D11_COMPARISON_GREATER_EQUAL (7) → MTLCompareFunctionGreaterEqual
//   D3D11_COMPARISON_ALWAYS        (8) → MTLCompareFunctionAlways
//   StencilEnable           → MTLDepthStencilDescriptor.{front,back}FaceStencil
//   StencilWriteMask        → MTLStencilDescriptor.writeMask
//   OMSetDepthStencilState  → MTLRenderCommandEncoder setDepthStencilState
// own1: D3DMetal binary 위임 우선 + Metal SDK + MSDN ID3D11Device. MoltenVK/DXVK 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// depth_func code (D3D11_COMPARISON_FUNC):
//   1 = never
//   2 = less
//   3 = equal
//   4 = less_equal
//   5 = greater
//   6 = not_equal
//   7 = greater_equal
//   8 = always
//
// stencil_enabled flag:
//   0 = disabled
//   1 = enabled
//
// persist schema (TSV — states.tsv):
//   state_id<int> \t depth_func<int> \t stencil_enabled<int> \t write_mask<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdds11_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3d11_depth_stencil_state_real"
}

fn pdds11_states_path() -> str {
    return pdds11_dir() + "/states.tsv"
}

fn pdds11_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdds11_dir() + "'")
}

fn cleanup_pdds11() -> void {
    pdds11_ensure_dir()
    let _ = exec("rm -f '" + pdds11_states_path() + "'")
}

// ─── 공통 file IO ───
fn pdds11_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdds11_append_row(path: str, row: str) -> void {
    pdds11_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_state: depth stencil state descriptor 1 건 기록 ───
fn record_state(state_id: int, depth_func: int, stencil_enabled: int, write_mask: int) -> void {
    if state_id <= 0 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [record_state] expected=state_id>0 got=" + to_string(state_id))
    }
    if depth_func < 1 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [record_state] expected=depth_func>=1 got=" + to_string(depth_func))
    }
    if depth_func > 8 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [record_state] expected=depth_func<=8 got=" + to_string(depth_func))
    }
    if stencil_enabled < 0 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [record_state] expected=stencil_enabled>=0 got=" + to_string(stencil_enabled))
    }
    if stencil_enabled > 1 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [record_state] expected=stencil_enabled<=1 got=" + to_string(stencil_enabled))
    }
    if write_mask < 0 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [record_state] expected=write_mask>=0 got=" + to_string(write_mask))
    }
    let row = to_string(state_id) + "\t" + to_string(depth_func)
        + "\t" + to_string(stencil_enabled) + "\t" + to_string(write_mask) + "\n"
    pdds11_append_row(pdds11_states_path(), row)
}

// ─── state_count: total depth stencil state 수 ───
fn state_count() -> int {
    let t = pdds11_read_table(pdds11_states_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_depth_func: 특정 depth_func 의 state 수 ───
fn count_by_depth_func(depth_func: int) -> int {
    let t = pdds11_read_table(pdds11_states_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == depth_func {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── stencil_enabled_count: stencil_enabled=1 state 수 ───
fn stencil_enabled_count() -> int {
    let t = pdds11_read_table(pdds11_states_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_write_mask: 모든 state write_mask 합 ───
fn total_write_mask() -> int {
    let t = pdds11_read_table(pdds11_states_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── less_count: depth_func=less(2) + less_equal(4) state 수 ───
fn less_count() -> int {
    return count_by_depth_func(2) + count_by_depth_func(4)
}

// ─── state_write_mask: 특정 state_id 의 write_mask (없으면 0) ───
fn state_write_mask(state_id: int) -> int {
    let t = pdds11_read_table(pdds11_states_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == state_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdds11_stats: [state_count, total_write_mask, stencil_enabled_count, less_count] ───
fn pdds11_stats() -> array {
    let mut out = []
    out.push(state_count())
    out.push(total_write_mask())
    out.push(stencil_enabled_count())
    out.push(less_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdds11-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdds11()

    // 2. record 5 states — ≥3 depth_funcs, ≥2 stencil_enabled
    //    s1: less, stencil off, mask=0
    record_state(420001, 2, 0, 0)
    r0_emit("pe_d3d11_depth_stencil_state_real_record",
        "\"state_id\":420001,\"depth_func\":2,\"stencil_enabled\":0,\"write_mask\":0,\"target\":\"newDepthStencilStateWithDescriptor\"")

    //    s2: less_equal, stencil on, mask=255
    record_state(420002, 4, 1, 255)
    r0_emit("pe_d3d11_depth_stencil_state_real_record",
        "\"state_id\":420002,\"depth_func\":4,\"stencil_enabled\":1,\"write_mask\":255,\"target\":\"newDepthStencilStateWithDescriptor\"")

    //    s3: always, stencil off, mask=0
    record_state(420003, 8, 0, 0)
    r0_emit("pe_d3d11_depth_stencil_state_real_record",
        "\"state_id\":420003,\"depth_func\":8,\"stencil_enabled\":0,\"write_mask\":0,\"target\":\"newDepthStencilStateWithDescriptor\"")

    //    s4: less, stencil on, mask=128
    record_state(420004, 2, 1, 128)
    r0_emit("pe_d3d11_depth_stencil_state_real_record",
        "\"state_id\":420004,\"depth_func\":2,\"stencil_enabled\":1,\"write_mask\":128,\"target\":\"newDepthStencilStateWithDescriptor\"")

    //    s5: greater_equal, stencil off, mask=0
    record_state(420005, 7, 0, 0)
    r0_emit("pe_d3d11_depth_stencil_state_real_record",
        "\"state_id\":420005,\"depth_func\":7,\"stencil_enabled\":0,\"write_mask\":0,\"target\":\"newDepthStencilStateWithDescriptor\"")

    // 3. state_count = 5
    let c = state_count()
    if c != 5 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [state_count] expected=5 got=" + to_string(c))
    }

    // 4. total_write_mask = 0+255+0+128+0 = 383
    let tm = total_write_mask()
    if tm != 383 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [total_write_mask] expected=383 got=" + to_string(tm))
    }

    // 5. count_by_depth_func sanity
    //    depth_func=2 less → s1, s4 = 2
    let d2 = count_by_depth_func(2)
    if d2 != 2 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [count_by_depth_func(2)] expected=2 got=" + to_string(d2))
    }
    //    depth_func=4 less_equal → s2 = 1
    let d4 = count_by_depth_func(4)
    if d4 != 1 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [count_by_depth_func(4)] expected=1 got=" + to_string(d4))
    }
    //    depth_func=7 greater_equal → s5 = 1
    let d7 = count_by_depth_func(7)
    if d7 != 1 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [count_by_depth_func(7)] expected=1 got=" + to_string(d7))
    }
    //    depth_func=8 always → s3 = 1
    let d8 = count_by_depth_func(8)
    if d8 != 1 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [count_by_depth_func(8)] expected=1 got=" + to_string(d8))
    }
    //    depth_func=1 never → none = 0
    let d1 = count_by_depth_func(1)
    if d1 != 0 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [count_by_depth_func(1)] expected=0 got=" + to_string(d1))
    }

    // 6. stencil_enabled_count → s2, s4 = 2
    let se = stencil_enabled_count()
    if se != 2 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [stencil_enabled_count] expected=2 got=" + to_string(se))
    }

    // 7. less_count → less(2)=2 + less_equal(4)=1 = 3
    let lc = less_count()
    if lc != 3 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [less_count] expected=3 got=" + to_string(lc))
    }

    // 8. state_write_mask sanity
    let m2 = state_write_mask(420002)
    if m2 != 255 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [state_write_mask(420002)] expected=255 got=" + to_string(m2))
    }
    let m4 = state_write_mask(420004)
    if m4 != 128 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [state_write_mask(420004)] expected=128 got=" + to_string(m4))
    }
    let m_miss = state_write_mask(99999)
    if m_miss != 0 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [state_write_mask(99999)] expected=0 got=" + to_string(m_miss))
    }

    // 9. pdds11_stats() = [5, 383, 2, 3]
    let s = pdds11_stats()
    if len(s) != 4 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [stats state_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 383 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [stats total_write_mask] expected=383 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [stats stencil_enabled] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [stats less_count] expected=3 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_d3d11_depth_stencil_state_real_stats",
        "\"state_count\":" + to_string(s[0])
        + ",\"total_write_mask\":" + to_string(s[1])
        + ",\"stencil_enabled\":" + to_string(s[2])
        + ",\"less_count\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_d3d11_depth_stencil_state_real FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdds11()
    let s2 = pdds11_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d3d11_depth_stencil_state_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3d11_depth_stencil_state_real self_test PASS (states=" + to_string(s[0])
        + ", mask=" + to_string(s[1]) + ", stencil=" + to_string(s[2])
        + ", less=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdds11_stats()
            println("state_count\t" + to_string(s[0]))
            println("total_write_mask\t" + to_string(s[1]))
            println("stencil_enabled\t" + to_string(s[2]))
            println("less_count\t" + to_string(s[3]))
            return
        }
        if sub == "mask" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("state_write_mask\t" + to_string(state_write_mask(sid)))
                return
            }
            println("usage: hexa run pe_d3d11_depth_stencil_state_real.hexa mask <state_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let kind = a[3]
                let val = to_int(a[4])
                if kind == "depth" {
                    println("count_by_depth_func\t" + to_string(count_by_depth_func(val)))
                    return
                }
                println("usage: hexa run pe_d3d11_depth_stencil_state_real.hexa count depth <depth_func>")
                return
            }
            println("usage: hexa run pe_d3d11_depth_stencil_state_real.hexa count depth <depth_func>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdds11()
            println("cleaned: " + pdds11_dir())
            return
        }
        if sub == "dir" {
            println(pdds11_dir())
            return
        }
    }
    println("usage: hexa run pe_d3d11_depth_stencil_state_real.hexa { self-test | stats | mask <state_id> | count depth <depth_func> | cleanup | dir }")
}
