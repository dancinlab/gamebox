// lib/loader/pe_taskbar_progress.hexa — stage5 ITaskbarList3 progress telemetry skeleton
//
// Win32 ITaskbarList3::SetProgressValue / SetProgressState 호출 → macOS
// NSDockTile progress badge bridge. docker hexa 가 update telemetry 만 기록,
// 실 NSDockTile API 호출은 host native helper (stage6) 에서 수행.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 progress update tracker — ITaskbarList3 / NSDockTile 직접 bind X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// state_kind code (TBPFLAG / NSProgressIndicator 매핑):
//   1 = no_progress   (TBPF_NOPROGRESS)
//   2 = indeterminate (TBPF_INDETERMINATE)
//   3 = normal        (TBPF_NORMAL)
//   4 = error         (TBPF_ERROR)
//   5 = paused        (TBPF_PAUSED)
//
// persist schema (TSV — updates.tsv):
//   update_id<int> \t state_kind<int> \t progress_value<int> \t progress_total<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ptbp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_taskbar_progress"
}

fn ptbp_updates_path() -> str {
    return ptbp_dir() + "/updates.tsv"
}

fn ptbp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ptbp_dir() + "'")
}

fn cleanup_ptbp() -> void {
    ptbp_ensure_dir()
    let _ = exec("rm -f '" + ptbp_updates_path() + "'")
}

// ─── 공통 file IO ───
fn ptbp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ptbp_append_row(path: str, row: str) -> void {
    ptbp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_update: progress update 1 건 기록 ───
fn record_update(update_id: int, state_kind: int, progress_value: int, progress_total: int) -> void {
    if update_id <= 0 {
        panic("pe_taskbar_progress FAIL [record_update] expected=update_id>0 got=" + to_string(update_id))
    }
    if state_kind < 1 {
        panic("pe_taskbar_progress FAIL [record_update] expected=state_kind>=1 got=" + to_string(state_kind))
    }
    if state_kind > 5 {
        panic("pe_taskbar_progress FAIL [record_update] expected=state_kind<=5 got=" + to_string(state_kind))
    }
    if progress_value < 0 {
        panic("pe_taskbar_progress FAIL [record_update] expected=progress_value>=0 got=" + to_string(progress_value))
    }
    if progress_total < 0 {
        panic("pe_taskbar_progress FAIL [record_update] expected=progress_total>=0 got=" + to_string(progress_total))
    }
    if progress_value > progress_total {
        panic("pe_taskbar_progress FAIL [record_update] expected=progress_value<=progress_total got value=" + to_string(progress_value) + " total=" + to_string(progress_total))
    }
    let row = to_string(update_id) + "\t" + to_string(state_kind)
        + "\t" + to_string(progress_value) + "\t" + to_string(progress_total) + "\n"
    ptbp_append_row(ptbp_updates_path(), row)
}

// ─── update_count: total update 수 ───
fn update_count() -> int {
    let t = ptbp_read_table(ptbp_updates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_progress_value: 모든 update progress_value 합 ───
fn total_progress_value() -> int {
    let t = ptbp_read_table(ptbp_updates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_progress_total: 모든 update progress_total 합 ───
fn total_progress_total() -> int {
    let t = ptbp_read_table(ptbp_updates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_state: 특정 state_kind 의 update 수 ───
fn count_by_state(state_kind: int) -> int {
    let t = ptbp_read_table(ptbp_updates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == state_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── update_progress_value: 특정 update_id 의 progress_value (없으면 0) ───
fn update_progress_value(update_id: int) -> int {
    let t = ptbp_read_table(ptbp_updates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == update_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── ptbp_stats: [update_count, total_progress_value, total_progress_total, count_by_state(3)] ───
fn ptbp_stats() -> array {
    let mut out = []
    out.push(update_count())
    out.push(total_progress_value())
    out.push(total_progress_total())
    out.push(count_by_state(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ptbp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ptbp()

    // 2. record 5 updates across ≥3 state_kinds
    record_update(220001, 2, 0, 0)
    r0_emit("pe_taskbar_progress_record",
        "\"update_id\":220001,\"state_kind\":2,\"progress_value\":0,\"progress_total\":0,\"target\":\"indeterminate\"")

    record_update(220002, 3, 25, 100)
    r0_emit("pe_taskbar_progress_record",
        "\"update_id\":220002,\"state_kind\":3,\"progress_value\":25,\"progress_total\":100,\"target\":\"normal\"")

    record_update(220003, 3, 75, 100)
    r0_emit("pe_taskbar_progress_record",
        "\"update_id\":220003,\"state_kind\":3,\"progress_value\":75,\"progress_total\":100,\"target\":\"normal\"")

    record_update(220004, 5, 75, 100)
    r0_emit("pe_taskbar_progress_record",
        "\"update_id\":220004,\"state_kind\":5,\"progress_value\":75,\"progress_total\":100,\"target\":\"paused\"")

    record_update(220005, 4, 90, 100)
    r0_emit("pe_taskbar_progress_record",
        "\"update_id\":220005,\"state_kind\":4,\"progress_value\":90,\"progress_total\":100,\"target\":\"error\"")

    // 3. update_count = 5
    let c = update_count()
    if c != 5 {
        panic("pe_taskbar_progress FAIL [update_count] expected=5 got=" + to_string(c))
    }

    // 4. total_progress_value = 0+25+75+75+90 = 265
    let tv = total_progress_value()
    if tv != 265 {
        panic("pe_taskbar_progress FAIL [total_progress_value] expected=265 got=" + to_string(tv))
    }

    // 5. total_progress_total = 0+100+100+100+100 = 400
    let tt = total_progress_total()
    if tt != 400 {
        panic("pe_taskbar_progress FAIL [total_progress_total] expected=400 got=" + to_string(tt))
    }

    // 6. count_by_state sanity (4 distinct kinds: 2, 3, 4, 5)
    let s2 = count_by_state(2)
    if s2 != 1 {
        panic("pe_taskbar_progress FAIL [count_by_state(2)] expected=1 got=" + to_string(s2))
    }
    let s3 = count_by_state(3)
    if s3 != 2 {
        panic("pe_taskbar_progress FAIL [count_by_state(3)] expected=2 got=" + to_string(s3))
    }
    let s4 = count_by_state(4)
    if s4 != 1 {
        panic("pe_taskbar_progress FAIL [count_by_state(4)] expected=1 got=" + to_string(s4))
    }
    let s5 = count_by_state(5)
    if s5 != 1 {
        panic("pe_taskbar_progress FAIL [count_by_state(5)] expected=1 got=" + to_string(s5))
    }
    let s1 = count_by_state(1)
    if s1 != 0 {
        panic("pe_taskbar_progress FAIL [count_by_state(1)] expected=0 got=" + to_string(s1))
    }
    let s99 = count_by_state(99)
    if s99 != 0 {
        panic("pe_taskbar_progress FAIL [count_by_state(99)] expected=0 got=" + to_string(s99))
    }

    // 7. update_progress_value sanity
    let v2 = update_progress_value(220002)
    if v2 != 25 {
        panic("pe_taskbar_progress FAIL [update_progress_value(220002)] expected=25 got=" + to_string(v2))
    }
    let v5 = update_progress_value(220005)
    if v5 != 90 {
        panic("pe_taskbar_progress FAIL [update_progress_value(220005)] expected=90 got=" + to_string(v5))
    }
    let v_miss = update_progress_value(9999)
    if v_miss != 0 {
        panic("pe_taskbar_progress FAIL [update_progress_value(9999)] expected=0 got=" + to_string(v_miss))
    }

    // 8. ptbp_stats() = [5, 265, 400, 2]
    let st = ptbp_stats()
    if len(st) != 4 {
        panic("pe_taskbar_progress FAIL [stats len] expected=4 got=" + to_string(len(st)))
    }
    if st[0] != 5 {
        panic("pe_taskbar_progress FAIL [stats update_count] expected=5 got=" + to_string(st[0]))
    }
    if st[1] != 265 {
        panic("pe_taskbar_progress FAIL [stats total_progress_value] expected=265 got=" + to_string(st[1]))
    }
    if st[2] != 400 {
        panic("pe_taskbar_progress FAIL [stats total_progress_total] expected=400 got=" + to_string(st[2]))
    }
    if st[3] != 2 {
        panic("pe_taskbar_progress FAIL [stats count_state(3)] expected=2 got=" + to_string(st[3]))
    }

    // 9. emit stats
    r0_emit("pe_taskbar_progress_stats",
        "\"update_count\":" + to_string(st[0])
        + ",\"total_progress_value\":" + to_string(st[1])
        + ",\"total_progress_total\":" + to_string(st[2])
        + ",\"state_normal\":" + to_string(st[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_taskbar_progress FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_ptbp()
    let st2 = ptbp_stats()
    let i = 0
    while i < len(st2) {
        if st2[i] != 0 {
            panic("pe_taskbar_progress FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(st2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_taskbar_progress self_test PASS (updates=" + to_string(st[0])
        + ", value=" + to_string(st[1]) + ", total=" + to_string(st[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let st = ptbp_stats()
            println("update_count\t" + to_string(st[0]))
            println("total_progress_value\t" + to_string(st[1]))
            println("total_progress_total\t" + to_string(st[2]))
            println("count_state_normal\t" + to_string(st[3]))
            return
        }
        if sub == "value" {
            if len(a) >= 4 {
                let uid = to_int(a[3])
                println("update_progress_value\t" + to_string(update_progress_value(uid)))
                return
            }
            println("usage: hexa run pe_taskbar_progress.hexa value <update_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_state\t" + to_string(count_by_state(kind)))
                return
            }
            println("usage: hexa run pe_taskbar_progress.hexa count <state_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ptbp()
            println("cleaned: " + ptbp_dir())
            return
        }
        if sub == "dir" {
            println(ptbp_dir())
            return
        }
    }
    println("usage: hexa run pe_taskbar_progress.hexa { self-test | stats | value <update_id> | count <state_kind> | cleanup | dir }")
}
