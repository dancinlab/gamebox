// lib/loader/pe_clipboard_format.hexa — cycle 78 Win32 Clipboard format bridge skeleton
//
// Win32 RegisterClipboardFormat / SetClipboardData / GetClipboardData /
// EnumClipboardFormats / EmptyClipboard → macOS NSPasteboard bridge telemetry.
// 본 module 은 clipboard op tracker — NSPasteboard 실 호출 X (host helper stage).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = register_custom
//   2 = set_data
//   3 = get_data
//   4 = enum_format
//   5 = empty
//
// format_kind code:
//   1 = text_unicode   (CF_UNICODETEXT → NSPasteboardTypeString)
//   2 = hdrop          (CF_HDROP → NSPasteboardTypeFileURL)
//   3 = bitmap         (CF_BITMAP → NSPasteboardTypeTIFF)
//   4 = html           (CF_HTML → public.html)
//   5 = custom         (RegisterClipboardFormat)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t format_kind<int> \t data_size_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcf_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_clipboard_format"
}

fn pcf_ops_path() -> str {
    return pcf_dir() + "/ops.tsv"
}

fn pcf_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcf_dir() + "'")
}

fn cleanup_pcf() -> void {
    pcf_ensure_dir()
    let _ = exec("rm -f '" + pcf_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pcf_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcf_append_row(path: str, row: str) -> void {
    pcf_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: clipboard op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, format_kind: int, data_size_bytes: int) -> void {
    if op_id <= 0 {
        panic("pe_clipboard_format FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_clipboard_format FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 5 {
        panic("pe_clipboard_format FAIL [record_op] expected=op_kind<=5 got=" + to_string(op_kind))
    }
    if format_kind < 1 {
        panic("pe_clipboard_format FAIL [record_op] expected=format_kind>=1 got=" + to_string(format_kind))
    }
    if format_kind > 5 {
        panic("pe_clipboard_format FAIL [record_op] expected=format_kind<=5 got=" + to_string(format_kind))
    }
    if data_size_bytes < 0 {
        panic("pe_clipboard_format FAIL [record_op] expected=data_size_bytes>=0 got=" + to_string(data_size_bytes))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(format_kind) + "\t" + to_string(data_size_bytes) + "\n"
    pcf_append_row(pcf_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pcf_read_table(pcf_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_data_bytes: 모든 op data_size_bytes 합 ───
fn total_data_bytes() -> int {
    let t = pcf_read_table(pcf_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = pcf_read_table(pcf_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_format_kind: 특정 format_kind 의 op 수 ───
fn count_by_format_kind(kind: int) -> int {
    let t = pcf_read_table(pcf_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_data_bytes: 특정 op_id 의 data_size_bytes (없으면 0) ───
fn op_data_bytes(op_id: int) -> int {
    let t = pcf_read_table(pcf_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pcf_stats: [op_count, total_data_bytes, count_by_op_kind(2), count_by_format_kind(1)] ───
fn pcf_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_data_bytes())
    out.push(count_by_op_kind(2))
    out.push(count_by_format_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pcf-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pcf()

    // 2. record 5 ops across ≥3 op_kinds and ≥3 format_kinds
    //    op_kinds used: 1(register_custom), 2(set_data ×2), 3(get_data), 5(empty)  → 4 kinds
    //    format_kinds used: 5(custom), 1(text_unicode ×2), 2(hdrop), 4(html)       → 4 kinds
    record_op(120001, 1, 5, 0)
    r0_emit("pe_clipboard_format_record",
        "\"op_id\":120001,\"op_kind\":1,\"format_kind\":5,\"data_size_bytes\":0,\"target\":\"register_custom\"")

    record_op(120002, 2, 1, 128)
    r0_emit("pe_clipboard_format_record",
        "\"op_id\":120002,\"op_kind\":2,\"format_kind\":1,\"data_size_bytes\":128,\"target\":\"set_data_text\"")

    record_op(120003, 2, 2, 512)
    r0_emit("pe_clipboard_format_record",
        "\"op_id\":120003,\"op_kind\":2,\"format_kind\":2,\"data_size_bytes\":512,\"target\":\"set_data_hdrop\"")

    record_op(120004, 3, 1, 64)
    r0_emit("pe_clipboard_format_record",
        "\"op_id\":120004,\"op_kind\":3,\"format_kind\":1,\"data_size_bytes\":64,\"target\":\"get_data_text\"")

    record_op(120005, 5, 4, 0)
    r0_emit("pe_clipboard_format_record",
        "\"op_id\":120005,\"op_kind\":5,\"format_kind\":4,\"data_size_bytes\":0,\"target\":\"empty\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_clipboard_format FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_data_bytes = 0+128+512+64+0 = 704
    let tb = total_data_bytes()
    if tb != 704 {
        panic("pe_clipboard_format FAIL [total_data_bytes] expected=704 got=" + to_string(tb))
    }

    // 5. count_by_op_kind sanity (1=1, 2=2, 3=1, 5=1, 4=0, 99=0)
    let k1 = count_by_op_kind(1)
    if k1 != 1 {
        panic("pe_clipboard_format FAIL [count_by_op_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 2 {
        panic("pe_clipboard_format FAIL [count_by_op_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_clipboard_format FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 0 {
        panic("pe_clipboard_format FAIL [count_by_op_kind(4)] expected=0 got=" + to_string(k4))
    }
    let k5 = count_by_op_kind(5)
    if k5 != 1 {
        panic("pe_clipboard_format FAIL [count_by_op_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_clipboard_format FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_format_kind sanity (1=2, 2=1, 3=0, 4=1, 5=1, 99=0)
    let f1 = count_by_format_kind(1)
    if f1 != 2 {
        panic("pe_clipboard_format FAIL [count_by_format_kind(1)] expected=2 got=" + to_string(f1))
    }
    let f2 = count_by_format_kind(2)
    if f2 != 1 {
        panic("pe_clipboard_format FAIL [count_by_format_kind(2)] expected=1 got=" + to_string(f2))
    }
    let f3 = count_by_format_kind(3)
    if f3 != 0 {
        panic("pe_clipboard_format FAIL [count_by_format_kind(3)] expected=0 got=" + to_string(f3))
    }
    let f4 = count_by_format_kind(4)
    if f4 != 1 {
        panic("pe_clipboard_format FAIL [count_by_format_kind(4)] expected=1 got=" + to_string(f4))
    }
    let f5 = count_by_format_kind(5)
    if f5 != 1 {
        panic("pe_clipboard_format FAIL [count_by_format_kind(5)] expected=1 got=" + to_string(f5))
    }
    let f99 = count_by_format_kind(99)
    if f99 != 0 {
        panic("pe_clipboard_format FAIL [count_by_format_kind(99)] expected=0 got=" + to_string(f99))
    }

    // 7. op_data_bytes sanity
    let b3 = op_data_bytes(120003)
    if b3 != 512 {
        panic("pe_clipboard_format FAIL [op_data_bytes(120003)] expected=512 got=" + to_string(b3))
    }
    let b4 = op_data_bytes(120004)
    if b4 != 64 {
        panic("pe_clipboard_format FAIL [op_data_bytes(120004)] expected=64 got=" + to_string(b4))
    }
    let b_miss = op_data_bytes(9999)
    if b_miss != 0 {
        panic("pe_clipboard_format FAIL [op_data_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 8. pcf_stats() = [5, 704, 2, 2]
    let s = pcf_stats()
    if len(s) != 4 {
        panic("pe_clipboard_format FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_clipboard_format FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 704 {
        panic("pe_clipboard_format FAIL [stats total_data_bytes] expected=704 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_clipboard_format FAIL [stats count_op_kind(2)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_clipboard_format FAIL [stats count_format_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_clipboard_format_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_data_bytes\":" + to_string(s[1])
        + ",\"set_data_count\":" + to_string(s[2])
        + ",\"text_unicode_count\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_clipboard_format FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pcf()
    let s2 = pcf_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_clipboard_format FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_clipboard_format self_test PASS (ops=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", set_data=" + to_string(s[2])
        + ", text=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcf_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_data_bytes\t" + to_string(s[1]))
            println("count_op_kind_set_data\t" + to_string(s[2]))
            println("count_format_kind_text_unicode\t" + to_string(s[3]))
            return
        }
        if sub == "bytes" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_data_bytes\t" + to_string(op_data_bytes(oid)))
                return
            }
            println("usage: hexa run pe_clipboard_format.hexa bytes <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let what = a[3]
                let kind = to_int(a[4])
                if what == "op" {
                    println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                    return
                }
                if what == "format" {
                    println("count_by_format_kind\t" + to_string(count_by_format_kind(kind)))
                    return
                }
                println("usage: hexa run pe_clipboard_format.hexa count { op | format } <kind>")
                return
            }
            println("usage: hexa run pe_clipboard_format.hexa count { op | format } <kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcf()
            println("cleaned: " + pcf_dir())
            return
        }
        if sub == "dir" {
            println(pcf_dir())
            return
        }
    }
    println("usage: hexa run pe_clipboard_format.hexa { self-test | stats | bytes <op_id> | count op <op_kind> | count format <format_kind> | cleanup | dir }")
}
