// ─── record_midi_mixer_event: midiOutOpen/Close + mixerOpen/Close row ───
fn record_midi_mixer_event(evt_id: int, mm_kind: str, handle_hex: str, device_index: int, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_winmm_core FAIL [record_midi_mixer_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if mm_kind == "" {
        panic("pe_winmm_core FAIL [record_midi_mixer_event] expected=mm_kind!=empty got=empty")
    }
    if handle_hex == "" {
        panic("pe_winmm_core FAIL [record_midi_mixer_event] expected=handle_hex!=empty got=empty")
    }
    if device_index < 0 {
        panic("pe_winmm_core FAIL [record_midi_mixer_event] expected=device_index>=0 got=" + to_string(device_index))
    }
    if status == "" {
        panic("pe_winmm_core FAIL [record_midi_mixer_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + mm_kind + "\t" + handle_hex + "\t"
        + to_string(device_index) + "\t" + status + "\n"
    pwm_append_row(pwm_midi_mixer_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pwm_count_rows(pwm_syscall_invoke_path(), 4)
}

fn timer_event_count() -> int {
    return pwm_count_rows(pwm_timer_event_path(), 5)
}

fn wave_event_count() -> int {
    return pwm_count_rows(pwm_wave_event_path(), 5)
}

fn midi_mixer_event_count() -> int {
    return pwm_count_rows(pwm_midi_mixer_event_path(), 5)
}

fn pwm_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(timer_event_count())
    out.push(wave_event_count())
    out.push(midi_mixer_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pwm-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pwm()

    // ─── 1. syscall_invoke × 12 (one per fn, 4 group coverage) ───
    //   TIMER group (4)
    record_syscall_invoke(1, 0, "timeBeginPeriod", "PARTIAL")
    println("__WINMM__ PARTIAL timeBeginPeriod")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"timeBeginPeriod\",\"fn_group\":\"timer\",\"status\":\"PARTIAL\",\"uPeriod_ms\":1,\"frame_pacing_critical\":true,\"return_synth\":\"TIMERR_NOERROR_0\"")
    record_syscall_invoke(2, 1, "timeEndPeriod", "PARTIAL")
    println("__WINMM__ PARTIAL timeEndPeriod")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"timeEndPeriod\",\"fn_group\":\"timer\",\"status\":\"PARTIAL\",\"uPeriod_ms\":1,\"return_synth\":\"TIMERR_NOERROR_0\"")
    record_syscall_invoke(3, 2, "timeGetTime", "PARTIAL")
    println("__WINMM__ PARTIAL timeGetTime")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"timeGetTime\",\"fn_group\":\"timer\",\"status\":\"PARTIAL\",\"return_dword_synth\":\"0x12345678\",\"frame_pacing_query\":true")
    record_syscall_invoke(4, 3, "timeSetEvent", "PARTIAL")
    println("__WINMM__ PARTIAL timeSetEvent")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"timeSetEvent\",\"fn_group\":\"timer\",\"status\":\"PARTIAL\",\"uDelay_ms\":16,\"uResolution_ms\":1,\"fuEvent\":\"TIME_PERIODIC_0x0001\",\"timer_id_synth\":\"0x94040001\"")

    //   WAVE group (4)
    record_syscall_invoke(5, 4, "waveOutOpen", "PARTIAL")
    println("__WINMM__ PARTIAL waveOutOpen")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"waveOutOpen\",\"fn_group\":\"wave\",\"status\":\"PARTIAL\",\"uDeviceID\":\"WAVE_MAPPER_0xFFFFFFFF\",\"pwfx_format\":\"PCM_44100_stereo_16bit\",\"struct_bytes\":18,\"hwaveout_out_hex\":\"0x94010000\",\"return_synth\":\"MMSYSERR_NOERROR_0\"")
    record_syscall_invoke(6, 5, "waveOutWrite", "PARTIAL")
    println("__WINMM__ PARTIAL waveOutWrite")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"waveOutWrite\",\"fn_group\":\"wave\",\"status\":\"PARTIAL\",\"hwaveout_hex\":\"0x94010000\",\"pwh_buffer_hex\":\"0x94010100\",\"buffer_bytes\":4096,\"return_synth\":\"MMSYSERR_NOERROR_0\"")
    record_syscall_invoke(7, 6, "waveOutClose", "PARTIAL")
    println("__WINMM__ PARTIAL waveOutClose")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"waveOutClose\",\"fn_group\":\"wave\",\"status\":\"PARTIAL\",\"hwaveout_hex\":\"0x94010000\",\"return_synth\":\"MMSYSERR_NOERROR_0\"")
    record_syscall_invoke(8, 7, "waveOutGetVolume", "PARTIAL")
    println("__WINMM__ PARTIAL waveOutGetVolume")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"waveOutGetVolume\",\"fn_group\":\"wave\",\"status\":\"PARTIAL\",\"hwaveout_hex\":\"0x94010000\",\"pdwVolume_out_hex\":\"0xFFFFFFFF\",\"left_channel\":\"0xFFFF_max\",\"right_channel\":\"0xFFFF_max\",\"return_synth\":\"MMSYSERR_NOERROR_0\"")

    //   MIDI group (2)
    record_syscall_invoke(9, 8, "midiOutOpen", "PARTIAL")
    println("__WINMM__ PARTIAL midiOutOpen")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"midiOutOpen\",\"fn_group\":\"midi\",\"status\":\"PARTIAL\",\"uDeviceID\":\"MIDI_MAPPER_0xFFFFFFFF\",\"hmidiout_out_hex\":\"0x94020000\",\"dwCallback_synth\":0,\"fdwOpen\":\"CALLBACK_NULL_0x00000000\",\"return_synth\":\"MMSYSERR_NOERROR_0\"")
    record_syscall_invoke(10, 9, "midiOutClose", "PARTIAL")
    println("__WINMM__ PARTIAL midiOutClose")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"midiOutClose\",\"fn_group\":\"midi\",\"status\":\"PARTIAL\",\"hmidiout_hex\":\"0x94020000\",\"return_synth\":\"MMSYSERR_NOERROR_0\"")

    //   MIXER group (2)
    record_syscall_invoke(11, 10, "mixerOpen", "PARTIAL")
    println("__WINMM__ PARTIAL mixerOpen")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"mixerOpen\",\"fn_group\":\"mixer\",\"status\":\"PARTIAL\",\"uMxId\":0,\"hmixer_out_hex\":\"0x94030000\",\"dwCallback_synth\":0,\"fdwOpen\":\"MIXER_OBJECTF_MIXER_0x00000000\",\"return_synth\":\"MMSYSERR_NOERROR_0\"")
    record_syscall_invoke(12, 11, "mixerClose", "PARTIAL")
    println("__WINMM__ PARTIAL mixerClose")
    r0_emit("pe_winmm_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"mixerClose\",\"fn_group\":\"mixer\",\"status\":\"PARTIAL\",\"hmixer_hex\":\"0x94030000\",\"return_synth\":\"MMSYSERR_NOERROR_0\"")

    // ─── 2. timer_event × 4 (begin/end/get/set) — frame-pacing critical ───
    record_timer_event(1, "begin_period_1ms", 1, "0x12345678", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"timer_event\",\"evt_id\":1,\"t_kind\":\"begin_period_1ms\",\"period_ms\":1,\"frame_pacing_critical\":true,\"d2r_d4_prerequisite\":true,\"time_ms_synth\":\"0x12345678\",\"status\":\"PARTIAL\"")
    record_timer_event(2, "end_period_1ms", 1, "0x12345678", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"timer_event\",\"evt_id\":2,\"t_kind\":\"end_period_1ms\",\"period_ms\":1,\"time_ms_synth\":\"0x12345678\",\"status\":\"PARTIAL\"")
    record_timer_event(3, "get_time_dword", 0, "0x12345678", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"timer_event\",\"evt_id\":3,\"t_kind\":\"get_time_dword\",\"period_ms\":0,\"time_ms_synth\":\"0x12345678\",\"return_dword_bytes\":4,\"status\":\"PARTIAL\"")
    record_timer_event(4, "set_event_periodic_16ms", 16, "0x94040001", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"timer_event\",\"evt_id\":4,\"t_kind\":\"set_event_periodic_16ms\",\"period_ms\":16,\"resolution_ms\":1,\"fuEvent\":\"TIME_PERIODIC\",\"timer_id_synth\":\"0x94040001\",\"status\":\"PARTIAL\"")

    // ─── 3. wave_event × 4 (open/write/close/get_volume) ───
    record_wave_event(1, "open_pcm_44100_stereo_16bit", "0x94010000", "WAVEFORMATEX_18B_PCM_44100_2ch_16bit", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"wave_event\",\"evt_id\":1,\"w_kind\":\"open_pcm_44100_stereo_16bit\",\"hwaveout_hex\":\"0x94010000\",\"format_synth\":\"WAVEFORMATEX_18B_PCM_44100_2ch_16bit\",\"struct_bytes\":18,\"wFormatTag\":\"0x0001_PCM\",\"nChannels\":2,\"nSamplesPerSec\":44100,\"nAvgBytesPerSec\":176400,\"nBlockAlign\":4,\"wBitsPerSample\":16,\"cbSize\":0,\"status\":\"PARTIAL\"")
    record_wave_event(2, "write_4096b_buffer", "0x94010000", "WAVEHDR_buffer_0x94010100_4096b", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"wave_event\",\"evt_id\":2,\"w_kind\":\"write_4096b_buffer\",\"hwaveout_hex\":\"0x94010000\",\"pwh_buffer_hex\":\"0x94010100\",\"buffer_bytes\":4096,\"format_synth\":\"WAVEHDR_buffer_0x94010100_4096b\",\"status\":\"PARTIAL\"")
    record_wave_event(3, "close_release_handle", "0x94010000", "release_no_format", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"wave_event\",\"evt_id\":3,\"w_kind\":\"close_release_handle\",\"hwaveout_hex\":\"0x94010000\",\"format_synth\":\"release_no_format\",\"status\":\"PARTIAL\"")
    record_wave_event(4, "get_volume_max_both", "0x94010000", "left_0xFFFF_right_0xFFFF", "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"wave_event\",\"evt_id\":4,\"w_kind\":\"get_volume_max_both\",\"hwaveout_hex\":\"0x94010000\",\"format_synth\":\"left_0xFFFF_right_0xFFFF\",\"pdwVolume_out_hex\":\"0xFFFFFFFF\",\"status\":\"PARTIAL\"")

    // ─── 4. midi_mixer_event × 4 (midi_open/close + mixer_open/close) ───
    record_midi_mixer_event(1, "midi_open_mapper", "0x94020000", 0, "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"midi_mixer_event\",\"evt_id\":1,\"mm_kind\":\"midi_open_mapper\",\"handle_hex\":\"0x94020000\",\"device_index\":0,\"uDeviceID\":\"MIDI_MAPPER_0xFFFFFFFF\",\"status\":\"PARTIAL\"")
    record_midi_mixer_event(2, "midi_close", "0x94020000", 0, "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"midi_mixer_event\",\"evt_id\":2,\"mm_kind\":\"midi_close\",\"handle_hex\":\"0x94020000\",\"device_index\":0,\"status\":\"PARTIAL\"")
    record_midi_mixer_event(3, "mixer_open_index_0", "0x94030000", 0, "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"midi_mixer_event\",\"evt_id\":3,\"mm_kind\":\"mixer_open_index_0\",\"handle_hex\":\"0x94030000\",\"device_index\":0,\"fdwOpen\":\"MIXER_OBJECTF_MIXER\",\"status\":\"PARTIAL\"")
    record_midi_mixer_event(4, "mixer_close", "0x94030000", 0, "PARTIAL")
    r0_emit("pe_winmm_core_record", "\"kind\":\"midi_mixer_event\",\"evt_id\":4,\"mm_kind\":\"mixer_close\",\"handle_hex\":\"0x94030000\",\"device_index\":0,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 12 {
        panic("pe_winmm_core FAIL [syscall_invoke_count] expected=12 got=" + to_string(si))
    }
    let te = timer_event_count()
    if te != 4 {
        panic("pe_winmm_core FAIL [timer_event_count] expected=4 got=" + to_string(te))
    }
    let we = wave_event_count()
    if we != 4 {
        panic("pe_winmm_core FAIL [wave_event_count] expected=4 got=" + to_string(we))
    }
    let mme = midi_mixer_event_count()
    if mme != 4 {
        panic("pe_winmm_core FAIL [midi_mixer_event_count] expected=4 got=" + to_string(mme))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "timeBeginPeriod" { panic("pe_winmm_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "timeGetTime" { panic("pe_winmm_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(4) != "waveOutOpen" { panic("pe_winmm_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(8) != "midiOutOpen" { panic("pe_winmm_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(10) != "mixerOpen" { panic("pe_winmm_core FAIL [fn_kind_name(10)]") }
    if fn_kind_name(11) != "mixerClose" { panic("pe_winmm_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_winmm_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "timer" { panic("pe_winmm_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "wave" { panic("pe_winmm_core FAIL [fn_group_name(4)]") }
    if fn_group_name(8) != "midi" { panic("pe_winmm_core FAIL [fn_group_name(8)]") }
    if fn_group_name(10) != "mixer" { panic("pe_winmm_core FAIL [fn_group_name(10)]") }
    if fn_group_name(99) != "unknown" { panic("pe_winmm_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pwm_stats()
    if len(s) != 4 { panic("pe_winmm_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 12 { panic("pe_winmm_core FAIL [stats syscall_invoke_count] expected=12 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_winmm_core FAIL [stats timer_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_winmm_core FAIL [stats wave_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 4 { panic("pe_winmm_core FAIL [stats midi_mixer_event_count] expected=4 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_winmm_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"timer_event_count\":" + to_string(s[1])
        + ",\"wave_event_count\":" + to_string(s[2])
        + ",\"midi_mixer_event_count\":" + to_string(s[3]))

    r0_emit("pe_winmm_core_summary",
        "\"target\":\"WINMM.dll\",\"fn_total\":12,\"fn_emit_partial\":12,\"groups\":[\"timer\",\"wave\",\"midi\",\"mixer\"],\"waveformatex_synth_bytes\":18,\"frame_pacing_critical\":true,\"d2r_d4_prerequisite\":true,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_winmm_core_kpi",
        "\"timer_emits\":4,\"wave_emits\":4,\"midi_emits\":2,\"mixer_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"frame_pacing_critical_baseline\":true,\"d2r_d4_audio_prerequisite_partial\":true,\"coreaudio_audiounit_binding\":false")

    // ─── cycle 39 → 40 WINMM coverage progression evidence emit ───
    r0_emit("pe_winmm_core_coverage_progression",
        "\"surface\":\"WINMM_full_435_fn\",\"cycle_39_count\":176,\"cycle_40_count\":188,\"delta\":12,\"cycle_39_percent\":40.46,\"cycle_40_percent\":43.22,\"cycle_40_module\":\"pe_winmm_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_am1_cycle_increment\":12,\"track_am_bundled_target\":\"~40-50 fn (cycle 40-43)\"")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_winmm_core_round_trip_matrix",
        "\"surface\":\"WINMM_core_12_fn\",\"fn_partial\":12,\"fn_groups\":4,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real timeBeginPeriod + waveOutOpen + midiOutOpen + mixerOpen = mach_absolute_time + AudioUnit + CoreAudio bridge pending separate cycle (long-horizon)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"frame_pacing_baseline\":\"timeBeginPeriod 1ms = high precision baseline for D2R/D4 frame timing\"")

    // ─── Track AM1 expansion emit (cycle 40, WINMM +12 fn) ───
    r0_emit("pe_winmm_core_am1_expansion",
        "\"track\":\"AM1\",\"cycle\":40,\"surface\":\"WINMM_new\",\"new_fn\":12,\"groups\":[\"timer\",\"wave\",\"midi\",\"mixer\"],\"timer_count\":4,\"wave_count\":4,\"midi_count\":2,\"mixer_count\":2,\"emit_format\":\"__WINMM__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_am_bundled_part_1_of_4\":true,\"50pct_threshold_target\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_winmm_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pwm()
    let s2 = pwm_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_winmm_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_winmm_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", timer_event=" + to_string(s[1])
        + ", wave_event=" + to_string(s[2]) + ", midi_mixer_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pwm_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("timer_event_count\t" + to_string(s[1]))
            println("wave_event_count\t" + to_string(s[2]))
            println("midi_mixer_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_winmm_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_winmm_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pwm()
            println("cleaned: " + pwm_dir())
            return
        }
        if sub == "dir" {
            println(pwm_dir())
            return
        }
    }
    println("usage: hexa run pe_winmm_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
