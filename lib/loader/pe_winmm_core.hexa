// lib/loader/pe_winmm_core.hexa — WINMM.dll multimedia/timer surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine winmm source 측 코드 인용 0. winmm.dll 직접 binding 0. CoreAudio AudioUnit
//       AudioToolbox 직접 binding 0. timer fn (timeBeginPeriod/timeGetTime/timeSetEvent) 측
//       game frame-pacing critical surface — D2R/D4 frame pacing prerequisite, 본 module 측
//       WAVEFORMATEX struct round-trip + timer resolution baseline (long-horizon production
//       smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH/AM parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AM1 — WINMM (winmm.dll) multimedia/timer surface coverage 12 fn (skeleton row 만).
// Track AH4 predecessor (DXGI 10 fn cycle 39) 후 본 Track AM1 은 WINMM 측 timer/wave/midi/
// mixer baseline land. cycle 39 측 176/435 (~40.46%) → cycle 40 측 ~188/435 (~43.22%)
// coverage progression (+12 fn 신규, Track AM bundled cycle 40-43 측 AM1 row, 첫 row, game
// frame-pacing critical surface).
//
// 대상 fn (12 fn — 4 group, fn_kind 0..11 canonical map):
//   TIMER  (4): timeBeginPeriod(0) / timeEndPeriod(1) / timeGetTime(2) / timeSetEvent(3)
//   WAVE   (4): waveOutOpen(4) / waveOutWrite(5) / waveOutClose(6) / waveOutGetVolume(7)
//   MIDI   (2): midiOutOpen(8) / midiOutClose(9)
//   MIXER  (2): mixerOpen(10) / mixerClose(11)
//
// synthetic struct families:
//   WAVEFORMATEX 18 byte: wFormatTag 0x0001 (PCM) + nChannels 0x0002 (stereo) +
//     nSamplesPerSec 0x0000AC44 (44100) + nAvgBytesPerSec 0x0002B110 (176400) +
//     nBlockAlign 0x0004 (4) + wBitsPerSample 0x0010 (16) + cbSize 0x0000.
//   HWAVEOUT handle 0x94010000 / HMIDIOUT handle 0x94020000 / HMIXER handle 0x94030000 /
//   timer_id_synth 0x94040001 / period_ms_synth 1 (1ms = high precision) / time_ms_synth
//   0x12345678 (timeGetTime DWORD return synth).
//
// persist schema (TSV — 4 table): syscall_invoke / timer_event / wave_event / midi_mixer_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwm_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_winmm_core"
}

fn pwm_syscall_invoke_path() -> str {
    return pwm_dir() + "/syscall_invoke.tsv"
}

fn pwm_timer_event_path() -> str {
    return pwm_dir() + "/timer_event.tsv"
}

fn pwm_wave_event_path() -> str {
    return pwm_dir() + "/wave_event.tsv"
}

fn pwm_midi_mixer_event_path() -> str {
    return pwm_dir() + "/midi_mixer_event.tsv"
}

fn pwm_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwm_dir() + "'")
}

fn cleanup_pwm() -> void {
    pwm_ensure_dir()
    let _ = exec("rm -f '" + pwm_syscall_invoke_path() + "' '" + pwm_timer_event_path()
        + "' '" + pwm_wave_event_path() + "' '" + pwm_midi_mixer_event_path() + "'")
}

// ─── 공통 file IO ───
fn pwm_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwm_append_row(path: str, row: str) -> void {
    pwm_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pwm_count_rows(path: str, min_cols: int) -> int {
    let t = pwm_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "timeBeginPeriod" }
    if k == 1 { return "timeEndPeriod" }
    if k == 2 { return "timeGetTime" }
    if k == 3 { return "timeSetEvent" }
    if k == 4 { return "waveOutOpen" }
    if k == 5 { return "waveOutWrite" }
    if k == 6 { return "waveOutClose" }
    if k == 7 { return "waveOutGetVolume" }
    if k == 8 { return "midiOutOpen" }
    if k == 9 { return "midiOutClose" }
    if k == 10 { return "mixerOpen" }
    if k == 11 { return "mixerClose" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "timer"
        }
    }
    if k >= 4 {
        if k <= 7 {
            return "wave"
        }
    }
    if k >= 8 {
        if k <= 9 {
            return "midi"
        }
    }
    if k >= 10 {
        if k <= 11 {
            return "mixer"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: WINMM fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_winmm_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_winmm_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_winmm_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_winmm_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_winmm_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pwm_append_row(pwm_syscall_invoke_path(), row)
}

// ─── record_timer_event: timeBeginPeriod/timeEndPeriod/timeGetTime/timeSetEvent row ───
fn record_timer_event(evt_id: int, t_kind: str, period_ms: int, time_ms_synth: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_winmm_core FAIL [record_timer_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if t_kind == "" {
        panic("pe_winmm_core FAIL [record_timer_event] expected=t_kind!=empty got=empty")
    }
    if period_ms < 0 {
        panic("pe_winmm_core FAIL [record_timer_event] expected=period_ms>=0 got=" + to_string(period_ms))
    }
    if time_ms_synth == "" {
        panic("pe_winmm_core FAIL [record_timer_event] expected=time_ms_synth!=empty got=empty")
    }
    if status == "" {
        panic("pe_winmm_core FAIL [record_timer_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + t_kind + "\t" + to_string(period_ms) + "\t"
        + time_ms_synth + "\t" + status + "\n"
    pwm_append_row(pwm_timer_event_path(), row)
}

