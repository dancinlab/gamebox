// lib/loader/i386_call_frame.hexa — Phase 1 stage1 — i386 call frame 빌더
//
// Battle.net-Setup.exe (i386) 호출 시 stack frame 구성.
// cdecl / stdcall / fastcall / thiscall 별 args push 순서 + 정리 책임.
//
// stage1: frame layout 계산만 (스택 정리 위치, args 사이즈, ESP delta).
//          stage2 에서 native helper 로 실제 push/call/cleanup.

use "./win32_abi_i386"
use "../perf/r0_common"

// args sizing — 모든 i386 args 는 4-byte align
fn arg_slot_size() -> int { return 4 }

fn args_total_size(arg_count: int) -> int {
    return arg_count * arg_slot_size()
}

// cdecl: caller cleanup → call 후 esp += args_size
// stdcall: callee cleanup → call 후 esp 동일 (callee 가 ret N)
// fastcall: ecx,edx 처음 2개 / 나머지 stack / callee cleanup
// thiscall: ecx = this / 나머지 stack / callee cleanup
fn caller_cleanup_bytes(conv: str, arg_count: int) -> int {
    if conv == "cdecl" { return args_total_size(arg_count) }
    if conv == "stdcall" { return 0 }
    if conv == "fastcall" {
        let stack_args = arg_count - 2
        if stack_args < 0 { stack_args = 0 }
        return 0
    }
    if conv == "thiscall" {
        let stack_args = arg_count - 1
        if stack_args < 0 { stack_args = 0 }
        return 0
    }
    return 0
}

fn register_args_count(conv: str) -> int {
    if conv == "fastcall" { return 2 }
    if conv == "thiscall" { return 1 }
    return 0
}

fn stack_args_count(conv: str, total: int) -> int {
    let reg = register_args_count(conv)
    if total <= reg { return 0 }
    return total - reg
}

fn frame_layout(conv: str, arg_count: int) -> str {
    let reg = register_args_count(conv)
    let stk = stack_args_count(conv, arg_count)
    let cleanup = caller_cleanup_bytes(conv, arg_count)
    return "conv=" + conv + " reg=" + to_string(reg) + " stack=" + to_string(stk) + " cleanup=" + to_string(cleanup)
}

fn self_test() -> void {
    let sid = "icf-" + exec("date +%s").trim()
    r0_session_set(sid)

    if arg_slot_size() != 4 { panic("i386_call_frame FAIL [slot]") }
    if args_total_size(5) != 20 { panic("i386_call_frame FAIL [total 5]") }

    // cdecl 4 args → caller cleanup 16
    if caller_cleanup_bytes("cdecl", 4) != 16 { panic("i386_call_frame FAIL [cdecl cleanup]") }
    // stdcall 4 args → caller cleanup 0
    if caller_cleanup_bytes("stdcall", 4) != 0 { panic("i386_call_frame FAIL [stdcall cleanup]") }
    // fastcall 4 args → caller cleanup 0 (callee handles)
    if caller_cleanup_bytes("fastcall", 4) != 0 { panic("i386_call_frame FAIL [fastcall cleanup]") }

    // register vs stack split
    if register_args_count("fastcall") != 2 { panic("i386_call_frame FAIL [fastcall reg]") }
    if register_args_count("thiscall") != 1 { panic("i386_call_frame FAIL [thiscall reg]") }
    if register_args_count("cdecl") != 0 { panic("i386_call_frame FAIL [cdecl reg]") }

    // fastcall 5 args → 2 reg + 3 stack
    if stack_args_count("fastcall", 5) != 3 { panic("i386_call_frame FAIL [fastcall stack 5]") }
    // fastcall 1 arg → 0 stack
    if stack_args_count("fastcall", 1) != 0 { panic("i386_call_frame FAIL [fastcall stack 1]") }

    let lay = frame_layout("stdcall", 3)
    if !lay.contains("conv=stdcall") { panic("i386_call_frame FAIL [layout]") }

    r0_emit("i386_call_frame_ok", "\"conventions\":4")

    println("  ✅ i386_call_frame self_test PASS (cdecl/stdcall/fastcall/thiscall, register split, ESP delta)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "layout" && len(a) >= 5 {
            println(frame_layout(a[3], to_int(a[4])))
            return
        }
        if sub == "cleanup" && len(a) >= 5 {
            println(to_string(caller_cleanup_bytes(a[3], to_int(a[4]))))
            return
        }
    }
    println("usage: hexa run i386_call_frame.hexa { self-test | layout <conv> <argc> | cleanup <conv> <argc> }")
}
