// lib/loader/pe_xinput_gamepad.hexa — cycle 76 XInputGetState/SetState gamepad polling skeleton
//
// XInput API gamepad polling tracker — host native helper 가
// IOKit / GameController framework 으로 실제 컨트롤러 상태를 읽어
// XINPUT_STATE/XINPUT_VIBRATION 구조체로 변환해 docker hexa 에 telemetry 전달.
// 본 module 은 polling op tracker — 실 XInputGetState() / SetState() 호출 X (cycle 77+).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   xinput1_4.dll 자체 import / link / replacement 0 — bridge telemetry only.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// controller_index 범위: 0..3 (XUSER_MAX_COUNT = 4 — XInput 사양).
//
// persist schema (TSV — polls.tsv):
//   poll_id<int> \t controller_index<int> \t buttons_pressed<int> \t trigger_value<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pxg_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_xinput_gamepad"
}

fn pxg_polls_path() -> str {
    return pxg_dir() + "/polls.tsv"
}

fn pxg_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pxg_dir() + "'")
}

fn cleanup_pxg() -> void {
    pxg_ensure_dir()
    let _ = exec("rm -f '" + pxg_polls_path() + "'")
}

// ─── 공통 file IO ───
fn pxg_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pxg_append_row(path: str, row: str) -> void {
    pxg_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_poll: gamepad polling 1 건 기록 ───
fn record_poll(poll_id: int, controller_index: int, buttons_pressed: int, trigger_value: int) -> void {
    if poll_id <= 0 {
        panic("pe_xinput_gamepad FAIL [record_poll] expected=poll_id>0 got=" + to_string(poll_id))
    }
    if controller_index < 0 {
        panic("pe_xinput_gamepad FAIL [record_poll] expected=controller_index>=0 got=" + to_string(controller_index))
    }
    if controller_index > 3 {
        panic("pe_xinput_gamepad FAIL [record_poll] expected=controller_index<=3 got=" + to_string(controller_index))
    }
    if buttons_pressed < 0 {
        panic("pe_xinput_gamepad FAIL [record_poll] expected=buttons_pressed>=0 got=" + to_string(buttons_pressed))
    }
    if trigger_value < 0 {
        panic("pe_xinput_gamepad FAIL [record_poll] expected=trigger_value>=0 got=" + to_string(trigger_value))
    }
    if trigger_value > 255 {
        panic("pe_xinput_gamepad FAIL [record_poll] expected=trigger_value<=255 got=" + to_string(trigger_value))
    }
    let row = to_string(poll_id) + "\t" + to_string(controller_index)
        + "\t" + to_string(buttons_pressed) + "\t" + to_string(trigger_value) + "\n"
    pxg_append_row(pxg_polls_path(), row)
}

// ─── poll_count: total poll 수 ───
fn poll_count() -> int {
    let t = pxg_read_table(pxg_polls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_buttons_pressed: 모든 poll buttons_pressed 합 ───
fn total_buttons_pressed() -> int {
    let t = pxg_read_table(pxg_polls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_controller: 특정 controller_index 의 poll 수 ───
fn count_by_controller(controller_index: int) -> int {
    let t = pxg_read_table(pxg_polls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == controller_index {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── connected_count: skeleton 단계 — 매 poll 은 connected 로 가정 ───
fn connected_count() -> int {
    return poll_count()
}

// ─── poll_trigger: 특정 poll_id 의 trigger_value (없으면 0) ───
fn poll_trigger(poll_id: int) -> int {
    let t = pxg_read_table(pxg_polls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == poll_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pxg_stats: [poll_count, total_buttons_pressed, connected_count, count_by_controller(0)] ───
fn pxg_stats() -> array {
    let mut out = []
    out.push(poll_count())
    out.push(total_buttons_pressed())
    out.push(connected_count())
    out.push(count_by_controller(0))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pxg-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pxg()

    // 2. record 6 polls across controller_index 0..2 (deterministic synthetic)
    record_poll(760001, 0, 2, 0)
    r0_emit("pe_xinput_gamepad_record",
        "\"poll_id\":760001,\"controller_index\":0,\"buttons_pressed\":2,\"trigger_value\":0")

    record_poll(760002, 0, 1, 128)
    r0_emit("pe_xinput_gamepad_record",
        "\"poll_id\":760002,\"controller_index\":0,\"buttons_pressed\":1,\"trigger_value\":128")

    record_poll(760003, 1, 4, 64)
    r0_emit("pe_xinput_gamepad_record",
        "\"poll_id\":760003,\"controller_index\":1,\"buttons_pressed\":4,\"trigger_value\":64")

    record_poll(760004, 1, 0, 255)
    r0_emit("pe_xinput_gamepad_record",
        "\"poll_id\":760004,\"controller_index\":1,\"buttons_pressed\":0,\"trigger_value\":255")

    record_poll(760005, 2, 8, 32)
    r0_emit("pe_xinput_gamepad_record",
        "\"poll_id\":760005,\"controller_index\":2,\"buttons_pressed\":8,\"trigger_value\":32")

    record_poll(760006, 0, 3, 16)
    r0_emit("pe_xinput_gamepad_record",
        "\"poll_id\":760006,\"controller_index\":0,\"buttons_pressed\":3,\"trigger_value\":16")

    // 3. poll_count = 6
    let c = poll_count()
    if c != 6 {
        panic("pe_xinput_gamepad FAIL [poll_count] expected=6 got=" + to_string(c))
    }

    // 4. total_buttons_pressed = 2 + 1 + 4 + 0 + 8 + 3 = 18
    let tb = total_buttons_pressed()
    if tb != 18 {
        panic("pe_xinput_gamepad FAIL [total_buttons_pressed] expected=18 got=" + to_string(tb))
    }

    // 5. count_by_controller sanity
    let c0 = count_by_controller(0)
    if c0 != 3 {
        panic("pe_xinput_gamepad FAIL [count_by_controller(0)] expected=3 got=" + to_string(c0))
    }
    let c1 = count_by_controller(1)
    if c1 != 2 {
        panic("pe_xinput_gamepad FAIL [count_by_controller(1)] expected=2 got=" + to_string(c1))
    }
    let c2 = count_by_controller(2)
    if c2 != 1 {
        panic("pe_xinput_gamepad FAIL [count_by_controller(2)] expected=1 got=" + to_string(c2))
    }
    let c3 = count_by_controller(3)
    if c3 != 0 {
        panic("pe_xinput_gamepad FAIL [count_by_controller(3)] expected=0 got=" + to_string(c3))
    }

    // 6. connected_count = poll_count = 6 (skeleton 가정)
    let cc = connected_count()
    if cc != 6 {
        panic("pe_xinput_gamepad FAIL [connected_count] expected=6 got=" + to_string(cc))
    }

    // 7. poll_trigger sanity
    let t2 = poll_trigger(760002)
    if t2 != 128 {
        panic("pe_xinput_gamepad FAIL [poll_trigger(760002)] expected=128 got=" + to_string(t2))
    }
    let t4 = poll_trigger(760004)
    if t4 != 255 {
        panic("pe_xinput_gamepad FAIL [poll_trigger(760004)] expected=255 got=" + to_string(t4))
    }
    let t_miss = poll_trigger(9999)
    if t_miss != 0 {
        panic("pe_xinput_gamepad FAIL [poll_trigger(9999)] expected=0 got=" + to_string(t_miss))
    }

    // 8. pxg_stats() = [6, 18, 6, 3]
    let s = pxg_stats()
    if len(s) != 4 {
        panic("pe_xinput_gamepad FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_xinput_gamepad FAIL [stats poll_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 18 {
        panic("pe_xinput_gamepad FAIL [stats total_buttons_pressed] expected=18 got=" + to_string(s[1]))
    }
    if s[2] != 6 {
        panic("pe_xinput_gamepad FAIL [stats connected_count] expected=6 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_xinput_gamepad FAIL [stats count_controller_0] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_xinput_gamepad_stats",
        "\"poll_count\":" + to_string(s[0])
        + ",\"total_buttons_pressed\":" + to_string(s[1])
        + ",\"connected_count\":" + to_string(s[2])
        + ",\"controller_0_polls\":" + to_string(s[3]))

    // 10. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_xinput_gamepad FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pxg()
    let s2 = pxg_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_xinput_gamepad FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_xinput_gamepad self_test PASS (polls=" + to_string(s[0])
        + ", buttons=" + to_string(s[1]) + ", connected=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pxg_stats()
            println("poll_count\t" + to_string(s[0]))
            println("total_buttons_pressed\t" + to_string(s[1]))
            println("connected_count\t" + to_string(s[2]))
            println("count_controller_0\t" + to_string(s[3]))
            return
        }
        if sub == "trigger" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                println("poll_trigger\t" + to_string(poll_trigger(pid)))
                return
            }
            println("usage: hexa run pe_xinput_gamepad.hexa trigger <poll_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let ci = to_int(a[3])
                println("count_by_controller\t" + to_string(count_by_controller(ci)))
                return
            }
            println("usage: hexa run pe_xinput_gamepad.hexa count <controller_index>")
            return
        }
        if sub == "cleanup" {
            cleanup_pxg()
            println("cleaned: " + pxg_dir())
            return
        }
        if sub == "dir" {
            println(pxg_dir())
            return
        }
    }
    println("usage: hexa run pe_xinput_gamepad.hexa { self-test | stats | trigger <poll_id> | count <controller_index> | cleanup | dir }")
}
