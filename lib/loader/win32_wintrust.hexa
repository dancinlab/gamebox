// lib/loader/win32_wintrust.hexa — Phase 4g — wintrust minimal (코드서명 우회)
//
// own 1: Wine 0. Microsoft Code Signing spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe wintrust imports (실측):
//   WinVerifyTrust — Authenticode 코드 서명 검증
//
// own 1 정합 — 기존 OS 의 Wintrust 서명 검증 의존 X. macOS 는 codesign 자체
// verify 가능. installer 가 자기 자신 서명 검증할 때 Authenticode 호출 →
// skeleton 은 ERROR_SUCCESS (0) 반환 (verified 가정).
// 보안적으로 위험 — 실 install 단계는 사용자가 별도 검증.

use "../perf/r0_common"

fn wintrust_table() -> str {
    let t = ""
    t = t + "WinVerifyTrust\tcodesign_verify_skeleton\tCodeSigning\tstub\n"
    return t
}

fn wintrust_table_size() -> int {
    let lines = wintrust_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = wintrust_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

// stub — 항상 ERROR_SUCCESS (0) 반환 = signature valid 가정
fn win_verify_trust_stub(file_path: str) -> int {
    return 0  // ERROR_SUCCESS
}

fn self_test() -> void {
    let sid = "wintrusttest-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = wintrust_table_size()
    if sz != 1 { panic("win32_wintrust FAIL [size] expected=1 got=" + to_string(sz)) }

    let m = lookup_mapping("WinVerifyTrust")
    if !m.contains("CodeSigning") { panic("win32_wintrust FAIL [lookup]") }

    let unk = lookup_mapping("UnknownFunc")
    if unk != "" { panic("win32_wintrust FAIL [lookup unknown]") }

    let rc = win_verify_trust_stub("/tmp/fake.exe")
    if rc != 0 { panic("win32_wintrust FAIL [stub return] expected=0 got=" + to_string(rc)) }

    r0_emit("wintrust_verify", "\"file\":\"/tmp/fake.exe\",\"result\":0")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_wintrust FAIL [emit count]") }

    println("  ✅ win32_wintrust self_test PASS (1 func, signature stub=valid, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "verify" && len(a) >= 4 {
            let rc = win_verify_trust_stub(a[3])
            println("verify_result=" + to_string(rc))
            return
        }
    }
    println("usage: hexa run win32_wintrust.hexa { self-test | verify <file> }")
}
