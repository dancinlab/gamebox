// lib/loader/pe_perf_session_aggregator.hexa — session-level perf aggregator dashboard.
// own1: 자체 aggregator. third-party metrics 인용 X
// schema: session_id<int> \t perf_kind<int> \t metric_value<int> \t quantile<int>
//   perf_kind: 1=cold_launch_ms 2=avg_frametime_us 3=p99_frametime_us 4=p999_frametime_us
//              5=memory_kb 6=gpu_util_pct 7=thermal_idx 8=metalfx_factor
//   quantile: 0=mean 50=median 95=p95 99=p99 999=p999

use "../perf/r0_common"

fn ppsa_dir() -> str { return GAMEBOX_HOME + "/persist/pe_perf_session_aggregator" }
fn ppsa_sessions_path() -> str { return ppsa_dir() + "/sessions.tsv" }
fn ppsa_ensure_dir() -> void { let _ = exec("mkdir -p '" + ppsa_dir() + "'") }
fn cleanup_ppsa() -> void { ppsa_ensure_dir(); let _ = exec("rm -f '" + ppsa_sessions_path() + "'") }

fn ppsa_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" { return "" }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ppsa_append_row(path: str, row: str) -> void {
    ppsa_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn record_session(session_id: int, perf_kind: int, metric_value: int, quantile: int) -> void {
    if session_id <= 0 { panic("pe_perf_session_aggregator FAIL [record] session_id>0 got=" + to_string(session_id)) }
    if perf_kind < 1 { panic("pe_perf_session_aggregator FAIL [record] perf>=1 got=" + to_string(perf_kind)) }
    if perf_kind > 8 { panic("pe_perf_session_aggregator FAIL [record] perf<=8 got=" + to_string(perf_kind)) }
    if metric_value < 0 { panic("pe_perf_session_aggregator FAIL [record] metric>=0 got=" + to_string(metric_value)) }
    if quantile < 0 { panic("pe_perf_session_aggregator FAIL [record] quantile>=0 got=" + to_string(quantile)) }
    let row = to_string(session_id) + "\t" + to_string(perf_kind)
        + "\t" + to_string(metric_value) + "\t" + to_string(quantile) + "\n"
    ppsa_append_row(ppsa_sessions_path(), row)
}

fn session_count() -> int {
    let t = ppsa_read_table(ppsa_sessions_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { cnt = cnt + 1 }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_perf_kind(perf_kind: int) -> int {
    let t = ppsa_read_table(ppsa_sessions_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == perf_kind { cnt = cnt + 1 }
            }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_quantile(quantile: int) -> int {
    let t = ppsa_read_table(ppsa_sessions_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == quantile { cnt = cnt + 1 }
            }
        }
        i = i + 1
    }
    return cnt
}

fn total_metric_value() -> int {
    let t = ppsa_read_table(ppsa_sessions_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 { sum = sum + to_int(parts[2]) }
        }
        i = i + 1
    }
    return sum
}

fn cold_launch_count() -> int {
    return count_by_perf_kind(1)
}

fn session_metric(session_id: int) -> int {
    let t = ppsa_read_table(ppsa_sessions_path())
    if t == "" { return 0 }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == session_id { return to_int(parts[2]) }
            }
        }
        i = i + 1
    }
    return 0
}

fn ppsa_stats() -> array {
    let mut out = []
    out.push(session_count())
    out.push(total_metric_value())
    out.push(cold_launch_count())
    out.push(count_by_quantile(99))
    out.push(count_by_perf_kind(2))
    return out
}

fn self_test() -> void {
    let sid = "ppsa-" + exec("date +%s").trim()
    r0_session_set(sid)
    cleanup_ppsa()

    record_session(220001, 1, 4500, 0)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220001,\"perf\":1,\"value\":4500,\"q\":0")
    record_session(220002, 2, 8333, 50)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220002,\"perf\":2,\"value\":8333,\"q\":50")
    record_session(220003, 2, 11200, 95)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220003,\"perf\":2,\"value\":11200,\"q\":95")
    record_session(220004, 3, 16667, 99)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220004,\"perf\":3,\"value\":16667,\"q\":99")
    record_session(220005, 4, 33333, 999)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220005,\"perf\":4,\"value\":33333,\"q\":999")
    record_session(220006, 5, 4194304, 0)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220006,\"perf\":5,\"value\":4194304,\"q\":0")
    record_session(220007, 6, 87, 50)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220007,\"perf\":6,\"value\":87,\"q\":50")
    record_session(220008, 8, 200, 0)
    r0_emit("pe_perf_session_aggregator_record", "\"id\":220008,\"perf\":8,\"value\":200,\"q\":0")

    let c = session_count()
    if c != 8 { panic("pe_perf_session_aggregator FAIL [session_count] expected=8 got=" + to_string(c)) }
    let cl = cold_launch_count()
    if cl != 1 { panic("pe_perf_session_aggregator FAIL [cold_launch_count] expected=1 got=" + to_string(cl)) }
    let p99 = count_by_quantile(99)
    if p99 != 1 { panic("pe_perf_session_aggregator FAIL [count_by_quantile(99)] expected=1 got=" + to_string(p99)) }
    let p2 = count_by_perf_kind(2)
    if p2 != 2 { panic("pe_perf_session_aggregator FAIL [count_by_perf_kind(2)] expected=2 got=" + to_string(p2)) }

    let s = ppsa_stats()
    if len(s) != 5 { panic("pe_perf_session_aggregator FAIL [stats len] expected=5 got=" + to_string(len(s))) }
    r0_emit("pe_perf_session_aggregator_stats",
        "\"sessions\":" + to_string(s[0]) + ",\"total\":" + to_string(s[1])
        + ",\"cold_launch\":" + to_string(s[2]) + ",\"q99\":" + to_string(s[3])
        + ",\"avg_frametime\":" + to_string(s[4]))

    let emit_n = r0_session_count(sid)
    if emit_n < 9 { panic("pe_perf_session_aggregator FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n)) }

    cleanup_ppsa()
    let s2 = ppsa_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 { panic("pe_perf_session_aggregator FAIL [cleanup stats[" + to_string(i) + "]] expected=0 got=" + to_string(s2[i])) }
        i = i + 1
    }

    println("  ✅ pe_perf_session_aggregator self_test PASS (sessions=" + to_string(s[0])
        + ", total=" + to_string(s[1]) + ", cold_launch=" + to_string(s[2])
        + ", q99=" + to_string(s[3]) + ", avg_frametime=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = ppsa_stats()
            println("session_count\t" + to_string(s[0]))
            println("total_metric\t" + to_string(s[1]))
            println("cold_launch_count\t" + to_string(s[2]))
            println("q99_count\t" + to_string(s[3]))
            println("avg_frametime_count\t" + to_string(s[4]))
            return
        }
        if sub == "cleanup" { cleanup_ppsa(); println("cleaned: " + ppsa_dir()); return }
        if sub == "dir" { println(ppsa_dir()); return }
    }
    println("usage: hexa run pe_perf_session_aggregator.hexa { self-test | stats | cleanup | dir }")
}
