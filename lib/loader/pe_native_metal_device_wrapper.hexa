// lib/loader/pe_native_metal_device_wrapper.hexa — stage4 Metal device init wrapper skeleton
//
// MTLCreateSystemDefaultDevice() → MTLDevice handle. D3D11/D3D12 device →
// Apple D3DMetal binary 통해 매핑. cycle 49+ 의 c_metal_pipeline_archive 같은
// 모듈과 연계.

use "../perf/r0_common"

let PNMDW_DIR = GAMEBOX_HOME + "/persist/pe_native_metal_device_wrapper"
let PNMDW_TABLE = PNMDW_DIR + "/devices.tsv"

fn pnmdw_dir() -> str { return PNMDW_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + PNMDW_DIR + "'")
}

fn append_row(row: str) -> void {
    ensure_dir()
    let tmp = PNMDW_TABLE + ".tmp"
    write_file(tmp, row + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PNMDW_TABLE + "' && rm -f '" + tmp + "'")
}

fn device_kind_name(kind: int) -> str {
    if kind == 1 { return "apple_silicon" }
    if kind == 2 { return "intel_discrete" }
    if kind == 3 { return "external_gpu" }
    return "unknown"
}

fn family_tier_name(tier: int) -> str {
    if tier == 1 { return "A14" }
    if tier == 2 { return "M1" }
    if tier == 3 { return "M2" }
    if tier == 4 { return "M3" }
    if tier == 5 { return "M4" }
    return "unknown"
}

// Schema (TSV): call_id<int> | device_kind<int> | family_tier<int> | success<int>
fn record_device_init(call_id: int, device_kind: int, family_tier: int, success: int) -> void {
    append_row(to_string(call_id) + "\t" + to_string(device_kind) + "\t" + to_string(family_tier) + "\t" + to_string(success))
    r0_emit("pnmdw_device_init", "\"call_id\":" + to_string(call_id) + ",\"device_kind\":\"" + device_kind_name(device_kind) + "\",\"family_tier\":\"" + family_tier_name(family_tier) + "\",\"success\":" + to_string(success))
}

fn table_exists() -> bool {
    let r = exec("test -f '" + PNMDW_TABLE + "' && echo ok").trim()
    return r == "ok"
}

fn device_count() -> int {
    if !table_exists() { return 0 }
    return to_int(exec("wc -l < '" + PNMDW_TABLE + "' | tr -d ' '").trim())
}

fn success_count() -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' '$4==1 {c++} END {print c+0}' '" + PNMDW_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn count_by_device_kind(kind: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$2==k {c++} END {print c+0}' '" + PNMDW_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn count_by_family_tier(tier: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$3==t {c++} END {print c+0}' '" + PNMDW_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn call_family_tier(call_id: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v cid=" + to_string(call_id) + " '$1==cid {print $3; exit}' '" + PNMDW_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn pnmdw_stats() -> array {
    return [device_count(), success_count(), count_by_device_kind(1), count_by_family_tier(2)]
}

fn cleanup_pnmdw() -> void {
    let _ = exec("rm -rf '" + PNMDW_DIR + "'")
}

fn self_test() -> void {
    let sid = "pnmdw-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pnmdw()

    // 4 device init synthesis (다양한 Apple Silicon)
    record_device_init(102001, 1, 2, 1)   // M1 success
    record_device_init(102002, 1, 3, 1)   // M2 success
    record_device_init(102003, 1, 4, 1)   // M3 success
    record_device_init(102004, 1, 5, 1)   // M4 success

    // device_count
    let dc = device_count()
    if dc != 4 { panic("pe_native_metal_device_wrapper FAIL [device_count] expected=4 got=" + to_string(dc)) }

    // success_count
    let sc = success_count()
    if sc != 4 { panic("pe_native_metal_device_wrapper FAIL [success_count] expected=4 got=" + to_string(sc)) }

    // count_by_device_kind
    let k1 = count_by_device_kind(1)
    if k1 != 4 { panic("pe_native_metal_device_wrapper FAIL [count_by_device_kind 1] expected=4 got=" + to_string(k1)) }
    let k2 = count_by_device_kind(2)
    if k2 != 0 { panic("pe_native_metal_device_wrapper FAIL [count_by_device_kind 2] expected=0 got=" + to_string(k2)) }
    let k99 = count_by_device_kind(99)
    if k99 != 0 { panic("pe_native_metal_device_wrapper FAIL [count_by_device_kind 99] expected=0 got=" + to_string(k99)) }

    // count_by_family_tier
    let t2 = count_by_family_tier(2)
    if t2 != 1 { panic("pe_native_metal_device_wrapper FAIL [count_by_family_tier 2] expected=1 got=" + to_string(t2)) }
    let t3 = count_by_family_tier(3)
    if t3 != 1 { panic("pe_native_metal_device_wrapper FAIL [count_by_family_tier 3] expected=1 got=" + to_string(t3)) }
    let t4 = count_by_family_tier(4)
    if t4 != 1 { panic("pe_native_metal_device_wrapper FAIL [count_by_family_tier 4] expected=1 got=" + to_string(t4)) }
    let t5 = count_by_family_tier(5)
    if t5 != 1 { panic("pe_native_metal_device_wrapper FAIL [count_by_family_tier 5] expected=1 got=" + to_string(t5)) }
    let t99 = count_by_family_tier(99)
    if t99 != 0 { panic("pe_native_metal_device_wrapper FAIL [count_by_family_tier 99] expected=0 got=" + to_string(t99)) }

    // call_family_tier
    let cf1 = call_family_tier(102001)
    if cf1 != 2 { panic("pe_native_metal_device_wrapper FAIL [call_family_tier 102001] expected=2 got=" + to_string(cf1)) }
    let cf4 = call_family_tier(102004)
    if cf4 != 5 { panic("pe_native_metal_device_wrapper FAIL [call_family_tier 102004] expected=5 got=" + to_string(cf4)) }
    let cf_missing = call_family_tier(9999)
    if cf_missing != 0 { panic("pe_native_metal_device_wrapper FAIL [call_family_tier 9999] expected=0 got=" + to_string(cf_missing)) }

    // pnmdw_stats = [4, 4, 4, 1]
    let st = pnmdw_stats()
    if len(st) != 4 { panic("pe_native_metal_device_wrapper FAIL [pnmdw_stats len] expected=4 got=" + to_string(len(st))) }
    if st[0] != 4 { panic("pe_native_metal_device_wrapper FAIL [pnmdw_stats[0]] expected=4 got=" + to_string(st[0])) }
    if st[1] != 4 { panic("pe_native_metal_device_wrapper FAIL [pnmdw_stats[1]] expected=4 got=" + to_string(st[1])) }
    if st[2] != 4 { panic("pe_native_metal_device_wrapper FAIL [pnmdw_stats[2]] expected=4 got=" + to_string(st[2])) }
    if st[3] != 1 { panic("pe_native_metal_device_wrapper FAIL [pnmdw_stats[3]] expected=1 got=" + to_string(st[3])) }

    // emit count >= 5 (4 device_init + 1 summary)
    r0_emit("pnmdw_self_test", "\"device_count\":4,\"success_count\":4,\"apple_silicon\":4")
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("pe_native_metal_device_wrapper FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    cleanup_pnmdw()

    println("  ✅ pe_native_metal_device_wrapper self_test PASS (devices=4, success=4, apple_silicon=4, M1=1, M2=1, M3=1, M4=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let st = pnmdw_stats()
            println("device_count=" + to_string(st[0]) + " success_count=" + to_string(st[1]) + " apple_silicon=" + to_string(st[2]) + " M1=" + to_string(st[3]))
            return
        }
        if sub == "tier" && len(a) >= 4 {
            println(to_string(call_family_tier(to_int(a[3]))))
            return
        }
        if sub == "count_kind" && len(a) >= 4 {
            println(to_string(count_by_device_kind(to_int(a[3]))))
            return
        }
        if sub == "count_tier" && len(a) >= 4 {
            println(to_string(count_by_family_tier(to_int(a[3]))))
            return
        }
        if sub == "cleanup" { cleanup_pnmdw(); println("cleaned"); return }
    }
    println("usage: hexa run pe_native_metal_device_wrapper.hexa { self-test | stats | tier <call_id> | count_kind <device_kind> | count_tier <family_tier> | cleanup }")
}
