// lib/loader/pe_iphlpapi_core.hexa — IPHLPAPI.dll IP helper surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine iphlpapi source 인용 0.
//       iphlpapi.dll 직접 binding 0. macOS BSD getifaddrs(3) / sysctl(NET_RT_DUMP) /
//       sysctl(NET_RT_IFLIST) / route(4) / SystemConfiguration.framework SCDynamicStore /
//       SCNetworkConfiguration / Network.framework nw_path_monitor_t 직접 binding 0.
//       NOTE: IPHLPAPI 측 D2R/D4 멀티-NIC routing + Battle.net REST endpoint 24.105.62.129
//       p2p hole-punching adapter discovery + DNS resolver baseline; GetAdaptersInfo/
//       GetAdaptersAddresses/GetIpForwardTable/GetIpNetTable/SendARP/GetNetworkParams/
//       NotifyAddrChange 측 IP_ADAPTER_INFO/MIB_IPFORWARDTABLE round-trip baseline
//       (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BD4 — IPHLPAPI adapter/routing/arp/dns surface 12 fn skeleton-tier.
// cycle 50 292/435 (~67.13%) → cycle 51 ~304/435 (~69.89%) (+12 fn, BD bundled part 4/4).
//
// 대상 fn (12 fn — 4 group, fn_kind 0..11):
//   ADAPTER (4): GetAdaptersInfo(0) / GetAdaptersAddresses(1) /
//                GetIpAddrTable(2) / GetInterfaceInfo(3)
//   ROUTING (4): GetIpForwardTable(4) / CreateIpForwardEntry(5) /
//                DeleteIpForwardEntry(6) / GetBestRoute(7)
//   ARP     (2): GetIpNetTable(8) / SendARP(9)
//   DNS     (2): GetNetworkParams(10) / NotifyAddrChange(11)
//
// synthetic struct families:
//   IP_ADAPTER_INFO 640B per record: ComboIndex 0 + AdapterName "{12345678-1234-1234-1234-...}" +
//     Description "Apple M Synthetic Ethernet" + AddressLength 6 + Address 02-50-41-50-50-4C +
//     Index 1 + Type MIB_IF_TYPE_ETHERNET 6 + DhcpEnabled TRUE 1 +
//     IpAddressList "192.168.1.42" / Mask "255.255.255.0" + GatewayList "192.168.1.1".
//   MIB_IPFORWARDTABLE header 8B + entry MIB_IPFORWARDROW 56B per route: Dest 0.0.0.0 +
//     Mask 0.0.0.0 + NextHop 192.168.1.1 + IfIndex 1 + Type MIB_IPROUTE_TYPE_INDIRECT 4 +
//     Proto MIB_IPPROTO_NETMGMT 3 + Metric1 25.
//   MIB_IPNETTABLE header 8B + entry MIB_IPNETROW 24B per ARP: Index 1 + PhysAddrLen 6 +
//     PhysAddr 02-50-41-50-50-4C + IpAddr 192.168.1.1 + Type MIB_IPNET_TYPE_DYNAMIC 3.
//   FIXED_INFO 524B: HostName "DESKTOP-D2R" + DomainName "blizzard.com" + DnsServerList
//     IP_ADDR_STRING chain 8.8.8.8 + 1.1.1.1.
//   OVERLAPPED 32B: hEvent 0x9F010100 (NotifyAddrChange async).
//
// persist schema (TSV — 5 table):
//   syscall_invoke / adapter_event / routing_event / arp_event / dns_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pip_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_iphlpapi_core"
}

fn pip_syscall_invoke_path() -> str {
    return pip_dir() + "/syscall_invoke.tsv"
}

fn pip_adapter_event_path() -> str {
    return pip_dir() + "/adapter_event.tsv"
}

fn pip_routing_event_path() -> str {
    return pip_dir() + "/routing_event.tsv"
}

fn pip_arp_event_path() -> str {
    return pip_dir() + "/arp_event.tsv"
}

fn pip_dns_event_path() -> str {
    return pip_dir() + "/dns_event.tsv"
}

fn pip_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pip_dir() + "'")
}

fn cleanup_pip() -> void {
    pip_ensure_dir()
    let _ = exec("rm -f '" + pip_syscall_invoke_path() + "' '" + pip_adapter_event_path()
        + "' '" + pip_routing_event_path() + "' '" + pip_arp_event_path()
        + "' '" + pip_dns_event_path() + "'")
}

// ─── 공통 file IO ───
fn pip_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pip_append_row(path: str, row: str) -> void {
    pip_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pip_count_rows(path: str, min_cols: int) -> int {
    let t = pip_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "GetAdaptersInfo" }
    if k == 1 { return "GetAdaptersAddresses" }
    if k == 2 { return "GetIpAddrTable" }
    if k == 3 { return "GetInterfaceInfo" }
    if k == 4 { return "GetIpForwardTable" }
    if k == 5 { return "CreateIpForwardEntry" }
    if k == 6 { return "DeleteIpForwardEntry" }
    if k == 7 { return "GetBestRoute" }
    if k == 8 { return "GetIpNetTable" }
    if k == 9 { return "SendARP" }
    if k == 10 { return "GetNetworkParams" }
    if k == 11 { return "NotifyAddrChange" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "adapter"
        }
    }
    if k >= 4 {
        if k <= 7 {
            return "routing"
        }
    }
    if k >= 8 {
        if k <= 9 {
            return "arp"
        }
    }
    if k >= 10 {
        if k <= 11 {
            return "dns"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: IPHLPAPI fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_iphlpapi_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_iphlpapi_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_iphlpapi_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_iphlpapi_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_iphlpapi_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pip_append_row(pip_syscall_invoke_path(), row)
}

// ─── record_adapter_event: GetAdaptersInfo/Addresses/IpAddrTable/InterfaceInfo row ───
fn record_adapter_event(evt_id: int, a_kind: str, if_index: str, adapter_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_iphlpapi_core FAIL [record_adapter_event] evt_id<=0") }
    if a_kind == "" { panic("pe_iphlpapi_core FAIL [record_adapter_event] a_kind=empty") }
    if if_index == "" { panic("pe_iphlpapi_core FAIL [record_adapter_event] if_index=empty") }
    if adapter_synth == "" { panic("pe_iphlpapi_core FAIL [record_adapter_event] adapter_synth=empty") }
    if status == "" { panic("pe_iphlpapi_core FAIL [record_adapter_event] status=empty") }
    let row = to_string(evt_id) + "\t" + a_kind + "\t" + if_index + "\t" + adapter_synth + "\t" + status + "\n"
    pip_append_row(pip_adapter_event_path(), row)
}

