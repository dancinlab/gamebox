// lib/loader/win32_rpcrt4_stage2.hexa — Phase 4j stage2 — rpcrt4 stub DLL
//
// own 1: Wine 0. Microsoft RPC API spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe RPCRT4 imports (실측 via pe_imports DLL #2):
//   UuidToStringA   → RPC_STATUS → 0  (RPC_S_OK)
//   RpcStringFreeA  → RPC_STATUS → 0  (RPC_S_OK)
//   UuidCreate      → RPC_STATUS → 0  (RPC_S_OK)
//
// stage2: signature stub table 만 보유. 실제 호출 시 stage3 (uuidgen bridge)
// 가 mapping. 여기서는 prototype + return value 명세만.

use "../perf/r0_common"

fn stub_table() -> str {
    let t = ""
    // name \t return_kind \t return_value \t notes
    t = t + "UuidToStringA\tRPC_STATUS\t0\tUUID*,RPC_CSTR*\n"
    t = t + "RpcStringFreeA\tRPC_STATUS\t0\tRPC_CSTR*\n"
    t = t + "UuidCreate\tRPC_STATUS\t0\tUUID*\n"
    return t
}

fn stub_count() -> int {
    let lines = stub_table().split("\n")
    let i = 0
    let n = 0
    while i < len(lines) {
        if lines[i] != "" { n = n + 1 }
        i = i + 1
    }
    return n
}

fn stub_lookup(name: str) -> str {
    let lines = stub_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

// UuidCreate stub — RPC_STATUS → RPC_S_OK (0).
fn UuidCreate_stub() -> int {
    return 0
}

// UuidToStringA stub — RPC_STATUS → RPC_S_OK (0).
fn UuidToStringA_stub() -> int {
    return 0
}

// RpcStringFreeA stub — RPC_STATUS → RPC_S_OK (0).
fn RpcStringFreeA_stub() -> int {
    return 0
}

fn self_test() -> void {
    let sid = "rpcrt4stage2-" + exec("date +%s").trim()
    r0_session_set(sid)

    let n = stub_count()
    if n != 3 { panic("win32_rpcrt4_stage2 FAIL [size] expected=3 got=" + to_string(n)) }

    let a = stub_lookup("UuidCreate")
    if !a.contains("RPC_STATUS") { panic("win32_rpcrt4_stage2 FAIL [lookup UuidCreate]") }
    let b = stub_lookup("UuidToStringA")
    if !b.contains("RPC_STATUS") { panic("win32_rpcrt4_stage2 FAIL [lookup UuidToStringA]") }
    let c = stub_lookup("RpcStringFreeA")
    if !c.contains("RPC_STATUS") { panic("win32_rpcrt4_stage2 FAIL [lookup RpcStringFreeA]") }

    if UuidCreate_stub() != 0 { panic("win32_rpcrt4_stage2 FAIL [UuidCreate rv]") }
    if UuidToStringA_stub() != 0 { panic("win32_rpcrt4_stage2 FAIL [UuidToStringA rv]") }
    if RpcStringFreeA_stub() != 0 { panic("win32_rpcrt4_stage2 FAIL [RpcStringFreeA rv]") }

    let unk = stub_lookup("NotAnRpcCall")
    if unk != "" { panic("win32_rpcrt4_stage2 FAIL [unknown should be empty]") }

    r0_emit("rpcrt4_stage2_stub", "\"count\":" + to_string(n) + ",\"rv\":0")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_rpcrt4_stage2 FAIL [emit count]") }

    println("  ✅ win32_rpcrt4_stage2 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "count" { println(to_string(stub_count())); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = stub_lookup(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_rpcrt4_stage2.hexa { self-test | count | lookup <name> }")
}
