// lib/loader/win32_kernel32_tier4_heap.hexa — cycle 82 R6 Tier 4 KERNEL32 heap manager tracker
//
// Tier 4 KERNEL32 user-mode heap manager (Apple-native, own2 자체 구현):
//   HeapCreate(flags, initial, max)     → malloc-based heap allocator entry
//   HeapDestroy(h)                      → 모든 chunk 회수 + heap entry free
//   HeapAlloc(h, flags, size)           → posix_memalign or malloc + heap_id 추적
//   HeapReAlloc(h, flags, ptr, size)    → realloc
//   HeapFree(h, flags, ptr)             → free
//   HeapSize(h, flags, ptr)             → malloc_size or per-allocation size table
//   GetProcessHeap                      → fixed sentinel heap_id = 1
//   HeapValidate / HeapWalk             → walk through chunk metadata (cycle 72 pe_heap_walk cross-ref)
//   HeapCompact                         → no-op (Apple malloc 자동 compacting)
//   D2R/D4 같은 게임의 anti-cheat 가 heap walk + integrity check 사용
// own1: Apple malloc + MSDN HeapAPI spec. Wine kernel32/heap.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 heap call tracker — 실 HeapAlloc/HeapFree dispatch X (stage6).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//    1 = HeapCreate
//    2 = HeapDestroy
//    3 = HeapAlloc
//    4 = HeapReAlloc
//    5 = HeapFree
//    6 = HeapSize
//    7 = GetProcessHeap
//    8 = HeapValidate
//    9 = HeapWalk
//   10 = HeapCompact
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t heap_id<int> \t size_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn wkt4_dir() -> str {
    return GAMEBOX_HOME + "/persist/win32_kernel32_tier4_heap"
}

fn wkt4_calls_path() -> str {
    return wkt4_dir() + "/calls.tsv"
}

fn wkt4_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + wkt4_dir() + "'")
}

fn cleanup_wkt4() -> void {
    wkt4_ensure_dir()
    let _ = exec("rm -f '" + wkt4_calls_path() + "'")
}

// ─── 공통 file IO ───
fn wkt4_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn wkt4_append_row(path: str, row: str) -> void {
    wkt4_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: heap call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, heap_id: int, size_bytes: int) -> void {
    if call_id <= 0 {
        panic("win32_kernel32_tier4_heap FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("win32_kernel32_tier4_heap FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 10 {
        panic("win32_kernel32_tier4_heap FAIL [record_call] expected=func_kind<=10 got=" + to_string(func_kind))
    }
    if heap_id < 0 {
        panic("win32_kernel32_tier4_heap FAIL [record_call] expected=heap_id>=0 got=" + to_string(heap_id))
    }
    if size_bytes < 0 {
        panic("win32_kernel32_tier4_heap FAIL [record_call] expected=size_bytes>=0 got=" + to_string(size_bytes))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(heap_id) + "\t" + to_string(size_bytes) + "\n"
    wkt4_append_row(wkt4_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = wkt4_read_table(wkt4_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_size_bytes: 모든 call size_bytes 합 ───
fn total_size_bytes() -> int {
    let t = wkt4_read_table(wkt4_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = wkt4_read_table(wkt4_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_heaps: 고유 heap_id 수 ───
fn distinct_heaps() -> int {
    let t = wkt4_read_table(wkt4_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut seen = []
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let hid = to_int(parts[2])
                let mut found = 0
                let j = 0
                let m = len(seen)
                while j < m {
                    if seen[j] == hid {
                        found = 1
                    }
                    j = j + 1
                }
                if found == 0 {
                    seen.push(hid)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── alloc_free_balance: HeapAlloc + HeapReAlloc - HeapFree (양수 = leak) ───
fn alloc_free_balance() -> int {
    return count_by_func_kind(3) + count_by_func_kind(4) - count_by_func_kind(5)
}

// ─── call_size: 특정 call_id 의 size_bytes (없으면 0) ───
fn call_size(call_id: int) -> int {
    let t = wkt4_read_table(wkt4_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── wkt4_stats: [call_count, total_size_bytes, distinct_heaps, alloc_free_balance] ───
fn wkt4_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_size_bytes())
    out.push(distinct_heaps())
    out.push(alloc_free_balance())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "wkt4-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_wkt4()

    // 2. record 6 calls — ≥4 func_kinds + ≥2 distinct heap_ids
    //    heap_id=1 (process heap), heap_id=2 (custom heap)
    //    HeapCreate(custom)         → heap_id=2, size=65536
    //    GetProcessHeap             → heap_id=1, size=0
    //    HeapAlloc(process, 4096)   → heap_id=1, size=4096
    //    HeapAlloc(custom, 8192)    → heap_id=2, size=8192
    //    HeapReAlloc(custom, 16384) → heap_id=2, size=16384
    //    HeapFree(process)          → heap_id=1, size=4096
    //
    //    aggregate:
    //      call_count          = 6
    //      total_size_bytes    = 65536 + 0 + 4096 + 8192 + 16384 + 4096 = 98304
    //      distinct_heaps      = 2
    //      alloc_free_balance  = (HeapAlloc=2) + (HeapReAlloc=1) - (HeapFree=1) = 2

    record_call(820001, 1, 2, 65536)
    r0_emit("win32_kernel32_tier4_heap_record",
        "\"call_id\":820001,\"func_kind\":1,\"heap_id\":2,\"size_bytes\":65536,\"target\":\"HeapCreate\"")

    record_call(820002, 7, 1, 0)
    r0_emit("win32_kernel32_tier4_heap_record",
        "\"call_id\":820002,\"func_kind\":7,\"heap_id\":1,\"size_bytes\":0,\"target\":\"GetProcessHeap\"")

    record_call(820003, 3, 1, 4096)
    r0_emit("win32_kernel32_tier4_heap_record",
        "\"call_id\":820003,\"func_kind\":3,\"heap_id\":1,\"size_bytes\":4096,\"target\":\"HeapAlloc\"")

    record_call(820004, 3, 2, 8192)
    r0_emit("win32_kernel32_tier4_heap_record",
        "\"call_id\":820004,\"func_kind\":3,\"heap_id\":2,\"size_bytes\":8192,\"target\":\"HeapAlloc\"")

    record_call(820005, 4, 2, 16384)
    r0_emit("win32_kernel32_tier4_heap_record",
        "\"call_id\":820005,\"func_kind\":4,\"heap_id\":2,\"size_bytes\":16384,\"target\":\"HeapReAlloc\"")

    record_call(820006, 5, 1, 4096)
    r0_emit("win32_kernel32_tier4_heap_record",
        "\"call_id\":820006,\"func_kind\":5,\"heap_id\":1,\"size_bytes\":4096,\"target\":\"HeapFree\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("win32_kernel32_tier4_heap FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. total_size_bytes = 98304
    let tb = total_size_bytes()
    if tb != 98304 {
        panic("win32_kernel32_tier4_heap FAIL [total_size_bytes] expected=98304 got=" + to_string(tb))
    }

    // 5. count_by_func_kind sanity
    let k1 = count_by_func_kind(1)
    if k1 != 1 {
        panic("win32_kernel32_tier4_heap FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k3 = count_by_func_kind(3)
    if k3 != 2 {
        panic("win32_kernel32_tier4_heap FAIL [count_by_func_kind(3)] expected=2 got=" + to_string(k3))
    }
    let k4 = count_by_func_kind(4)
    if k4 != 1 {
        panic("win32_kernel32_tier4_heap FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_func_kind(5)
    if k5 != 1 {
        panic("win32_kernel32_tier4_heap FAIL [count_by_func_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k7 = count_by_func_kind(7)
    if k7 != 1 {
        panic("win32_kernel32_tier4_heap FAIL [count_by_func_kind(7)] expected=1 got=" + to_string(k7))
    }
    let k99 = count_by_func_kind(10)
    if k99 != 0 {
        panic("win32_kernel32_tier4_heap FAIL [count_by_func_kind(10)] expected=0 got=" + to_string(k99))
    }

    // 6. distinct_heaps = 2
    let dh = distinct_heaps()
    if dh != 2 {
        panic("win32_kernel32_tier4_heap FAIL [distinct_heaps] expected=2 got=" + to_string(dh))
    }

    // 7. alloc_free_balance = 2 (3 alloc-style calls - 1 free)
    let bal = alloc_free_balance()
    if bal != 2 {
        panic("win32_kernel32_tier4_heap FAIL [alloc_free_balance] expected=2 got=" + to_string(bal))
    }

    // 8. call_size sanity
    let s1 = call_size(820001)
    if s1 != 65536 {
        panic("win32_kernel32_tier4_heap FAIL [call_size(820001)] expected=65536 got=" + to_string(s1))
    }
    let s5 = call_size(820005)
    if s5 != 16384 {
        panic("win32_kernel32_tier4_heap FAIL [call_size(820005)] expected=16384 got=" + to_string(s5))
    }
    let s_miss = call_size(9999)
    if s_miss != 0 {
        panic("win32_kernel32_tier4_heap FAIL [call_size(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 9. wkt4_stats() = [6, 98304, 2, 2]
    let s = wkt4_stats()
    if len(s) != 4 {
        panic("win32_kernel32_tier4_heap FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("win32_kernel32_tier4_heap FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 98304 {
        panic("win32_kernel32_tier4_heap FAIL [stats total_size_bytes] expected=98304 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("win32_kernel32_tier4_heap FAIL [stats distinct_heaps] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("win32_kernel32_tier4_heap FAIL [stats alloc_free_balance] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("win32_kernel32_tier4_heap_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_size_bytes\":" + to_string(s[1])
        + ",\"distinct_heaps\":" + to_string(s[2])
        + ",\"alloc_free_balance\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("win32_kernel32_tier4_heap FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_wkt4()
    let s2 = wkt4_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("win32_kernel32_tier4_heap FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ win32_kernel32_tier4_heap self_test PASS (calls=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", heaps=" + to_string(s[2])
        + ", balance=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = wkt4_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_size_bytes\t" + to_string(s[1]))
            println("distinct_heaps\t" + to_string(s[2]))
            println("alloc_free_balance\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_size\t" + to_string(call_size(cid)))
                return
            }
            println("usage: hexa run win32_kernel32_tier4_heap.hexa size <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_func_kind\t" + to_string(count_by_func_kind(kind)))
                return
            }
            println("usage: hexa run win32_kernel32_tier4_heap.hexa count <func_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_wkt4()
            println("cleaned: " + wkt4_dir())
            return
        }
        if sub == "dir" {
            println(wkt4_dir())
            return
        }
    }
    println("usage: hexa run win32_kernel32_tier4_heap.hexa { self-test | stats | size <call_id> | count <func_kind> | cleanup | dir }")
}
