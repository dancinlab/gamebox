// lib/loader/win32_uiautomationcore.hexa — Phase 4k — UIAutomationCore no-op
//
// own 1: Wine 0. Microsoft UI Automation spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe UIAutomationCore imports (실측):
//   UiaHostProviderFromHwnd
//   UiaReturnRawElementProvider
//   UiaRaiseAutomationPropertyChangedEvent
//   UiaRaiseAutomationEvent
//   UiaClientsAreListening
//
// Accessibility framework — installer 가 screen reader 등 보조 도구 알림.
// installer 본체 동작에 영향 X — skeleton 단계 모두 no-op (S_OK 반환 가정).
// macOS 는 NSAccessibility framework 으로 동등 기능 — 향후 매핑 가능.

use "../perf/r0_common"

fn uiac_table() -> str {
    let t = ""
    t = t + "UiaHostProviderFromHwnd\tNSAccessibility_provider\tA11y\tnoop\n"
    t = t + "UiaReturnRawElementProvider\tNSAccessibility_return\tA11y\tnoop\n"
    t = t + "UiaRaiseAutomationPropertyChangedEvent\tnoop\tA11y\tnoop\n"
    t = t + "UiaRaiseAutomationEvent\tnoop\tA11y\tnoop\n"
    t = t + "UiaClientsAreListening\tNSAccessibility_isListening\tA11y\tnoop\n"
    return t
}

fn uiac_table_size() -> int {
    let lines = uiac_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = uiac_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

// 모두 no-op stub — S_OK (0) 반환
fn uia_noop() -> int {
    return 0
}

fn self_test() -> void {
    let sid = "uiactest-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = uiac_table_size()
    if sz != 5 { panic("win32_uiautomationcore FAIL [size] expected=5 got=" + to_string(sz)) }

    let m = lookup_mapping("UiaClientsAreListening")
    if !m.contains("A11y") { panic("win32_uiautomationcore FAIL [lookup]") }

    let unk = lookup_mapping("UnknownUiaFunc")
    if unk != "" { panic("win32_uiautomationcore FAIL [unknown]") }

    let rc = uia_noop()
    if rc != 0 { panic("win32_uiautomationcore FAIL [noop return]") }

    r0_emit("uia_lookup", "\"name\":\"UiaClientsAreListening\",\"result\":\"noop\"")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_uiautomationcore FAIL [emit count]") }

    println("  ✅ win32_uiautomationcore self_test PASS (5 funcs all no-op, A11y skeleton, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_mapping(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_uiautomationcore.hexa { self-test | lookup <name> }")
}
