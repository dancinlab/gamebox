// lib/loader/pe_crypt32_core.hexa — CRYPT32.dll PKI/CMS/PKCS7 surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine crypt32 source 측 코드 인용 0. crypt32.dll 직접 binding 0. macOS Security.framework
//       SecCertificate / SecTrust / SecPolicy / CommonCrypto / OpenSSL / BoringSSL / mbedtls
//       직접 binding 0. NOTE: CRYPT32 측 D2R/D4 launcher TLS cert chain validate + Battle.net
//       installer code-sign verify + CMS PKCS7 signed-data envelope decode 측 baseline,
//       본 module 측 CERT_CONTEXT + CRYPT_DATA_BLOB + HCRYPTMSG + HCERTSTORE struct
//       round-trip baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH/AM/AZ parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AZ1 — CRYPT32 (crypt32.dll) PKI/CMS/PKCS7 surface coverage 12 fn (skeleton row 만).
// Track AM4 predecessor (SETUPAPI 10 fn cycle 43, 50% threshold breach) 후 본 Track AZ1 측
// CRYPT32 cert/cms/pkcs7 baseline land. cycle 43 측 218/435 (~50.11%) → cycle 44 측
// ~230/435 (~52.87%) coverage progression (+12 fn 신규, Track AZ bundled cycle 44-47 측 AZ1 row,
// 첫 row).
//
// 대상 fn (12 fn — 3 group, fn_kind 0..11 canonical map):
//   CERT     (5): CertCreateCertificateContext(0) / CertVerifyCertificateChainPolicy(1) /
//                 CertOpenStore(2) / CertFindCertificateInStore(3) / CertCloseStore(4)
//   CMS      (4): CryptMsgOpenToDecode(5) / CryptMsgUpdate(6) / CryptMsgGetParam(7) /
//                 CryptMsgClose(8)
//   PKCS7    (3): CryptDecodeObject(9) / CryptDecodeObjectEx(10) / CryptHashData(11)
//
// synthetic struct families:
//   CERT_CONTEXT 28 byte: dwCertEncodingType 0x00010001 X509_ASN+PKCS_7 + pbCertEncoded ptr
//     0x98010100 + cbCertEncoded 1024 + pCertInfo ptr 0x98010200 + hCertStore handle 0x98010000.
//   CRYPT_DATA_BLOB 16 byte: cbData 4096 + pbData ptr 0x98020100.
//   HCRYPTMSG 0x98030000 (CMS message handle, opaque pointer to PKCS#7 SignedData envelope).
//   HCERTSTORE 0x98010000 (cert store handle, opaque — system "MY"/"ROOT"/"CA" container).
//   CERT_CHAIN_POLICY_PARA 12 byte: cbSize 12 + dwFlags 0 + pvExtraPolicyPara NULL.
//   CERT_CHAIN_POLICY_STATUS 12 byte: cbSize 12 + dwError 0 + lChainIndex -1 + lElementIndex -1.
//   PKCS_7_SIGNED_DATA OID synth: "1.2.840.113549.1.7.2" — PKCS#7 SignedData ContentType.
//   X509_NAME synth: "CN=Battle.net Update Agent CA, O=Blizzard Entertainment Inc, C=US".
//
// persist schema (TSV — 4 table): syscall_invoke / cert_event / cms_event / pkcs7_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcz_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_crypt32_core"
}

fn pcz_syscall_invoke_path() -> str {
    return pcz_dir() + "/syscall_invoke.tsv"
}

fn pcz_cert_event_path() -> str {
    return pcz_dir() + "/cert_event.tsv"
}

fn pcz_cms_event_path() -> str {
    return pcz_dir() + "/cms_event.tsv"
}

fn pcz_pkcs7_event_path() -> str {
    return pcz_dir() + "/pkcs7_event.tsv"
}

fn pcz_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcz_dir() + "'")
}

fn cleanup_pcz() -> void {
    pcz_ensure_dir()
    let _ = exec("rm -f '" + pcz_syscall_invoke_path() + "' '" + pcz_cert_event_path()
        + "' '" + pcz_cms_event_path() + "' '" + pcz_pkcs7_event_path() + "'")
}

// ─── 공통 file IO ───
fn pcz_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcz_append_row(path: str, row: str) -> void {
    pcz_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pcz_count_rows(path: str, min_cols: int) -> int {
    let t = pcz_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "CertCreateCertificateContext" }
    if k == 1 { return "CertVerifyCertificateChainPolicy" }
    if k == 2 { return "CertOpenStore" }
    if k == 3 { return "CertFindCertificateInStore" }
    if k == 4 { return "CertCloseStore" }
    if k == 5 { return "CryptMsgOpenToDecode" }
    if k == 6 { return "CryptMsgUpdate" }
    if k == 7 { return "CryptMsgGetParam" }
    if k == 8 { return "CryptMsgClose" }
    if k == 9 { return "CryptDecodeObject" }
    if k == 10 { return "CryptDecodeObjectEx" }
    if k == 11 { return "CryptHashData" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 4 {
            return "cert"
        }
    }
    if k >= 5 {
        if k <= 8 {
            return "cms"
        }
    }
    if k >= 9 {
        if k <= 11 {
            return "pkcs7"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: CRYPT32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_crypt32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_crypt32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_crypt32_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_crypt32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_crypt32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pcz_append_row(pcz_syscall_invoke_path(), row)
}

// ─── record_cert_event: CertCreateContext/VerifyChain/OpenStore/Find/Close row ───
fn record_cert_event(evt_id: int, c_kind: str, hcert_hex: str, cert_synth: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_crypt32_core FAIL [record_cert_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if c_kind == "" {
