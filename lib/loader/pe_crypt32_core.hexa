    }
    if hcert_hex == "" {
        panic("pe_crypt32_core FAIL [record_cert_event] expected=hcert_hex!=empty got=empty")
    }
    if cert_synth == "" {
        panic("pe_crypt32_core FAIL [record_cert_event] expected=cert_synth!=empty got=empty")
