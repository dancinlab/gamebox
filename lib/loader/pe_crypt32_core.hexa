// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pcz_count_rows(pcz_syscall_invoke_path(), 4)
}

fn cert_event_count() -> int {
    return pcz_count_rows(pcz_cert_event_path(), 5)
}

fn cms_event_count() -> int {
    return pcz_count_rows(pcz_cms_event_path(), 5)
}

fn pkcs7_event_count() -> int {
    return pcz_count_rows(pcz_pkcs7_event_path(), 5)
}

fn pcz_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(cert_event_count())
    out.push(cms_event_count())
    out.push(pkcs7_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pcz-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pcz()

    // ─── 1. syscall_invoke × 12 (one per fn, 3 group coverage) ───
    //   CERT group (5)
    record_syscall_invoke(1, 0, "CertCreateCertificateContext", "PARTIAL")
    println("__CRYPT32__ PARTIAL CertCreateCertificateContext")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"CertCreateCertificateContext\",\"fn_group\":\"cert\",\"status\":\"PARTIAL\",\"dwCertEncodingType\":\"X509_ASN_PKCS_7_0x00010001\",\"pbCertEncoded_synth\":\"0x98010100\",\"cbCertEncoded\":1024,\"pccert_context_out_hex\":\"0x98010300\",\"struct_bytes\":28")
    record_syscall_invoke(2, 1, "CertVerifyCertificateChainPolicy", "PARTIAL")
    println("__CRYPT32__ PARTIAL CertVerifyCertificateChainPolicy")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"CertVerifyCertificateChainPolicy\",\"fn_group\":\"cert\",\"status\":\"PARTIAL\",\"pszPolicyOID\":\"CERT_CHAIN_POLICY_BASE_0x00000001\",\"chain_policy_para_bytes\":12,\"chain_policy_status_bytes\":12,\"dwError\":0,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(3, 2, "CertOpenStore", "PARTIAL")
    println("__CRYPT32__ PARTIAL CertOpenStore")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"CertOpenStore\",\"fn_group\":\"cert\",\"status\":\"PARTIAL\",\"lpszStoreProvider\":\"CERT_STORE_PROV_SYSTEM_W_0x0A\",\"dwEncodingType\":\"X509_ASN_PKCS_7_0x00010001\",\"hCryptProv\":0,\"dwFlags\":\"CERT_SYSTEM_STORE_CURRENT_USER_0x00010000\",\"pvPara_synth\":\"WCHAR_MY_store\",\"hcertstore_out_hex\":\"0x98010000\"")
    record_syscall_invoke(4, 3, "CertFindCertificateInStore", "PARTIAL")
    println("__CRYPT32__ PARTIAL CertFindCertificateInStore")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"CertFindCertificateInStore\",\"fn_group\":\"cert\",\"status\":\"PARTIAL\",\"hCertStore\":\"0x98010000\",\"dwCertEncodingType\":\"X509_ASN_PKCS_7_0x00010001\",\"dwFindFlags\":0,\"dwFindType\":\"CERT_FIND_SUBJECT_STR_W_0x00080007\",\"pvFindPara_synth\":\"WCHAR_Battle_net_Update_Agent\",\"pccert_context_out_hex\":\"0x98010300\"")
    record_syscall_invoke(5, 4, "CertCloseStore", "PARTIAL")
    println("__CRYPT32__ PARTIAL CertCloseStore")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"CertCloseStore\",\"fn_group\":\"cert\",\"status\":\"PARTIAL\",\"hCertStore\":\"0x98010000\",\"dwFlags\":0,\"return_bool\":\"TRUE_1\"")

    //   CMS group (4)
    record_syscall_invoke(6, 5, "CryptMsgOpenToDecode", "PARTIAL")
    println("__CRYPT32__ PARTIAL CryptMsgOpenToDecode")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"CryptMsgOpenToDecode\",\"fn_group\":\"cms\",\"status\":\"PARTIAL\",\"dwMsgEncodingType\":\"X509_ASN_PKCS_7_0x00010001\",\"dwFlags\":0,\"dwMsgType\":\"CMSG_SIGNED_0x02\",\"hcryptprov\":0,\"hcryptmsg_out_hex\":\"0x98030000\"")
    record_syscall_invoke(7, 6, "CryptMsgUpdate", "PARTIAL")
    println("__CRYPT32__ PARTIAL CryptMsgUpdate")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"CryptMsgUpdate\",\"fn_group\":\"cms\",\"status\":\"PARTIAL\",\"hCryptMsg\":\"0x98030000\",\"pbData_synth\":\"PKCS7_SignedData_envelope_4096B\",\"cbData\":4096,\"fFinal\":\"TRUE_1\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(8, 7, "CryptMsgGetParam", "PARTIAL")
    println("__CRYPT32__ PARTIAL CryptMsgGetParam")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"CryptMsgGetParam\",\"fn_group\":\"cms\",\"status\":\"PARTIAL\",\"hCryptMsg\":\"0x98030000\",\"dwParamType\":\"CMSG_CONTENT_PARAM_0x02\",\"dwIndex\":0,\"pvData_synth\":\"signed_content_blob_2048B\",\"pcbData\":2048,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(9, 8, "CryptMsgClose", "PARTIAL")
    println("__CRYPT32__ PARTIAL CryptMsgClose")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"CryptMsgClose\",\"fn_group\":\"cms\",\"status\":\"PARTIAL\",\"hCryptMsg\":\"0x98030000\",\"return_bool\":\"TRUE_1\"")

    //   PKCS7 group (3)
    record_syscall_invoke(10, 9, "CryptDecodeObject", "PARTIAL")
    println("__CRYPT32__ PARTIAL CryptDecodeObject")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"CryptDecodeObject\",\"fn_group\":\"pkcs7\",\"status\":\"PARTIAL\",\"dwCertEncodingType\":\"X509_ASN_PKCS_7_0x00010001\",\"lpszStructType\":\"PKCS_7_SIGNED_OID_1_2_840_113549_1_7_2\",\"pbEncoded_synth\":\"0x98020100\",\"cbEncoded\":4096,\"dwFlags\":0,\"pvStructInfo_synth\":\"PKCS7_SignedData_decoded_struct\",\"pcbStructInfo\":2048,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(11, 10, "CryptDecodeObjectEx", "PARTIAL")
    println("__CRYPT32__ PARTIAL CryptDecodeObjectEx")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"CryptDecodeObjectEx\",\"fn_group\":\"pkcs7\",\"status\":\"PARTIAL\",\"dwCertEncodingType\":\"X509_ASN_PKCS_7_0x00010001\",\"lpszStructType\":\"X509_NAME_OID_1_2_840_113549_1_9_22_2\",\"pbEncoded_synth\":\"0x98020200\",\"cbEncoded\":256,\"dwFlags\":\"CRYPT_DECODE_ALLOC_FLAG_0x00008000\",\"pDecodePara_synth\":\"NULL\",\"pvStructInfo_synth\":\"X509_NAME_CN_Battle_net_Update_Agent_CA\",\"pcbStructInfo\":256,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(12, 11, "CryptHashData", "PARTIAL")
    println("__CRYPT32__ PARTIAL CryptHashData")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"CryptHashData\",\"fn_group\":\"pkcs7\",\"status\":\"PARTIAL\",\"hHash\":\"0x98040000\",\"pbData_synth\":\"signed_content_blob_2048B\",\"cbData\":2048,\"dwFlags\":0,\"hash_algo_synth\":\"CALG_SHA_256_0x0000800C\",\"hash_size\":32,\"hash_value_synth\":\"3a4f9b...e2c8\",\"return_bool\":\"TRUE_1\"")

    // ─── 2. cert_event × 5 (create/verify/open/find/close) ───
    record_cert_event(1, "create_blizzard_ca_cert", "0x98010300", "CERT_CONTEXT_28B_X509_ASN_PKCS_7", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cert_event\",\"evt_id\":1,\"c_kind\":\"create_blizzard_ca_cert\",\"hcert_hex\":\"0x98010300\",\"cert_synth\":\"CERT_CONTEXT_28B_X509_ASN_PKCS_7\",\"struct_bytes\":28,\"X509_NAME\":\"CN=Battle.net Update Agent CA, O=Blizzard Entertainment Inc, C=US\",\"cbCertEncoded\":1024,\"status\":\"PARTIAL\"")
    record_cert_event(2, "verify_chain_policy_base", "0x98010300", "CERT_CHAIN_POLICY_BASE_dwError_0", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cert_event\",\"evt_id\":2,\"c_kind\":\"verify_chain_policy_base\",\"hcert_hex\":\"0x98010300\",\"cert_synth\":\"CERT_CHAIN_POLICY_BASE_dwError_0\",\"chain_policy_para_bytes\":12,\"chain_policy_status_bytes\":12,\"dwError\":0,\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_cert_event(3, "open_my_system_store", "0x98010000", "CERT_STORE_PROV_SYSTEM_W_MY_CURRENT_USER", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cert_event\",\"evt_id\":3,\"c_kind\":\"open_my_system_store\",\"hcert_hex\":\"0x98010000\",\"cert_synth\":\"CERT_STORE_PROV_SYSTEM_W_MY_CURRENT_USER\",\"dwFlags\":\"CERT_SYSTEM_STORE_CURRENT_USER\",\"pvPara\":\"MY\",\"status\":\"PARTIAL\"")
    record_cert_event(4, "find_battlenet_subject", "0x98010300", "CERT_FIND_SUBJECT_STR_W_Battle_net_Update_Agent", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cert_event\",\"evt_id\":4,\"c_kind\":\"find_battlenet_subject\",\"hcert_hex\":\"0x98010300\",\"cert_synth\":\"CERT_FIND_SUBJECT_STR_W_Battle_net_Update_Agent\",\"dwFindType\":\"CERT_FIND_SUBJECT_STR_W\",\"status\":\"PARTIAL\"")
    record_cert_event(5, "close_release_store", "0x98010000", "release_no_certstore", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cert_event\",\"evt_id\":5,\"c_kind\":\"close_release_store\",\"hcert_hex\":\"0x98010000\",\"cert_synth\":\"release_no_certstore\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")

    // ─── 3. cms_event × 4 (open_decode/update/get_param/close) ───
    record_cms_event(1, "open_decode_signed", "0x98030000", "CMSG_SIGNED_0x02", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cms_event\",\"evt_id\":1,\"c_kind\":\"open_decode_signed\",\"hcryptmsg_hex\":\"0x98030000\",\"cms_synth\":\"CMSG_SIGNED_0x02\",\"dwMsgEncodingType\":\"X509_ASN_PKCS_7\",\"dwMsgType\":\"CMSG_SIGNED\",\"status\":\"PARTIAL\"")
    record_cms_event(2, "update_envelope_4096", "0x98030000", "PKCS7_SignedData_envelope_4096B", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cms_event\",\"evt_id\":2,\"c_kind\":\"update_envelope_4096\",\"hcryptmsg_hex\":\"0x98030000\",\"cms_synth\":\"PKCS7_SignedData_envelope_4096B\",\"cbData\":4096,\"fFinal\":true,\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_cms_event(3, "get_param_content", "0x98030000", "CMSG_CONTENT_PARAM_signed_content_2048B", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cms_event\",\"evt_id\":3,\"c_kind\":\"get_param_content\",\"hcryptmsg_hex\":\"0x98030000\",\"cms_synth\":\"CMSG_CONTENT_PARAM_signed_content_2048B\",\"dwParamType\":\"CMSG_CONTENT_PARAM\",\"pcbData\":2048,\"status\":\"PARTIAL\"")
    record_cms_event(4, "close_release_msg", "0x98030000", "release_no_cryptmsg", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"cms_event\",\"evt_id\":4,\"c_kind\":\"close_release_msg\",\"hcryptmsg_hex\":\"0x98030000\",\"cms_synth\":\"release_no_cryptmsg\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")

    // ─── 4. pkcs7_event × 3 (decode_object/decode_ex/hash_data) ───
    record_pkcs7_event(1, "decode_pkcs7_signed_data", "OID_1_2_840_113549_1_7_2", "PKCS7_SignedData_decoded_struct_2048B", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"pkcs7_event\",\"evt_id\":1,\"p_kind\":\"decode_pkcs7_signed_data\",\"oid_synth\":\"OID_1_2_840_113549_1_7_2\",\"blob_synth\":\"PKCS7_SignedData_decoded_struct_2048B\",\"struct_bytes\":2048,\"status\":\"PARTIAL\"")
    record_pkcs7_event(2, "decode_ex_x509_name", "OID_1_2_840_113549_1_9_22_2", "X509_NAME_CN_Battle_net_Update_Agent_CA_256B", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"pkcs7_event\",\"evt_id\":2,\"p_kind\":\"decode_ex_x509_name\",\"oid_synth\":\"OID_1_2_840_113549_1_9_22_2\",\"blob_synth\":\"X509_NAME_CN_Battle_net_Update_Agent_CA_256B\",\"struct_bytes\":256,\"alloc_flag\":\"CRYPT_DECODE_ALLOC_FLAG_0x00008000\",\"status\":\"PARTIAL\"")
    record_pkcs7_event(3, "hash_data_sha256_2048", "ALGID_CALG_SHA_256_0x0000800C", "hash_value_32B_3a4f9b_e2c8", "PARTIAL")
    r0_emit("pe_crypt32_core_record", "\"kind\":\"pkcs7_event\",\"evt_id\":3,\"p_kind\":\"hash_data_sha256_2048\",\"oid_synth\":\"ALGID_CALG_SHA_256_0x0000800C\",\"blob_synth\":\"hash_value_32B_3a4f9b_e2c8\",\"hash_size\":32,\"input_size\":2048,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 12 {
        panic("pe_crypt32_core FAIL [syscall_invoke_count] expected=12 got=" + to_string(si))
    }
    let ce = cert_event_count()
    if ce != 5 {
        panic("pe_crypt32_core FAIL [cert_event_count] expected=5 got=" + to_string(ce))
    }
    let cme = cms_event_count()
    if cme != 4 {
        panic("pe_crypt32_core FAIL [cms_event_count] expected=4 got=" + to_string(cme))
    }
    let pe = pkcs7_event_count()
    if pe != 3 {
        panic("pe_crypt32_core FAIL [pkcs7_event_count] expected=3 got=" + to_string(pe))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "CertCreateCertificateContext" { panic("pe_crypt32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "CertOpenStore" { panic("pe_crypt32_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(5) != "CryptMsgOpenToDecode" { panic("pe_crypt32_core FAIL [fn_kind_name(5)]") }
    if fn_kind_name(8) != "CryptMsgClose" { panic("pe_crypt32_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(11) != "CryptHashData" { panic("pe_crypt32_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_crypt32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "cert" { panic("pe_crypt32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(5) != "cms" { panic("pe_crypt32_core FAIL [fn_group_name(5)]") }
    if fn_group_name(9) != "pkcs7" { panic("pe_crypt32_core FAIL [fn_group_name(9)]") }
    if fn_group_name(99) != "unknown" { panic("pe_crypt32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pcz_stats()
    if len(s) != 4 { panic("pe_crypt32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 12 { panic("pe_crypt32_core FAIL [stats syscall_invoke_count] expected=12 got=" + to_string(s[0])) }
    if s[1] != 5 { panic("pe_crypt32_core FAIL [stats cert_event_count] expected=5 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_crypt32_core FAIL [stats cms_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_crypt32_core FAIL [stats pkcs7_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_crypt32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"cert_event_count\":" + to_string(s[1])
        + ",\"cms_event_count\":" + to_string(s[2])
        + ",\"pkcs7_event_count\":" + to_string(s[3]))

    r0_emit("pe_crypt32_core_summary",
        "\"target\":\"CRYPT32.dll\",\"fn_total\":12,\"fn_emit_partial\":12,\"groups\":[\"cert\",\"cms\",\"pkcs7\"],\"cert_context_synth_bytes\":28,\"crypt_data_blob_synth_bytes\":16,\"chain_policy_para_synth_bytes\":12,\"chain_policy_status_synth_bytes\":12,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_crypt32_core_kpi",
        "\"cert_emits\":5,\"cms_emits\":4,\"pkcs7_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"battlenet_code_sign_baseline\":true,\"d2r_d4_tls_chain_baseline\":true,\"security_framework_seccertificate_sectrust_binding\":false,\"commoncrypto_openssl_boringssl_mbedtls_binding\":false")

    // ─── cycle 43 → 44 CRYPT32 coverage progression evidence emit ───
    r0_emit("pe_crypt32_core_coverage_progression",
        "\"surface\":\"CRYPT32_full_435_fn\",\"cycle_43_count\":218,\"cycle_44_count\":230,\"delta\":12,\"cycle_43_percent\":50.11,\"cycle_44_percent\":52.87,\"cycle_44_module\":\"pe_crypt32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_az1_cycle_increment\":12,\"track_az_bundled_part_1_of_4\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_crypt32_core_round_trip_matrix",
        "\"surface\":\"CRYPT32_core_12_fn\",\"fn_partial\":12,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real CertVerifyCertificateChainPolicy + CryptMsgUpdate + CryptDecodeObject = Security.framework SecCertificate/SecTrust + CommonCrypto + ASN.1 PKCS7 parser bridge pending separate cycle (long-horizon)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    // ─── Track AZ1 expansion emit (cycle 44, CRYPT32 +12 fn) ───
    r0_emit("pe_crypt32_core_az1_expansion",
        "\"track\":\"AZ1\",\"cycle\":44,\"surface\":\"CRYPT32_new\",\"new_fn\":12,\"groups\":[\"cert\",\"cms\",\"pkcs7\"],\"cert_count\":5,\"cms_count\":4,\"pkcs7_count\":3,\"emit_format\":\"__CRYPT32__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_az_bundled_part_1_of_4\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_crypt32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pcz()
    let s2 = pcz_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_crypt32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_crypt32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", cert_event=" + to_string(s[1])
        + ", cms_event=" + to_string(s[2]) + ", pkcs7_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcz_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("cert_event_count\t" + to_string(s[1]))
            println("cms_event_count\t" + to_string(s[2]))
            println("pkcs7_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_crypt32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_crypt32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcz()
            println("cleaned: " + pcz_dir())
            return
        }
        if sub == "dir" {
            println(pcz_dir())
            return
        }
    }
    println("usage: hexa run pe_crypt32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
