// lib/loader/pe_lineage_classic_r28_track.hexa — Lineage Classic r28 (NCSOFT 2026-02-07 신작) 전용 entry/loader 추적.
//
// Lineage Classic r28 (NCSOFT 2026-02-07 신작) launch chain (own2 자체 추적):
//   process_attach           — lineage_classic.exe (x86_64 PE32+) entry
//   opengl_context_init      — OpenGL 4.3+ (Win10/11 64bit only)
//                              → Apple Metal 변환 path (R5 D3DMetal 우회 — OpenGL 직접)
//   hwid_check               — 필수 기기 등록 (HWID 기반, 라이선스 인증)
//   gameguard_init           — GameGuard kernel driver (Apple 차단)
//                              → live KR/대만 서버 필수 — closure path B 차단
//   patcher_diff             — patch script
//   login_screen / server_select / character_select / world_load / first_frame
//   결론: PE x64 + OpenGL 4.3 = closure path B 친화 (D2R 동급), 단 GameGuard 차단 → skeleton-only
// own1: NCSOFT 공개 정보 + binary observation. Wine NCWest wrapper 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 Lineage Classic r28-specific phase tracker — 실 lineage_classic.exe 실행 X.
// own 2 mandate: r0_emit ≥ 11 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//    1 = process_attach        (lineage_classic.exe x86_64 PE32+ entry)
//    2 = opengl_context_init   (OpenGL 4.3+ context create)
//    3 = hwid_check            (HWID 라이선스 인증)
//    4 = gameguard_init        (GameGuard kernel driver init)
//    5 = patcher_diff          (patch script diff)
//    6 = login_screen          (login UI)
//    7 = server_select         (server list)
//    8 = character_select      (character roster)
//    9 = world_load            (world / map mmap)
//   10 = first_frame           (OpenGL swap first call)
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t dll_loaded<int> \t gameguard_active<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn plcr28_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_lineage_classic_r28_track"
}

fn plcr28_steps_path() -> str {
    return plcr28_dir() + "/steps.tsv"
}

fn plcr28_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + plcr28_dir() + "'")
}

fn cleanup_plcr28() -> void {
    plcr28_ensure_dir()
    let _ = exec("rm -f '" + plcr28_steps_path() + "'")
}

// ─── 공통 file IO ───
fn plcr28_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn plcr28_append_row(path: str, row: str) -> void {
    plcr28_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_step: Lineage Classic r28 launch step 1 건 기록 ───
fn record_step(step_id: int, phase_kind: int, dll_loaded: int, gameguard_active: int) -> void {
    if step_id <= 0 {
        panic("pe_lineage_classic_r28_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_lineage_classic_r28_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 10 {
        panic("pe_lineage_classic_r28_track FAIL [record_step] expected=phase_kind<=10 got=" + to_string(phase_kind))
    }
    if dll_loaded < 0 {
        panic("pe_lineage_classic_r28_track FAIL [record_step] expected=dll_loaded>=0 got=" + to_string(dll_loaded))
    }
    if dll_loaded > 1 {
        panic("pe_lineage_classic_r28_track FAIL [record_step] expected=dll_loaded<=1 got=" + to_string(dll_loaded))
    }
    if gameguard_active < 0 {
        panic("pe_lineage_classic_r28_track FAIL [record_step] expected=gameguard_active>=0 got=" + to_string(gameguard_active))
    }
    if gameguard_active > 1 {
        panic("pe_lineage_classic_r28_track FAIL [record_step] expected=gameguard_active<=1 got=" + to_string(gameguard_active))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(dll_loaded) + "\t" + to_string(gameguard_active) + "\n"
    plcr28_append_row(plcr28_steps_path(), row)
}

// ─── step_count: total step 수 ───
fn step_count() -> int {
    let t = plcr28_read_table(plcr28_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 step 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = plcr28_read_table(plcr28_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── loaded_count: dll_loaded=1 인 step 수 ───
fn loaded_count() -> int {
    let t = plcr28_read_table(plcr28_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── gameguard_active_count: gameguard_active=1 인 step 수 ───
fn gameguard_active_count() -> int {
    let t = plcr28_read_table(plcr28_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── gl43_init_count: opengl_context_init (phase_kind=2) step 수 ───
fn gl43_init_count() -> int {
    return count_by_phase_kind(2)
}

// ─── step_dll_loaded: 특정 step_id 의 dll_loaded (없으면 0) ───
fn step_dll_loaded(step_id: int) -> int {
    let t = plcr28_read_table(plcr28_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── plcr28_stats: [step_count, loaded_count, gameguard_active_count, gl43_init_count, count_by_phase_kind(10)] ───
fn plcr28_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(loaded_count())
    out.push(gameguard_active_count())
    out.push(gl43_init_count())
    out.push(count_by_phase_kind(10))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "plcr28-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_plcr28()

    // 2. record 10 steps — Lineage Classic r28 launch chain 전체, phase_kind 1..10 각 1건
    //   id 280001: phase  1 process_attach        dll=0 gg=0  (lineage_classic.exe entry)
    //   id 280002: phase  2 opengl_context_init   dll=1 gg=0  (OpenGL 4.3+ context, GL ICD dll)
    //   id 280003: phase  3 hwid_check            dll=0 gg=0  (HWID 라이선스 인증)
    //   id 280004: phase  4 gameguard_init        dll=1 gg=1  (GameGuard kernel driver — Apple 차단)
    //   id 280005: phase  5 patcher_diff          dll=0 gg=1  (patch script diff, GG active)
    //   id 280006: phase  6 login_screen          dll=1 gg=1  (login UI, GG active)
    //   id 280007: phase  7 server_select         dll=0 gg=1  (server list, GG active)
    //   id 280008: phase  8 character_select      dll=0 gg=1  (character roster, GG active)
    //   id 280009: phase  9 world_load            dll=1 gg=1  (world/map mmap, GG active)
    //   id 280010: phase 10 first_frame           dll=0 gg=1  (OpenGL swap first, GG active)
    //   sums: steps=10, loaded=4, gameguard_active=7, gl43_init=1, count_kind(10)=1
    record_step(280001, 1, 0, 0)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280001,\"phase_kind\":1,\"dll_loaded\":0,\"gameguard_active\":0,\"target\":\"process_attach\"")

    record_step(280002, 2, 1, 0)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280002,\"phase_kind\":2,\"dll_loaded\":1,\"gameguard_active\":0,\"target\":\"opengl_context_init\"")

    record_step(280003, 3, 0, 0)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280003,\"phase_kind\":3,\"dll_loaded\":0,\"gameguard_active\":0,\"target\":\"hwid_check\"")

    record_step(280004, 4, 1, 1)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280004,\"phase_kind\":4,\"dll_loaded\":1,\"gameguard_active\":1,\"target\":\"gameguard_init\"")

    record_step(280005, 5, 0, 1)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280005,\"phase_kind\":5,\"dll_loaded\":0,\"gameguard_active\":1,\"target\":\"patcher_diff\"")

    record_step(280006, 6, 1, 1)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280006,\"phase_kind\":6,\"dll_loaded\":1,\"gameguard_active\":1,\"target\":\"login_screen\"")

    record_step(280007, 7, 0, 1)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280007,\"phase_kind\":7,\"dll_loaded\":0,\"gameguard_active\":1,\"target\":\"server_select\"")

    record_step(280008, 8, 0, 1)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280008,\"phase_kind\":8,\"dll_loaded\":0,\"gameguard_active\":1,\"target\":\"character_select\"")

    record_step(280009, 9, 1, 1)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280009,\"phase_kind\":9,\"dll_loaded\":1,\"gameguard_active\":1,\"target\":\"world_load\"")

    record_step(280010, 10, 0, 1)
    r0_emit("pe_lineage_classic_r28_track_record",
        "\"step_id\":280010,\"phase_kind\":10,\"dll_loaded\":0,\"gameguard_active\":1,\"target\":\"first_frame\"")

    // 3. step_count = 10
    let c = step_count()
    if c != 10 {
        panic("pe_lineage_classic_r28_track FAIL [step_count] expected=10 got=" + to_string(c))
    }

    // 4. count_by_phase_kind sanity — 1..10 각 1건, 99 = 0
    let p1 = count_by_phase_kind(1)
    if p1 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p6 = count_by_phase_kind(6)
    if p6 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(p6))
    }
    let p7 = count_by_phase_kind(7)
    if p7 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(7)] expected=1 got=" + to_string(p7))
    }
    let p8 = count_by_phase_kind(8)
    if p8 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(8)] expected=1 got=" + to_string(p8))
    }
    let p9 = count_by_phase_kind(9)
    if p9 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(9)] expected=1 got=" + to_string(p9))
    }
    let p10 = count_by_phase_kind(10)
    if p10 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(10)] expected=1 got=" + to_string(p10))
    }
    let p99 = count_by_phase_kind(99)
    if p99 != 0 {
        panic("pe_lineage_classic_r28_track FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p99))
    }

    // 5. loaded_count = 4 (280002, 280004, 280006, 280009)
    let lc = loaded_count()
    if lc != 4 {
        panic("pe_lineage_classic_r28_track FAIL [loaded_count] expected=4 got=" + to_string(lc))
    }

    // 6. gameguard_active_count = 7 (280004..280010)
    let gc = gameguard_active_count()
    if gc != 7 {
        panic("pe_lineage_classic_r28_track FAIL [gameguard_active_count] expected=7 got=" + to_string(gc))
    }

    // 7. gl43_init_count = 1 (phase_kind=2, 280002)
    let gl = gl43_init_count()
    if gl != 1 {
        panic("pe_lineage_classic_r28_track FAIL [gl43_init_count] expected=1 got=" + to_string(gl))
    }

    // 8. step_dll_loaded sanity
    let d2 = step_dll_loaded(280002)
    if d2 != 1 {
        panic("pe_lineage_classic_r28_track FAIL [step_dll_loaded(280002)] expected=1 got=" + to_string(d2))
    }
    let d3 = step_dll_loaded(280003)
    if d3 != 0 {
        panic("pe_lineage_classic_r28_track FAIL [step_dll_loaded(280003)] expected=0 got=" + to_string(d3))
    }
    let d_miss = step_dll_loaded(9999)
    if d_miss != 0 {
        panic("pe_lineage_classic_r28_track FAIL [step_dll_loaded(9999)] expected=0 got=" + to_string(d_miss))
    }

    // 9. plcr28_stats() = [10, 4, 7, 1, 1]
    let s = plcr28_stats()
    if len(s) != 5 {
        panic("pe_lineage_classic_r28_track FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 10 {
        panic("pe_lineage_classic_r28_track FAIL [stats step_count] expected=10 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_lineage_classic_r28_track FAIL [stats loaded_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 7 {
        panic("pe_lineage_classic_r28_track FAIL [stats gameguard_active_count] expected=7 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_lineage_classic_r28_track FAIL [stats gl43_init_count] expected=1 got=" + to_string(s[3]))
    }
    if s[4] != 1 {
        panic("pe_lineage_classic_r28_track FAIL [stats count_phase(10)] expected=1 got=" + to_string(s[4]))
    }

    // 10. emit stats
    r0_emit("pe_lineage_classic_r28_track_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"loaded_count\":" + to_string(s[1])
        + ",\"gameguard_active_count\":" + to_string(s[2])
        + ",\"gl43_init_count\":" + to_string(s[3])
        + ",\"count_first_frame\":" + to_string(s[4]))

    // 11. emit count >= 11 (10 records + 1 stats = 11)
    let emit_n = r0_session_count(sid)
    if emit_n < 11 {
        panic("pe_lineage_classic_r28_track FAIL [r0 emit count] expected=>=11 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_plcr28()
    let s2 = plcr28_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_lineage_classic_r28_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    // ─── ADDITIVE Track-B (.roadmap.lineage_classic_r28 retired_intentional adoption) ───
    // GameGuard kernel-mode anti-cheat detection emit — research-direction only,
    // NEVER attempt PASS. status_enum_adopted: retired_intentional.
    // own1: no kernel-AC bypass, no driver fetch — static signature schema only.
    // own2: status_emit `__LC_R28_GG__ <DETECTED|FAIL|RETIRED_INTENTIONAL> <posture>`
    //
    // Posture row 1 — kernel-AC family detected.
    r0_emit("__LC_R28_GG__",
        "\"posture\":\"DETECTED\",\"family\":\"gameguard\",\"vendor\":\"inca_internet\","
        + "\"mode\":\"kernel\",\"action\":\"none\",\"bypass\":\"forbidden\"")

    // Posture row 2 — formal retired_intentional adoption (block-acknowledged = PASS-equivalent).
    r0_emit("__LC_R28_GG__",
        "\"posture\":\"RETIRED_INTENTIONAL\",\"family\":\"gameguard\","
        + "\"status_enum_adopted\":true,\"adopted_iso\":\"2026-05-03\","
        + "\"rationale\":\"kernel_ac_block_acknowledged_no_bypass_path\","
        + "\"mk1_narrative\":\"docs/LINEAGE_CLASSIC_R28_MANJEOM_REVIEW.md\"")

    println("  ✅ pe_lineage_classic_r28_track self_test PASS (steps=" + to_string(s[0])
        + ", loaded=" + to_string(s[1]) + ", gameguard=" + to_string(s[2])
        + ", gl43_init=" + to_string(s[3]) + ", first_frame=" + to_string(s[4])
        + ", trackb_gg_posture=2 [DETECTED+RETIRED_INTENTIONAL], emits=" + to_string(emit_n + 2)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = plcr28_stats()
            println("step_count\t" + to_string(s[0]))
            println("loaded_count\t" + to_string(s[1]))
            println("gameguard_active_count\t" + to_string(s[2]))
            println("gl43_init_count\t" + to_string(s[3]))
            println("count_first_frame\t" + to_string(s[4]))
            return
        }
        if sub == "loaded" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_dll_loaded\t" + to_string(step_dll_loaded(sid)))
                return
            }
            println("usage: hexa run pe_lineage_classic_r28_track.hexa loaded <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_lineage_classic_r28_track.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_plcr28()
            println("cleaned: " + plcr28_dir())
            return
        }
        if sub == "dir" {
            println(plcr28_dir())
            return
        }
    }
    println("usage: hexa run pe_lineage_classic_r28_track.hexa { self-test | stats | loaded <step_id> | count <phase_kind> | cleanup | dir }")
}
