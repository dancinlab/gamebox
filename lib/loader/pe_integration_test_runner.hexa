// lib/loader/pe_integration_test_runner.hexa — cycle 83 multi-module integration self-test runner
//
// Integration test runner — multi-module end-to-end path 추적:
//   scenario_kind:
//     1=fake_d2r_launch       — pe_d2r_specific_track (cycle 82) 의 7-phase 시뮬
//     2=fake_d4_launch        — pe_d4_specific_track (cycle 82) 의 8-phase 시뮬
//     3=fake_battle_net       — pe_battle_net_agent_ipc_track 의 RPC 시뮬
//     4=fake_helper_handshake — pe_helper_subprocess_spawn 의 6-phase 시뮬
//     5=full_chain_64bit      — section_map → reloc → tls_init → iat_resolve → entry → first frame
//     6=full_chain_32bit      — i386 path (win32_abi_i386 fix 적용 필요)
//   phases_passed = 각 시나리오의 도달 단계 수
//   skeleton: 실 실행 X — TSV 추적만, 미래 cycle 의 실 통합 test 자리 잡기
// own1: 자체 시뮬 — third-party test framework 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 integration path tracker — 실 PE map / reloc / IAT 호출 X (미래 cycle).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// scenario_kind code:
//   1 = fake_d2r_launch
//   2 = fake_d4_launch
//   3 = fake_battle_net
//   4 = fake_helper_handshake
//   5 = full_chain_64bit
//   6 = full_chain_32bit
//
// persist schema (TSV — tests.tsv):
//   test_id<int> \t scenario_kind<int> \t phases_passed<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pitr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_integration_test_runner"
}

fn pitr_tests_path() -> str {
    return pitr_dir() + "/tests.tsv"
}

fn pitr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pitr_dir() + "'")
}

fn cleanup_pitr() -> void {
    pitr_ensure_dir()
    let _ = exec("rm -f '" + pitr_tests_path() + "'")
}

// ─── 공통 file IO ───
fn pitr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pitr_append_row(path: str, row: str) -> void {
    pitr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_test: integration test 1 건 기록 ───
fn record_test(test_id: int, scenario_kind: int, phases_passed: int, elevated: int) -> void {
    if test_id <= 0 {
        panic("pe_integration_test_runner FAIL [record_test] expected=test_id>0 got=" + to_string(test_id))
    }
    if scenario_kind < 1 {
        panic("pe_integration_test_runner FAIL [record_test] expected=scenario_kind>=1 got=" + to_string(scenario_kind))
    }
    if scenario_kind > 6 {
        panic("pe_integration_test_runner FAIL [record_test] expected=scenario_kind<=6 got=" + to_string(scenario_kind))
    }
    if phases_passed < 0 {
        panic("pe_integration_test_runner FAIL [record_test] expected=phases_passed>=0 got=" + to_string(phases_passed))
    }
    if phases_passed > 10 {
        panic("pe_integration_test_runner FAIL [record_test] expected=phases_passed<=10 got=" + to_string(phases_passed))
    }
    if elevated < 0 {
        panic("pe_integration_test_runner FAIL [record_test] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_integration_test_runner FAIL [record_test] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(test_id) + "\t" + to_string(scenario_kind)
        + "\t" + to_string(phases_passed) + "\t" + to_string(elevated) + "\n"
    pitr_append_row(pitr_tests_path(), row)
}

// ─── test_count: total test 수 ───
fn test_count() -> int {
    let t = pitr_read_table(pitr_tests_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_phases_passed: 모든 test phases_passed 합 ───
fn total_phases_passed() -> int {
    let t = pitr_read_table(pitr_tests_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_scenario_kind: 특정 scenario_kind 의 test 수 ───
fn count_by_scenario_kind(scenario_kind: int) -> int {
    let t = pitr_read_table(pitr_tests_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == scenario_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── elevated_count: elevated=1 인 test 수 ───
fn elevated_count() -> int {
    let t = pitr_read_table(pitr_tests_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── full_pass_count: phases_passed >= 10 인 test 수 ───
fn full_pass_count() -> int {
    let t = pitr_read_table(pitr_tests_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) >= 10 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── test_phases_passed: 특정 test_id 의 phases_passed (없으면 0) ───
fn test_phases_passed(test_id: int) -> int {
    let t = pitr_read_table(pitr_tests_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == test_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pitr_stats: [test_count, total_phases_passed, elevated_count, full_pass_count] ───
fn pitr_stats() -> array {
    let mut out = []
    out.push(test_count())
    out.push(total_phases_passed())
    out.push(elevated_count())
    out.push(full_pass_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pitr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pitr()

    // 2. record 6 integration tests across all 6 scenario_kinds
    //    phases_passed: 1, 5, 10, 9, 10, 7  → total=42, full_pass=2
    record_test(830001, 1, 1, 0)
    r0_emit("pe_integration_test_runner_record",
        "\"test_id\":830001,\"scenario_kind\":1,\"phases_passed\":1,\"elevated\":0,\"target\":\"fake_d2r_launch\"")

    record_test(830002, 2, 5, 0)
    r0_emit("pe_integration_test_runner_record",
        "\"test_id\":830002,\"scenario_kind\":2,\"phases_passed\":5,\"elevated\":0,\"target\":\"fake_d4_launch\"")

    record_test(830003, 3, 10, 0)
    r0_emit("pe_integration_test_runner_record",
        "\"test_id\":830003,\"scenario_kind\":3,\"phases_passed\":10,\"elevated\":0,\"target\":\"fake_battle_net\"")

    record_test(830004, 4, 9, 1)
    r0_emit("pe_integration_test_runner_record",
        "\"test_id\":830004,\"scenario_kind\":4,\"phases_passed\":9,\"elevated\":1,\"target\":\"fake_helper_handshake\"")

    record_test(830005, 5, 10, 1)
    r0_emit("pe_integration_test_runner_record",
        "\"test_id\":830005,\"scenario_kind\":5,\"phases_passed\":10,\"elevated\":1,\"target\":\"full_chain_64bit\"")

    record_test(830006, 6, 7, 0)
    r0_emit("pe_integration_test_runner_record",
        "\"test_id\":830006,\"scenario_kind\":6,\"phases_passed\":7,\"elevated\":0,\"target\":\"full_chain_32bit\"")

    // 3. test_count = 6
    let c = test_count()
    if c != 6 {
        panic("pe_integration_test_runner FAIL [test_count] expected=6 got=" + to_string(c))
    }

    // 4. total_phases_passed = 1+5+10+9+10+7 = 42
    let tp = total_phases_passed()
    if tp != 42 {
        panic("pe_integration_test_runner FAIL [total_phases_passed] expected=42 got=" + to_string(tp))
    }

    // 5. count_by_scenario_kind sanity (각 kind 1 건씩)
    let k1 = count_by_scenario_kind(1)
    if k1 != 1 {
        panic("pe_integration_test_runner FAIL [count_by_scenario_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_scenario_kind(2)
    if k2 != 1 {
        panic("pe_integration_test_runner FAIL [count_by_scenario_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_scenario_kind(3)
    if k3 != 1 {
        panic("pe_integration_test_runner FAIL [count_by_scenario_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_scenario_kind(4)
    if k4 != 1 {
        panic("pe_integration_test_runner FAIL [count_by_scenario_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_scenario_kind(5)
    if k5 != 1 {
        panic("pe_integration_test_runner FAIL [count_by_scenario_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k6 = count_by_scenario_kind(6)
    if k6 != 1 {
        panic("pe_integration_test_runner FAIL [count_by_scenario_kind(6)] expected=1 got=" + to_string(k6))
    }
    let k99 = count_by_scenario_kind(99)
    if k99 != 0 {
        panic("pe_integration_test_runner FAIL [count_by_scenario_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. elevated_count = 2 (830004, 830005)
    let ec = elevated_count()
    if ec != 2 {
        panic("pe_integration_test_runner FAIL [elevated_count] expected=2 got=" + to_string(ec))
    }

    // 7. full_pass_count = 2 (phases_passed >= 10 → 830003, 830005)
    let fp = full_pass_count()
    if fp != 2 {
        panic("pe_integration_test_runner FAIL [full_pass_count] expected=2 got=" + to_string(fp))
    }

    // 8. test_phases_passed sanity
    let p3 = test_phases_passed(830003)
    if p3 != 10 {
        panic("pe_integration_test_runner FAIL [test_phases_passed(830003)] expected=10 got=" + to_string(p3))
    }
    let p4 = test_phases_passed(830004)
    if p4 != 9 {
        panic("pe_integration_test_runner FAIL [test_phases_passed(830004)] expected=9 got=" + to_string(p4))
    }
    let p_miss = test_phases_passed(9999999)
    if p_miss != 0 {
        panic("pe_integration_test_runner FAIL [test_phases_passed(9999999)] expected=0 got=" + to_string(p_miss))
    }

    // 9. pitr_stats() = [6, 42, 2, 2]
    let s = pitr_stats()
    if len(s) != 4 {
        panic("pe_integration_test_runner FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_integration_test_runner FAIL [stats test_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 42 {
        panic("pe_integration_test_runner FAIL [stats total_phases_passed] expected=42 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_integration_test_runner FAIL [stats elevated_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_integration_test_runner FAIL [stats full_pass_count] expected=2 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_integration_test_runner_stats",
        "\"test_count\":" + to_string(s[0])
        + ",\"total_phases_passed\":" + to_string(s[1])
        + ",\"elevated_count\":" + to_string(s[2])
        + ",\"full_pass_count\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_integration_test_runner FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pitr()
    let s2 = pitr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_integration_test_runner FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_integration_test_runner self_test PASS (tests=" + to_string(s[0])
        + ", phases=" + to_string(s[1]) + ", elevated=" + to_string(s[2])
        + ", full_pass=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pitr_stats()
            println("test_count\t" + to_string(s[0]))
            println("total_phases_passed\t" + to_string(s[1]))
            println("elevated_count\t" + to_string(s[2]))
            println("full_pass_count\t" + to_string(s[3]))
            return
        }
        if sub == "phases" {
            if len(a) >= 4 {
                let tid = to_int(a[3])
                println("test_phases_passed\t" + to_string(test_phases_passed(tid)))
                return
            }
            println("usage: hexa run pe_integration_test_runner.hexa phases <test_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_scenario_kind\t" + to_string(count_by_scenario_kind(kind)))
                return
            }
            println("usage: hexa run pe_integration_test_runner.hexa count <scenario_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pitr()
            println("cleaned: " + pitr_dir())
            return
        }
        if sub == "dir" {
            println(pitr_dir())
            return
        }
    }
    println("usage: hexa run pe_integration_test_runner.hexa { self-test | stats | phases <test_id> | count <scenario_kind> | cleanup | dir }")
}
