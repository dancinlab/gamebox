// lib/loader/pe_dwrite_text_layout.hexa — cycle 77 DirectWrite IDWriteTextLayout
// glyph layout telemetry → CoreText bridge skeleton
//
// Windows DirectWrite IDWriteTextLayout 의 char→glyph shaping 결과를 hexa
// telemetry 로 기록 → host native helper 단에서 CoreText (CTLine /
// CTFramesetter) 로 재현. 본 module 은 layout op tracker — 실 DWrite COM
// 호출 X (stage 2 native bridge 가 담당).
//
// own 1 enforcement: Wine / CrossOver / GPTK / Whisky / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// script_kind code:
//   1 = latin
//   2 = cjk
//   3 = arabic
//   4 = devanagari
//   5 = mixed
//
// persist schema (TSV — layouts.tsv):
//   layout_id<int> \t script_kind<int> \t char_count<int> \t glyph_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdtl_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dwrite_text_layout"
}

fn pdtl_layouts_path() -> str {
    return pdtl_dir() + "/layouts.tsv"
}

fn pdtl_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdtl_dir() + "'")
}

fn cleanup_pdtl() -> void {
    pdtl_ensure_dir()
    let _ = exec("rm -f '" + pdtl_layouts_path() + "'")
}

// ─── 공통 file IO ───
fn pdtl_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdtl_append_row(path: str, row: str) -> void {
    pdtl_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_layout: layout 1 건 기록 ───
fn record_layout(layout_id: int, script_kind: int, char_count: int, glyph_count: int) -> void {
    if layout_id <= 0 {
        panic("pe_dwrite_text_layout FAIL [record_layout] expected=layout_id>0 got=" + to_string(layout_id))
    }
    if script_kind < 1 {
        panic("pe_dwrite_text_layout FAIL [record_layout] expected=script_kind>=1 got=" + to_string(script_kind))
    }
    if script_kind > 5 {
        panic("pe_dwrite_text_layout FAIL [record_layout] expected=script_kind<=5 got=" + to_string(script_kind))
    }
    if char_count < 0 {
        panic("pe_dwrite_text_layout FAIL [record_layout] expected=char_count>=0 got=" + to_string(char_count))
    }
    if glyph_count < 0 {
        panic("pe_dwrite_text_layout FAIL [record_layout] expected=glyph_count>=0 got=" + to_string(glyph_count))
    }
    let row = to_string(layout_id) + "\t" + to_string(script_kind)
        + "\t" + to_string(char_count) + "\t" + to_string(glyph_count) + "\n"
    pdtl_append_row(pdtl_layouts_path(), row)
}

// ─── layout_count: total layout 수 ───
fn layout_count() -> int {
    let t = pdtl_read_table(pdtl_layouts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_chars: 모든 layout char_count 합 ───
fn total_chars() -> int {
    let t = pdtl_read_table(pdtl_layouts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_glyphs: 모든 layout glyph_count 합 ───
fn total_glyphs() -> int {
    let t = pdtl_read_table(pdtl_layouts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_script: 특정 script_kind 의 layout 수 ───
fn count_by_script(script_kind: int) -> int {
    let t = pdtl_read_table(pdtl_layouts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == script_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── layout_glyph_count: 특정 layout_id 의 glyph_count (없으면 0) ───
fn layout_glyph_count(layout_id: int) -> int {
    let t = pdtl_read_table(pdtl_layouts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == layout_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdtl_stats: [layout_count, total_chars, total_glyphs, count_by_script(2)] ───
fn pdtl_stats() -> array {
    let mut out = []
    out.push(layout_count())
    out.push(total_chars())
    out.push(total_glyphs())
    out.push(count_by_script(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdtl-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdtl()

    // 2. record 5 layouts across ≥3 scripts (latin, cjk, arabic, mixed, cjk)
    record_layout(770001, 1, 12, 12)
    r0_emit("pe_dwrite_text_layout_record",
        "\"layout_id\":770001,\"script_kind\":1,\"char_count\":12,\"glyph_count\":12,\"target\":\"latin\"")

    record_layout(770002, 2, 8, 8)
    r0_emit("pe_dwrite_text_layout_record",
        "\"layout_id\":770002,\"script_kind\":2,\"char_count\":8,\"glyph_count\":8,\"target\":\"cjk\"")

    record_layout(770003, 3, 10, 14)
    r0_emit("pe_dwrite_text_layout_record",
        "\"layout_id\":770003,\"script_kind\":3,\"char_count\":10,\"glyph_count\":14,\"target\":\"arabic\"")

    record_layout(770004, 5, 20, 24)
    r0_emit("pe_dwrite_text_layout_record",
        "\"layout_id\":770004,\"script_kind\":5,\"char_count\":20,\"glyph_count\":24,\"target\":\"mixed\"")

    record_layout(770005, 2, 6, 6)
    r0_emit("pe_dwrite_text_layout_record",
        "\"layout_id\":770005,\"script_kind\":2,\"char_count\":6,\"glyph_count\":6,\"target\":\"cjk\"")

    // 3. layout_count = 5
    let c = layout_count()
    if c != 5 {
        panic("pe_dwrite_text_layout FAIL [layout_count] expected=5 got=" + to_string(c))
    }

    // 4. total_chars = 56
    let tc = total_chars()
    if tc != 56 {
        panic("pe_dwrite_text_layout FAIL [total_chars] expected=56 got=" + to_string(tc))
    }

    // 5. total_glyphs = 64
    let tg = total_glyphs()
    if tg != 64 {
        panic("pe_dwrite_text_layout FAIL [total_glyphs] expected=64 got=" + to_string(tg))
    }

    // 6. count_by_script sanity
    let s1 = count_by_script(1)
    if s1 != 1 {
        panic("pe_dwrite_text_layout FAIL [count_by_script(1)] expected=1 got=" + to_string(s1))
    }
    let s2 = count_by_script(2)
    if s2 != 2 {
        panic("pe_dwrite_text_layout FAIL [count_by_script(2)] expected=2 got=" + to_string(s2))
    }
    let s3 = count_by_script(3)
    if s3 != 1 {
        panic("pe_dwrite_text_layout FAIL [count_by_script(3)] expected=1 got=" + to_string(s3))
    }
    let s4 = count_by_script(4)
    if s4 != 0 {
        panic("pe_dwrite_text_layout FAIL [count_by_script(4)] expected=0 got=" + to_string(s4))
    }
    let s5 = count_by_script(5)
    if s5 != 1 {
        panic("pe_dwrite_text_layout FAIL [count_by_script(5)] expected=1 got=" + to_string(s5))
    }

    // 7. layout_glyph_count sanity
    let g3 = layout_glyph_count(770003)
    if g3 != 14 {
        panic("pe_dwrite_text_layout FAIL [layout_glyph_count(770003)] expected=14 got=" + to_string(g3))
    }
    let g4 = layout_glyph_count(770004)
    if g4 != 24 {
        panic("pe_dwrite_text_layout FAIL [layout_glyph_count(770004)] expected=24 got=" + to_string(g4))
    }
    let g_miss = layout_glyph_count(9999)
    if g_miss != 0 {
        panic("pe_dwrite_text_layout FAIL [layout_glyph_count(9999)] expected=0 got=" + to_string(g_miss))
    }

    // 8. pdtl_stats() = [5, 56, 64, 2]
    let s = pdtl_stats()
    if len(s) != 4 {
        panic("pe_dwrite_text_layout FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_dwrite_text_layout FAIL [stats layout_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 56 {
        panic("pe_dwrite_text_layout FAIL [stats total_chars] expected=56 got=" + to_string(s[1]))
    }
    if s[2] != 64 {
        panic("pe_dwrite_text_layout FAIL [stats total_glyphs] expected=64 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_dwrite_text_layout FAIL [stats count_script(cjk)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_dwrite_text_layout_stats",
        "\"layout_count\":" + to_string(s[0])
        + ",\"total_chars\":" + to_string(s[1])
        + ",\"total_glyphs\":" + to_string(s[2])
        + ",\"script_cjk\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_dwrite_text_layout FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdtl()
    let s2c = pdtl_stats()
    let i = 0
    while i < len(s2c) {
        if s2c[i] != 0 {
            panic("pe_dwrite_text_layout FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2c[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dwrite_text_layout self_test PASS (layouts=" + to_string(s[0])
        + ", chars=" + to_string(s[1]) + ", glyphs=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdtl_stats()
            println("layout_count\t" + to_string(s[0]))
            println("total_chars\t" + to_string(s[1]))
            println("total_glyphs\t" + to_string(s[2]))
            println("count_script_cjk\t" + to_string(s[3]))
            return
        }
        if sub == "glyphs" {
            if len(a) >= 4 {
                let lid = to_int(a[3])
                println("layout_glyph_count\t" + to_string(layout_glyph_count(lid)))
                return
            }
            println("usage: hexa run pe_dwrite_text_layout.hexa glyphs <layout_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let sk = to_int(a[3])
                println("count_by_script\t" + to_string(count_by_script(sk)))
                return
            }
            println("usage: hexa run pe_dwrite_text_layout.hexa count <script_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdtl()
            println("cleaned: " + pdtl_dir())
            return
        }
        if sub == "dir" {
            println(pdtl_dir())
            return
        }
    }
    println("usage: hexa run pe_dwrite_text_layout.hexa { self-test | stats | glyphs <layout_id> | count <script_kind> | cleanup | dir }")
}
