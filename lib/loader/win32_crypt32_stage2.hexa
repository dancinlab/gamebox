// lib/loader/win32_crypt32_stage2.hexa — Battle.net Setup CRYPT32 imports coverage
//
// CRYPT32 stage2: Battle.net 은 cert chain validation + Authenticode signature 검증에
// CertOpenStore, CertFindCertificateInStore, CryptVerifyMessageSignature 등 함수
// 사용. stage1 의 base 위에 Battle.net 특이 imports 추가.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 CRYPT32 API spec:
//     - CertOpenStore:       https://learn.microsoft.com/en-us/windows/win32/api/wincrypt/nf-wincrypt-certopenstore
//     - CertFindCertificateInStore:
//                            https://learn.microsoft.com/en-us/windows/win32/api/wincrypt/nf-wincrypt-certfindcertificateinstore
//     - CertGetCertificateChain:
//                            https://learn.microsoft.com/en-us/windows/win32/api/wincrypt/nf-wincrypt-certgetcertificatechain
//     - CryptMsgGetParam:    https://learn.microsoft.com/en-us/windows/win32/api/wincrypt/nf-wincrypt-cryptmsggetparam
//     - CryptQueryObject:    https://learn.microsoft.com/en-us/windows/win32/api/wincrypt/nf-wincrypt-cryptqueryobject
//
// own 2 mandate:
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout 만)
//   - panic("win32_crypt32_stage2 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Battle.net-Setup.exe CRYPT32 imports — DLL index 12, 18 funcs):
//   pe_imports.hexa names tool/bench/Battle.net-Setup.exe 12 결과:
//     CertOpenStore, CertCloseStore, CertFindCertificateInStore,
//     CertFreeCertificateContext, CryptStringToBinaryA,
//     CertAddCertificateContextToStore, CertGetNameStringA, CryptQueryObject,
//     CertCreateCertificateChainEngine, CertGetCertificateChain,
//     CertFreeCertificateChain, CryptMsgClose, CryptMsgGetParam,
//     CertGetNameStringW, CertEnumCertificatesInStore,
//     CertDuplicateCertificateContext, CertGetCertificateContextProperty,
//     CertFreeCertificateChainEngine
//
// stub 정책 (skeleton — cert verify 우회, wintrust 와 동일 정책):
//   BOOL retval                → return 1 (TRUE — success)
//   HANDLE/HCERTSTORE/PCCERT_* → return 1 (synthetic non-NULL handle)
//   DWORD retval (count/len)   → return 0 (empty result — caller 가 NULL buffer 처리)
//   LPCSTR/LPCWSTR retval      → return ""
//   void retval                → return 0 (no-op marker)

use "../perf/r0_common"

// ─── Cert Store (HANDLE-returning) ───
// CertOpenStore — HCERTSTORE 반환. synthetic non-NULL = 1.
fn cert_open_store(provider: str, encoding: int, hcrypt: int, flags: int, para: str) -> int {
    let _ = provider
    let _ = encoding
    let _ = hcrypt
    let _ = flags
    let _ = para
    return 1
}

// CertCloseStore — BOOL 반환.
fn cert_close_store(hstore: int, flags: int) -> int {
    let _ = hstore
    let _ = flags
    return 1
}

// CertEnumCertificatesInStore — PCCERT_CONTEXT 반환 (NULL = no more).
// stub: 단일 synthetic context 1 만 제공 후 caller 의 다음 호출은
// prev != 0 이면 0 반환 (enumeration 종료).
fn cert_enum_certificates_in_store(hstore: int, prev: int) -> int {
    let _ = hstore
    if prev != 0 { return 0 }
    return 1
}

// CertAddCertificateContextToStore — BOOL.
fn cert_add_certificate_context_to_store(hstore: int, ctx: int, disposition: int, stored: int) -> int {
    let _ = hstore
    let _ = ctx
    let _ = disposition
    let _ = stored
    return 1
}

// ─── Cert Find ───
// CertFindCertificateInStore — PCCERT_CONTEXT.
fn cert_find_certificate_in_store(hstore: int, encoding: int, find_flags: int, find_kind: int, find_para: str, prev: int) -> int {
    let _ = hstore
    let _ = encoding
    let _ = find_flags
    let _ = find_kind
    let _ = find_para
    if prev != 0 { return 0 }
    return 1
}

// CertDuplicateCertificateContext — PCCERT_CONTEXT (incremented refcount).
fn cert_duplicate_certificate_context(ctx: int) -> int {
    if ctx == 0 { return 0 }
    return ctx
}

// CertFreeCertificateContext — BOOL.
fn cert_free_certificate_context(ctx: int) -> int {
    let _ = ctx
    return 1
}

// ─── Cert Chain ───
// CertCreateCertificateChainEngine — BOOL (out param: HCERTCHAINENGINE*).
fn cert_create_certificate_chain_engine(config: str, engine_out: int) -> int {
    let _ = config
    let _ = engine_out
    return 1
}

// CertGetCertificateChain — BOOL (out: PCCERT_CHAIN_CONTEXT*).
fn cert_get_certificate_chain(engine: int, ctx: int, time_arg: str, additional: int, params: str, flags: int, reserved: int, chain_out: int) -> int {
    let _ = engine
    let _ = ctx
    let _ = time_arg
    let _ = additional
    let _ = params
    let _ = flags
    let _ = reserved
    let _ = chain_out
    return 1
}

// CertFreeCertificateChain — void (no-op marker).
fn cert_free_certificate_chain(chain: int) -> int {
    let _ = chain
    return 0
}

// CertFreeCertificateChainEngine — void.
fn cert_free_certificate_chain_engine(engine: int) -> int {
    let _ = engine
    return 0
}

// ─── Cert Info ───
// CertGetNameStringA — DWORD (필요한 char count 또는 written).
//   buffer == NULL → required size (skeleton: 0 = no name).
//   buffer != NULL → written count (skeleton: 0).
fn cert_get_name_string_a(ctx: int, name_kind: int, flags: int, type_para: str, buffer: int, size: int) -> int {
    let _ = ctx
    let _ = name_kind
    let _ = flags
    let _ = type_para
    let _ = buffer
    let _ = size
    return 0
}

// CertGetNameStringW — DWORD.
fn cert_get_name_string_w(ctx: int, name_kind: int, flags: int, type_para: str, buffer: int, size: int) -> int {
    let _ = ctx
    let _ = name_kind
    let _ = flags
    let _ = type_para
    let _ = buffer
    let _ = size
    return 0
}

// CertGetCertificateContextProperty — BOOL.
fn cert_get_certificate_context_property(ctx: int, prop_id: int, data: int, size: int) -> int {
    let _ = ctx
    let _ = prop_id
    let _ = data
    let _ = size
    return 1
}

// ─── Crypto Msg ───
// CryptQueryObject — BOOL (out: encoding, content_type, format, store, msg, ctx).
fn crypt_query_object(obj_kind: int, obj: str, expected_content: int, expected_format: int, flags: int, encoding_out: int, content_type_out: int, format_out: int, store_out: int, msg_out: int, ctx_out: int) -> int {
    let _ = obj_kind
    let _ = obj
    let _ = expected_content
    let _ = expected_format
    let _ = flags
    let _ = encoding_out
    let _ = content_type_out
    let _ = format_out
    let _ = store_out
    let _ = msg_out
    let _ = ctx_out
    return 1
}

// CryptMsgClose — BOOL.
fn crypt_msg_close(msg: int) -> int {
    let _ = msg
    return 1
}

// CryptMsgGetParam — BOOL.
fn crypt_msg_get_param(msg: int, param_kind: int, index: int, data: int, size: int) -> int {
    let _ = msg
    let _ = param_kind
    let _ = index
    let _ = data
    let _ = size
    return 1
}

// ─── Util ───
// CryptStringToBinaryA — BOOL.
fn crypt_string_to_binary_a(src: str, src_len: int, flags: int, binary: int, binary_size: int, skip: int, used_flags: int) -> int {
    let _ = src
    let _ = src_len
    let _ = flags
    let _ = binary
    let _ = binary_size
    let _ = skip
    let _ = used_flags
    return 1
}

// ─── stage2 stub list (이름 / 카테고리 — self_test, list 용) ───
fn stage2_funcs() -> str {
    let t = ""
    t = t + "CertOpenStore\tCertStore\n"
    t = t + "CertCloseStore\tCertStore\n"
    t = t + "CertEnumCertificatesInStore\tCertStore\n"
    t = t + "CertAddCertificateContextToStore\tCertStore\n"
    t = t + "CertFindCertificateInStore\tCertFind\n"
    t = t + "CertDuplicateCertificateContext\tCertFind\n"
    t = t + "CertFreeCertificateContext\tCertFind\n"
    t = t + "CertCreateCertificateChainEngine\tCertChain\n"
    t = t + "CertGetCertificateChain\tCertChain\n"
    t = t + "CertFreeCertificateChain\tCertChain\n"
    t = t + "CertFreeCertificateChainEngine\tCertChain\n"
    t = t + "CertGetNameStringA\tCertInfo\n"
    t = t + "CertGetNameStringW\tCertInfo\n"
    t = t + "CertGetCertificateContextProperty\tCertInfo\n"
    t = t + "CryptQueryObject\tCryptoMsg\n"
    t = t + "CryptMsgClose\tCryptoMsg\n"
    t = t + "CryptMsgGetParam\tCryptoMsg\n"
    t = t + "CryptStringToBinaryA\tUtil\n"
    return t
}

fn stage2_count() -> int {
    let lines = stage2_funcs().split("\n")
    let i = 0
    let n = 0
    while i < len(lines) {
        if lines[i] != "" { n = n + 1 }
        i = i + 1
    }
    return n
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "crypt32s2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // Cert Store
    let hstore = cert_open_store("System", 0, 0, 0, "MY")
    if hstore != 1 { panic("win32_crypt32_stage2 FAIL [CertOpenStore] expected=1 got=" + to_string(hstore)) }

    let close_rc = cert_close_store(hstore, 0)
    if close_rc != 1 { panic("win32_crypt32_stage2 FAIL [CertCloseStore] expected=1 got=" + to_string(close_rc)) }

    let enum1 = cert_enum_certificates_in_store(hstore, 0)
    if enum1 != 1 { panic("win32_crypt32_stage2 FAIL [CertEnumCertificatesInStore first] expected=1 got=" + to_string(enum1)) }
    let enum2 = cert_enum_certificates_in_store(hstore, enum1)
    if enum2 != 0 { panic("win32_crypt32_stage2 FAIL [CertEnumCertificatesInStore end] expected=0 got=" + to_string(enum2)) }

    let add_rc = cert_add_certificate_context_to_store(hstore, 1, 1, 0)
    if add_rc != 1 { panic("win32_crypt32_stage2 FAIL [CertAddCertificateContextToStore] expected=1 got=" + to_string(add_rc)) }

    // Cert Find
    let found = cert_find_certificate_in_store(hstore, 0, 0, 0, "", 0)
    if found != 1 { panic("win32_crypt32_stage2 FAIL [CertFindCertificateInStore] expected=1 got=" + to_string(found)) }

    let dup = cert_duplicate_certificate_context(found)
    if dup != found { panic("win32_crypt32_stage2 FAIL [CertDuplicateCertificateContext] expected=" + to_string(found) + " got=" + to_string(dup)) }

    let free_ctx = cert_free_certificate_context(dup)
    if free_ctx != 1 { panic("win32_crypt32_stage2 FAIL [CertFreeCertificateContext] expected=1 got=" + to_string(free_ctx)) }

    // Cert Chain
    let eng_rc = cert_create_certificate_chain_engine("", 0)
    if eng_rc != 1 { panic("win32_crypt32_stage2 FAIL [CertCreateCertificateChainEngine] expected=1 got=" + to_string(eng_rc)) }

    let chain_rc = cert_get_certificate_chain(1, found, "", 0, "", 0, 0, 0)
    if chain_rc != 1 { panic("win32_crypt32_stage2 FAIL [CertGetCertificateChain] expected=1 got=" + to_string(chain_rc)) }

    let free_chain = cert_free_certificate_chain(1)
    if free_chain != 0 { panic("win32_crypt32_stage2 FAIL [CertFreeCertificateChain] expected=0 got=" + to_string(free_chain)) }

    let free_eng = cert_free_certificate_chain_engine(1)
    if free_eng != 0 { panic("win32_crypt32_stage2 FAIL [CertFreeCertificateChainEngine] expected=0 got=" + to_string(free_eng)) }

    // Cert Info
    let na = cert_get_name_string_a(found, 0, 0, "", 0, 0)
    if na != 0 { panic("win32_crypt32_stage2 FAIL [CertGetNameStringA] expected=0 got=" + to_string(na)) }

    let nw = cert_get_name_string_w(found, 0, 0, "", 0, 0)
    if nw != 0 { panic("win32_crypt32_stage2 FAIL [CertGetNameStringW] expected=0 got=" + to_string(nw)) }

    let prop = cert_get_certificate_context_property(found, 0, 0, 0)
    if prop != 1 { panic("win32_crypt32_stage2 FAIL [CertGetCertificateContextProperty] expected=1 got=" + to_string(prop)) }

    // Crypto Msg
    let q = crypt_query_object(1, "fake.cab", 0, 0, 0, 0, 0, 0, 0, 0, 0)
    if q != 1 { panic("win32_crypt32_stage2 FAIL [CryptQueryObject] expected=1 got=" + to_string(q)) }

    let mc = crypt_msg_close(1)
    if mc != 1 { panic("win32_crypt32_stage2 FAIL [CryptMsgClose] expected=1 got=" + to_string(mc)) }

    let mg = crypt_msg_get_param(1, 0, 0, 0, 0)
    if mg != 1 { panic("win32_crypt32_stage2 FAIL [CryptMsgGetParam] expected=1 got=" + to_string(mg)) }

    // Util
    let b64 = crypt_string_to_binary_a("YWJj", 4, 1, 0, 0, 0, 0)
    if b64 != 1 { panic("win32_crypt32_stage2 FAIL [CryptStringToBinaryA] expected=1 got=" + to_string(b64)) }

    // count 검증
    let n = stage2_count()
    if n != 18 { panic("win32_crypt32_stage2 FAIL [stage2_count] expected=18 got=" + to_string(n)) }

    r0_emit("crypt32s2_store",
        "\"open\":" + to_string(hstore)
        + ",\"close\":" + to_string(close_rc)
        + ",\"enum_first\":" + to_string(enum1)
        + ",\"enum_end\":" + to_string(enum2))
    r0_emit("crypt32s2_chain",
        "\"engine\":" + to_string(eng_rc)
        + ",\"get\":" + to_string(chain_rc)
        + ",\"free_chain\":" + to_string(free_chain)
        + ",\"free_eng\":" + to_string(free_eng))
    r0_emit("crypt32s2_msg",
        "\"query\":" + to_string(q)
        + ",\"close\":" + to_string(mc)
        + ",\"get_param\":" + to_string(mg))
    r0_emit("crypt32s2_stats",
        "\"functions\":" + to_string(n)
        + ",\"target\":\"Battle.net-Setup.exe\"")

    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("win32_crypt32_stage2 FAIL [emit count] expected=>=4 got=" + to_string(cnt)) }

    println("  ✅ win32_crypt32_stage2 self_test PASS (" + to_string(n) + " functions stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            let lines = stage2_funcs().split("\n")
            let i = 0
            while i < len(lines) {
                if lines[i] != "" { println(lines[i]) }
                i = i + 1
            }
            return
        }
    }
    println("usage: hexa run win32_crypt32_stage2.hexa { self-test | list }")
}
