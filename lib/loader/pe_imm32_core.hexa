    }
    if hwnd_hex == "" {
        panic("pe_imm32_core FAIL [record_context_event] expected=hwnd_hex!=empty got=empty")
    }
    if himc_hex == "" {
        panic("pe_imm32_core FAIL [record_context_event] expected=himc_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_imm32_core FAIL [record_context_event] expected=status!=empty got=empty")
