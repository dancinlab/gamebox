// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pim_count_rows(pim_syscall_invoke_path(), 4)
}

fn context_event_count() -> int {
    return pim_count_rows(pim_context_event_path(), 5)
}

fn composition_event_count() -> int {
    return pim_count_rows(pim_composition_event_path(), 5)
}

fn ime_event_count() -> int {
    return pim_count_rows(pim_ime_event_path(), 5)
}

fn pim_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(context_event_count())
    out.push(composition_event_count())
    out.push(ime_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pim-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pim()

    // ─── 1. syscall_invoke × 10 (one per fn, 3 group coverage) ───
    //   CONTEXT group (3)
    record_syscall_invoke(1, 0, "ImmGetContext", "PARTIAL")
    println("__IMM32__ PARTIAL ImmGetContext")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"ImmGetContext\",\"fn_group\":\"context\",\"status\":\"PARTIAL\",\"hwnd\":\"0x90A00000\",\"himc_out_hex\":\"0x96010000\"")
    record_syscall_invoke(2, 1, "ImmReleaseContext", "PARTIAL")
    println("__IMM32__ PARTIAL ImmReleaseContext")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"ImmReleaseContext\",\"fn_group\":\"context\",\"status\":\"PARTIAL\",\"hwnd\":\"0x90A00000\",\"himc_hex\":\"0x96010000\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(3, 2, "ImmAssociateContext", "PARTIAL")
    println("__IMM32__ PARTIAL ImmAssociateContext")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"ImmAssociateContext\",\"fn_group\":\"context\",\"status\":\"PARTIAL\",\"hwnd\":\"0x90A00000\",\"himc_new_hex\":\"0x96010100\",\"himc_prev_out_hex\":\"0x96010000\"")

    //   COMPOSITION group (4)
    record_syscall_invoke(4, 3, "ImmGetCompositionStringW", "PARTIAL")
    println("__IMM32__ PARTIAL ImmGetCompositionStringW")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"ImmGetCompositionStringW\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"himc_hex\":\"0x96010000\",\"dwIndex\":\"GCS_COMPSTR_0x00000008\",\"lpBuf_synth\":\"WCHAR_0xC548_0xB155_안녕\",\"dwBufLen\":4,\"return_byte_len\":4")
    record_syscall_invoke(5, 4, "ImmSetCompositionStringW", "PARTIAL")
    println("__IMM32__ PARTIAL ImmSetCompositionStringW")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"ImmSetCompositionStringW\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"himc_hex\":\"0x96010000\",\"dwIndex\":\"SCS_SETSTR_0x00000009\",\"lpComp_synth\":\"WCHAR_test_0x0074_0x0065_0x0073_0x0074\",\"dwCompLen\":8,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(6, 5, "ImmNotifyIME", "PARTIAL")
    println("__IMM32__ PARTIAL ImmNotifyIME")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"ImmNotifyIME\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"himc_hex\":\"0x96010000\",\"dwAction\":\"NI_COMPOSITIONSTR_0x0015\",\"dwIndex\":\"CPS_COMPLETE_0x0001\",\"dwValue\":0,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(7, 6, "ImmGetCandidateListW", "PARTIAL")
    println("__IMM32__ PARTIAL ImmGetCandidateListW")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"ImmGetCandidateListW\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"himc_hex\":\"0x96010000\",\"deIndex\":0,\"lpCandList_synth\":\"CANDIDATELIST_28B_header_3_candidates\",\"struct_bytes\":28,\"dwBufLen\":64,\"candidate_count\":3")

    //   IME group (3)
    record_syscall_invoke(8, 7, "ImmGetDefaultIMEWnd", "PARTIAL")
    println("__IMM32__ PARTIAL ImmGetDefaultIMEWnd")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"ImmGetDefaultIMEWnd\",\"fn_group\":\"ime\",\"status\":\"PARTIAL\",\"hwnd\":\"0x90A00000\",\"hwnd_default_ime_out_hex\":\"0x96020000\"")
    record_syscall_invoke(9, 8, "ImmIsIME", "PARTIAL")
    println("__IMM32__ PARTIAL ImmIsIME")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"ImmIsIME\",\"fn_group\":\"ime\",\"status\":\"PARTIAL\",\"hkl_synth\":\"0x04120412_ko_KR\",\"hkl_alt_ja_jp\":\"0x04110411\",\"hkl_alt_zh_cn\":\"0x04040404\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(10, 9, "ImmInstallIMEW", "PARTIAL")
    println("__IMM32__ PARTIAL ImmInstallIMEW")
    r0_emit("pe_imm32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"ImmInstallIMEW\",\"fn_group\":\"ime\",\"status\":\"PARTIAL\",\"lpszIMEFileName\":\"C__Windows__System32__ko_kr_ime.ime\",\"lpszLayoutText\":\"Korean_Microsoft_IME\",\"hkl_out_hex\":\"0x04120412\"")

    // ─── 2. context_event × 3 (get/release/associate) ───
    record_context_event(1, "get_context_for_hwnd", "0x90A00000", "0x96010000", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"context_event\",\"evt_id\":1,\"c_kind\":\"get_context_for_hwnd\",\"hwnd_hex\":\"0x90A00000\",\"himc_hex\":\"0x96010000\",\"status\":\"PARTIAL\"")
    record_context_event(2, "release_context", "0x90A00000", "0x96010000", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"context_event\",\"evt_id\":2,\"c_kind\":\"release_context\",\"hwnd_hex\":\"0x90A00000\",\"himc_hex\":\"0x96010000\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_context_event(3, "associate_new_context", "0x90A00000", "0x96010100", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"context_event\",\"evt_id\":3,\"c_kind\":\"associate_new_context\",\"hwnd_hex\":\"0x90A00000\",\"himc_hex\":\"0x96010100\",\"himc_prev_hex\":\"0x96010000\",\"status\":\"PARTIAL\"")

    // ─── 3. composition_event × 4 (get_str_ko/set_str_test/notify_complete/candidate_list) ───
    record_composition_event(1, "get_compstr_GCS_COMPSTR_ko_안녕", "0x96010000", "WCHAR_0xC548_0xB155_안녕_4B", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"composition_event\",\"evt_id\":1,\"c_kind\":\"get_compstr_GCS_COMPSTR_ko_안녕\",\"himc_hex\":\"0x96010000\",\"comp_synth\":\"WCHAR_0xC548_0xB155_안녕_4B\",\"dwIndex\":\"GCS_COMPSTR\",\"return_byte_len\":4,\"locale\":\"ko_KR\",\"status\":\"PARTIAL\"")
    record_composition_event(2, "set_compstr_SCS_SETSTR_test", "0x96010000", "WCHAR_test_8B", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"composition_event\",\"evt_id\":2,\"c_kind\":\"set_compstr_SCS_SETSTR_test\",\"himc_hex\":\"0x96010000\",\"comp_synth\":\"WCHAR_test_8B\",\"dwIndex\":\"SCS_SETSTR\",\"dwCompLen\":8,\"locale\":\"en_US\",\"status\":\"PARTIAL\"")
    record_composition_event(3, "notify_NI_COMPOSITIONSTR_CPS_COMPLETE", "0x96010000", "dwAction_0x0015_dwIndex_0x0001", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"composition_event\",\"evt_id\":3,\"c_kind\":\"notify_NI_COMPOSITIONSTR_CPS_COMPLETE\",\"himc_hex\":\"0x96010000\",\"comp_synth\":\"dwAction_0x0015_dwIndex_0x0001\",\"dwAction\":\"NI_COMPOSITIONSTR\",\"dwIndex\":\"CPS_COMPLETE\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_composition_event(4, "get_candidate_list_3candidates", "0x96010000", "CANDIDATELIST_28B_header_3_candidates", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"composition_event\",\"evt_id\":4,\"c_kind\":\"get_candidate_list_3candidates\",\"himc_hex\":\"0x96010000\",\"comp_synth\":\"CANDIDATELIST_28B_header_3_candidates\",\"struct_bytes\":28,\"deIndex\":0,\"candidate_count\":3,\"status\":\"PARTIAL\"")

    // ─── 4. ime_event × 3 (default_ime_wnd/is_ime/install_ime) ───
    record_ime_event(1, "default_ime_wnd_for_hwnd", "0x90A00000", "hwnd_default_ime_0x96020000", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"ime_event\",\"evt_id\":1,\"i_kind\":\"default_ime_wnd_for_hwnd\",\"hwnd_or_hkl\":\"0x90A00000\",\"ime_synth\":\"hwnd_default_ime_0x96020000\",\"hwnd_default_ime_hex\":\"0x96020000\",\"status\":\"PARTIAL\"")
    record_ime_event(2, "is_ime_check_ko_kr", "0x04120412", "ko_KR_TRUE", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"ime_event\",\"evt_id\":2,\"i_kind\":\"is_ime_check_ko_kr\",\"hwnd_or_hkl\":\"0x04120412\",\"ime_synth\":\"ko_KR_TRUE\",\"hkl_synth\":\"0x04120412_ko_KR\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_ime_event(3, "install_ime_ko_kr", "0x04120412", "C__Windows__System32__ko_kr_ime.ime", "PARTIAL")
    r0_emit("pe_imm32_core_record", "\"kind\":\"ime_event\",\"evt_id\":3,\"i_kind\":\"install_ime_ko_kr\",\"hwnd_or_hkl\":\"0x04120412\",\"ime_synth\":\"C__Windows__System32__ko_kr_ime.ime\",\"layout_text\":\"Korean_Microsoft_IME\",\"hkl_out_hex\":\"0x04120412\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_imm32_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let ce = context_event_count()
    if ce != 3 {
        panic("pe_imm32_core FAIL [context_event_count] expected=3 got=" + to_string(ce))
    }
    let ce2 = composition_event_count()
    if ce2 != 4 {
        panic("pe_imm32_core FAIL [composition_event_count] expected=4 got=" + to_string(ce2))
    }
    let ie = ime_event_count()
    if ie != 3 {
        panic("pe_imm32_core FAIL [ime_event_count] expected=3 got=" + to_string(ie))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "ImmGetContext" { panic("pe_imm32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "ImmAssociateContext" { panic("pe_imm32_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(3) != "ImmGetCompositionStringW" { panic("pe_imm32_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(6) != "ImmGetCandidateListW" { panic("pe_imm32_core FAIL [fn_kind_name(6)]") }
    if fn_kind_name(9) != "ImmInstallIMEW" { panic("pe_imm32_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_imm32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "context" { panic("pe_imm32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(3) != "composition" { panic("pe_imm32_core FAIL [fn_group_name(3)]") }
    if fn_group_name(7) != "ime" { panic("pe_imm32_core FAIL [fn_group_name(7)]") }
    if fn_group_name(99) != "unknown" { panic("pe_imm32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pim_stats()
    if len(s) != 4 { panic("pe_imm32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_imm32_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 3 { panic("pe_imm32_core FAIL [stats context_event_count] expected=3 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_imm32_core FAIL [stats composition_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_imm32_core FAIL [stats ime_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_imm32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"context_event_count\":" + to_string(s[1])
        + ",\"composition_event_count\":" + to_string(s[2])
        + ",\"ime_event_count\":" + to_string(s[3]))

    r0_emit("pe_imm32_core_summary",
        "\"target\":\"IMM32.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"context\",\"composition\",\"ime\"],\"compositionform_synth_bytes\":28,\"candidatelist_synth_bytes\":28,\"locales\":[\"ko_KR\",\"ja_JP\",\"zh_CN\",\"en_US\"],\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_imm32_core_kpi",
        "\"context_emits\":3,\"composition_emits\":4,\"ime_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_lineage_korean_ime_baseline\":true,\"nstextinputclient_imkinputcontroller_binding\":false")

    // ─── cycle 41 → 42 IMM32 coverage progression evidence emit ───
    r0_emit("pe_imm32_core_coverage_progression",
        "\"surface\":\"IMM32_full_435_fn\",\"cycle_41_count\":198,\"cycle_42_count\":208,\"delta\":10,\"cycle_41_percent\":45.52,\"cycle_42_percent\":47.82,\"cycle_42_module\":\"pe_imm32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_am3_cycle_increment\":10,\"track_am_bundled_part_3_of_4\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_imm32_core_round_trip_matrix",
        "\"surface\":\"IMM32_core_10_fn\",\"fn_partial\":10,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.2\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real ImmGetContext + ImmGetCompositionStringW + ImmNotifyIME = NSTextInputClient + NSTextInputContext + IMKInputController bridge pending separate cycle (long-horizon)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"d2r_lineage_korean_ime_baseline\":\"안녕 / test / テスト / 你好 ko/ja/zh/en composition string sample baseline\"")

    // ─── Track AM3 expansion emit (cycle 42, IMM32 +10 fn) ───
    r0_emit("pe_imm32_core_am3_expansion",
        "\"track\":\"AM3\",\"cycle\":42,\"surface\":\"IMM32_new\",\"new_fn\":10,\"groups\":[\"context\",\"composition\",\"ime\"],\"context_count\":3,\"composition_count\":4,\"ime_count\":3,\"emit_format\":\"__IMM32__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_2_evidence_augment\":true,\"track_am_bundled_part_3_of_4\":true,\"50pct_threshold_target\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_imm32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pim()
    let s2 = pim_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_imm32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_imm32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", context_event=" + to_string(s[1])
        + ", composition_event=" + to_string(s[2]) + ", ime_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pim_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("context_event_count\t" + to_string(s[1]))
            println("composition_event_count\t" + to_string(s[2]))
            println("ime_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_imm32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_imm32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pim()
            println("cleaned: " + pim_dir())
            return
        }
        if sub == "dir" {
            println(pim_dir())
            return
        }
    }
    println("usage: hexa run pe_imm32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
