// lib/loader/pe_imm32_core.hexa — IMM32.dll IME input surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine imm32 source 측 코드 인용 0. imm32.dll 직접 binding 0. macOS NSTextInputClient /
//       NSTextInputContext / TISInputSource / IMKInputController / IME service 직접 binding 0.
//       NOTE: IMM32 는 ko-KR/ja-JP/zh-CN IME composition 측 PE binary game text input 측 surface
//       (D2R chat input + Lineage 한글 입력 baseline), 본 module 측 HIMC + COMPOSITIONFORM
//       struct round-trip + composition string 측 baseline (long-horizon production smoke
//       pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH/AM parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AM3 — IMM32 (imm32.dll) IME input surface coverage 10 fn (skeleton row 만).
// Track AM2 predecessor (XAudio2 10 fn cycle 41) 후 본 Track AM3 은 IMM32 측 context +
// composition + IME baseline land. cycle 41 측 198/435 (~45.52%) → cycle 42 측 ~208/435
// (~47.82%) coverage progression (+10 fn 신규, Track AM bundled cycle 40-43 측 AM3 row,
// 3번째 row, ko-KR / ja-JP / zh-CN IME baseline).
//
// 대상 fn (10 fn — 3 group, fn_kind 0..9 canonical map):
//   CONTEXT      (3): ImmGetContext(0) / ImmReleaseContext(1) / ImmAssociateContext(2)
//   COMPOSITION  (4): ImmGetCompositionStringW(3) / ImmSetCompositionStringW(4) /
//                     ImmNotifyIME(5) / ImmGetCandidateListW(6)
//   IME          (3): ImmGetDefaultIMEWnd(7) / ImmIsIME(8) / ImmInstallIMEW(9)
//
// synthetic struct families:
//   HIMC handle 0x96010000 (input context, opaque)
//   HIMC list family 0x96010100 / 0x96010200 (per HWND association)
//   HWND default IME wnd 0x96020000 (ImmGetDefaultIMEWnd return)
//   COMPOSITIONFORM 28 byte: dwStyle 0x00000002 (CFS_POINT) + ptCurrentPos.x 100 + .y 200 +
//     rcArea.left 0 + .top 0 + .right 800 + .bottom 600.
//   composition string WCHAR (UTF-16 LE) — "안녕" (4 byte 안 0xC548 + 녕 0xB155) /
//     "test" / "テスト" / "你好" — synthetic ko/ja/zh sample.
//   CANDIDATELIST 28 byte (header) + offsets WORD + WCHAR list — synthetic 3-candidate.
//   HKL ko-KR 0x04120412 / ja-JP 0x04110411 / zh-CN 0x04040404 (low 16-bit LANGID).
//
// persist schema (TSV — 4 table): syscall_invoke / context_event / composition_event / ime_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pim_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_imm32_core"
}

fn pim_syscall_invoke_path() -> str {
    return pim_dir() + "/syscall_invoke.tsv"
}

fn pim_context_event_path() -> str {
    return pim_dir() + "/context_event.tsv"
}

fn pim_composition_event_path() -> str {
    return pim_dir() + "/composition_event.tsv"
}

fn pim_ime_event_path() -> str {
    return pim_dir() + "/ime_event.tsv"
}

fn pim_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pim_dir() + "'")
}

fn cleanup_pim() -> void {
    pim_ensure_dir()
    let _ = exec("rm -f '" + pim_syscall_invoke_path() + "' '" + pim_context_event_path()
        + "' '" + pim_composition_event_path() + "' '" + pim_ime_event_path() + "'")
}

// ─── 공통 file IO ───
fn pim_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pim_append_row(path: str, row: str) -> void {
    pim_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pim_count_rows(path: str, min_cols: int) -> int {
    let t = pim_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "ImmGetContext" }
    if k == 1 { return "ImmReleaseContext" }
    if k == 2 { return "ImmAssociateContext" }
    if k == 3 { return "ImmGetCompositionStringW" }
    if k == 4 { return "ImmSetCompositionStringW" }
    if k == 5 { return "ImmNotifyIME" }
    if k == 6 { return "ImmGetCandidateListW" }
    if k == 7 { return "ImmGetDefaultIMEWnd" }
    if k == 8 { return "ImmIsIME" }
    if k == 9 { return "ImmInstallIMEW" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "context"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "composition"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "ime"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: IMM32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_imm32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_imm32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_imm32_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_imm32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_imm32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pim_append_row(pim_syscall_invoke_path(), row)
}

// ─── record_context_event: ImmGetContext/ReleaseContext/AssociateContext row ───
