// lib/loader/win32_shell32_stage2.hexa — Battle.net Setup SHELL32 imports coverage
//
// Battle.net 의 shell ops (file dialog, special folder, shortcut) 함수 —
// SHGetSpecialFolderPathA/W, SHGetFolderPathW, ShellExecuteA 등. stage1 base 위에
// 추가.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft 공식 SHELL32 API spec:
//     - SHGetFolderPathW:        https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/
//     - SHGetSpecialFolderPathA: https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/
//     - ShellExecuteExA/W:       https://learn.microsoft.com/en-us/windows/win32/api/shellapi/
//     - SHBrowseForFolderW:      https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/
//     - CommandLineToArgvW:      https://learn.microsoft.com/en-us/windows/win32/api/shellapi/
//   Wine source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 3: shell32_s2_stub + shell32_s2_csidl + shell32_s2_count)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("win32_shell32_stage2 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase stage2 — Battle.net-Setup.exe SHELL32 imports 8 함수 + extras):
//   stage1 (win32_shell32.hexa) = mapping table + CSIDL synthetic path lookup.
//   stage2 = 실제 호출 가능한 stub function 들 — Win32 호출 규약에 맞춰
//   적절한 default value (BOOL=1 / HRESULT=0 / HANDLE=1 / void=no return) 를 반환.
//
// Battle.net-Setup.exe 실측 SHELL32 imports (objdump -p, DLL index 9):
//   1. SHGetFolderPathW         (HRESULT)
//   2. ShellExecuteExA          (BOOL)
//   3. SHGetMalloc              (HRESULT)
//   4. SHGetPathFromIDListW     (BOOL)
//   5. SHBrowseForFolderW       (HANDLE — LPITEMIDLIST)
//   6. ShellExecuteExW          (BOOL)
//   7. CommandLineToArgvW       (HANDLE — LPWSTR*)
//   8. FindExecutableA          (HINSTANCE)
//
// 추가 헤더 spec 명시 함수 (기타 일반 setup 시나리오):
//   9.  SHGetSpecialFolderPathA (BOOL)
//  10.  SHGetSpecialFolderPathW (BOOL)
//  11.  ShellExecuteA           (HINSTANCE)
//
// Win32 retval 정의:
//   BOOL TRUE  = 1
//   BOOL FALSE = 0
//   S_OK       = 0
//   HANDLE / HINSTANCE non-null = 1 (synthetic, 비-NULL 만 의미 있음)

use "../perf/r0_common"

// ─── 1. SHGetFolderPathW(hwndOwner, csidl, hToken, dwFlags, pszPath) → HRESULT ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/nf-shlobj_core-shgetfolderpathw
//   Battle.net: 보통 CSIDL_LOCAL_APPDATA(28) / CSIDL_PROGRAM_FILES(38) 호출.
//   stub: S_OK (0) — pszPath buffer 채움은 stage1 csidl_to_path 와 별개 (caller 책임).
fn sh_get_folder_path_w(hwnd_owner: int, csidl: int, h_token: int, dw_flags: int, psz_path: str) -> int {
    let _ = hwnd_owner
    let _ = csidl
    let _ = h_token
    let _ = dw_flags
    let _ = psz_path
    return 0  // S_OK
}

// ─── 2. ShellExecuteExA(lpExecInfo) → BOOL ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shellapi/nf-shellapi-shellexecuteexa
//   stub: TRUE — 실 launch 없음.
fn shell_execute_ex_a(lp_exec_info: str) -> int {
    let _ = lp_exec_info
    return 1  // TRUE
}

// ─── 3. SHGetMalloc(ppMalloc) → HRESULT ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/nf-shlobj_core-shgetmalloc
//   stub: S_OK — IMalloc COM interface 미구현 (out param 채움은 caller 책임).
fn sh_get_malloc(pp_malloc: str) -> int {
    let _ = pp_malloc
    return 0  // S_OK
}

// ─── 4. SHGetPathFromIDListW(pidl, pszPath) → BOOL ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/nf-shlobj_core-shgetpathfromidlistw
//   stub: TRUE.
fn sh_get_path_from_id_list_w(pidl: int, psz_path: str) -> int {
    let _ = pidl
    let _ = psz_path
    return 1  // TRUE
}

// ─── 5. SHBrowseForFolderW(lpbi) → LPITEMIDLIST (HANDLE) ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/nf-shlobj_core-shbrowseforfolderw
//   stub: 1 (non-NULL synthetic handle — headless 환경에서 dialog 미표시).
fn sh_browse_for_folder_w(lpbi: str) -> int {
    let _ = lpbi
    return 1  // non-NULL HANDLE
}

// ─── 6. ShellExecuteExW(lpExecInfo) → BOOL ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shellapi/nf-shellapi-shellexecuteexw
//   stub: TRUE.
fn shell_execute_ex_w(lp_exec_info: str) -> int {
    let _ = lp_exec_info
    return 1  // TRUE
}

// ─── 7. CommandLineToArgvW(lpCmdLine, pNumArgs) → LPWSTR* (HANDLE) ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shellapi/nf-shellapi-commandlinetoargvw
//   stub: 1 (non-NULL synthetic argv pointer).
fn command_line_to_argv_w(lp_cmd_line: str, p_num_args: int) -> int {
    let _ = lp_cmd_line
    let _ = p_num_args
    return 1  // non-NULL HANDLE
}

// ─── 8. FindExecutableA(lpFile, lpDirectory, lpResult) → HINSTANCE ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shellapi/nf-shellapi-findexecutablea
//   stub: 1 (non-NULL HINSTANCE — Win32 spec: > 32 = success, <= 32 = error).
fn find_executable_a(lp_file: str, lp_directory: str, lp_result: str) -> int {
    let _ = lp_file
    let _ = lp_directory
    let _ = lp_result
    return 1  // non-NULL HINSTANCE (caller 측에서 > 32 체크 시 보조 확장 필요)
}

// ─── 9. SHGetSpecialFolderPathA(hwndOwner, lpszPath, csidl, fCreate) → BOOL ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/nf-shlobj_core-shgetspecialfolderpatha
//   stub: TRUE.
fn sh_get_special_folder_path_a(hwnd_owner: int, lpsz_path: str, csidl: int, f_create: int) -> int {
    let _ = hwnd_owner
    let _ = lpsz_path
    let _ = csidl
    let _ = f_create
    return 1  // TRUE
}

// ─── 10. SHGetSpecialFolderPathW(hwndOwner, lpszPath, csidl, fCreate) → BOOL ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shlobj_core/nf-shlobj_core-shgetspecialfolderpathw
//   stub: TRUE.
fn sh_get_special_folder_path_w(hwnd_owner: int, lpsz_path: str, csidl: int, f_create: int) -> int {
    let _ = hwnd_owner
    let _ = lpsz_path
    let _ = csidl
    let _ = f_create
    return 1  // TRUE
}

// ─── 11. ShellExecuteA(hwnd, lpOperation, lpFile, lpParameters, lpDirectory, nShowCmd) → HINSTANCE ───
//   참조: https://learn.microsoft.com/en-us/windows/win32/api/shellapi/nf-shellapi-shellexecutea
//   stub: 1 (non-NULL HINSTANCE).
fn shell_execute_a(hwnd: int, lp_operation: str, lp_file: str, lp_parameters: str, lp_directory: str, n_show_cmd: int) -> int {
    let _ = hwnd
    let _ = lp_operation
    let _ = lp_file
    let _ = lp_parameters
    let _ = lp_directory
    let _ = n_show_cmd
    return 1  // non-NULL HINSTANCE
}

// ─── stub 함수 list (TSV — name\tret_kind\texpected_ret) ───
fn shell32_s2_stub_list() -> str {
    let mut t = ""
    t = t + "SHGetFolderPathW\tHRESULT\t0\n"
    t = t + "ShellExecuteExA\tBOOL\t1\n"
    t = t + "SHGetMalloc\tHRESULT\t0\n"
    t = t + "SHGetPathFromIDListW\tBOOL\t1\n"
    t = t + "SHBrowseForFolderW\tHANDLE\t1\n"
    t = t + "ShellExecuteExW\tBOOL\t1\n"
    t = t + "CommandLineToArgvW\tHANDLE\t1\n"
    t = t + "FindExecutableA\tHINSTANCE\t1\n"
    t = t + "SHGetSpecialFolderPathA\tBOOL\t1\n"
    t = t + "SHGetSpecialFolderPathW\tBOOL\t1\n"
    t = t + "ShellExecuteA\tHINSTANCE\t1\n"
    return t
}

fn shell32_s2_stub_count() -> int {
    let t = shell32_s2_stub_list()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        if lines[i] != "" {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "shell32s2-" + exec("date +%s").trim()
    r0_session_set(sid)

    let mut stubbed = 0

    // 1. SHGetFolderPathW → HRESULT 0
    let r1 = sh_get_folder_path_w(0, 28, 0, 0, "")
    if r1 != 0 {
        panic("win32_shell32_stage2 FAIL [SHGetFolderPathW] expected=0 got=" + to_string(r1))
    }
    stubbed = stubbed + 1

    // 2. ShellExecuteExA → BOOL 1
    let r2 = shell_execute_ex_a("")
    if r2 != 1 {
        panic("win32_shell32_stage2 FAIL [ShellExecuteExA] expected=1 got=" + to_string(r2))
    }
    stubbed = stubbed + 1

    // 3. SHGetMalloc → HRESULT 0
    let r3 = sh_get_malloc("")
    if r3 != 0 {
        panic("win32_shell32_stage2 FAIL [SHGetMalloc] expected=0 got=" + to_string(r3))
    }
    stubbed = stubbed + 1

    // 4. SHGetPathFromIDListW → BOOL 1
    let r4 = sh_get_path_from_id_list_w(0, "")
    if r4 != 1 {
        panic("win32_shell32_stage2 FAIL [SHGetPathFromIDListW] expected=1 got=" + to_string(r4))
    }
    stubbed = stubbed + 1

    // 5. SHBrowseForFolderW → HANDLE 1
    let r5 = sh_browse_for_folder_w("")
    if r5 != 1 {
        panic("win32_shell32_stage2 FAIL [SHBrowseForFolderW] expected=1 got=" + to_string(r5))
    }
    stubbed = stubbed + 1

    // 6. ShellExecuteExW → BOOL 1
    let r6 = shell_execute_ex_w("")
    if r6 != 1 {
        panic("win32_shell32_stage2 FAIL [ShellExecuteExW] expected=1 got=" + to_string(r6))
    }
    stubbed = stubbed + 1

    // 7. CommandLineToArgvW → HANDLE 1
    let r7 = command_line_to_argv_w("", 0)
    if r7 != 1 {
        panic("win32_shell32_stage2 FAIL [CommandLineToArgvW] expected=1 got=" + to_string(r7))
    }
    stubbed = stubbed + 1

    // 8. FindExecutableA → HINSTANCE 1
    let r8 = find_executable_a("", "", "")
    if r8 != 1 {
        panic("win32_shell32_stage2 FAIL [FindExecutableA] expected=1 got=" + to_string(r8))
    }
    stubbed = stubbed + 1

    // 9. SHGetSpecialFolderPathA → BOOL 1
    let r9 = sh_get_special_folder_path_a(0, "", 28, 0)
    if r9 != 1 {
        panic("win32_shell32_stage2 FAIL [SHGetSpecialFolderPathA] expected=1 got=" + to_string(r9))
    }
    stubbed = stubbed + 1

    // 10. SHGetSpecialFolderPathW → BOOL 1
    let r10 = sh_get_special_folder_path_w(0, "", 28, 0)
    if r10 != 1 {
        panic("win32_shell32_stage2 FAIL [SHGetSpecialFolderPathW] expected=1 got=" + to_string(r10))
    }
    stubbed = stubbed + 1

    // 11. ShellExecuteA → HINSTANCE 1
    let r11 = shell_execute_a(0, "open", "/Applications/Battle.net.app", "", "", 1)
    if r11 != 1 {
        panic("win32_shell32_stage2 FAIL [ShellExecuteA] expected=1 got=" + to_string(r11))
    }
    stubbed = stubbed + 1

    // 12. stub_count = 11
    let cnt = shell32_s2_stub_count()
    if cnt != 11 {
        panic("win32_shell32_stage2 FAIL [stub_count] expected=11 got=" + to_string(cnt))
    }
    if cnt != stubbed {
        panic("win32_shell32_stage2 FAIL [stub vs counted] expected=" + to_string(stubbed) + " got=" + to_string(cnt))
    }

    // 13. r0_emit ≥ 3
    r0_emit("shell32_s2_stub", "\"name\":\"SHGetFolderPathW\",\"ret_kind\":\"HRESULT\",\"ret\":" + to_string(r1))
    r0_emit("shell32_s2_csidl", "\"csidl\":28,\"sh_get_folder_path_w_ret\":" + to_string(r1) + ",\"sh_get_special_folder_path_w_ret\":" + to_string(r10))
    r0_emit("shell32_s2_count", "\"stubbed\":" + to_string(stubbed) + ",\"list_size\":" + to_string(cnt))

    let emit_n = r0_session_count(sid)
    if emit_n < 3 {
        panic("win32_shell32_stage2 FAIL [r0 emit count] expected=>=3 got=" + to_string(emit_n))
    }

    // 14. PASS
    println("  ✅ win32_shell32_stage2 self_test PASS (" + to_string(stubbed) + " stubbed, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            println(shell32_s2_stub_list())
            return
        }
        if sub == "count" {
            println(to_string(shell32_s2_stub_count()))
            return
        }
    }
    println("usage: hexa run win32_shell32_stage2.hexa { self-test | list | count }")
}
