// lib/loader/pe_iat_api_set_redirect.hexa — R3 phase 2 API Set redirection tracker
//
// Win10 API Set redirection (PEB->ApiSetMap):
//   schema location: NtCurrentTeb()->ProcessEnvironmentBlock->ApiSetMap (Win10+)
//   binary format: API_SET_NAMESPACE { Version, Size, Flags, Count, EntryOffset, HashOffset, HashFactor }
//   hash 매핑: lowercase string hash → namespace entry → namespace value (DLL string)
//   예: api-ms-win-core-string-l1-1-0.dll → kernelbase.dll
//   skeleton: 알려진 D2R/Battle.net 사용 api-ms-win-core-* schema entry hash 만 추적
// own1: Win10 API Set spec (Microsoft) + Apple POSIX. Wine apiset.c 인용 X
//
// api_set_kind code:
//   1 = core (api-ms-win-core-*)
//   2 = eventing (api-ms-win-eventing-*)
//   3 = core_winrt (api-ms-win-core-winrt-*)
//   4 = ext_ms (ext-ms-win-*)
//   5 = devicequery (api-ms-win-devicequery-*)
//
// resolved_dll code:
//   1 = kernelbase.dll
//   2 = ntdll.dll
//   3 = advapi32.dll
//   4 = user32.dll
//   5 = other
//
// persist schema (TSV — redirects.tsv):
//   redirect_id<int> \t api_set_kind<int> \t hash_value<int> \t resolved_dll<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pasr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_iat_api_set_redirect"
}

fn pasr_redirects_path() -> str {
    return pasr_dir() + "/redirects.tsv"
}

fn pasr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pasr_dir() + "'")
}

fn cleanup_pasr() -> void {
    pasr_ensure_dir()
    let _ = exec("rm -f '" + pasr_redirects_path() + "'")
}

// ─── 공통 file IO ───
fn pasr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pasr_append_row(path: str, row: str) -> void {
    pasr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_redirect: API Set redirect 1 건 기록 ───
fn record_redirect(redirect_id: int, api_set_kind: int, hash_value: int, resolved_dll: int) -> void {
    if redirect_id <= 0 {
        panic("pe_iat_api_set_redirect FAIL [record_redirect] expected=redirect_id>0 got=" + to_string(redirect_id))
    }
    if api_set_kind < 1 {
        panic("pe_iat_api_set_redirect FAIL [record_redirect] expected=api_set_kind>=1 got=" + to_string(api_set_kind))
    }
    if api_set_kind > 5 {
        panic("pe_iat_api_set_redirect FAIL [record_redirect] expected=api_set_kind<=5 got=" + to_string(api_set_kind))
    }
    if hash_value < 0 {
        panic("pe_iat_api_set_redirect FAIL [record_redirect] expected=hash_value>=0 got=" + to_string(hash_value))
    }
    if resolved_dll < 1 {
        panic("pe_iat_api_set_redirect FAIL [record_redirect] expected=resolved_dll>=1 got=" + to_string(resolved_dll))
    }
    if resolved_dll > 5 {
        panic("pe_iat_api_set_redirect FAIL [record_redirect] expected=resolved_dll<=5 got=" + to_string(resolved_dll))
    }
    let row = to_string(redirect_id) + "\t" + to_string(api_set_kind)
        + "\t" + to_string(hash_value) + "\t" + to_string(resolved_dll) + "\n"
    pasr_append_row(pasr_redirects_path(), row)
}

// ─── redirect_count: total redirect 수 ───
fn redirect_count() -> int {
    let t = pasr_read_table(pasr_redirects_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_api_set_kind: 특정 api_set_kind 의 redirect 수 ───
fn count_by_api_set_kind(api_set_kind: int) -> int {
    let t = pasr_read_table(pasr_redirects_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == api_set_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_resolved_dll: 특정 resolved_dll 의 redirect 수 ───
fn count_by_resolved_dll(resolved_dll: int) -> int {
    let t = pasr_read_table(pasr_redirects_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == resolved_dll {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── kernelbase_count: resolved_dll == 1 (kernelbase) ───
fn kernelbase_count() -> int {
    return count_by_resolved_dll(1)
}

// ─── distinct_hashes: 고유 hash_value 개수 ───
fn distinct_hashes() -> int {
    let t = pasr_read_table(pasr_redirects_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let hv = to_int(parts[2])
                let mut found = false
                let j = 0
                while j < len(seen) {
                    if seen[j] == hv {
                        found = true
                    }
                    j = j + 1
                }
                if !found {
                    seen.push(hv)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── redirect_resolved_dll: 특정 redirect_id 의 resolved_dll (없으면 0) ───
fn redirect_resolved_dll(redirect_id: int) -> int {
    let t = pasr_read_table(pasr_redirects_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == redirect_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pasr_stats: [redirect_count, kernelbase_count, distinct_hashes, count_by_api_set_kind(1)] ───
fn pasr_stats() -> array {
    let mut out = []
    out.push(redirect_count())
    out.push(kernelbase_count())
    out.push(distinct_hashes())
    out.push(count_by_api_set_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pasr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pasr()

    // 2. record 5 redirects across ≥3 api_set_kinds and ≥3 resolved_dlls
    //    api_set_kind: 1=core, 2=eventing, 4=ext_ms (3 kinds)
    //    resolved_dll: 1=kernelbase, 2=ntdll, 3=advapi32 (3 dlls)
    record_redirect(220001, 1, 1001, 1)
    r0_emit("pe_iat_api_set_redirect_record",
        "\"redirect_id\":220001,\"api_set_kind\":1,\"hash_value\":1001,\"resolved_dll\":1,\"target\":\"api-ms-win-core-string-l1-1-0\"")

    record_redirect(220002, 1, 1002, 1)
    r0_emit("pe_iat_api_set_redirect_record",
        "\"redirect_id\":220002,\"api_set_kind\":1,\"hash_value\":1002,\"resolved_dll\":1,\"target\":\"api-ms-win-core-heap-l1-1-0\"")

    record_redirect(220003, 2, 2001, 3)
    r0_emit("pe_iat_api_set_redirect_record",
        "\"redirect_id\":220003,\"api_set_kind\":2,\"hash_value\":2001,\"resolved_dll\":3,\"target\":\"api-ms-win-eventing-provider\"")

    record_redirect(220004, 4, 4001, 2)
    r0_emit("pe_iat_api_set_redirect_record",
        "\"redirect_id\":220004,\"api_set_kind\":4,\"hash_value\":4001,\"resolved_dll\":2,\"target\":\"ext-ms-win-ntuser-misc\"")

    record_redirect(220005, 1, 1001, 1)
    r0_emit("pe_iat_api_set_redirect_record",
        "\"redirect_id\":220005,\"api_set_kind\":1,\"hash_value\":1001,\"resolved_dll\":1,\"target\":\"api-ms-win-core-string-l1-1-0-dup\"")

    // 3. redirect_count = 5
    let c = redirect_count()
    if c != 5 {
        panic("pe_iat_api_set_redirect FAIL [redirect_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_api_set_kind sanity (kinds: 1=3, 2=1, 4=1)
    let k1 = count_by_api_set_kind(1)
    if k1 != 3 {
        panic("pe_iat_api_set_redirect FAIL [count_by_api_set_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_api_set_kind(2)
    if k2 != 1 {
        panic("pe_iat_api_set_redirect FAIL [count_by_api_set_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k4 = count_by_api_set_kind(4)
    if k4 != 1 {
        panic("pe_iat_api_set_redirect FAIL [count_by_api_set_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k3 = count_by_api_set_kind(3)
    if k3 != 0 {
        panic("pe_iat_api_set_redirect FAIL [count_by_api_set_kind(3)] expected=0 got=" + to_string(k3))
    }
    let k5 = count_by_api_set_kind(5)
    if k5 != 0 {
        panic("pe_iat_api_set_redirect FAIL [count_by_api_set_kind(5)] expected=0 got=" + to_string(k5))
    }

    // 5. count_by_resolved_dll sanity (dlls: 1=3, 2=1, 3=1)
    let d1 = count_by_resolved_dll(1)
    if d1 != 3 {
        panic("pe_iat_api_set_redirect FAIL [count_by_resolved_dll(1)] expected=3 got=" + to_string(d1))
    }
    let d2 = count_by_resolved_dll(2)
    if d2 != 1 {
        panic("pe_iat_api_set_redirect FAIL [count_by_resolved_dll(2)] expected=1 got=" + to_string(d2))
    }
    let d3 = count_by_resolved_dll(3)
    if d3 != 1 {
        panic("pe_iat_api_set_redirect FAIL [count_by_resolved_dll(3)] expected=1 got=" + to_string(d3))
    }
    let d4 = count_by_resolved_dll(4)
    if d4 != 0 {
        panic("pe_iat_api_set_redirect FAIL [count_by_resolved_dll(4)] expected=0 got=" + to_string(d4))
    }

    // 6. kernelbase_count = 3
    let kb = kernelbase_count()
    if kb != 3 {
        panic("pe_iat_api_set_redirect FAIL [kernelbase_count] expected=3 got=" + to_string(kb))
    }

    // 7. distinct_hashes: hashes={1001,1002,2001,4001} → 4
    let dh = distinct_hashes()
    if dh != 4 {
        panic("pe_iat_api_set_redirect FAIL [distinct_hashes] expected=4 got=" + to_string(dh))
    }

    // 8. redirect_resolved_dll sanity
    let r2 = redirect_resolved_dll(220003)
    if r2 != 3 {
        panic("pe_iat_api_set_redirect FAIL [redirect_resolved_dll(220003)] expected=3 got=" + to_string(r2))
    }
    let r4 = redirect_resolved_dll(220004)
    if r4 != 2 {
        panic("pe_iat_api_set_redirect FAIL [redirect_resolved_dll(220004)] expected=2 got=" + to_string(r4))
    }
    let r_miss = redirect_resolved_dll(9999)
    if r_miss != 0 {
        panic("pe_iat_api_set_redirect FAIL [redirect_resolved_dll(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 9. pasr_stats() = [5, 3, 4, 3]
    let s = pasr_stats()
    if len(s) != 4 {
        panic("pe_iat_api_set_redirect FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_iat_api_set_redirect FAIL [stats redirect_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_iat_api_set_redirect FAIL [stats kernelbase_count] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_iat_api_set_redirect FAIL [stats distinct_hashes] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_iat_api_set_redirect FAIL [stats kind_core] expected=3 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_iat_api_set_redirect_stats",
        "\"redirect_count\":" + to_string(s[0])
        + ",\"kernelbase_count\":" + to_string(s[1])
        + ",\"distinct_hashes\":" + to_string(s[2])
        + ",\"kind_core\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_iat_api_set_redirect FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pasr()
    let s2 = pasr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_iat_api_set_redirect FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_iat_api_set_redirect self_test PASS (redirects=" + to_string(s[0])
        + ", kernelbase=" + to_string(s[1]) + ", hashes=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pasr_stats()
            println("redirect_count\t" + to_string(s[0]))
            println("kernelbase_count\t" + to_string(s[1]))
            println("distinct_hashes\t" + to_string(s[2]))
            println("kind_core\t" + to_string(s[3]))
            return
        }
        if sub == "dll" {
            if len(a) >= 4 {
                let rid = to_int(a[3])
                println("redirect_resolved_dll\t" + to_string(redirect_resolved_dll(rid)))
                return
            }
            println("usage: hexa run pe_iat_api_set_redirect.hexa dll <redirect_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let mode = a[3]
                let val = to_int(a[4])
                if mode == "api" {
                    println("count_by_api_set_kind\t" + to_string(count_by_api_set_kind(val)))
                    return
                }
                if mode == "dll" {
                    println("count_by_resolved_dll\t" + to_string(count_by_resolved_dll(val)))
                    return
                }
            }
            println("usage: hexa run pe_iat_api_set_redirect.hexa count { api <api_set_kind> | dll <resolved_dll> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pasr()
            println("cleaned: " + pasr_dir())
            return
        }
        if sub == "dir" {
            println(pasr_dir())
            return
        }
    }
    println("usage: hexa run pe_iat_api_set_redirect.hexa { self-test | stats | dll <redirect_id> | count api <api_set_kind> | count dll <resolved_dll> | cleanup | dir }")
}
