// lib/loader/pe_token_privilege.hexa — cycle 74 Win32 token privilege adjust skeleton
//
// Win32 AdjustTokenPrivileges / LookupPrivilegeValueW telemetry — process
// access token 의 privilege 를 enable / disable 하는 op 를 추적. SeDebugPrivilege,
// SeTcbPrivilege, SeLockMemoryPrivilege, SeShutdownPrivilege, SeTimeZonePrivilege.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 privilege adjust tracker — 실 AdjustTokenPrivileges() 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// privilege_kind code:
//   1 = SeDebugPrivilege
//   2 = SeTcbPrivilege
//   3 = SeLockMemoryPrivilege
//   4 = SeShutdownPrivilege
//   5 = SeTimeZonePrivilege
//
// persist schema (TSV — adjusts.tsv):
//   adjust_id<int> \t privilege_kind<int> \t enabled<int> \t prior_enabled<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ptp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_token_privilege"
}

fn ptp_adjusts_path() -> str {
    return ptp_dir() + "/adjusts.tsv"
}

fn ptp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ptp_dir() + "'")
}

fn cleanup_ptp() -> void {
    ptp_ensure_dir()
    let _ = exec("rm -f '" + ptp_adjusts_path() + "'")
}

// ─── 공통 file IO ───
fn ptp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ptp_append_row(path: str, row: str) -> void {
    ptp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_adjust: privilege adjust 1 건 기록 ───
fn record_adjust(adjust_id: int, privilege_kind: int, enabled: int, prior_enabled: int) -> void {
    if adjust_id <= 0 {
        panic("pe_token_privilege FAIL [record_adjust] expected=adjust_id>0 got=" + to_string(adjust_id))
    }
    if privilege_kind < 1 {
        panic("pe_token_privilege FAIL [record_adjust] expected=privilege_kind>=1 got=" + to_string(privilege_kind))
    }
    if privilege_kind > 5 {
        panic("pe_token_privilege FAIL [record_adjust] expected=privilege_kind<=5 got=" + to_string(privilege_kind))
    }
    if enabled < 0 {
        panic("pe_token_privilege FAIL [record_adjust] expected=enabled>=0 got=" + to_string(enabled))
    }
    if enabled > 1 {
        panic("pe_token_privilege FAIL [record_adjust] expected=enabled<=1 got=" + to_string(enabled))
    }
    if prior_enabled < 0 {
        panic("pe_token_privilege FAIL [record_adjust] expected=prior_enabled>=0 got=" + to_string(prior_enabled))
    }
    if prior_enabled > 1 {
        panic("pe_token_privilege FAIL [record_adjust] expected=prior_enabled<=1 got=" + to_string(prior_enabled))
    }
    let row = to_string(adjust_id) + "\t" + to_string(privilege_kind)
        + "\t" + to_string(enabled) + "\t" + to_string(prior_enabled) + "\n"
    ptp_append_row(ptp_adjusts_path(), row)
}

// ─── adjust_count: total adjust 수 ───
fn adjust_count() -> int {
    let t = ptp_read_table(ptp_adjusts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── enabled_count: enabled=1 인 adjust 수 ───
fn enabled_count() -> int {
    let t = ptp_read_table(ptp_adjusts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_privilege: 특정 privilege_kind 의 adjust 수 ───
fn count_by_privilege(privilege_kind: int) -> int {
    let t = ptp_read_table(ptp_adjusts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == privilege_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── transition_count: enabled != prior_enabled 인 adjust 수 ───
fn transition_count() -> int {
    let t = ptp_read_table(ptp_adjusts_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) != to_int(parts[3]) {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── adjust_prior_enabled: 특정 adjust_id 의 prior_enabled (없으면 -1) ───
fn adjust_prior_enabled(adjust_id: int) -> int {
    let t = ptp_read_table(ptp_adjusts_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == adjust_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── ptp_stats: [adjust_count, enabled_count, transition_count, count_by_privilege(1)] ───
fn ptp_stats() -> array {
    let mut out = []
    out.push(adjust_count())
    out.push(enabled_count())
    out.push(transition_count())
    out.push(count_by_privilege(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ptp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ptp()

    // 2. record 5 adjusts across ≥3 privileges with ≥2 transitions
    //   id=140001 SeDebugPrivilege   enable  (prior=0 → enabled=1) transition
    //   id=140002 SeTcbPrivilege     enable  (prior=0 → enabled=1) transition
    //   id=140003 SeLockMemoryPriv   noop    (prior=1 → enabled=1)
    //   id=140004 SeDebugPrivilege   disable (prior=1 → enabled=0) transition
    //   id=140005 SeShutdownPriv     enable  (prior=0 → enabled=1) transition
    record_adjust(140001, 1, 1, 0)
    r0_emit("pe_token_privilege_record",
        "\"adjust_id\":140001,\"privilege_kind\":1,\"enabled\":1,\"prior_enabled\":0,\"target\":\"SeDebugPrivilege\"")

    record_adjust(140002, 2, 1, 0)
    r0_emit("pe_token_privilege_record",
        "\"adjust_id\":140002,\"privilege_kind\":2,\"enabled\":1,\"prior_enabled\":0,\"target\":\"SeTcbPrivilege\"")

    record_adjust(140003, 3, 1, 1)
    r0_emit("pe_token_privilege_record",
        "\"adjust_id\":140003,\"privilege_kind\":3,\"enabled\":1,\"prior_enabled\":1,\"target\":\"SeLockMemoryPrivilege\"")

    record_adjust(140004, 1, 0, 1)
    r0_emit("pe_token_privilege_record",
        "\"adjust_id\":140004,\"privilege_kind\":1,\"enabled\":0,\"prior_enabled\":1,\"target\":\"SeDebugPrivilege\"")

    record_adjust(140005, 4, 1, 0)
    r0_emit("pe_token_privilege_record",
        "\"adjust_id\":140005,\"privilege_kind\":4,\"enabled\":1,\"prior_enabled\":0,\"target\":\"SeShutdownPrivilege\"")

    // 3. adjust_count = 5
    let c = adjust_count()
    if c != 5 {
        panic("pe_token_privilege FAIL [adjust_count] expected=5 got=" + to_string(c))
    }

    // 4. enabled_count = 4 (id=140004 disabled)
    let ec = enabled_count()
    if ec != 4 {
        panic("pe_token_privilege FAIL [enabled_count] expected=4 got=" + to_string(ec))
    }

    // 5. count_by_privilege sanity
    let p1 = count_by_privilege(1)
    if p1 != 2 {
        panic("pe_token_privilege FAIL [count_by_privilege(1)] expected=2 got=" + to_string(p1))
    }
    let p2 = count_by_privilege(2)
    if p2 != 1 {
        panic("pe_token_privilege FAIL [count_by_privilege(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_privilege(3)
    if p3 != 1 {
        panic("pe_token_privilege FAIL [count_by_privilege(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_privilege(4)
    if p4 != 1 {
        panic("pe_token_privilege FAIL [count_by_privilege(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_privilege(5)
    if p5 != 0 {
        panic("pe_token_privilege FAIL [count_by_privilege(5)] expected=0 got=" + to_string(p5))
    }

    // 6. transition_count = 4 (140001/140002/140004/140005, 140003 노운)
    let tc = transition_count()
    if tc != 4 {
        panic("pe_token_privilege FAIL [transition_count] expected=4 got=" + to_string(tc))
    }

    // 7. adjust_prior_enabled sanity
    let pe1 = adjust_prior_enabled(140001)
    if pe1 != 0 {
        panic("pe_token_privilege FAIL [adjust_prior_enabled(140001)] expected=0 got=" + to_string(pe1))
    }
    let pe4 = adjust_prior_enabled(140004)
    if pe4 != 1 {
        panic("pe_token_privilege FAIL [adjust_prior_enabled(140004)] expected=1 got=" + to_string(pe4))
    }
    let pe_miss = adjust_prior_enabled(9999)
    if pe_miss != -1 {
        panic("pe_token_privilege FAIL [adjust_prior_enabled(9999)] expected=-1 got=" + to_string(pe_miss))
    }

    // 8. ptp_stats() = [5, 4, 4, 2]
    let s = ptp_stats()
    if len(s) != 4 {
        panic("pe_token_privilege FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_token_privilege FAIL [stats adjust_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_token_privilege FAIL [stats enabled_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_token_privilege FAIL [stats transition_count] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_token_privilege FAIL [stats count_priv(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_token_privilege_stats",
        "\"adjust_count\":" + to_string(s[0])
        + ",\"enabled_count\":" + to_string(s[1])
        + ",\"transition_count\":" + to_string(s[2])
        + ",\"priv_debug\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_token_privilege FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_ptp()
    let s2 = ptp_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_token_privilege FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_token_privilege self_test PASS (adjusts=" + to_string(s[0])
        + ", enabled=" + to_string(s[1]) + ", transitions=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ptp_stats()
            println("adjust_count\t" + to_string(s[0]))
            println("enabled_count\t" + to_string(s[1]))
            println("transition_count\t" + to_string(s[2]))
            println("count_priv_debug\t" + to_string(s[3]))
            return
        }
        if sub == "prior" {
            if len(a) >= 4 {
                let aid = to_int(a[3])
                println("adjust_prior_enabled\t" + to_string(adjust_prior_enabled(aid)))
                return
            }
            println("usage: hexa run pe_token_privilege.hexa prior <adjust_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_privilege\t" + to_string(count_by_privilege(pk)))
                return
            }
            println("usage: hexa run pe_token_privilege.hexa count <privilege_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ptp()
            println("cleaned: " + ptp_dir())
            return
        }
        if sub == "dir" {
            println(ptp_dir())
            return
        }
    }
    println("usage: hexa run pe_token_privilege.hexa { self-test | stats | prior <adjust_id> | count <privilege_kind> | cleanup | dir }")
}
