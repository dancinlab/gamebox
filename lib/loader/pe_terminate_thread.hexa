// lib/loader/pe_terminate_thread.hexa — cycle70 thread/process termination telemetry skeleton
//
// Tracks PE per-thread / per-process cleanup events: ExitThread, TerminateThread,
// ExitProcess, and natural process exit. Aggregates TLS callback execution count
// + nonzero exit_code rate for shutdown-path forensics.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 termination event tracker — 실 NtTerminateThread / RtlExitUserThread
//   / DllMain DLL_THREAD_DETACH 호출 X (stage6+).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// termination_kind code:
//   1 = exit_thread          (ExitThread / RtlExitUserThread — cooperative)
//   2 = terminate_thread     (TerminateThread — forced, no cleanup)
//   3 = exit_process         (ExitProcess / RtlExitUserProcess)
//   4 = process_exit_natural (main returned, runtime teardown)
//
// persist schema (TSV — terminations.tsv):
//   term_id<int> \t termination_kind<int> \t exit_code<int> \t tls_callbacks_run<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ptt_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_terminate_thread"
}

fn ptt_terminations_path() -> str {
    return ptt_dir() + "/terminations.tsv"
}

fn ptt_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ptt_dir() + "'")
}

fn cleanup_ptt() -> void {
    ptt_ensure_dir()
    let _ = exec("rm -f '" + ptt_terminations_path() + "'")
}

// ─── 공통 file IO ───
fn ptt_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ptt_append_row(path: str, row: str) -> void {
    ptt_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_termination: termination 1 건 기록 ───
fn record_termination(term_id: int, termination_kind: int, exit_code: int, tls_callbacks_run: int) -> void {
    if term_id <= 0 {
        panic("pe_terminate_thread FAIL [record_termination] expected=term_id>0 got=" + to_string(term_id))
    }
    if termination_kind < 1 {
        panic("pe_terminate_thread FAIL [record_termination] expected=termination_kind>=1 got=" + to_string(termination_kind))
    }
    if termination_kind > 4 {
        panic("pe_terminate_thread FAIL [record_termination] expected=termination_kind<=4 got=" + to_string(termination_kind))
    }
    if tls_callbacks_run < 0 {
        panic("pe_terminate_thread FAIL [record_termination] expected=tls_callbacks_run>=0 got=" + to_string(tls_callbacks_run))
    }
    let row = to_string(term_id) + "\t" + to_string(termination_kind)
        + "\t" + to_string(exit_code) + "\t" + to_string(tls_callbacks_run) + "\n"
    ptt_append_row(ptt_terminations_path(), row)
}

// ─── termination_count: total termination 수 ───
fn termination_count() -> int {
    let t = ptt_read_table(ptt_terminations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_kind: 특정 termination_kind 의 termination 수 ───
fn count_by_kind(kind: int) -> int {
    let t = ptt_read_table(ptt_terminations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_tls_callbacks: 모든 termination tls_callbacks_run 합 ───
fn total_tls_callbacks() -> int {
    let t = ptt_read_table(ptt_terminations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── nonzero_exit_count: exit_code != 0 인 termination 수 ───
fn nonzero_exit_count() -> int {
    let t = ptt_read_table(ptt_terminations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) != 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── term_exit_code: 특정 term_id 의 exit_code (없으면 0) ───
fn term_exit_code(term_id: int) -> int {
    let t = ptt_read_table(ptt_terminations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == term_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── ptt_stats: [termination_count, total_tls_callbacks, nonzero_exit_count, count_by_kind(2)] ───
fn ptt_stats() -> array {
    let mut out = []
    out.push(termination_count())
    out.push(total_tls_callbacks())
    out.push(nonzero_exit_count())
    out.push(count_by_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ptt-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ptt()

    // 2. record 5 terminations across ≥3 kinds with ≥2 nonzero exit_code
    record_termination(170001, 1, 0, 3)
    r0_emit("pe_terminate_thread_record",
        "\"term_id\":170001,\"termination_kind\":1,\"exit_code\":0,\"tls_callbacks_run\":3,\"target\":\"exit_thread\"")

    record_termination(170002, 2, 1, 0)
    r0_emit("pe_terminate_thread_record",
        "\"term_id\":170002,\"termination_kind\":2,\"exit_code\":1,\"tls_callbacks_run\":0,\"target\":\"terminate_thread\"")

    record_termination(170003, 3, 0, 5)
    r0_emit("pe_terminate_thread_record",
        "\"term_id\":170003,\"termination_kind\":3,\"exit_code\":0,\"tls_callbacks_run\":5,\"target\":\"exit_process\"")

    record_termination(170004, 2, 259, 0)
    r0_emit("pe_terminate_thread_record",
        "\"term_id\":170004,\"termination_kind\":2,\"exit_code\":259,\"tls_callbacks_run\":0,\"target\":\"terminate_thread\"")

    record_termination(170005, 4, 0, 4)
    r0_emit("pe_terminate_thread_record",
        "\"term_id\":170005,\"termination_kind\":4,\"exit_code\":0,\"tls_callbacks_run\":4,\"target\":\"process_exit_natural\"")

    // 3. termination_count = 5
    let c = termination_count()
    if c != 5 {
        panic("pe_terminate_thread FAIL [termination_count] expected=5 got=" + to_string(c))
    }

    // 4. total_tls_callbacks = 12 (3+0+5+0+4)
    let tt = total_tls_callbacks()
    if tt != 12 {
        panic("pe_terminate_thread FAIL [total_tls_callbacks] expected=12 got=" + to_string(tt))
    }

    // 5. count_by_kind sanity (kinds: 1,2,2,3,4 → covers ≥3 kinds)
    let k1 = count_by_kind(1)
    if k1 != 1 {
        panic("pe_terminate_thread FAIL [count_by_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_kind(2)
    if k2 != 2 {
        panic("pe_terminate_thread FAIL [count_by_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_kind(3)
    if k3 != 1 {
        panic("pe_terminate_thread FAIL [count_by_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_kind(4)
    if k4 != 1 {
        panic("pe_terminate_thread FAIL [count_by_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_kind(99)
    if k99 != 0 {
        panic("pe_terminate_thread FAIL [count_by_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. nonzero_exit_count = 2 (exit_code 1, 259)
    let nz = nonzero_exit_count()
    if nz != 2 {
        panic("pe_terminate_thread FAIL [nonzero_exit_count] expected=2 got=" + to_string(nz))
    }

    // 7. term_exit_code sanity
    let e2 = term_exit_code(170002)
    if e2 != 1 {
        panic("pe_terminate_thread FAIL [term_exit_code(170002)] expected=1 got=" + to_string(e2))
    }
    let e4 = term_exit_code(170004)
    if e4 != 259 {
        panic("pe_terminate_thread FAIL [term_exit_code(170004)] expected=259 got=" + to_string(e4))
    }
    let e_miss = term_exit_code(9999)
    if e_miss != 0 {
        panic("pe_terminate_thread FAIL [term_exit_code(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 8. ptt_stats() = [5, 12, 2, 2]
    let s = ptt_stats()
    if len(s) != 4 {
        panic("pe_terminate_thread FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_terminate_thread FAIL [stats termination_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 12 {
        panic("pe_terminate_thread FAIL [stats total_tls_callbacks] expected=12 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_terminate_thread FAIL [stats nonzero_exit_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_terminate_thread FAIL [stats count_kind(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_terminate_thread_stats",
        "\"termination_count\":" + to_string(s[0])
        + ",\"total_tls_callbacks\":" + to_string(s[1])
        + ",\"nonzero_exit_count\":" + to_string(s[2])
        + ",\"kind_terminate_thread\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_terminate_thread FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_ptt()
    let s2 = ptt_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_terminate_thread FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_terminate_thread self_test PASS (terminations=" + to_string(s[0])
        + ", tls_callbacks=" + to_string(s[1]) + ", nonzero_exit=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ptt_stats()
            println("termination_count\t" + to_string(s[0]))
            println("total_tls_callbacks\t" + to_string(s[1]))
            println("nonzero_exit_count\t" + to_string(s[2]))
            println("count_kind_terminate_thread\t" + to_string(s[3]))
            return
        }
        if sub == "exit" {
            if len(a) >= 4 {
                let tid = to_int(a[3])
                println("term_exit_code\t" + to_string(term_exit_code(tid)))
                return
            }
            println("usage: hexa run pe_terminate_thread.hexa exit <term_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_kind\t" + to_string(count_by_kind(kind)))
                return
            }
            println("usage: hexa run pe_terminate_thread.hexa count <termination_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ptt()
            println("cleaned: " + ptt_dir())
            return
        }
        if sub == "dir" {
            println(ptt_dir())
            return
        }
    }
    println("usage: hexa run pe_terminate_thread.hexa { self-test | stats | exit <term_id> | count <termination_kind> | cleanup | dir }")
}
