// lib/loader/win32_kernel32_extras.hexa — Phase 4n — Battle.net-Setup.exe 보강
//
// own 1: Wine 0. Microsoft kernel32 API spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe i386 PE 의 kernel32 imports 중 win32_kernel32.hexa
// base 에 없는 45 Win32 함수 추가 매핑 (skeleton stub level).
//
// 카테고리:
//   Resource (1):    SizeofResource
//   Event (2):       CreateEventA, SetEvent
//   Heap (4):        GetProcessHeap, HeapAlloc, HeapFree, GetCompressedFileSizeW
//   Time (4):        SystemTimeToFileTime, FileTimeToSystemTime, GetLocalTime, GetTickCount
//   Locale (3):      GetComputerNameW, GetUserDefaultLangID, GetOEMCP
//   String (1):      lstrcpynA, IsBadStringPtrA
//   File (5):        GetFileSize, DeleteFileA, GetTempPathA, GetVolumeInformationW, SetFilePointer
//   Module (4):      FreeLibrary, GetModuleHandleW, LoadLibraryW, GetProcAddress
//   CritSec (2):     DeleteCriticalSection, InitializeCriticalSectionEx
//   Exception (3):   RaiseException, DecodePointer, GetLastError
//   Console (2):     ReadConsoleA, SetConsoleMode
//   Toolhelp (4):    CreateToolhelp32Snapshot, Process32Next, Module32FirstW, Thread32First
//   Toolhelp2 (1):   Thread32Next
//   Thread (3):      GetThreadContext, SuspendThread, GetProcessId
//   Fiber (3):       ConvertFiberToThread, SwitchToFiber, DeleteFiber
//   Pipe (1):        SetNamedPipeHandleState
//   Sync (1):        CloseHandle (이미 base 에 있을 수 있음 — 중복 무해)
//
// macOS 매핑:
//   Heap → malloc/free
//   Time → time / gettimeofday
//   Locale → CFLocale
//   Module → dlopen/dlclose/dlsym
//   Toolhelp → libproc + sysctl (process enumeration)
//   Thread → pthread_*
//   Fiber → ucontext_t (deprecated POSIX)
//   Console → stdin/stdout
//   Exception → setjmp/longjmp + signal

use "../perf/r0_common"

fn extras_table() -> str {
    let t = ""
    // Resource (1)
    t = t + "SizeofResource\tCFBundleGetResourceSize\tResource\tskeleton\n"
    // Event (2)
    t = t + "CreateEventA\tdispatch_semaphore_create\tEvent\tskeleton\n"
    t = t + "SetEvent\tdispatch_semaphore_signal\tEvent\tskeleton\n"
    // Heap (4)
    t = t + "GetProcessHeap\tmalloc_default_zone\tHeap\tskeleton\n"
    t = t + "HeapAlloc\tmalloc\tHeap\tskeleton\n"
    t = t + "HeapFree\tfree\tHeap\tskeleton\n"
    t = t + "GetCompressedFileSizeW\tlstat\tHeap\tskeleton\n"
    // Time (4)
    t = t + "SystemTimeToFileTime\ttimegm\tTime\tskeleton\n"
    t = t + "FileTimeToSystemTime\tgmtime\tTime\tskeleton\n"
    t = t + "GetLocalTime\tlocaltime\tTime\tskeleton\n"
    t = t + "GetTickCount\tmach_absolute_time\tTime\tskeleton\n"
    // Locale (3)
    t = t + "GetComputerNameW\tgethostname\tLocale\tskeleton\n"
    t = t + "GetUserDefaultLangID\tCFLocale_getValue\tLocale\tskeleton\n"
    t = t + "GetOEMCP\tNSStringEncoding_macroman\tLocale\tskeleton\n"
    // String (2)
    t = t + "lstrcpynA\tstrlcpy\tString\tskeleton\n"
    t = t + "IsBadStringPtrA\tposix_madvise_check\tString\tskeleton\n"
    // File (5)
    t = t + "GetFileSize\tfstat\tFile\tskeleton\n"
    t = t + "DeleteFileA\tunlink\tFile\tskeleton\n"
    t = t + "GetTempPathA\tNSTemporaryDirectory\tFile\tskeleton\n"
    t = t + "GetVolumeInformationW\tstatfs\tFile\tskeleton\n"
    t = t + "SetFilePointer\tlseek\tFile\tskeleton\n"
    // Module (4)
    t = t + "FreeLibrary\tdlclose\tModule\tskeleton\n"
    t = t + "GetModuleHandleW\tdlopen_handle\tModule\tskeleton\n"
    t = t + "LoadLibraryW\tdlopen\tModule\tskeleton\n"
    t = t + "GetProcAddress\tdlsym\tModule\tskeleton\n"
    // CritSec (2)
    t = t + "DeleteCriticalSection\tpthread_mutex_destroy\tCritSec\tskeleton\n"
    t = t + "InitializeCriticalSectionEx\tpthread_mutex_init\tCritSec\tskeleton\n"
    // Exception (3)
    t = t + "RaiseException\tlongjmp\tException\tskeleton\n"
    t = t + "DecodePointer\tnoop_passthrough\tException\tskeleton\n"
    t = t + "GetLastError\terrno\tException\tskeleton\n"
    // Console (2)
    t = t + "ReadConsoleA\tread_stdin\tConsole\tskeleton\n"
    t = t + "SetConsoleMode\ttcsetattr\tConsole\tskeleton\n"
    // Toolhelp (5)
    t = t + "CreateToolhelp32Snapshot\tlibproc_listpids\tToolhelp\tskeleton\n"
    t = t + "Process32Next\tproc_pidpath_iter\tToolhelp\tskeleton\n"
    t = t + "Module32FirstW\tdyld_image_iter\tToolhelp\tskeleton\n"
    t = t + "Thread32First\ttask_threads\tToolhelp\tskeleton\n"
    t = t + "Thread32Next\ttask_threads_next\tToolhelp\tskeleton\n"
    // Thread (3)
    t = t + "GetThreadContext\tthread_get_state\tThread\tskeleton\n"
    t = t + "SuspendThread\tthread_suspend\tThread\tskeleton\n"
    t = t + "GetProcessId\tgetpid\tThread\tskeleton\n"
    // Fiber (3)
    t = t + "ConvertFiberToThread\tucontext_init\tFiber\tskeleton\n"
    t = t + "SwitchToFiber\tswapcontext\tFiber\tskeleton\n"
    t = t + "DeleteFiber\tucontext_free\tFiber\tskeleton\n"
    // Pipe (1)
    t = t + "SetNamedPipeHandleState\tfcntl_setfl\tPipe\tskeleton\n"
    return t
}

fn extras_table_size() -> int {
    let lines = extras_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = extras_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

fn function_macos_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" { return "" }
    let parts = m.split("\t")
    if len(parts) < 1 { return "" }
    return parts[0]
}

fn extras_stats() -> array {
    let cats = ["Resource", "Event", "Heap", "Time", "Locale", "String", "File", "Module", "CritSec", "Exception", "Console", "Toolhelp", "Thread", "Fiber", "Pipe"]
    let result = []
    let lines = extras_table().split("\n")
    let n = len(lines)
    let c = 0
    while c < len(cats) {
        let cat = cats[c]
        let total = 0
        let i = 0
        while i < n {
            if lines[i] != "" {
                let parts = lines[i].split("\t")
                if len(parts) >= 4 && parts[2] == cat {
                    total = total + 1
                }
            }
            i = i + 1
        }
        result = result + [[cat, total]]
        c = c + 1
    }
    return result
}

fn self_test() -> void {
    let sid = "kernel32extras-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = extras_table_size()
    if sz < 40 { panic("win32_kernel32_extras FAIL [size] expected>=40 got=" + to_string(sz)) }

    // category samples
    let m_heap = lookup_mapping("HeapAlloc")
    if !m_heap.contains("malloc") { panic("win32_kernel32_extras FAIL [HeapAlloc] got=" + m_heap) }

    let m_load = lookup_mapping("LoadLibraryW")
    if !m_load.contains("dlopen") { panic("win32_kernel32_extras FAIL [LoadLibraryW]") }

    let m_fiber = lookup_mapping("SwitchToFiber")
    if !m_fiber.contains("Fiber") { panic("win32_kernel32_extras FAIL [Fiber]") }

    let m_proc = lookup_mapping("CreateToolhelp32Snapshot")
    if !m_proc.contains("libproc") { panic("win32_kernel32_extras FAIL [Toolhelp]") }

    let unk = lookup_mapping("UnknownKernel32Func")
    if unk != "" { panic("win32_kernel32_extras FAIL [unknown]") }

    // stats
    let stats = extras_stats()
    if len(stats) != 15 { panic("win32_kernel32_extras FAIL [stats categories]") }
    let total = 0
    let i = 0
    while i < len(stats) {
        total = total + stats[i][1]
        i = i + 1
    }
    if total != sz { panic("win32_kernel32_extras FAIL [stats total mismatch]") }

    r0_emit("kernel32_extras_lookup", "\"name\":\"HeapAlloc\",\"macos\":\"" + function_macos_equiv("HeapAlloc") + "\"")
    r0_emit("kernel32_extras_stats", "\"functions\":" + to_string(sz) + ",\"categories\":15")

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("win32_kernel32_extras FAIL [emit count]") }

    println("  ✅ win32_kernel32_extras self_test PASS (" + to_string(sz) + " funcs / 15 categories — Battle.net-Setup boost, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_mapping(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
        if sub == "size" {
            println(to_string(extras_table_size()))
            return
        }
    }
    println("usage: hexa run win32_kernel32_extras.hexa { self-test | lookup <name> | size }")
}
