// lib/loader/pe_locale_info.hexa — cycle 79 GetLocaleInfoEx telemetry skeleton
//
// Win32 GetLocaleInfoEx / GetUserDefaultLocaleName → NSLocale bridge tracker.
// Win32 가 LCID + LCType 로 query 한 locale data 를 native helper 가 NSLocale
// 로 번역해 돌려주는 경로 — 본 module 은 query telemetry recorder.
//   record_query() 만 기록 — 실 GetLocaleInfoEx() / NSLocale 호출 X (stage6).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// lctype_kind code:
//   1 = ilanguage    (LOCALE_ILANGUAGE)
//   2 = scountry     (LOCALE_SCOUNTRY)
//   3 = scurrency    (LOCALE_SCURRENCY)
//   4 = sdate        (LOCALE_SSHORTDATE)
//   5 = stime        (LOCALE_STIMEFORMAT)
//   6 = imeasure     (LOCALE_IMEASURE)
//
// lcid sample:
//   1042 = ko-KR
//   1041 = ja-JP
//   2052 = zh-CN
//
// persist schema (TSV — queries.tsv):
//   query_id<int> \t lcid<int> \t lctype_kind<int> \t result_chars<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pli_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_locale_info"
}

fn pli_queries_path() -> str {
    return pli_dir() + "/queries.tsv"
}

fn pli_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pli_dir() + "'")
}

fn cleanup_pli() -> void {
    pli_ensure_dir()
    let _ = exec("rm -f '" + pli_queries_path() + "'")
}

// ─── 공통 file IO ───
fn pli_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pli_append_row(path: str, row: str) -> void {
    pli_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_query: locale query 1 건 기록 ───
fn record_query(query_id: int, lcid: int, lctype_kind: int, result_chars: int) -> void {
    if query_id <= 0 {
        panic("pe_locale_info FAIL [record_query] expected=query_id>0 got=" + to_string(query_id))
    }
    if lcid <= 0 {
        panic("pe_locale_info FAIL [record_query] expected=lcid>0 got=" + to_string(lcid))
    }
    if lctype_kind < 1 {
        panic("pe_locale_info FAIL [record_query] expected=lctype_kind>=1 got=" + to_string(lctype_kind))
    }
    if lctype_kind > 6 {
        panic("pe_locale_info FAIL [record_query] expected=lctype_kind<=6 got=" + to_string(lctype_kind))
    }
    if result_chars < 0 {
        panic("pe_locale_info FAIL [record_query] expected=result_chars>=0 got=" + to_string(result_chars))
    }
    let row = to_string(query_id) + "\t" + to_string(lcid)
        + "\t" + to_string(lctype_kind) + "\t" + to_string(result_chars) + "\n"
    pli_append_row(pli_queries_path(), row)
}

// ─── query_count: total query 수 ───
fn query_count() -> int {
    let t = pli_read_table(pli_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_result_chars: 모든 query result_chars 합 ───
fn total_result_chars() -> int {
    let t = pli_read_table(pli_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_lctype_kind: 특정 lctype_kind 의 query 수 ───
fn count_by_lctype_kind(kind: int) -> int {
    let t = pli_read_table(pli_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_lcids: 등장한 distinct lcid 수 ───
fn distinct_lcids() -> int {
    let t = pli_read_table(pli_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut seen = []
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let lcid = to_int(parts[1])
                let mut found = 0
                let j = 0
                while j < len(seen) {
                    if seen[j] == lcid {
                        found = 1
                    }
                    j = j + 1
                }
                if found == 0 {
                    seen.push(lcid)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── query_result_chars: 특정 query_id 의 result_chars (없으면 0) ───
fn query_result_chars(query_id: int) -> int {
    let t = pli_read_table(pli_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == query_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pli_stats: [query_count, total_result_chars, distinct_lcids, count_by_lctype_kind(2)] ───
fn pli_stats() -> array {
    let mut out = []
    out.push(query_count())
    out.push(total_result_chars())
    out.push(distinct_lcids())
    out.push(count_by_lctype_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pli-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pli()

    // 2. record 5 queries — 4 lctype_kinds(1,2,3,4) × 3 lcids(1042,1041,2052)
    record_query(120001, 1042, 1, 4)
    r0_emit("pe_locale_info_record",
        "\"query_id\":120001,\"lcid\":1042,\"lctype_kind\":1,\"result_chars\":4,\"target\":\"ilanguage\"")

    record_query(120002, 1042, 2, 11)
    r0_emit("pe_locale_info_record",
        "\"query_id\":120002,\"lcid\":1042,\"lctype_kind\":2,\"result_chars\":11,\"target\":\"scountry\"")

    record_query(120003, 1041, 3, 3)
    r0_emit("pe_locale_info_record",
        "\"query_id\":120003,\"lcid\":1041,\"lctype_kind\":3,\"result_chars\":3,\"target\":\"scurrency\"")

    record_query(120004, 1041, 2, 5)
    r0_emit("pe_locale_info_record",
        "\"query_id\":120004,\"lcid\":1041,\"lctype_kind\":2,\"result_chars\":5,\"target\":\"scountry\"")

    record_query(120005, 2052, 4, 10)
    r0_emit("pe_locale_info_record",
        "\"query_id\":120005,\"lcid\":2052,\"lctype_kind\":4,\"result_chars\":10,\"target\":\"sdate\"")

    // 3. query_count = 5
    let c = query_count()
    if c != 5 {
        panic("pe_locale_info FAIL [query_count] expected=5 got=" + to_string(c))
    }

    // 4. total_result_chars = 4+11+3+5+10 = 33
    let tc = total_result_chars()
    if tc != 33 {
        panic("pe_locale_info FAIL [total_result_chars] expected=33 got=" + to_string(tc))
    }

    // 5. count_by_lctype_kind sanity
    let k1 = count_by_lctype_kind(1)
    if k1 != 1 {
        panic("pe_locale_info FAIL [count_by_lctype_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_lctype_kind(2)
    if k2 != 2 {
        panic("pe_locale_info FAIL [count_by_lctype_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_lctype_kind(3)
    if k3 != 1 {
        panic("pe_locale_info FAIL [count_by_lctype_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_lctype_kind(4)
    if k4 != 1 {
        panic("pe_locale_info FAIL [count_by_lctype_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_lctype_kind(5)
    if k5 != 0 {
        panic("pe_locale_info FAIL [count_by_lctype_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_lctype_kind(6)
    if k99 != 0 {
        panic("pe_locale_info FAIL [count_by_lctype_kind(6)] expected=0 got=" + to_string(k99))
    }

    // 6. distinct_lcids = 3 (1042, 1041, 2052)
    let d = distinct_lcids()
    if d != 3 {
        panic("pe_locale_info FAIL [distinct_lcids] expected=3 got=" + to_string(d))
    }

    // 7. query_result_chars sanity
    let r2 = query_result_chars(120002)
    if r2 != 11 {
        panic("pe_locale_info FAIL [query_result_chars(120002)] expected=11 got=" + to_string(r2))
    }
    let r5 = query_result_chars(120005)
    if r5 != 10 {
        panic("pe_locale_info FAIL [query_result_chars(120005)] expected=10 got=" + to_string(r5))
    }
    let r_miss = query_result_chars(9999)
    if r_miss != 0 {
        panic("pe_locale_info FAIL [query_result_chars(9999)] expected=0 got=" + to_string(r_miss))
    }

    // 8. pli_stats() = [5, 33, 3, 2]
    let s = pli_stats()
    if len(s) != 4 {
        panic("pe_locale_info FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_locale_info FAIL [stats query_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 33 {
        panic("pe_locale_info FAIL [stats total_result_chars] expected=33 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_locale_info FAIL [stats distinct_lcids] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_locale_info FAIL [stats count_kind(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_locale_info_stats",
        "\"query_count\":" + to_string(s[0])
        + ",\"total_result_chars\":" + to_string(s[1])
        + ",\"distinct_lcids\":" + to_string(s[2])
        + ",\"kind_scountry\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_locale_info FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pli()
    let s2 = pli_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_locale_info FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_locale_info self_test PASS (queries=" + to_string(s[0])
        + ", chars=" + to_string(s[1]) + ", lcids=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pli_stats()
            println("query_count\t" + to_string(s[0]))
            println("total_result_chars\t" + to_string(s[1]))
            println("distinct_lcids\t" + to_string(s[2]))
            println("count_kind_scountry\t" + to_string(s[3]))
            return
        }
        if sub == "chars" {
            if len(a) >= 4 {
                let qid = to_int(a[3])
                println("query_result_chars\t" + to_string(query_result_chars(qid)))
                return
            }
            println("usage: hexa run pe_locale_info.hexa chars <query_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_lctype_kind\t" + to_string(count_by_lctype_kind(kind)))
                return
            }
            println("usage: hexa run pe_locale_info.hexa count <lctype_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pli()
            println("cleaned: " + pli_dir())
            return
        }
        if sub == "dir" {
            println(pli_dir())
            return
        }
    }
    println("usage: hexa run pe_locale_info.hexa { self-test | stats | chars <query_id> | count <lctype_kind> | cleanup | dir }")
}
