// lib/loader/pe_setupapi_core.hexa — SETUPAPI.dll device installer surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine setupapi source 측 코드 인용 0. setupapi.dll 직접 binding 0. macOS IOKit /
//       IORegistry / NSFileManager INF parser / kext loader 직접 binding 0. NOTE: SETUPAPI
//       는 D2R/D4 installer + Battle.net Update Agent 측 device install / driver enumeration /
//       INF file parse surface, 본 module 측 HDEVINFO + SP_DEVINFO_DATA + HINF struct
//       round-trip baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH/AM parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AM4 — SETUPAPI (setupapi.dll) device installer surface coverage 10 fn (skeleton row 만).
// Track AM3 predecessor (IMM32 10 fn cycle 42) 후 본 Track AM4 는 SETUPAPI 측 devinfo +
// driver + INF baseline land. cycle 42 측 208/435 (~47.82%) → cycle 43 측 ~218/435
// (~50.11%) coverage progression (+10 fn 신규, Track AM bundled cycle 40-43 측 AM4 row,
// 마지막 row, **50% threshold breach milestone**).
//
// 대상 fn (10 fn — 3 group, fn_kind 0..9 canonical map):
//   DEVINFO  (4): SetupDiCreateDeviceInfoList(0) / SetupDiDestroyDeviceInfoList(1) /
//                 SetupDiEnumDeviceInfo(2) / SetupDiGetDeviceRegistryPropertyW(3)
//   DRIVER   (3): SetupDiBuildDriverInfoList(4) / SetupDiGetDriverInfoDetailW(5) /
//                 SetupDiCallClassInstaller(6)
//   INF      (3): SetupOpenInfFileW(7) / SetupGetLineByIndexW(8) / SetupCloseInfFile(9)
//
// synthetic struct families:
//   HDEVINFO handle 0x97010000 (device info set, opaque pointer)
//   SP_DEVINFO_DATA 32 byte: cbSize 32 + ClassGuid 16-byte (GUID_DEVCLASS_DISPLAY synth) +
//     DevInst 0x00000A1B + Reserved 0.
//   HINF handle 0x97020000 (INF file parser handle, opaque)
//   SP_DRVINFO_DATA_W 1606 byte (truncated to header 36-byte: cbSize 1606 + DriverType 0x01
//     SPDIT_CLASSDRIVER + Reserved 0 + Description WCHAR[256] + MfgName WCHAR[256] +
//     ProviderName WCHAR[256] + DriverDate FILETIME 8 + DriverVersion ULARGE_INTEGER 8).
//   GUID_DEVCLASS_DISPLAY (16 byte LE): "4D36E968-E325-11CE-BFC1-08002BE10318"
//   GUID_DEVCLASS_NET     (16 byte LE): "4D36E972-E325-11CE-BFC1-08002BE10318"
//   INFCONTEXT 24 byte: Inf 0x97020000 + CurrentInf 0x97020000 + Section 0 + Line 5 +
//     Reserved 0.
//
// persist schema (TSV — 4 table): syscall_invoke / devinfo_event / driver_event / inf_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn psa_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_setupapi_core"
}

fn psa_syscall_invoke_path() -> str {
    return psa_dir() + "/syscall_invoke.tsv"
}

fn psa_devinfo_event_path() -> str {
    return psa_dir() + "/devinfo_event.tsv"
}

fn psa_driver_event_path() -> str {
    return psa_dir() + "/driver_event.tsv"
}

fn psa_inf_event_path() -> str {
    return psa_dir() + "/inf_event.tsv"
}

fn psa_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + psa_dir() + "'")
}

fn cleanup_psa() -> void {
    psa_ensure_dir()
    let _ = exec("rm -f '" + psa_syscall_invoke_path() + "' '" + psa_devinfo_event_path()
        + "' '" + psa_driver_event_path() + "' '" + psa_inf_event_path() + "'")
}

// ─── 공통 file IO ───
fn psa_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn psa_append_row(path: str, row: str) -> void {
    psa_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn psa_count_rows(path: str, min_cols: int) -> int {
    let t = psa_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "SetupDiCreateDeviceInfoList" }
    if k == 1 { return "SetupDiDestroyDeviceInfoList" }
    if k == 2 { return "SetupDiEnumDeviceInfo" }
    if k == 3 { return "SetupDiGetDeviceRegistryPropertyW" }
    if k == 4 { return "SetupDiBuildDriverInfoList" }
    if k == 5 { return "SetupDiGetDriverInfoDetailW" }
    if k == 6 { return "SetupDiCallClassInstaller" }
    if k == 7 { return "SetupOpenInfFileW" }
    if k == 8 { return "SetupGetLineByIndexW" }
    if k == 9 { return "SetupCloseInfFile" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "devinfo"
        }
    }
    if k >= 4 {
        if k <= 6 {
            return "driver"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "inf"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: SETUPAPI fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_setupapi_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_setupapi_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_setupapi_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_setupapi_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_setupapi_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    psa_append_row(psa_syscall_invoke_path(), row)
}

