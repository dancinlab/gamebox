// ─── statistics ───
fn syscall_invoke_count() -> int {
    return psa_count_rows(psa_syscall_invoke_path(), 4)
}

fn devinfo_event_count() -> int {
    return psa_count_rows(psa_devinfo_event_path(), 5)
}

fn driver_event_count() -> int {
    return psa_count_rows(psa_driver_event_path(), 5)
}

fn inf_event_count() -> int {
    return psa_count_rows(psa_inf_event_path(), 5)
}

fn psa_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(devinfo_event_count())
    out.push(driver_event_count())
    out.push(inf_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "psa-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_psa()

    // ─── 1. syscall_invoke × 10 (one per fn, 3 group coverage) ───
    //   DEVINFO group (4)
    record_syscall_invoke(1, 0, "SetupDiCreateDeviceInfoList", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupDiCreateDeviceInfoList")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"SetupDiCreateDeviceInfoList\",\"fn_group\":\"devinfo\",\"status\":\"PARTIAL\",\"ClassGuid\":\"GUID_DEVCLASS_DISPLAY_4D36E968\",\"hwnd_parent\":0,\"hdevinfo_out_hex\":\"0x97010000\"")
    record_syscall_invoke(2, 1, "SetupDiDestroyDeviceInfoList", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupDiDestroyDeviceInfoList")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"SetupDiDestroyDeviceInfoList\",\"fn_group\":\"devinfo\",\"status\":\"PARTIAL\",\"hdevinfo_hex\":\"0x97010000\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(3, 2, "SetupDiEnumDeviceInfo", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupDiEnumDeviceInfo")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"SetupDiEnumDeviceInfo\",\"fn_group\":\"devinfo\",\"status\":\"PARTIAL\",\"hdevinfo_hex\":\"0x97010000\",\"member_index\":0,\"sp_devinfo_data_out_hex\":\"0x97010100\",\"struct_bytes\":32,\"DevInst\":\"0x00000A1B\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(4, 3, "SetupDiGetDeviceRegistryPropertyW", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupDiGetDeviceRegistryPropertyW")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"SetupDiGetDeviceRegistryPropertyW\",\"fn_group\":\"devinfo\",\"status\":\"PARTIAL\",\"hdevinfo_hex\":\"0x97010000\",\"sp_devinfo_data_hex\":\"0x97010100\",\"Property\":\"SPDRP_FRIENDLYNAME_0x0000000C\",\"PropertyRegDataType\":\"REG_SZ_1\",\"PropertyBuffer_synth\":\"WCHAR_Apple_M_series_Display\",\"PropertyBufferSize\":64,\"return_bool\":\"TRUE_1\"")

    //   DRIVER group (3)
    record_syscall_invoke(5, 4, "SetupDiBuildDriverInfoList", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupDiBuildDriverInfoList")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"SetupDiBuildDriverInfoList\",\"fn_group\":\"driver\",\"status\":\"PARTIAL\",\"hdevinfo_hex\":\"0x97010000\",\"sp_devinfo_data_hex\":\"0x97010100\",\"DriverType\":\"SPDIT_CLASSDRIVER_1\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(6, 5, "SetupDiGetDriverInfoDetailW", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupDiGetDriverInfoDetailW")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"SetupDiGetDriverInfoDetailW\",\"fn_group\":\"driver\",\"status\":\"PARTIAL\",\"hdevinfo_hex\":\"0x97010000\",\"sp_devinfo_data_hex\":\"0x97010100\",\"sp_drvinfo_data_synth\":\"SP_DRVINFO_DATA_W_1606B_truncated\",\"struct_bytes\":1606,\"InfFileName_synth\":\"display.inf\",\"DriverDescription\":\"Apple_M_series_Display_Driver\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(7, 6, "SetupDiCallClassInstaller", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupDiCallClassInstaller")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"SetupDiCallClassInstaller\",\"fn_group\":\"driver\",\"status\":\"PARTIAL\",\"hdevinfo_hex\":\"0x97010000\",\"sp_devinfo_data_hex\":\"0x97010100\",\"InstallFunction\":\"DIF_INSTALLDEVICE_0x000000C2\",\"return_bool\":\"TRUE_1\"")

    //   INF group (3)
    record_syscall_invoke(8, 7, "SetupOpenInfFileW", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupOpenInfFileW")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"SetupOpenInfFileW\",\"fn_group\":\"inf\",\"status\":\"PARTIAL\",\"FileName_synth\":\"C__Windows__INF__display.inf\",\"InfClass\":\"NULL_class_default\",\"InfStyle\":\"INF_STYLE_WIN4_0x00000002\",\"hinf_out_hex\":\"0x97020000\",\"ErrorLine_out\":0")
    record_syscall_invoke(9, 8, "SetupGetLineByIndexW", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupGetLineByIndexW")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"SetupGetLineByIndexW\",\"fn_group\":\"inf\",\"status\":\"PARTIAL\",\"hinf_hex\":\"0x97020000\",\"Section_synth\":\"Manufacturer\",\"Index\":5,\"infcontext_out_hex\":\"0x97020100\",\"struct_bytes\":24,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(10, 9, "SetupCloseInfFile", "PARTIAL")
    println("__SETUPAPI__ PARTIAL SetupCloseInfFile")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"SetupCloseInfFile\",\"fn_group\":\"inf\",\"status\":\"PARTIAL\",\"hinf_hex\":\"0x97020000\",\"void_return\":true")

    // ─── 2. devinfo_event × 4 (create/destroy/enum/get_property) ───
    record_devinfo_event(1, "create_display_class", "0x97010000", "GUID_DEVCLASS_DISPLAY_4D36E968", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"devinfo_event\",\"evt_id\":1,\"d_kind\":\"create_display_class\",\"hdevinfo_hex\":\"0x97010000\",\"devinfo_synth\":\"GUID_DEVCLASS_DISPLAY_4D36E968\",\"class_guid_bytes\":16,\"status\":\"PARTIAL\"")
    record_devinfo_event(2, "destroy_release", "0x97010000", "release_no_devinfo", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"devinfo_event\",\"evt_id\":2,\"d_kind\":\"destroy_release\",\"hdevinfo_hex\":\"0x97010000\",\"devinfo_synth\":\"release_no_devinfo\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_devinfo_event(3, "enum_member_index_0", "0x97010000", "SP_DEVINFO_DATA_32B_DevInst_0x00000A1B", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"devinfo_event\",\"evt_id\":3,\"d_kind\":\"enum_member_index_0\",\"hdevinfo_hex\":\"0x97010000\",\"devinfo_synth\":\"SP_DEVINFO_DATA_32B_DevInst_0x00000A1B\",\"member_index\":0,\"struct_bytes\":32,\"DevInst\":\"0x00000A1B\",\"status\":\"PARTIAL\"")
    record_devinfo_event(4, "get_registry_property_friendly_name", "0x97010000", "WCHAR_Apple_M_series_Display_64B", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"devinfo_event\",\"evt_id\":4,\"d_kind\":\"get_registry_property_friendly_name\",\"hdevinfo_hex\":\"0x97010000\",\"devinfo_synth\":\"WCHAR_Apple_M_series_Display_64B\",\"Property\":\"SPDRP_FRIENDLYNAME\",\"RegDataType\":\"REG_SZ\",\"BufferSize\":64,\"status\":\"PARTIAL\"")

    // ─── 3. driver_event × 3 (build_list/get_detail/call_installer) ───
    record_driver_event(1, "build_classdriver_list", "0x97010000", "SPDIT_CLASSDRIVER_1", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"driver_event\",\"evt_id\":1,\"d_kind\":\"build_classdriver_list\",\"hdevinfo_hex\":\"0x97010000\",\"drv_synth\":\"SPDIT_CLASSDRIVER_1\",\"DriverType\":\"SPDIT_CLASSDRIVER\",\"status\":\"PARTIAL\"")
    record_driver_event(2, "get_driver_detail_apple_display", "0x97010000", "SP_DRVINFO_DATA_W_1606B_truncated", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"driver_event\",\"evt_id\":2,\"d_kind\":\"get_driver_detail_apple_display\",\"hdevinfo_hex\":\"0x97010000\",\"drv_synth\":\"SP_DRVINFO_DATA_W_1606B_truncated\",\"struct_bytes\":1606,\"InfFileName\":\"display.inf\",\"DriverDescription\":\"Apple_M_series_Display_Driver\",\"status\":\"PARTIAL\"")
    record_driver_event(3, "call_class_installer_DIF_INSTALLDEVICE", "0x97010000", "DIF_INSTALLDEVICE_0x000000C2", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"driver_event\",\"evt_id\":3,\"d_kind\":\"call_class_installer_DIF_INSTALLDEVICE\",\"hdevinfo_hex\":\"0x97010000\",\"drv_synth\":\"DIF_INSTALLDEVICE_0x000000C2\",\"InstallFunction\":\"DIF_INSTALLDEVICE\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")

    // ─── 4. inf_event × 3 (open/get_line/close) ───
    record_inf_event(1, "open_display_inf", "0x97020000", "C__Windows__INF__display.inf", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"inf_event\",\"evt_id\":1,\"i_kind\":\"open_display_inf\",\"hinf_hex\":\"0x97020000\",\"inf_synth\":\"C__Windows__INF__display.inf\",\"InfStyle\":\"INF_STYLE_WIN4\",\"ErrorLine\":0,\"status\":\"PARTIAL\"")
    record_inf_event(2, "get_line_manufacturer_index_5", "0x97020000", "INFCONTEXT_24B_Section_Manufacturer_Line_5", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"inf_event\",\"evt_id\":2,\"i_kind\":\"get_line_manufacturer_index_5\",\"hinf_hex\":\"0x97020000\",\"inf_synth\":\"INFCONTEXT_24B_Section_Manufacturer_Line_5\",\"struct_bytes\":24,\"section\":\"Manufacturer\",\"line_index\":5,\"status\":\"PARTIAL\"")
    record_inf_event(3, "close_inf_release", "0x97020000", "release_no_inf", "PARTIAL")
    r0_emit("pe_setupapi_core_record", "\"kind\":\"inf_event\",\"evt_id\":3,\"i_kind\":\"close_inf_release\",\"hinf_hex\":\"0x97020000\",\"inf_synth\":\"release_no_inf\",\"void_return\":true,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_setupapi_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let de = devinfo_event_count()
    if de != 4 {
        panic("pe_setupapi_core FAIL [devinfo_event_count] expected=4 got=" + to_string(de))
    }
    let dre = driver_event_count()
    if dre != 3 {
        panic("pe_setupapi_core FAIL [driver_event_count] expected=3 got=" + to_string(dre))
    }
    let ie = inf_event_count()
    if ie != 3 {
        panic("pe_setupapi_core FAIL [inf_event_count] expected=3 got=" + to_string(ie))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "SetupDiCreateDeviceInfoList" { panic("pe_setupapi_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "SetupDiEnumDeviceInfo" { panic("pe_setupapi_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(4) != "SetupDiBuildDriverInfoList" { panic("pe_setupapi_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(7) != "SetupOpenInfFileW" { panic("pe_setupapi_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(9) != "SetupCloseInfFile" { panic("pe_setupapi_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_setupapi_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "devinfo" { panic("pe_setupapi_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "driver" { panic("pe_setupapi_core FAIL [fn_group_name(4)]") }
    if fn_group_name(7) != "inf" { panic("pe_setupapi_core FAIL [fn_group_name(7)]") }
    if fn_group_name(99) != "unknown" { panic("pe_setupapi_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = psa_stats()
    if len(s) != 4 { panic("pe_setupapi_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_setupapi_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_setupapi_core FAIL [stats devinfo_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_setupapi_core FAIL [stats driver_event_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_setupapi_core FAIL [stats inf_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_setupapi_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"devinfo_event_count\":" + to_string(s[1])
        + ",\"driver_event_count\":" + to_string(s[2])
        + ",\"inf_event_count\":" + to_string(s[3]))

    r0_emit("pe_setupapi_core_summary",
        "\"target\":\"SETUPAPI.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"devinfo\",\"driver\",\"inf\"],\"sp_devinfo_data_synth_bytes\":32,\"sp_drvinfo_data_synth_bytes\":1606,\"infcontext_synth_bytes\":24,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\",\"50pct_threshold_breach\":true")

    r0_emit("pe_setupapi_core_kpi",
        "\"devinfo_emits\":4,\"driver_emits\":3,\"inf_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_d4_installer_baseline\":true,\"battlenet_update_agent_baseline\":true,\"iokit_ioregistry_kext_loader_binding\":false")

    // ─── cycle 42 → 43 SETUPAPI coverage progression evidence emit (50% threshold breach) ───
    r0_emit("pe_setupapi_core_coverage_progression",
        "\"surface\":\"SETUPAPI_full_435_fn\",\"cycle_42_count\":208,\"cycle_43_count\":218,\"delta\":10,\"cycle_42_percent\":47.82,\"cycle_43_percent\":50.11,\"cycle_43_module\":\"pe_setupapi_core.hexa\",\"50pct_threshold_breached\":true,\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_am4_cycle_increment\":10,\"track_am_bundled_part_4_of_4\":true,\"track_am_bundled_total_delta\":42")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_setupapi_core_round_trip_matrix",
        "\"surface\":\"SETUPAPI_core_10_fn\",\"fn_partial\":10,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real SetupDiEnumDeviceInfo + SetupDiCallClassInstaller + SetupOpenInfFileW = IOKit IORegistry + kext loader + INF parser bridge pending separate cycle (long-horizon)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"50pct_threshold_breached\":\"cycle 43 = 218/435 (50.11%) — Track AM milestone\"")

    // ─── Track AM4 expansion emit (cycle 43, SETUPAPI +10 fn) ───
    r0_emit("pe_setupapi_core_am4_expansion",
        "\"track\":\"AM4\",\"cycle\":43,\"surface\":\"SETUPAPI_new\",\"new_fn\":10,\"groups\":[\"devinfo\",\"driver\",\"inf\"],\"devinfo_count\":4,\"driver_count\":3,\"inf_count\":3,\"emit_format\":\"__SETUPAPI__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_3_evidence_augment\":true,\"track_am_bundled_part_4_of_4\":true,\"track_am_bundled_complete\":true,\"50pct_threshold_breached\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_setupapi_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_psa()
    let s2 = psa_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_setupapi_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_setupapi_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", devinfo_event=" + to_string(s[1])
        + ", driver_event=" + to_string(s[2]) + ", inf_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = psa_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("devinfo_event_count\t" + to_string(s[1]))
            println("driver_event_count\t" + to_string(s[2]))
            println("inf_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_setupapi_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_setupapi_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_psa()
            println("cleaned: " + psa_dir())
            return
        }
        if sub == "dir" {
            println(psa_dir())
            return
        }
    }
    println("usage: hexa run pe_setupapi_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
