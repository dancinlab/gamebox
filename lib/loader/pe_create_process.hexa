// lib/loader/pe_create_process.hexa — cycle 74 Win32 CreateProcessW telemetry skeleton
//
// Win32 CreateProcessW 호출 추적 — lpProcessInformation 의 hProcess / hThread /
// dwProcessId / dwThreadId 4-tuple + dwCreationFlags bitmask 를 TSV 로 기록.
// 본 module 은 syscall 기록기 — 실 CreateProcessW 호출은 native bridge 단계.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// dwCreationFlags 주요 bit (Microsoft Win32 doc):
//   0x00000001 = DEBUG_PROCESS              (PROCESS-wide debug; bit 0)
//   0x00000002 = DEBUG_ONLY_THIS_PROCESS    (this only)
//   0x00000004 = CREATE_SUSPENDED           (primary thread suspended)
//   0x00000008 = DETACHED_PROCESS           (no console inherit)
//   0x00000010 = CREATE_NEW_CONSOLE
//   0x00000200 = CREATE_NEW_PROCESS_GROUP
//
// persist schema (TSV — creates.tsv):
//   create_id<int> \t creation_flags<int> \t process_id<int> \t thread_id<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pcp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_create_process"
}

fn pcp_creates_path() -> str {
    return pcp_dir() + "/creates.tsv"
}

fn pcp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pcp_dir() + "'")
}

fn cleanup_pcp() -> void {
    pcp_ensure_dir()
    let _ = exec("rm -f '" + pcp_creates_path() + "'")
}

// ─── 공통 file IO ───
fn pcp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pcp_append_row(path: str, row: str) -> void {
    pcp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_create: CreateProcessW 호출 1 건 기록 ───
fn record_create(create_id: int, creation_flags: int, process_id: int, thread_id: int) -> void {
    if create_id <= 0 {
        panic("pe_create_process FAIL [record_create] expected=create_id>0 got=" + to_string(create_id))
    }
    if creation_flags < 0 {
        panic("pe_create_process FAIL [record_create] expected=creation_flags>=0 got=" + to_string(creation_flags))
    }
    if process_id <= 0 {
        panic("pe_create_process FAIL [record_create] expected=process_id>0 got=" + to_string(process_id))
    }
    if thread_id <= 0 {
        panic("pe_create_process FAIL [record_create] expected=thread_id>0 got=" + to_string(thread_id))
    }
    let row = to_string(create_id) + "\t" + to_string(creation_flags)
        + "\t" + to_string(process_id) + "\t" + to_string(thread_id) + "\n"
    pcp_append_row(pcp_creates_path(), row)
}

// ─── create_count: total create 수 ───
fn create_count() -> int {
    let t = pcp_read_table(pcp_creates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_creation_flags: 모든 row 의 creation_flags 합 ───
fn total_creation_flags() -> int {
    let t = pcp_read_table(pcp_creates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_flag_bit: (creation_flags AND bit_mask) != 0 인 row 수 ───
fn count_by_flag_bit(bit_mask: int) -> int {
    let t = pcp_read_table(pcp_creates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let flags = to_int(parts[1])
                if (flags & bit_mask) != 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_processes: 고유한 process_id 개수 ───
fn distinct_processes() -> int {
    let t = pcp_read_table(pcp_creates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let pid = to_int(parts[2])
                let m = len(seen)
                let j = 0
                let mut found = 0
                while j < m {
                    if seen[j] == pid {
                        found = 1
                    }
                    j = j + 1
                }
                if found == 0 {
                    seen.push(pid)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── distinct_threads: 고유한 thread_id 개수 ───
fn distinct_threads() -> int {
    let t = pcp_read_table(pcp_creates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let tid = to_int(parts[3])
                let m = len(seen)
                let j = 0
                let mut found = 0
                while j < m {
                    if seen[j] == tid {
                        found = 1
                    }
                    j = j + 1
                }
                if found == 0 {
                    seen.push(tid)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── create_process_id: 특정 create_id 의 process_id (없으면 0) ───
fn create_process_id(create_id: int) -> int {
    let t = pcp_read_table(pcp_creates_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == create_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pcp_stats: [create_count, total_creation_flags, distinct_processes, distinct_threads] ───
fn pcp_stats() -> array {
    let mut out = []
    out.push(create_count())
    out.push(total_creation_flags())
    out.push(distinct_processes())
    out.push(distinct_threads())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pcp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pcp()

    // 2. record 5 CreateProcessW calls (deterministic synthetic)
    //    flag bits: 0x01=DEBUG_PROCESS, 0x02=DEBUG_ONLY_THIS_PROCESS,
    //    0x04=CREATE_SUSPENDED, 0x08=DETACHED_PROCESS, 0x200=NEW_PROCESS_GROUP
    //    PIDs: 4001, 4002, 4003, 4001, 4004 → 4 distinct
    //    TIDs: 5001, 5002, 5003, 5004, 5005 → 5 distinct

    record_create(740001, 0x04, 4001, 5001)         // SUSPENDED
    r0_emit("pe_create_process_record",
        "\"create_id\":740001,\"creation_flags\":4,\"process_id\":4001,\"thread_id\":5001,\"target\":\"suspended\"")

    record_create(740002, 0x02, 4002, 5002)         // DEBUG_ONLY_THIS_PROCESS
    r0_emit("pe_create_process_record",
        "\"create_id\":740002,\"creation_flags\":2,\"process_id\":4002,\"thread_id\":5002,\"target\":\"debug_only_this\"")

    record_create(740003, 0x01, 4003, 5003)         // DEBUG_PROCESS
    r0_emit("pe_create_process_record",
        "\"create_id\":740003,\"creation_flags\":1,\"process_id\":4003,\"thread_id\":5003,\"target\":\"debug_process\"")

    record_create(740004, 0x0C, 4001, 5004)         // SUSPENDED | DETACHED (4|8=12)
    r0_emit("pe_create_process_record",
        "\"create_id\":740004,\"creation_flags\":12,\"process_id\":4001,\"thread_id\":5004,\"target\":\"suspended_detached\"")

    record_create(740005, 0x200, 4004, 5005)        // NEW_PROCESS_GROUP
    r0_emit("pe_create_process_record",
        "\"create_id\":740005,\"creation_flags\":512,\"process_id\":4004,\"thread_id\":5005,\"target\":\"new_pgroup\"")

    // 3. create_count = 5
    let c = create_count()
    if c != 5 {
        panic("pe_create_process FAIL [create_count] expected=5 got=" + to_string(c))
    }

    // 4. total_creation_flags = 4 + 2 + 1 + 12 + 512 = 531
    let tf = total_creation_flags()
    if tf != 531 {
        panic("pe_create_process FAIL [total_creation_flags] expected=531 got=" + to_string(tf))
    }

    // 5. count_by_flag_bit sanity
    //    0x04 (SUSPENDED) → rows 1, 4 → 2
    //    0x08 (DETACHED) → row 4 → 1
    //    0x02 (DEBUG_ONLY) → row 2 → 1
    //    0x01 (DEBUG_PROCESS) → row 3 → 1
    //    0x200 (NEW_PGROUP) → row 5 → 1
    //    0x10 (NEW_CONSOLE) → none → 0
    let f_susp = count_by_flag_bit(0x04)
    if f_susp != 2 {
        panic("pe_create_process FAIL [count_by_flag_bit(0x04)] expected=2 got=" + to_string(f_susp))
    }
    let f_det = count_by_flag_bit(0x08)
    if f_det != 1 {
        panic("pe_create_process FAIL [count_by_flag_bit(0x08)] expected=1 got=" + to_string(f_det))
    }
    let f_dbg_only = count_by_flag_bit(0x02)
    if f_dbg_only != 1 {
        panic("pe_create_process FAIL [count_by_flag_bit(0x02)] expected=1 got=" + to_string(f_dbg_only))
    }
    let f_dbg = count_by_flag_bit(0x01)
    if f_dbg != 1 {
        panic("pe_create_process FAIL [count_by_flag_bit(0x01)] expected=1 got=" + to_string(f_dbg))
    }
    let f_pgrp = count_by_flag_bit(0x200)
    if f_pgrp != 1 {
        panic("pe_create_process FAIL [count_by_flag_bit(0x200)] expected=1 got=" + to_string(f_pgrp))
    }
    let f_zero = count_by_flag_bit(0x10)
    if f_zero != 0 {
        panic("pe_create_process FAIL [count_by_flag_bit(0x10)] expected=0 got=" + to_string(f_zero))
    }

    // 6. distinct_processes = 4 (4001 dup, 4002, 4003, 4004)
    let dp = distinct_processes()
    if dp != 4 {
        panic("pe_create_process FAIL [distinct_processes] expected=4 got=" + to_string(dp))
    }
    if dp < 3 {
        panic("pe_create_process FAIL [distinct_processes>=3] got=" + to_string(dp))
    }

    // 7. distinct_threads = 5
    let dt = distinct_threads()
    if dt != 5 {
        panic("pe_create_process FAIL [distinct_threads] expected=5 got=" + to_string(dt))
    }

    // 8. create_process_id sanity
    let p2 = create_process_id(740002)
    if p2 != 4002 {
        panic("pe_create_process FAIL [create_process_id(740002)] expected=4002 got=" + to_string(p2))
    }
    let p4 = create_process_id(740004)
    if p4 != 4001 {
        panic("pe_create_process FAIL [create_process_id(740004)] expected=4001 got=" + to_string(p4))
    }
    let p_miss = create_process_id(99999)
    if p_miss != 0 {
        panic("pe_create_process FAIL [create_process_id(99999)] expected=0 got=" + to_string(p_miss))
    }

    // 9. pcp_stats() = [5, 531, 4, 5]
    let s = pcp_stats()
    if len(s) != 4 {
        panic("pe_create_process FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_create_process FAIL [stats create_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 531 {
        panic("pe_create_process FAIL [stats total_flags] expected=531 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_create_process FAIL [stats distinct_pids] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 5 {
        panic("pe_create_process FAIL [stats distinct_tids] expected=5 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_create_process_stats",
        "\"create_count\":" + to_string(s[0])
        + ",\"total_flags\":" + to_string(s[1])
        + ",\"distinct_pids\":" + to_string(s[2])
        + ",\"distinct_tids\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_create_process FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pcp()
    let s2 = pcp_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_create_process FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_create_process self_test PASS (creates=" + to_string(s[0])
        + ", flags=" + to_string(s[1]) + ", pids=" + to_string(s[2])
        + ", tids=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pcp_stats()
            println("create_count\t" + to_string(s[0]))
            println("total_creation_flags\t" + to_string(s[1]))
            println("distinct_processes\t" + to_string(s[2]))
            println("distinct_threads\t" + to_string(s[3]))
            return
        }
        if sub == "pid" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("create_process_id\t" + to_string(create_process_id(cid)))
                return
            }
            println("usage: hexa run pe_create_process.hexa pid <create_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let bit = to_int(a[3])
                println("count_by_flag_bit\t" + to_string(count_by_flag_bit(bit)))
                return
            }
            println("usage: hexa run pe_create_process.hexa count <flag_bit>")
            return
        }
        if sub == "cleanup" {
            cleanup_pcp()
            println("cleaned: " + pcp_dir())
            return
        }
        if sub == "dir" {
            println(pcp_dir())
            return
        }
    }
    println("usage: hexa run pe_create_process.hexa { self-test | stats | pid <create_id> | count <flag_bit> | cleanup | dir }")
}
