// lib/loader/pe_starcraft2_track.hexa — StarCraft 2 (Blizzard, RTS) 전용 entry/loader 추적.
//
// SC2 launch chain (own2 자체 추적):
//   process_attach        — SC2.exe entry, NT TLS_CALLBACK array fire
//   blizz_engine          — Blizzard engine boot (Battle.net.dll, Galaxy.dll)
//   warden_init           — Warden user-mode AC (D2R/D4 와 동일 family)
//   bnet_token            — Battle.net Agent token (sc2 entitlement)
//   campaign_select       — Wings/HOTS/LOTV/NCO single-player campaign
//   multiplayer_lobby     — 1v1/2v2/3v3/4v4 ladder + arcade (멀티 정책상 거부)
//   replay_load           — replay file playback path
//   arcade_load           — Galaxy editor map (Battle Royale, RTS custom)
//   first_frame           — DX11 swapchain present
// own1: SC2 공개 정보 + Battle.net IPC. Wine 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 10 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = process_attach
//   2 = blizz_engine
//   3 = warden_init
//   4 = bnet_token
//   5 = campaign_select
//   6 = multiplayer_lobby
//   7 = replay_load
//   8 = arcade_load
//   9 = first_frame
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t dll_loaded<int> \t warden_active<int>

use "../perf/r0_common"

fn psc2t_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_starcraft2_track"
}

fn psc2t_steps_path() -> str {
    return psc2t_dir() + "/steps.tsv"
}

fn psc2t_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + psc2t_dir() + "'")
}

fn cleanup_psc2t() -> void {
    psc2t_ensure_dir()
    let _ = exec("rm -f '" + psc2t_steps_path() + "'")
}

fn psc2t_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn psc2t_append_row(path: str, row: str) -> void {
    psc2t_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn record_step(step_id: int, phase_kind: int, dll_loaded: int, warden_active: int) -> void {
    if step_id <= 0 {
        panic("pe_starcraft2_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_starcraft2_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 9 {
        panic("pe_starcraft2_track FAIL [record_step] expected=phase_kind<=9 got=" + to_string(phase_kind))
    }
    if dll_loaded < 0 {
        panic("pe_starcraft2_track FAIL [record_step] expected=dll_loaded>=0 got=" + to_string(dll_loaded))
    }
    if dll_loaded > 1 {
        panic("pe_starcraft2_track FAIL [record_step] expected=dll_loaded<=1 got=" + to_string(dll_loaded))
    }
    if warden_active < 0 {
        panic("pe_starcraft2_track FAIL [record_step] expected=warden_active>=0 got=" + to_string(warden_active))
    }
    if warden_active > 1 {
        panic("pe_starcraft2_track FAIL [record_step] expected=warden_active<=1 got=" + to_string(warden_active))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(dll_loaded) + "\t" + to_string(warden_active) + "\n"
    psc2t_append_row(psc2t_steps_path(), row)
}

fn step_count() -> int {
    let t = psc2t_read_table(psc2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_phase_kind(phase_kind: int) -> int {
    let t = psc2t_read_table(psc2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn loaded_count() -> int {
    let t = psc2t_read_table(psc2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn warden_active_count() -> int {
    let t = psc2t_read_table(psc2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn bnet_token_count() -> int {
    return count_by_phase_kind(4)
}

fn step_dll_loaded(step_id: int) -> int {
    let t = psc2t_read_table(psc2t_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn psc2t_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(loaded_count())
    out.push(warden_active_count())
    out.push(bnet_token_count())
    out.push(count_by_phase_kind(9))
    return out
}

fn self_test() -> void {
    let sid = "psc2t-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_psc2t()

    record_step(160001, 1, 0, 0)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160001,\"phase_kind\":1,\"dll_loaded\":0,\"warden_active\":0,\"target\":\"process_attach\"")
    record_step(160002, 2, 1, 0)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160002,\"phase_kind\":2,\"dll_loaded\":1,\"warden_active\":0,\"target\":\"blizz_engine\"")
    record_step(160003, 3, 1, 1)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160003,\"phase_kind\":3,\"dll_loaded\":1,\"warden_active\":1,\"target\":\"warden_init\"")
    record_step(160004, 4, 1, 1)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160004,\"phase_kind\":4,\"dll_loaded\":1,\"warden_active\":1,\"target\":\"bnet_token\"")
    record_step(160005, 5, 0, 1)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160005,\"phase_kind\":5,\"dll_loaded\":0,\"warden_active\":1,\"target\":\"campaign_select\"")
    record_step(160006, 6, 0, 1)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160006,\"phase_kind\":6,\"dll_loaded\":0,\"warden_active\":1,\"target\":\"multiplayer_lobby\"")
    record_step(160007, 7, 0, 0)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160007,\"phase_kind\":7,\"dll_loaded\":0,\"warden_active\":0,\"target\":\"replay_load\"")
    record_step(160008, 8, 1, 0)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160008,\"phase_kind\":8,\"dll_loaded\":1,\"warden_active\":0,\"target\":\"arcade_load\"")
    record_step(160009, 9, 0, 0)
    r0_emit("pe_starcraft2_track_record",
        "\"step_id\":160009,\"phase_kind\":9,\"dll_loaded\":0,\"warden_active\":0,\"target\":\"first_frame\"")

    let c = step_count()
    if c != 9 {
        panic("pe_starcraft2_track FAIL [step_count] expected=9 got=" + to_string(c))
    }
    let p4 = bnet_token_count()
    if p4 != 1 {
        panic("pe_starcraft2_track FAIL [bnet_token_count] expected=1 got=" + to_string(p4))
    }
    let lc = loaded_count()
    if lc != 4 {
        panic("pe_starcraft2_track FAIL [loaded_count] expected=4 got=" + to_string(lc))
    }
    let wa = warden_active_count()
    if wa != 4 {
        panic("pe_starcraft2_track FAIL [warden_active_count] expected=4 got=" + to_string(wa))
    }
    let p9 = count_by_phase_kind(9)
    if p9 != 1 {
        panic("pe_starcraft2_track FAIL [count_by_phase_kind(9)] expected=1 got=" + to_string(p9))
    }
    let p99 = count_by_phase_kind(99)
    if p99 != 0 {
        panic("pe_starcraft2_track FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p99))
    }
    let d_miss = step_dll_loaded(9999)
    if d_miss != 0 {
        panic("pe_starcraft2_track FAIL [step_dll_loaded(9999)] expected=0 got=" + to_string(d_miss))
    }

    let s = psc2t_stats()
    if len(s) != 5 {
        panic("pe_starcraft2_track FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 9 {
        panic("pe_starcraft2_track FAIL [stats step_count] expected=9 got=" + to_string(s[0]))
    }

    r0_emit("pe_starcraft2_track_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"loaded_count\":" + to_string(s[1])
        + ",\"warden_active_count\":" + to_string(s[2])
        + ",\"bnet_token_count\":" + to_string(s[3])
        + ",\"first_frame_count\":" + to_string(s[4]))

    let emit_n = r0_session_count(sid)
    if emit_n < 10 {
        panic("pe_starcraft2_track FAIL [r0 emit count] expected=>=10 got=" + to_string(emit_n))
    }

    cleanup_psc2t()
    let s2 = psc2t_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_starcraft2_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_starcraft2_track self_test PASS (steps=" + to_string(s[0])
        + ", loaded=" + to_string(s[1]) + ", warden=" + to_string(s[2])
        + ", bnet_token=" + to_string(s[3]) + ", first_frame=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = psc2t_stats()
            println("step_count\t" + to_string(s[0]))
            println("loaded_count\t" + to_string(s[1]))
            println("warden_active_count\t" + to_string(s[2]))
            println("bnet_token_count\t" + to_string(s[3]))
            println("first_frame_count\t" + to_string(s[4]))
            return
        }
        if sub == "loaded" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_dll_loaded\t" + to_string(step_dll_loaded(sid)))
                return
            }
            println("usage: hexa run pe_starcraft2_track.hexa loaded <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_starcraft2_track.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_psc2t()
            println("cleaned: " + psc2t_dir())
            return
        }
        if sub == "dir" {
            println(psc2t_dir())
            return
        }
    }
    println("usage: hexa run pe_starcraft2_track.hexa { self-test | stats | loaded <step_id> | count <phase_kind> | cleanup | dir }")
}
