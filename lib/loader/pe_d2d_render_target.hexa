// lib/loader/pe_d2d_render_target.hexa — cycle 77 Direct2D ID2D1RenderTarget skeleton
//
// Direct2D ID2D1RenderTarget BeginDraw/EndDraw + DrawText/FillRectangle
// telemetry → CoreGraphics bridge. PE host (Windows app) 의 D2D draw call
// 을 추적하여 macOS native CoreGraphics layer 로 forwarding 할 수 있는
// metadata 를 제공한다. 본 module 은 op tracker — 실 D2D / CG 호출 X.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = fill_rect
//   2 = draw_rect
//   3 = fill_geometry
//   4 = draw_text
//   5 = draw_bitmap
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t primitive_count<int> \t antialiased<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdrt_d2d_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d2d_render_target"
}

fn pdrt_d2d_ops_path() -> str {
    return pdrt_d2d_dir() + "/ops.tsv"
}

fn pdrt_d2d_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdrt_d2d_dir() + "'")
}

fn cleanup_pdrt_d2d() -> void {
    pdrt_d2d_ensure_dir()
    let _ = exec("rm -f '" + pdrt_d2d_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pdrt_d2d_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdrt_d2d_append_row(path: str, row: str) -> void {
    pdrt_d2d_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: D2D draw op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, primitive_count: int, antialiased: int) -> void {
    if op_id <= 0 {
        panic("pe_d2d_render_target FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_d2d_render_target FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 5 {
        panic("pe_d2d_render_target FAIL [record_op] expected=op_kind<=5 got=" + to_string(op_kind))
    }
    if primitive_count < 0 {
        panic("pe_d2d_render_target FAIL [record_op] expected=primitive_count>=0 got=" + to_string(primitive_count))
    }
    if antialiased < 0 {
        panic("pe_d2d_render_target FAIL [record_op] expected=antialiased>=0 got=" + to_string(antialiased))
    }
    if antialiased > 1 {
        panic("pe_d2d_render_target FAIL [record_op] expected=antialiased<=1 got=" + to_string(antialiased))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(primitive_count) + "\t" + to_string(antialiased) + "\n"
    pdrt_d2d_append_row(pdrt_d2d_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pdrt_d2d_read_table(pdrt_d2d_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_primitives: 모든 op primitive_count 합 ───
fn total_primitives() -> int {
    let t = pdrt_d2d_read_table(pdrt_d2d_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── antialiased_count: antialiased=1 인 op 수 ───
fn antialiased_count() -> int {
    let t = pdrt_d2d_read_table(pdrt_d2d_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = pdrt_d2d_read_table(pdrt_d2d_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_primitive_count: 특정 op_id 의 primitive_count (없으면 0) ───
fn op_primitive_count(op_id: int) -> int {
    let t = pdrt_d2d_read_table(pdrt_d2d_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdrt_d2d_stats: [op_count, total_primitives, antialiased_count, count_by_op_kind(4)] ───
fn pdrt_d2d_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_primitives())
    out.push(antialiased_count())
    out.push(count_by_op_kind(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdrt-d2d-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdrt_d2d()

    // 2. record 6 D2D ops across ≥3 op_kinds with ≥3 antialiased
    record_op(120001, 1, 1, 1)
    r0_emit("pe_d2d_render_target_record",
        "\"op_id\":120001,\"op_kind\":1,\"primitive_count\":1,\"antialiased\":1,\"target\":\"fill_rect\"")

    record_op(120002, 1, 1, 0)
    r0_emit("pe_d2d_render_target_record",
        "\"op_id\":120002,\"op_kind\":1,\"primitive_count\":1,\"antialiased\":0,\"target\":\"fill_rect\"")

    record_op(120003, 2, 1, 1)
    r0_emit("pe_d2d_render_target_record",
        "\"op_id\":120003,\"op_kind\":2,\"primitive_count\":1,\"antialiased\":1,\"target\":\"draw_rect\"")

    record_op(120004, 4, 16, 1)
    r0_emit("pe_d2d_render_target_record",
        "\"op_id\":120004,\"op_kind\":4,\"primitive_count\":16,\"antialiased\":1,\"target\":\"draw_text\"")

    record_op(120005, 4, 32, 0)
    r0_emit("pe_d2d_render_target_record",
        "\"op_id\":120005,\"op_kind\":4,\"primitive_count\":32,\"antialiased\":0,\"target\":\"draw_text\"")

    record_op(120006, 5, 1, 0)
    r0_emit("pe_d2d_render_target_record",
        "\"op_id\":120006,\"op_kind\":5,\"primitive_count\":1,\"antialiased\":0,\"target\":\"draw_bitmap\"")

    // 3. op_count = 6
    let c = op_count()
    if c != 6 {
        panic("pe_d2d_render_target FAIL [op_count] expected=6 got=" + to_string(c))
    }

    // 4. total_primitives = 1+1+1+16+32+1 = 52
    let tp = total_primitives()
    if tp != 52 {
        panic("pe_d2d_render_target FAIL [total_primitives] expected=52 got=" + to_string(tp))
    }

    // 5. antialiased_count = 3
    let ac = antialiased_count()
    if ac != 3 {
        panic("pe_d2d_render_target FAIL [antialiased_count] expected=3 got=" + to_string(ac))
    }

    // 6. count_by_op_kind sanity
    let k1 = count_by_op_kind(1)
    if k1 != 2 {
        panic("pe_d2d_render_target FAIL [count_by_op_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 1 {
        panic("pe_d2d_render_target FAIL [count_by_op_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 0 {
        panic("pe_d2d_render_target FAIL [count_by_op_kind(3)] expected=0 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 2 {
        panic("pe_d2d_render_target FAIL [count_by_op_kind(4)] expected=2 got=" + to_string(k4))
    }
    let k5 = count_by_op_kind(5)
    if k5 != 1 {
        panic("pe_d2d_render_target FAIL [count_by_op_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_d2d_render_target FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. op_primitive_count sanity
    let p4 = op_primitive_count(120004)
    if p4 != 16 {
        panic("pe_d2d_render_target FAIL [op_primitive_count(120004)] expected=16 got=" + to_string(p4))
    }
    let p5 = op_primitive_count(120005)
    if p5 != 32 {
        panic("pe_d2d_render_target FAIL [op_primitive_count(120005)] expected=32 got=" + to_string(p5))
    }
    let p_miss = op_primitive_count(9999)
    if p_miss != 0 {
        panic("pe_d2d_render_target FAIL [op_primitive_count(9999)] expected=0 got=" + to_string(p_miss))
    }

    // 8. pdrt_d2d_stats() = [6, 52, 3, 2]
    let s = pdrt_d2d_stats()
    if len(s) != 4 {
        panic("pe_d2d_render_target FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_d2d_render_target FAIL [stats op_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 52 {
        panic("pe_d2d_render_target FAIL [stats total_primitives] expected=52 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_d2d_render_target FAIL [stats antialiased_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_d2d_render_target FAIL [stats count_kind(4)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_d2d_render_target_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_primitives\":" + to_string(s[1])
        + ",\"antialiased_count\":" + to_string(s[2])
        + ",\"kind_draw_text\":" + to_string(s[3]))

    // 10. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_d2d_render_target FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdrt_d2d()
    let s2 = pdrt_d2d_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d2d_render_target FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d2d_render_target self_test PASS (ops=" + to_string(s[0])
        + ", prims=" + to_string(s[1]) + ", aa=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdrt_d2d_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_primitives\t" + to_string(s[1]))
            println("antialiased_count\t" + to_string(s[2]))
            println("count_kind_draw_text\t" + to_string(s[3]))
            return
        }
        if sub == "prims" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_primitive_count\t" + to_string(op_primitive_count(oid)))
                return
            }
            println("usage: hexa run pe_d2d_render_target.hexa prims <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_d2d_render_target.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdrt_d2d()
            println("cleaned: " + pdrt_d2d_dir())
            return
        }
        if sub == "dir" {
            println(pdrt_d2d_dir())
            return
        }
    }
    println("usage: hexa run pe_d2d_render_target.hexa { self-test | stats | prims <op_id> | count <op_kind> | cleanup | dir }")
}
