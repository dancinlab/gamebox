// lib/loader/dx_d3d11.hexa — Phase 5a — DirectX 11 → D3DMetal mapping table (skeleton)
//
// own 1 enforcement: Wine / DXVK / VKD3D / community 코드 0 줄.
//   참조 only — Apple D3DMetal binary redistribution:
//     - DMG/redist/lib/external/D3DMetal.framework (Apple 공식 binary)
//   참조 only — Microsoft 공식 Direct3D 11 spec:
//     - Device:        https://learn.microsoft.com/en-us/windows/win32/api/d3d11/nn-d3d11-id3d11device
//     - DeviceContext: https://learn.microsoft.com/en-us/windows/win32/api/d3d11/nn-d3d11-id3d11devicecontext
//     - DXGI SwapChain:https://learn.microsoft.com/en-us/windows/win32/api/dxgi/nn-dxgi-idxgiswapchain
//   참조 only — Apple Metal spec:
//     - MTLDevice:     https://developer.apple.com/documentation/metal/mtldevice
//     - MTLRenderCommandEncoder: https://developer.apple.com/documentation/metal/mtlrendercommandencoder
//   Wine / DXVK / VKD3D source 단 1 줄도 import / copy / port 금지.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 ≥ 2: d3d11_lookup + d3d11_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("dx_d3d11 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 5a — skeleton):
//   30 핵심 D3D11 method 의 *mapping table* 만 정의.
//   각 entry = (D3D11 method, 대응되는 D3DMetal/Metal 호출, 카테고리, status).
//   실제 implementation (D3DMetal.framework binding trampoline) 은 Phase 5a 후속.
//
// status 값:
//   "skeleton" — mapping 만 (Phase 5a 현재 모든 entry)
//   "stub"     — default value 만 반환 (호출 시 S_OK 또는 NULL)
//   "impl"     — 실제 D3DMetal binding 호출
//
// 30 method 카테고리 (실제 분포):
//   Device         8  (D3D11CreateDevice, D3D11CreateDeviceAndSwapChain,
//                     CreateBuffer, CreateTexture2D, CreateRenderTargetView,
//                     CreateDepthStencilView, CreateShaderResourceView, CreateSamplerState)
//   Shader         6  (CreateVertexShader, CreatePixelShader, CreateComputeShader,
//                     CreateGeometryShader, CreateHullShader, CreateDomainShader)
//   DeviceContext 10  (Draw, DrawIndexed, DrawInstanced, DrawIndexedInstanced,
//                     IASetVertexBuffers, IASetIndexBuffer, VSSetShader, PSSetShader,
//                     OMSetRenderTargets, ClearRenderTargetView)
//   Pipeline       4  (CreateInputLayout, CreateBlendState,
//                     CreateDepthStencilState, CreateRasterizerState)
//   SwapChain      2  (Present, ResizeBuffers)
//   ──────────
//   total         30  / 5 categories

use "../perf/r0_common"

// ─── 30 method mapping table (TSV — name\tmetal\tcategory\tstatus) ───
//
// 한 줄 = "<D3D11 method>\t<D3DMetal/Metal equivalent>\t<category>\t<status>"
// 줄 구분자 = "\n". 첫 줄도 의미 entry (header 없음 — 데이터 30줄).
fn d3d11_table() -> str {
    let t = ""
    // Device (8)
    t = t + "D3D11CreateDevice\tCreateMTLDevice_d3dmetal\tDevice\tskeleton\n"
    t = t + "D3D11CreateDeviceAndSwapChain\tCreateMTLDevice_swap\tDevice\tskeleton\n"
    t = t + "ID3D11Device::CreateBuffer\tMTLBuffer_new\tDevice\tskeleton\n"
    t = t + "ID3D11Device::CreateTexture2D\tMTLTexture_new\tDevice\tskeleton\n"
    t = t + "ID3D11Device::CreateRenderTargetView\tMTLRenderTarget_new\tDevice\tskeleton\n"
    t = t + "ID3D11Device::CreateDepthStencilView\tMTLDepthStencil_new\tDevice\tskeleton\n"
    t = t + "ID3D11Device::CreateShaderResourceView\tMTLTextureView_new\tDevice\tskeleton\n"
    t = t + "ID3D11Device::CreateSamplerState\tMTLSamplerState_new\tDevice\tskeleton\n"
    // Shader (6)
    t = t + "ID3D11Device::CreateVertexShader\tMTLVertexFunction_new\tShader\tskeleton\n"
    t = t + "ID3D11Device::CreatePixelShader\tMTLFragmentFunction_new\tShader\tskeleton\n"
    t = t + "ID3D11Device::CreateComputeShader\tMTLComputeFunction_new\tShader\tskeleton\n"
    t = t + "ID3D11Device::CreateGeometryShader\tMTLGeometryFunction_new\tShader\tskeleton\n"
    t = t + "ID3D11Device::CreateHullShader\tMTLTessControlFunction_new\tShader\tskeleton\n"
    t = t + "ID3D11Device::CreateDomainShader\tMTLTessEvalFunction_new\tShader\tskeleton\n"
    // DeviceContext (10)
    t = t + "ID3D11DeviceContext::Draw\tMTLRenderCommandEncoder_drawPrimitives\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::DrawIndexed\tMTLRenderCommandEncoder_drawIndexedPrimitives\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::DrawInstanced\tMTLRenderCommandEncoder_drawPrimitives_instanced\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::DrawIndexedInstanced\tMTLRenderCommandEncoder_drawIndexedPrimitives_instanced\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::IASetVertexBuffers\tMTLRenderCommandEncoder_setVertexBuffer\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::IASetIndexBuffer\tMTLRenderCommandEncoder_setIndexBuffer\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::VSSetShader\tMTLRenderCommandEncoder_setVertexFunction\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::PSSetShader\tMTLRenderCommandEncoder_setFragmentFunction\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::OMSetRenderTargets\tMTLRenderCommandEncoder_setRenderPipelineState\tDeviceContext\tskeleton\n"
    t = t + "ID3D11DeviceContext::ClearRenderTargetView\tMTLRenderCommandEncoder_clear\tDeviceContext\tskeleton\n"
    // Pipeline (4)
    t = t + "ID3D11Device::CreateInputLayout\tMTLVertexDescriptor\tPipeline\tskeleton\n"
    t = t + "ID3D11Device::CreateBlendState\tMTLRenderPipeline_blend\tPipeline\tskeleton\n"
    t = t + "ID3D11Device::CreateDepthStencilState\tMTLDepthStencilState\tPipeline\tskeleton\n"
    t = t + "ID3D11Device::CreateRasterizerState\tMTLRenderPipeline_raster\tPipeline\tskeleton\n"
    // SwapChain (2)
    t = t + "IDXGISwapChain::Present\tCAMetalLayer_drawable_present\tSwapChain\tskeleton\n"
    t = t + "IDXGISwapChain::ResizeBuffers\tCAMetalLayer_resize\tSwapChain\tskeleton\n"
    return t
}

// ─── table line count (entry 수 = 30) ───
fn d3d11_table_size() -> int {
    let t = d3d11_table()
    let lines = t.split("\n")
    // trailing "\n" → 마지막 빈 element 1 개. count 에서 제외.
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ─── lookup: D3D11 method 명 → "<metal>\t<category>\t<status>" 또는 "" ───
fn lookup_mapping(name: str) -> str {
    let t = d3d11_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == name {
                    return parts[1] + "\t" + parts[2] + "\t" + parts[3]
                }
            }
        }
        i = i + 1
    }
    return ""
}

// ─── status only ───
fn method_status(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[2]
    }
    return ""
}

// ─── category only ───
fn method_category(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[1]
    }
    return ""
}

// ─── Metal equivalent only ───
fn method_metal_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" {
        return ""
    }
    let p = m.split("\t")
    if len(p) >= 3 {
        return p[0]
    }
    return ""
}

// ─── category 통계 ───
//
//   반환: array of [category_name, total_count, impl_count]
//   (hexa stage1 dict 부재 → array of array).
//   impl_count = status == "impl" 인 entry 수 (Phase 5a 현재 모두 0).
fn d3d11_stats() -> array {
    let mut cats = []
    cats.push(["Device", 0, 0])
    cats.push(["Shader", 0, 0])
    cats.push(["DeviceContext", 0, 0])
    cats.push(["Pipeline", 0, 0])
    cats.push(["SwapChain", 0, 0])

    let t = d3d11_table()
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cat = parts[2]
                let st = parts[3]
                let j = 0
                while j < len(cats) {
                    if cats[j][0] == cat {
                        cats[j][1] = cats[j][1] + 1
                        if st == "impl" {
                            cats[j][2] = cats[j][2] + 1
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return cats
}

// ─── 전체 impl_count 합 (스카라) ───
fn d3d11_impl_count() -> int {
    let stats = d3d11_stats()
    let n = len(stats)
    let i = 0
    let total = 0
    while i < n {
        total = total + stats[i][2]
        i = i + 1
    }
    return total
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "d3d11test-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. table_size ≥ 25 (실제 30)
    let sz = d3d11_table_size()
    if sz < 25 {
        panic("dx_d3d11 FAIL [table_size] expected=>=25 got=" + to_string(sz))
    }
    if sz != 30 {
        panic("dx_d3d11 FAIL [table_size_exact] expected=30 got=" + to_string(sz))
    }

    // 2. lookup_mapping("D3D11CreateDevice") = "CreateMTLDevice_d3dmetal\tDevice\tskeleton"
    let m_create = lookup_mapping("D3D11CreateDevice")
    let exp_create = "CreateMTLDevice_d3dmetal\tDevice\tskeleton"
    if m_create != exp_create {
        panic("dx_d3d11 FAIL [lookup D3D11CreateDevice] expected=" + exp_create + " got=" + m_create)
    }

    // 3. lookup_mapping("ID3D11DeviceContext::Draw") = "MTLRenderCommandEncoder_drawPrimitives\tDeviceContext\tskeleton"
    let m_draw = lookup_mapping("ID3D11DeviceContext::Draw")
    let exp_draw = "MTLRenderCommandEncoder_drawPrimitives\tDeviceContext\tskeleton"
    if m_draw != exp_draw {
        panic("dx_d3d11 FAIL [lookup Draw] expected=" + exp_draw + " got=" + m_draw)
    }

    // 3b. SwapChain Present
    let m_present = lookup_mapping("IDXGISwapChain::Present")
    let exp_present = "CAMetalLayer_drawable_present\tSwapChain\tskeleton"
    if m_present != exp_present {
        panic("dx_d3d11 FAIL [lookup Present] expected=" + exp_present + " got=" + m_present)
    }

    // 3c. method_status
    let st = method_status("D3D11CreateDevice")
    if st != "skeleton" {
        panic("dx_d3d11 FAIL [method_status D3D11CreateDevice] expected=skeleton got=" + st)
    }

    // 3d. unknown name → empty
    let m_unknown = lookup_mapping("NoSuchMethod")
    if m_unknown != "" {
        panic("dx_d3d11 FAIL [lookup unknown] expected=empty got=" + m_unknown)
    }

    // 5a. r0_emit "d3d11_lookup" {name, metal}
    let metal_create = method_metal_equiv("D3D11CreateDevice")
    r0_emit("d3d11_lookup",
        "\"name\":\"D3D11CreateDevice\",\"metal\":\"" + metal_create + "\"")

    // 4. d3d11_stats() ≥ 5 categories with expected counts
    let stats = d3d11_stats()
    let cat_n = len(stats)
    if cat_n < 5 {
        panic("dx_d3d11 FAIL [stats categories] expected=>=5 got=" + to_string(cat_n))
    }
    // 카테고리별 정확한 count 검증
    let i = 0
    let sum_total = 0
    let sum_impl = 0
    while i < cat_n {
        let cn = stats[i][0]
        let ct = stats[i][1]
        let ci = stats[i][2]
        sum_total = sum_total + ct
        sum_impl = sum_impl + ci
        // 카테고리별 정확 count
        if cn == "Device" {
            if ct != 8 {
                panic("dx_d3d11 FAIL [stats Device count] expected=8 got=" + to_string(ct))
            }
        }
        if cn == "Shader" {
            if ct != 6 {
                panic("dx_d3d11 FAIL [stats Shader count] expected=6 got=" + to_string(ct))
            }
        }
        if cn == "DeviceContext" {
            if ct != 10 {
                panic("dx_d3d11 FAIL [stats DeviceContext count] expected=10 got=" + to_string(ct))
            }
        }
        if cn == "Pipeline" {
            if ct != 4 {
                panic("dx_d3d11 FAIL [stats Pipeline count] expected=4 got=" + to_string(ct))
            }
        }
        if cn == "SwapChain" {
            if ct != 2 {
                panic("dx_d3d11 FAIL [stats SwapChain count] expected=2 got=" + to_string(ct))
            }
        }
        i = i + 1
    }
    if sum_total != 30 {
        panic("dx_d3d11 FAIL [stats total sum] expected=30 got=" + to_string(sum_total))
    }
    if sum_impl != 0 {
        panic("dx_d3d11 FAIL [stats impl sum] expected=0 got=" + to_string(sum_impl))
    }

    // 5b. r0_emit "d3d11_stats" {table_size, categories, impl_count}
    r0_emit("d3d11_stats",
        "\"table_size\":" + to_string(sz)
        + ",\"categories\":" + to_string(cat_n)
        + ",\"impl_count\":" + to_string(sum_impl))

    // R0 emit count 검증 — 정확히 2 events (d3d11_lookup + d3d11_stats)
    let emit_n = r0_session_count(sid)
    if emit_n != 2 {
        panic("dx_d3d11 FAIL [r0 emit count] expected=2 got=" + to_string(emit_n))
    }

    println("  ✅ dx_d3d11 self_test PASS (30 methods, 5 categories, all skeleton, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "table" {
            print(d3d11_table())
            return
        }
        if sub == "lookup" {
            if len(a) >= 4 {
                let name = a[3]
                let m = lookup_mapping(name)
                if m == "" {
                    println("(not found)")
                } else {
                    println(m)
                }
                return
            }
        }
        if sub == "status" {
            if len(a) >= 4 {
                let name = a[3]
                let s = method_status(name)
                if s == "" {
                    println("(not found)")
                } else {
                    println(s)
                }
                return
            }
        }
        if sub == "stats" {
            let stats = d3d11_stats()
            let n = len(stats)
            let i = 0
            while i < n {
                println(stats[i][0]
                    + "\t" + to_string(stats[i][1])
                    + "\t" + to_string(stats[i][2]))
                i = i + 1
            }
            return
        }
        if sub == "size" {
            println(to_string(d3d11_table_size()))
            return
        }
    }
    println("usage: hexa run dx_d3d11.hexa { self-test | table | lookup <name> | status <name> | stats | size }")
}
