// lib/loader/pe_jit_entitlement_track.hexa — E2 codesign + JIT entitlement 상태 추적기
//
// Apple Silicon hardened runtime 필요 entitlement:
//   com.apple.security.cs.allow-jit                       — MAP_JIT mmap (NX → RWX 전환)
//   com.apple.security.cs.allow-unsigned-executable-memory — Rosetta 2 + DIY JIT path
//   com.apple.security.cs.disable-library-validation       — D3DMetal weak link 허용
//   com.apple.security.cs.allow-dyld-environment-variables — DYLD_INSERT_LIBRARIES 등 허용
//   com.apple.security.cs.allow-unsigned-executable        — unsigned exec page 허용
//
// codesign 명령 (own1: Apple codesign + entitlement plist 만):
//   codesign -s - --entitlements helper.entitlements --options runtime --force <bin>
//   codesign -d --entitlements - <bin>            # verify_dump 단계
//
// own 1 enforcement: Wine / CrossOver / community / GPTK / Whisky 0 줄 — 본 모듈은
//   Apple codesign + entitlement plist 만 다루는 추적기일 뿐, 외부 helper X.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// entitlement_kind code:
//   1 = allow_jit                               (com.apple.security.cs.allow-jit)
//   2 = allow_unsigned_executable_memory        (allow-unsigned-executable-memory)
//   3 = disable_library_validation              (disable-library-validation)
//   4 = allow_dyld_environment_variables        (allow-dyld-environment-variables)
//   5 = allow_unsigned_executable               (allow-unsigned-executable)
//
// codesign_phase code:
//   1 = plist_writeup     — helper.entitlements plist 작성
//   2 = codesign_invoke   — codesign -s - --entitlements ... 실 호출
//   3 = verify_dump       — codesign -d --entitlements - 로 dump 검증
//   4 = runtime_test      — MAP_JIT mmap / pthread_jit_write_protect_np 실 동작
//
// persist schema (TSV — entries.tsv):
//   entry_id<str> \t entitlement_kind<int> \t codesign_phase<int> \t active<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pjet_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_jit_entitlement_track"
}

fn pjet_entries_path() -> str {
    return pjet_dir() + "/entries.tsv"
}

fn pjet_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pjet_dir() + "'")
}

fn cleanup_pjet() -> void {
    pjet_ensure_dir()
    let _ = exec("rm -f '" + pjet_entries_path() + "'")
}

// ─── 공통 file IO ───
fn pjet_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pjet_append_row(path: str, row: str) -> void {
    pjet_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_entry: entitlement entry 1 건 기록 ───
fn record_entry(entry_id: str, entitlement_kind: int, codesign_phase: int, active: int) -> void {
    if entry_id == "" {
        panic("pe_jit_entitlement_track FAIL [record_entry] expected=entry_id!=\"\" got=\"\"")
    }
    if entitlement_kind < 1 {
        panic("pe_jit_entitlement_track FAIL [record_entry] expected=entitlement_kind>=1 got=" + to_string(entitlement_kind))
    }
    if entitlement_kind > 5 {
        panic("pe_jit_entitlement_track FAIL [record_entry] expected=entitlement_kind<=5 got=" + to_string(entitlement_kind))
    }
    if codesign_phase < 1 {
        panic("pe_jit_entitlement_track FAIL [record_entry] expected=codesign_phase>=1 got=" + to_string(codesign_phase))
    }
    if codesign_phase > 4 {
        panic("pe_jit_entitlement_track FAIL [record_entry] expected=codesign_phase<=4 got=" + to_string(codesign_phase))
    }
    if active < 0 {
        panic("pe_jit_entitlement_track FAIL [record_entry] expected=active>=0 got=" + to_string(active))
    }
    if active > 1 {
        panic("pe_jit_entitlement_track FAIL [record_entry] expected=active<=1 got=" + to_string(active))
    }
    let row = entry_id + "\t" + to_string(entitlement_kind)
        + "\t" + to_string(codesign_phase) + "\t" + to_string(active) + "\n"
    pjet_append_row(pjet_entries_path(), row)
}

// ─── entry_count: total entry 수 ───
fn entry_count() -> int {
    let t = pjet_read_table(pjet_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_entitlement_kind: 특정 entitlement_kind 의 entry 수 ───
fn count_by_entitlement_kind(entitlement_kind: int) -> int {
    let t = pjet_read_table(pjet_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == entitlement_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_codesign_phase: 특정 codesign_phase 의 entry 수 ───
fn count_by_codesign_phase(codesign_phase: int) -> int {
    let t = pjet_read_table(pjet_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == codesign_phase {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── active_count: active=1 인 entry 수 ───
fn active_count() -> int {
    let t = pjet_read_table(pjet_entries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── allow_jit_count: entitlement_kind=1 (allow-jit) 의 entry 수 ───
fn allow_jit_count() -> int {
    return count_by_entitlement_kind(1)
}

// ─── entry_active: 특정 entry_id 의 active 상태 (없으면 -1) ───
fn entry_active(entry_id: str) -> int {
    let t = pjet_read_table(pjet_entries_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == entry_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pjet_stats: [entry_count, allow_jit_count, active_count] ───
fn pjet_stats() -> array {
    let mut out = []
    out.push(entry_count())
    out.push(allow_jit_count())
    out.push(active_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pjet-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pjet()

    // 2. record 8 entries — covers ≥4 entitlement_kinds and ≥3 codesign_phases
    //    (entitlement 1,2,3,4,5 hit; phase 1,2,3,4 hit; active=1 ×5)

    // E1: allow_jit / plist_writeup / active
    record_entry("e_allow_jit_plist", 1, 1, 1)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_allow_jit_plist\",\"entitlement_kind\":1,\"codesign_phase\":1,\"active\":1")

    // E2: allow_jit / codesign_invoke / active
    record_entry("e_allow_jit_codesign", 1, 2, 1)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_allow_jit_codesign\",\"entitlement_kind\":1,\"codesign_phase\":2,\"active\":1")

    // E3: allow_jit / runtime_test / active
    record_entry("e_allow_jit_runtime", 1, 4, 1)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_allow_jit_runtime\",\"entitlement_kind\":1,\"codesign_phase\":4,\"active\":1")

    // E4: allow_unsigned_executable_memory / plist_writeup / active
    record_entry("e_unsigned_exec_mem_plist", 2, 1, 1)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_unsigned_exec_mem_plist\",\"entitlement_kind\":2,\"codesign_phase\":1,\"active\":1")

    // E5: allow_unsigned_executable_memory / verify_dump / active
    record_entry("e_unsigned_exec_mem_verify", 2, 3, 1)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_unsigned_exec_mem_verify\",\"entitlement_kind\":2,\"codesign_phase\":3,\"active\":1")

    // E6: disable_library_validation / codesign_invoke / inactive
    record_entry("e_disable_libval_codesign", 3, 2, 0)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_disable_libval_codesign\",\"entitlement_kind\":3,\"codesign_phase\":2,\"active\":0")

    // E7: allow_dyld_env_vars / plist_writeup / inactive
    record_entry("e_dyld_env_plist", 4, 1, 0)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_dyld_env_plist\",\"entitlement_kind\":4,\"codesign_phase\":1,\"active\":0")

    // E8: allow_unsigned_executable / verify_dump / inactive
    record_entry("e_unsigned_exec_verify", 5, 3, 0)
    r0_emit("pe_jit_entitlement_track_record",
        "\"entry_id\":\"e_unsigned_exec_verify\",\"entitlement_kind\":5,\"codesign_phase\":3,\"active\":0")

    // 3. entry_count = 8
    let ec = entry_count()
    if ec != 8 {
        panic("pe_jit_entitlement_track FAIL [entry_count] expected=8 got=" + to_string(ec))
    }

    // 4. count_by_entitlement_kind sanity (≥4 entitlement_kinds present)
    let k1 = count_by_entitlement_kind(1)
    if k1 != 3 {
        panic("pe_jit_entitlement_track FAIL [count_by_entitlement_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_entitlement_kind(2)
    if k2 != 2 {
        panic("pe_jit_entitlement_track FAIL [count_by_entitlement_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_entitlement_kind(3)
    if k3 != 1 {
        panic("pe_jit_entitlement_track FAIL [count_by_entitlement_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_entitlement_kind(4)
    if k4 != 1 {
        panic("pe_jit_entitlement_track FAIL [count_by_entitlement_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_entitlement_kind(5)
    if k5 != 1 {
        panic("pe_jit_entitlement_track FAIL [count_by_entitlement_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k_miss = count_by_entitlement_kind(99)
    if k_miss != 0 {
        panic("pe_jit_entitlement_track FAIL [count_by_entitlement_kind(99)] expected=0 got=" + to_string(k_miss))
    }

    // 5. count_by_codesign_phase sanity (≥3 codesign_phases present)
    let ph1 = count_by_codesign_phase(1)
    if ph1 != 3 {
        panic("pe_jit_entitlement_track FAIL [count_by_codesign_phase(1)] expected=3 got=" + to_string(ph1))
    }
    let ph2 = count_by_codesign_phase(2)
    if ph2 != 2 {
        panic("pe_jit_entitlement_track FAIL [count_by_codesign_phase(2)] expected=2 got=" + to_string(ph2))
    }
    let ph3 = count_by_codesign_phase(3)
    if ph3 != 2 {
        panic("pe_jit_entitlement_track FAIL [count_by_codesign_phase(3)] expected=2 got=" + to_string(ph3))
    }
    let ph4 = count_by_codesign_phase(4)
    if ph4 != 1 {
        panic("pe_jit_entitlement_track FAIL [count_by_codesign_phase(4)] expected=1 got=" + to_string(ph4))
    }
    let ph_miss = count_by_codesign_phase(99)
    if ph_miss != 0 {
        panic("pe_jit_entitlement_track FAIL [count_by_codesign_phase(99)] expected=0 got=" + to_string(ph_miss))
    }

    // 6. allow_jit_count = 3 (entitlement_kind=1 ×3)
    let ajc = allow_jit_count()
    if ajc != 3 {
        panic("pe_jit_entitlement_track FAIL [allow_jit_count] expected=3 got=" + to_string(ajc))
    }

    // 7. active_count = 5 (E1,E2,E3,E4,E5)
    let ac = active_count()
    if ac != 5 {
        panic("pe_jit_entitlement_track FAIL [active_count] expected=5 got=" + to_string(ac))
    }

    // 8. entry_active lookup
    let ea_hit = entry_active("e_allow_jit_codesign")
    if ea_hit != 1 {
        panic("pe_jit_entitlement_track FAIL [entry_active hit] expected=1 got=" + to_string(ea_hit))
    }
    let ea_inactive = entry_active("e_dyld_env_plist")
    if ea_inactive != 0 {
        panic("pe_jit_entitlement_track FAIL [entry_active inactive] expected=0 got=" + to_string(ea_inactive))
    }
    let ea_miss = entry_active("e_does_not_exist")
    if ea_miss != -1 {
        panic("pe_jit_entitlement_track FAIL [entry_active miss] expected=-1 got=" + to_string(ea_miss))
    }

    // 9. pjet_stats() = [8, 3, 5]
    let s = pjet_stats()
    if len(s) != 3 {
        panic("pe_jit_entitlement_track FAIL [stats len] expected=3 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_jit_entitlement_track FAIL [stats entry_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 3 {
        panic("pe_jit_entitlement_track FAIL [stats allow_jit] expected=3 got=" + to_string(s[1]))
    }
    if s[2] != 5 {
        panic("pe_jit_entitlement_track FAIL [stats active] expected=5 got=" + to_string(s[2]))
    }

    // 10. emit aggregate stats
    r0_emit("pe_jit_entitlement_track_stats",
        "\"entry_count\":" + to_string(s[0])
        + ",\"allow_jit_count\":" + to_string(s[1])
        + ",\"active_count\":" + to_string(s[2]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_jit_entitlement_track FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pjet()
    let s2 = pjet_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_jit_entitlement_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_jit_entitlement_track self_test PASS (entries=" + to_string(s[0])
        + ", allow_jit=" + to_string(s[1]) + ", active=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pjet_stats()
            println("entry_count\t" + to_string(s[0]))
            println("allow_jit_count\t" + to_string(s[1]))
            println("active_count\t" + to_string(s[2]))
            return
        }
        if sub == "active" {
            if len(a) >= 4 {
                let eid = a[3]
                println("active\t" + to_string(entry_active(eid)))
                return
            }
            println("usage: hexa run pe_jit_entitlement_track.hexa active <entry_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let val = to_int(a[4])
                if dim == "ent" {
                    println("count_by_entitlement_kind\t" + to_string(count_by_entitlement_kind(val)))
                    return
                }
                if dim == "phase" {
                    println("count_by_codesign_phase\t" + to_string(count_by_codesign_phase(val)))
                    return
                }
                println("usage: hexa run pe_jit_entitlement_track.hexa count { ent | phase } <kind>")
                return
            }
            println("usage: hexa run pe_jit_entitlement_track.hexa count { ent | phase } <kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pjet()
            println("cleaned: " + pjet_dir())
            return
        }
        if sub == "dir" {
            println(pjet_dir())
            return
        }
    }
    println("usage: hexa run pe_jit_entitlement_track.hexa { self-test | stats | active <entry_id> | count ent <entitlement_kind> | count phase <codesign_phase> | cleanup | dir }")
}
