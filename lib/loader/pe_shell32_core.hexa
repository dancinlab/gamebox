// lib/loader/pe_shell32_core.hexa — SHELL32.dll Shell APIs surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine shell32 source 측 코드 인용 0. shell32.dll 직접 binding 0. macOS NSWorkspace
//       / NSFileManager / LSOpenURLsWithRole 직접 binding 0. shlobj.h / shellapi.h /
//       shlwapi.h reference shape 만 (CSIDL / SHFILEINFO / HINSTANCE return). 실
//       SHGetFolderPathW / 실 ShellExecuteW / 실 DragQueryFileW / 실 SHCreateDirectoryExW =
//       미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AH2 — SHELL32 (shell32.dll) Shell APIs surface coverage 12 fn (skeleton row 만).
// Track AH1 predecessor (MSVCRT 12 fn cycle 36) 후 본 Track AH2 는 SHELL32 측 path +
// process + drag-drop + misc baseline land. cycle 36 측 144/435 (~33.10%) → cycle 37
// 측 ~156/435 (~35.86%) coverage progression (+12 fn 신규, Track AH bundled cycle 36-39
// 측 AH2 row, 두 번째 row).
//
// 대상 fn (12 fn — 4 group, fn_kind 0..11 canonical map):
//   PATH      (4): SHGetFolderPathW(0) / SHGetSpecialFolderPathW(1) / PathCombineW(2) /
//                  PathAppendW(3)
//   PROCESS   (3): ShellExecuteW(4) / ShellExecuteExW(5) / FindExecutableW(6)
//   DRAG_DROP (3): DragAcceptFiles(7) / DragQueryFileW(8) / DragFinish(9)
//   MISC      (2): SHCreateDirectoryExW(10) / SHGetFileInfoW(11)
//
// synthetic CSIDL 4 byte LE: CSIDL_PERSONAL 0x00000005 (Documents), CSIDL_APPDATA 0x0000001A,
//   CSIDL_LOCAL_APPDATA 0x0000001C, CSIDL_PROGRAM_FILES 0x00000026.
// synthetic path WCHAR* 0x91010100 → "C:\\Users\\D2R\\Saved Games\\Diablo II Resurrected\\" UTF-16 LE.
// synthetic SHFILEINFO 696 byte (HICON hIcon@0+4 + iIcon@4+4 + dwAttributes@8+4 + szDisplayName@12+520
//   WCHAR[260] + szTypeName@532+160 WCHAR[80]) at 0x91020000 — synth dwAttributes 0x00000080
//   (SFGAO_FILESYSTEM), szTypeName "D2R Save File".
// synthetic HDROP 0x91030000 (drag-drop handle), DragQueryFileW return synth: count 2,
//   filenames "C:\\save1.d2s" "C:\\save2.d2s".
// synthetic HINSTANCE return: ShellExecuteW success > 32 (synth 33 = 0x00000021).
//
// persist schema (TSV — 4 table): syscall_invoke / shell_path_event / shell_exec_event / drag_drop_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn psh_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_shell32_core"
}

fn psh_syscall_invoke_path() -> str {
    return psh_dir() + "/syscall_invoke.tsv"
}

fn psh_shell_path_event_path() -> str {
    return psh_dir() + "/shell_path_event.tsv"
}

fn psh_shell_exec_event_path() -> str {
    return psh_dir() + "/shell_exec_event.tsv"
}

fn psh_drag_drop_event_path() -> str {
    return psh_dir() + "/drag_drop_event.tsv"
}

fn psh_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + psh_dir() + "'")
}

fn cleanup_psh() -> void {
    psh_ensure_dir()
    let _ = exec("rm -f '" + psh_syscall_invoke_path() + "' '" + psh_shell_path_event_path()
        + "' '" + psh_shell_exec_event_path() + "' '" + psh_drag_drop_event_path() + "'")
}

// ─── 공통 file IO ───
fn psh_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn psh_append_row(path: str, row: str) -> void {
    psh_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn psh_count_rows(path: str, min_cols: int) -> int {
    let t = psh_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "SHGetFolderPathW" }
    if k == 1 { return "SHGetSpecialFolderPathW" }
    if k == 2 { return "PathCombineW" }
    if k == 3 { return "PathAppendW" }
    if k == 4 { return "ShellExecuteW" }
    if k == 5 { return "ShellExecuteExW" }
    if k == 6 { return "FindExecutableW" }
    if k == 7 { return "DragAcceptFiles" }
    if k == 8 { return "DragQueryFileW" }
    if k == 9 { return "DragFinish" }
    if k == 10 { return "SHCreateDirectoryExW" }
    if k == 11 { return "SHGetFileInfoW" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "path"
        }
    }
    if k >= 4 {
        if k <= 6 {
            return "process"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "drag_drop"
        }
    }
    if k >= 10 {
        if k <= 11 {
            return "misc"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: SHELL32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_shell32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_shell32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_shell32_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_shell32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_shell32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    psh_append_row(psh_syscall_invoke_path(), row)
}

// ─── record_shell_path_event: SHGetFolderPathW/PathCombineW row ───
fn record_shell_path_event(evt_id: int, path_kind: str, csidl_hex: str, path_synth: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_shell32_core FAIL [record_shell_path_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if path_kind == "" {
        panic("pe_shell32_core FAIL [record_shell_path_event] expected=path_kind!=empty got=empty")
    }
    if csidl_hex == "" {
        panic("pe_shell32_core FAIL [record_shell_path_event] expected=csidl_hex!=empty got=empty")
    }
    if path_synth == "" {
        panic("pe_shell32_core FAIL [record_shell_path_event] expected=path_synth!=empty got=empty")
    }
    if status == "" {
        panic("pe_shell32_core FAIL [record_shell_path_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + path_kind + "\t" + csidl_hex + "\t"
        + path_synth + "\t" + status + "\n"
    psh_append_row(psh_shell_path_event_path(), row)
}

