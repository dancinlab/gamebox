// ─── record_drag_drop_event: DragAcceptFiles/QueryFile/Finish row ───
fn record_drag_drop_event(evt_id: int, drag_kind: str, hdrop_hex: str, file_count: int, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_shell32_core FAIL [record_drag_drop_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if drag_kind == "" {
        panic("pe_shell32_core FAIL [record_drag_drop_event] expected=drag_kind!=empty got=empty")
    }
    if hdrop_hex == "" {
        panic("pe_shell32_core FAIL [record_drag_drop_event] expected=hdrop_hex!=empty got=empty")
    }
    if file_count < 0 {
        panic("pe_shell32_core FAIL [record_drag_drop_event] expected=file_count>=0 got=" + to_string(file_count))
    }
    if status == "" {
        panic("pe_shell32_core FAIL [record_drag_drop_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + drag_kind + "\t" + hdrop_hex + "\t"
        + to_string(file_count) + "\t" + status + "\n"
    psh_append_row(psh_drag_drop_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return psh_count_rows(psh_syscall_invoke_path(), 4)
}

fn shell_path_event_count() -> int {
    return psh_count_rows(psh_shell_path_event_path(), 5)
}

fn shell_exec_event_count() -> int {
    return psh_count_rows(psh_shell_exec_event_path(), 5)
}

fn drag_drop_event_count() -> int {
    return psh_count_rows(psh_drag_drop_event_path(), 5)
}

fn psh_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(shell_path_event_count())
    out.push(shell_exec_event_count())
    out.push(drag_drop_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "psh-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_psh()

    // ─── 1. syscall_invoke × 12 (one per fn, 4 group coverage) ───
    //   PATH group (4)
    record_syscall_invoke(1, 0, "SHGetFolderPathW", "PARTIAL")
    println("__SHELL32__ PARTIAL SHGetFolderPathW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"SHGetFolderPathW\",\"fn_group\":\"path\",\"status\":\"PARTIAL\",\"csidl\":\"0x00000005\",\"csidl_kind\":\"CSIDL_PERSONAL\",\"path_buf_hex\":\"0x91010100\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\Documents\",\"hresult\":\"0x00000000\"")
    record_syscall_invoke(2, 1, "SHGetSpecialFolderPathW", "PARTIAL")
    println("__SHELL32__ PARTIAL SHGetSpecialFolderPathW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"SHGetSpecialFolderPathW\",\"fn_group\":\"path\",\"status\":\"PARTIAL\",\"csidl\":\"0x0000001A\",\"csidl_kind\":\"CSIDL_APPDATA\",\"path_buf_hex\":\"0x91010200\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\AppData\\\\Roaming\",\"return_synth\":\"TRUE\"")
    record_syscall_invoke(3, 2, "PathCombineW", "PARTIAL")
    println("__SHELL32__ PARTIAL PathCombineW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"PathCombineW\",\"fn_group\":\"path\",\"status\":\"PARTIAL\",\"dst_hex\":\"0x91010300\",\"dir_synth\":\"C:\\\\Users\\\\D2R\\\\Saved Games\",\"file_synth\":\"Diablo II Resurrected\",\"result_synth\":\"C:\\\\Users\\\\D2R\\\\Saved Games\\\\Diablo II Resurrected\"")
    record_syscall_invoke(4, 3, "PathAppendW", "PARTIAL")
    println("__SHELL32__ PARTIAL PathAppendW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"PathAppendW\",\"fn_group\":\"path\",\"status\":\"PARTIAL\",\"dst_hex\":\"0x91010300\",\"more_synth\":\"save.d2s\",\"result_synth\":\"C:\\\\Users\\\\D2R\\\\Saved Games\\\\Diablo II Resurrected\\\\save.d2s\",\"return_synth\":\"TRUE\"")

    //   PROCESS group (3)
    record_syscall_invoke(5, 4, "ShellExecuteW", "PARTIAL")
    println("__SHELL32__ PARTIAL ShellExecuteW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"ShellExecuteW\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00000000\",\"verb_synth\":\"open\",\"file_synth\":\"D2R.exe\",\"params_synth\":\"-launch\",\"show_cmd\":\"0x00000001\",\"hinstance_hex\":\"0x00000021\"")
    record_syscall_invoke(6, 5, "ShellExecuteExW", "PARTIAL")
    println("__SHELL32__ PARTIAL ShellExecuteExW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"ShellExecuteExW\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"shellexecuteinfo_hex\":\"0x91040000\",\"struct_bytes\":80,\"verb_synth\":\"open\",\"file_synth\":\"D2R.exe\",\"hinstance_hex\":\"0x00000021\",\"hprocess_hex\":\"0x91040100\",\"return_synth\":\"TRUE\"")
    record_syscall_invoke(7, 6, "FindExecutableW", "PARTIAL")
    println("__SHELL32__ PARTIAL FindExecutableW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"FindExecutableW\",\"fn_group\":\"process\",\"status\":\"PARTIAL\",\"file_synth\":\"save.d2s\",\"dir_synth\":\"C:\\\\Users\\\\D2R\",\"result_buf_hex\":\"0x91010400\",\"result_synth\":\"C:\\\\Program Files\\\\Diablo II Resurrected\\\\D2R.exe\",\"hinstance_hex\":\"0x00000021\"")

    //   DRAG_DROP group (3)
    record_syscall_invoke(8, 7, "DragAcceptFiles", "PARTIAL")
    println("__SHELL32__ PARTIAL DragAcceptFiles")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"DragAcceptFiles\",\"fn_group\":\"drag_drop\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00010000\",\"accept\":\"TRUE\",\"return_synth\":\"void\"")
    record_syscall_invoke(9, 8, "DragQueryFileW", "PARTIAL")
    println("__SHELL32__ PARTIAL DragQueryFileW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"DragQueryFileW\",\"fn_group\":\"drag_drop\",\"status\":\"PARTIAL\",\"hdrop_hex\":\"0x91030000\",\"file_index\":0,\"file_buf_hex\":\"0x91010500\",\"file_synth\":\"C:\\\\save1.d2s\",\"return_synth\":12")
    record_syscall_invoke(10, 9, "DragFinish", "PARTIAL")
    println("__SHELL32__ PARTIAL DragFinish")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"DragFinish\",\"fn_group\":\"drag_drop\",\"status\":\"PARTIAL\",\"hdrop_hex\":\"0x91030000\",\"return_synth\":\"void\"")

    //   MISC group (2)
    record_syscall_invoke(11, 10, "SHCreateDirectoryExW", "PARTIAL")
    println("__SHELL32__ PARTIAL SHCreateDirectoryExW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"SHCreateDirectoryExW\",\"fn_group\":\"misc\",\"status\":\"PARTIAL\",\"hwnd_hex\":\"0x00000000\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\Saved Games\\\\Diablo II Resurrected\\\\Mods\",\"sec_attrs_hex\":\"0x00000000\",\"return_synth\":\"ERROR_SUCCESS_0x00000000\"")
    record_syscall_invoke(12, 11, "SHGetFileInfoW", "PARTIAL")
    println("__SHELL32__ PARTIAL SHGetFileInfoW")
    r0_emit("pe_shell32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"SHGetFileInfoW\",\"fn_group\":\"misc\",\"status\":\"PARTIAL\",\"path_synth\":\"save.d2s\",\"shfileinfo_hex\":\"0x91020000\",\"struct_bytes\":696,\"flags\":\"0x00000400\",\"flags_kind\":\"SHGFI_TYPENAME\",\"sztypename_synth\":\"D2R Save File\",\"dwattributes\":\"0x00000080\",\"return_synth\":1")

    // ─── 2. shell_path_event × 4 (folder/special_folder/combine/append) ───
    record_shell_path_event(1, "folder_personal", "0x00000005", "C:\\Users\\D2R\\Documents", "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"shell_path_event\",\"evt_id\":1,\"path_kind\":\"folder_personal\",\"csidl_hex\":\"0x00000005\",\"csidl_kind\":\"CSIDL_PERSONAL\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\Documents\",\"path_buf_hex\":\"0x91010100\",\"hresult\":\"0x00000000\",\"status\":\"PARTIAL\"")
    record_shell_path_event(2, "folder_appdata", "0x0000001A", "C:\\Users\\D2R\\AppData\\Roaming", "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"shell_path_event\",\"evt_id\":2,\"path_kind\":\"folder_appdata\",\"csidl_hex\":\"0x0000001A\",\"csidl_kind\":\"CSIDL_APPDATA\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\AppData\\\\Roaming\",\"path_buf_hex\":\"0x91010200\",\"return_synth\":\"TRUE\",\"status\":\"PARTIAL\"")
    record_shell_path_event(3, "combine", "n/a", "C:\\Users\\D2R\\Saved Games\\Diablo II Resurrected", "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"shell_path_event\",\"evt_id\":3,\"path_kind\":\"combine\",\"csidl_hex\":\"n/a\",\"dir_synth\":\"C:\\\\Users\\\\D2R\\\\Saved Games\",\"file_synth\":\"Diablo II Resurrected\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\Saved Games\\\\Diablo II Resurrected\",\"dst_hex\":\"0x91010300\",\"status\":\"PARTIAL\"")
    record_shell_path_event(4, "append", "n/a", "C:\\Users\\D2R\\Saved Games\\Diablo II Resurrected\\save.d2s", "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"shell_path_event\",\"evt_id\":4,\"path_kind\":\"append\",\"csidl_hex\":\"n/a\",\"more_synth\":\"save.d2s\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\Saved Games\\\\Diablo II Resurrected\\\\save.d2s\",\"dst_hex\":\"0x91010300\",\"return_synth\":\"TRUE\",\"status\":\"PARTIAL\"")

    // ─── 3. shell_exec_event × 3 (open/exec_ex/find) ───
    record_shell_exec_event(1, "open_d2r", "open", "0x00000021", "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"shell_exec_event\",\"evt_id\":1,\"exec_kind\":\"open_d2r\",\"verb_synth\":\"open\",\"file_synth\":\"D2R.exe\",\"hinstance_hex\":\"0x00000021\",\"hinstance_int\":33,\"success_threshold\":\">32\",\"status\":\"PARTIAL\"")
    record_shell_exec_event(2, "exec_ex_d2r", "open", "0x00000021", "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"shell_exec_event\",\"evt_id\":2,\"exec_kind\":\"exec_ex_d2r\",\"verb_synth\":\"open\",\"file_synth\":\"D2R.exe\",\"hinstance_hex\":\"0x00000021\",\"hprocess_hex\":\"0x91040100\",\"shellexecuteinfo_hex\":\"0x91040000\",\"return_synth\":\"TRUE\",\"status\":\"PARTIAL\"")
    record_shell_exec_event(3, "find_executable", "n/a", "0x00000021", "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"shell_exec_event\",\"evt_id\":3,\"exec_kind\":\"find_executable\",\"verb_synth\":\"n/a\",\"file_synth\":\"save.d2s\",\"result_synth\":\"C:\\\\Program Files\\\\Diablo II Resurrected\\\\D2R.exe\",\"hinstance_hex\":\"0x00000021\",\"status\":\"PARTIAL\"")

    // ─── 4. drag_drop_event × 3 (accept/query/finish) ───
    record_drag_drop_event(1, "accept", "0x00010000", 0, "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"drag_drop_event\",\"evt_id\":1,\"drag_kind\":\"accept\",\"hwnd_hex\":\"0x00010000\",\"hdrop_hex\":\"0x00010000\",\"accept\":\"TRUE\",\"file_count\":0,\"status\":\"PARTIAL\"")
    record_drag_drop_event(2, "query_count", "0x91030000", 2, "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"drag_drop_event\",\"evt_id\":2,\"drag_kind\":\"query_count\",\"hdrop_hex\":\"0x91030000\",\"file_index\":\"0xFFFFFFFF\",\"file_count\":2,\"return_synth\":2,\"status\":\"PARTIAL\"")
    record_drag_drop_event(3, "finish", "0x91030000", 0, "PARTIAL")
    r0_emit("pe_shell32_core_record", "\"kind\":\"drag_drop_event\",\"evt_id\":3,\"drag_kind\":\"finish\",\"hdrop_hex\":\"0x91030000\",\"file_count\":0,\"return_synth\":\"void\",\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 12 {
        panic("pe_shell32_core FAIL [syscall_invoke_count] expected=12 got=" + to_string(si))
    }
    let spe = shell_path_event_count()
    if spe != 4 {
        panic("pe_shell32_core FAIL [shell_path_event_count] expected=4 got=" + to_string(spe))
    }
    let see = shell_exec_event_count()
    if see != 3 {
        panic("pe_shell32_core FAIL [shell_exec_event_count] expected=3 got=" + to_string(see))
    }
    let dde = drag_drop_event_count()
    if dde != 3 {
        panic("pe_shell32_core FAIL [drag_drop_event_count] expected=3 got=" + to_string(dde))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "SHGetFolderPathW" { panic("pe_shell32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(3) != "PathAppendW" { panic("pe_shell32_core FAIL [fn_kind_name(3)]") }
    if fn_kind_name(4) != "ShellExecuteW" { panic("pe_shell32_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(7) != "DragAcceptFiles" { panic("pe_shell32_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(11) != "SHGetFileInfoW" { panic("pe_shell32_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_shell32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "path" { panic("pe_shell32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "process" { panic("pe_shell32_core FAIL [fn_group_name(4)]") }
    if fn_group_name(7) != "drag_drop" { panic("pe_shell32_core FAIL [fn_group_name(7)]") }
    if fn_group_name(10) != "misc" { panic("pe_shell32_core FAIL [fn_group_name(10)]") }
    if fn_group_name(99) != "unknown" { panic("pe_shell32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = psh_stats()
    if len(s) != 4 { panic("pe_shell32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 12 { panic("pe_shell32_core FAIL [stats syscall_invoke_count] expected=12 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_shell32_core FAIL [stats shell_path_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_shell32_core FAIL [stats shell_exec_event_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_shell32_core FAIL [stats drag_drop_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_shell32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"shell_path_event_count\":" + to_string(s[1])
        + ",\"shell_exec_event_count\":" + to_string(s[2])
        + ",\"drag_drop_event_count\":" + to_string(s[3]))

    r0_emit("pe_shell32_core_summary",
        "\"target\":\"SHELL32.dll\",\"fn_total\":12,\"fn_emit_partial\":12,\"groups\":[\"path\",\"process\",\"drag_drop\",\"misc\"],\"shfileinfo_synth_bytes\":696,\"csidl_constants\":[\"0x00000005_PERSONAL\",\"0x0000001A_APPDATA\",\"0x0000001C_LOCAL_APPDATA\",\"0x00000026_PROGRAM_FILES\"],\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_shell32_core_kpi",
        "\"path_emits\":4,\"process_emits\":3,\"drag_drop_emits\":3,\"misc_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"shell_dependency_unblock_partial\":true")

    // ─── cycle 36 → 37 SHELL32 coverage progression evidence emit ───
    r0_emit("pe_shell32_core_coverage_progression",
        "\"surface\":\"SHELL32_full_435_fn\",\"cycle_36_count\":144,\"cycle_37_count\":156,\"delta\":12,\"cycle_36_percent\":33.10,\"cycle_37_percent\":35.86,\"cycle_37_module\":\"pe_shell32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_ah2_cycle_increment\":12")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_shell32_core_round_trip_matrix",
        "\"surface\":\"SHELL32_core_12_fn\",\"fn_partial\":12,\"fn_groups\":4,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real SHGetFolderPathW + ShellExecuteW + DragQueryFileW = NSWorkspace + LSOpenURLsWithRole + NSFileManager bridge pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"shell_dependency\":\"D2R install path resolution + save folder discovery + launcher invocation\"")

    // ─── Track AH2 expansion emit (cycle 37, SHELL32 +12 fn) ───
    r0_emit("pe_shell32_core_ah2_expansion",
        "\"track\":\"AH2\",\"cycle\":37,\"surface\":\"SHELL32_new\",\"new_fn\":12,\"groups\":[\"path\",\"process\",\"drag_drop\",\"misc\"],\"path_count\":4,\"process_count\":3,\"drag_drop_count\":3,\"misc_count\":2,\"emit_format\":\"__SHELL32__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_ah_bundled_part_2_of_4\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_shell32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_psh()
    let s2 = psh_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_shell32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_shell32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", shell_path_event=" + to_string(s[1])
        + ", shell_exec_event=" + to_string(s[2]) + ", drag_drop_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = psh_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("shell_path_event_count\t" + to_string(s[1]))
            println("shell_exec_event_count\t" + to_string(s[2]))
            println("drag_drop_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_shell32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_shell32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_psh()
            println("cleaned: " + psh_dir())
            return
        }
        if sub == "dir" {
            println(psh_dir())
            return
        }
    }
    println("usage: hexa run pe_shell32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
