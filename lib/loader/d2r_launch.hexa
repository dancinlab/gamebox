// lib/loader/d2r_launch.hexa — Phase 9 — D2R (Diablo II: Resurrected) launch path skeleton
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — 공식 spec / 공개 정보:
//     - PE format:    https://learn.microsoft.com/en-us/windows/win32/debug/pe-format
//     - DirectX 11:   https://learn.microsoft.com/en-us/windows/win32/direct3d11/
//     - D2R system:   공개 system requirements (Blizzard 공식 페이지 — 인용 only)
//   Wine source 단 1 줄도 import / copy / port 금지.
//   D2R binary / asset 본 skeleton 에 포함 ❌. validate_d2r_path 는 path 만 받아 검증.
//
// own 2 mandate:
//   - r0_emit ≥ 1 (실제 = 3: d2r_info + d2r_phase_deps + d2r_scenarios)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("d2r_launch FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase 9 — skeleton):
//   D2R launch path 의 *meta-data* 만 정의:
//     - d2r_info()           — 게임 식별 정보 (name / dx / platform / dll deps)
//     - d2r_phase_deps()     — Phase 0a~6 모듈 의존성 매트릭스
//     - d2r_dx_requirements()— DirectX / GPU 요구사항 문자열
//     - d2r_scenarios()      — 시작~게임 진입 시나리오 목록
//     - validate_d2r_path()  — D2R.exe path 검증 (synthetic — 부재 시 [false,false,false])
//
//   실제 launch trampoline (PE map → IAT resolve → entry jump) 은 Phase 9 후속.
//   본 skeleton 은 의존성 그래프 + 시나리오 정의 만 담당.

use "../perf/r0_common"

// ─── D2R 게임 정보 ───
//
// multi-line key=value 형식. parser 는 "\n" split + "=" split.
// 필드:
//   name       — 사람-읽기 이름 (Diablo II: Resurrected)
//   dx_path    — 사용 DirectX 경로 (DX11)
//   platform   — binary architecture (x86_64)
//   dll_deps   — 필수 의존 DLL 목록 ("+" 로 구분)
fn d2r_info() -> str {
    let s = ""
    s = s + "name=Diablo II: Resurrected\n"
    s = s + "dx_path=DX11\n"
    s = s + "platform=x86_64\n"
    s = s + "dll_deps=KERNEL32+USER32+GDI32+ADVAPI32+D3D11+WS2_32"
    return s
}

// ─── Phase 0a~6 모듈 의존성 ───
//
//   반환: array of [phase_module_name, required_flag]
//   required_flag:
//     "required" — D2R launch 에 반드시 필요
//     "optional" — 있으면 좋지만 부재 시 fallback 가능
//
//   Phase 매핑 (핵심 의존성):
//     Phase 0a  pe_parser       — PE 헤더 파싱 (D2R.exe 분석)
//     Phase 0a  pe_loader       — PE 섹션 mmap + relocation
//     Phase 0a  pe_imports      — IAT 해석
//     Phase 0a  pe_relocations  — base relocation 적용
//     Phase 1   win32_abi       — x86_64 Win64 ABI ↔ macOS SysV ABI 어댑터
//     Phase 3a  win32_kernel32  — kernel32 함수 mapping
//     Phase 3b  win32_user32    — user32 함수 mapping (창 / 메시지)
//     Phase 3c  win32_gdi32     — gdi32 함수 mapping (그래픽 객체)
//     Phase 3d  win32_advapi32  — advapi32 함수 mapping (registry)
//     Phase 3e  win32_winsock   — ws2_32 함수 mapping (Battle.net 연결)
//     Phase 6   dx_d3d11        — D3D11 ↔ Metal 어댑터 (D2R 핵심)
fn d2r_phase_deps() -> array {
    let mut deps = []
    // Phase 0a — PE 처리
    deps.push(["pe_parser", "required"])
    deps.push(["pe_loader", "required"])
    deps.push(["pe_imports", "required"])
    deps.push(["pe_relocations", "required"])
    // Phase 1 — ABI
    deps.push(["win32_abi", "required"])
    // Phase 3 — Win32 DLL mappings
    deps.push(["win32_kernel32", "required"])
    deps.push(["win32_user32", "required"])
    deps.push(["win32_gdi32", "required"])
    deps.push(["win32_advapi32", "required"])
    deps.push(["win32_winsock", "optional"])
    // Phase 6 — DirectX
    deps.push(["dx_d3d11", "required"])
    return deps
}

// ─── D2R DirectX / GPU 요구사항 ───
//
// 공개 system requirements 인용:
//   - Minimum:  DirectX 11, GPU memory 2GB
//   - Recommended: DirectX 12 capable, GPU memory 4GB+
//   본 skeleton 은 minimum-functional 기준 = DX11 + 4GB (안정 동작).
fn d2r_dx_requirements() -> str {
    return "DirectX 11 + GPU memory >= 4GB"
}

// ─── D2R 시나리오 정의 ───
//
//   각 시나리오 = [name, description] (짧은 string).
//   시나리오는 launch path validation 용 *체크포인트*:
//     intro            — splash + main menu
//     character_select — 캐릭터 선택 화면
//     act1_camp        — Act 1 Rogue Encampment (game world 진입)
//     act1_blood_moor  — first outdoor zone (실제 game loop 시작)
//     waypoint         — waypoint 시스템 (zone transition)
fn d2r_scenarios() -> array {
    let mut sc = []
    sc.push(["intro", "splash + menu"])
    sc.push(["character_select", "character creation / selection"])
    sc.push(["act1_camp", "Act 1 Rogue Encampment"])
    sc.push(["act1_blood_moor", "Blood Moor — first outdoor zone"])
    sc.push(["waypoint", "waypoint zone transition"])
    return sc
}

// ─── D2R.exe path 검증 (synthetic) ───
//
//   반환: [exists, is_pe, has_d3d11_imports]
//   각 element = bool (true / false).
//
//   실제 D2R.exe 부재 시 모든 entry false.
//   exists       — 파일 존재 여부 (test -f)
//   is_pe        — PE signature ("MZ" + "PE\0\0") 검증 (skeleton — exists 만 의존)
//   has_d3d11_imports — IAT 에 D3D11.DLL import 포함 여부 (skeleton — exists 만 의존)
//
//   Phase 9 후속:
//     pe_parser.parse(d2r_exe) → headers
//     pe_imports.scan(d2r_exe) → import DLL list → "D3D11" 검색
//   본 skeleton 은 path existence 만 사용 (실제 D2R 부재 환경에서 SKIP 동작).
fn validate_d2r_path(d2r_exe: str) -> array {
    let mut r = []
    // 1. exists — test -f
    let exists_str = exec("test -f '" + d2r_exe + "' && echo yes || echo no").trim()
    let exists = exists_str == "yes"
    r.push(exists)
    // 2. is_pe — exists 시 첫 2 byte "MZ" 검증, 아니면 false
    let is_pe = false
    if exists {
        let mz = exec("head -c 2 '" + d2r_exe + "' 2>/dev/null").trim()
        if mz == "MZ" {
            // is_pe = true (skeleton — DOS header offset 0x3C 의 PE\0\0 검사는 후속)
        }
    }
    r.push(is_pe)
    // 3. has_d3d11_imports — skeleton: 실제 IAT 파싱 부재 → 항상 false
    //    Phase 9 후속에서 pe_imports module 호출로 교체.
    r.push(false)
    return r
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "d2rlnch-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. d2r_info() contains "Diablo II" + "DX11" + "x86_64"
    let info = d2r_info()
    if info.index_of("Diablo II") < 0 {
        panic("d2r_launch FAIL [info Diablo II] expected=contains got=" + info)
    }
    if info.index_of("DX11") < 0 {
        panic("d2r_launch FAIL [info DX11] expected=contains got=" + info)
    }
    if info.index_of("x86_64") < 0 {
        panic("d2r_launch FAIL [info x86_64] expected=contains got=" + info)
    }

    // 2. d2r_phase_deps() ≥ 6 phases listed
    let deps = d2r_phase_deps()
    let dn = len(deps)
    if dn < 6 {
        panic("d2r_launch FAIL [phase_deps count] expected=>=6 got=" + to_string(dn))
    }
    // 각 entry = [name, flag] — 2-tuple 검증
    let i = 0
    while i < dn {
        let e = deps[i]
        if len(e) < 2 {
            panic("d2r_launch FAIL [phase_deps shape] expected=2-tuple got=" + to_string(len(e)) + " at i=" + to_string(i))
        }
        i = i + 1
    }

    // 3. d2r_dx_requirements() contains "DirectX 11"
    let dx = d2r_dx_requirements()
    if dx.index_of("DirectX 11") < 0 {
        panic("d2r_launch FAIL [dx_requirements] expected=contains DirectX 11 got=" + dx)
    }

    // 4. d2r_scenarios() ≥ 3 scenarios
    let sc = d2r_scenarios()
    let sn = len(sc)
    if sn < 3 {
        panic("d2r_launch FAIL [scenarios count] expected=>=3 got=" + to_string(sn))
    }

    // 5. validate_d2r_path("/nonexistent.exe") → [false, false, false]
    let v = validate_d2r_path("/nonexistent.exe")
    if len(v) != 3 {
        panic("d2r_launch FAIL [validate length] expected=3 got=" + to_string(len(v)))
    }
    if v[0] != false {
        panic("d2r_launch FAIL [validate exists] expected=false got=true")
    }
    if v[1] != false {
        panic("d2r_launch FAIL [validate is_pe] expected=false got=true")
    }
    if v[2] != false {
        panic("d2r_launch FAIL [validate has_d3d11_imports] expected=false got=true")
    }

    // 6a. r0_emit "d2r_info" — info string 의 첫 라인 (name=...) 만 payload 로
    let lines = info.split("\n")
    let name_line = ""
    if len(lines) >= 1 {
        name_line = lines[0]
    }
    r0_emit("d2r_info",
        "\"name_line\":\"" + name_line + "\",\"dx\":\"DX11\",\"platform\":\"x86_64\"")

    // 6b. r0_emit "d2r_phase_deps" — 의존성 phase 수
    let req_count = 0
    let opt_count = 0
    let j = 0
    while j < dn {
        if deps[j][1] == "required" {
            req_count = req_count + 1
        }
        if deps[j][1] == "optional" {
            opt_count = opt_count + 1
        }
        j = j + 1
    }
    r0_emit("d2r_phase_deps",
        "\"total\":" + to_string(dn)
        + ",\"required\":" + to_string(req_count)
        + ",\"optional\":" + to_string(opt_count))

    // 6c. r0_emit "d2r_scenarios" — scenario 수
    r0_emit("d2r_scenarios",
        "\"count\":" + to_string(sn))

    // R0 emit count 검증 — 정확히 3 events
    let emit_n = r0_session_count(sid)
    if emit_n != 3 {
        panic("d2r_launch FAIL [r0 emit count] expected=3 got=" + to_string(emit_n))
    }

    println("  ✅ d2r_launch self_test PASS ("
        + to_string(dn) + " phase deps, "
        + to_string(req_count) + " required, "
        + to_string(sn) + " scenarios, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "info" {
            print(d2r_info())
            println("")
            return
        }
        if sub == "deps" {
            let deps = d2r_phase_deps()
            let n = len(deps)
            let i = 0
            while i < n {
                println(deps[i][0] + "\t" + deps[i][1])
                i = i + 1
            }
            return
        }
        if sub == "dx" {
            println(d2r_dx_requirements())
            return
        }
        if sub == "scenarios" {
            let sc = d2r_scenarios()
            let n = len(sc)
            let i = 0
            while i < n {
                println(sc[i][0] + "\t" + sc[i][1])
                i = i + 1
            }
            return
        }
        if sub == "validate" {
            if len(a) >= 4 {
                let path = a[3]
                let v = validate_d2r_path(path)
                let exists_s = "false"
                if v[0] { exists_s = "true" }
                let is_pe_s = "false"
                if v[1] { is_pe_s = "true" }
                let d3d11_s = "false"
                if v[2] { d3d11_s = "true" }
                println("exists=" + exists_s + "\tis_pe=" + is_pe_s + "\thas_d3d11_imports=" + d3d11_s)
                return
            }
        }
    }
    println("usage: hexa run d2r_launch.hexa { self-test | info | deps | dx | scenarios | validate <path> }")
}
