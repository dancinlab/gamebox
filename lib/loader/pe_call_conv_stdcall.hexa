// lib/loader/pe_call_conv_stdcall.hexa — cycle68 i386 stdcall adapter telemetry skeleton
//
// i386 stdcall ABI: 모든 인자는 stack 으로 전달 (right-to-left), callee 가
// return 시 stack 을 정리 (RET imm16). param_bytes = sum of slot sizes,
// ret_bytes = callee 가 정리해야 하는 byte 수 (typically == param_bytes).
// arm64 AAPCS adapter 는 stack 에 spill 된 i386 인자를 x0..x7 + stack 으로
// rebalance 하고 return path 에서 stack imm16 cleanup 을 emulate.
// 본 module 은 call site adapter telemetry tracker — 실제 stack walk /
// RET imm16 decode 호출 X (cycle69+).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   stdcall stack cleanup logic 은 Microsoft __stdcall ABI spec 기반 자체 구현.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// param_bytes / ret_bytes 단위: byte (4-byte aligned slot 가정, 본 skeleton 은
// 단순 sum 만 보존 — alignment 검증은 cycle69+).
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t param_count<int> \t param_bytes<int> \t ret_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pccs_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_call_conv_stdcall"
}

fn pccs_calls_path() -> str {
    return pccs_dir() + "/calls.tsv"
}

fn pccs_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pccs_dir() + "'")
}

fn cleanup_pccs() -> void {
    pccs_ensure_dir()
    let _ = exec("rm -f '" + pccs_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pccs_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pccs_append_row(path: str, row: str) -> void {
    pccs_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: stdcall site 1 건 기록 ───
fn record_call(call_id: int, param_count: int, param_bytes: int, ret_bytes: int) -> void {
    if call_id <= 0 {
        panic("pe_call_conv_stdcall FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if param_count < 0 {
        panic("pe_call_conv_stdcall FAIL [record_call] expected=param_count>=0 got=" + to_string(param_count))
    }
    if param_bytes < 0 {
        panic("pe_call_conv_stdcall FAIL [record_call] expected=param_bytes>=0 got=" + to_string(param_bytes))
    }
    if ret_bytes < 0 {
        panic("pe_call_conv_stdcall FAIL [record_call] expected=ret_bytes>=0 got=" + to_string(ret_bytes))
    }
    if ret_bytes > param_bytes {
        panic("pe_call_conv_stdcall FAIL [record_call] expected=ret_bytes<=param_bytes got="
            + to_string(ret_bytes) + ">" + to_string(param_bytes))
    }
    let row = to_string(call_id) + "\t" + to_string(param_count)
        + "\t" + to_string(param_bytes) + "\t" + to_string(ret_bytes) + "\n"
    pccs_append_row(pccs_calls_path(), row)
}

// ─── call_count: total call site 수 ───
fn call_count() -> int {
    let t = pccs_read_table(pccs_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_param_bytes: 모든 call 의 param_bytes 합 ───
fn total_param_bytes() -> int {
    let t = pccs_read_table(pccs_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_ret_bytes: 모든 call 의 ret_bytes 합 ───
fn total_ret_bytes() -> int {
    let t = pccs_read_table(pccs_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_param_count: 특정 param_count 의 call 수 ───
fn count_by_param_count(pc: int) -> int {
    let t = pccs_read_table(pccs_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == pc {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_param_bytes: 특정 call_id 의 param_bytes (없으면 0) ───
fn call_param_bytes(call_id: int) -> int {
    let t = pccs_read_table(pccs_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pccs_stats: [call_count, total_param_bytes, total_ret_bytes, count_by_param_count(4)] ───
fn pccs_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_param_bytes())
    out.push(total_ret_bytes())
    out.push(count_by_param_count(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pccs-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pccs()

    // 2. record 5 stdcall sites — param_count 0/1/2/4/6, param_bytes = pc*4,
    //    ret_bytes == param_bytes (callee cleans stack via RET imm16).
    //   call 681001: 0 params (pb=0  rb=0)   — void()
    //   call 681002: 1 param  (pb=4  rb=4)   — RET 4
    //   call 681003: 2 params (pb=8  rb=8)   — RET 8
    //   call 681004: 4 params (pb=16 rb=16)  — RET 16
    //   call 681005: 6 params (pb=24 rb=24)  — RET 24
    record_call(681001, 0, 0, 0)
    r0_emit("pe_call_conv_stdcall_record",
        "\"call_id\":681001,\"param_count\":0,\"param_bytes\":0,\"ret_bytes\":0,\"target\":\"void\"")

    record_call(681002, 1, 4, 4)
    r0_emit("pe_call_conv_stdcall_record",
        "\"call_id\":681002,\"param_count\":1,\"param_bytes\":4,\"ret_bytes\":4,\"target\":\"ret4\"")

    record_call(681003, 2, 8, 8)
    r0_emit("pe_call_conv_stdcall_record",
        "\"call_id\":681003,\"param_count\":2,\"param_bytes\":8,\"ret_bytes\":8,\"target\":\"ret8\"")

    record_call(681004, 4, 16, 16)
    r0_emit("pe_call_conv_stdcall_record",
        "\"call_id\":681004,\"param_count\":4,\"param_bytes\":16,\"ret_bytes\":16,\"target\":\"ret16\"")

    record_call(681005, 6, 24, 24)
    r0_emit("pe_call_conv_stdcall_record",
        "\"call_id\":681005,\"param_count\":6,\"param_bytes\":24,\"ret_bytes\":24,\"target\":\"ret24\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("pe_call_conv_stdcall FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. total_param_bytes = 0+4+8+16+24 = 52
    let tpb = total_param_bytes()
    if tpb != 52 {
        panic("pe_call_conv_stdcall FAIL [total_param_bytes] expected=52 got=" + to_string(tpb))
    }

    // 5. total_ret_bytes = 0+4+8+16+24 = 52
    let trb = total_ret_bytes()
    if trb != 52 {
        panic("pe_call_conv_stdcall FAIL [total_ret_bytes] expected=52 got=" + to_string(trb))
    }

    // 6. count_by_param_count sanity
    let pc0 = count_by_param_count(0)
    if pc0 != 1 {
        panic("pe_call_conv_stdcall FAIL [count_by_param_count(0)] expected=1 got=" + to_string(pc0))
    }
    let pc1 = count_by_param_count(1)
    if pc1 != 1 {
        panic("pe_call_conv_stdcall FAIL [count_by_param_count(1)] expected=1 got=" + to_string(pc1))
    }
    let pc2 = count_by_param_count(2)
    if pc2 != 1 {
        panic("pe_call_conv_stdcall FAIL [count_by_param_count(2)] expected=1 got=" + to_string(pc2))
    }
    let pc4 = count_by_param_count(4)
    if pc4 != 1 {
        panic("pe_call_conv_stdcall FAIL [count_by_param_count(4)] expected=1 got=" + to_string(pc4))
    }
    let pc6 = count_by_param_count(6)
    if pc6 != 1 {
        panic("pe_call_conv_stdcall FAIL [count_by_param_count(6)] expected=1 got=" + to_string(pc6))
    }
    let pc99 = count_by_param_count(99)
    if pc99 != 0 {
        panic("pe_call_conv_stdcall FAIL [count_by_param_count(99)] expected=0 got=" + to_string(pc99))
    }

    // 7. call_param_bytes sanity
    let b2 = call_param_bytes(681002)
    if b2 != 4 {
        panic("pe_call_conv_stdcall FAIL [call_param_bytes(681002)] expected=4 got=" + to_string(b2))
    }
    let b4 = call_param_bytes(681004)
    if b4 != 16 {
        panic("pe_call_conv_stdcall FAIL [call_param_bytes(681004)] expected=16 got=" + to_string(b4))
    }
    let b1 = call_param_bytes(681001)
    if b1 != 0 {
        panic("pe_call_conv_stdcall FAIL [call_param_bytes(681001)] expected=0 got=" + to_string(b1))
    }
    let b_miss = call_param_bytes(9999)
    if b_miss != 0 {
        panic("pe_call_conv_stdcall FAIL [call_param_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 8. pccs_stats() = [5, 52, 52, 1]
    let s = pccs_stats()
    if len(s) != 4 {
        panic("pe_call_conv_stdcall FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_call_conv_stdcall FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 52 {
        panic("pe_call_conv_stdcall FAIL [stats total_param_bytes] expected=52 got=" + to_string(s[1]))
    }
    if s[2] != 52 {
        panic("pe_call_conv_stdcall FAIL [stats total_ret_bytes] expected=52 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_call_conv_stdcall FAIL [stats count_param_count(4)] expected=1 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_call_conv_stdcall_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_param_bytes\":" + to_string(s[1])
        + ",\"total_ret_bytes\":" + to_string(s[2])
        + ",\"count_pc4\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_call_conv_stdcall FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pccs()
    let s2 = pccs_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_call_conv_stdcall FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_call_conv_stdcall self_test PASS (calls=" + to_string(s[0])
        + ", param_bytes=" + to_string(s[1]) + ", ret_bytes=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pccs_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_param_bytes\t" + to_string(s[1]))
            println("total_ret_bytes\t" + to_string(s[2]))
            println("count_param_count_4\t" + to_string(s[3]))
            return
        }
        if sub == "params" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_param_bytes\t" + to_string(call_param_bytes(cid)))
                return
            }
            println("usage: hexa run pe_call_conv_stdcall.hexa params <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pc = to_int(a[3])
                println("count_by_param_count\t" + to_string(count_by_param_count(pc)))
                return
            }
            println("usage: hexa run pe_call_conv_stdcall.hexa count <param_count>")
            return
        }
        if sub == "cleanup" {
            cleanup_pccs()
            println("cleaned: " + pccs_dir())
            return
        }
        if sub == "dir" {
            println(pccs_dir())
            return
        }
    }
    println("usage: hexa run pe_call_conv_stdcall.hexa { self-test | stats | params <call_id> | count <param_count> | cleanup | dir }")
}
