// lib/loader/win32_msimg32.hexa — Phase 4i — msimg32 GDI helper
//
// own 1: Wine 0. Microsoft GDI Image extension spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe msimg32 imports (실측):
//   AlphaBlend — alpha blending (GDI 보조)
//
// macOS 의 CGContext blend mode 와 동등. skeleton 단계는 mapping table 만.

use "../perf/r0_common"

fn msimg32_table() -> str {
    let t = ""
    t = t + "AlphaBlend\tCGContext_setBlendMode_alpha\tGDI_blend\tskeleton\n"
    return t
}

fn msimg32_table_size() -> int {
    let lines = msimg32_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = msimg32_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

fn self_test() -> void {
    let sid = "msimg32test-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = msimg32_table_size()
    if sz != 1 { panic("win32_msimg32 FAIL [size] expected=1 got=" + to_string(sz)) }

    let m = lookup_mapping("AlphaBlend")
    if !m.contains("blend") { panic("win32_msimg32 FAIL [lookup]") }

    r0_emit("msimg32_lookup", "\"name\":\"AlphaBlend\"")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_msimg32 FAIL [emit count]") }

    println("  ✅ win32_msimg32 self_test PASS (1 func, AlphaBlend → CGContext, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_mapping(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_msimg32.hexa { self-test | lookup <name> }")
}
