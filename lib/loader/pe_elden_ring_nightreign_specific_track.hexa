// lib/loader/pe_elden_ring_nightreign_specific_track.hexa — Elden Ring Nightreign 전용 entry/loader 추적.
//
// Elden Ring Nightreign (FromSoftware, 2025-05-30) standalone multiplayer co-op spinoff launch (own2 자체 추적):
//   process_attach          — nightreign.exe entry
//   fromsoft_engine_init    — Dantelion 2 engine (inherited from Elden Ring base) + DX12
//   eac_init                — Easy Anti-Cheat kernel driver (inherited, Apple 차단)
//   co_op_session_init      — 3-player co-op session lifecycle init
//   matchmaking_query       — FromSoft online matchmaking server query (online_required = 1)
//   3player_sync_handshake  — co-op 3-player sync state handshake
//   world_load              — co-op shared world streaming
//   first_frame             — DX12 swapchain Present (co-op variant)
//   session_terminate       — co-op session terminate / cleanup
//   결론: standalone (base game NOT required), multiplayer 차단 (Apple kernel mismatch
//         + FromSoft matchmaking server transitive). 사용자 directive 거부 — own1.
// own1: 공개 정보 + binary observation. Wine Nightreign wrapper / co-op mod 인용 X
//
// own 1 enforcement: 타사 Wine layer / community 코드 0 줄.
//   본 module 은 Nightreign-specific phase tracker — 실 nightreign.exe 실행 X.
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = process_attach          (nightreign.exe entry)
//   2 = fromsoft_engine_init    (Dantelion 2 + DX12 device create, inherited)
//   3 = eac_init                (EAC kernel driver — inherited from elden_ring base)
//   4 = co_op_session_init      (3-player co-op session lifecycle init, NEW)
//   5 = matchmaking_query       (FromSoft online matchmaking server query, NEW)
//   6 = 3player_sync_handshake  (co-op 3-player sync state, NEW)
//   7 = world_load              (co-op shared world streaming)
//   8 = first_frame             (DX12 swapchain Present, co-op variant)
//   9 = session_terminate       (co-op session terminate)
//
// online_required:
//   0 = offline launch 가능 (single-player practice mode 정도)
//   1 = online 강제 (EAC, matchmaking, multiplayer)
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t dll_loaded<int> \t online_required<int>
//
// Track BY (2026-05-05) documented this module as deferred to CG+ candidate;
// Track CM (2026-05-05) lands the skeleton-tier module per user closure directive.
//
// retired_intentional posture (inherited from elden_ring base via Track BY):
//   - blk.1 = EAC anti-tamper inherited (Track-C 2026-05-03 base, Track BY inherited)
//   - blk.2 = FromSoft co-op matchmaking new sub-class (Track BY 2026-05-05)

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn perst_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_elden_ring_nightreign_specific_track"
}

fn perst_steps_path() -> str {
    return perst_dir() + "/steps.tsv"
}

fn perst_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + perst_dir() + "'")
}

fn cleanup_perst() -> void {
    perst_ensure_dir()
    let _ = exec("rm -f '" + perst_steps_path() + "'")
}

// ─── 공통 file IO ───
fn perst_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn perst_append_row(path: str, row: str) -> void {
    perst_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_step: Nightreign launch step 1 건 기록 ───
fn record_step(step_id: int, phase_kind: int, dll_loaded: int, online_required: int) -> void {
    if step_id <= 0 {
        panic("pe_elden_ring_nightreign_specific_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_elden_ring_nightreign_specific_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 9 {
        panic("pe_elden_ring_nightreign_specific_track FAIL [record_step] expected=phase_kind<=9 got=" + to_string(phase_kind))
    }
    if dll_loaded < 0 || dll_loaded > 1 {
        panic("pe_elden_ring_nightreign_specific_track FAIL [record_step] expected=dll_loaded in {0,1} got=" + to_string(dll_loaded))
    }
    if online_required < 0 || online_required > 1 {
        panic("pe_elden_ring_nightreign_specific_track FAIL [record_step] expected=online_required in {0,1} got=" + to_string(online_required))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(dll_loaded) + "\t" + to_string(online_required) + "\n"
    perst_append_row(perst_steps_path(), row)
    r0_emit("pe_nightreign_record_step", "\"step\":" + to_string(step_id) + ",\"phase\":" + to_string(phase_kind) + ",\"dll\":" + to_string(dll_loaded) + ",\"online_required\":" + to_string(online_required))
}

fn step_count() -> int {
    let exists = exec("test -f '" + perst_steps_path() + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + perst_steps_path() + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

fn count_by_phase_kind(phase_kind: int) -> int {
    let exists = exec("test -f '" + perst_steps_path() + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v v=" + to_string(phase_kind) + " '$2==v {c++} END{print c+0}' '" + perst_steps_path() + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn count_online_required() -> int {
    let exists = exec("test -f '" + perst_steps_path() + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==1 {c++} END{print c+0}' '" + perst_steps_path() + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn nightreign_stats() -> array {
    return [step_count(), count_by_phase_kind(3), count_by_phase_kind(4), count_online_required()]
}

fn self_test() -> void {
    let sid = "pe-nightreign-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_perst()

    // 합성 9-step Nightreign launch sequence (skeleton-tier, retired_intentional posture):
    //   step 1 — process_attach (offline OK)
    //   step 2 — fromsoft_engine_init (offline OK)
    //   step 3 — eac_init (online_required = 1, kernel driver absent on Apple)
    //   step 4 — co_op_session_init (online_required = 1)
    //   step 5 — matchmaking_query (online_required = 1)
    //   step 6 — 3player_sync_handshake (online_required = 1)
    //   step 7 — world_load (online_required = 1, co-op shared world)
    //   step 8 — first_frame (offline OK if single-player practice mode)
    //   step 9 — session_terminate (offline OK)
    record_step(1, 1, 0, 0)
    record_step(2, 2, 1, 0)
    record_step(3, 3, 1, 1)
    record_step(4, 4, 1, 1)
    record_step(5, 5, 1, 1)
    record_step(6, 6, 1, 1)
    record_step(7, 7, 1, 1)
    record_step(8, 8, 1, 0)
    record_step(9, 9, 1, 0)

    let sc = step_count()
    if sc != 9 { panic("pe_elden_ring_nightreign_specific_track FAIL [step_count] expected=9 got=" + to_string(sc)) }

    // 3 = eac_init, 4 = co_op_session_init each 1 step
    let ec = count_by_phase_kind(3)
    if ec != 1 { panic("pe_elden_ring_nightreign_specific_track FAIL [eac_init count] expected=1 got=" + to_string(ec)) }
    let cc = count_by_phase_kind(4)
    if cc != 1 { panic("pe_elden_ring_nightreign_specific_track FAIL [co_op_init count] expected=1 got=" + to_string(cc)) }

    // online_required = 5 (steps 3..7)
    let or_count = count_online_required()
    if or_count != 5 { panic("pe_elden_ring_nightreign_specific_track FAIL [online_required count] expected=5 got=" + to_string(or_count)) }

    let stats = nightreign_stats()
    r0_emit("pe_nightreign_summary", "\"steps\":" + to_string(stats[0]) + ",\"eac_init\":" + to_string(stats[1]) + ",\"co_op_init\":" + to_string(stats[2]) + ",\"online_required\":" + to_string(stats[3]))

    // ─── synthetic Nightreign retired_intentional posture annotation (Track CM, inherited from BY) ───
    //
    // .roadmap.elden_ring_nightreign blk.1 = EAC anti-tamper inherited from elden_ring base
    // (Track-C 2026-05-03 + Track BY 2026-05-05 inherited).
    // .roadmap.elden_ring_nightreign blk.2 = FromSoft co-op matchmaking new sub-class
    // (Track BY 2026-05-05 documentation-only fan-out).
    // own1 Wine 0 + own2 honest emit, no AC bypass / no matchmaking server bypass.
    // cond.1/.2/.3 status `retired_intentional` (Track BY cascading flip from blk.1+blk.2 inheritance).
    r0_emit("pe_nightreign_retired_intentional",
        "\"stage\":\"nightreign_eac_plus_co_op_matchmaking_synthetic\",\"domain\":\"pe_elden_ring_nightreign_specific_track\",\"posture\":\"retired_intentional_inherited_plus_co_op\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"ac_bypass\":0,\"matchmaking_bypass\":0,\"blocker_ref_1\":\"elden_ring_nightreign.blk.1\",\"blocker_class_1\":\"eac_anti_tamper_inherited\",\"blocker_ref_2\":\"elden_ring_nightreign.blk.2\",\"blocker_class_2\":\"fromsoft_co_op_matchmaking\",\"adoption_iso\":\"2026-05-05\",\"adoption_track\":\"BY+CM\",\"verdict\":\"RETIRED_INTENTIONAL\"")
    println("__NIGHTREIGN_LAUNCH__ RETIRED_INTENTIONAL nightreign_eac_plus_co_op_matchmaking_synthetic")

    cleanup_perst()

    // 9 record + 1 summary + 1 retired_intentional posture = 11 emits
    let cnt = r0_session_count(sid)
    if cnt < 11 { panic("pe_elden_ring_nightreign_specific_track FAIL [emit count] expected>=11 got=" + to_string(cnt)) }

    println("  ✅ pe_elden_ring_nightreign_specific_track self_test PASS (9 steps, eac_init=1, co_op_init=1, online_required=5, sid=" + sid + ", emits=" + to_string(cnt) + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = nightreign_stats()
            println("steps=" + to_string(s[0]) + " eac_init=" + to_string(s[1]) + " co_op_init=" + to_string(s[2]) + " online_required=" + to_string(s[3]))
            return
        }
        if sub == "count_phase" {
            if len(a) >= 4 {
                let p = to_int(a[3])
                println(to_string(count_by_phase_kind(p)))
                return
            }
        }
        if sub == "cleanup" { cleanup_perst(); println("cleaned"); return }
    }
    println("usage: hexa run pe_elden_ring_nightreign_specific_track.hexa { self-test | stats | count_phase <kind> | cleanup }")
}
