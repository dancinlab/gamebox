// lib/loader/pe_syscall_table.hexa — Win32 system call number → handler dispatch
// telemetry skeleton (cycle 69). NT syscall table tracks resolved Native API
// calls dispatched through the loader.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 syscall dispatch tracker — 실 syscall() 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// category_kind code:
//   1 = file
//   2 = process
//   3 = memory
//   4 = registry
//   5 = object
//
// persist schema (TSV — dispatches.tsv):
//   dispatch_id<int> \t syscall_num<int> \t category_kind<int> \t elapsed_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pst_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_syscall_table"
}

fn pst_dispatches_path() -> str {
    return pst_dir() + "/dispatches.tsv"
}

fn pst_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pst_dir() + "'")
}

fn cleanup_pst() -> void {
    pst_ensure_dir()
    let _ = exec("rm -f '" + pst_dispatches_path() + "'")
}

// ─── 공통 file IO ───
fn pst_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pst_append_row(path: str, row: str) -> void {
    pst_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dispatch: syscall dispatch 1 건 기록 ───
fn record_dispatch(dispatch_id: int, syscall_num: int, category_kind: int, elapsed_us: int) -> void {
    if dispatch_id <= 0 {
        panic("pe_syscall_table FAIL [record_dispatch] expected=dispatch_id>0 got=" + to_string(dispatch_id))
    }
    if syscall_num < 0 {
        panic("pe_syscall_table FAIL [record_dispatch] expected=syscall_num>=0 got=" + to_string(syscall_num))
    }
    if category_kind < 1 {
        panic("pe_syscall_table FAIL [record_dispatch] expected=category_kind>=1 got=" + to_string(category_kind))
    }
    if category_kind > 5 {
        panic("pe_syscall_table FAIL [record_dispatch] expected=category_kind<=5 got=" + to_string(category_kind))
    }
    if elapsed_us < 0 {
        panic("pe_syscall_table FAIL [record_dispatch] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    let row = to_string(dispatch_id) + "\t" + to_string(syscall_num)
        + "\t" + to_string(category_kind) + "\t" + to_string(elapsed_us) + "\n"
    pst_append_row(pst_dispatches_path(), row)
}

// ─── dispatch_count: total dispatch 수 ───
fn dispatch_count() -> int {
    let t = pst_read_table(pst_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_elapsed_us: 모든 dispatch elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = pst_read_table(pst_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_category: 특정 category_kind 의 dispatch 수 ───
fn count_by_category(kind: int) -> int {
    let t = pst_read_table(pst_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_syscall_num: 특정 syscall_num 의 dispatch 수 ───
fn count_by_syscall_num(syscall_num: int) -> int {
    let t = pst_read_table(pst_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == syscall_num {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── dispatch_elapsed_us: 특정 dispatch_id 의 elapsed_us (없으면 0) ───
fn dispatch_elapsed_us(dispatch_id: int) -> int {
    let t = pst_read_table(pst_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == dispatch_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pst_stats: [dispatch_count, total_elapsed_us, count_by_category(1), count_by_category(3)] ───
fn pst_stats() -> array {
    let mut out = []
    out.push(dispatch_count())
    out.push(total_elapsed_us())
    out.push(count_by_category(1))
    out.push(count_by_category(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pst-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pst()

    // 2. record 5 dispatches (≥3 categories: file/process/memory/registry)
    record_dispatch(220001, 25, 1, 120)
    r0_emit("pe_syscall_table_record",
        "\"dispatch_id\":220001,\"syscall_num\":25,\"category_kind\":1,\"elapsed_us\":120,\"target\":\"file\"")

    record_dispatch(220002, 38, 2, 540)
    r0_emit("pe_syscall_table_record",
        "\"dispatch_id\":220002,\"syscall_num\":38,\"category_kind\":2,\"elapsed_us\":540,\"target\":\"process\"")

    record_dispatch(220003, 24, 3, 80)
    r0_emit("pe_syscall_table_record",
        "\"dispatch_id\":220003,\"syscall_num\":24,\"category_kind\":3,\"elapsed_us\":80,\"target\":\"memory\"")

    record_dispatch(220004, 25, 1, 200)
    r0_emit("pe_syscall_table_record",
        "\"dispatch_id\":220004,\"syscall_num\":25,\"category_kind\":1,\"elapsed_us\":200,\"target\":\"file\"")

    record_dispatch(220005, 12, 4, 360)
    r0_emit("pe_syscall_table_record",
        "\"dispatch_id\":220005,\"syscall_num\":12,\"category_kind\":4,\"elapsed_us\":360,\"target\":\"registry\"")

    // 3. dispatch_count = 5
    let c = dispatch_count()
    if c != 5 {
        panic("pe_syscall_table FAIL [dispatch_count] expected=5 got=" + to_string(c))
    }

    // 4. total_elapsed_us = 1300
    let te = total_elapsed_us()
    if te != 1300 {
        panic("pe_syscall_table FAIL [total_elapsed_us] expected=1300 got=" + to_string(te))
    }

    // 5. count_by_category sanity
    let k1 = count_by_category(1)
    if k1 != 2 {
        panic("pe_syscall_table FAIL [count_by_category(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_category(2)
    if k2 != 1 {
        panic("pe_syscall_table FAIL [count_by_category(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_category(3)
    if k3 != 1 {
        panic("pe_syscall_table FAIL [count_by_category(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_category(4)
    if k4 != 1 {
        panic("pe_syscall_table FAIL [count_by_category(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_category(5)
    if k5 != 0 {
        panic("pe_syscall_table FAIL [count_by_category(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_category(99)
    if k99 != 0 {
        panic("pe_syscall_table FAIL [count_by_category(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_syscall_num sanity (25 appears twice)
    let s25 = count_by_syscall_num(25)
    if s25 != 2 {
        panic("pe_syscall_table FAIL [count_by_syscall_num(25)] expected=2 got=" + to_string(s25))
    }
    let s38 = count_by_syscall_num(38)
    if s38 != 1 {
        panic("pe_syscall_table FAIL [count_by_syscall_num(38)] expected=1 got=" + to_string(s38))
    }
    let s_miss = count_by_syscall_num(9999)
    if s_miss != 0 {
        panic("pe_syscall_table FAIL [count_by_syscall_num(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 7. dispatch_elapsed_us sanity
    let e2 = dispatch_elapsed_us(220002)
    if e2 != 540 {
        panic("pe_syscall_table FAIL [dispatch_elapsed_us(220002)] expected=540 got=" + to_string(e2))
    }
    let e5 = dispatch_elapsed_us(220005)
    if e5 != 360 {
        panic("pe_syscall_table FAIL [dispatch_elapsed_us(220005)] expected=360 got=" + to_string(e5))
    }
    let e_miss = dispatch_elapsed_us(9999)
    if e_miss != 0 {
        panic("pe_syscall_table FAIL [dispatch_elapsed_us(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 8. pst_stats() = [5, 1300, 2, 1]
    let s = pst_stats()
    if len(s) != 4 {
        panic("pe_syscall_table FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_syscall_table FAIL [stats dispatch_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 1300 {
        panic("pe_syscall_table FAIL [stats total_elapsed_us] expected=1300 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_syscall_table FAIL [stats count_file] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_syscall_table FAIL [stats count_memory] expected=1 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_syscall_table_stats",
        "\"dispatch_count\":" + to_string(s[0])
        + ",\"total_elapsed_us\":" + to_string(s[1])
        + ",\"count_file\":" + to_string(s[2])
        + ",\"count_memory\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_syscall_table FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pst()
    let s2 = pst_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_syscall_table FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_syscall_table self_test PASS (dispatches=" + to_string(s[0])
        + ", elapsed_us=" + to_string(s[1]) + ", file=" + to_string(s[2])
        + ", memory=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pst_stats()
            println("dispatch_count\t" + to_string(s[0]))
            println("total_elapsed_us\t" + to_string(s[1]))
            println("count_file\t" + to_string(s[2]))
            println("count_memory\t" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("dispatch_elapsed_us\t" + to_string(dispatch_elapsed_us(did)))
                return
            }
            println("usage: hexa run pe_syscall_table.hexa elapsed <dispatch_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_category\t" + to_string(count_by_category(kind)))
                return
            }
            println("usage: hexa run pe_syscall_table.hexa count <category_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pst()
            println("cleaned: " + pst_dir())
            return
        }
        if sub == "dir" {
            println(pst_dir())
            return
        }
    }
    println("usage: hexa run pe_syscall_table.hexa { self-test | stats | elapsed <dispatch_id> | count <category_kind> | cleanup | dir }")
}
