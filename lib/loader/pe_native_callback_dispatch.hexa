// lib/loader/pe_native_callback_dispatch.hexa — stage3 native callback bridge skeleton
//
// Win32 stub 이 macOS native 호출 시 calling convention 변환. i386 stdcall/
// cdecl (caller cleanup) ↔ ARM64 (callee saves x19-x28). 본 파일은 dispatch
// 추적 — 실 ABI shim 은 stage4.

use "../perf/r0_common"

let PNCD_DIR = GAMEBOX_HOME + "/persist/pe_native_callback_dispatch"
let PNCD_TABLE = PNCD_DIR + "/dispatch.tsv"

fn pncd_dir() -> str { return PNCD_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + PNCD_DIR + "'")
}

fn append_row(row: str) -> void {
    ensure_dir()
    let tmp = PNCD_TABLE + ".tmp"
    write_file(tmp, row + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PNCD_TABLE + "' && rm -f '" + tmp + "'")
}

fn abi_name(kind: int) -> str {
    if kind == 1 { return "stdcall" }
    if kind == 2 { return "cdecl" }
    if kind == 3 { return "fastcall" }
    if kind == 4 { return "thiscall" }
    return "unknown"
}

// Schema (TSV): stub_id<int> | abi_kind<int> | args_count<int> | elapsed_us<int>
fn record_dispatch(stub_id: int, abi_kind: int, args_count: int, elapsed_us: int) -> void {
    append_row(to_string(stub_id) + "\t" + to_string(abi_kind) + "\t" + to_string(args_count) + "\t" + to_string(elapsed_us))
    r0_emit("pncd_dispatch", "\"stub_id\":" + to_string(stub_id) + ",\"abi\":\"" + abi_name(abi_kind) + "\",\"args\":" + to_string(args_count) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

fn table_exists() -> bool {
    let r = exec("test -f '" + PNCD_TABLE + "' && echo ok").trim()
    return r == "ok"
}

fn dispatch_count() -> int {
    if !table_exists() { return 0 }
    return to_int(exec("wc -l < '" + PNCD_TABLE + "' | tr -d ' '").trim())
}

fn total_args() -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END {print s+0}' '" + PNCD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn total_elapsed_us() -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END {print s+0}' '" + PNCD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn count_by_abi(kind: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$2==k {c++} END {print c+0}' '" + PNCD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn stub_dispatch_us(stub_id: int) -> int {
    if !table_exists() { return 0 }
    let s = exec("awk -F'\\t' -v sid=" + to_string(stub_id) + " '$1==sid {s+=$4} END {print s+0}' '" + PNCD_TABLE + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn pncd_stats() -> array {
    return [dispatch_count(), total_args(), count_by_abi(1), count_by_abi(2)]
}

fn cleanup_pncd() -> void {
    let _ = exec("rm -rf '" + PNCD_DIR + "'")
}

fn self_test() -> void {
    let sid = "pncd-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pncd()

    // 4 dispatches synthesis
    record_dispatch(82001, 1, 4, 60)   // stdcall 4 args (Win32 default)
    record_dispatch(82002, 2, 3, 50)   // cdecl 3 args (msvcrt)
    record_dispatch(82003, 1, 2, 40)   // stdcall 2 args
    record_dispatch(82004, 3, 6, 80)   // fastcall 6 args

    // dispatch_count
    let dc = dispatch_count()
    if dc != 4 { panic("pe_native_callback_dispatch FAIL [dispatch_count] expected=4 got=" + to_string(dc)) }

    // total_args
    let ta = total_args()
    if ta != 15 { panic("pe_native_callback_dispatch FAIL [total_args] expected=15 got=" + to_string(ta)) }

    // total_elapsed_us
    let te = total_elapsed_us()
    if te != 230 { panic("pe_native_callback_dispatch FAIL [total_elapsed_us] expected=230 got=" + to_string(te)) }

    // count_by_abi
    let c1 = count_by_abi(1)
    if c1 != 2 { panic("pe_native_callback_dispatch FAIL [count_by_abi 1] expected=2 got=" + to_string(c1)) }
    let c2 = count_by_abi(2)
    if c2 != 1 { panic("pe_native_callback_dispatch FAIL [count_by_abi 2] expected=1 got=" + to_string(c2)) }
    let c3 = count_by_abi(3)
    if c3 != 1 { panic("pe_native_callback_dispatch FAIL [count_by_abi 3] expected=1 got=" + to_string(c3)) }
    let c4 = count_by_abi(4)
    if c4 != 0 { panic("pe_native_callback_dispatch FAIL [count_by_abi 4] expected=0 got=" + to_string(c4)) }
    let c99 = count_by_abi(99)
    if c99 != 0 { panic("pe_native_callback_dispatch FAIL [count_by_abi 99] expected=0 got=" + to_string(c99)) }

    // stub_dispatch_us
    let s1 = stub_dispatch_us(82001)
    if s1 != 60 { panic("pe_native_callback_dispatch FAIL [stub_dispatch_us 82001] expected=60 got=" + to_string(s1)) }
    let s4 = stub_dispatch_us(82004)
    if s4 != 80 { panic("pe_native_callback_dispatch FAIL [stub_dispatch_us 82004] expected=80 got=" + to_string(s4)) }
    let s_missing = stub_dispatch_us(9999)
    if s_missing != 0 { panic("pe_native_callback_dispatch FAIL [stub_dispatch_us 9999] expected=0 got=" + to_string(s_missing)) }

    // pncd_stats = [4, 15, 2, 1]
    let st = pncd_stats()
    if len(st) != 4 { panic("pe_native_callback_dispatch FAIL [pncd_stats len] expected=4 got=" + to_string(len(st))) }
    if st[0] != 4 { panic("pe_native_callback_dispatch FAIL [pncd_stats[0]] expected=4 got=" + to_string(st[0])) }
    if st[1] != 15 { panic("pe_native_callback_dispatch FAIL [pncd_stats[1]] expected=15 got=" + to_string(st[1])) }
    if st[2] != 2 { panic("pe_native_callback_dispatch FAIL [pncd_stats[2]] expected=2 got=" + to_string(st[2])) }
    if st[3] != 1 { panic("pe_native_callback_dispatch FAIL [pncd_stats[3]] expected=1 got=" + to_string(st[3])) }

    // emit count >= 5 (4 dispatch + 1 summary)
    r0_emit("pncd_self_test", "\"dispatch_count\":4,\"total_args\":15,\"total_elapsed_us\":230")
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("pe_native_callback_dispatch FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    cleanup_pncd()

    println("  ✅ pe_native_callback_dispatch self_test PASS (dispatch=4, args=15, elapsed_us=230, stdcall=2, cdecl=1, fastcall=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let st = pncd_stats()
            println("dispatch_count=" + to_string(st[0]) + " total_args=" + to_string(st[1]) + " stdcall=" + to_string(st[2]) + " cdecl=" + to_string(st[3]))
            return
        }
        if sub == "elapsed" && len(a) >= 4 {
            println(to_string(stub_dispatch_us(to_int(a[3]))))
            return
        }
        if sub == "count" && len(a) >= 4 {
            println(to_string(count_by_abi(to_int(a[3]))))
            return
        }
        if sub == "cleanup" { cleanup_pncd(); println("cleaned"); return }
    }
    println("usage: hexa run pe_native_callback_dispatch.hexa { self-test | stats | elapsed <stub_id> | count <abi_kind> | cleanup }")
}
