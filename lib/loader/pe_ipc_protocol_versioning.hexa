// lib/loader/pe_ipc_protocol_versioning.hexa — stage6 IPC protocol version migration skeleton
//
// v1/v2/v3 protocol coexistence. message schema 별 forward/backward compat
// migration. cycle 64 handshake 의 version negotiation 후속 — 실 message
// 변환.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 migration tracker — 실 message 변환 logic X (stage7).
// own 2 mandate: r0_emit ≥ 5 + self_test() + main() dispatch + headless safe + panic 형식.
//
// persist schema (TSV — migrations.tsv):
//   migration_id<int> \t from_version<int> \t to_version<int> \t message_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pipv_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ipc_protocol_versioning"
}

fn pipv_migrations_path() -> str {
    return pipv_dir() + "/migrations.tsv"
}

fn pipv_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pipv_dir() + "'")
}

fn cleanup_pipv() -> void {
    pipv_ensure_dir()
    let _ = exec("rm -f '" + pipv_migrations_path() + "'")
}

// ─── 공통 file IO ───
fn pipv_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pipv_append_row(path: str, row: str) -> void {
    pipv_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_migration: migration 1 건 기록 ───
fn record_migration(migration_id: int, from_version: int, to_version: int, message_count: int) -> void {
    if migration_id <= 0 {
        panic("pe_ipc_protocol_versioning FAIL [record_migration] expected=migration_id>0 got=" + to_string(migration_id))
    }
    if from_version < 1 {
        panic("pe_ipc_protocol_versioning FAIL [record_migration] expected=from_version>=1 got=" + to_string(from_version))
    }
    if to_version < 1 {
        panic("pe_ipc_protocol_versioning FAIL [record_migration] expected=to_version>=1 got=" + to_string(to_version))
    }
    if message_count < 0 {
        panic("pe_ipc_protocol_versioning FAIL [record_migration] expected=message_count>=0 got=" + to_string(message_count))
    }
    let row = to_string(migration_id) + "\t" + to_string(from_version)
        + "\t" + to_string(to_version) + "\t" + to_string(message_count) + "\n"
    pipv_append_row(pipv_migrations_path(), row)
}

// ─── migration_count: total migration 수 ───
fn migration_count() -> int {
    let t = pipv_read_table(pipv_migrations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_from_version: from_version 일치 migration 수 ───
fn count_by_from_version(v: int) -> int {
    let t = pipv_read_table(pipv_migrations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == v {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_to_version: to_version 일치 migration 수 ───
fn count_by_to_version(v: int) -> int {
    let t = pipv_read_table(pipv_migrations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == v {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_messages: 전 migration 의 message_count 합 ───
fn total_messages() -> int {
    let t = pipv_read_table(pipv_migrations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── migration_messages: 특정 migration_id 의 message_count (없으면 0) ───
fn migration_messages(migration_id: int) -> int {
    let t = pipv_read_table(pipv_migrations_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == migration_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pipv_stats: [migration_count, total_messages, count_by_from_version(1), count_by_to_version(2)] ───
fn pipv_stats() -> array {
    let mut out = []
    out.push(migration_count())
    out.push(total_messages())
    out.push(count_by_from_version(1))
    out.push(count_by_to_version(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pipv-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pipv()

    // 2. record 4 migrations (deterministic synthetic)
    record_migration(127001, 1, 2, 240)
    r0_emit("pe_ipc_protocol_versioning_record",
        "\"migration_id\":127001,\"from_version\":1,\"to_version\":2,\"message_count\":240,\"target\":\"v1_to_v2_bulk\"")

    record_migration(127002, 1, 2, 180)
    r0_emit("pe_ipc_protocol_versioning_record",
        "\"migration_id\":127002,\"from_version\":1,\"to_version\":2,\"message_count\":180,\"target\":\"v1_to_v2_partial\"")

    record_migration(127003, 2, 3, 120)
    r0_emit("pe_ipc_protocol_versioning_record",
        "\"migration_id\":127003,\"from_version\":2,\"to_version\":3,\"message_count\":120,\"target\":\"v2_to_v3_upgrade\"")

    record_migration(127004, 1, 3, 60)
    r0_emit("pe_ipc_protocol_versioning_record",
        "\"migration_id\":127004,\"from_version\":1,\"to_version\":3,\"message_count\":60,\"target\":\"v1_to_v3_skip\"")

    // 3. migration_count = 4
    let c = migration_count()
    if c != 4 {
        panic("pe_ipc_protocol_versioning FAIL [migration_count] expected=4 got=" + to_string(c))
    }

    // 4. total_messages = 600
    let tm = total_messages()
    if tm != 600 {
        panic("pe_ipc_protocol_versioning FAIL [total_messages] expected=600 got=" + to_string(tm))
    }

    // 5. count_by_from_version sanity
    let cf1 = count_by_from_version(1)
    if cf1 != 3 {
        panic("pe_ipc_protocol_versioning FAIL [count_by_from_version(1)] expected=3 got=" + to_string(cf1))
    }
    let cf2 = count_by_from_version(2)
    if cf2 != 1 {
        panic("pe_ipc_protocol_versioning FAIL [count_by_from_version(2)] expected=1 got=" + to_string(cf2))
    }
    let cf3 = count_by_from_version(3)
    if cf3 != 0 {
        panic("pe_ipc_protocol_versioning FAIL [count_by_from_version(3)] expected=0 got=" + to_string(cf3))
    }
    let cf99 = count_by_from_version(99)
    if cf99 != 0 {
        panic("pe_ipc_protocol_versioning FAIL [count_by_from_version(99)] expected=0 got=" + to_string(cf99))
    }

    // 6. count_by_to_version sanity
    let ct2 = count_by_to_version(2)
    if ct2 != 2 {
        panic("pe_ipc_protocol_versioning FAIL [count_by_to_version(2)] expected=2 got=" + to_string(ct2))
    }
    let ct3 = count_by_to_version(3)
    if ct3 != 2 {
        panic("pe_ipc_protocol_versioning FAIL [count_by_to_version(3)] expected=2 got=" + to_string(ct3))
    }
    let ct99 = count_by_to_version(99)
    if ct99 != 0 {
        panic("pe_ipc_protocol_versioning FAIL [count_by_to_version(99)] expected=0 got=" + to_string(ct99))
    }

    // 7. migration_messages sanity
    let mm1 = migration_messages(127001)
    if mm1 != 240 {
        panic("pe_ipc_protocol_versioning FAIL [migration_messages(127001)] expected=240 got=" + to_string(mm1))
    }
    let mm4 = migration_messages(127004)
    if mm4 != 60 {
        panic("pe_ipc_protocol_versioning FAIL [migration_messages(127004)] expected=60 got=" + to_string(mm4))
    }
    let mm_miss = migration_messages(9999)
    if mm_miss != 0 {
        panic("pe_ipc_protocol_versioning FAIL [migration_messages(9999)] expected=0 got=" + to_string(mm_miss))
    }

    // 8. pipv_stats() = [4, 600, 3, 2]
    let s = pipv_stats()
    if len(s) != 4 {
        panic("pe_ipc_protocol_versioning FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 4 {
        panic("pe_ipc_protocol_versioning FAIL [stats migration_count] expected=4 got=" + to_string(s[0]))
    }
    if s[1] != 600 {
        panic("pe_ipc_protocol_versioning FAIL [stats total_messages] expected=600 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_ipc_protocol_versioning FAIL [stats count_by_from_version(1)] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_ipc_protocol_versioning FAIL [stats count_by_to_version(2)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_ipc_protocol_versioning_stats",
        "\"migration_count\":" + to_string(s[0])
        + ",\"total_messages\":" + to_string(s[1])
        + ",\"from_v1\":" + to_string(s[2])
        + ",\"to_v2\":" + to_string(s[3]))

    // 10. emit count >= 5 (4 records + 1 stats = 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("pe_ipc_protocol_versioning FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pipv()
    let s2 = pipv_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ipc_protocol_versioning FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ipc_protocol_versioning self_test PASS (migrations=" + to_string(s[0])
        + ", total_msgs=" + to_string(s[1]) + ", from_v1=" + to_string(s[2])
        + ", to_v2=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pipv_stats()
            println("migration_count\t" + to_string(s[0]))
            println("total_messages\t" + to_string(s[1]))
            println("from_v1\t" + to_string(s[2]))
            println("to_v2\t" + to_string(s[3]))
            return
        }
        if sub == "msgs" {
            if len(a) >= 4 {
                let mid = to_int(a[3])
                println("migration_messages\t" + to_string(migration_messages(mid)))
                return
            }
            println("usage: hexa run pe_ipc_protocol_versioning.hexa msgs <migration_id>")
            return
        }
        if sub == "count_from" {
            if len(a) >= 4 {
                let v = to_int(a[3])
                println("count_by_from_version\t" + to_string(count_by_from_version(v)))
                return
            }
            println("usage: hexa run pe_ipc_protocol_versioning.hexa count_from <v>")
            return
        }
        if sub == "count_to" {
            if len(a) >= 4 {
                let v = to_int(a[3])
                println("count_by_to_version\t" + to_string(count_by_to_version(v)))
                return
            }
            println("usage: hexa run pe_ipc_protocol_versioning.hexa count_to <v>")
            return
        }
        if sub == "cleanup" {
            cleanup_pipv()
            println("cleaned: " + pipv_dir())
            return
        }
    }
    println("usage: hexa run pe_ipc_protocol_versioning.hexa { self-test | stats | msgs <migration_id> | count_from <v> | count_to <v> | cleanup }")
}
