// lib/loader/pe_debug_directory.hexa — stage3 PE debug directory parser skeleton
//
// PE Debug Directory: IMAGE_DEBUG_TYPE_CODEVIEW (PDB path + GUID + age).
// 보통 IMAGE_DEBUG_TYPE_REPRO (build reproducibility) 도 동반. Crash trace
// resolution + symbol address lookup.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   Microsoft PE/COFF spec + Apple lldb-rpc doc 만 참조.
// own 2 mandate: r0_emit ≥ 5 + self_test() + main() dispatch + headless safe + panic 형식.
//
// debug_kind:
//   1 = CODEVIEW (PDB path + GUID + age)
//   2 = COFF
//   3 = POGO
//   4 = REPRO (build reproducibility)
//   5 = other
//
// persist schema (TSV — debug_history.tsv):
//   pe_id<int> \t debug_kind<int> \t has_pdb_path<int> \t build_age<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdd_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_debug_directory"
}

fn pdd_history_path() -> str {
    return pdd_dir() + "/debug_history.tsv"
}

fn pdd_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdd_dir() + "'")
}

fn cleanup_pdd() -> void {
    pdd_ensure_dir()
    let _ = exec("rm -f '" + pdd_history_path() + "'")
}

// ─── 공통 file IO ───
fn pdd_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdd_append_row(path: str, row: str) -> void {
    pdd_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_debug: PE Debug Directory entry 1건 기록 ───
//   stage4 에서 실 IMAGE_DEBUG_DIRECTORY parse + PDB load 로 교체.
fn record_debug(pe_id: int, debug_kind: int, has_pdb_path: int, build_age: int) -> void {
    if pe_id <= 0 {
        panic("pe_debug_directory FAIL [record_debug] expected=pe_id>0 got=" + to_string(pe_id))
    }
    if debug_kind < 1 {
        panic("pe_debug_directory FAIL [record_debug] expected=debug_kind>=1 got=" + to_string(debug_kind))
    }
    if debug_kind > 5 {
        panic("pe_debug_directory FAIL [record_debug] expected=debug_kind<=5 got=" + to_string(debug_kind))
    }
    if has_pdb_path < 0 {
        panic("pe_debug_directory FAIL [record_debug] expected=has_pdb_path>=0 got=" + to_string(has_pdb_path))
    }
    if has_pdb_path > 1 {
        panic("pe_debug_directory FAIL [record_debug] expected=has_pdb_path<=1 got=" + to_string(has_pdb_path))
    }
    if build_age < 0 {
        panic("pe_debug_directory FAIL [record_debug] expected=build_age>=0 got=" + to_string(build_age))
    }
    let row = to_string(pe_id) + "\t" + to_string(debug_kind)
        + "\t" + to_string(has_pdb_path) + "\t" + to_string(build_age) + "\n"
    pdd_append_row(pdd_history_path(), row)
}

// ─── debug_count: 총 debug entry 수 ───
fn debug_count() -> int {
    let mut cnt = 0
    let t = pdd_read_table(pdd_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── pdb_present_count: has_pdb_path == 1 건수 ───
fn pdb_present_count() -> int {
    let mut cnt = 0
    let t = pdd_read_table(pdd_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_debug_kind: 특정 debug_kind 의 entry 수 ───
fn count_by_debug_kind(kind: int) -> int {
    let mut cnt = 0
    let t = pdd_read_table(pdd_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── pe_build_age: 특정 pe_id 의 build_age (first record = highest age) ───
fn pe_build_age(pe_id: int) -> int {
    let mut age = 0
    let mut found = 0
    let t = pdd_read_table(pdd_history_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == pe_id {
                    if found == 0 {
                        age = to_int(parts[3])
                        found = 1
                    }
                }
            }
        }
        i = i + 1
    }
    return age
}

// ─── pdd_stats: [debug_count, pdb_present_count, count_by_debug_kind(1), count_by_debug_kind(4)] ───
fn pdd_stats() -> array {
    let mut out = []
    out.push(debug_count())
    out.push(pdb_present_count())
    out.push(count_by_debug_kind(1))
    out.push(count_by_debug_kind(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdebugdir-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdd()

    // 2. record 4 entries (Battle.net Setup CODEVIEW + REPRO / D2R.exe / stripped COFF)
    record_debug(93001, 1, 1, 12)
    r0_emit("pe_debug_directory_record",
        "\"pe_id\":93001,\"debug_kind\":1,\"has_pdb_path\":1,\"build_age\":12,\"label\":\"battlenet_setup_codeview\"")

    record_debug(93001, 4, 0, 0)
    r0_emit("pe_debug_directory_record",
        "\"pe_id\":93001,\"debug_kind\":4,\"has_pdb_path\":0,\"build_age\":0,\"label\":\"battlenet_setup_repro\"")

    record_debug(93002, 1, 1, 8)
    r0_emit("pe_debug_directory_record",
        "\"pe_id\":93002,\"debug_kind\":1,\"has_pdb_path\":1,\"build_age\":8,\"label\":\"d2r_exe_codeview\"")

    record_debug(93003, 2, 0, 0)
    r0_emit("pe_debug_directory_record",
        "\"pe_id\":93003,\"debug_kind\":2,\"has_pdb_path\":0,\"build_age\":0,\"label\":\"stripped_coff_only\"")

    // 3. debug_count = 4
    let dc = debug_count()
    if dc != 4 {
        panic("pe_debug_directory FAIL [debug_count] expected=4 got=" + to_string(dc))
    }

    // 4. pdb_present_count = 2
    let pp = pdb_present_count()
    if pp != 2 {
        panic("pe_debug_directory FAIL [pdb_present_count] expected=2 got=" + to_string(pp))
    }

    // 5. count_by_debug_kind
    let k1 = count_by_debug_kind(1)
    if k1 != 2 {
        panic("pe_debug_directory FAIL [count_by_debug_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_debug_kind(2)
    if k2 != 1 {
        panic("pe_debug_directory FAIL [count_by_debug_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k4 = count_by_debug_kind(4)
    if k4 != 1 {
        panic("pe_debug_directory FAIL [count_by_debug_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_debug_kind(99)
    if k99 != 0 {
        panic("pe_debug_directory FAIL [count_by_debug_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. pe_build_age
    let a1 = pe_build_age(93001)
    if a1 != 12 {
        panic("pe_debug_directory FAIL [pe_build_age(93001)] expected=12 got=" + to_string(a1))
    }
    let a2 = pe_build_age(93002)
    if a2 != 8 {
        panic("pe_debug_directory FAIL [pe_build_age(93002)] expected=8 got=" + to_string(a2))
    }
    let a0 = pe_build_age(9999)
    if a0 != 0 {
        panic("pe_debug_directory FAIL [pe_build_age(9999)] expected=0 got=" + to_string(a0))
    }

    // 7. pdd_stats() = [4, 2, 2, 1]
    let s = pdd_stats()
    if len(s) != 4 {
        panic("pe_debug_directory FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 4 {
        panic("pe_debug_directory FAIL [stats debug_count] expected=4 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_debug_directory FAIL [stats pdb_present_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_debug_directory FAIL [stats count_by_debug_kind(1)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_debug_directory FAIL [stats count_by_debug_kind(4)] expected=1 got=" + to_string(s[3]))
    }

    // 8. emit stats
    r0_emit("pe_debug_directory_stats",
        "\"debug_count\":" + to_string(s[0])
        + ",\"pdb_present_count\":" + to_string(s[1])
        + ",\"count_codeview\":" + to_string(s[2])
        + ",\"count_repro\":" + to_string(s[3]))

    // 9. emit count >= 5 (실제: 4 records + 1 stats = 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("pe_debug_directory FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 10. cleanup → stats 모두 0
    cleanup_pdd()
    let s2 = pdd_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_debug_directory FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_debug_directory self_test PASS (4 entries, pdb=" + to_string(s[1])
        + ", codeview=" + to_string(s[2]) + ", repro=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdd_stats()
            println("debug_count\t" + to_string(s[0]))
            println("pdb_present_count\t" + to_string(s[1]))
            println("count_by_debug_kind(1)\t" + to_string(s[2]))
            println("count_by_debug_kind(4)\t" + to_string(s[3]))
            return
        }
        if sub == "age" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                println("pe_build_age(" + to_string(pid) + ")\t" + to_string(pe_build_age(pid)))
                return
            }
            println("usage: hexa run pe_debug_directory.hexa age <pe_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println("count_by_debug_kind(" + to_string(k) + ")\t" + to_string(count_by_debug_kind(k)))
                return
            }
            println("usage: hexa run pe_debug_directory.hexa count <debug_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdd()
            println("cleaned: " + pdd_dir())
            return
        }
        if sub == "dir" {
            println(pdd_dir())
            return
        }
    }
    println("usage: hexa run pe_debug_directory.hexa { self-test | stats | age <pe_id> | count <debug_kind> | cleanup | dir }")
}
