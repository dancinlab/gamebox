// lib/loader/pe_ntdll_alloc_virtual_real.hexa — NTDLL NtAllocate/Free/Protect/QueryVirtualMemory 실 호출 추적 (cycle 84)
//
// NTDLL Virtual Memory API 실 호출 → Apple POSIX bridge:
//   NtAllocateVirtualMemory(ProcessHandle, BaseAddress*, ZeroBits, RegionSize*, AllocationType, Protect)
//     → mmap(addr, len, PROT_READ|PROT_WRITE, MAP_ANON|MAP_PRIVATE, -1, 0)
//   MEM_COMMIT bit  → real backing (default mmap, page populated on touch)
//   MEM_RESERVE bit → MAP_NORESERVE (address space reservation, no swap charge)
//   MEM_COMMIT|MEM_RESERVE → mmap(MAP_ANON|MAP_PRIVATE) with PROT set
//   NtFreeVirtualMemory MEM_RELEASE   → munmap(addr, len)
//   NtFreeVirtualMemory MEM_DECOMMIT  → mprotect(addr, len, PROT_NONE) + madvise(MADV_FREE)
//   NtProtectVirtualMemory → mprotect(addr, len, prot_translate(Protect))
//   NtQueryVirtualMemory   → /proc-style probe via mach_vm_region (Apple) — read-only
// own1: NTDLL spec + Apple mmap(2)/mprotect(2) man pages only. Wine ntdll/virtual.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 NT virtual memory call tracker — 실 mmap/mprotect 호출 X (native bridge stage).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//   1 = NtAllocateVirtualMemory
//   2 = NtFreeVirtualMemory
//   3 = NtProtectVirtualMemory
//   4 = NtQueryVirtualMemory
//
// alloc_kind code (AllocationType / FreeType):
//   1 = MEM_COMMIT
//   2 = MEM_RESERVE
//   3 = MEM_COMMIT|MEM_RESERVE
//   4 = MEM_RELEASE
//   5 = MEM_DECOMMIT
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t alloc_kind<int> \t length_kb<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pnavr_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ntdll_alloc_virtual_real"
}

fn pnavr_calls_path() -> str {
    return pnavr_dir() + "/calls.tsv"
}

fn pnavr_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pnavr_dir() + "'")
}

fn cleanup_pnavr() -> void {
    pnavr_ensure_dir()
    let _ = exec("rm -f '" + pnavr_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pnavr_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pnavr_append_row(path: str, row: str) -> void {
    pnavr_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: NT virtual memory API call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, alloc_kind: int, length_kb: int) -> void {
    if call_id <= 0 {
        panic("pe_ntdll_alloc_virtual_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 4 {
        panic("pe_ntdll_alloc_virtual_real FAIL [record_call] expected=func_kind<=4 got=" + to_string(func_kind))
    }
    if alloc_kind < 0 {
        panic("pe_ntdll_alloc_virtual_real FAIL [record_call] expected=alloc_kind>=0 got=" + to_string(alloc_kind))
    }
    if alloc_kind > 5 {
        panic("pe_ntdll_alloc_virtual_real FAIL [record_call] expected=alloc_kind<=5 got=" + to_string(alloc_kind))
    }
    if length_kb < 0 {
        panic("pe_ntdll_alloc_virtual_real FAIL [record_call] expected=length_kb>=0 got=" + to_string(length_kb))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(alloc_kind) + "\t" + to_string(length_kb) + "\n"
    pnavr_append_row(pnavr_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = pnavr_read_table(pnavr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(kind: int) -> int {
    let t = pnavr_read_table(pnavr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_length_kb: 모든 call 의 length_kb 합 ───
fn total_length_kb() -> int {
    let t = pnavr_read_table(pnavr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut total = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                total = total + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return total
}

// ─── count_by_alloc_kind: 특정 alloc_kind 의 call 수 ───
fn count_by_alloc_kind(kind: int) -> int {
    let t = pnavr_read_table(pnavr_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── commit_count: MEM_COMMIT (1) + MEM_COMMIT|MEM_RESERVE (3) ───
fn commit_count() -> int {
    return count_by_alloc_kind(1) + count_by_alloc_kind(3)
}

// ─── call_length: 특정 call_id 의 length_kb (없으면 -1) ───
fn call_length(call_id: int) -> int {
    let t = pnavr_read_table(pnavr_calls_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pnavr_stats: [call_count, commit_count, count_by_func_kind(1), total_length_kb] ───
fn pnavr_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(commit_count())
    out.push(count_by_func_kind(1))
    out.push(total_length_kb())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pnavr-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pnavr()

    // 2. record 6 calls — covers all 4 func_kinds, ≥3 alloc_kinds (1, 2, 3, 4, 5)
    //    NtAllocateVirtualMemory MEM_COMMIT|MEM_RESERVE 4096 KB (4 MB heap chunk)
    record_call(140001, 1, 3, 4096)
    r0_emit("pe_ntdll_alloc_virtual_real_record",
        "\"call_id\":140001,\"func_kind\":1,\"alloc_kind\":3,\"length_kb\":4096,\"target\":\"NtAllocateVirtualMemory\"")

    //    NtAllocateVirtualMemory MEM_RESERVE only 65536 KB (64 MB reserve)
    record_call(140002, 1, 2, 65536)
    r0_emit("pe_ntdll_alloc_virtual_real_record",
        "\"call_id\":140002,\"func_kind\":1,\"alloc_kind\":2,\"length_kb\":65536,\"target\":\"NtAllocateVirtualMemory\"")

    //    NtAllocateVirtualMemory MEM_COMMIT 1024 KB (commit on already-reserved region)
    record_call(140003, 1, 1, 1024)
    r0_emit("pe_ntdll_alloc_virtual_real_record",
        "\"call_id\":140003,\"func_kind\":1,\"alloc_kind\":1,\"length_kb\":1024,\"target\":\"NtAllocateVirtualMemory\"")

    //    NtProtectVirtualMemory (alloc_kind=0 N/A) 1024 KB
    record_call(140004, 3, 0, 1024)
    r0_emit("pe_ntdll_alloc_virtual_real_record",
        "\"call_id\":140004,\"func_kind\":3,\"alloc_kind\":0,\"length_kb\":1024,\"target\":\"NtProtectVirtualMemory\"")

    //    NtFreeVirtualMemory MEM_DECOMMIT 1024 KB
    record_call(140005, 2, 5, 1024)
    r0_emit("pe_ntdll_alloc_virtual_real_record",
        "\"call_id\":140005,\"func_kind\":2,\"alloc_kind\":5,\"length_kb\":1024,\"target\":\"NtFreeVirtualMemory\"")

    //    NtQueryVirtualMemory (alloc_kind=0 N/A, length_kb=0 read-only probe)
    record_call(140006, 4, 0, 0)
    r0_emit("pe_ntdll_alloc_virtual_real_record",
        "\"call_id\":140006,\"func_kind\":4,\"alloc_kind\":0,\"length_kb\":0,\"target\":\"NtQueryVirtualMemory\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("pe_ntdll_alloc_virtual_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (all 4 func_kinds covered: 1,2,3,4)
    let f1 = count_by_func_kind(1)
    if f1 != 3 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_func_kind(1)] expected=3 got=" + to_string(f1))
    }
    let f2 = count_by_func_kind(2)
    if f2 != 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(f2))
    }
    let f3 = count_by_func_kind(3)
    if f3 != 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_func_kind(3)] expected=1 got=" + to_string(f3))
    }
    let f4 = count_by_func_kind(4)
    if f4 != 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(f4))
    }
    let f99 = count_by_func_kind(99)
    if f99 != 0 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_func_kind(99)] expected=0 got=" + to_string(f99))
    }

    // 5. count_by_alloc_kind sanity (≥3 alloc_kinds covered: 1, 2, 3, 5)
    let a1 = count_by_alloc_kind(1)
    if a1 != 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_alloc_kind(1)] expected=1 got=" + to_string(a1))
    }
    let a2 = count_by_alloc_kind(2)
    if a2 != 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_alloc_kind(2)] expected=1 got=" + to_string(a2))
    }
    let a3 = count_by_alloc_kind(3)
    if a3 != 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_alloc_kind(3)] expected=1 got=" + to_string(a3))
    }
    let a5 = count_by_alloc_kind(5)
    if a5 != 1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [count_by_alloc_kind(5)] expected=1 got=" + to_string(a5))
    }

    // 6. commit_count = a1 + a3 = 2
    let cc = commit_count()
    if cc != 2 {
        panic("pe_ntdll_alloc_virtual_real FAIL [commit_count] expected=2 got=" + to_string(cc))
    }

    // 7. total_length_kb = 4096 + 65536 + 1024 + 1024 + 1024 + 0 = 72704
    let tot = total_length_kb()
    if tot != 72704 {
        panic("pe_ntdll_alloc_virtual_real FAIL [total_length_kb] expected=72704 got=" + to_string(tot))
    }

    // 8. call_length sanity
    let l1 = call_length(140001)
    if l1 != 4096 {
        panic("pe_ntdll_alloc_virtual_real FAIL [call_length(140001)] expected=4096 got=" + to_string(l1))
    }
    let l2 = call_length(140002)
    if l2 != 65536 {
        panic("pe_ntdll_alloc_virtual_real FAIL [call_length(140002)] expected=65536 got=" + to_string(l2))
    }
    let l_miss = call_length(9999)
    if l_miss != -1 {
        panic("pe_ntdll_alloc_virtual_real FAIL [call_length(9999)] expected=-1 got=" + to_string(l_miss))
    }

    // 9. pnavr_stats() = [6, 2, 3, 72704]
    let s = pnavr_stats()
    if len(s) != 4 {
        panic("pe_ntdll_alloc_virtual_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_ntdll_alloc_virtual_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_ntdll_alloc_virtual_real FAIL [stats commit_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_ntdll_alloc_virtual_real FAIL [stats func_kind(1)] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 72704 {
        panic("pe_ntdll_alloc_virtual_real FAIL [stats total_length_kb] expected=72704 got=" + to_string(s[3]))
    }

    // 10. emit stats (7th r0_emit)
    r0_emit("pe_ntdll_alloc_virtual_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"commit_count\":" + to_string(s[1])
        + ",\"func_kind_alloc\":" + to_string(s[2])
        + ",\"total_length_kb\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_ntdll_alloc_virtual_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0 (post-cleanup zero)
    cleanup_pnavr()
    let s2 = pnavr_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ntdll_alloc_virtual_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ntdll_alloc_virtual_real self_test PASS (calls=" + to_string(s[0])
        + ", commit=" + to_string(s[1]) + ", alloc=" + to_string(s[2])
        + ", total_kb=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pnavr_stats()
            println("call_count\t" + to_string(s[0]))
            println("commit_count\t" + to_string(s[1]))
            println("count_func_kind_alloc\t" + to_string(s[2]))
            println("total_length_kb\t" + to_string(s[3]))
            return
        }
        if sub == "length" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_length\t" + to_string(call_length(cid)))
                return
            }
            println("usage: hexa run pe_ntdll_alloc_virtual_real.hexa length <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let what = a[3]
                let val = to_int(a[4])
                if what == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if what == "alloc" {
                    println("count_by_alloc_kind\t" + to_string(count_by_alloc_kind(val)))
                    return
                }
            }
            println("usage: hexa run pe_ntdll_alloc_virtual_real.hexa count { func <func_kind> | alloc <alloc_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pnavr()
            println("cleaned: " + pnavr_dir())
            return
        }
        if sub == "dir" {
            println(pnavr_dir())
            return
        }
    }
    println("usage: hexa run pe_ntdll_alloc_virtual_real.hexa { self-test | stats | length <call_id> | count func <func_kind> | count alloc <alloc_kind> | cleanup | dir }")
}
