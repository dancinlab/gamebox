// lib/loader/pe_delta_force_specific_track.hexa — cycle 83: Delta Force 전용 launch chain tracker
//
// Delta Force (TiMi 2024) launch chain (own2 자체 추적):
//   process_attach        — delta-force.exe entry
//   timi_engine_init      — TiMi proprietary engine, DX12 + Vulkan dual path
//   anti_cheat_init       — ACE-AC (Tencent Anti-Cheat Engine) kernel driver
//                           → Apple Silicon kernel-mode AC 차단 (만점 검토 결론)
//   lobby_load            — main menu / battle pass / inventory
//   match_request         — server matchmaking
//   map_load              — Operations / Hot Zone map asset stream
//   first_frame           — DX12 swapchain present (Apple D3DMetal)
//   disconnect            — match cleanup + telemetry post
//   결론: kernel anti-cheat 차단 → first frame 도달 불가 (skeleton 추적만)
// own1: 공개 정보 + binary observation. Wine Delta Force wrapper 인용 X
// own 2 mandate: r0_emit ≥ 9 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = process_attach
//   2 = timi_engine_init
//   3 = anti_cheat_init
//   4 = lobby_load
//   5 = match_request
//   6 = map_load
//   7 = first_frame
//   8 = disconnect
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t dll_loaded<int> \t ac_blocked<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdfst_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_delta_force_specific_track"
}

fn pdfst_steps_path() -> str {
    return pdfst_dir() + "/steps.tsv"
}

fn pdfst_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdfst_dir() + "'")
}

fn cleanup_pdfst() -> void {
    pdfst_ensure_dir()
    let _ = exec("rm -f '" + pdfst_steps_path() + "'")
}

// ─── 공통 file IO ───
fn pdfst_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdfst_append_row(path: str, row: str) -> void {
    pdfst_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_step: Delta Force launch step 1 건 기록 ───
fn record_step(step_id: int, phase_kind: int, dll_loaded: int, ac_blocked: int) -> void {
    if step_id <= 0 {
        panic("pe_delta_force_specific_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_delta_force_specific_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 8 {
        panic("pe_delta_force_specific_track FAIL [record_step] expected=phase_kind<=8 got=" + to_string(phase_kind))
    }
    if dll_loaded < 0 {
        panic("pe_delta_force_specific_track FAIL [record_step] expected=dll_loaded>=0 got=" + to_string(dll_loaded))
    }
    if ac_blocked < 0 {
        panic("pe_delta_force_specific_track FAIL [record_step] expected=ac_blocked>=0 got=" + to_string(ac_blocked))
    }
    if ac_blocked > 1 {
        panic("pe_delta_force_specific_track FAIL [record_step] expected=ac_blocked<=1 got=" + to_string(ac_blocked))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(dll_loaded) + "\t" + to_string(ac_blocked) + "\n"
    pdfst_append_row(pdfst_steps_path(), row)
}

// ─── step_count: total step 수 ───
fn step_count() -> int {
    let t = pdfst_read_table(pdfst_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 step 수 ───
fn count_by_phase_kind(kind: int) -> int {
    let t = pdfst_read_table(pdfst_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── loaded_count: 모든 step dll_loaded 합 ───
fn loaded_count() -> int {
    let t = pdfst_read_table(pdfst_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── ac_blocked_count: ac_blocked=1 인 step 수 ───
fn ac_blocked_count() -> int {
    let t = pdfst_read_table(pdfst_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── anti_cheat_init_count: phase_kind=3 step 수 ───
fn anti_cheat_init_count() -> int {
    return count_by_phase_kind(3)
}

// ─── step_dll_loaded: 특정 step_id 의 dll_loaded (없으면 0) ───
fn step_dll_loaded(step_id: int) -> int {
    let t = pdfst_read_table(pdfst_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdfst_stats: [step_count, loaded_count, ac_blocked_count, anti_cheat_init_count] ───
fn pdfst_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(loaded_count())
    out.push(ac_blocked_count())
    out.push(anti_cheat_init_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdfst-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdfst()

    // 2. record 8 steps (phase_kind 1..8 모두 cover, ≥1 ac_blocked)
    record_step(830001, 1, 1, 0)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830001,\"phase_kind\":1,\"dll_loaded\":1,\"ac_blocked\":0,\"target\":\"process_attach\"")

    record_step(830002, 2, 12, 0)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830002,\"phase_kind\":2,\"dll_loaded\":12,\"ac_blocked\":0,\"target\":\"timi_engine_init\"")

    record_step(830003, 3, 4, 1)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830003,\"phase_kind\":3,\"dll_loaded\":4,\"ac_blocked\":1,\"target\":\"anti_cheat_init\"")

    record_step(830004, 4, 8, 0)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830004,\"phase_kind\":4,\"dll_loaded\":8,\"ac_blocked\":0,\"target\":\"lobby_load\"")

    record_step(830005, 5, 2, 0)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830005,\"phase_kind\":5,\"dll_loaded\":2,\"ac_blocked\":0,\"target\":\"match_request\"")

    record_step(830006, 6, 16, 0)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830006,\"phase_kind\":6,\"dll_loaded\":16,\"ac_blocked\":0,\"target\":\"map_load\"")

    record_step(830007, 7, 0, 0)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830007,\"phase_kind\":7,\"dll_loaded\":0,\"ac_blocked\":0,\"target\":\"first_frame\"")

    record_step(830008, 8, 0, 0)
    r0_emit("pe_delta_force_specific_track_record",
        "\"step_id\":830008,\"phase_kind\":8,\"dll_loaded\":0,\"ac_blocked\":0,\"target\":\"disconnect\"")

    // 3. step_count = 8
    let c = step_count()
    if c != 8 {
        panic("pe_delta_force_specific_track FAIL [step_count] expected=8 got=" + to_string(c))
    }

    // 4. loaded_count = 1+12+4+8+2+16+0+0 = 43
    let lc = loaded_count()
    if lc != 43 {
        panic("pe_delta_force_specific_track FAIL [loaded_count] expected=43 got=" + to_string(lc))
    }

    // 5. count_by_phase_kind sanity (각 phase_kind = 1)
    let k1 = count_by_phase_kind(1)
    if k1 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_phase_kind(2)
    if k2 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_phase_kind(3)
    if k3 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_phase_kind(4)
    if k4 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_phase_kind(5)
    if k5 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k6 = count_by_phase_kind(6)
    if k6 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(k6))
    }
    let k7 = count_by_phase_kind(7)
    if k7 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(7)] expected=1 got=" + to_string(k7))
    }
    let k8 = count_by_phase_kind(8)
    if k8 != 1 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(8)] expected=1 got=" + to_string(k8))
    }
    let k99 = count_by_phase_kind(99)
    if k99 != 0 {
        panic("pe_delta_force_specific_track FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. ac_blocked_count = 1 (anti_cheat_init)
    let abc = ac_blocked_count()
    if abc != 1 {
        panic("pe_delta_force_specific_track FAIL [ac_blocked_count] expected=1 got=" + to_string(abc))
    }

    // 7. anti_cheat_init_count = 1
    let acic = anti_cheat_init_count()
    if acic != 1 {
        panic("pe_delta_force_specific_track FAIL [anti_cheat_init_count] expected=1 got=" + to_string(acic))
    }

    // 8. step_dll_loaded sanity
    let dl2 = step_dll_loaded(830002)
    if dl2 != 12 {
        panic("pe_delta_force_specific_track FAIL [step_dll_loaded(830002)] expected=12 got=" + to_string(dl2))
    }
    let dl6 = step_dll_loaded(830006)
    if dl6 != 16 {
        panic("pe_delta_force_specific_track FAIL [step_dll_loaded(830006)] expected=16 got=" + to_string(dl6))
    }
    let dl_miss = step_dll_loaded(9999)
    if dl_miss != 0 {
        panic("pe_delta_force_specific_track FAIL [step_dll_loaded(9999)] expected=0 got=" + to_string(dl_miss))
    }

    // 9. pdfst_stats() = [8, 43, 1, 1]
    let s = pdfst_stats()
    if len(s) != 4 {
        panic("pe_delta_force_specific_track FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_delta_force_specific_track FAIL [stats step_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 43 {
        panic("pe_delta_force_specific_track FAIL [stats loaded_count] expected=43 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_delta_force_specific_track FAIL [stats ac_blocked_count] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_delta_force_specific_track FAIL [stats anti_cheat_init_count] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_delta_force_specific_track_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"loaded_count\":" + to_string(s[1])
        + ",\"ac_blocked_count\":" + to_string(s[2])
        + ",\"anti_cheat_init_count\":" + to_string(s[3]))

    // 11. emit count >= 9 (8 records + 1 stats = 9)
    let emit_n = r0_session_count(sid)
    if emit_n < 9 {
        panic("pe_delta_force_specific_track FAIL [r0 emit count] expected=>=9 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pdfst()
    let s2 = pdfst_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_delta_force_specific_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_delta_force_specific_track self_test PASS (steps=" + to_string(s[0])
        + ", loaded=" + to_string(s[1]) + ", ac_blocked=" + to_string(s[2])
        + ", ac_init=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdfst_stats()
            println("step_count\t" + to_string(s[0]))
            println("loaded_count\t" + to_string(s[1]))
            println("ac_blocked_count\t" + to_string(s[2]))
            println("anti_cheat_init_count\t" + to_string(s[3]))
            return
        }
        if sub == "loaded" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_dll_loaded\t" + to_string(step_dll_loaded(sid)))
                return
            }
            println("usage: hexa run pe_delta_force_specific_track.hexa loaded <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(kind)))
                return
            }
            println("usage: hexa run pe_delta_force_specific_track.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdfst()
            println("cleaned: " + pdfst_dir())
            return
        }
        if sub == "dir" {
            println(pdfst_dir())
            return
        }
    }
    println("usage: hexa run pe_delta_force_specific_track.hexa { self-test | stats | loaded <step_id> | count <phase_kind> | cleanup | dir }")
}
