// lib/loader/pe_dns_query.hexa — cycle 75 Win32 DnsQuery_W / GetAddrInfoW telemetry skeleton
//
// Win32 DNS resolution surface tracker — DnsQuery_W / GetAddrInfoW 호출
// telemetry. record_kind = DNS record class (A / AAAA / CNAME / MX / TXT /
// PTR), elevated bit = cache (0) vs network (1) resolution path.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 DNS query tracker — 실 DnsQuery_W() / GetAddrInfoW() 호출 X (stage6).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// record_kind code:
//   1 = A
//   2 = AAAA
//   3 = CNAME
//   4 = MX
//   5 = TXT
//   6 = PTR
//
// elevated bit:
//   0 = cache hit (resolver cache)
//   1 = network resolution
//
// persist schema (TSV — queries.tsv):
//   query_id<int> \t record_kind<int> \t answer_count<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdq_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dns_query"
}

fn pdq_queries_path() -> str {
    return pdq_dir() + "/queries.tsv"
}

fn pdq_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdq_dir() + "'")
}

fn cleanup_pdq() -> void {
    pdq_ensure_dir()
    let _ = exec("rm -f '" + pdq_queries_path() + "'")
}

// ─── 공통 file IO ───
fn pdq_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdq_append_row(path: str, row: str) -> void {
    pdq_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_query: DNS query 1 건 기록 ───
fn record_query(query_id: int, record_kind: int, answer_count: int, elevated: int) -> void {
    if query_id <= 0 {
        panic("pe_dns_query FAIL [record_query] expected=query_id>0 got=" + to_string(query_id))
    }
    if record_kind < 1 {
        panic("pe_dns_query FAIL [record_query] expected=record_kind>=1 got=" + to_string(record_kind))
    }
    if record_kind > 6 {
        panic("pe_dns_query FAIL [record_query] expected=record_kind<=6 got=" + to_string(record_kind))
    }
    if answer_count < 0 {
        panic("pe_dns_query FAIL [record_query] expected=answer_count>=0 got=" + to_string(answer_count))
    }
    if elevated < 0 {
        panic("pe_dns_query FAIL [record_query] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_dns_query FAIL [record_query] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(query_id) + "\t" + to_string(record_kind)
        + "\t" + to_string(answer_count) + "\t" + to_string(elevated) + "\n"
    pdq_append_row(pdq_queries_path(), row)
}

// ─── query_count: total query 수 ───
fn query_count() -> int {
    let t = pdq_read_table(pdq_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_answers: 모든 query answer_count 합 ───
fn total_answers() -> int {
    let t = pdq_read_table(pdq_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_record_kind: 특정 record_kind 의 query 수 ───
fn count_by_record_kind(kind: int) -> int {
    let t = pdq_read_table(pdq_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── network_count: elevated=1 인 query 수 (network resolution) ───
fn network_count() -> int {
    let t = pdq_read_table(pdq_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── query_answers: 특정 query_id 의 answer_count (없으면 0) ───
fn query_answers(query_id: int) -> int {
    let t = pdq_read_table(pdq_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == query_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdq_stats: [query_count, total_answers, network_count, count_by_record_kind(1)] ───
fn pdq_stats() -> array {
    let mut out = []
    out.push(query_count())
    out.push(total_answers())
    out.push(network_count())
    out.push(count_by_record_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdq-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdq()

    // 2. record 5 DNS queries across ≥3 record_kinds, ≥2 cache + ≥2 network
    //    layout:
    //      750001 A      / answers=1  / cache    (elevated=0)
    //      750002 AAAA   / answers=2  / network  (elevated=1)
    //      750003 CNAME  / answers=1  / network  (elevated=1)
    //      750004 A      / answers=3  / cache    (elevated=0)
    //      750005 MX     / answers=2  / network  (elevated=1)
    record_query(750001, 1, 1, 0)
    r0_emit("pe_dns_query_record",
        "\"query_id\":750001,\"record_kind\":1,\"answer_count\":1,\"elevated\":0,\"target\":\"A_cache\"")

    record_query(750002, 2, 2, 1)
    r0_emit("pe_dns_query_record",
        "\"query_id\":750002,\"record_kind\":2,\"answer_count\":2,\"elevated\":1,\"target\":\"AAAA_net\"")

    record_query(750003, 3, 1, 1)
    r0_emit("pe_dns_query_record",
        "\"query_id\":750003,\"record_kind\":3,\"answer_count\":1,\"elevated\":1,\"target\":\"CNAME_net\"")

    record_query(750004, 1, 3, 0)
    r0_emit("pe_dns_query_record",
        "\"query_id\":750004,\"record_kind\":1,\"answer_count\":3,\"elevated\":0,\"target\":\"A_cache\"")

    record_query(750005, 4, 2, 1)
    r0_emit("pe_dns_query_record",
        "\"query_id\":750005,\"record_kind\":4,\"answer_count\":2,\"elevated\":1,\"target\":\"MX_net\"")

    // 3. query_count = 5
    let c = query_count()
    if c != 5 {
        panic("pe_dns_query FAIL [query_count] expected=5 got=" + to_string(c))
    }

    // 4. total_answers = 1+2+1+3+2 = 9
    let ta = total_answers()
    if ta != 9 {
        panic("pe_dns_query FAIL [total_answers] expected=9 got=" + to_string(ta))
    }

    // 5. count_by_record_kind sanity
    let k1 = count_by_record_kind(1)
    if k1 != 2 {
        panic("pe_dns_query FAIL [count_by_record_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_record_kind(2)
    if k2 != 1 {
        panic("pe_dns_query FAIL [count_by_record_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_record_kind(3)
    if k3 != 1 {
        panic("pe_dns_query FAIL [count_by_record_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_record_kind(4)
    if k4 != 1 {
        panic("pe_dns_query FAIL [count_by_record_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_record_kind(5)
    if k5 != 0 {
        panic("pe_dns_query FAIL [count_by_record_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k6 = count_by_record_kind(6)
    if k6 != 0 {
        panic("pe_dns_query FAIL [count_by_record_kind(6)] expected=0 got=" + to_string(k6))
    }
    let k99 = count_by_record_kind(99)
    if k99 != 0 {
        panic("pe_dns_query FAIL [count_by_record_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. network_count = 3 (elevated=1: 750002, 750003, 750005)
    let nc = network_count()
    if nc != 3 {
        panic("pe_dns_query FAIL [network_count] expected=3 got=" + to_string(nc))
    }

    // 7. query_answers sanity
    let a2 = query_answers(750002)
    if a2 != 2 {
        panic("pe_dns_query FAIL [query_answers(750002)] expected=2 got=" + to_string(a2))
    }
    let a4 = query_answers(750004)
    if a4 != 3 {
        panic("pe_dns_query FAIL [query_answers(750004)] expected=3 got=" + to_string(a4))
    }
    let a_miss = query_answers(9999)
    if a_miss != 0 {
        panic("pe_dns_query FAIL [query_answers(9999)] expected=0 got=" + to_string(a_miss))
    }

    // 8. pdq_stats() = [5, 9, 3, 2]
    let s = pdq_stats()
    if len(s) != 4 {
        panic("pe_dns_query FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_dns_query FAIL [stats query_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 9 {
        panic("pe_dns_query FAIL [stats total_answers] expected=9 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_dns_query FAIL [stats network_count] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_dns_query FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_dns_query_stats",
        "\"query_count\":" + to_string(s[0])
        + ",\"total_answers\":" + to_string(s[1])
        + ",\"network_count\":" + to_string(s[2])
        + ",\"kind_A\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_dns_query FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdq()
    let s2 = pdq_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dns_query FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dns_query self_test PASS (queries=" + to_string(s[0])
        + ", answers=" + to_string(s[1]) + ", network=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdq_stats()
            println("query_count\t" + to_string(s[0]))
            println("total_answers\t" + to_string(s[1]))
            println("network_count\t" + to_string(s[2]))
            println("count_kind_A\t" + to_string(s[3]))
            return
        }
        if sub == "answers" {
            if len(a) >= 4 {
                let qid = to_int(a[3])
                println("query_answers\t" + to_string(query_answers(qid)))
                return
            }
            println("usage: hexa run pe_dns_query.hexa answers <query_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_record_kind\t" + to_string(count_by_record_kind(kind)))
                return
            }
            println("usage: hexa run pe_dns_query.hexa count <record_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdq()
            println("cleaned: " + pdq_dir())
            return
        }
        if sub == "dir" {
            println(pdq_dir())
            return
        }
    }
    println("usage: hexa run pe_dns_query.hexa { self-test | stats | answers <query_id> | count <record_kind> | cleanup | dir }")
}
