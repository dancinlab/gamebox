// lib/loader/pe_call_conv_cdecl.hexa — cycle68 i386 cdecl adapter telemetry skeleton
//
// i386 cdecl ABI: 모든 인자 stack 으로 전달 (right-to-left, caller cleans).
// varargs (printf 류) 친화적 — callee 가 push 된 인자 개수를 모르므로 caller 가
// stack pointer 를 복원. arm64 adapter 는 stack frame 을 walk 해서 x0..x7 +
// stack spill 로 매핑하고, va_arg 는 변동 부 길이만큼 추가 walk.
// 본 module 은 call site adapter telemetry tracker — 실 stack walk / va_list
// extraction 호출 X (cycle69+).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   cdecl ABI 의 caller-cleans-stack + va_arg 분류 logic 은 System V i386 /
//   Microsoft __cdecl spec 기반 자체 구현.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// va_arg_count: variadic 인 경우 fixed 이후 추가 인자 개수, non-variadic 이면 0.
//   (variadic 판정: va_arg_count > 0 또는 명시적 marker — 본 skeleton 은
//   va_arg_count > 0 을 variadic 으로 간주.)
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t param_count<int> \t param_bytes<int> \t va_arg_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pccc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_call_conv_cdecl"
}

fn pccc_calls_path() -> str {
    return pccc_dir() + "/calls.tsv"
}

fn pccc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pccc_dir() + "'")
}

fn cleanup_pccc() -> void {
    pccc_ensure_dir()
    let _ = exec("rm -f '" + pccc_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pccc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pccc_append_row(path: str, row: str) -> void {
    pccc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: cdecl site 1 건 기록 ───
fn record_call(call_id: int, param_count: int, param_bytes: int, va_arg_count: int) -> void {
    if call_id <= 0 {
        panic("pe_call_conv_cdecl FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if param_count < 0 {
        panic("pe_call_conv_cdecl FAIL [record_call] expected=param_count>=0 got=" + to_string(param_count))
    }
    if param_bytes < 0 {
        panic("pe_call_conv_cdecl FAIL [record_call] expected=param_bytes>=0 got=" + to_string(param_bytes))
    }
    if va_arg_count < 0 {
        panic("pe_call_conv_cdecl FAIL [record_call] expected=va_arg_count>=0 got=" + to_string(va_arg_count))
    }
    if va_arg_count > param_count {
        panic("pe_call_conv_cdecl FAIL [record_call] expected=va_arg_count<=param_count got="
            + to_string(va_arg_count) + ">" + to_string(param_count))
    }
    let row = to_string(call_id) + "\t" + to_string(param_count)
        + "\t" + to_string(param_bytes) + "\t" + to_string(va_arg_count) + "\n"
    pccc_append_row(pccc_calls_path(), row)
}

// ─── call_count: total call site 수 ───
fn call_count() -> int {
    let t = pccc_read_table(pccc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_param_bytes: 모든 call 의 param_bytes 합 ───
fn total_param_bytes() -> int {
    let t = pccc_read_table(pccc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── variadic_count: va_arg_count > 0 인 call 수 ───
fn variadic_count() -> int {
    let t = pccc_read_table(pccc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) > 0 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_va_args: 모든 call 의 va_arg_count 합 ───
fn total_va_args() -> int {
    let t = pccc_read_table(pccc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_param_count: 특정 param_count 의 call 수 ───
fn count_by_param_count(pc: int) -> int {
    let t = pccc_read_table(pccc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == pc {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── call_param_bytes: 특정 call_id 의 param_bytes (없으면 0) ───
fn call_param_bytes(call_id: int) -> int {
    let t = pccc_read_table(pccc_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pccc_stats: [call_count, total_param_bytes, variadic_count, total_va_args] ───
fn pccc_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_param_bytes())
    out.push(variadic_count())
    out.push(total_va_args())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pccc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pccc()

    // 2. record 5 cdecl sites — variadic ≥ 2, param_count 다양
    //   call 690001: 0 params (bytes=0)             — void()
    //   call 690002: 2 params (bytes=8, va=0)       — fixed (int,int)
    //   call 690003: 3 params (bytes=12, va=2)      — printf("%s%d", ...) variadic
    //   call 690004: 4 params (bytes=16, va=0)      — fixed (4 int)
    //   call 690005: 5 params (bytes=20, va=4)      — fprintf(fp, "%s", ...) variadic
    record_call(690001, 0, 0, 0)
    r0_emit("pe_call_conv_cdecl_record",
        "\"call_id\":690001,\"param_count\":0,\"param_bytes\":0,\"va_arg_count\":0,\"target\":\"void\"")

    record_call(690002, 2, 8, 0)
    r0_emit("pe_call_conv_cdecl_record",
        "\"call_id\":690002,\"param_count\":2,\"param_bytes\":8,\"va_arg_count\":0,\"target\":\"fixed_2\"")

    record_call(690003, 3, 12, 2)
    r0_emit("pe_call_conv_cdecl_record",
        "\"call_id\":690003,\"param_count\":3,\"param_bytes\":12,\"va_arg_count\":2,\"target\":\"printf_va2\"")

    record_call(690004, 4, 16, 0)
    r0_emit("pe_call_conv_cdecl_record",
        "\"call_id\":690004,\"param_count\":4,\"param_bytes\":16,\"va_arg_count\":0,\"target\":\"fixed_4\"")

    record_call(690005, 5, 20, 4)
    r0_emit("pe_call_conv_cdecl_record",
        "\"call_id\":690005,\"param_count\":5,\"param_bytes\":20,\"va_arg_count\":4,\"target\":\"fprintf_va4\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("pe_call_conv_cdecl FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. total_param_bytes = 0+8+12+16+20 = 56
    let tpb = total_param_bytes()
    if tpb != 56 {
        panic("pe_call_conv_cdecl FAIL [total_param_bytes] expected=56 got=" + to_string(tpb))
    }

    // 5. variadic_count = 2 (690003, 690005)
    let vc = variadic_count()
    if vc != 2 {
        panic("pe_call_conv_cdecl FAIL [variadic_count] expected=2 got=" + to_string(vc))
    }

    // 6. total_va_args = 2+4 = 6
    let tva = total_va_args()
    if tva != 6 {
        panic("pe_call_conv_cdecl FAIL [total_va_args] expected=6 got=" + to_string(tva))
    }

    // 7. count_by_param_count sanity
    let pc0 = count_by_param_count(0)
    if pc0 != 1 {
        panic("pe_call_conv_cdecl FAIL [count_by_param_count(0)] expected=1 got=" + to_string(pc0))
    }
    let pc2 = count_by_param_count(2)
    if pc2 != 1 {
        panic("pe_call_conv_cdecl FAIL [count_by_param_count(2)] expected=1 got=" + to_string(pc2))
    }
    let pc3 = count_by_param_count(3)
    if pc3 != 1 {
        panic("pe_call_conv_cdecl FAIL [count_by_param_count(3)] expected=1 got=" + to_string(pc3))
    }
    let pc4 = count_by_param_count(4)
    if pc4 != 1 {
        panic("pe_call_conv_cdecl FAIL [count_by_param_count(4)] expected=1 got=" + to_string(pc4))
    }
    let pc5 = count_by_param_count(5)
    if pc5 != 1 {
        panic("pe_call_conv_cdecl FAIL [count_by_param_count(5)] expected=1 got=" + to_string(pc5))
    }
    let pc99 = count_by_param_count(99)
    if pc99 != 0 {
        panic("pe_call_conv_cdecl FAIL [count_by_param_count(99)] expected=0 got=" + to_string(pc99))
    }

    // 8. call_param_bytes sanity
    let b3 = call_param_bytes(690003)
    if b3 != 12 {
        panic("pe_call_conv_cdecl FAIL [call_param_bytes(690003)] expected=12 got=" + to_string(b3))
    }
    let b5 = call_param_bytes(690005)
    if b5 != 20 {
        panic("pe_call_conv_cdecl FAIL [call_param_bytes(690005)] expected=20 got=" + to_string(b5))
    }
    let b1 = call_param_bytes(690001)
    if b1 != 0 {
        panic("pe_call_conv_cdecl FAIL [call_param_bytes(690001)] expected=0 got=" + to_string(b1))
    }
    let b_miss = call_param_bytes(9999)
    if b_miss != 0 {
        panic("pe_call_conv_cdecl FAIL [call_param_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 9. pccc_stats() = [5, 56, 2, 6]
    let s = pccc_stats()
    if len(s) != 4 {
        panic("pe_call_conv_cdecl FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_call_conv_cdecl FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 56 {
        panic("pe_call_conv_cdecl FAIL [stats total_param_bytes] expected=56 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_call_conv_cdecl FAIL [stats variadic_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 6 {
        panic("pe_call_conv_cdecl FAIL [stats total_va_args] expected=6 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_call_conv_cdecl_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_param_bytes\":" + to_string(s[1])
        + ",\"variadic_count\":" + to_string(s[2])
        + ",\"total_va_args\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_call_conv_cdecl FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pccc()
    let s2 = pccc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_call_conv_cdecl FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_call_conv_cdecl self_test PASS (calls=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", variadic=" + to_string(s[2])
        + ", va_args=" + to_string(s[3]) + ", emits=" + to_string(emit_n)
        + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pccc_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_param_bytes\t" + to_string(s[1]))
            println("variadic_count\t" + to_string(s[2]))
            println("total_va_args\t" + to_string(s[3]))
            return
        }
        if sub == "params" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_param_bytes\t" + to_string(call_param_bytes(cid)))
                return
            }
            println("usage: hexa run pe_call_conv_cdecl.hexa params <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let arg = a[3]
                if arg == "variadic" {
                    println("variadic_count\t" + to_string(variadic_count()))
                    return
                }
                let pc = to_int(arg)
                println("count_by_param_count\t" + to_string(count_by_param_count(pc)))
                return
            }
            println("usage: hexa run pe_call_conv_cdecl.hexa count { variadic | <param_count> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pccc()
            println("cleaned: " + pccc_dir())
            return
        }
        if sub == "dir" {
            println(pccc_dir())
            return
        }
    }
    println("usage: hexa run pe_call_conv_cdecl.hexa { self-test | stats | params <call_id> | count variadic | count <param_count> | cleanup | dir }")
}
