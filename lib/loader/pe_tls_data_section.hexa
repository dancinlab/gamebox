// lib/loader/pe_tls_data_section.hexa — stage3 PE TLS data section parser skeleton
//
// PE TLS Directory: StartAddressOfRawData / EndAddressOfRawData /
// AddressOfIndex / SizeOfZeroFill. cycle 60 pe_tls_stage2 = callbacks. 본
// module = data init image (per-thread copy 됨).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   참조 only — Microsoft PE/COFF spec (TLS Directory):
//     https://learn.microsoft.com/en-us/windows/win32/debug/pe-format#the-tls-section
//
// own 2 mandate:
//   - r0_emit ≥ 4
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("pe_tls_data_section FAIL [<sub>] expected=X got=Y")
//
// 범위 (stage3 — instrumentation only):
//   stage3 = TLS data section 메타데이터 추적 — synthetic recording.
//   stage4 = 실제 per-thread allocation + raw data copy + zero-fill.
//
// Schema (TSV): pe_id<int> | raw_data_size<int> | zero_fill_size<int> | alignment<int>

use "../perf/r0_common"

// ─── persist directory ───
fn ptds_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_tls_data_section"
}

fn ptds_table_path() -> str {
    return ptds_dir() + "/data_section.tsv"
}

fn ensure_ptds_dir() -> void {
    let _ = exec("mkdir -p '" + ptds_dir() + "'")
}

fn cleanup_ptds() -> void {
    ensure_ptds_dir()
    let _ = exec("rm -f '" + ptds_table_path() + "'")
}

// ─── 공통 file IO ───
fn ptds_read_table() -> str {
    let path = ptds_table_path()
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ptds_append_row(row: str) -> void {
    ensure_ptds_dir()
    let path = ptds_table_path()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_tls_data: TLS data section row 1 추가 ───
fn record_tls_data(pe_id: int, raw_data_size: int, zero_fill_size: int, alignment: int) -> void {
    let row = to_string(pe_id) + "\t" + to_string(raw_data_size)
        + "\t" + to_string(zero_fill_size) + "\t" + to_string(alignment) + "\n"
    ptds_append_row(row)
}

// ─── tls_data_count: 전체 row 수 ───
fn tls_data_count() -> int {
    let t = ptds_read_table()
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        if lines[i] != "" {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ─── total_raw_size: 모든 raw_data_size 합 ───
fn total_raw_size() -> int {
    let t = ptds_read_table()
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_zero_size: 모든 zero_fill_size 합 ───
fn total_zero_size() -> int {
    let t = ptds_read_table()
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── pe_tls_total_size: 특정 pe_id 의 raw + zero 합 ───
fn pe_tls_total_size(pe_id: int) -> int {
    let t = ptds_read_table()
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    let key = to_string(pe_id)
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if parts[0] == key {
                    sum = sum + to_int(parts[1]) + to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return sum
}

// ─── ptds_stats: [tls_data_count, total_raw_size, total_zero_size, raw+zero] ───
fn ptds_stats() -> array {
    let mut out = []
    let c = tls_data_count()
    let r = total_raw_size()
    let z = total_zero_size()
    out.push(c)
    out.push(r)
    out.push(z)
    out.push(r + z)
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "petds-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ptds()
    if tls_data_count() != 0 {
        panic("pe_tls_data_section FAIL [pre cleanup] expected=0 got=" + to_string(tls_data_count()))
    }

    // 2. 3 PEs synthetic
    record_tls_data(94001, 256, 128, 16)    // Battle.net Setup
    record_tls_data(94002, 1024, 512, 16)   // D2R.exe
    record_tls_data(94003, 0, 4096, 4)      // zerofill-only PE

    // emit 1: ptds_record (PE 94001)
    r0_emit("ptds_record",
        "\"pe_id\":94001,\"raw_data_size\":256,\"zero_fill_size\":128,\"alignment\":16")

    // emit 2: ptds_record (PE 94002)
    r0_emit("ptds_record",
        "\"pe_id\":94002,\"raw_data_size\":1024,\"zero_fill_size\":512,\"alignment\":16")

    // emit 3: ptds_record (PE 94003)
    r0_emit("ptds_record",
        "\"pe_id\":94003,\"raw_data_size\":0,\"zero_fill_size\":4096,\"alignment\":4")

    // 3. tls_data_count = 3
    let total = tls_data_count()
    if total != 3 {
        panic("pe_tls_data_section FAIL [tls_data_count] expected=3 got=" + to_string(total))
    }

    // 4. total_raw_size = 256+1024+0 = 1280
    let raw = total_raw_size()
    if raw != 1280 {
        panic("pe_tls_data_section FAIL [total_raw_size] expected=1280 got=" + to_string(raw))
    }

    // 5. total_zero_size = 128+512+4096 = 4736
    let zero = total_zero_size()
    if zero != 4736 {
        panic("pe_tls_data_section FAIL [total_zero_size] expected=4736 got=" + to_string(zero))
    }

    // 6. pe_tls_total_size per PE
    let s1 = pe_tls_total_size(94001)
    if s1 != 384 {
        panic("pe_tls_data_section FAIL [pe_tls_total_size 94001] expected=384 got=" + to_string(s1))
    }
    let s2 = pe_tls_total_size(94002)
    if s2 != 1536 {
        panic("pe_tls_data_section FAIL [pe_tls_total_size 94002] expected=1536 got=" + to_string(s2))
    }
    let s3 = pe_tls_total_size(94003)
    if s3 != 4096 {
        panic("pe_tls_data_section FAIL [pe_tls_total_size 94003] expected=4096 got=" + to_string(s3))
    }
    let s_none = pe_tls_total_size(9999)
    if s_none != 0 {
        panic("pe_tls_data_section FAIL [pe_tls_total_size 9999] expected=0 got=" + to_string(s_none))
    }

    // 7. ptds_stats() = [3, 1280, 4736, 6016]
    let stats = ptds_stats()
    if len(stats) != 4 {
        panic("pe_tls_data_section FAIL [stats len] expected=4 got=" + to_string(len(stats)))
    }
    if stats[0] != 3 {
        panic("pe_tls_data_section FAIL [stats[0]] expected=3 got=" + to_string(stats[0]))
    }
    if stats[1] != 1280 {
        panic("pe_tls_data_section FAIL [stats[1]] expected=1280 got=" + to_string(stats[1]))
    }
    if stats[2] != 4736 {
        panic("pe_tls_data_section FAIL [stats[2]] expected=4736 got=" + to_string(stats[2]))
    }
    if stats[3] != 6016 {
        panic("pe_tls_data_section FAIL [stats[3]] expected=6016 got=" + to_string(stats[3]))
    }

    // emit 4: ptds_stats summary
    r0_emit("ptds_stats",
        "\"tls_data_count\":" + to_string(stats[0])
        + ",\"total_raw_size\":" + to_string(stats[1])
        + ",\"total_zero_size\":" + to_string(stats[2])
        + ",\"total_size\":" + to_string(stats[3]))

    // 8. r0_emit count >= 4
    let emit_n = r0_session_count(sid)
    if emit_n < 4 {
        panic("pe_tls_data_section FAIL [r0 emit count] expected=>=4 got=" + to_string(emit_n))
    }

    // 9. cleanup 후 모두 0
    cleanup_ptds()
    if tls_data_count() != 0 {
        panic("pe_tls_data_section FAIL [post cleanup count] expected=0 got=" + to_string(tls_data_count()))
    }
    if total_raw_size() != 0 {
        panic("pe_tls_data_section FAIL [post cleanup raw] expected=0 got=" + to_string(total_raw_size()))
    }
    if total_zero_size() != 0 {
        panic("pe_tls_data_section FAIL [post cleanup zero] expected=0 got=" + to_string(total_zero_size()))
    }
    let stats_after = ptds_stats()
    let i = 0
    while i < len(stats_after) {
        if stats_after[i] != 0 {
            panic("pe_tls_data_section FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(stats_after[i]))
        }
        i = i + 1
    }

    // 10. PASS
    println("  ✅ pe_tls_data_section self_test PASS (3 PEs, raw="
        + to_string(stats[1]) + "B, zero=" + to_string(stats[2]) + "B, total="
        + to_string(stats[3]) + "B, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ptds_stats()
            println("tls_data_count\t" + to_string(s[0]))
            println("total_raw_size\t" + to_string(s[1]))
            println("total_zero_size\t" + to_string(s[2]))
            println("total_size\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                println(to_string(pe_tls_total_size(pid)))
                return
            }
            println("usage: size <pe_id>")
            return
        }
        if sub == "cleanup" {
            cleanup_ptds()
            println("cleaned: " + ptds_dir())
            return
        }
    }
    println("usage: hexa run pe_tls_data_section.hexa { self-test | stats | size <pe_id> | cleanup }")
}
