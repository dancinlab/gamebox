// lib/loader/pe_gdi32_core.hexa — GDI32.dll core syscall surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine gdi32 source 측 코드 인용 0. CoreGraphics / CGContext / Quartz / Metal 직접
//       binding 0. windows.h / wingdi.h reference shape 만 (HDC / HBITMAP / HGDIOBJ / SIZE /
//       BITMAPINFO / LOGFONTW). 실 GetDC / 실 BitBlt / 실 TextOutW / 실 CreateBitmap = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track Q — GDI32 (gdi32.dll) core graphics device interface surface coverage 15 fn (skeleton row 만).
// Track O predecessor (KERNEL32 18 fn) + Track Q1 sibling (USER32 20 fn) 후 본 Track Q2 는 GDI32 측
// 핵심 drawing / DC / GDI object / font primitive 측 4 group baseline land. cycle 29 측 46/435
// (~10.57%) → cycle 30 측 61/435 (~14.02%) coverage progression (+15 fn 신규).
//
// 대상 fn (15 fn — 4 group, fn_kind 0..14 canonical map see fn_kind_name() below):
//   DC mgmt (4):   GetDC(0) / ReleaseDC(1) / CreateCompatibleDC(2) / DeleteDC(3)
//   Drawing (5):   BitBlt(4) / StretchBlt(5) / TextOutW(6) / Rectangle(7) / MoveToEx(8)
//   Object (4):    CreateBitmap(9) / CreateCompatibleBitmap(10) / SelectObject(11) / DeleteObject(12)
//   Font (2):      CreateFontW(13) / GetTextExtentPoint32W(14)
//
// synthetic HDC: hdc_hex "0x21010800" (D2R primary DC 가정).
// synthetic HBITMAP: hbmp_hex "0x22020900".
// synthetic HGDIOBJ (font/pen/brush 공용): hgdi_hex "0x23030A00".
// synthetic LOGFONTW (92 byte reference shape, lfHeight = -12 LE encoded).
// synthetic BITMAPINFOHEADER (40 byte): width=1280 height=720 planes=1 bitCount=32.
// synthetic SIZE (8 byte = 2 × LONG): cx=128 cy=24 (text extent 가정).
//
// persist schema (TSV — 4 table): syscall_invoke / dc_lifecycle / draw_op / gdi_object_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pgdi_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_gdi32_core"
}

fn pgdi_syscall_invoke_path() -> str {
    return pgdi_dir() + "/syscall_invoke.tsv"
}

fn pgdi_dc_lifecycle_path() -> str {
    return pgdi_dir() + "/dc_lifecycle.tsv"
}

fn pgdi_draw_op_path() -> str {
    return pgdi_dir() + "/draw_op.tsv"
}

fn pgdi_gdi_object_event_path() -> str {
    return pgdi_dir() + "/gdi_object_event.tsv"
}

fn pgdi_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pgdi_dir() + "'")
}

fn cleanup_pgdi() -> void {
    pgdi_ensure_dir()
    let _ = exec("rm -f '" + pgdi_syscall_invoke_path() + "' '" + pgdi_dc_lifecycle_path()
        + "' '" + pgdi_draw_op_path() + "' '" + pgdi_gdi_object_event_path() + "'")
}

// ─── 공통 file IO ───
fn pgdi_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pgdi_append_row(path: str, row: str) -> void {
    pgdi_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pgdi_count_rows(path: str, min_cols: int) -> int {
    let t = pgdi_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (15 fn coverage, fn_kind 0..14) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "GetDC" }
    if k == 1 { return "ReleaseDC" }
    if k == 2 { return "CreateCompatibleDC" }
    if k == 3 { return "DeleteDC" }
    if k == 4 { return "BitBlt" }
    if k == 5 { return "StretchBlt" }
    if k == 6 { return "TextOutW" }
    if k == 7 { return "Rectangle" }
    if k == 8 { return "MoveToEx" }
    if k == 9 { return "CreateBitmap" }
    if k == 10 { return "CreateCompatibleBitmap" }
    if k == 11 { return "SelectObject" }
    if k == 12 { return "DeleteObject" }
    if k == 13 { return "CreateFontW" }
    if k == 14 { return "GetTextExtentPoint32W" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "dc_mgmt"
        }
    }
    if k >= 4 {
        if k <= 8 {
            return "drawing"
        }
    }
    if k >= 9 {
        if k <= 12 {
            return "object"
        }
    }
    if k >= 13 {
        if k <= 14 {
            return "font"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: GDI32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_gdi32_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_gdi32_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 14 {
        panic("pe_gdi32_core FAIL [record_syscall_invoke] expected=fn_kind<=14 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_gdi32_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_gdi32_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pgdi_append_row(pgdi_syscall_invoke_path(), row)
}

// ─── record_dc_lifecycle: GetDC / ReleaseDC / CreateCompatibleDC / DeleteDC row ───
fn record_dc_lifecycle(life_id: int, op_id: str, hdc_hex: str, hwnd_hex: str, status: str) -> void {
    if life_id <= 0 {
        panic("pe_gdi32_core FAIL [record_dc_lifecycle] expected=life_id>0 got=" + to_string(life_id))
    }
    if op_id == "" {
        panic("pe_gdi32_core FAIL [record_dc_lifecycle] expected=op_id!=empty got=empty")
    }
    if hdc_hex == "" {
        panic("pe_gdi32_core FAIL [record_dc_lifecycle] expected=hdc_hex!=empty got=empty")
    }
    if hwnd_hex == "" {
        panic("pe_gdi32_core FAIL [record_dc_lifecycle] expected=hwnd_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_gdi32_core FAIL [record_dc_lifecycle] expected=status!=empty got=empty")
    }
    let row = to_string(life_id) + "\t" + op_id + "\t" + hdc_hex + "\t"
        + hwnd_hex + "\t" + status + "\n"
    pgdi_append_row(pgdi_dc_lifecycle_path(), row)
}

// ─── record_draw_op: BitBlt / StretchBlt / TextOutW / Rectangle row ───
fn record_draw_op(draw_id: int, draw_kind: str, hdc_hex: str, payload_hex: str, status: str) -> void {
    if draw_id <= 0 {
        panic("pe_gdi32_core FAIL [record_draw_op] expected=draw_id>0 got=" + to_string(draw_id))
