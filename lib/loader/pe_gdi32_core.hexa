    if hdc_hex == "" {
        panic("pe_gdi32_core FAIL [record_draw_op] expected=hdc_hex!=empty got=empty")
    }
    if payload_hex == "" {
        panic("pe_gdi32_core FAIL [record_draw_op] expected=payload_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_gdi32_core FAIL [record_draw_op] expected=status!=empty got=empty")
    }
    let row = to_string(draw_id) + "\t" + draw_kind + "\t" + hdc_hex + "\t"
        + payload_hex + "\t" + status + "\n"
    pgdi_append_row(pgdi_draw_op_path(), row)
}

// ─── record_gdi_object_event: GDI obj fn event row (HBITMAP / HFONT / HGDIOBJ synth) ───
fn record_gdi_object_event(evt_id: int, obj_kind: str, fn_name: str, hgdi_hex: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_gdi32_core FAIL [record_gdi_object_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if obj_kind == "" {
        panic("pe_gdi32_core FAIL [record_gdi_object_event] expected=obj_kind!=empty got=empty")
    }
    if fn_name == "" {
        panic("pe_gdi32_core FAIL [record_gdi_object_event] expected=fn_name!=empty got=empty")
    }
    if hgdi_hex == "" {
        panic("pe_gdi32_core FAIL [record_gdi_object_event] expected=hgdi_hex!=empty got=empty")
    }
    if status == "" {
        panic("pe_gdi32_core FAIL [record_gdi_object_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + obj_kind + "\t" + fn_name + "\t"
        + hgdi_hex + "\t" + status + "\n"
    pgdi_append_row(pgdi_gdi_object_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pgdi_count_rows(pgdi_syscall_invoke_path(), 4)
}

fn dc_lifecycle_count() -> int {
    return pgdi_count_rows(pgdi_dc_lifecycle_path(), 5)
}

fn draw_op_count() -> int {
    return pgdi_count_rows(pgdi_draw_op_path(), 5)
}

fn gdi_object_event_count() -> int {
    return pgdi_count_rows(pgdi_gdi_object_event_path(), 5)
}

fn pgdi_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(dc_lifecycle_count())
    out.push(draw_op_count())
    out.push(gdi_object_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pgdi-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pgdi()

    // ─── 1. syscall_invoke × 15 (one per fn, 4 group coverage) ───
    //   DC mgmt group (4)
    record_syscall_invoke(1, 0, "GetDC", "PARTIAL")
    println("__GDI32__ PARTIAL GetDC")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"GetDC\",\"fn_group\":\"dc_mgmt\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21010800\",\"hwnd_hex\":\"0x00010404\"")
    record_syscall_invoke(2, 1, "ReleaseDC", "PARTIAL")
    println("__GDI32__ PARTIAL ReleaseDC")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"ReleaseDC\",\"fn_group\":\"dc_mgmt\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21010800\",\"hwnd_hex\":\"0x00010404\",\"return_synth\":1")
    record_syscall_invoke(3, 2, "CreateCompatibleDC", "PARTIAL")
    println("__GDI32__ PARTIAL CreateCompatibleDC")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"CreateCompatibleDC\",\"fn_group\":\"dc_mgmt\",\"status\":\"PARTIAL\",\"src_hdc_hex\":\"0x21010800\",\"new_hdc_hex\":\"0x21020900\"")
    record_syscall_invoke(4, 3, "DeleteDC", "PARTIAL")
    println("__GDI32__ PARTIAL DeleteDC")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"DeleteDC\",\"fn_group\":\"dc_mgmt\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21020900\",\"return_synth\":1")

    //   Drawing group (5)
    record_syscall_invoke(5, 4, "BitBlt", "PARTIAL")
    println("__GDI32__ PARTIAL BitBlt")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"BitBlt\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"dst_hdc\":\"0x21010800\",\"src_hdc\":\"0x21020900\",\"width\":1280,\"height\":720,\"raster_op\":\"0x00CC0020\"")
    record_syscall_invoke(6, 5, "StretchBlt", "PARTIAL")
    println("__GDI32__ PARTIAL StretchBlt")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"StretchBlt\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"dst_w\":1920,\"dst_h\":1080,\"src_w\":1280,\"src_h\":720,\"raster_op\":\"0x00CC0020\"")
    record_syscall_invoke(7, 6, "TextOutW", "PARTIAL")
    println("__GDI32__ PARTIAL TextOutW")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"TextOutW\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21010800\",\"x\":10,\"y\":10,\"text_w_synth\":\"D2R Loading\",\"len\":11")
    record_syscall_invoke(8, 7, "Rectangle", "PARTIAL")
    println("__GDI32__ PARTIAL Rectangle")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"Rectangle\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21010800\",\"left\":0,\"top\":0,\"right\":1280,\"bottom\":720")
    record_syscall_invoke(9, 8, "MoveToEx", "PARTIAL")
    println("__GDI32__ PARTIAL MoveToEx")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"MoveToEx\",\"fn_group\":\"drawing\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21010800\",\"x\":640,\"y\":400")

    //   Object group (4: CreateBitmap + CreateCompatibleBitmap + SelectObject + DeleteObject)
    record_syscall_invoke(10, 9, "CreateBitmap", "PARTIAL")
    println("__GDI32__ PARTIAL CreateBitmap")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"CreateBitmap\",\"fn_group\":\"object\",\"status\":\"PARTIAL\",\"width\":1280,\"height\":720,\"planes\":1,\"bit_count\":32,\"hbmp_hex\":\"0x22020900\"")
    record_syscall_invoke(11, 10, "CreateCompatibleBitmap", "PARTIAL")
    println("__GDI32__ PARTIAL CreateCompatibleBitmap")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"CreateCompatibleBitmap\",\"fn_group\":\"object\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21010800\",\"width\":1280,\"height\":720,\"hbmp_hex\":\"0x22030A00\"")
    record_syscall_invoke(12, 11, "SelectObject", "PARTIAL")
    println("__GDI32__ PARTIAL SelectObject")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"SelectObject\",\"fn_group\":\"object\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21020900\",\"hgdi_hex\":\"0x22020900\",\"prev_hgdi_hex\":\"0x23030A00\"")
    record_syscall_invoke(13, 12, "DeleteObject", "PARTIAL")
    println("__GDI32__ PARTIAL DeleteObject")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":13,\"fn_kind\":12,\"fn_name\":\"DeleteObject\",\"fn_group\":\"object\",\"status\":\"PARTIAL\",\"hgdi_hex\":\"0x22020900\",\"return_synth\":1")

    //   Font group (2: CreateFontW + GetTextExtentPoint32W)
    record_syscall_invoke(14, 13, "CreateFontW", "PARTIAL")
    println("__GDI32__ PARTIAL CreateFontW")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":14,\"fn_kind\":13,\"fn_name\":\"CreateFontW\",\"fn_group\":\"font\",\"status\":\"PARTIAL\",\"face_name_w_synth\":\"Exocet\",\"height\":-12,\"weight\":400,\"hfont_hex\":\"0x23030A00\",\"logfont_synth_bytes\":92")
    record_syscall_invoke(15, 14, "GetTextExtentPoint32W", "PARTIAL")
    println("__GDI32__ PARTIAL GetTextExtentPoint32W")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":15,\"fn_kind\":14,\"fn_name\":\"GetTextExtentPoint32W\",\"fn_group\":\"font\",\"status\":\"PARTIAL\",\"hdc_hex\":\"0x21010800\",\"text_w_synth\":\"D2R Loading\",\"size_synth_hex\":\"8000000018000000\",\"cx\":128,\"cy\":24")

    // ─── 2. dc_lifecycle × 4 (get / create_compat / select / delete) ───
    record_dc_lifecycle(1, "get", "0x21010800", "0x00010404", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"dc_lifecycle\",\"life_id\":1,\"op_id\":\"get\",\"hdc_hex\":\"0x21010800\",\"hwnd_hex\":\"0x00010404\",\"status\":\"PARTIAL\"")
    record_dc_lifecycle(2, "create_compat", "0x21020900", "0x00010404", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"dc_lifecycle\",\"life_id\":2,\"op_id\":\"create_compat\",\"hdc_hex\":\"0x21020900\",\"hwnd_hex\":\"0x00010404\",\"src_hdc\":\"0x21010800\",\"status\":\"PARTIAL\"")
    record_dc_lifecycle(3, "release", "0x21010800", "0x00010404", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"dc_lifecycle\",\"life_id\":3,\"op_id\":\"release\",\"hdc_hex\":\"0x21010800\",\"hwnd_hex\":\"0x00010404\",\"return_synth\":1,\"status\":\"PARTIAL\"")
    record_dc_lifecycle(4, "delete", "0x21020900", "0x00010404", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"dc_lifecycle\",\"life_id\":4,\"op_id\":\"delete\",\"hdc_hex\":\"0x21020900\",\"hwnd_hex\":\"0x00010404\",\"return_synth\":1,\"status\":\"PARTIAL\"")

    // ─── 3. draw_op × 4 (bitblt / stretchblt / textout / rect) ───
    record_draw_op(1, "bitblt", "0x21010800", "00050000D0020000CC0020", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"draw_op\",\"draw_id\":1,\"draw_kind\":\"bitblt\",\"hdc_hex\":\"0x21010800\",\"src_hdc\":\"0x21020900\",\"width\":1280,\"height\":720,\"raster_op\":\"0x00CC0020\",\"status\":\"PARTIAL\"")
    record_draw_op(2, "stretchblt", "0x21010800", "8007000038040000", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"draw_op\",\"draw_id\":2,\"draw_kind\":\"stretchblt\",\"hdc_hex\":\"0x21010800\",\"dst_w\":1920,\"dst_h\":1080,\"src_w\":1280,\"src_h\":720,\"raster_op\":\"0x00CC0020\",\"status\":\"PARTIAL\"")
    record_draw_op(3, "textout", "0x21010800", "0A0000000A0000000B000000", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"draw_op\",\"draw_id\":3,\"draw_kind\":\"textout\",\"hdc_hex\":\"0x21010800\",\"x\":10,\"y\":10,\"text_w_synth\":\"D2R Loading\",\"len\":11,\"status\":\"PARTIAL\"")
    record_draw_op(4, "rect", "0x21010800", "0000000000000000000500000F020000", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"draw_op\",\"draw_id\":4,\"draw_kind\":\"rect\",\"hdc_hex\":\"0x21010800\",\"left\":0,\"top\":0,\"right\":1280,\"bottom\":720,\"status\":\"PARTIAL\"")

    // ─── 4. gdi_object_event × 4 (bitmap create / select / font create / delete) ───
    record_gdi_object_event(1, "bitmap", "CreateBitmap", "0x22020900", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"gdi_object_event\",\"evt_id\":1,\"obj_kind\":\"bitmap\",\"fn_name\":\"CreateBitmap\",\"hgdi_hex\":\"0x22020900\",\"width\":1280,\"height\":720,\"bit_count\":32,\"status\":\"PARTIAL\"")
    record_gdi_object_event(2, "select", "SelectObject", "0x22020900", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"gdi_object_event\",\"evt_id\":2,\"obj_kind\":\"select\",\"fn_name\":\"SelectObject\",\"hgdi_hex\":\"0x22020900\",\"hdc_hex\":\"0x21020900\",\"prev_hgdi_hex\":\"0x23030A00\",\"status\":\"PARTIAL\"")
    record_gdi_object_event(3, "font", "CreateFontW", "0x23030A00", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"gdi_object_event\",\"evt_id\":3,\"obj_kind\":\"font\",\"fn_name\":\"CreateFontW\",\"hgdi_hex\":\"0x23030A00\",\"face_name_w_synth\":\"Exocet\",\"height\":-12,\"weight\":400,\"logfont_synth_bytes\":92,\"status\":\"PARTIAL\"")
    record_gdi_object_event(4, "delete", "DeleteObject", "0x22020900", "PARTIAL")
    r0_emit("pe_gdi32_core_record", "\"kind\":\"gdi_object_event\",\"evt_id\":4,\"obj_kind\":\"delete\",\"fn_name\":\"DeleteObject\",\"hgdi_hex\":\"0x22020900\",\"return_synth\":1,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 15 {
        panic("pe_gdi32_core FAIL [syscall_invoke_count] expected=15 got=" + to_string(si))
    }
    let dc = dc_lifecycle_count()
    if dc != 4 {
        panic("pe_gdi32_core FAIL [dc_lifecycle_count] expected=4 got=" + to_string(dc))
    }
    let dr = draw_op_count()
    if dr != 4 {
        panic("pe_gdi32_core FAIL [draw_op_count] expected=4 got=" + to_string(dr))
    }
    let go = gdi_object_event_count()
    if go != 4 {
        panic("pe_gdi32_core FAIL [gdi_object_event_count] expected=4 got=" + to_string(go))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "GetDC" { panic("pe_gdi32_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(4) != "BitBlt" { panic("pe_gdi32_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(9) != "CreateBitmap" { panic("pe_gdi32_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(13) != "CreateFontW" { panic("pe_gdi32_core FAIL [fn_kind_name(13)]") }
    if fn_kind_name(14) != "GetTextExtentPoint32W" { panic("pe_gdi32_core FAIL [fn_kind_name(14)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_gdi32_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "dc_mgmt" { panic("pe_gdi32_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "drawing" { panic("pe_gdi32_core FAIL [fn_group_name(4)]") }
    if fn_group_name(9) != "object" { panic("pe_gdi32_core FAIL [fn_group_name(9)]") }
    if fn_group_name(13) != "font" { panic("pe_gdi32_core FAIL [fn_group_name(13)]") }
    if fn_group_name(99) != "unknown" { panic("pe_gdi32_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pgdi_stats()
    if len(s) != 4 { panic("pe_gdi32_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 15 { panic("pe_gdi32_core FAIL [stats syscall_invoke_count] expected=15 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_gdi32_core FAIL [stats dc_lifecycle_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_gdi32_core FAIL [stats draw_op_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 4 { panic("pe_gdi32_core FAIL [stats gdi_object_event_count] expected=4 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_gdi32_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"dc_lifecycle_count\":" + to_string(s[1])
        + ",\"draw_op_count\":" + to_string(s[2])
        + ",\"gdi_object_event_count\":" + to_string(s[3]))

    r0_emit("pe_gdi32_core_summary",
        "\"target\":\"GDI32.dll\",\"fn_total\":15,\"fn_emit_partial\":15,\"groups\":[\"dc_mgmt\",\"drawing\",\"object\",\"font\"],\"hdc_synth\":\"0x21010800\",\"hbmp_synth\":\"0x22020900\",\"hgdi_synth\":\"0x23030A00\",\"logfont_synth_bytes\":92,\"bitmapinfo_synth_bytes\":40,\"size_synth_bytes\":8,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_gdi32_core_kpi",
        "\"dc_mgmt_emits\":4,\"drawing_emits\":5,\"object_emits\":4,\"font_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true")

    // ─── cycle 29 → 30 GDI32 coverage progression evidence emit ───
    r0_emit("pe_gdi32_core_coverage_progression",
        "\"surface\":\"GDI32_full_~24_fn_estimated\",\"cycle_29_count\":46,\"cycle_30_count\":61,\"delta\":15,\"cycle_29_percent\":10.57,\"cycle_30_percent\":14.02,\"cycle_30_module\":\"pe_gdi32_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\"")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_gdi32_core_round_trip_matrix",
        "\"surface\":\"GDI32_core_15_fn\",\"fn_partial\":15,\"fn_groups\":4,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.2\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real GetDC + BitBlt + TextOutW + CreateFontW pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"track_q_cross_link_to_track_o\":\"GDI32_baseline + USER32_20_fn + KERNEL32_18_fn = cumulative skeleton-tier surface coverage toward Warden natural-environment alignment\"")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_gdi32_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pgdi()
    let s2 = pgdi_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_gdi32_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_gdi32_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", dc_lifecycle=" + to_string(s[1])
        + ", draw_op=" + to_string(s[2]) + ", gdi_object_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pgdi_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("dc_lifecycle_count\t" + to_string(s[1]))
            println("draw_op_count\t" + to_string(s[2]))
            println("gdi_object_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_gdi32_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_gdi32_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pgdi()
            println("cleaned: " + pgdi_dir())
            return
        }
        if sub == "dir" {
            println(pgdi_dir())
            return
        }
    }
    println("usage: hexa run pe_gdi32_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
