// lib/loader/pe_tls_callback_dispatch.hexa — PE TLS callback dispatch telemetry skeleton
//
// PE TLS directory 의 AddressOfCallBacks array 는 NULL-terminated callback
// pointer list — loader/thread runtime 가 DLL_PROCESS_ATTACH /
// DLL_THREAD_ATTACH / DLL_THREAD_DETACH / DLL_PROCESS_DETACH 시점마다
// 각 callback 을 순회 호출한다. 본 module 은 dispatch event tracker —
// 실제 callback invoke 는 stage6 native bridge 가 담당.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// reason_kind code:
//   1 = process_attach   (DLL_PROCESS_ATTACH)
//   2 = thread_attach    (DLL_THREAD_ATTACH)
//   3 = thread_detach    (DLL_THREAD_DETACH)
//   4 = process_detach   (DLL_PROCESS_DETACH)
//
// persist schema (TSV — dispatches.tsv):
//   dispatch_id<int> \t reason_kind<int> \t callback_index<int> \t elapsed_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn ptlc_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_tls_callback_dispatch"
}

fn ptlc_dispatches_path() -> str {
    return ptlc_dir() + "/dispatches.tsv"
}

fn ptlc_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + ptlc_dir() + "'")
}

fn cleanup_ptlc() -> void {
    ptlc_ensure_dir()
    let _ = exec("rm -f '" + ptlc_dispatches_path() + "'")
}

// ─── 공통 file IO ───
fn ptlc_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn ptlc_append_row(path: str, row: str) -> void {
    ptlc_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dispatch: TLS callback dispatch 1 건 기록 ───
fn record_dispatch(dispatch_id: int, reason_kind: int, callback_index: int, elapsed_us: int) -> void {
    if dispatch_id <= 0 {
        panic("pe_tls_callback_dispatch FAIL [record_dispatch] expected=dispatch_id>0 got=" + to_string(dispatch_id))
    }
    if reason_kind < 1 {
        panic("pe_tls_callback_dispatch FAIL [record_dispatch] expected=reason_kind>=1 got=" + to_string(reason_kind))
    }
    if reason_kind > 4 {
        panic("pe_tls_callback_dispatch FAIL [record_dispatch] expected=reason_kind<=4 got=" + to_string(reason_kind))
    }
    if callback_index < 0 {
        panic("pe_tls_callback_dispatch FAIL [record_dispatch] expected=callback_index>=0 got=" + to_string(callback_index))
    }
    if elapsed_us < 0 {
        panic("pe_tls_callback_dispatch FAIL [record_dispatch] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    let row = to_string(dispatch_id) + "\t" + to_string(reason_kind)
        + "\t" + to_string(callback_index) + "\t" + to_string(elapsed_us) + "\n"
    ptlc_append_row(ptlc_dispatches_path(), row)
}

// ─── dispatch_count: total dispatch 수 ───
fn dispatch_count() -> int {
    let t = ptlc_read_table(ptlc_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_elapsed_us: 모든 dispatch elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = ptlc_read_table(ptlc_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_reason: 특정 reason_kind dispatch 수 ───
fn count_by_reason(reason_kind: int) -> int {
    let t = ptlc_read_table(ptlc_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == reason_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── max_callback_index: 최대 callback_index 값 (없으면 0) ───
fn max_callback_index() -> int {
    let t = ptlc_read_table(ptlc_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut mx = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let v = to_int(parts[2])
                if v > mx {
                    mx = v
                }
            }
        }
        i = i + 1
    }
    return mx
}

// ─── dispatch_elapsed_us: 특정 dispatch_id 의 elapsed_us (없으면 0) ───
fn dispatch_elapsed_us(dispatch_id: int) -> int {
    let t = ptlc_read_table(ptlc_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == dispatch_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── ptlc_stats: [dispatch_count, total_elapsed_us, count_by_reason(1), max_callback_index] ───
fn ptlc_stats() -> array {
    let mut out = []
    out.push(dispatch_count())
    out.push(total_elapsed_us())
    out.push(count_by_reason(1))
    out.push(max_callback_index())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "ptlc-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_ptlc()

    // 2. record 5 dispatches across all 4 reason_kinds
    record_dispatch(720001, 1, 0, 120)
    r0_emit("pe_tls_callback_dispatch_record",
        "\"dispatch_id\":720001,\"reason_kind\":1,\"callback_index\":0,\"elapsed_us\":120,\"target\":\"process_attach\"")

    record_dispatch(720002, 2, 1, 80)
    r0_emit("pe_tls_callback_dispatch_record",
        "\"dispatch_id\":720002,\"reason_kind\":2,\"callback_index\":1,\"elapsed_us\":80,\"target\":\"thread_attach\"")

    record_dispatch(720003, 2, 2, 95)
    r0_emit("pe_tls_callback_dispatch_record",
        "\"dispatch_id\":720003,\"reason_kind\":2,\"callback_index\":2,\"elapsed_us\":95,\"target\":\"thread_attach\"")

    record_dispatch(720004, 3, 1, 60)
    r0_emit("pe_tls_callback_dispatch_record",
        "\"dispatch_id\":720004,\"reason_kind\":3,\"callback_index\":1,\"elapsed_us\":60,\"target\":\"thread_detach\"")

    record_dispatch(720005, 4, 0, 200)
    r0_emit("pe_tls_callback_dispatch_record",
        "\"dispatch_id\":720005,\"reason_kind\":4,\"callback_index\":0,\"elapsed_us\":200,\"target\":\"process_detach\"")

    // 3. dispatch_count = 5
    let c = dispatch_count()
    if c != 5 {
        panic("pe_tls_callback_dispatch FAIL [dispatch_count] expected=5 got=" + to_string(c))
    }

    // 4. total_elapsed_us = 555
    let te = total_elapsed_us()
    if te != 555 {
        panic("pe_tls_callback_dispatch FAIL [total_elapsed_us] expected=555 got=" + to_string(te))
    }

    // 5. count_by_reason sanity
    let r1 = count_by_reason(1)
    if r1 != 1 {
        panic("pe_tls_callback_dispatch FAIL [count_by_reason(1)] expected=1 got=" + to_string(r1))
    }
    let r2 = count_by_reason(2)
    if r2 != 2 {
        panic("pe_tls_callback_dispatch FAIL [count_by_reason(2)] expected=2 got=" + to_string(r2))
    }
    let r3 = count_by_reason(3)
    if r3 != 1 {
        panic("pe_tls_callback_dispatch FAIL [count_by_reason(3)] expected=1 got=" + to_string(r3))
    }
    let r4 = count_by_reason(4)
    if r4 != 1 {
        panic("pe_tls_callback_dispatch FAIL [count_by_reason(4)] expected=1 got=" + to_string(r4))
    }
    let r99 = count_by_reason(99)
    if r99 != 0 {
        panic("pe_tls_callback_dispatch FAIL [count_by_reason(99)] expected=0 got=" + to_string(r99))
    }

    // 6. max_callback_index = 2
    let mx = max_callback_index()
    if mx != 2 {
        panic("pe_tls_callback_dispatch FAIL [max_callback_index] expected=2 got=" + to_string(mx))
    }

    // 7. dispatch_elapsed_us sanity
    let e1 = dispatch_elapsed_us(720001)
    if e1 != 120 {
        panic("pe_tls_callback_dispatch FAIL [dispatch_elapsed_us(720001)] expected=120 got=" + to_string(e1))
    }
    let e5 = dispatch_elapsed_us(720005)
    if e5 != 200 {
        panic("pe_tls_callback_dispatch FAIL [dispatch_elapsed_us(720005)] expected=200 got=" + to_string(e5))
    }
    let e_miss = dispatch_elapsed_us(9999)
    if e_miss != 0 {
        panic("pe_tls_callback_dispatch FAIL [dispatch_elapsed_us(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 8. ptlc_stats() = [5, 555, 1, 2]
    let s = ptlc_stats()
    if len(s) != 4 {
        panic("pe_tls_callback_dispatch FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_tls_callback_dispatch FAIL [stats dispatch_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 555 {
        panic("pe_tls_callback_dispatch FAIL [stats total_elapsed_us] expected=555 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_tls_callback_dispatch FAIL [stats count_reason(1)] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_tls_callback_dispatch FAIL [stats max_callback_index] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_tls_callback_dispatch_stats",
        "\"dispatch_count\":" + to_string(s[0])
        + ",\"total_elapsed_us\":" + to_string(s[1])
        + ",\"reason_process_attach\":" + to_string(s[2])
        + ",\"max_callback_index\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_tls_callback_dispatch FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_ptlc()
    let s2 = ptlc_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_tls_callback_dispatch FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_tls_callback_dispatch self_test PASS (dispatches=" + to_string(s[0])
        + ", elapsed_us=" + to_string(s[1]) + ", max_idx=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = ptlc_stats()
            println("dispatch_count\t" + to_string(s[0]))
            println("total_elapsed_us\t" + to_string(s[1]))
            println("count_reason_process_attach\t" + to_string(s[2]))
            println("max_callback_index\t" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("dispatch_elapsed_us\t" + to_string(dispatch_elapsed_us(did)))
                return
            }
            println("usage: hexa run pe_tls_callback_dispatch.hexa elapsed <dispatch_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let reason_kind = to_int(a[3])
                println("count_by_reason\t" + to_string(count_by_reason(reason_kind)))
                return
            }
            println("usage: hexa run pe_tls_callback_dispatch.hexa count <reason_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_ptlc()
            println("cleaned: " + ptlc_dir())
            return
        }
        if sub == "dir" {
            println(ptlc_dir())
            return
        }
    }
    println("usage: hexa run pe_tls_callback_dispatch.hexa { self-test | stats | elapsed <dispatch_id> | count <reason_kind> | cleanup | dir }")
}
