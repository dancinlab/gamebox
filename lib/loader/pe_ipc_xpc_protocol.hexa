// lib/loader/pe_ipc_xpc_protocol.hexa — stage6 Apple XPC protocol skeleton
//
// XPC Mach-based IPC. xpc_connection_create_mach_service + xpc_object_t
// dictionary. App Sandbox compatible. com.airgenome.gamebox.helper service.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 xpc message tracker — 실 xpc_connection_create() 호출 X (stage7).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// msg_kind code:
//   1 = request
//   2 = reply
//   3 = event
//   4 = error
//
// persist schema (TSV — xpc_messages.tsv):
//   msg_id<int> \t msg_kind<int> \t dictionary_count<int> \t elapsed_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pixp_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ipc_xpc_protocol"
}

fn pixp_msgs_path() -> str {
    return pixp_dir() + "/xpc_messages.tsv"
}

fn pixp_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pixp_dir() + "'")
}

fn cleanup_pixp() -> void {
    pixp_ensure_dir()
    let _ = exec("rm -f '" + pixp_msgs_path() + "'")
}

// ─── 공통 file IO ───
fn pixp_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pixp_append_row(path: str, row: str) -> void {
    pixp_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_xpc: xpc message 1 건 기록 ───
fn record_xpc(msg_id: int, msg_kind: int, dictionary_count: int, elapsed_us: int) -> void {
    if msg_id <= 0 {
        panic("pe_ipc_xpc_protocol FAIL [record_xpc] expected=msg_id>0 got=" + to_string(msg_id))
    }
    if msg_kind < 1 {
        panic("pe_ipc_xpc_protocol FAIL [record_xpc] expected=msg_kind>=1 got=" + to_string(msg_kind))
    }
    if msg_kind > 4 {
        panic("pe_ipc_xpc_protocol FAIL [record_xpc] expected=msg_kind<=4 got=" + to_string(msg_kind))
    }
    if dictionary_count < 0 {
        panic("pe_ipc_xpc_protocol FAIL [record_xpc] expected=dictionary_count>=0 got=" + to_string(dictionary_count))
    }
    if elapsed_us < 0 {
        panic("pe_ipc_xpc_protocol FAIL [record_xpc] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    let row = to_string(msg_id) + "\t" + to_string(msg_kind)
        + "\t" + to_string(dictionary_count) + "\t" + to_string(elapsed_us) + "\n"
    pixp_append_row(pixp_msgs_path(), row)
}

// ─── xpc_count: total message 수 ───
fn xpc_count() -> int {
    let t = pixp_read_table(pixp_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_dictionaries: 모든 message dictionary_count 합 ───
fn total_dictionaries() -> int {
    let t = pixp_read_table(pixp_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_msg_kind: 특정 msg_kind 의 message 수 ───
fn count_by_msg_kind(kind: int) -> int {
    let t = pixp_read_table(pixp_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── msg_elapsed: 특정 msg_id 의 elapsed_us (없으면 0) ───
fn msg_elapsed(msg_id: int) -> int {
    let t = pixp_read_table(pixp_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == msg_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pixp_stats: [xpc_count, total_dictionaries, count_by_msg_kind(1), count_by_msg_kind(2)] ───
fn pixp_stats() -> array {
    let mut out = []
    out.push(xpc_count())
    out.push(total_dictionaries())
    out.push(count_by_msg_kind(1))
    out.push(count_by_msg_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pixp-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pixp()

    // 2. record 5 xpc messages (deterministic synthetic)
    record_xpc(120001, 1, 8, 240)
    r0_emit("pe_ipc_xpc_protocol_record",
        "\"msg_id\":120001,\"msg_kind\":1,\"dictionary_count\":8,\"elapsed_us\":240,\"target\":\"request\"")

    record_xpc(120002, 2, 12, 180)
    r0_emit("pe_ipc_xpc_protocol_record",
        "\"msg_id\":120002,\"msg_kind\":2,\"dictionary_count\":12,\"elapsed_us\":180,\"target\":\"reply\"")

    record_xpc(120003, 3, 4, 80)
    r0_emit("pe_ipc_xpc_protocol_record",
        "\"msg_id\":120003,\"msg_kind\":3,\"dictionary_count\":4,\"elapsed_us\":80,\"target\":\"event\"")

    record_xpc(120004, 1, 16, 320)
    r0_emit("pe_ipc_xpc_protocol_record",
        "\"msg_id\":120004,\"msg_kind\":1,\"dictionary_count\":16,\"elapsed_us\":320,\"target\":\"request\"")

    record_xpc(120005, 4, 2, 40)
    r0_emit("pe_ipc_xpc_protocol_record",
        "\"msg_id\":120005,\"msg_kind\":4,\"dictionary_count\":2,\"elapsed_us\":40,\"target\":\"error\"")

    // 3. xpc_count = 5
    let c = xpc_count()
    if c != 5 {
        panic("pe_ipc_xpc_protocol FAIL [xpc_count] expected=5 got=" + to_string(c))
    }

    // 4. total_dictionaries = 42 (8+12+4+16+2)
    let td = total_dictionaries()
    if td != 42 {
        panic("pe_ipc_xpc_protocol FAIL [total_dictionaries] expected=42 got=" + to_string(td))
    }

    // 5. count_by_msg_kind sanity
    let k1 = count_by_msg_kind(1)
    if k1 != 2 {
        panic("pe_ipc_xpc_protocol FAIL [count_by_msg_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_msg_kind(2)
    if k2 != 1 {
        panic("pe_ipc_xpc_protocol FAIL [count_by_msg_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_msg_kind(3)
    if k3 != 1 {
        panic("pe_ipc_xpc_protocol FAIL [count_by_msg_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_msg_kind(4)
    if k4 != 1 {
        panic("pe_ipc_xpc_protocol FAIL [count_by_msg_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_msg_kind(99)
    if k99 != 0 {
        panic("pe_ipc_xpc_protocol FAIL [count_by_msg_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. msg_elapsed sanity
    let e1 = msg_elapsed(120001)
    if e1 != 240 {
        panic("pe_ipc_xpc_protocol FAIL [msg_elapsed(120001)] expected=240 got=" + to_string(e1))
    }
    let e4 = msg_elapsed(120004)
    if e4 != 320 {
        panic("pe_ipc_xpc_protocol FAIL [msg_elapsed(120004)] expected=320 got=" + to_string(e4))
    }
    let e_miss = msg_elapsed(9999)
    if e_miss != 0 {
        panic("pe_ipc_xpc_protocol FAIL [msg_elapsed(9999)] expected=0 got=" + to_string(e_miss))
    }

    // 7. pixp_stats() = [5, 42, 2, 1]
    let s = pixp_stats()
    if len(s) != 4 {
        panic("pe_ipc_xpc_protocol FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_ipc_xpc_protocol FAIL [stats xpc_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 42 {
        panic("pe_ipc_xpc_protocol FAIL [stats total_dictionaries] expected=42 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_ipc_xpc_protocol FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_ipc_xpc_protocol FAIL [stats count_kind(2)] expected=1 got=" + to_string(s[3]))
    }

    // 8. emit stats
    r0_emit("pe_ipc_xpc_protocol_stats",
        "\"xpc_count\":" + to_string(s[0])
        + ",\"total_dictionaries\":" + to_string(s[1])
        + ",\"kind_request\":" + to_string(s[2])
        + ",\"kind_reply\":" + to_string(s[3]))

    // 9. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_ipc_xpc_protocol FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 10. cleanup → stats 모두 0
    cleanup_pixp()
    let s2 = pixp_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ipc_xpc_protocol FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ipc_xpc_protocol self_test PASS (msgs=" + to_string(s[0])
        + ", dicts=" + to_string(s[1]) + ", req=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pixp_stats()
            println("xpc_count\t" + to_string(s[0]))
            println("total_dictionaries\t" + to_string(s[1]))
            println("count_kind_request\t" + to_string(s[2]))
            println("count_kind_reply\t" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let mid = to_int(a[3])
                println("msg_elapsed\t" + to_string(msg_elapsed(mid)))
                return
            }
            println("usage: hexa run pe_ipc_xpc_protocol.hexa elapsed <msg_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_msg_kind\t" + to_string(count_by_msg_kind(kind)))
                return
            }
            println("usage: hexa run pe_ipc_xpc_protocol.hexa count <msg_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pixp()
            println("cleaned: " + pixp_dir())
            return
        }
        if sub == "dir" {
            println(pixp_dir())
            return
        }
    }
    println("usage: hexa run pe_ipc_xpc_protocol.hexa { self-test | stats | elapsed <msg_id> | count <msg_kind> | cleanup | dir }")
}
