// lib/loader/pe_unicode_normalize.hexa — cycle 79 Win32 NormalizeString bridge skeleton
//
// Win32 NormalizeString() ↔ macOS CFStringNormalize() bridge telemetry.
// Unicode TR15 (Normalization Forms): NFC / NFD / NFKC / NFKD.
// docker hexa 가 normalize op metadata 를 기록 — 실제 NormalizeString /
// CFStringNormalize 호출은 native helper (stage6) 에서 수행.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 normalize op tracker — 실 NormalizeString() / ICU / CF X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// form_kind code (Unicode TR15):
//   1 = NFC  (Canonical Composition)
//   2 = NFD  (Canonical Decomposition)
//   3 = NFKC (Compatibility Composition)
//   4 = NFKD (Compatibility Decomposition)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t form_kind<int> \t input_chars<int> \t output_chars<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pun_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_unicode_normalize"
}

fn pun_ops_path() -> str {
    return pun_dir() + "/ops.tsv"
}

fn pun_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pun_dir() + "'")
}

fn cleanup_pun() -> void {
    pun_ensure_dir()
    let _ = exec("rm -f '" + pun_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pun_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pun_append_row(path: str, row: str) -> void {
    pun_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: normalize op 1 건 기록 ───
fn record_op(op_id: int, form_kind: int, input_chars: int, output_chars: int) -> void {
    if op_id <= 0 {
        panic("pe_unicode_normalize FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if form_kind < 1 {
        panic("pe_unicode_normalize FAIL [record_op] expected=form_kind>=1 got=" + to_string(form_kind))
    }
    if form_kind > 4 {
        panic("pe_unicode_normalize FAIL [record_op] expected=form_kind<=4 got=" + to_string(form_kind))
    }
    if input_chars < 0 {
        panic("pe_unicode_normalize FAIL [record_op] expected=input_chars>=0 got=" + to_string(input_chars))
    }
    if output_chars < 0 {
        panic("pe_unicode_normalize FAIL [record_op] expected=output_chars>=0 got=" + to_string(output_chars))
    }
    let row = to_string(op_id) + "\t" + to_string(form_kind)
        + "\t" + to_string(input_chars) + "\t" + to_string(output_chars) + "\n"
    pun_append_row(pun_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pun_read_table(pun_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_input_chars: 모든 op input_chars 합 ───
fn total_input_chars() -> int {
    let t = pun_read_table(pun_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_output_chars: 모든 op output_chars 합 ───
fn total_output_chars() -> int {
    let t = pun_read_table(pun_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_form_kind: 특정 form_kind 의 op 수 ───
fn count_by_form_kind(form_kind: int) -> int {
    let t = pun_read_table(pun_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == form_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_output_chars: 특정 op_id 의 output_chars (없으면 0) ───
fn op_output_chars(op_id: int) -> int {
    let t = pun_read_table(pun_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pun_stats: [op_count, total_input_chars, total_output_chars, count_by_form_kind(1)] ───
fn pun_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_input_chars())
    out.push(total_output_chars())
    out.push(count_by_form_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pun-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pun()

    // 2. record 5 normalize ops across all 4 form_kinds
    //    op 790001: NFC,  input=10, output=8   (composition reduces length)
    //    op 790002: NFD,  input=8,  output=12  (decomposition expands length)
    //    op 790003: NFKC, input=14, output=10  (compat composition)
    //    op 790004: NFKD, input=10, output=18  (compat decomposition)
    //    op 790005: NFC,  input=20, output=16  (second NFC sample)
    //    aggregates: input_total=62, output_total=64, kind1=2
    record_op(790001, 1, 10, 8)
    r0_emit("pe_unicode_normalize_record",
        "\"op_id\":790001,\"form_kind\":1,\"input_chars\":10,\"output_chars\":8,\"target\":\"nfc\"")

    record_op(790002, 2, 8, 12)
    r0_emit("pe_unicode_normalize_record",
        "\"op_id\":790002,\"form_kind\":2,\"input_chars\":8,\"output_chars\":12,\"target\":\"nfd\"")

    record_op(790003, 3, 14, 10)
    r0_emit("pe_unicode_normalize_record",
        "\"op_id\":790003,\"form_kind\":3,\"input_chars\":14,\"output_chars\":10,\"target\":\"nfkc\"")

    record_op(790004, 4, 10, 18)
    r0_emit("pe_unicode_normalize_record",
        "\"op_id\":790004,\"form_kind\":4,\"input_chars\":10,\"output_chars\":18,\"target\":\"nfkd\"")

    record_op(790005, 1, 20, 16)
    r0_emit("pe_unicode_normalize_record",
        "\"op_id\":790005,\"form_kind\":1,\"input_chars\":20,\"output_chars\":16,\"target\":\"nfc\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_unicode_normalize FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_input_chars = 62
    let ti = total_input_chars()
    if ti != 62 {
        panic("pe_unicode_normalize FAIL [total_input_chars] expected=62 got=" + to_string(ti))
    }

    // 5. total_output_chars = 64
    let to_ = total_output_chars()
    if to_ != 64 {
        panic("pe_unicode_normalize FAIL [total_output_chars] expected=64 got=" + to_string(to_))
    }

    // 6. count_by_form_kind sanity (all 4 forms covered)
    let k1 = count_by_form_kind(1)
    if k1 != 2 {
        panic("pe_unicode_normalize FAIL [count_by_form_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_form_kind(2)
    if k2 != 1 {
        panic("pe_unicode_normalize FAIL [count_by_form_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_form_kind(3)
    if k3 != 1 {
        panic("pe_unicode_normalize FAIL [count_by_form_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_form_kind(4)
    if k4 != 1 {
        panic("pe_unicode_normalize FAIL [count_by_form_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_form_kind(99)
    if k99 != 0 {
        panic("pe_unicode_normalize FAIL [count_by_form_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. op_output_chars sanity
    let o2 = op_output_chars(790002)
    if o2 != 12 {
        panic("pe_unicode_normalize FAIL [op_output_chars(790002)] expected=12 got=" + to_string(o2))
    }
    let o4 = op_output_chars(790004)
    if o4 != 18 {
        panic("pe_unicode_normalize FAIL [op_output_chars(790004)] expected=18 got=" + to_string(o4))
    }
    let o_miss = op_output_chars(9999)
    if o_miss != 0 {
        panic("pe_unicode_normalize FAIL [op_output_chars(9999)] expected=0 got=" + to_string(o_miss))
    }

    // 8. pun_stats() = [5, 62, 64, 2]
    let s = pun_stats()
    if len(s) != 4 {
        panic("pe_unicode_normalize FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_unicode_normalize FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 62 {
        panic("pe_unicode_normalize FAIL [stats total_input_chars] expected=62 got=" + to_string(s[1]))
    }
    if s[2] != 64 {
        panic("pe_unicode_normalize FAIL [stats total_output_chars] expected=64 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_unicode_normalize FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_unicode_normalize_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_input_chars\":" + to_string(s[1])
        + ",\"total_output_chars\":" + to_string(s[2])
        + ",\"kind_nfc\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_unicode_normalize FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pun()
    let s2 = pun_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_unicode_normalize FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_unicode_normalize self_test PASS (ops=" + to_string(s[0])
        + ", in=" + to_string(s[1]) + ", out=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pun_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_input_chars\t" + to_string(s[1]))
            println("total_output_chars\t" + to_string(s[2]))
            println("count_kind_nfc\t" + to_string(s[3]))
            return
        }
        if sub == "output" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_output_chars\t" + to_string(op_output_chars(oid)))
                return
            }
            println("usage: hexa run pe_unicode_normalize.hexa output <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let fk = to_int(a[3])
                println("count_by_form_kind\t" + to_string(count_by_form_kind(fk)))
                return
            }
            println("usage: hexa run pe_unicode_normalize.hexa count <form_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pun()
            println("cleaned: " + pun_dir())
            return
        }
        if sub == "dir" {
            println(pun_dir())
            return
        }
    }
    println("usage: hexa run pe_unicode_normalize.hexa { self-test | stats | output <op_id> | count <form_kind> | cleanup | dir }")
}
