// lib/loader/pe_i386_pe32_loader_real.hexa — i386 PE32 (Optional Magic 267) 실 loader
//
// PE32 (Optional Magic 0x010B = 267) vs PE32+ (0x020B = 523):
//   - PE32  : i386 32bit. ImageBase 4-byte (default 0x400000). 4GB virtual
//     address space (NX bit only — no full ASLR slide on 32bit).
//   - PE32+ : x64 64bit. ImageBase 8-byte (default 0x140000000). 별도 loader.
// FileAlignment 0x200 (512), SectionAlignment 0x1000 (4KB Win32 default).
// Battle.net-Setup.exe 같은 32bit installer 가 본 loader path 를 통과.
//
// 본 module 은 i386 PE32 실 loader 의 phase tracker — load 1 건당
// (load_id, phase_kind, size_kb, success) 를 보존. arm64 host 에서 PE32 를
// emulate 하기 전 phase coverage 를 검증하는 instrumentation skeleton.
//
// own 1 enforcement: Wine winecrt0 / CrossOver / community PE loader 코드 0 줄.
//   PE/COFF spec (https://learn.microsoft.com/en-us/windows/win32/debug/pe-format)
//   만 참조. 자체 구현.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind 정의:
//   1 = mz_dos_check          — MZ signature (0x5A4D) + e_lfanew offset 확인
//   2 = pe_signature_check    — "PE\0\0" (0x00004550) at e_lfanew 확인
//   3 = optional_header_pe32  — Optional Magic == 267 (PE32) 확인
//   4 = section_table_walk    — IMAGE_SECTION_HEADER 배열 walk + alignment 검증
//   5 = image_base_realloc    — preferred ImageBase 충돌 시 .reloc 적용
//   6 = imagebase_4gb_check   — VirtualAddress 가 4GB (0xFFFFFFFF) 안에 들어가는지
//
// persist schema (TSV — loads.tsv):
//   load_id<int> \t phase_kind<int> \t size_kb<int> \t success<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pipl_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_i386_pe32_loader_real"
}

fn pipl_loads_path() -> str {
    return pipl_dir() + "/loads.tsv"
}

fn pipl_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pipl_dir() + "'")
}

fn cleanup_pipl() -> void {
    pipl_ensure_dir()
    let _ = exec("rm -f '" + pipl_loads_path() + "'")
}

// ─── 공통 file IO ───
fn pipl_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pipl_append_row(path: str, row: str) -> void {
    pipl_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_load: PE32 loader phase 1 건 기록 ───
fn record_load(load_id: int, phase_kind: int, size_kb: int, success: int) -> void {
    if load_id <= 0 {
        panic("pe_i386_pe32_loader_real FAIL [record_load] expected=load_id>0 got=" + to_string(load_id))
    }
    if phase_kind < 1 {
        panic("pe_i386_pe32_loader_real FAIL [record_load] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 6 {
        panic("pe_i386_pe32_loader_real FAIL [record_load] expected=phase_kind<=6 got=" + to_string(phase_kind))
    }
    if size_kb < 0 {
        panic("pe_i386_pe32_loader_real FAIL [record_load] expected=size_kb>=0 got=" + to_string(size_kb))
    }
    if success < 0 {
        panic("pe_i386_pe32_loader_real FAIL [record_load] expected=success>=0 got=" + to_string(success))
    }
    if success > 1 {
        panic("pe_i386_pe32_loader_real FAIL [record_load] expected=success<=1 got=" + to_string(success))
    }
    let row = to_string(load_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(size_kb) + "\t" + to_string(success) + "\n"
    pipl_append_row(pipl_loads_path(), row)
}

// ─── load_count: total load 수 ───
fn load_count() -> int {
    let t = pipl_read_table(pipl_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 load 수 ───
fn count_by_phase_kind(pk: int) -> int {
    let t = pipl_read_table(pipl_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == pk {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_size_kb: 모든 load 의 size_kb 합 ───
fn total_size_kb() -> int {
    let t = pipl_read_table(pipl_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── success_count: success == 1 의 load 수 ───
fn success_count() -> int {
    let t = pipl_read_table(pipl_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── realloc_count: phase_kind == 5 (image_base_realloc) 의 load 수 ───
fn realloc_count() -> int {
    return count_by_phase_kind(5)
}

// ─── load_size: 특정 load_id 의 size_kb (없으면 0) ───
fn load_size(load_id: int) -> int {
    let t = pipl_read_table(pipl_loads_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == load_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pipl_stats: [load_count, total_size_kb, success_count, realloc_count] ───
fn pipl_stats() -> array {
    let mut out = []
    out.push(load_count())
    out.push(total_size_kb())
    out.push(success_count())
    out.push(realloc_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pipl-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pipl()

    // 2. record 6 loads covering all 6 phase_kinds with ≥4 success:
    //   load 692001: mz_dos_check         (pk=1) — 64KB,  success (Battle.net-Setup MZ stub)
    //   load 692002: pe_signature_check   (pk=2) — 128KB, success ("PE\0\0" sig)
    //   load 692003: optional_header_pe32 (pk=3) — 256KB, success (Magic=267 PE32)
    //   load 692004: section_table_walk   (pk=4) — 512KB, success (.text/.rdata/.data/.rsrc/.reloc)
    //   load 692005: image_base_realloc   (pk=5) — 384KB, fail    (preferred 0x400000 충돌, reloc 미적용)
    //   load 692006: imagebase_4gb_check  (pk=6) — 192KB, fail    (VA > 4GB — 32bit 한계 초과)
    record_load(692001, 1, 64, 1)
    r0_emit("pe_i386_pe32_loader_real_record",
        "\"load_id\":692001,\"phase_kind\":1,\"phase\":\"mz_dos_check\",\"size_kb\":64,\"success\":1,\"pe\":\"Battle.net-Setup.exe\"")

    record_load(692002, 2, 128, 1)
    r0_emit("pe_i386_pe32_loader_real_record",
        "\"load_id\":692002,\"phase_kind\":2,\"phase\":\"pe_signature_check\",\"size_kb\":128,\"success\":1")

    record_load(692003, 3, 256, 1)
    r0_emit("pe_i386_pe32_loader_real_record",
        "\"load_id\":692003,\"phase_kind\":3,\"phase\":\"optional_header_pe32\",\"size_kb\":256,\"success\":1,\"magic\":267")

    record_load(692004, 4, 512, 1)
    r0_emit("pe_i386_pe32_loader_real_record",
        "\"load_id\":692004,\"phase_kind\":4,\"phase\":\"section_table_walk\",\"size_kb\":512,\"success\":1")

    record_load(692005, 5, 384, 0)
    r0_emit("pe_i386_pe32_loader_real_record",
        "\"load_id\":692005,\"phase_kind\":5,\"phase\":\"image_base_realloc\",\"size_kb\":384,\"success\":0")

    record_load(692006, 6, 192, 0)
    r0_emit("pe_i386_pe32_loader_real_record",
        "\"load_id\":692006,\"phase_kind\":6,\"phase\":\"imagebase_4gb_check\",\"size_kb\":192,\"success\":0")

    // 3. load_count = 6
    let c = load_count()
    if c != 6 {
        panic("pe_i386_pe32_loader_real FAIL [load_count] expected=6 got=" + to_string(c))
    }

    // 4. total_size_kb = 64+128+256+512+384+192 = 1536
    let tsk = total_size_kb()
    if tsk != 1536 {
        panic("pe_i386_pe32_loader_real FAIL [total_size_kb] expected=1536 got=" + to_string(tsk))
    }

    // 5. success_count = 4 (pk=1,2,3,4 success; pk=5,6 fail)
    let sc = success_count()
    if sc != 4 {
        panic("pe_i386_pe32_loader_real FAIL [success_count] expected=4 got=" + to_string(sc))
    }

    // 6. count_by_phase_kind sanity (all 6 phase_kinds covered, each count == 1)
    let pk1 = count_by_phase_kind(1)
    if pk1 != 1 {
        panic("pe_i386_pe32_loader_real FAIL [count_by_phase_kind(1)] expected=1 got=" + to_string(pk1))
    }
    let pk2 = count_by_phase_kind(2)
    if pk2 != 1 {
        panic("pe_i386_pe32_loader_real FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(pk2))
    }
    let pk3 = count_by_phase_kind(3)
    if pk3 != 1 {
        panic("pe_i386_pe32_loader_real FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(pk3))
    }
    let pk4 = count_by_phase_kind(4)
    if pk4 != 1 {
        panic("pe_i386_pe32_loader_real FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(pk4))
    }
    let pk5 = count_by_phase_kind(5)
    if pk5 != 1 {
        panic("pe_i386_pe32_loader_real FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(pk5))
    }
    let pk6 = count_by_phase_kind(6)
    if pk6 != 1 {
        panic("pe_i386_pe32_loader_real FAIL [count_by_phase_kind(6)] expected=1 got=" + to_string(pk6))
    }
    let pk99 = count_by_phase_kind(99)
    if pk99 != 0 {
        panic("pe_i386_pe32_loader_real FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(pk99))
    }

    // 7. realloc_count == count_by_phase_kind(5) == 1
    let rc = realloc_count()
    if rc != 1 {
        panic("pe_i386_pe32_loader_real FAIL [realloc_count] expected=1 got=" + to_string(rc))
    }

    // 8. load_size sanity
    let s1 = load_size(692001)
    if s1 != 64 {
        panic("pe_i386_pe32_loader_real FAIL [load_size(692001)] expected=64 got=" + to_string(s1))
    }
    let s4 = load_size(692004)
    if s4 != 512 {
        panic("pe_i386_pe32_loader_real FAIL [load_size(692004)] expected=512 got=" + to_string(s4))
    }
    let s5 = load_size(692005)
    if s5 != 384 {
        panic("pe_i386_pe32_loader_real FAIL [load_size(692005)] expected=384 got=" + to_string(s5))
    }
    let s_miss = load_size(9999)
    if s_miss != 0 {
        panic("pe_i386_pe32_loader_real FAIL [load_size(9999)] expected=0 got=" + to_string(s_miss))
    }

    // 9. pipl_stats() = [6, 1536, 4, 1]
    let s = pipl_stats()
    if len(s) != 4 {
        panic("pe_i386_pe32_loader_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_i386_pe32_loader_real FAIL [stats load_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 1536 {
        panic("pe_i386_pe32_loader_real FAIL [stats total_size_kb] expected=1536 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_i386_pe32_loader_real FAIL [stats success_count] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_i386_pe32_loader_real FAIL [stats realloc_count] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats (≥7 r0_emit: 6 records + 1 stats = 7)
    r0_emit("pe_i386_pe32_loader_real_stats",
        "\"load_count\":" + to_string(s[0])
        + ",\"total_size_kb\":" + to_string(s[1])
        + ",\"success_count\":" + to_string(s[2])
        + ",\"realloc_count\":" + to_string(s[3]))

    // 11. emit count >= 7
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_i386_pe32_loader_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pipl()
    let s2 = pipl_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_i386_pe32_loader_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_i386_pe32_loader_real self_test PASS (loads=" + to_string(s[0])
        + ", size_kb=" + to_string(s[1]) + ", success=" + to_string(s[2])
        + ", realloc=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pipl_stats()
            println("load_count\t" + to_string(s[0]))
            println("total_size_kb\t" + to_string(s[1]))
            println("success_count\t" + to_string(s[2]))
            println("realloc_count\t" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let lid = to_int(a[3])
                println("load_size\t" + to_string(load_size(lid)))
                return
            }
            println("usage: hexa run pe_i386_pe32_loader_real.hexa size <load_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_i386_pe32_loader_real.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pipl()
            println("cleaned: " + pipl_dir())
            return
        }
        if sub == "dir" {
            println(pipl_dir())
            return
        }
    }
    println("usage: hexa run pe_i386_pe32_loader_real.hexa { self-test | stats | size <load_id> | count <phase_kind> | cleanup | dir }")
}
