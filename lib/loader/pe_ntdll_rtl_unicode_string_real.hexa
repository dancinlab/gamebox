// lib/loader/pe_ntdll_rtl_unicode_string_real.hexa — cycle 83 NTDLL Rtl* string ops tracker
//
// NTDLL Rtl* string ops:
//   RtlInitUnicodeString(out UNICODE_STRING, src_wstr) → length+max_length+buffer
//   RtlAnsiStringToUnicodeString → MultiByteToWideChar(CP_ACP) wrapper
//   RtlUnicodeStringToAnsiString → WideCharToMultiByte(CP_ACP)
//   RtlUnicodeStringToOemString  → WideCharToMultiByte(CP_OEMCP) — 한국어 949
//   RtlCopyUnicodeString         → memcpy + length set
//   RtlCompareUnicodeString      → wmemcmp + case_insensitive option
//   RtlFreeUnicodeString         → ExFreePool stub (Apple free)
// own1: NTDLL Rtl* spec + Apple wcs* + iconv. Wine ntdll/rtlstr.c 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 Rtl* call tracker — 실 RtlInitUnicodeString / iconv 호출 X (stage6).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//   1 = init               (RtlInitUnicodeString)
//   2 = ansi_to_unicode    (RtlAnsiStringToUnicodeString)
//   3 = unicode_to_ansi    (RtlUnicodeStringToAnsiString)
//   4 = unicode_to_oem     (RtlUnicodeStringToOemString — CP949)
//   5 = copy               (RtlCopyUnicodeString)
//   6 = compare            (RtlCompareUnicodeString)
//   7 = free               (RtlFreeUnicodeString)
//
// cross-ref: cycle 79 pe_unicode_string (UNICODE_STRING marshal byte counter).
//   본 module 은 char count 단위 — call 1 건 = (input_chars, output_chars).
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t input_chars<int> \t output_chars<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pnrur_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ntdll_rtl_unicode_string_real"
}

fn pnrur_calls_path() -> str {
    return pnrur_dir() + "/calls.tsv"
}

fn pnrur_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pnrur_dir() + "'")
}

fn cleanup_pnrur() -> void {
    pnrur_ensure_dir()
    let _ = exec("rm -f '" + pnrur_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pnrur_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pnrur_append_row(path: str, row: str) -> void {
    pnrur_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: Rtl* call 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, input_chars: int, output_chars: int) -> void {
    if call_id <= 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 7 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [record_call] expected=func_kind<=7 got=" + to_string(func_kind))
    }
    if input_chars < 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [record_call] expected=input_chars>=0 got=" + to_string(input_chars))
    }
    if output_chars < 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [record_call] expected=output_chars>=0 got=" + to_string(output_chars))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(input_chars) + "\t" + to_string(output_chars) + "\n"
    pnrur_append_row(pnrur_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = pnrur_read_table(pnrur_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 call 수 ───
fn count_by_func_kind(func_kind: int) -> int {
    let t = pnrur_read_table(pnrur_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == func_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_input_chars: 모든 call input_chars 합 ───
fn total_input_chars() -> int {
    let t = pnrur_read_table(pnrur_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_output_chars: 모든 call output_chars 합 ───
fn total_output_chars() -> int {
    let t = pnrur_read_table(pnrur_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── expansion_pct: (total_output_chars * 100) / total_input_chars (0-guard) ───
fn expansion_pct() -> int {
    let ti = total_input_chars()
    if ti <= 0 {
        return 0
    }
    let to_o = total_output_chars()
    return (to_o * 100) / ti
}

// ─── call_output_chars: 특정 call_id 의 output_chars (없으면 0) ───
fn call_output_chars(call_id: int) -> int {
    let t = pnrur_read_table(pnrur_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pnrur_stats: [call_count, total_input_chars, total_output_chars, expansion_pct] ───
fn pnrur_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(total_input_chars())
    out.push(total_output_chars())
    out.push(expansion_pct())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pnrur-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pnrur()

    // 2. record 6 calls across ≥4 func_kinds (1, 2, 4, 6, 7 → 5 distinct)
    //    char counts in UTF-16 code units (input vs output)
    record_call(330001, 1, 18, 18)        // RtlInitUnicodeString "C:\\Windows\\Sys" — identity len
    r0_emit("pe_ntdll_rtl_unicode_string_real_record",
        "\"call_id\":330001,\"func_kind\":1,\"input_chars\":18,\"output_chars\":18,\"target\":\"init\"")

    record_call(330002, 2, 13, 13)        // RtlAnsiStringToUnicodeString "Diablo II.exe" 13 ANSI → 13 wchar
    r0_emit("pe_ntdll_rtl_unicode_string_real_record",
        "\"call_id\":330002,\"func_kind\":2,\"input_chars\":13,\"output_chars\":13,\"target\":\"ansi_to_unicode\"")

    record_call(330003, 4, 8, 16)         // RtlUnicodeStringToOemString — 8 wchar 한글 → CP949 16 bytes (2x expansion)
    r0_emit("pe_ntdll_rtl_unicode_string_real_record",
        "\"call_id\":330003,\"func_kind\":4,\"input_chars\":8,\"output_chars\":16,\"target\":\"unicode_to_oem\"")

    record_call(330004, 6, 24, 24)        // RtlCompareUnicodeString — both 24 wchar
    r0_emit("pe_ntdll_rtl_unicode_string_real_record",
        "\"call_id\":330004,\"func_kind\":6,\"input_chars\":24,\"output_chars\":24,\"target\":\"compare\"")

    record_call(330005, 7, 18, 0)         // RtlFreeUnicodeString — input=18 wchar, output=0 (freed)
    r0_emit("pe_ntdll_rtl_unicode_string_real_record",
        "\"call_id\":330005,\"func_kind\":7,\"input_chars\":18,\"output_chars\":0,\"target\":\"free\"")

    record_call(330006, 2, 19, 19)        // RtlAnsiStringToUnicodeString "HKLM\\Software\\Bliz" 19 ANSI → 19 wchar
    r0_emit("pe_ntdll_rtl_unicode_string_real_record",
        "\"call_id\":330006,\"func_kind\":2,\"input_chars\":19,\"output_chars\":19,\"target\":\"ansi_to_unicode\"")

    // 3. call_count = 6
    let c = call_count()
    if c != 6 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [call_count] expected=6 got=" + to_string(c))
    }

    // 4. total_input_chars = 18 + 13 + 8 + 24 + 18 + 19 = 100
    let ti = total_input_chars()
    if ti != 100 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [total_input_chars] expected=100 got=" + to_string(ti))
    }

    // 5. total_output_chars = 18 + 13 + 16 + 24 + 0 + 19 = 90
    let to_o = total_output_chars()
    if to_o != 90 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [total_output_chars] expected=90 got=" + to_string(to_o))
    }

    // 6. expansion_pct = (90 * 100) / 100 = 90
    let ep = expansion_pct()
    if ep != 90 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [expansion_pct] expected=90 got=" + to_string(ep))
    }

    // 7. count_by_func_kind sanity
    let k1 = count_by_func_kind(1)
    if k1 != 1 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(k1))
    }
    let k2 = count_by_func_kind(2)
    if k2 != 2 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k4 = count_by_func_kind(4)
    if k4 != 1 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k6 = count_by_func_kind(6)
    if k6 != 1 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(6)] expected=1 got=" + to_string(k6))
    }
    let k7 = count_by_func_kind(7)
    if k7 != 1 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(7)] expected=1 got=" + to_string(k7))
    }
    let k3 = count_by_func_kind(3)
    if k3 != 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(3)] expected=0 got=" + to_string(k3))
    }
    let k5 = count_by_func_kind(5)
    if k5 != 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_func_kind(99)
    if k99 != 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [count_by_func_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 8. call_output_chars sanity
    let o3 = call_output_chars(330003)
    if o3 != 16 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [call_output_chars(330003)] expected=16 got=" + to_string(o3))
    }
    let o5 = call_output_chars(330005)
    if o5 != 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [call_output_chars(330005)] expected=0 got=" + to_string(o5))
    }
    let o_miss = call_output_chars(9999)
    if o_miss != 0 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [call_output_chars(9999)] expected=0 got=" + to_string(o_miss))
    }

    // 9. pnrur_stats() = [6, 100, 90, 90]
    let s = pnrur_stats()
    if len(s) != 4 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [stats call_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 100 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [stats total_input_chars] expected=100 got=" + to_string(s[1]))
    }
    if s[2] != 90 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [stats total_output_chars] expected=90 got=" + to_string(s[2]))
    }
    if s[3] != 90 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [stats expansion_pct] expected=90 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_ntdll_rtl_unicode_string_real_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"total_input_chars\":" + to_string(s[1])
        + ",\"total_output_chars\":" + to_string(s[2])
        + ",\"expansion_pct\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_ntdll_rtl_unicode_string_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pnrur()
    let s2 = pnrur_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ntdll_rtl_unicode_string_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ntdll_rtl_unicode_string_real self_test PASS (calls=" + to_string(s[0])
        + ", input=" + to_string(s[1]) + ", output=" + to_string(s[2])
        + ", expansion_pct=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pnrur_stats()
            println("call_count\t" + to_string(s[0]))
            println("total_input_chars\t" + to_string(s[1]))
            println("total_output_chars\t" + to_string(s[2]))
            println("expansion_pct\t" + to_string(s[3]))
            return
        }
        if sub == "output" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_output_chars\t" + to_string(call_output_chars(cid)))
                return
            }
            println("usage: hexa run pe_ntdll_rtl_unicode_string_real.hexa output <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let fk = to_int(a[3])
                println("count_by_func_kind\t" + to_string(count_by_func_kind(fk)))
                return
            }
            println("usage: hexa run pe_ntdll_rtl_unicode_string_real.hexa count <func_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pnrur()
            println("cleaned: " + pnrur_dir())
            return
        }
        if sub == "dir" {
            println(pnrur_dir())
            return
        }
    }
    println("usage: hexa run pe_ntdll_rtl_unicode_string_real.hexa { self-test | stats | output <call_id> | count <func_kind> | cleanup | dir }")
}
