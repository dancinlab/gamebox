// lib/loader/pe_usp10_core.hexa — USP10.dll Uniscribe text shaping surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine usp10 source 인용 0.
//       usp10.dll 직접 binding 0. macOS CoreText CTLine / CTRun / CTFontRef / CTRunDelegate /
//       CFAttributedString / NSLayoutManager / NSTextStorage / NSTypesetter / HarfBuzz /
//       FreeType 직접 binding 0. NOTE: USP10 측 D2R/D4 chat overlay + Lineage 한글 텍스트
//       shaping + complex script (Arabic/Hebrew RTL/Devanagari) 측 baseline; ScriptItemize/
//       ScriptShape/ScriptPlace/ScriptLayout 측 SCRIPT_ITEM/SCRIPT_VISATTR/GOFFSET/
//       SCRIPT_LOGATTR struct round-trip baseline (long-horizon production smoke pending).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track AZ4 — USP10 Uniscribe itemize/shape/layout surface 10 fn skeleton-tier.
// cycle 46 252/435 (~57.93%) → cycle 47 ~262/435 (~60.23%) (+10 fn, AZ bundled part 4/4).
// **60% threshold breach milestone** — first crossing of 60% Win32 fn coverage.
//
// 대상 fn (10 fn — 3 group, fn_kind 0..9):
//   ITEMIZE (3): ScriptItemize(0) / ScriptItemizeOpenType(1) / ScriptShape(2)
//   SHAPE   (4): ScriptShapeOpenType(3) / ScriptPlace(4) / ScriptPlaceOpenType(5) /
//                ScriptStringAnalyse(6)
//   LAYOUT  (3): ScriptLayout(7) / ScriptApplyLogicalWidth(8) / ScriptStringFree(9)
//
// synthetic struct families:
//   SCRIPT_ITEM 8B: iCharPos 0 + a (SCRIPT_ANALYSIS 4B: eScript LANG_KOREAN 0x0412 +
//     fRTL 0 + fLayoutRTL 0 + fLinkBefore 0 + fLinkAfter 0 + fLogicalOrder 0 + fNoGlyphIndex 0).
//   SCRIPT_ANALYSIS 4B: bit-packed eScript 10 + fRTL 1 + fLayoutRTL 1 + 4 misc bit + s 16B.
//   SCRIPT_VISATTR 2B (per glyph): uJustification 4 + fClusterStart 1 + fDiacritic 1 +
//     fZeroWidth 1 + fReserved 1 + fShapeReserved 8.
//   GOFFSET 8B: du 0 + dv 0 (per-glyph offset, default zero for Latin).
//   SCRIPT_LOGATTR 1B: fSoftBreak 1 + fWhiteSpace 1 + fCharStop 1 + fWordStop 1 +
//     fInvalid 1 + fReserved 3.
//   ABC 12B: abcA 0 + abcB 11 + abcC 0 (LSB/glyph_width/RSB).
//   HFONT 0x9B010000 / HDC 0x9B020000 (GDI handles re-used).
//   SCRIPT_CACHE ptr 0x9B030000 (opaque per-font cache).
//   SCRIPT_STRING_ANALYSIS ptr 0x9B040000 (opaque ScriptString session).
//   sample text: WCHAR ko 안녕하세요 (5-char 0xC548_0xB155_0xD558_0xC138_0xC694) +
//     en "Hello" (5-char) + ar مرحبا (5-char RTL) + zh 你好 (2-char).
//
// persist schema (TSV — 4 table): syscall_invoke/itemize_event/shape_event/layout_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pus_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_usp10_core"
}

fn pus_syscall_invoke_path() -> str {
    return pus_dir() + "/syscall_invoke.tsv"
}

fn pus_itemize_event_path() -> str {
    return pus_dir() + "/itemize_event.tsv"
}

fn pus_shape_event_path() -> str {
    return pus_dir() + "/shape_event.tsv"
}

fn pus_layout_event_path() -> str {
    return pus_dir() + "/layout_event.tsv"
}

fn pus_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pus_dir() + "'")
}

fn cleanup_pus() -> void {
    pus_ensure_dir()
    let _ = exec("rm -f '" + pus_syscall_invoke_path() + "' '" + pus_itemize_event_path()
        + "' '" + pus_shape_event_path() + "' '" + pus_layout_event_path() + "'")
}

// ─── 공통 file IO ───
fn pus_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pus_append_row(path: str, row: str) -> void {
    pus_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pus_count_rows(path: str, min_cols: int) -> int {
    let t = pus_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (10 fn coverage, fn_kind 0..9) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "ScriptItemize" }
    if k == 1 { return "ScriptItemizeOpenType" }
    if k == 2 { return "ScriptShape" }
    if k == 3 { return "ScriptShapeOpenType" }
    if k == 4 { return "ScriptPlace" }
    if k == 5 { return "ScriptPlaceOpenType" }
    if k == 6 { return "ScriptStringAnalyse" }
    if k == 7 { return "ScriptLayout" }
    if k == 8 { return "ScriptApplyLogicalWidth" }
    if k == 9 { return "ScriptStringFree" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "itemize"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "shape"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "layout"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: USP10 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_usp10_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_usp10_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 9 {
        panic("pe_usp10_core FAIL [record_syscall_invoke] expected=fn_kind<=9 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_usp10_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_usp10_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pus_append_row(pus_syscall_invoke_path(), row)
}

// ─── record_itemize_event: ScriptItemize/ItemizeOpenType/Shape row ───
fn record_itemize_event(evt_id: int, i_kind: str, text_synth: str, item_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_usp10_core FAIL [record_itemize_event] evt_id<=0") }
    if i_kind == "" { panic("pe_usp10_core FAIL [record_itemize_event] i_kind=empty") }
    if text_synth == "" { panic("pe_usp10_core FAIL [record_itemize_event] text_synth=empty") }
    if item_synth == "" { panic("pe_usp10_core FAIL [record_itemize_event] item_synth=empty") }
    if status == "" { panic("pe_usp10_core FAIL [record_itemize_event] status=empty") }
    let row = to_string(evt_id) + "\t" + i_kind + "\t" + text_synth + "\t" + item_synth + "\t" + status + "\n"
    pus_append_row(pus_itemize_event_path(), row)
}

// ─── record_shape_event: ScriptShapeOpenType/Place/PlaceOpenType/StringAnalyse row ───
fn record_shape_event(evt_id: int, s_kind: str, cache_synth: str, glyph_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_usp10_core FAIL [record_shape_event] evt_id<=0") }
    if s_kind == "" { panic("pe_usp10_core FAIL [record_shape_event] s_kind=empty") }
    if cache_synth == "" { panic("pe_usp10_core FAIL [record_shape_event] cache_synth=empty") }
    if glyph_synth == "" { panic("pe_usp10_core FAIL [record_shape_event] glyph_synth=empty") }
    if status == "" { panic("pe_usp10_core FAIL [record_shape_event] status=empty") }
    let row = to_string(evt_id) + "\t" + s_kind + "\t" + cache_synth + "\t" + glyph_synth + "\t" + status + "\n"
    pus_append_row(pus_shape_event_path(), row)
}

// ─── record_layout_event: ScriptLayout/ApplyLogicalWidth/StringFree row ───
fn record_layout_event(evt_id: int, l_kind: str, ssa_synth: str, layout_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_usp10_core FAIL [record_layout_event] evt_id<=0") }
    if l_kind == "" { panic("pe_usp10_core FAIL [record_layout_event] l_kind=empty") }
    if ssa_synth == "" { panic("pe_usp10_core FAIL [record_layout_event] ssa_synth=empty") }
    if layout_synth == "" { panic("pe_usp10_core FAIL [record_layout_event] layout_synth=empty") }
    if status == "" { panic("pe_usp10_core FAIL [record_layout_event] status=empty") }
    let row = to_string(evt_id) + "\t" + l_kind + "\t" + ssa_synth + "\t" + layout_synth + "\t" + status + "\n"
    pus_append_row(pus_layout_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pus_count_rows(pus_syscall_invoke_path(), 4)
}

fn itemize_event_count() -> int {
    return pus_count_rows(pus_itemize_event_path(), 5)
}

fn shape_event_count() -> int {
    return pus_count_rows(pus_shape_event_path(), 5)
}

fn layout_event_count() -> int {
    return pus_count_rows(pus_layout_event_path(), 5)
}

fn pus_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(itemize_event_count())
    out.push(shape_event_count())
    out.push(layout_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pus-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pus()

    // ─── 1. syscall_invoke × 10 (one per fn, 3 group coverage) ───
    //   ITEMIZE group (3)
    record_syscall_invoke(1, 0, "ScriptItemize", "PARTIAL")
    println("__USP10__ PARTIAL ScriptItemize")
    r0_emit("pe_usp10_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"ScriptItemize\",\"fn_group\":\"itemize\",\"status\":\"PARTIAL\",\"pwcInChars_synth\":\"WCHAR_ko_안녕하세요_5_chars\",\"cInChars\":5,\"cMaxItems\":16,\"psControl_synth\":\"SCRIPT_CONTROL_4B_default\",\"psState_synth\":\"SCRIPT_STATE_4B_default\",\"pItems_out_synth\":\"SCRIPT_ITEM_8B_array_2_items\",\"struct_bytes_per_item\":8,\"pcItems_out\":1,\"hresult\":\"S_OK_0x00000000\"")
    record_syscall_invoke(2, 1, "ScriptItemizeOpenType", "PARTIAL")
    println("__USP10__ PARTIAL ScriptItemizeOpenType")
    r0_emit("pe_usp10_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"ScriptItemizeOpenType\",\"fn_group\":\"itemize\",\"status\":\"PARTIAL\",\"pwcInChars_synth\":\"WCHAR_ar_مرحبا_5_chars_RTL\",\"cInChars\":5,\"cMaxItems\":16,\"pTagsOut_synth\":\"OPENTYPE_TAG_arab_4B_LE\",\"pItems_out_synth\":\"SCRIPT_ITEM_8B_RTL_arab\",\"hresult\":\"S_OK\"")
    record_syscall_invoke(3, 2, "ScriptShape", "PARTIAL")
    println("__USP10__ PARTIAL ScriptShape")
    r0_emit("pe_usp10_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"ScriptShape\",\"fn_group\":\"itemize\",\"status\":\"PARTIAL\",\"hdc\":\"0x9B020000\",\"psc_synth\":\"SCRIPT_CACHE_0x9B030000\",\"pwcChars_synth\":\"WCHAR_ko_안녕\",\"cChars\":2,\"cMaxGlyphs\":16,\"psa_synth\":\"SCRIPT_ANALYSIS_4B_eScript_LANG_KOREAN\",\"pwOutGlyphs_synth\":\"WORD_array_2_glyph_indices\",\"pwLogClust_synth\":\"WORD_array_2_cluster_map\",\"psva_synth\":\"SCRIPT_VISATTR_2B_per_glyph\",\"pcGlyphs_out\":2,\"hresult\":\"S_OK\"")

    //   SHAPE group (4)
    record_syscall_invoke(4, 3, "ScriptShapeOpenType", "PARTIAL")
    println("__USP10__ PARTIAL ScriptShapeOpenType")
    r0_emit("pe_usp10_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"ScriptShapeOpenType\",\"fn_group\":\"shape\",\"status\":\"PARTIAL\",\"hdc\":\"0x9B020000\",\"psc_synth\":\"SCRIPT_CACHE_0x9B030000\",\"tagScript\":\"OPENTYPE_TAG_hang_4B\",\"tagLangSys\":\"OPENTYPE_TAG_KOR_4B\",\"rcRangeChars_synth\":\"int_2_chars\",\"rpRangeProperties_synth\":\"OPENTYPE_FEATURE_RECORD_kern_8B\",\"cMaxGlyphs\":16,\"pwOutGlyphs_out\":2,\"hresult\":\"S_OK\"")
    record_syscall_invoke(5, 4, "ScriptPlace", "PARTIAL")
    println("__USP10__ PARTIAL ScriptPlace")
    r0_emit("pe_usp10_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"ScriptPlace\",\"fn_group\":\"shape\",\"status\":\"PARTIAL\",\"hdc\":\"0x9B020000\",\"psc_synth\":\"SCRIPT_CACHE_0x9B030000\",\"pwGlyphs_synth\":\"WORD_array_2_glyph_indices\",\"cGlyphs\":2,\"psva_synth\":\"SCRIPT_VISATTR_2B_per_glyph\",\"piAdvance_out_synth\":\"int_array_2_advance_per_glyph_11_11\",\"pGoffset_out_synth\":\"GOFFSET_8B_zero_du_dv\",\"pABC_out_synth\":\"ABC_12B_abcA_0_abcB_22_abcC_0\",\"hresult\":\"S_OK\"")
    record_syscall_invoke(6, 5, "ScriptPlaceOpenType", "PARTIAL")
    println("__USP10__ PARTIAL ScriptPlaceOpenType")
    r0_emit("pe_usp10_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"ScriptPlaceOpenType\",\"fn_group\":\"shape\",\"status\":\"PARTIAL\",\"hdc\":\"0x9B020000\",\"psc_synth\":\"SCRIPT_CACHE_0x9B030000\",\"tagScript\":\"OPENTYPE_TAG_arab_4B\",\"tagLangSys\":\"OPENTYPE_TAG_ARA_4B\",\"piAdvance_out\":\"int_array_5_RTL_advance\",\"pGoffset_out\":\"GOFFSET_8B_array_5\",\"pABC_out\":\"ABC_12B_RTL\",\"hresult\":\"S_OK\"")
