    r0_emit("pe_usp10_core_record", "\"kind\":\"shape_event\",\"evt_id\":2,\"s_kind\":\"place_advance_2_glyphs_11_11\",\"cache_synth\":\"SCRIPT_CACHE_0x9B030000\",\"glyph_synth\":\"int_array_2_advance_GOFFSET_8B_zero_ABC_12B_abcB_22\",\"struct_bytes_goffset\":8,\"struct_bytes_abc\":12,\"abcB_total\":22,\"status\":\"PARTIAL\"")
    record_shape_event(3, "place_opentype_arabic_rtl_ARA", "SCRIPT_CACHE_0x9B030000", "OPENTYPE_TAG_arab_ARA_5_glyphs_RTL", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"shape_event\",\"evt_id\":3,\"s_kind\":\"place_opentype_arabic_rtl_ARA\",\"cache_synth\":\"SCRIPT_CACHE_0x9B030000\",\"glyph_synth\":\"OPENTYPE_TAG_arab_ARA_5_glyphs_RTL\",\"cGlyphs\":5,\"fRTL\":true,\"status\":\"PARTIAL\"")
    record_shape_event(4, "string_analyse_ko_anyounghaseyo_7_glyphs", "SCRIPT_STRING_ANALYSIS_0x9B040000", "WCHAR_ko_안녕하세요_5_chars_to_7_glyphs_SSA_GLYPHS", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"shape_event\",\"evt_id\":4,\"s_kind\":\"string_analyse_ko_anyounghaseyo_7_glyphs\",\"cache_synth\":\"SCRIPT_STRING_ANALYSIS_0x9B040000\",\"glyph_synth\":\"WCHAR_ko_안녕하세요_5_chars_to_7_glyphs_SSA_GLYPHS\",\"flags\":\"SSA_GLYPHS_0x00000080\",\"status\":\"PARTIAL\"")

    // ─── 4. layout_event × 3 (layout/apply_logical_width/string_free) ───
    record_layout_event(1, "layout_bidi_2_runs_LTR_RTL", "SCRIPT_STRING_ANALYSIS_0x9B040000", "BYTE_array_2_bidi_level_0_1_visual_logical", "PARTIAL")
