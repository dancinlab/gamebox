    record_syscall_invoke(10, 9, "ScriptStringFree", "PARTIAL")
    println("__USP10__ PARTIAL ScriptStringFree")
    r0_emit("pe_usp10_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"ScriptStringFree\",\"fn_group\":\"layout\",\"status\":\"PARTIAL\",\"pssa\":\"SCRIPT_STRING_ANALYSIS_0x9B040000\",\"hresult\":\"S_OK\",\"void_release\":true")

    // ─── 2. itemize_event × 3 (itemize/itemize_ot/shape) ───
    record_itemize_event(1, "itemize_ko_anyounghaseyo", "WCHAR_ko_안녕하세요_5_chars", "SCRIPT_ITEM_8B_array_2_items_eScript_LANG_KOREAN", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"itemize_event\",\"evt_id\":1,\"i_kind\":\"itemize_ko_anyounghaseyo\",\"text_synth\":\"WCHAR_ko_안녕하세요_5_chars\",\"item_synth\":\"SCRIPT_ITEM_8B_array_2_items_eScript_LANG_KOREAN\",\"struct_bytes_per_item\":8,\"cItems\":1,\"status\":\"PARTIAL\"")
    record_itemize_event(2, "itemize_ot_arabic_rtl", "WCHAR_ar_مرحبا_5_chars_RTL", "SCRIPT_ITEM_8B_RTL_arab_OPENTYPE_TAG_arab", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"itemize_event\",\"evt_id\":2,\"i_kind\":\"itemize_ot_arabic_rtl\",\"text_synth\":\"WCHAR_ar_مرحبا_5_chars_RTL\",\"item_synth\":\"SCRIPT_ITEM_8B_RTL_arab_OPENTYPE_TAG_arab\",\"fRTL\":true,\"opentype_tag\":\"arab\",\"status\":\"PARTIAL\"")
    record_itemize_event(3, "shape_ko_anyoung_2_glyphs", "WCHAR_ko_안녕_2_chars", "WORD_array_2_glyph_indices_SCRIPT_VISATTR_2B", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"itemize_event\",\"evt_id\":3,\"i_kind\":\"shape_ko_anyoung_2_glyphs\",\"text_synth\":\"WCHAR_ko_안녕_2_chars\",\"item_synth\":\"WORD_array_2_glyph_indices_SCRIPT_VISATTR_2B\",\"cGlyphs\":2,\"hdc\":\"0x9B020000\",\"status\":\"PARTIAL\"")

    // ─── 3. shape_event × 4 (shape_ot/place/place_ot/string_analyse) ───
    record_shape_event(1, "shape_opentype_korean_hang_KOR", "SCRIPT_CACHE_0x9B030000", "OPENTYPE_TAG_hang_KOR_2_glyphs", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"shape_event\",\"evt_id\":1,\"s_kind\":\"shape_opentype_korean_hang_KOR\",\"cache_synth\":\"SCRIPT_CACHE_0x9B030000\",\"glyph_synth\":\"OPENTYPE_TAG_hang_KOR_2_glyphs\",\"feature\":\"kern\",\"hdc\":\"0x9B020000\",\"status\":\"PARTIAL\"")
