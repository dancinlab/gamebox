    record_layout_event(2, "apply_logical_width_justify_2_chars", "SCRIPT_STRING_ANALYSIS_0x9B040000", "int_array_2_justified_widths_logical_width_target", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"layout_event\",\"evt_id\":2,\"l_kind\":\"apply_logical_width_justify_2_chars\",\"ssa_synth\":\"SCRIPT_STRING_ANALYSIS_0x9B040000\",\"layout_synth\":\"int_array_2_justified_widths_logical_width_target\",\"cChars\":2,\"cGlyphs\":2,\"status\":\"PARTIAL\"")
    record_layout_event(3, "string_free_release_ssa", "SCRIPT_STRING_ANALYSIS_0x9B040000", "release_no_ssa_void", "PARTIAL")
    r0_emit("pe_usp10_core_record", "\"kind\":\"layout_event\",\"evt_id\":3,\"l_kind\":\"string_free_release_ssa\",\"ssa_synth\":\"SCRIPT_STRING_ANALYSIS_0x9B040000\",\"layout_synth\":\"release_no_ssa_void\",\"void_release\":true,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 10 {
        panic("pe_usp10_core FAIL [syscall_invoke_count] expected=10 got=" + to_string(si))
    }
    let ie = itemize_event_count()
    if ie != 3 {
        panic("pe_usp10_core FAIL [itemize_event_count] expected=3 got=" + to_string(ie))
    }
    let se = shape_event_count()
    if se != 4 {
        panic("pe_usp10_core FAIL [shape_event_count] expected=4 got=" + to_string(se))
    }
    let le = layout_event_count()
    if le != 3 {
        panic("pe_usp10_core FAIL [layout_event_count] expected=3 got=" + to_string(le))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "ScriptItemize" { panic("pe_usp10_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "ScriptShape" { panic("pe_usp10_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(4) != "ScriptPlace" { panic("pe_usp10_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(7) != "ScriptLayout" { panic("pe_usp10_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(9) != "ScriptStringFree" { panic("pe_usp10_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_usp10_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "itemize" { panic("pe_usp10_core FAIL [fn_group_name(0)]") }
    if fn_group_name(3) != "shape" { panic("pe_usp10_core FAIL [fn_group_name(3)]") }
    if fn_group_name(7) != "layout" { panic("pe_usp10_core FAIL [fn_group_name(7)]") }
    if fn_group_name(99) != "unknown" { panic("pe_usp10_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pus_stats()
    if len(s) != 4 { panic("pe_usp10_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 10 { panic("pe_usp10_core FAIL [stats syscall_invoke_count] expected=10 got=" + to_string(s[0])) }
    if s[1] != 3 { panic("pe_usp10_core FAIL [stats itemize_event_count] expected=3 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_usp10_core FAIL [stats shape_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_usp10_core FAIL [stats layout_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_usp10_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"itemize_event_count\":" + to_string(s[1])
        + ",\"shape_event_count\":" + to_string(s[2])
        + ",\"layout_event_count\":" + to_string(s[3]))

    r0_emit("pe_usp10_core_summary",
        "\"target\":\"USP10.dll\",\"fn_total\":10,\"fn_emit_partial\":10,\"groups\":[\"itemize\",\"shape\",\"layout\"],\"script_item_synth_bytes\":8,\"script_visattr_synth_bytes\":2,\"goffset_synth_bytes\":8,\"abc_synth_bytes\":12,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\",\"60pct_threshold_breach\":true")

    r0_emit("pe_usp10_core_kpi",
        "\"itemize_emits\":3,\"shape_emits\":4,\"layout_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_chat_overlay_baseline\":true,\"lineage_korean_text_shaping_baseline\":true,\"complex_script_arabic_hebrew_devanagari_baseline\":true,\"coretext_ctline_ctrun_ctfontref_binding\":false,\"harfbuzz_freetype_binding\":false")

    // ─── cycle 46 → 47 USP10 coverage progression evidence emit (60% threshold breach) ───
    r0_emit("pe_usp10_core_coverage_progression",
        "\"surface\":\"USP10_full_435_fn\",\"cycle_46_count\":252,\"cycle_47_count\":262,\"delta\":10,\"cycle_46_percent\":57.93,\"cycle_47_percent\":60.23,\"cycle_47_module\":\"pe_usp10_core.hexa\",\"60pct_threshold_breached\":true,\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_az4_cycle_increment\":10,\"track_az_bundled_part_4_of_4\":true,\"track_az_bundled_total_delta\":44")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_usp10_core_round_trip_matrix",
        "\"surface\":\"USP10_core_10_fn\",\"fn_partial\":10,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.2\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real ScriptShape + ScriptPlace + ScriptLayout = CoreText CTLine/CTRun + HarfBuzz/FreeType + NSLayoutManager bridge pending separate cycle (long-horizon complex script shaping)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"60pct_threshold_breached\":\"cycle 47 = 262/435 (60.23%) — Track AZ milestone\"")

    // ─── Track AZ4 expansion emit (cycle 47, USP10 +10 fn) ───
    r0_emit("pe_usp10_core_az4_expansion",
        "\"track\":\"AZ4\",\"cycle\":47,\"surface\":\"USP10_new\",\"new_fn\":10,\"groups\":[\"itemize\",\"shape\",\"layout\"],\"itemize_count\":3,\"shape_count\":4,\"layout_count\":3,\"emit_format\":\"__USP10__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_2_evidence_augment\":true,\"track_az_bundled_part_4_of_4\":true,\"track_az_bundled_complete\":true,\"60pct_threshold_breached\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_usp10_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pus()
    let s2 = pus_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_usp10_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_usp10_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", itemize_event=" + to_string(s[1])
        + ", shape_event=" + to_string(s[2]) + ", layout_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pus_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("itemize_event_count\t" + to_string(s[1]))
            println("shape_event_count\t" + to_string(s[2]))
            println("layout_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_usp10_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_usp10_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pus()
            println("cleaned: " + pus_dir())
            return
        }
        if sub == "dir" {
            println(pus_dir())
            return
        }
    }
    println("usage: hexa run pe_usp10_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
