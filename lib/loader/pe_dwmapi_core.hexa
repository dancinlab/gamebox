// lib/loader/pe_dwmapi_core.hexa — DWMAPI.dll Desktop Window Manager surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine dwmapi source 인용 0.
//       dwmapi.dll 직접 binding 0. macOS WindowServer / CoreAnimation CALayer /
//       CAMetalLayer / NSVisualEffectView / CGSConnection / CGSWindow 직접 binding 0.
//       NOTE: DWMAPI 측 D2R/D4 launcher composition state + Battle.net Agent
//       blur-behind dialog baseline + thumbnail preview baseline; DwmExtendFrameIntoClientArea/
//       DwmEnableBlurBehindWindow/DwmRegisterThumbnail 측 MARGINS/DWM_BLURBEHIND/HTHUMBNAIL
//       round-trip baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BH2 — DWMAPI composition/effects/thumbnails surface 11 fn skeleton-tier.
// cycle 52 314/435 (~72.18%) → cycle 53 ~325/435 (~74.71%) (+11 fn, BH bundled part 2/4).
//
// 대상 fn (11 fn — 3 group, fn_kind 0..10):
//   COMPOSITION (4): DwmIsCompositionEnabled(0) / DwmEnableComposition(1) /
//                    DwmExtendFrameIntoClientArea(2) / DwmGetWindowAttribute(3)
//   EFFECTS     (4): DwmEnableBlurBehindWindow(4) / DwmSetWindowAttribute(5) /
//                    DwmFlush(6) / DwmGetCompositionTimingInfo(7)
//   THUMBNAILS  (3): DwmRegisterThumbnail(8) / DwmUnregisterThumbnail(9) /
//                    DwmUpdateThumbnailProperties(10)
//
// synthetic struct families:
//   MARGINS 16B cxLeftWidth -1 cxRightWidth -1 cyTopHeight -1 cyBottomHeight -1 (sheet of glass).
//   DWM_BLURBEHIND 16B dwFlags DWM_BB_ENABLE 0x1 + fEnable TRUE_1 + hRgnBlur 0 + fTransitionOnMaximized 0.
//   DWM_TIMING_INFO 152B cbSize 152 rateRefresh 60_1 qpcRefreshPeriod 16666666ns (60Hz) +
//     rateCompose 60_1 qpcCompose 0 + cFramesDisplayed 1024 + cFramesPending 0 + cFramesAvailable 1.
//   HTHUMBNAIL 0xB0010100 opaque thumbnail handle.
//   DWM_THUMBNAIL_PROPERTIES 48B dwFlags 0x1F (all valid) rcDestination RECT 16B + rcSource RECT 16B +
//     opacity 255 + fVisible TRUE_1 + fSourceClientAreaOnly FALSE_0.
//   DWMWINDOWATTRIBUTE 4B value DWMWA_NCRENDERING_ENABLED 1 / DWMWA_USE_IMMERSIVE_DARK_MODE 20.
//
// persist schema (TSV — 4 table):
//   syscall_invoke / composition_event / effect_event / thumbnail_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdw_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dwmapi_core"
}

fn pdw_syscall_invoke_path() -> str {
    return pdw_dir() + "/syscall_invoke.tsv"
}

fn pdw_composition_event_path() -> str {
    return pdw_dir() + "/composition_event.tsv"
}

fn pdw_effect_event_path() -> str {
    return pdw_dir() + "/effect_event.tsv"
}

fn pdw_thumbnail_event_path() -> str {
    return pdw_dir() + "/thumbnail_event.tsv"
}

fn pdw_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdw_dir() + "'")
}

fn cleanup_pdw() -> void {
    pdw_ensure_dir()
    let _ = exec("rm -f '" + pdw_syscall_invoke_path() + "' '" + pdw_composition_event_path()
        + "' '" + pdw_effect_event_path() + "' '" + pdw_thumbnail_event_path() + "'")
}

// ─── 공통 file IO ───
fn pdw_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdw_append_row(path: str, row: str) -> void {
    pdw_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pdw_count_rows(path: str, min_cols: int) -> int {
    let t = pdw_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (11 fn coverage, fn_kind 0..10) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "DwmIsCompositionEnabled" }
    if k == 1 { return "DwmEnableComposition" }
    if k == 2 { return "DwmExtendFrameIntoClientArea" }
    if k == 3 { return "DwmGetWindowAttribute" }
    if k == 4 { return "DwmEnableBlurBehindWindow" }
    if k == 5 { return "DwmSetWindowAttribute" }
    if k == 6 { return "DwmFlush" }
    if k == 7 { return "DwmGetCompositionTimingInfo" }
    if k == 8 { return "DwmRegisterThumbnail" }
    if k == 9 { return "DwmUnregisterThumbnail" }
    if k == 10 { return "DwmUpdateThumbnailProperties" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 3 {
            return "composition"
        }
    }
    if k >= 4 {
        if k <= 7 {
            return "effects"
        }
    }
    if k >= 8 {
        if k <= 10 {
            return "thumbnails"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: DWMAPI fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_dwmapi_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_dwmapi_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 10 {
        panic("pe_dwmapi_core FAIL [record_syscall_invoke] expected=fn_kind<=10 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_dwmapi_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_dwmapi_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pdw_append_row(pdw_syscall_invoke_path(), row)
}

// ─── record_composition_event: IsCompositionEnabled/EnableComposition/ExtendFrame/GetAttribute row ───
fn record_composition_event(evt_id: int, c_kind: str, comp_state: str, attr_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_dwmapi_core FAIL [record_composition_event] evt_id<=0") }
    if c_kind == "" { panic("pe_dwmapi_core FAIL [record_composition_event] c_kind=empty") }
    if comp_state == "" { panic("pe_dwmapi_core FAIL [record_composition_event] comp_state=empty") }
    if attr_synth == "" { panic("pe_dwmapi_core FAIL [record_composition_event] attr_synth=empty") }
    if status == "" { panic("pe_dwmapi_core FAIL [record_composition_event] status=empty") }
    let row = to_string(evt_id) + "\t" + c_kind + "\t" + comp_state + "\t" + attr_synth + "\t" + status + "\n"
    pdw_append_row(pdw_composition_event_path(), row)
}

// ─── record_effect_event: BlurBehind/SetAttribute/Flush/CompositionTimingInfo row ───
fn record_effect_event(evt_id: int, e_kind: str, effect_synth: str, timing_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_dwmapi_core FAIL [record_effect_event] evt_id<=0") }
    if e_kind == "" { panic("pe_dwmapi_core FAIL [record_effect_event] e_kind=empty") }
    if effect_synth == "" { panic("pe_dwmapi_core FAIL [record_effect_event] effect_synth=empty") }
    if timing_synth == "" { panic("pe_dwmapi_core FAIL [record_effect_event] timing_synth=empty") }
    if status == "" { panic("pe_dwmapi_core FAIL [record_effect_event] status=empty") }
    let row = to_string(evt_id) + "\t" + e_kind + "\t" + effect_synth + "\t" + timing_synth + "\t" + status + "\n"
    pdw_append_row(pdw_effect_event_path(), row)
}

// ─── record_thumbnail_event: Register/Unregister/UpdateProperties row ───
fn record_thumbnail_event(evt_id: int, t_kind: str, hthumb_hex: str, prop_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_dwmapi_core FAIL [record_thumbnail_event] evt_id<=0") }
    if t_kind == "" { panic("pe_dwmapi_core FAIL [record_thumbnail_event] t_kind=empty") }
    if hthumb_hex == "" { panic("pe_dwmapi_core FAIL [record_thumbnail_event] hthumb_hex=empty") }
    if prop_synth == "" { panic("pe_dwmapi_core FAIL [record_thumbnail_event] prop_synth=empty") }
    if status == "" { panic("pe_dwmapi_core FAIL [record_thumbnail_event] status=empty") }
    let row = to_string(evt_id) + "\t" + t_kind + "\t" + hthumb_hex + "\t" + prop_synth + "\t" + status + "\n"
    pdw_append_row(pdw_thumbnail_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pdw_count_rows(pdw_syscall_invoke_path(), 4)
}

fn composition_event_count() -> int {
    return pdw_count_rows(pdw_composition_event_path(), 5)
}

fn effect_event_count() -> int {
    return pdw_count_rows(pdw_effect_event_path(), 5)
}

fn thumbnail_event_count() -> int {
    return pdw_count_rows(pdw_thumbnail_event_path(), 5)
}

fn pdw_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(composition_event_count())
    out.push(effect_event_count())
    out.push(thumbnail_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pdw-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pdw()

    // ─── 1. syscall_invoke × 11 (one per fn, 3 group coverage) ───
    //   COMPOSITION group (4)
    record_syscall_invoke(1, 0, "DwmIsCompositionEnabled", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmIsCompositionEnabled")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"DwmIsCompositionEnabled\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"out_pfEnabled\":\"TRUE_1\",\"return_hresult\":\"S_OK_0\",\"composition_state\":\"enabled_aero\"")
    record_syscall_invoke(2, 1, "DwmEnableComposition", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmEnableComposition")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"DwmEnableComposition\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"uCompositionAction\":\"DWM_EC_ENABLECOMPOSITION_1\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(3, 2, "DwmExtendFrameIntoClientArea", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmExtendFrameIntoClientArea")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"DwmExtendFrameIntoClientArea\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"hwnd\":\"0xB0020100_HWND_d2r_launcher\",\"pMarInset\":\"MARGINS_16B_-1_-1_-1_-1_sheet_of_glass\",\"struct_bytes\":16,\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(4, 3, "DwmGetWindowAttribute", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmGetWindowAttribute")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"DwmGetWindowAttribute\",\"fn_group\":\"composition\",\"status\":\"PARTIAL\",\"hwnd\":\"0xB0020100_HWND\",\"dwAttribute\":\"DWMWA_NCRENDERING_ENABLED_1\",\"out_pvAttribute\":\"BOOL_4B_TRUE_1\",\"cbAttribute\":4,\"return_hresult\":\"S_OK_0\"")

    //   EFFECTS group (4)
    record_syscall_invoke(5, 4, "DwmEnableBlurBehindWindow", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmEnableBlurBehindWindow")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"DwmEnableBlurBehindWindow\",\"fn_group\":\"effects\",\"status\":\"PARTIAL\",\"hwnd\":\"0xB0020100_HWND\",\"pBlurBehind\":\"DWM_BLURBEHIND_16B_dwFlags_0x1_DWM_BB_ENABLE_fEnable_TRUE\",\"struct_bytes\":16,\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(6, 5, "DwmSetWindowAttribute", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmSetWindowAttribute")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"DwmSetWindowAttribute\",\"fn_group\":\"effects\",\"status\":\"PARTIAL\",\"hwnd\":\"0xB0020100_HWND\",\"dwAttribute\":\"DWMWA_USE_IMMERSIVE_DARK_MODE_20\",\"pvAttribute\":\"BOOL_4B_TRUE_1\",\"cbAttribute\":4,\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(7, 6, "DwmFlush", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmFlush")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"DwmFlush\",\"fn_group\":\"effects\",\"status\":\"PARTIAL\",\"return_hresult\":\"S_OK_0\",\"frame_pacing_baseline\":true")
    record_syscall_invoke(8, 7, "DwmGetCompositionTimingInfo", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmGetCompositionTimingInfo")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"DwmGetCompositionTimingInfo\",\"fn_group\":\"effects\",\"status\":\"PARTIAL\",\"hwnd\":0,\"out_pTimingInfo\":\"DWM_TIMING_INFO_152B_rateRefresh_60_1_qpcRefreshPeriod_16666666ns_cFramesDisplayed_1024\",\"struct_bytes\":152,\"return_hresult\":\"S_OK_0\"")

    //   THUMBNAILS group (3)
    record_syscall_invoke(9, 8, "DwmRegisterThumbnail", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmRegisterThumbnail")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"DwmRegisterThumbnail\",\"fn_group\":\"thumbnails\",\"status\":\"PARTIAL\",\"hwndDestination\":\"0xB0020100_HWND\",\"hwndSource\":\"0xB0020200_HWND_d2r_game\",\"out_phThumbnailId\":\"0xB0010100\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(10, 9, "DwmUnregisterThumbnail", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmUnregisterThumbnail")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"DwmUnregisterThumbnail\",\"fn_group\":\"thumbnails\",\"status\":\"PARTIAL\",\"hThumbnailId\":\"0xB0010100\",\"return_hresult\":\"S_OK_0\"")
    record_syscall_invoke(11, 10, "DwmUpdateThumbnailProperties", "PARTIAL")
    println("__DWMAPI__ PARTIAL DwmUpdateThumbnailProperties")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"DwmUpdateThumbnailProperties\",\"fn_group\":\"thumbnails\",\"status\":\"PARTIAL\",\"hThumbnailId\":\"0xB0010100\",\"ptnProperties\":\"DWM_THUMBNAIL_PROPERTIES_48B_dwFlags_0x1F_opacity_255_fVisible_TRUE\",\"struct_bytes\":48,\"return_hresult\":\"S_OK_0\"")

    // ─── 2. composition_event × 4 (enabled/enable/extend_frame/get_attr) ───
    record_composition_event(1, "is_enabled_aero_query", "enabled_TRUE_1", "DWMWA_NCRENDERING_ENABLED_1", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"composition_event\",\"evt_id\":1,\"c_kind\":\"is_enabled_aero_query\",\"comp_state\":\"enabled_TRUE_1\",\"attr_synth\":\"DWMWA_NCRENDERING_ENABLED_1\",\"d2r_d4_aero_baseline\":true,\"status\":\"PARTIAL\"")
    record_composition_event(2, "enable_composition_action", "DWM_EC_ENABLECOMPOSITION_1", "transition_to_aero", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"composition_event\",\"evt_id\":2,\"c_kind\":\"enable_composition_action\",\"comp_state\":\"DWM_EC_ENABLECOMPOSITION_1\",\"attr_synth\":\"transition_to_aero\",\"return_hresult\":\"S_OK_0\",\"status\":\"PARTIAL\"")
    record_composition_event(3, "extend_frame_sheet_of_glass", "MARGINS_16B_-1_-1_-1_-1", "battle_net_dialog_sheet_of_glass", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"composition_event\",\"evt_id\":3,\"c_kind\":\"extend_frame_sheet_of_glass\",\"comp_state\":\"MARGINS_16B_-1_-1_-1_-1\",\"attr_synth\":\"battle_net_dialog_sheet_of_glass\",\"struct_bytes\":16,\"battle_net_dialog_baseline\":true,\"status\":\"PARTIAL\"")
    record_composition_event(4, "get_attr_immersive_dark_mode", "DWMWA_USE_IMMERSIVE_DARK_MODE_20", "BOOL_4B_TRUE_1", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"composition_event\",\"evt_id\":4,\"c_kind\":\"get_attr_immersive_dark_mode\",\"comp_state\":\"DWMWA_USE_IMMERSIVE_DARK_MODE_20\",\"attr_synth\":\"BOOL_4B_TRUE_1\",\"struct_bytes\":4,\"status\":\"PARTIAL\"")

    // ─── 3. effect_event × 4 (blur_behind/set_attr/flush/timing) ───
    record_effect_event(1, "enable_blur_behind_dialog", "DWM_BLURBEHIND_16B_dwFlags_0x1_fEnable_TRUE", "battle_net_dialog_blur", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"effect_event\",\"evt_id\":1,\"e_kind\":\"enable_blur_behind_dialog\",\"effect_synth\":\"DWM_BLURBEHIND_16B_dwFlags_0x1_fEnable_TRUE\",\"timing_synth\":\"battle_net_dialog_blur\",\"struct_bytes\":16,\"battle_net_blur_baseline\":true,\"status\":\"PARTIAL\"")
    record_effect_event(2, "set_attr_dark_mode", "DWMWA_USE_IMMERSIVE_DARK_MODE_20_TRUE", "d2r_launcher_dark_mode", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"effect_event\",\"evt_id\":2,\"e_kind\":\"set_attr_dark_mode\",\"effect_synth\":\"DWMWA_USE_IMMERSIVE_DARK_MODE_20_TRUE\",\"timing_synth\":\"d2r_launcher_dark_mode\",\"struct_bytes\":4,\"status\":\"PARTIAL\"")
    record_effect_event(3, "flush_compositor_60hz", "DwmFlush_present_blocking", "60Hz_synced", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"effect_event\",\"evt_id\":3,\"e_kind\":\"flush_compositor_60hz\",\"effect_synth\":\"DwmFlush_present_blocking\",\"timing_synth\":\"60Hz_synced\",\"frame_pacing_d2r_d4\":true,\"status\":\"PARTIAL\"")
    record_effect_event(4, "get_timing_60hz", "rateRefresh_60_1_qpcRefreshPeriod_16666666ns", "DWM_TIMING_INFO_152B", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"effect_event\",\"evt_id\":4,\"e_kind\":\"get_timing_60hz\",\"effect_synth\":\"rateRefresh_60_1_qpcRefreshPeriod_16666666ns\",\"timing_synth\":\"DWM_TIMING_INFO_152B\",\"struct_bytes\":152,\"cFramesDisplayed\":1024,\"status\":\"PARTIAL\"")

    // ─── 4. thumbnail_event × 3 (register/unregister/update_props) ───
    record_thumbnail_event(1, "register_thumbnail_d2r_game", "0xB0010100", "hwnd_dest_battle_net_overlay", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"thumbnail_event\",\"evt_id\":1,\"t_kind\":\"register_thumbnail_d2r_game\",\"hthumb_hex\":\"0xB0010100\",\"prop_synth\":\"hwnd_dest_battle_net_overlay\",\"battle_net_overlay_baseline\":true,\"status\":\"PARTIAL\"")
    record_thumbnail_event(2, "unregister_thumbnail", "0xB0010100", "release_handle", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"thumbnail_event\",\"evt_id\":2,\"t_kind\":\"unregister_thumbnail\",\"hthumb_hex\":\"0xB0010100\",\"prop_synth\":\"release_handle\",\"return_hresult\":\"S_OK_0\",\"status\":\"PARTIAL\"")
    record_thumbnail_event(3, "update_props_opacity_255_visible", "0xB0010100", "DWM_THUMBNAIL_PROPERTIES_48B_dwFlags_0x1F_opacity_255_fVisible_TRUE", "PARTIAL")
    r0_emit("pe_dwmapi_core_record", "\"kind\":\"thumbnail_event\",\"evt_id\":3,\"t_kind\":\"update_props_opacity_255_visible\",\"hthumb_hex\":\"0xB0010100\",\"prop_synth\":\"DWM_THUMBNAIL_PROPERTIES_48B_dwFlags_0x1F_opacity_255_fVisible_TRUE\",\"struct_bytes\":48,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 11 {
        panic("pe_dwmapi_core FAIL [syscall_invoke_count] expected=11 got=" + to_string(si))
    }
    let ce = composition_event_count()
    if ce != 4 {
        panic("pe_dwmapi_core FAIL [composition_event_count] expected=4 got=" + to_string(ce))
    }
    let ee = effect_event_count()
    if ee != 4 {
        panic("pe_dwmapi_core FAIL [effect_event_count] expected=4 got=" + to_string(ee))
    }
    let te = thumbnail_event_count()
    if te != 3 {
        panic("pe_dwmapi_core FAIL [thumbnail_event_count] expected=3 got=" + to_string(te))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "DwmIsCompositionEnabled" { panic("pe_dwmapi_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "DwmExtendFrameIntoClientArea" { panic("pe_dwmapi_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(4) != "DwmEnableBlurBehindWindow" { panic("pe_dwmapi_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(7) != "DwmGetCompositionTimingInfo" { panic("pe_dwmapi_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(10) != "DwmUpdateThumbnailProperties" { panic("pe_dwmapi_core FAIL [fn_kind_name(10)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_dwmapi_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "composition" { panic("pe_dwmapi_core FAIL [fn_group_name(0)]") }
    if fn_group_name(4) != "effects" { panic("pe_dwmapi_core FAIL [fn_group_name(4)]") }
    if fn_group_name(8) != "thumbnails" { panic("pe_dwmapi_core FAIL [fn_group_name(8)]") }
    if fn_group_name(99) != "unknown" { panic("pe_dwmapi_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pdw_stats()
    if len(s) != 4 { panic("pe_dwmapi_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 11 { panic("pe_dwmapi_core FAIL [stats syscall_invoke_count] expected=11 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_dwmapi_core FAIL [stats composition_event_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_dwmapi_core FAIL [stats effect_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_dwmapi_core FAIL [stats thumbnail_event_count] expected=3 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_dwmapi_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"composition_event_count\":" + to_string(s[1])
        + ",\"effect_event_count\":" + to_string(s[2])
        + ",\"thumbnail_event_count\":" + to_string(s[3]))

    r0_emit("pe_dwmapi_core_summary",
        "\"target\":\"DWMAPI.dll\",\"fn_total\":11,\"fn_emit_partial\":11,\"groups\":[\"composition\",\"effects\",\"thumbnails\"],\"margins_synth_bytes\":16,\"dwm_blurbehind_synth_bytes\":16,\"dwm_timing_info_synth_bytes\":152,\"dwm_thumbnail_props_synth_bytes\":48,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_dwmapi_core_kpi",
        "\"composition_emits\":4,\"effect_emits\":4,\"thumbnail_emits\":3,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"d2r_d4_compositor_state_baseline\":true,\"battlenet_agent_blur_dialog_baseline\":true,\"windowserver_coreanimation_calayer_binding\":false,\"cametallayer_nsvisualeffectview_binding\":false")

    // ─── cycle 52 → 53 DWMAPI coverage progression evidence emit ───
    r0_emit("pe_dwmapi_core_coverage_progression",
        "\"surface\":\"DWMAPI_full_435_fn\",\"cycle_52_count\":314,\"cycle_53_count\":325,\"delta\":11,\"cycle_52_percent\":72.18,\"cycle_53_percent\":74.71,\"cycle_53_module\":\"pe_dwmapi_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_bh2_cycle_increment\":11,\"track_bh_bundled_part_2_of_4\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_dwmapi_core_round_trip_matrix",
        "\"surface\":\"DWMAPI_core_11_fn\",\"fn_partial\":11,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.2\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real DwmExtendFrameIntoClientArea + DwmEnableBlurBehindWindow + DwmGetCompositionTimingInfo = WindowServer + CoreAnimation CALayer + CAMetalLayer + NSVisualEffectView + CGSConnection + CGSWindow bridge pending separate cycle (long-horizon compositor pipeline)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    // ─── Track BH2 expansion emit (cycle 53, DWMAPI +11 fn) ───
    r0_emit("pe_dwmapi_core_bh2_expansion",
        "\"track\":\"BH2\",\"cycle\":53,\"surface\":\"DWMAPI_new\",\"new_fn\":11,\"groups\":[\"composition\",\"effects\",\"thumbnails\"],\"composition_count\":4,\"effects_count\":4,\"thumbnails_count\":3,\"emit_format\":\"__DWMAPI__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_2_evidence_augment\":true,\"track_bh_bundled_part_2_of_4\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_dwmapi_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pdw()
    let s2 = pdw_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dwmapi_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dwmapi_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", composition_event=" + to_string(s[1])
        + ", effect_event=" + to_string(s[2]) + ", thumbnail_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdw_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("composition_event_count\t" + to_string(s[1]))
            println("effect_event_count\t" + to_string(s[2]))
            println("thumbnail_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_dwmapi_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_dwmapi_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdw()
            println("cleaned: " + pdw_dir())
            return
        }
        if sub == "dir" {
            println(pdw_dir())
            return
        }
    }
    println("usage: hexa run pe_dwmapi_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
