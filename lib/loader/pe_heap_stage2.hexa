// lib/loader/pe_heap_stage2.hexa — stage2 process heap skeleton
//
// Win32 ProcessHeap 시뮬레이션. HeapCreate (size, opts) → mmap-backed region.
// HeapAlloc / HeapFree 추적 + leak detect.
//
// own 1 enforcement: Wine / CrossOver / ReactOS / community heap manager 0 줄.
//   참조 only — Microsoft 공식 Heap API spec:
//     - HeapCreate:    https://learn.microsoft.com/en-us/windows/win32/api/heapapi/nf-heapapi-heapcreate
//     - HeapAlloc:     https://learn.microsoft.com/en-us/windows/win32/api/heapapi/nf-heapapi-heapalloc
//     - HeapFree:      https://learn.microsoft.com/en-us/windows/win32/api/heapapi/nf-heapapi-heapfree
//     - HeapDestroy:   https://learn.microsoft.com/en-us/windows/win32/api/heapapi/nf-heapapi-heapdestroy
//     - GetProcessHeap:https://learn.microsoft.com/en-us/windows/win32/api/heapapi/nf-heapapi-getprocessheap
//
// own 2 mandate:
//   - r0_emit ≥ 6
//     (실제: phs_create + phs_alloc × 2 + phs_free + phs_destroy + phs_stats)
//   - fn self_test() + main() dispatch
//   - headless (stdin/stdout/file 만)
//   - panic("pe_heap_stage2 FAIL [<sub>] expected=X got=Y")
//
// 범위 (Phase — PE process heap recording):
//   stage1 = mmap region 할당 (synthetic addr 부여).
//   stage2 = 실제 Heap operation 단계 — alloc/free/create/destroy 추적.
//
// op_kind 정의:
//   1 = alloc    (HeapAlloc)
//   2 = free     (HeapFree)
//   3 = create   (HeapCreate)
//   4 = destroy  (HeapDestroy)
//
// schema (heap_ops.tsv): heap_id<int> | op_kind<int> | size<int> | addr<int>

use "../perf/r0_common"

// ─── persist 디렉토리 ───
fn phs_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_heap_stage2"
}

fn heap_ops_path() -> str {
    return phs_dir() + "/heap_ops.tsv"
}

fn ensure_phs_dir() -> void {
    let _ = exec("mkdir -p '" + phs_dir() + "'")
}

fn cleanup_phs() -> void {
    ensure_phs_dir()
    let _ = exec("rm -f '" + heap_ops_path() + "'")
}

// ─── 공통 file IO ───
fn read_phs_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn append_phs_row(path: str, row: str) -> void {
    ensure_phs_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_heap_op ───
//   op_kind: 1=alloc, 2=free, 3=create, 4=destroy
fn record_heap_op(heap_id: int, op_kind: int, size: int, addr: int) -> void {
    let row = to_string(heap_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(size) + "\t" + to_string(addr) + "\n"
    append_phs_row(heap_ops_path(), row)
}

// ─── op_count: 전체 row 수 ───
fn op_count() -> int {
    let t = read_phs_table(heap_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        if lines[i] != "" {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ─── total_alloc_bytes: op_kind=1 의 size 합 ───
fn total_alloc_bytes() -> int {
    let t = read_phs_table(heap_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let k = to_int(parts[1])
                if k == 1 {
                    sum = sum + to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_free_bytes: op_kind=2 의 size 합 ───
fn total_free_bytes() -> int {
    let t = read_phs_table(heap_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let k = to_int(parts[1])
                if k == 2 {
                    sum = sum + to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return sum
}

// ─── live_heap_bytes: alloc - free ───
fn live_heap_bytes() -> int {
    return total_alloc_bytes() - total_free_bytes()
}

// ─── count_by_op_kind: 특정 op_kind 의 row 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = read_phs_table(heap_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut c = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let k = to_int(parts[1])
                if k == kind {
                    c = c + 1
                }
            }
        }
        i = i + 1
    }
    return c
}

// ─── phs_stats: [op_count, total_alloc_bytes, total_free_bytes, live_heap_bytes] ───
fn phs_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_alloc_bytes())
    out.push(total_free_bytes())
    out.push(live_heap_bytes())
    return out
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "phs-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_phs()

    // 1b. cleanup 후 op_count == 0
    let c0 = op_count()
    if c0 != 0 {
        panic("pe_heap_stage2 FAIL [cleanup op_count] expected=0 got=" + to_string(c0))
    }

    // 2. record 5 ops
    record_heap_op(76001, 3, 1048576, 0x100000)  // create 1MB heap
    r0_emit("phs_create",
        "\"heap_id\":76001,\"size\":1048576,\"addr\":\"0x100000\"")

    record_heap_op(76001, 1, 4096, 0x101000)     // alloc 4KB
    r0_emit("phs_alloc",
        "\"heap_id\":76001,\"size\":4096,\"addr\":\"0x101000\"")

    record_heap_op(76001, 1, 8192, 0x102000)     // alloc 8KB
    r0_emit("phs_alloc",
        "\"heap_id\":76001,\"size\":8192,\"addr\":\"0x102000\"")

    record_heap_op(76001, 2, 4096, 0x101000)     // free 4KB
    r0_emit("phs_free",
        "\"heap_id\":76001,\"size\":4096,\"addr\":\"0x101000\"")

    record_heap_op(76001, 4, 1048576, 0x100000)  // destroy
    r0_emit("phs_destroy",
        "\"heap_id\":76001,\"size\":1048576,\"addr\":\"0x100000\"")

    // 3. op_count == 5
    let c = op_count()
    if c != 5 {
        panic("pe_heap_stage2 FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_alloc_bytes == 12288 (4096 + 8192)
    let ta = total_alloc_bytes()
    if ta != 12288 {
        panic("pe_heap_stage2 FAIL [total_alloc_bytes] expected=12288 got=" + to_string(ta))
    }

    // 5. total_free_bytes == 4096
    let tf = total_free_bytes()
    if tf != 4096 {
        panic("pe_heap_stage2 FAIL [total_free_bytes] expected=4096 got=" + to_string(tf))
    }

    // 6. live_heap_bytes == 8192
    let lh = live_heap_bytes()
    if lh != 8192 {
        panic("pe_heap_stage2 FAIL [live_heap_bytes] expected=8192 got=" + to_string(lh))
    }

    // 7. count_by_op_kind: 1=2, 2=1, 3=1, 4=1, 99=0
    let n1 = count_by_op_kind(1)
    if n1 != 2 {
        panic("pe_heap_stage2 FAIL [count_by_op_kind 1] expected=2 got=" + to_string(n1))
    }
    let n2 = count_by_op_kind(2)
    if n2 != 1 {
        panic("pe_heap_stage2 FAIL [count_by_op_kind 2] expected=1 got=" + to_string(n2))
    }
    let n3 = count_by_op_kind(3)
    if n3 != 1 {
        panic("pe_heap_stage2 FAIL [count_by_op_kind 3] expected=1 got=" + to_string(n3))
    }
    let n4 = count_by_op_kind(4)
    if n4 != 1 {
        panic("pe_heap_stage2 FAIL [count_by_op_kind 4] expected=1 got=" + to_string(n4))
    }
    let n99 = count_by_op_kind(99)
    if n99 != 0 {
        panic("pe_heap_stage2 FAIL [count_by_op_kind 99] expected=0 got=" + to_string(n99))
    }

    // 8. phs_stats() == [5, 12288, 4096, 8192]
    let s = phs_stats()
    if len(s) != 4 {
        panic("pe_heap_stage2 FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_heap_stage2 FAIL [stats[0]] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 12288 {
        panic("pe_heap_stage2 FAIL [stats[1]] expected=12288 got=" + to_string(s[1]))
    }
    if s[2] != 4096 {
        panic("pe_heap_stage2 FAIL [stats[2]] expected=4096 got=" + to_string(s[2]))
    }
    if s[3] != 8192 {
        panic("pe_heap_stage2 FAIL [stats[3]] expected=8192 got=" + to_string(s[3]))
    }

    // 9. emit phs_stats (final aggregator)
    r0_emit("phs_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"alloc\":" + to_string(s[1])
        + ",\"free\":" + to_string(s[2])
        + ",\"live\":" + to_string(s[3]))

    // 10. r0_emit count 검증 (≥ 6; 실제 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_heap_stage2 FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → 모든 stat 0
    cleanup_phs()
    let s2 = phs_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_heap_stage2 FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    // 12. PASS
    println("  ✅ pe_heap_stage2 self_test PASS (5 ops, alloc=" + to_string(ta)
        + ", free=" + to_string(tf) + ", live=" + to_string(lh)
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = phs_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_alloc_bytes\t" + to_string(s[1]))
            println("total_free_bytes\t" + to_string(s[2]))
            println("live_heap_bytes\t" + to_string(s[3]))
            return
        }
        if sub == "live" {
            println(to_string(live_heap_bytes()))
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println(to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_heap_stage2.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_phs()
            println("cleaned: " + phs_dir())
            return
        }
        if sub == "dir" {
            println(phs_dir())
            return
        }
    }
    println("usage: hexa run pe_heap_stage2.hexa { self-test | stats | live | count <op_kind> | cleanup | dir }")
}
