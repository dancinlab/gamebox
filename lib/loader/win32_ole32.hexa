// lib/loader/win32_ole32.hexa — Phase 4e — ole32 minimal mapping
//
// own 1: Wine 0. Microsoft COM API spec 만 참조.
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe ole32 imports (실측):
//   CoCreateInstance, CoTaskMemFree
//
// COM minimal — installer 가 CoCreateInstance 으로 IShellLink, IPersistFile
// 같은 표준 COM object 생성 후 사용. skeleton 단계는 NULL 반환 + 호출 추적.

use "../perf/r0_common"

fn ole32_table() -> str {
    let t = ""
    t = t + "CoCreateInstance\tNSClassFromString_synthetic\tCOM\tskeleton\n"
    t = t + "CoTaskMemFree\tfree\tCOM\tskeleton\n"
    return t
}

fn ole32_table_size() -> int {
    let lines = ole32_table().split("\n")
    let n = len(lines)
    let i = 0
    let count = 0
    while i < n {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn lookup_mapping(name: str) -> str {
    let lines = ole32_table().split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        if lines[i] != "" {
            let parts = lines[i].split("\t")
            if len(parts) >= 4 && parts[0] == name {
                return parts[1] + "\t" + parts[2] + "\t" + parts[3]
            }
        }
        i = i + 1
    }
    return ""
}

fn function_macos_equiv(name: str) -> str {
    let m = lookup_mapping(name)
    if m == "" { return "" }
    let parts = m.split("\t")
    if len(parts) < 1 { return "" }
    return parts[0]
}

// CoCreateInstance(CLSID, ...) → 합성 NULL pointer (skeleton)
fn co_create_instance_stub(clsid: str) -> str {
    return "NULL"
}

fn self_test() -> void {
    let sid = "ole32test-" + exec("date +%s").trim()
    r0_session_set(sid)

    let sz = ole32_table_size()
    if sz != 2 { panic("win32_ole32 FAIL [size] expected=2 got=" + to_string(sz)) }

    let m = lookup_mapping("CoCreateInstance")
    if !m.contains("COM") { panic("win32_ole32 FAIL [lookup CoCreateInstance]") }

    let m2 = lookup_mapping("CoTaskMemFree")
    if !m2.contains("free") { panic("win32_ole32 FAIL [lookup CoTaskMemFree]") }

    let unk = lookup_mapping("Unknown")
    if unk != "" { panic("win32_ole32 FAIL [lookup unknown]") }

    let stub = co_create_instance_stub("00000000-0000-0000-0000-000000000000")
    if stub != "NULL" { panic("win32_ole32 FAIL [stub] got=" + stub) }

    r0_emit("ole32_lookup", "\"name\":\"CoCreateInstance\",\"macos\":\"" + function_macos_equiv("CoCreateInstance") + "\"")
    r0_emit("ole32_stats", "\"functions\":" + to_string(sz))

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("win32_ole32 FAIL [emit count] expected>=2 got=" + to_string(cnt)) }

    println("  ✅ win32_ole32 self_test PASS (2 funcs, COM minimal, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "table" { println(ole32_table()); return }
        if sub == "lookup" && len(a) >= 4 {
            let r = lookup_mapping(a[3])
            if r == "" { println("not_found") } else { println(r) }
            return
        }
    }
    println("usage: hexa run win32_ole32.hexa { self-test | table | lookup <name> }")
}
