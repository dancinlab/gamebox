// lib/loader/pe_battle_net_agent_ipc_track.hexa — cycle 82 bonus
//
// Battle.net Agent IPC 패턴 (own2 자체 추적):
//   transport:
//     - localhost named pipe (\\.\pipe\battle.net.agent.<UUID>) — Win32
//     - TCP loopback (127.0.0.1:1120 default Battle.net Agent port)
//     - WebSocket on top of HTTP (Battle.net launcher → Agent REST)
//     - HTTPS to bnetcdn / akamaihd (download)
//   rpc:
//     login              — OAuth2 token request, account credentials
//     token_refresh      — Bearer token expiration / refresh
//     game_state         — installed/installing/uninstalled per app_id (D2R = 'OSI', D4 = 'Fen')
//     download_progress  — bytes_downloaded / total_bytes / current_chunk
//     patch_apply        — patch script invocation, file rename/diff
//     launch_request     — actual game.exe spawn with cmdline
//     heartbeat          — periodic ping for Agent liveness
//   D2R / D4 모두 Agent IPC 통과해야 launch 가능 (offline mode 도 token 검증 필요)
// own1: Battle.net protocol observation — Wine bnet protocol code 인용 X
//
// transport_kind code:
//   1 = named_pipe
//   2 = tcp_loopback
//   3 = websocket
//   4 = https
//
// rpc_kind code:
//   1 = login
//   2 = token_refresh
//   3 = game_state
//   4 = download_progress
//   5 = patch_apply
//   6 = launch_request
//   7 = heartbeat
//
// persist schema (TSV — msgs.tsv):
//   msg_id<int> \t transport_kind<int> \t rpc_kind<int> \t payload_bytes<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pbnait_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_battle_net_agent_ipc_track"
}

fn pbnait_msgs_path() -> str {
    return pbnait_dir() + "/msgs.tsv"
}

fn pbnait_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pbnait_dir() + "'")
}

fn cleanup_pbnait() -> void {
    pbnait_ensure_dir()
    let _ = exec("rm -f '" + pbnait_msgs_path() + "'")
}

// ─── 공통 file IO ───
fn pbnait_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pbnait_append_row(path: str, row: str) -> void {
    pbnait_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_msg: Agent IPC msg 1 건 기록 ───
fn record_msg(msg_id: int, transport_kind: int, rpc_kind: int, payload_bytes: int) -> void {
    if msg_id <= 0 {
        panic("pe_battle_net_agent_ipc_track FAIL [record_msg] expected=msg_id>0 got=" + to_string(msg_id))
    }
    if transport_kind < 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [record_msg] expected=transport_kind>=1 got=" + to_string(transport_kind))
    }
    if transport_kind > 4 {
        panic("pe_battle_net_agent_ipc_track FAIL [record_msg] expected=transport_kind<=4 got=" + to_string(transport_kind))
    }
    if rpc_kind < 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [record_msg] expected=rpc_kind>=1 got=" + to_string(rpc_kind))
    }
    if rpc_kind > 7 {
        panic("pe_battle_net_agent_ipc_track FAIL [record_msg] expected=rpc_kind<=7 got=" + to_string(rpc_kind))
    }
    if payload_bytes < 0 {
        panic("pe_battle_net_agent_ipc_track FAIL [record_msg] expected=payload_bytes>=0 got=" + to_string(payload_bytes))
    }
    let row = to_string(msg_id) + "\t" + to_string(transport_kind)
        + "\t" + to_string(rpc_kind) + "\t" + to_string(payload_bytes) + "\n"
    pbnait_append_row(pbnait_msgs_path(), row)
}

// ─── msg_count: total msg 수 ───
fn msg_count() -> int {
    let t = pbnait_read_table(pbnait_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_transport_kind: 특정 transport_kind 의 msg 수 ───
fn count_by_transport_kind(transport_kind: int) -> int {
    let t = pbnait_read_table(pbnait_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == transport_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_rpc_kind: 특정 rpc_kind 의 msg 수 ───
fn count_by_rpc_kind(rpc_kind: int) -> int {
    let t = pbnait_read_table(pbnait_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == rpc_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_payload_bytes: 모든 msg payload_bytes 합 ───
fn total_payload_bytes() -> int {
    let t = pbnait_read_table(pbnait_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── launch_request_count: rpc_kind=6 (launch_request) msg 수 ───
fn launch_request_count() -> int {
    return count_by_rpc_kind(6)
}

// ─── msg_payload: 특정 msg_id 의 payload_bytes (없으면 0) ───
fn msg_payload(msg_id: int) -> int {
    let t = pbnait_read_table(pbnait_msgs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == msg_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pbnait_stats: [msg_count, total_payload_bytes, launch_request_count, count_by_transport_kind(2)] ───
fn pbnait_stats() -> array {
    let mut out = []
    out.push(msg_count())
    out.push(total_payload_bytes())
    out.push(launch_request_count())
    out.push(count_by_transport_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pbnait-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pbnait()

    // 2. record 6 Agent IPC msgs across ≥3 transports + ≥4 rpc_kinds
    //    transports: named_pipe(1), tcp_loopback(2), websocket(3), https(4)
    //    rpc_kinds:  login(1), token_refresh(2), game_state(3), download_progress(4),
    //                patch_apply(5), launch_request(6), heartbeat(7)
    record_msg(820001, 4, 1, 512)        // https + login (OAuth2)
    r0_emit("pe_battle_net_agent_ipc_track_record",
        "\"msg_id\":820001,\"transport_kind\":4,\"rpc_kind\":1,\"payload_bytes\":512,\"target\":\"https/login\"")

    record_msg(820002, 2, 3, 256)        // tcp_loopback + game_state
    r0_emit("pe_battle_net_agent_ipc_track_record",
        "\"msg_id\":820002,\"transport_kind\":2,\"rpc_kind\":3,\"payload_bytes\":256,\"target\":\"tcp_loopback/game_state\"")

    record_msg(820003, 3, 4, 1024)       // websocket + download_progress
    r0_emit("pe_battle_net_agent_ipc_track_record",
        "\"msg_id\":820003,\"transport_kind\":3,\"rpc_kind\":4,\"payload_bytes\":1024,\"target\":\"websocket/download_progress\"")

    record_msg(820004, 2, 7, 64)         // tcp_loopback + heartbeat
    r0_emit("pe_battle_net_agent_ipc_track_record",
        "\"msg_id\":820004,\"transport_kind\":2,\"rpc_kind\":7,\"payload_bytes\":64,\"target\":\"tcp_loopback/heartbeat\"")

    record_msg(820005, 1, 6, 384)        // named_pipe + launch_request (D2R = 'OSI')
    r0_emit("pe_battle_net_agent_ipc_track_record",
        "\"msg_id\":820005,\"transport_kind\":1,\"rpc_kind\":6,\"payload_bytes\":384,\"target\":\"named_pipe/launch_request/OSI\"")

    record_msg(820006, 2, 6, 448)        // tcp_loopback + launch_request (D4 = 'Fen')
    r0_emit("pe_battle_net_agent_ipc_track_record",
        "\"msg_id\":820006,\"transport_kind\":2,\"rpc_kind\":6,\"payload_bytes\":448,\"target\":\"tcp_loopback/launch_request/Fen\"")

    // 3. msg_count = 6
    let c = msg_count()
    if c != 6 {
        panic("pe_battle_net_agent_ipc_track FAIL [msg_count] expected=6 got=" + to_string(c))
    }

    // 4. total_payload_bytes = 512+256+1024+64+384+448 = 2688
    let tb = total_payload_bytes()
    if tb != 2688 {
        panic("pe_battle_net_agent_ipc_track FAIL [total_payload_bytes] expected=2688 got=" + to_string(tb))
    }

    // 5. count_by_transport_kind sanity
    let t1 = count_by_transport_kind(1)
    if t1 != 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_transport_kind(1)] expected=1 got=" + to_string(t1))
    }
    let t2 = count_by_transport_kind(2)
    if t2 != 3 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_transport_kind(2)] expected=3 got=" + to_string(t2))
    }
    let t3 = count_by_transport_kind(3)
    if t3 != 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_transport_kind(3)] expected=1 got=" + to_string(t3))
    }
    let t4 = count_by_transport_kind(4)
    if t4 != 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_transport_kind(4)] expected=1 got=" + to_string(t4))
    }
    let t99 = count_by_transport_kind(99)
    if t99 != 0 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_transport_kind(99)] expected=0 got=" + to_string(t99))
    }

    // 6. count_by_rpc_kind sanity (≥4 distinct kinds: 1,3,4,7,6)
    let r1 = count_by_rpc_kind(1)
    if r1 != 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_rpc_kind(1)] expected=1 got=" + to_string(r1))
    }
    let r3 = count_by_rpc_kind(3)
    if r3 != 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_rpc_kind(3)] expected=1 got=" + to_string(r3))
    }
    let r4 = count_by_rpc_kind(4)
    if r4 != 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_rpc_kind(4)] expected=1 got=" + to_string(r4))
    }
    let r6 = count_by_rpc_kind(6)
    if r6 != 2 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_rpc_kind(6)] expected=2 got=" + to_string(r6))
    }
    let r7 = count_by_rpc_kind(7)
    if r7 != 1 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_rpc_kind(7)] expected=1 got=" + to_string(r7))
    }
    let r2 = count_by_rpc_kind(2)
    if r2 != 0 {
        panic("pe_battle_net_agent_ipc_track FAIL [count_by_rpc_kind(2)] expected=0 got=" + to_string(r2))
    }

    // 7. launch_request_count = 2 (D2R + D4)
    let lrc = launch_request_count()
    if lrc != 2 {
        panic("pe_battle_net_agent_ipc_track FAIL [launch_request_count] expected=2 got=" + to_string(lrc))
    }

    // 8. msg_payload sanity
    let p3 = msg_payload(820003)
    if p3 != 1024 {
        panic("pe_battle_net_agent_ipc_track FAIL [msg_payload(820003)] expected=1024 got=" + to_string(p3))
    }
    let p5 = msg_payload(820005)
    if p5 != 384 {
        panic("pe_battle_net_agent_ipc_track FAIL [msg_payload(820005)] expected=384 got=" + to_string(p5))
    }
    let p_miss = msg_payload(9999)
    if p_miss != 0 {
        panic("pe_battle_net_agent_ipc_track FAIL [msg_payload(9999)] expected=0 got=" + to_string(p_miss))
    }

    // 9. pbnait_stats() = [6, 2688, 2, 3]
    let s = pbnait_stats()
    if len(s) != 4 {
        panic("pe_battle_net_agent_ipc_track FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_battle_net_agent_ipc_track FAIL [stats msg_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 2688 {
        panic("pe_battle_net_agent_ipc_track FAIL [stats total_payload_bytes] expected=2688 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_battle_net_agent_ipc_track FAIL [stats launch_request_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_battle_net_agent_ipc_track FAIL [stats count_transport(2)] expected=3 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_battle_net_agent_ipc_track_stats",
        "\"msg_count\":" + to_string(s[0])
        + ",\"total_payload_bytes\":" + to_string(s[1])
        + ",\"launch_request_count\":" + to_string(s[2])
        + ",\"transport_tcp_loopback\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_battle_net_agent_ipc_track FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pbnait()
    let s2 = pbnait_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_battle_net_agent_ipc_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    // ─── synthetic Agent IPC round-trip (Track-N cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track-N mission: battlenet cond.3 (Agent IPC + REST endpoint live round-trip
    // simulation) 측 evidence augment. cond.3 측 status `partial` 영구 유지 —
    // 실 http://localhost:1120 Battle.net Agent endpoint + 실 IPC envelope
    // round-trip 측 production smoke gate transitive (network-dependent, blk.1
    // + Track-K Win32 syscall perfection long-horizon 정합).
    //
    // synthetic Agent IPC round-trip: 4 verb (install/launch/uninstall/heartbeat)
    // × IPC message envelope (request → response). hexa-native loop only —
    // 실 TCP loopback 0, named pipe 0, http server 0, websocket 0,
    // OAuth credential 0. Mirror style of pe_battlenet_agent_sd_forging.hexa
    // 측 3 verb round-trip matrix (cond.1 PASS) — 본 augment 는 4 verb PARTIAL
    // matrix (cond.3 partial 유지 정합, NOT PASS).
    //
    // payload = ipc_msg_id + verb_kind + response_code_simulated.
    // round-trip emit = `__BNET_IPC__ PARTIAL <verb>` per row.
    //
    // own1: Wine 0 / IPC bypass 0 / endpoint spoof 0 / port hijack 0.
    // own2: PARTIAL emit explicit (NOT PASS — production smoke deferred,
    //       cond.1 PASS shim 와 명확 distinct).
    let synth_ipc_session = "ipc-synth-" + exec("date +%s").trim()

    println("__BNET_IPC__ PARTIAL install")
    r0_emit("pe_battle_net_agent_ipc_track_synthetic_round_trip",
        "\"stage\":\"agent_ipc_envelope_round_trip\",\"ipc_session\":\"" + synth_ipc_session + "\",\"ipc_msg_id\":900001,\"verb_kind\":\"install\",\"endpoint_simulated\":\"http://localhost:1120/agent/v1/install\",\"response_code_simulated\":200,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"permanent_until_real_network — blk.1 transitive\"")

    println("__BNET_IPC__ PARTIAL launch")
    r0_emit("pe_battle_net_agent_ipc_track_synthetic_round_trip",
        "\"stage\":\"agent_ipc_envelope_round_trip\",\"ipc_session\":\"" + synth_ipc_session + "\",\"ipc_msg_id\":900002,\"verb_kind\":\"launch\",\"endpoint_simulated\":\"http://localhost:1120/agent/v1/launch\",\"response_code_simulated\":200,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__BNET_IPC__ PARTIAL uninstall")
    r0_emit("pe_battle_net_agent_ipc_track_synthetic_round_trip",
        "\"stage\":\"agent_ipc_envelope_round_trip\",\"ipc_session\":\"" + synth_ipc_session + "\",\"ipc_msg_id\":900003,\"verb_kind\":\"uninstall\",\"endpoint_simulated\":\"http://localhost:1120/agent/v1/uninstall\",\"response_code_simulated\":200,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__BNET_IPC__ PARTIAL heartbeat")
    r0_emit("pe_battle_net_agent_ipc_track_synthetic_round_trip",
        "\"stage\":\"agent_ipc_envelope_round_trip\",\"ipc_session\":\"" + synth_ipc_session + "\",\"ipc_msg_id\":900004,\"verb_kind\":\"heartbeat\",\"endpoint_simulated\":\"http://localhost:1120/agent/v1/heartbeat\",\"response_code_simulated\":204,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    r0_emit("pe_battle_net_agent_ipc_track_synthetic_round_trip_matrix",
        "\"verbs_total\":4,\"verbs_partial\":4,\"verbs_pass\":0,\"ipc_session\":\"" + synth_ipc_session + "\",\"transport_kind\":\"synthetic_inline\",\"network\":\"none\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"track\":\"N4\",\"lockin_iso\":\"2026-05-03\",\"distinct_from_cond_1_pass_shim\":true")

    println("  ✅ pe_battle_net_agent_ipc_track self_test PASS (msgs=" + to_string(s[0])
        + ", payload_bytes=" + to_string(s[1]) + ", launch_requests=" + to_string(s[2])
        + ", +4 synthetic verb PARTIAL round-trips, emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pbnait_stats()
            println("msg_count\t" + to_string(s[0]))
            println("total_payload_bytes\t" + to_string(s[1]))
            println("launch_request_count\t" + to_string(s[2]))
            println("count_transport_tcp_loopback\t" + to_string(s[3]))
            return
        }
        if sub == "payload" {
            if len(a) >= 4 {
                let mid = to_int(a[3])
                println("msg_payload\t" + to_string(msg_payload(mid)))
                return
            }
            println("usage: hexa run pe_battle_net_agent_ipc_track.hexa payload <msg_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let dim = a[3]
                let val = to_int(a[4])
                if dim == "transport" {
                    println("count_by_transport_kind\t" + to_string(count_by_transport_kind(val)))
                    return
                }
                if dim == "rpc" {
                    println("count_by_rpc_kind\t" + to_string(count_by_rpc_kind(val)))
                    return
                }
            }
            println("usage: hexa run pe_battle_net_agent_ipc_track.hexa count { transport <transport_kind> | rpc <rpc_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pbnait()
            println("cleaned: " + pbnait_dir())
            return
        }
        if sub == "dir" {
            println(pbnait_dir())
            return
        }
    }
    println("usage: hexa run pe_battle_net_agent_ipc_track.hexa { self-test | stats | payload <msg_id> | count transport <transport_kind> | count rpc <rpc_kind> | cleanup | dir }")
}
