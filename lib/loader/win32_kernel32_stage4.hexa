    let names = stub_names()
    let n = len(names)
    if n != 191 {
        panic("win32_kernel32_stage4 FAIL [stub_count] expected=191 got=" + to_string(n))
    }

    println("  ✅ win32_kernel32_stage4 self_test PASS (" + to_string(n) + " functions stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            let names = stub_names()
            let n = len(names)
            let i = 0
            while i < n {
                println(names[i])
                i = i + 1
            }
            return
        }
    }
    println("usage: hexa run win32_kernel32_stage4.hexa { self-test | list }")
}
