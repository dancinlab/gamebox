// lib/loader/win32_winsock_stage2.hexa — Battle.net Setup WS2_32 imports coverage
//
// Battle.net 의 socket 함수. WSAStartup, socket, connect, send, recv, closesocket,
// gethostbyname 등. stage1 base 위에 추가. 주의: ordinals (#xxx) 는 stub 대상 X
// (이름으로 매핑 안 됨).
//
// own 1: Wine 0. Microsoft Winsock 2 / WS2_32 API spec 만 참조.
//   https://learn.microsoft.com/en-us/windows/win32/api/winsock2/
//   https://learn.microsoft.com/en-us/windows/win32/api/ws2tcpip/
// own 2: r0_emit ≥ 1, self_test, headless, panic format.
//
// Battle.net-Setup.exe WS2_32 imports (실측, DLL idx=3, ~31 entries):
//   대부분 ordinals (#1..#151) — stub 대상 X (이름 매핑 불가).
//   Named imports (3): freeaddrinfo, getaddrinfo, WSAIoctl.
//   stage1 에 getaddrinfo_w / freeaddrinfo 부재 → stage2 에서 새로 stub.
//
// stage2 = synthetic stub layer (실제 socket 호출 없이 ABI level retval):
//   void returns       → no return
//   int  returns (0=ok)→ 0

use "../perf/r0_common"

// ─── int returns (success = 0) ──────────────────────────────
//   getaddrinfo: returns 0 on success, non-zero error code otherwise.
fn stub_getaddrinfo() -> int {
    return 0
}

//   WSAIoctl: returns 0 on success, SOCKET_ERROR (-1) otherwise.
fn stub_wsa_ioctl() -> int {
    return 0
}

// ─── void returns ───────────────────────────────────────────
//   freeaddrinfo: void — frees addrinfo chain. stub = no-op.
fn stub_freeaddrinfo() -> void {
}

// ─── coverage table — stub name → return-class ──────────────
fn stub_table() -> str {
    let t = ""
    t = t + "getaddrinfo\tINT\n"
    t = t + "WSAIoctl\tINT\n"
    t = t + "freeaddrinfo\tVOID\n"
    return t
}

fn stub_count() -> int {
    let lines = stub_table().split("\n")
    let i = 0
    let count = 0
    while i < len(lines) {
        if lines[i] != "" { count = count + 1 }
        i = i + 1
    }
    return count
}

fn list_stubs() -> void {
    let lines = stub_table().split("\n")
    let i = 0
    while i < len(lines) {
        if lines[i] != "" {
            println(lines[i])
        }
        i = i + 1
    }
}

fn self_test() -> void {
    let sid = "wsks2-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. stub count
    let n = stub_count()
    if n != 3 { panic("win32_winsock_stage2 FAIL [count] expected=3 got=" + to_string(n)) }

    // 2. INT-returning stubs (success = 0)
    let i1 = stub_getaddrinfo()
    if i1 != 0 { panic("win32_winsock_stage2 FAIL [getaddrinfo] expected=0 got=" + to_string(i1)) }
    let i2 = stub_wsa_ioctl()
    if i2 != 0 { panic("win32_winsock_stage2 FAIL [WSAIoctl] expected=0 got=" + to_string(i2)) }

    // 3. VOID-returning stub (no return — call only)
    stub_freeaddrinfo()

    // 4. r0_emit
    r0_emit("winsock_stage2_stub",
        "\"stubs\":" + to_string(n)
        + ",\"ints\":2,\"voids\":1")

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("win32_winsock_stage2 FAIL [emit count] expected=>=1 got=" + to_string(cnt)) }

    println("  ✅ win32_winsock_stage2 self_test PASS (" + to_string(n) + " stubbed)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            list_stubs()
            return
        }
    }
    println("usage: hexa run win32_winsock_stage2.hexa { self-test | list }")
}
