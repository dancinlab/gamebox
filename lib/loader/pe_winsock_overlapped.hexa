// lib/loader/pe_winsock_overlapped.hexa — cycle 75 Winsock async I/O telemetry skeleton
//
// Windows ws2_32.dll Winsock async I/O — WSARecv / WSASend with OVERLAPPED
// 구조체 + LPWSAOVERLAPPED_COMPLETION_ROUTINE callback / WSAEvent / APC /
// IOCP completion route 추적. PE 게임 binary가 띄우는 비동기 socket op 의
// telemetry-only tracker.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 op tracker — 실 WSARecv() / WSASend() / OVERLAPPED 호출 X (cycle 후속).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = wsarecv
//   2 = wsasend
//   3 = wsaaccept
//   4 = wsaconnect
//
// completion_route code:
//   1 = callback   (LPWSAOVERLAPPED_COMPLETION_ROUTINE)
//   2 = event      (WSAEvent + WSAWaitForMultipleEvents)
//   3 = apc        (alertable wait + queued APC)
//   4 = iocp       (I/O Completion Port via GetQueuedCompletionStatus)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t bytes_transferred<int> \t completion_route<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwo_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_winsock_overlapped"
}

fn pwo_ops_path() -> str {
    return pwo_dir() + "/ops.tsv"
}

fn pwo_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwo_dir() + "'")
}

fn cleanup_pwo() -> void {
    pwo_ensure_dir()
    let _ = exec("rm -f '" + pwo_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pwo_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwo_append_row(path: str, row: str) -> void {
    pwo_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: Winsock async op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, bytes_transferred: int, completion_route: int) -> void {
    if op_id <= 0 {
        panic("pe_winsock_overlapped FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_winsock_overlapped FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 4 {
        panic("pe_winsock_overlapped FAIL [record_op] expected=op_kind<=4 got=" + to_string(op_kind))
    }
    if bytes_transferred < 0 {
        panic("pe_winsock_overlapped FAIL [record_op] expected=bytes_transferred>=0 got=" + to_string(bytes_transferred))
    }
    if completion_route < 1 {
        panic("pe_winsock_overlapped FAIL [record_op] expected=completion_route>=1 got=" + to_string(completion_route))
    }
    if completion_route > 4 {
        panic("pe_winsock_overlapped FAIL [record_op] expected=completion_route<=4 got=" + to_string(completion_route))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(bytes_transferred) + "\t" + to_string(completion_route) + "\n"
    pwo_append_row(pwo_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pwo_read_table(pwo_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_bytes: 모든 op bytes_transferred 합 ───
fn total_bytes() -> int {
    let t = pwo_read_table(pwo_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(op_kind: int) -> int {
    let t = pwo_read_table(pwo_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == op_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_completion_route: 특정 completion_route 의 op 수 ───
fn count_by_completion_route(completion_route: int) -> int {
    let t = pwo_read_table(pwo_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == completion_route {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_bytes: 특정 op_id 의 bytes_transferred (없으면 0) ───
fn op_bytes(op_id: int) -> int {
    let t = pwo_read_table(pwo_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pwo_stats: [op_count, total_bytes, count_kind_wsarecv, count_route_iocp] ───
fn pwo_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_bytes())
    out.push(count_by_op_kind(1))
    out.push(count_by_completion_route(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pwo-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pwo()

    // 2. record 6 ops across 4 op_kinds and 4 completion_routes (deterministic synthetic)
    record_op(750001, 1, 1024, 1)
    r0_emit("pe_winsock_overlapped_record",
        "\"op_id\":750001,\"op_kind\":1,\"bytes_transferred\":1024,\"completion_route\":1,\"target\":\"wsarecv_callback\"")

    record_op(750002, 2, 512, 2)
    r0_emit("pe_winsock_overlapped_record",
        "\"op_id\":750002,\"op_kind\":2,\"bytes_transferred\":512,\"completion_route\":2,\"target\":\"wsasend_event\"")

    record_op(750003, 1, 2048, 4)
    r0_emit("pe_winsock_overlapped_record",
        "\"op_id\":750003,\"op_kind\":1,\"bytes_transferred\":2048,\"completion_route\":4,\"target\":\"wsarecv_iocp\"")

    record_op(750004, 3, 0, 4)
    r0_emit("pe_winsock_overlapped_record",
        "\"op_id\":750004,\"op_kind\":3,\"bytes_transferred\":0,\"completion_route\":4,\"target\":\"wsaaccept_iocp\"")

    record_op(750005, 4, 0, 3)
    r0_emit("pe_winsock_overlapped_record",
        "\"op_id\":750005,\"op_kind\":4,\"bytes_transferred\":0,\"completion_route\":3,\"target\":\"wsaconnect_apc\"")

    record_op(750006, 2, 256, 4)
    r0_emit("pe_winsock_overlapped_record",
        "\"op_id\":750006,\"op_kind\":2,\"bytes_transferred\":256,\"completion_route\":4,\"target\":\"wsasend_iocp\"")

    // 3. op_count = 6
    let c = op_count()
    if c != 6 {
        panic("pe_winsock_overlapped FAIL [op_count] expected=6 got=" + to_string(c))
    }

    // 4. total_bytes = 1024+512+2048+0+0+256 = 3840
    let tb = total_bytes()
    if tb != 3840 {
        panic("pe_winsock_overlapped FAIL [total_bytes] expected=3840 got=" + to_string(tb))
    }

    // 5. count_by_op_kind sanity (≥3 distinct kinds: 1,2,3,4 all present)
    let k1 = count_by_op_kind(1)
    if k1 != 2 {
        panic("pe_winsock_overlapped FAIL [count_by_op_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 2 {
        panic("pe_winsock_overlapped FAIL [count_by_op_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_winsock_overlapped FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_op_kind(4)
    if k4 != 1 {
        panic("pe_winsock_overlapped FAIL [count_by_op_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_winsock_overlapped FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_completion_route sanity (≥3 distinct routes: 1,2,3,4 all present)
    let r1 = count_by_completion_route(1)
    if r1 != 1 {
        panic("pe_winsock_overlapped FAIL [count_by_completion_route(1)] expected=1 got=" + to_string(r1))
    }
    let r2 = count_by_completion_route(2)
    if r2 != 1 {
        panic("pe_winsock_overlapped FAIL [count_by_completion_route(2)] expected=1 got=" + to_string(r2))
    }
    let r3 = count_by_completion_route(3)
    if r3 != 1 {
        panic("pe_winsock_overlapped FAIL [count_by_completion_route(3)] expected=1 got=" + to_string(r3))
    }
    let r4 = count_by_completion_route(4)
    if r4 != 3 {
        panic("pe_winsock_overlapped FAIL [count_by_completion_route(4)] expected=3 got=" + to_string(r4))
    }
    let r99 = count_by_completion_route(99)
    if r99 != 0 {
        panic("pe_winsock_overlapped FAIL [count_by_completion_route(99)] expected=0 got=" + to_string(r99))
    }

    // 7. op_bytes sanity
    let b1 = op_bytes(750001)
    if b1 != 1024 {
        panic("pe_winsock_overlapped FAIL [op_bytes(750001)] expected=1024 got=" + to_string(b1))
    }
    let b3 = op_bytes(750003)
    if b3 != 2048 {
        panic("pe_winsock_overlapped FAIL [op_bytes(750003)] expected=2048 got=" + to_string(b3))
    }
    let b_miss = op_bytes(9999)
    if b_miss != 0 {
        panic("pe_winsock_overlapped FAIL [op_bytes(9999)] expected=0 got=" + to_string(b_miss))
    }

    // 8. pwo_stats() = [6, 3840, 2, 3]
    let s = pwo_stats()
    if len(s) != 4 {
        panic("pe_winsock_overlapped FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_winsock_overlapped FAIL [stats op_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 3840 {
        panic("pe_winsock_overlapped FAIL [stats total_bytes] expected=3840 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_winsock_overlapped FAIL [stats count_kind_wsarecv] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_winsock_overlapped FAIL [stats count_route_iocp] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_winsock_overlapped_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_bytes\":" + to_string(s[1])
        + ",\"count_kind_wsarecv\":" + to_string(s[2])
        + ",\"count_route_iocp\":" + to_string(s[3]))

    // 10. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_winsock_overlapped FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pwo()
    let s2 = pwo_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_winsock_overlapped FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_winsock_overlapped self_test PASS (ops=" + to_string(s[0])
        + ", bytes=" + to_string(s[1]) + ", wsarecv=" + to_string(s[2])
        + ", iocp=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pwo_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_bytes\t" + to_string(s[1]))
            println("count_kind_wsarecv\t" + to_string(s[2]))
            println("count_route_iocp\t" + to_string(s[3]))
            return
        }
        if sub == "bytes" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_bytes\t" + to_string(op_bytes(oid)))
                return
            }
            println("usage: hexa run pe_winsock_overlapped.hexa bytes <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let kind_or_route = a[3]
                let val = to_int(a[4])
                if kind_or_route == "op" {
                    println("count_by_op_kind\t" + to_string(count_by_op_kind(val)))
                    return
                }
                if kind_or_route == "route" {
                    println("count_by_completion_route\t" + to_string(count_by_completion_route(val)))
                    return
                }
            }
            println("usage: hexa run pe_winsock_overlapped.hexa count { op <op_kind> | route <completion_route> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pwo()
            println("cleaned: " + pwo_dir())
            return
        }
        if sub == "dir" {
            println(pwo_dir())
            return
        }
    }
    println("usage: hexa run pe_winsock_overlapped.hexa { self-test | stats | bytes <op_id> | count op <op_kind> | count route <completion_route> | cleanup | dir }")
}
