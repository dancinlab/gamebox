// lib/loader/pe_dyld_cache_warmup.hexa — cycle 67 dyld shared cache pre-warm metrics skeleton
//
// macOS dyld shared cache 를 사전 warm-up 하여 PE→Mach-O thunk loader 가
// 첫 dlopen 시점에 page fault storm 을 피하도록 — warmup 1 건 = library_count
// 만큼의 lib 를 touch + elapsed_us 측정 + page cache hit_count 카운터.
//
// own 1 enforcement: Wine / CrossOver / GPTK / Whisky / community 코드 0 줄.
//   본 module 은 warmup metric tracker — 실 dyld API 호출 X (stage6).
// own 2 mandate: r0_emit ≥ 5 + self_test() + main() dispatch + headless safe + panic 형식.
//
// persist schema (TSV — warmups.tsv):
//   warmup_id<int> \t library_count<int> \t elapsed_us<int> \t hit_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdcw_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dyld_cache_warmup"
}

fn pdcw_warmups_path() -> str {
    return pdcw_dir() + "/warmups.tsv"
}

fn pdcw_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdcw_dir() + "'")
}

fn cleanup_pdcw() -> void {
    pdcw_ensure_dir()
    let _ = exec("rm -f '" + pdcw_warmups_path() + "'")
}

// ─── 공통 file IO ───
fn pdcw_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdcw_append_row(path: str, row: str) -> void {
    pdcw_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_warmup: warmup 1 건 기록 ───
fn record_warmup(warmup_id: int, library_count: int, elapsed_us: int, hit_count: int) -> void {
    if warmup_id <= 0 {
        panic("pe_dyld_cache_warmup FAIL [record_warmup] expected=warmup_id>0 got=" + to_string(warmup_id))
    }
    if library_count < 0 {
        panic("pe_dyld_cache_warmup FAIL [record_warmup] expected=library_count>=0 got=" + to_string(library_count))
    }
    if elapsed_us < 0 {
        panic("pe_dyld_cache_warmup FAIL [record_warmup] expected=elapsed_us>=0 got=" + to_string(elapsed_us))
    }
    if hit_count < 0 {
        panic("pe_dyld_cache_warmup FAIL [record_warmup] expected=hit_count>=0 got=" + to_string(hit_count))
    }
    if hit_count > library_count {
        panic("pe_dyld_cache_warmup FAIL [record_warmup] expected=hit_count<=library_count got="
            + to_string(hit_count) + " (library_count=" + to_string(library_count) + ")")
    }
    let row = to_string(warmup_id) + "\t" + to_string(library_count)
        + "\t" + to_string(elapsed_us) + "\t" + to_string(hit_count) + "\n"
    pdcw_append_row(pdcw_warmups_path(), row)
}

// ─── warmup_count: total warmup 수 ───
fn warmup_count() -> int {
    let t = pdcw_read_table(pdcw_warmups_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_libraries: 모든 warmup library_count 합 ───
fn total_libraries() -> int {
    let t = pdcw_read_table(pdcw_warmups_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[1])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_elapsed_us: 모든 warmup elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let t = pdcw_read_table(pdcw_warmups_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_hits: 모든 warmup hit_count 합 ───
fn total_hits() -> int {
    let t = pdcw_read_table(pdcw_warmups_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── warmup_libraries: 특정 warmup_id 의 library_count (없으면 0) ───
fn warmup_libraries(warmup_id: int) -> int {
    let t = pdcw_read_table(pdcw_warmups_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == warmup_id {
                    return to_int(parts[1])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdcw_stats: [warmup_count, total_libraries, total_elapsed_us, total_hits] ───
fn pdcw_stats() -> array {
    let mut out = []
    out.push(warmup_count())
    out.push(total_libraries())
    out.push(total_elapsed_us())
    out.push(total_hits())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdcw-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdcw()

    // 2. record 4 warmups (varying library_count + hit_count, deterministic)
    record_warmup(670001, 32, 1500, 24)
    r0_emit("pe_dyld_cache_warmup_record",
        "\"warmup_id\":670001,\"library_count\":32,\"elapsed_us\":1500,\"hit_count\":24")

    record_warmup(670002, 64, 2800, 50)
    r0_emit("pe_dyld_cache_warmup_record",
        "\"warmup_id\":670002,\"library_count\":64,\"elapsed_us\":2800,\"hit_count\":50")

    record_warmup(670003, 128, 5200, 96)
    r0_emit("pe_dyld_cache_warmup_record",
        "\"warmup_id\":670003,\"library_count\":128,\"elapsed_us\":5200,\"hit_count\":96")

    record_warmup(670004, 16, 800, 12)
    r0_emit("pe_dyld_cache_warmup_record",
        "\"warmup_id\":670004,\"library_count\":16,\"elapsed_us\":800,\"hit_count\":12")

    // 3. warmup_count = 4
    let c = warmup_count()
    if c != 4 {
        panic("pe_dyld_cache_warmup FAIL [warmup_count] expected=4 got=" + to_string(c))
    }

    // 4. total_libraries = 32+64+128+16 = 240
    let tl = total_libraries()
    if tl != 240 {
        panic("pe_dyld_cache_warmup FAIL [total_libraries] expected=240 got=" + to_string(tl))
    }

    // 5. total_elapsed_us = 1500+2800+5200+800 = 10300
    let te = total_elapsed_us()
    if te != 10300 {
        panic("pe_dyld_cache_warmup FAIL [total_elapsed_us] expected=10300 got=" + to_string(te))
    }

    // 6. total_hits = 24+50+96+12 = 182
    let th = total_hits()
    if th != 182 {
        panic("pe_dyld_cache_warmup FAIL [total_hits] expected=182 got=" + to_string(th))
    }

    // 7. warmup_libraries sanity
    let l2 = warmup_libraries(670002)
    if l2 != 64 {
        panic("pe_dyld_cache_warmup FAIL [warmup_libraries(670002)] expected=64 got=" + to_string(l2))
    }
    let l3 = warmup_libraries(670003)
    if l3 != 128 {
        panic("pe_dyld_cache_warmup FAIL [warmup_libraries(670003)] expected=128 got=" + to_string(l3))
    }
    let l_miss = warmup_libraries(9999)
    if l_miss != 0 {
        panic("pe_dyld_cache_warmup FAIL [warmup_libraries(9999)] expected=0 got=" + to_string(l_miss))
    }

    // 8. pdcw_stats() = [4, 240, 10300, 182]
    let s = pdcw_stats()
    if len(s) != 4 {
        panic("pe_dyld_cache_warmup FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 4 {
        panic("pe_dyld_cache_warmup FAIL [stats warmup_count] expected=4 got=" + to_string(s[0]))
    }
    if s[1] != 240 {
        panic("pe_dyld_cache_warmup FAIL [stats total_libraries] expected=240 got=" + to_string(s[1]))
    }
    if s[2] != 10300 {
        panic("pe_dyld_cache_warmup FAIL [stats total_elapsed_us] expected=10300 got=" + to_string(s[2]))
    }
    if s[3] != 182 {
        panic("pe_dyld_cache_warmup FAIL [stats total_hits] expected=182 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_dyld_cache_warmup_stats",
        "\"warmup_count\":" + to_string(s[0])
        + ",\"total_libraries\":" + to_string(s[1])
        + ",\"total_elapsed_us\":" + to_string(s[2])
        + ",\"total_hits\":" + to_string(s[3]))

    // 10. emit count >= 5 (4 records + 1 stats = 5)
    let emit_n = r0_session_count(sid)
    if emit_n < 5 {
        panic("pe_dyld_cache_warmup FAIL [r0 emit count] expected=>=5 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdcw()
    let s2 = pdcw_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dyld_cache_warmup FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dyld_cache_warmup self_test PASS (warmups=" + to_string(s[0])
        + ", libs=" + to_string(s[1]) + ", elapsed_us=" + to_string(s[2])
        + ", hits=" + to_string(s[3]) + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdcw_stats()
            println("warmup_count\t" + to_string(s[0]))
            println("total_libraries\t" + to_string(s[1]))
            println("total_elapsed_us\t" + to_string(s[2]))
            println("total_hits\t" + to_string(s[3]))
            return
        }
        if sub == "libs" {
            if len(a) >= 4 {
                let wid = to_int(a[3])
                println("warmup_libraries\t" + to_string(warmup_libraries(wid)))
                return
            }
            println("usage: hexa run pe_dyld_cache_warmup.hexa libs <warmup_id>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdcw()
            println("cleaned: " + pdcw_dir())
            return
        }
        if sub == "dir" {
            println(pdcw_dir())
            return
        }
    }
    println("usage: hexa run pe_dyld_cache_warmup.hexa { self-test | stats | libs <warmup_id> | cleanup | dir }")
}
