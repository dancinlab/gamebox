// ─── record_string_op_event: strlen/strcpy/strcmp/sprintf row ───
fn record_string_op_event(evt_id: int, str_kind: str, src_synth: str, result_synth: str, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_msvcrt_core FAIL [record_string_op_event] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if str_kind == "" {
        panic("pe_msvcrt_core FAIL [record_string_op_event] expected=str_kind!=empty got=empty")
    }
    if src_synth == "" {
        panic("pe_msvcrt_core FAIL [record_string_op_event] expected=src_synth!=empty got=empty")
    }
    if result_synth == "" {
        panic("pe_msvcrt_core FAIL [record_string_op_event] expected=result_synth!=empty got=empty")
    }
    if status == "" {
        panic("pe_msvcrt_core FAIL [record_string_op_event] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + str_kind + "\t" + src_synth + "\t"
        + result_synth + "\t" + status + "\n"
    pmsv_append_row(pmsv_string_op_event_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pmsv_count_rows(pmsv_syscall_invoke_path(), 4)
}

fn file_io_round_trip_count() -> int {
    return pmsv_count_rows(pmsv_file_io_round_trip_path(), 5)
}

fn memory_lifecycle_count() -> int {
    return pmsv_count_rows(pmsv_memory_lifecycle_path(), 5)
}

fn string_op_event_count() -> int {
    return pmsv_count_rows(pmsv_string_op_event_path(), 5)
}

fn pmsv_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(file_io_round_trip_count())
    out.push(memory_lifecycle_count())
    out.push(string_op_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pmsv-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pmsv()

    // ─── 1. syscall_invoke × 12 (one per fn, 3 group coverage) ───
    //   FILE_IO group (5)
    record_syscall_invoke(1, 0, "fopen", "PARTIAL")
    println("__MSVCRT__ PARTIAL fopen")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"fopen\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\save.d2s\",\"mode_synth\":\"rb\",\"file_ptr_hex\":\"0x90010100\",\"fd_synth\":4")
    record_syscall_invoke(2, 1, "fread", "PARTIAL")
    println("__MSVCRT__ PARTIAL fread")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"fread\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"file_ptr_hex\":\"0x90010100\",\"buf_hex\":\"0x90020000\",\"size_t_synth\":64,\"nmemb_synth\":1,\"return_synth\":1")
    record_syscall_invoke(3, 2, "fwrite", "PARTIAL")
    println("__MSVCRT__ PARTIAL fwrite")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"fwrite\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"file_ptr_hex\":\"0x90010100\",\"buf_hex\":\"0x90020000\",\"size_t_synth\":64,\"nmemb_synth\":1,\"return_synth\":1")
    record_syscall_invoke(4, 3, "fclose", "PARTIAL")
    println("__MSVCRT__ PARTIAL fclose")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"fclose\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"file_ptr_hex\":\"0x90010100\",\"return_synth\":0")
    record_syscall_invoke(5, 4, "fprintf", "PARTIAL")
    println("__MSVCRT__ PARTIAL fprintf")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"fprintf\",\"fn_group\":\"file_io\",\"status\":\"PARTIAL\",\"file_ptr_hex\":\"0x90010100\",\"format_synth\":\"%s_%d\\n\",\"args_synth\":\"D2R,123\",\"return_synth\":8")

    //   MEMORY group (3)
    record_syscall_invoke(6, 5, "malloc", "PARTIAL")
    println("__MSVCRT__ PARTIAL malloc")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"malloc\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"size_t_synth\":64,\"addr_hex\":\"0x90100000\"")
    record_syscall_invoke(7, 6, "free", "PARTIAL")
    println("__MSVCRT__ PARTIAL free")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"free\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"addr_hex\":\"0x90100000\"")
    record_syscall_invoke(8, 7, "realloc", "PARTIAL")
    println("__MSVCRT__ PARTIAL realloc")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"realloc\",\"fn_group\":\"memory\",\"status\":\"PARTIAL\",\"addr_in_hex\":\"0x90100000\",\"size_t_synth\":128,\"addr_out_hex\":\"0x90100400\"")

    //   STRING group (4)
    record_syscall_invoke(9, 8, "strlen", "PARTIAL")
    println("__MSVCRT__ PARTIAL strlen")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"strlen\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"src_synth\":\"D2R\",\"return_synth\":3")
    record_syscall_invoke(10, 9, "strcpy", "PARTIAL")
    println("__MSVCRT__ PARTIAL strcpy")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"strcpy\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"src_synth\":\"D2R\",\"dst_hex\":\"0x90020100\",\"return_hex\":\"0x90020100\"")
    record_syscall_invoke(11, 10, "strcmp", "PARTIAL")
    println("__MSVCRT__ PARTIAL strcmp")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"strcmp\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"left_synth\":\"abc\",\"right_synth\":\"abd\",\"return_synth\":-1")
    record_syscall_invoke(12, 11, "sprintf", "PARTIAL")
    println("__MSVCRT__ PARTIAL sprintf")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"sprintf\",\"fn_group\":\"string\",\"status\":\"PARTIAL\",\"format_synth\":\"%s_%d\",\"args_synth\":\"D2R,123\",\"dst_hex\":\"0x90020200\",\"return_synth\":7,\"output_synth\":\"D2R_123\"")

    // ─── 2. file_io_round_trip × 4 (open/read/write/close cycle) ───
    record_file_io_round_trip(1, "fopen_rb", "0x90010100", 0, "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"file_io_round_trip\",\"evt_id\":1,\"io_kind\":\"fopen_rb\",\"file_ptr_hex\":\"0x90010100\",\"path_synth\":\"C:\\\\Users\\\\D2R\\\\save.d2s\",\"mode_synth\":\"rb\",\"fd_synth\":4,\"flags\":\"0x00000001\",\"status\":\"PARTIAL\"")
    record_file_io_round_trip(2, "fread_64b", "0x90010100", 64, "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"file_io_round_trip\",\"evt_id\":2,\"io_kind\":\"fread_64b\",\"file_ptr_hex\":\"0x90010100\",\"buf_hex\":\"0x90020000\",\"byte_count\":64,\"size_t_le\":\"4000000000000000\",\"return_synth\":1,\"status\":\"PARTIAL\"")
    record_file_io_round_trip(3, "fwrite_64b", "0x90010100", 64, "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"file_io_round_trip\",\"evt_id\":3,\"io_kind\":\"fwrite_64b\",\"file_ptr_hex\":\"0x90010100\",\"buf_hex\":\"0x90020000\",\"byte_count\":64,\"size_t_le\":\"4000000000000000\",\"return_synth\":1,\"status\":\"PARTIAL\"")
    record_file_io_round_trip(4, "fclose", "0x90010100", 0, "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"file_io_round_trip\",\"evt_id\":4,\"io_kind\":\"fclose\",\"file_ptr_hex\":\"0x90010100\",\"byte_count\":0,\"return_synth\":0,\"status\":\"PARTIAL\"")

    // ─── 3. memory_lifecycle × 3 (malloc → realloc → free) ───
    record_memory_lifecycle(1, "malloc_64b", "0x90100000", 64, "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"memory_lifecycle\",\"evt_id\":1,\"mem_kind\":\"malloc_64b\",\"addr_hex\":\"0x90100000\",\"size_bytes\":64,\"size_t_le\":\"4000000000000000\",\"status\":\"PARTIAL\"")
    record_memory_lifecycle(2, "realloc_128b", "0x90100400", 128, "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"memory_lifecycle\",\"evt_id\":2,\"mem_kind\":\"realloc_128b\",\"addr_in_hex\":\"0x90100000\",\"addr_hex\":\"0x90100400\",\"size_bytes\":128,\"size_t_le\":\"8000000000000000\",\"status\":\"PARTIAL\"")
    record_memory_lifecycle(3, "free", "0x90100400", 0, "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"memory_lifecycle\",\"evt_id\":3,\"mem_kind\":\"free\",\"addr_hex\":\"0x90100400\",\"size_bytes\":0,\"status\":\"PARTIAL\"")

    // ─── 4. string_op_event × 4 (strlen/strcpy/strcmp/sprintf) ───
    record_string_op_event(1, "strlen", "D2R", "3", "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"string_op_event\",\"evt_id\":1,\"str_kind\":\"strlen\",\"src_synth\":\"D2R\",\"result_synth\":\"3\",\"size_t_le\":\"0300000000000000\",\"status\":\"PARTIAL\"")
    record_string_op_event(2, "strcpy", "D2R", "0x90020100", "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"string_op_event\",\"evt_id\":2,\"str_kind\":\"strcpy\",\"src_synth\":\"D2R\",\"dst_hex\":\"0x90020100\",\"result_synth\":\"0x90020100\",\"status\":\"PARTIAL\"")
    record_string_op_event(3, "strcmp", "abc_vs_abd", "-1", "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"string_op_event\",\"evt_id\":3,\"str_kind\":\"strcmp\",\"left_synth\":\"abc\",\"right_synth\":\"abd\",\"src_synth\":\"abc_vs_abd\",\"result_synth\":\"-1\",\"int_le\":\"FFFFFFFF\",\"status\":\"PARTIAL\"")
    record_string_op_event(4, "sprintf", "%s_%d|D2R,123", "D2R_123", "PARTIAL")
    r0_emit("pe_msvcrt_core_record", "\"kind\":\"string_op_event\",\"evt_id\":4,\"str_kind\":\"sprintf\",\"format_synth\":\"%s_%d\",\"args_synth\":\"D2R,123\",\"src_synth\":\"%s_%d|D2R,123\",\"result_synth\":\"D2R_123\",\"length\":7,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 12 {
        panic("pe_msvcrt_core FAIL [syscall_invoke_count] expected=12 got=" + to_string(si))
    }
    let fio = file_io_round_trip_count()
    if fio != 4 {
        panic("pe_msvcrt_core FAIL [file_io_round_trip_count] expected=4 got=" + to_string(fio))
    }
    let mem = memory_lifecycle_count()
    if mem != 3 {
        panic("pe_msvcrt_core FAIL [memory_lifecycle_count] expected=3 got=" + to_string(mem))
    }
    let stro = string_op_event_count()
    if stro != 4 {
        panic("pe_msvcrt_core FAIL [string_op_event_count] expected=4 got=" + to_string(stro))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "fopen" { panic("pe_msvcrt_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(4) != "fprintf" { panic("pe_msvcrt_core FAIL [fn_kind_name(4)]") }
    if fn_kind_name(5) != "malloc" { panic("pe_msvcrt_core FAIL [fn_kind_name(5)]") }
    if fn_kind_name(7) != "realloc" { panic("pe_msvcrt_core FAIL [fn_kind_name(7)]") }
    if fn_kind_name(8) != "strlen" { panic("pe_msvcrt_core FAIL [fn_kind_name(8)]") }
    if fn_kind_name(11) != "sprintf" { panic("pe_msvcrt_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_msvcrt_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "file_io" { panic("pe_msvcrt_core FAIL [fn_group_name(0)]") }
    if fn_group_name(5) != "memory" { panic("pe_msvcrt_core FAIL [fn_group_name(5)]") }
    if fn_group_name(8) != "string" { panic("pe_msvcrt_core FAIL [fn_group_name(8)]") }
    if fn_group_name(99) != "unknown" { panic("pe_msvcrt_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pmsv_stats()
    if len(s) != 4 { panic("pe_msvcrt_core FAIL [stats len] expected=4 got=" + to_string(len(s))) }
    if s[0] != 12 { panic("pe_msvcrt_core FAIL [stats syscall_invoke_count] expected=12 got=" + to_string(s[0])) }
    if s[1] != 4 { panic("pe_msvcrt_core FAIL [stats file_io_round_trip_count] expected=4 got=" + to_string(s[1])) }
    if s[2] != 3 { panic("pe_msvcrt_core FAIL [stats memory_lifecycle_count] expected=3 got=" + to_string(s[2])) }
    if s[3] != 4 { panic("pe_msvcrt_core FAIL [stats string_op_event_count] expected=4 got=" + to_string(s[3])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_msvcrt_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"file_io_round_trip_count\":" + to_string(s[1])
        + ",\"memory_lifecycle_count\":" + to_string(s[2])
        + ",\"string_op_event_count\":" + to_string(s[3]))

    r0_emit("pe_msvcrt_core_summary",
        "\"target\":\"MSVCRT.dll\",\"fn_total\":12,\"fn_emit_partial\":12,\"groups\":[\"file_io\",\"memory\",\"string\"],\"file_struct_synth_bytes\":8,\"size_t_synth_bytes\":8,\"heap_addr_family\":[\"0x90100000\",\"0x90100400\"],\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_msvcrt_core_kpi",
        "\"file_io_emits\":5,\"memory_emits\":3,\"string_emits\":4,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"crt_dependency_unblock_partial\":true")

    // ─── cycle 35 → 36 MSVCRT coverage progression evidence emit ───
    r0_emit("pe_msvcrt_core_coverage_progression",
        "\"surface\":\"MSVCRT_full_435_fn\",\"cycle_35_count\":132,\"cycle_36_count\":144,\"delta\":12,\"cycle_35_percent\":30.34,\"cycle_36_percent\":33.10,\"cycle_36_module\":\"pe_msvcrt_core.hexa\",\"long_horizon_cycles_remaining\":\"many (full ~435 fn = multi-cycle)\",\"track_ah1_cycle_increment\":12")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_msvcrt_core_round_trip_matrix",
        "\"surface\":\"MSVCRT_core_12_fn\",\"fn_partial\":12,\"fn_groups\":3,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real fopen + malloc + strlen = libSystem fopen(3)/malloc(3)/strlen(3) bridge pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\",\"crt_dependency\":\"C runtime baseline prerequisite for PE entry + nearly_every_PE_binary\"")

    // ─── Track AH1 expansion emit (cycle 36, MSVCRT +12 fn) ───
    r0_emit("pe_msvcrt_core_ah1_expansion",
        "\"track\":\"AH1\",\"cycle\":36,\"surface\":\"MSVCRT_new\",\"new_fn\":12,\"groups\":[\"file_io\",\"memory\",\"string\"],\"file_io_count\":5,\"memory_count\":3,\"string_count\":4,\"emit_format\":\"__MSVCRT__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_ah_bundled_part_1_of_4\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_msvcrt_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pmsv()
    let s2 = pmsv_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_msvcrt_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_msvcrt_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", file_io_round_trip=" + to_string(s[1])
        + ", memory_lifecycle=" + to_string(s[2]) + ", string_op_event=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pmsv_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("file_io_round_trip_count\t" + to_string(s[1]))
            println("memory_lifecycle_count\t" + to_string(s[2]))
            println("string_op_event_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_msvcrt_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_msvcrt_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pmsv()
            println("cleaned: " + pmsv_dir())
            return
        }
        if sub == "dir" {
            println(pmsv_dir())
            return
        }
    }
    println("usage: hexa run pe_msvcrt_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
