// lib/loader/pe_msvcrt_core.hexa — MSVCRT.dll C runtime surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. ReactOS /
//       Wine msvcrt source 측 코드 인용 0. msvcrt.dll 직접 binding 0. macOS libSystem
//       fopen(3) / malloc(3) / strlen(3) 직접 binding 0. stdio.h / stdlib.h / string.h
//       reference shape 만 (FILE* / size_t / int return value). 실 fopen / 실 fread /
//       실 malloc / 실 strlen / 실 sprintf = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — full coverage 측 multi-cycle long-horizon, production smoke pending.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L/O/Q/W/AH parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track AH1 — MSVCRT (msvcrt.dll) C runtime surface coverage 12 fn (skeleton row 만).
// Track W4 predecessor (OLEAUT32 11 fn cycle 35) 후 본 Track AH1 는 MSVCRT 측 file_io +
// memory + string baseline land. cycle 35 측 132/435 (~30.34%) → cycle 36 측 ~144/435
// (~33.10%) coverage progression (+12 fn 신규, Track AH bundled cycle 36-39 측 AH1 row,
// 첫 row).
//
// 대상 fn (12 fn — 3 group, fn_kind 0..11 canonical map):
//   FILE_IO (5):    fopen(0) / fread(1) / fwrite(2) / fclose(3) / fprintf(4)
//   MEMORY  (3):    malloc(5) / free(6) / realloc(7)
//   STRING  (4):    strlen(8) / strcpy(9) / strcmp(10) / sprintf(11)
//
// synthetic FILE* (8 byte = pointer-to-fake-FILE_struct at 0x90010100, fd_synth 4):
//   fd 4 (4 byte LE 0x04000000), flags 0x00000001 (R/W), buf_ptr 0x90020000, eof 0.
// synthetic size_t (8 byte ULongLong LE) round-trip: 0x40 (64 byte read) / 0x100 (256 byte buffer).
// synthetic heap addr family: malloc 0x90100000 (64 byte block) / realloc 0x90100400 (128 byte expand).
// synthetic strlen result (size_t LE): "D2R" → 3, "airgenome-gamebox" → 17.
// synthetic strcmp result (int LE): "abc" vs "abc" = 0, "abc" vs "abd" = -1, "abd" vs "abc" = +1.
// synthetic sprintf format target: "%s_%d" with args ("D2R", 123) → "D2R_123" (7 byte + \0).
//
// persist schema (TSV — 4 table): syscall_invoke / file_io_round_trip / memory_lifecycle / string_op_event.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pmsv_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_msvcrt_core"
}

fn pmsv_syscall_invoke_path() -> str {
    return pmsv_dir() + "/syscall_invoke.tsv"
}

fn pmsv_file_io_round_trip_path() -> str {
    return pmsv_dir() + "/file_io_round_trip.tsv"
}

fn pmsv_memory_lifecycle_path() -> str {
    return pmsv_dir() + "/memory_lifecycle.tsv"
}

fn pmsv_string_op_event_path() -> str {
    return pmsv_dir() + "/string_op_event.tsv"
}

fn pmsv_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pmsv_dir() + "'")
}

fn cleanup_pmsv() -> void {
    pmsv_ensure_dir()
    let _ = exec("rm -f '" + pmsv_syscall_invoke_path() + "' '" + pmsv_file_io_round_trip_path()
        + "' '" + pmsv_memory_lifecycle_path() + "' '" + pmsv_string_op_event_path() + "'")
}

// ─── 공통 file IO ───
fn pmsv_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pmsv_append_row(path: str, row: str) -> void {
    pmsv_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pmsv_count_rows(path: str, min_cols: int) -> int {
    let t = pmsv_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "fopen" }
    if k == 1 { return "fread" }
    if k == 2 { return "fwrite" }
    if k == 3 { return "fclose" }
    if k == 4 { return "fprintf" }
    if k == 5 { return "malloc" }
    if k == 6 { return "free" }
    if k == 7 { return "realloc" }
    if k == 8 { return "strlen" }
    if k == 9 { return "strcpy" }
    if k == 10 { return "strcmp" }
    if k == 11 { return "sprintf" }
    return "unknown"
}

// ─── helper: fn_group_name (3 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 4 {
            return "file_io"
        }
    }
    if k >= 5 {
        if k <= 7 {
            return "memory"
        }
    }
    if k >= 8 {
        if k <= 11 {
            return "string"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: MSVCRT fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_msvcrt_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_msvcrt_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_msvcrt_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_msvcrt_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_msvcrt_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pmsv_append_row(pmsv_syscall_invoke_path(), row)
}

// ─── record_file_io_round_trip: fopen/fread/fwrite/fclose/fprintf round-trip row ───
fn record_file_io_round_trip(evt_id: int, io_kind: str, file_ptr_hex: str, byte_count: int, status: str) -> void {
    if evt_id <= 0 {
        panic("pe_msvcrt_core FAIL [record_file_io_round_trip] expected=evt_id>0 got=" + to_string(evt_id))
    }
    if io_kind == "" {
        panic("pe_msvcrt_core FAIL [record_file_io_round_trip] expected=io_kind!=empty got=empty")
    }
    if file_ptr_hex == "" {
        panic("pe_msvcrt_core FAIL [record_file_io_round_trip] expected=file_ptr_hex!=empty got=empty")
    }
    if byte_count < 0 {
        panic("pe_msvcrt_core FAIL [record_file_io_round_trip] expected=byte_count>=0 got=" + to_string(byte_count))
    }
    if status == "" {
        panic("pe_msvcrt_core FAIL [record_file_io_round_trip] expected=status!=empty got=empty")
    }
    let row = to_string(evt_id) + "\t" + io_kind + "\t" + file_ptr_hex + "\t"
        + to_string(byte_count) + "\t" + status + "\n"
    pmsv_append_row(pmsv_file_io_round_trip_path(), row)
}

// ─── record_memory_lifecycle: malloc/free/realloc lifecycle row ───
fn record_memory_lifecycle(evt_id: int, mem_kind: str, addr_hex: str, size_bytes: int, status: str) -> void {
    if evt_id <= 0 {
