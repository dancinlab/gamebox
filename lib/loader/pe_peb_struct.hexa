// lib/loader/pe_peb_struct.hexa — cycle 69 PEB layout telemetry skeleton
//
// Process Environment Block (PEB) — Windows NT loader-side per-process struct.
// Reachable via TEB->ProcessEnvironmentBlock (TEB[0x60] on x64, TEB[0x30] on
// x86). Tracks loader-related field reads — Ldr / ProcessParameters /
// ImageBaseAddress / NumberOfProcessors / BeingDebugged.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 PEB field access tracker — 실제 PEB struct walk 은 stage6.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// field_kind code:
//   1 = Ldr                    (PEB_LDR_DATA*)
//   2 = ProcessParameters      (RTL_USER_PROCESS_PARAMETERS*)
//   3 = ImageBaseAddress
//   4 = NumberOfProcessors
//   5 = BeingDebugged
//
// persist schema (TSV — accesses.tsv):
//   access_id<int> \t field_kind<int> \t offset<int> \t process_id<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn peb_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_peb_struct"
}

fn peb_accesses_path() -> str {
    return peb_dir() + "/accesses.tsv"
}

fn peb_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + peb_dir() + "'")
}

fn cleanup_peb() -> void {
    peb_ensure_dir()
    let _ = exec("rm -f '" + peb_accesses_path() + "'")
}

// ─── 공통 file IO ───
fn peb_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn peb_append_row(path: str, row: str) -> void {
    peb_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_access: PEB field access 1 건 기록 ───
fn record_access(access_id: int, field_kind: int, offset: int, process_id: int) -> void {
    if access_id <= 0 {
        panic("pe_peb_struct FAIL [record_access] expected=access_id>0 got=" + to_string(access_id))
    }
    if field_kind < 1 {
        panic("pe_peb_struct FAIL [record_access] expected=field_kind>=1 got=" + to_string(field_kind))
    }
    if field_kind > 5 {
        panic("pe_peb_struct FAIL [record_access] expected=field_kind<=5 got=" + to_string(field_kind))
    }
    if offset < 0 {
        panic("pe_peb_struct FAIL [record_access] expected=offset>=0 got=" + to_string(offset))
    }
    if process_id <= 0 {
        panic("pe_peb_struct FAIL [record_access] expected=process_id>0 got=" + to_string(process_id))
    }
    let row = to_string(access_id) + "\t" + to_string(field_kind)
        + "\t" + to_string(offset) + "\t" + to_string(process_id) + "\n"
    peb_append_row(peb_accesses_path(), row)
}

// ─── access_count: total access 수 ───
fn access_count() -> int {
    let t = peb_read_table(peb_accesses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_field: 특정 field_kind 의 access 수 ───
fn count_by_field(kind: int) -> int {
    let t = peb_read_table(peb_accesses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_processes: 등장한 process_id 의 종류 수 ───
fn distinct_processes() -> int {
    let t = peb_read_table(peb_accesses_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let mut seen = []
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let pid = to_int(parts[3])
                let mut found = false
                let j = 0
                while j < len(seen) {
                    if seen[j] == pid {
                        found = true
                    }
                    j = j + 1
                }
                if found == false {
                    seen.push(pid)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── count_being_debugged: field_kind == 5 인 access 수 ───
fn count_being_debugged() -> int {
    return count_by_field(5)
}

// ─── access_offset: 특정 access_id 의 offset (없으면 -1) ───
fn access_offset(access_id: int) -> int {
    let t = peb_read_table(peb_accesses_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == access_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── peb_stats: [access_count, distinct_processes, count_being_debugged, count_by_field(1)] ───
fn peb_stats() -> array {
    let mut out = []
    out.push(access_count())
    out.push(distinct_processes())
    out.push(count_being_debugged())
    out.push(count_by_field(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "peb-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_peb()

    // 2. record 5 accesses across ≥4 fields (1=Ldr, 2=ProcessParameters,
    //    3=ImageBaseAddress, 5=BeingDebugged), 2 distinct PIDs
    record_access(690001, 1, 24, 4321)
    r0_emit("pe_peb_struct_record",
        "\"access_id\":690001,\"field_kind\":1,\"offset\":24,\"process_id\":4321,\"target\":\"Ldr\"")

    record_access(690002, 2, 32, 4321)
    r0_emit("pe_peb_struct_record",
        "\"access_id\":690002,\"field_kind\":2,\"offset\":32,\"process_id\":4321,\"target\":\"ProcessParameters\"")

    record_access(690003, 3, 16, 4321)
    r0_emit("pe_peb_struct_record",
        "\"access_id\":690003,\"field_kind\":3,\"offset\":16,\"process_id\":4321,\"target\":\"ImageBaseAddress\"")

    record_access(690004, 5, 2, 4321)
    r0_emit("pe_peb_struct_record",
        "\"access_id\":690004,\"field_kind\":5,\"offset\":2,\"process_id\":4321,\"target\":\"BeingDebugged\"")

    record_access(690005, 1, 24, 8765)
    r0_emit("pe_peb_struct_record",
        "\"access_id\":690005,\"field_kind\":1,\"offset\":24,\"process_id\":8765,\"target\":\"Ldr\"")

    // 3. access_count = 5
    let c = access_count()
    if c != 5 {
        panic("pe_peb_struct FAIL [access_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_field sanity (1=Ldr×2, 2=PP×1, 3=IBA×1, 4=NP×0, 5=BD×1)
    let k1 = count_by_field(1)
    if k1 != 2 {
        panic("pe_peb_struct FAIL [count_by_field(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_field(2)
    if k2 != 1 {
        panic("pe_peb_struct FAIL [count_by_field(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_field(3)
    if k3 != 1 {
        panic("pe_peb_struct FAIL [count_by_field(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_field(4)
    if k4 != 0 {
        panic("pe_peb_struct FAIL [count_by_field(4)] expected=0 got=" + to_string(k4))
    }
    let k5 = count_by_field(5)
    if k5 != 1 {
        panic("pe_peb_struct FAIL [count_by_field(5)] expected=1 got=" + to_string(k5))
    }

    // 5. distinct_processes = 2 (4321, 8765)
    let dp = distinct_processes()
    if dp != 2 {
        panic("pe_peb_struct FAIL [distinct_processes] expected=2 got=" + to_string(dp))
    }

    // 6. count_being_debugged = 1
    let cbd = count_being_debugged()
    if cbd != 1 {
        panic("pe_peb_struct FAIL [count_being_debugged] expected=1 got=" + to_string(cbd))
    }

    // 7. access_offset sanity
    let o2 = access_offset(690002)
    if o2 != 32 {
        panic("pe_peb_struct FAIL [access_offset(690002)] expected=32 got=" + to_string(o2))
    }
    let o4 = access_offset(690004)
    if o4 != 2 {
        panic("pe_peb_struct FAIL [access_offset(690004)] expected=2 got=" + to_string(o4))
    }
    let o_miss = access_offset(9999999)
    if o_miss != -1 {
        panic("pe_peb_struct FAIL [access_offset(9999999)] expected=-1 got=" + to_string(o_miss))
    }

    // 8. peb_stats() = [5, 2, 1, 2]
    let s = peb_stats()
    if len(s) != 4 {
        panic("pe_peb_struct FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_peb_struct FAIL [stats access_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_peb_struct FAIL [stats distinct_processes] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 1 {
        panic("pe_peb_struct FAIL [stats count_being_debugged] expected=1 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_peb_struct FAIL [stats count_field_ldr] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_peb_struct_stats",
        "\"access_count\":" + to_string(s[0])
        + ",\"distinct_processes\":" + to_string(s[1])
        + ",\"count_being_debugged\":" + to_string(s[2])
        + ",\"count_field_ldr\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_peb_struct FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_peb()
    let s2 = peb_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_peb_struct FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_peb_struct self_test PASS (accesses=" + to_string(s[0])
        + ", procs=" + to_string(s[1]) + ", debugged=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = peb_stats()
            println("access_count\t" + to_string(s[0]))
            println("distinct_processes\t" + to_string(s[1]))
            println("count_being_debugged\t" + to_string(s[2]))
            println("count_field_ldr\t" + to_string(s[3]))
            return
        }
        if sub == "offset" {
            if len(a) >= 4 {
                let aid = to_int(a[3])
                println("access_offset\t" + to_string(access_offset(aid)))
                return
            }
            println("usage: hexa run pe_peb_struct.hexa offset <access_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let arg = a[3]
                if arg == "debugged" {
                    println("count_being_debugged\t" + to_string(count_being_debugged()))
                    return
                }
                let kind = to_int(arg)
                println("count_by_field\t" + to_string(count_by_field(kind)))
                return
            }
            println("usage: hexa run pe_peb_struct.hexa count <field_kind|debugged>")
            return
        }
        if sub == "cleanup" {
            cleanup_peb()
            println("cleaned: " + peb_dir())
            return
        }
        if sub == "dir" {
            println(peb_dir())
            return
        }
    }
    println("usage: hexa run pe_peb_struct.hexa { self-test | stats | offset <access_id> | count <field_kind|debugged> | cleanup | dir }")
}
