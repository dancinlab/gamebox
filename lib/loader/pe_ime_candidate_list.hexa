// lib/loader/pe_ime_candidate_list.hexa — Win32 IME ImmGetCandidateList telemetry
//
// cycle 79 — IME 후보 리스트 (composition 중 character selection 대상). 한자/한글
// IME 가 phrase / alphabetic / stroke / phonetic / radical 등의 list_kind 로
// 후보를 띄우면 user 가 selected_index 로 1 개를 고른다. 본 module 은 query 1 건당
// list_kind, candidate_count, selected_index 를 record 하는 telemetry tracker.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 query tracker — 실제 ImmGetCandidateList() 호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// list_kind code:
//   1 = phrase
//   2 = alphabetic
//   3 = stroke
//   4 = phonetic
//   5 = radical
//
// persist schema (TSV — queries.tsv):
//   query_id<int> \t list_kind<int> \t candidate_count<int> \t selected_index<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn picl_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_ime_candidate_list"
}

fn picl_queries_path() -> str {
    return picl_dir() + "/queries.tsv"
}

fn picl_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + picl_dir() + "'")
}

fn cleanup_picl() -> void {
    picl_ensure_dir()
    let _ = exec("rm -f '" + picl_queries_path() + "'")
}

// ─── 공통 file IO ───
fn picl_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn picl_append_row(path: str, row: str) -> void {
    picl_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_query: IME query 1 건 기록 ───
fn record_query(query_id: int, list_kind: int, candidate_count: int, selected_index: int) -> void {
    if query_id <= 0 {
        panic("pe_ime_candidate_list FAIL [record_query] expected=query_id>0 got=" + to_string(query_id))
    }
    if list_kind < 1 {
        panic("pe_ime_candidate_list FAIL [record_query] expected=list_kind>=1 got=" + to_string(list_kind))
    }
    if list_kind > 5 {
        panic("pe_ime_candidate_list FAIL [record_query] expected=list_kind<=5 got=" + to_string(list_kind))
    }
    if candidate_count < 0 {
        panic("pe_ime_candidate_list FAIL [record_query] expected=candidate_count>=0 got=" + to_string(candidate_count))
    }
    if selected_index < -1 {
        panic("pe_ime_candidate_list FAIL [record_query] expected=selected_index>=-1 got=" + to_string(selected_index))
    }
    if selected_index >= candidate_count {
        if selected_index != -1 {
            panic("pe_ime_candidate_list FAIL [record_query] expected=selected_index<candidate_count got=" + to_string(selected_index))
        }
    }
    let row = to_string(query_id) + "\t" + to_string(list_kind)
        + "\t" + to_string(candidate_count) + "\t" + to_string(selected_index) + "\n"
    picl_append_row(picl_queries_path(), row)
}

// ─── query_count: total query 수 ───
fn query_count() -> int {
    let t = picl_read_table(picl_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_candidates: 모든 query 의 candidate_count 합 ───
fn total_candidates() -> int {
    let t = picl_read_table(picl_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_list_kind: 특정 list_kind 의 query 수 ───
fn count_by_list_kind(list_kind: int) -> int {
    let t = picl_read_table(picl_queries_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == list_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── query_selected_index: 특정 query_id 의 selected_index (없으면 -1) ───
fn query_selected_index(query_id: int) -> int {
    let t = picl_read_table(picl_queries_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == query_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── picl_stats: [query_count, total_candidates, count_by_list_kind(1), count_by_list_kind(4)] ───
fn picl_stats() -> array {
    let mut out = []
    out.push(query_count())
    out.push(total_candidates())
    out.push(count_by_list_kind(1))
    out.push(count_by_list_kind(4))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "picl-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_picl()

    // 2. record 5 queries across 3 list_kinds (phrase, stroke, phonetic)
    record_query(170001, 1, 9, 0)
    r0_emit("pe_ime_candidate_list_record",
        "\"query_id\":170001,\"list_kind\":1,\"candidate_count\":9,\"selected_index\":0,\"target\":\"phrase\"")

    record_query(170002, 1, 12, 3)
    r0_emit("pe_ime_candidate_list_record",
        "\"query_id\":170002,\"list_kind\":1,\"candidate_count\":12,\"selected_index\":3,\"target\":\"phrase\"")

    record_query(170003, 3, 6, 1)
    r0_emit("pe_ime_candidate_list_record",
        "\"query_id\":170003,\"list_kind\":3,\"candidate_count\":6,\"selected_index\":1,\"target\":\"stroke\"")

    record_query(170004, 4, 8, 7)
    r0_emit("pe_ime_candidate_list_record",
        "\"query_id\":170004,\"list_kind\":4,\"candidate_count\":8,\"selected_index\":7,\"target\":\"phonetic\"")

    record_query(170005, 4, 5, -1)
    r0_emit("pe_ime_candidate_list_record",
        "\"query_id\":170005,\"list_kind\":4,\"candidate_count\":5,\"selected_index\":-1,\"target\":\"phonetic\"")

    // 3. query_count = 5
    let c = query_count()
    if c != 5 {
        panic("pe_ime_candidate_list FAIL [query_count] expected=5 got=" + to_string(c))
    }

    // 4. total_candidates = 9 + 12 + 6 + 8 + 5 = 40
    let tc = total_candidates()
    if tc != 40 {
        panic("pe_ime_candidate_list FAIL [total_candidates] expected=40 got=" + to_string(tc))
    }

    // 5. count_by_list_kind sanity
    let k1 = count_by_list_kind(1)
    if k1 != 2 {
        panic("pe_ime_candidate_list FAIL [count_by_list_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_list_kind(2)
    if k2 != 0 {
        panic("pe_ime_candidate_list FAIL [count_by_list_kind(2)] expected=0 got=" + to_string(k2))
    }
    let k3 = count_by_list_kind(3)
    if k3 != 1 {
        panic("pe_ime_candidate_list FAIL [count_by_list_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_list_kind(4)
    if k4 != 2 {
        panic("pe_ime_candidate_list FAIL [count_by_list_kind(4)] expected=2 got=" + to_string(k4))
    }
    let k5 = count_by_list_kind(5)
    if k5 != 0 {
        panic("pe_ime_candidate_list FAIL [count_by_list_kind(5)] expected=0 got=" + to_string(k5))
    }
    let k99 = count_by_list_kind(99)
    if k99 != 0 {
        panic("pe_ime_candidate_list FAIL [count_by_list_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. query_selected_index sanity
    let s1 = query_selected_index(170001)
    if s1 != 0 {
        panic("pe_ime_candidate_list FAIL [query_selected_index(170001)] expected=0 got=" + to_string(s1))
    }
    let s4 = query_selected_index(170004)
    if s4 != 7 {
        panic("pe_ime_candidate_list FAIL [query_selected_index(170004)] expected=7 got=" + to_string(s4))
    }
    let s5 = query_selected_index(170005)
    if s5 != -1 {
        panic("pe_ime_candidate_list FAIL [query_selected_index(170005)] expected=-1 got=" + to_string(s5))
    }
    let s_miss = query_selected_index(9999)
    if s_miss != -1 {
        panic("pe_ime_candidate_list FAIL [query_selected_index(9999)] expected=-1 got=" + to_string(s_miss))
    }

    // 7. picl_stats() = [5, 40, 2, 2]
    let s = picl_stats()
    if len(s) != 4 {
        panic("pe_ime_candidate_list FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_ime_candidate_list FAIL [stats query_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 40 {
        panic("pe_ime_candidate_list FAIL [stats total_candidates] expected=40 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_ime_candidate_list FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_ime_candidate_list FAIL [stats count_kind(4)] expected=2 got=" + to_string(s[3]))
    }

    // 8. emit stats
    r0_emit("pe_ime_candidate_list_stats",
        "\"query_count\":" + to_string(s[0])
        + ",\"total_candidates\":" + to_string(s[1])
        + ",\"kind_phrase\":" + to_string(s[2])
        + ",\"kind_phonetic\":" + to_string(s[3]))

    // 9. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_ime_candidate_list FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 10. cleanup → stats 모두 0
    cleanup_picl()
    let s2 = picl_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_ime_candidate_list FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_ime_candidate_list self_test PASS (queries=" + to_string(s[0])
        + ", candidates=" + to_string(s[1]) + ", kinds=3"
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = picl_stats()
            println("query_count\t" + to_string(s[0]))
            println("total_candidates\t" + to_string(s[1]))
            println("count_kind_phrase\t" + to_string(s[2]))
            println("count_kind_phonetic\t" + to_string(s[3]))
            return
        }
        if sub == "selected" {
            if len(a) >= 4 {
                let qid = to_int(a[3])
                println("query_selected_index\t" + to_string(query_selected_index(qid)))
                return
            }
            println("usage: hexa run pe_ime_candidate_list.hexa selected <query_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let lk = to_int(a[3])
                println("count_by_list_kind\t" + to_string(count_by_list_kind(lk)))
                return
            }
            println("usage: hexa run pe_ime_candidate_list.hexa count <list_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_picl()
            println("cleaned: " + picl_dir())
            return
        }
        if sub == "dir" {
            println(picl_dir())
            return
        }
    }
    println("usage: hexa run pe_ime_candidate_list.hexa { self-test | stats | selected <query_id> | count <list_kind> | cleanup | dir }")
}
