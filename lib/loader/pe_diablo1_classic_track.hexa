// lib/loader/pe_diablo1_classic_track.hexa — Diablo 1 (Blizzard, 1996) 전용 entry/loader 추적.
//
// Diablo 1 launch chain (own2 자체 추적):
//   process_attach        — Diablo.exe entry (i386 PE32, 1996)
//   ddraw_init            — DirectDraw 1.0 device + primary surface
//   mpq_archive_load      — DIABDAT.MPQ (Storm.dll wrapper)
//   smacker_play_intro    — Smacker video codec (RAD Game Tools)
//   character_create      — Warrior / Rogue / Sorcerer + Hellfire Monk/Bard/Barbarian
//   town_load             — Tristram NPC (Cain/Pepin/Griswold/Wirt/Ogden/Adria)
//   labyrinth_load        — Cathedral/Catacombs/Caves/Hell L1-L16
//   first_frame           — DDraw Blt() first call
//   hellfire_dlc          — Sierra On-Line DLC (1997)
// own1: Diablo 1 공개 정보 (오래된 game, 광범위). Wine 인용 X
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 Diablo 1-specific phase tracker — closure path B 매우 친화 (anti-cheat 0).
// own 2 mandate: r0_emit ≥ 10 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = process_attach
//   2 = ddraw_init
//   3 = mpq_archive_load
//   4 = smacker_play_intro
//   5 = character_create
//   6 = town_load
//   7 = labyrinth_load
//   8 = first_frame
//   9 = hellfire_dlc
//
// persist schema (TSV — steps.tsv):
//   step_id<int> \t phase_kind<int> \t dll_loaded<int> \t online_battle_net<int>

use "../perf/r0_common"

fn pd1ct_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_diablo1_classic_track"
}

fn pd1ct_steps_path() -> str {
    return pd1ct_dir() + "/steps.tsv"
}

fn pd1ct_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pd1ct_dir() + "'")
}

fn cleanup_pd1ct() -> void {
    pd1ct_ensure_dir()
    let _ = exec("rm -f '" + pd1ct_steps_path() + "'")
}

fn pd1ct_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pd1ct_append_row(path: str, row: str) -> void {
    pd1ct_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn record_step(step_id: int, phase_kind: int, dll_loaded: int, online_battle_net: int) -> void {
    if step_id <= 0 {
        panic("pe_diablo1_classic_track FAIL [record_step] expected=step_id>0 got=" + to_string(step_id))
    }
    if phase_kind < 1 {
        panic("pe_diablo1_classic_track FAIL [record_step] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 9 {
        panic("pe_diablo1_classic_track FAIL [record_step] expected=phase_kind<=9 got=" + to_string(phase_kind))
    }
    if dll_loaded < 0 {
        panic("pe_diablo1_classic_track FAIL [record_step] expected=dll_loaded>=0 got=" + to_string(dll_loaded))
    }
    if dll_loaded > 1 {
        panic("pe_diablo1_classic_track FAIL [record_step] expected=dll_loaded<=1 got=" + to_string(dll_loaded))
    }
    if online_battle_net < 0 {
        panic("pe_diablo1_classic_track FAIL [record_step] expected=online_battle_net>=0 got=" + to_string(online_battle_net))
    }
    if online_battle_net > 1 {
        panic("pe_diablo1_classic_track FAIL [record_step] expected=online_battle_net<=1 got=" + to_string(online_battle_net))
    }
    let row = to_string(step_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(dll_loaded) + "\t" + to_string(online_battle_net) + "\n"
    pd1ct_append_row(pd1ct_steps_path(), row)
}

fn step_count() -> int {
    let t = pd1ct_read_table(pd1ct_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

fn count_by_phase_kind(phase_kind: int) -> int {
    let t = pd1ct_read_table(pd1ct_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn loaded_count() -> int {
    let t = pd1ct_read_table(pd1ct_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn online_count() -> int {
    let t = pd1ct_read_table(pd1ct_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

fn hellfire_count() -> int {
    return count_by_phase_kind(9)
}

fn step_dll_loaded(step_id: int) -> int {
    let t = pd1ct_read_table(pd1ct_steps_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == step_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn pd1ct_stats() -> array {
    let mut out = []
    out.push(step_count())
    out.push(loaded_count())
    out.push(online_count())
    out.push(hellfire_count())
    out.push(count_by_phase_kind(8))
    return out
}

fn self_test() -> void {
    let sid = "pd1ct-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pd1ct()

    record_step(170001, 1, 0, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170001,\"phase_kind\":1,\"dll_loaded\":0,\"online\":0,\"target\":\"process_attach\"")
    record_step(170002, 2, 1, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170002,\"phase_kind\":2,\"dll_loaded\":1,\"online\":0,\"target\":\"ddraw_init\"")
    record_step(170003, 3, 1, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170003,\"phase_kind\":3,\"dll_loaded\":1,\"online\":0,\"target\":\"mpq_archive_load\"")
    record_step(170004, 4, 1, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170004,\"phase_kind\":4,\"dll_loaded\":1,\"online\":0,\"target\":\"smacker_play_intro\"")
    record_step(170005, 5, 0, 1)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170005,\"phase_kind\":5,\"dll_loaded\":0,\"online\":1,\"target\":\"character_create\"")
    record_step(170006, 6, 0, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170006,\"phase_kind\":6,\"dll_loaded\":0,\"online\":0,\"target\":\"town_load\"")
    record_step(170007, 7, 0, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170007,\"phase_kind\":7,\"dll_loaded\":0,\"online\":0,\"target\":\"labyrinth_load\"")
    record_step(170008, 8, 0, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170008,\"phase_kind\":8,\"dll_loaded\":0,\"online\":0,\"target\":\"first_frame\"")
    record_step(170009, 9, 1, 0)
    r0_emit("pe_diablo1_classic_track_record",
        "\"step_id\":170009,\"phase_kind\":9,\"dll_loaded\":1,\"online\":0,\"target\":\"hellfire_dlc\"")

    let c = step_count()
    if c != 9 {
        panic("pe_diablo1_classic_track FAIL [step_count] expected=9 got=" + to_string(c))
    }
    let hc = hellfire_count()
    if hc != 1 {
        panic("pe_diablo1_classic_track FAIL [hellfire_count] expected=1 got=" + to_string(hc))
    }
    let oc = online_count()
    if oc != 1 {
        panic("pe_diablo1_classic_track FAIL [online_count] expected=1 got=" + to_string(oc))
    }
    let lc = loaded_count()
    if lc != 4 {
        panic("pe_diablo1_classic_track FAIL [loaded_count] expected=4 got=" + to_string(lc))
    }
    let p99 = count_by_phase_kind(99)
    if p99 != 0 {
        panic("pe_diablo1_classic_track FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p99))
    }
    let d_miss = step_dll_loaded(9999)
    if d_miss != 0 {
        panic("pe_diablo1_classic_track FAIL [step_dll_loaded(9999)] expected=0 got=" + to_string(d_miss))
    }

    let s = pd1ct_stats()
    if len(s) != 5 {
        panic("pe_diablo1_classic_track FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }

    r0_emit("pe_diablo1_classic_track_stats",
        "\"step_count\":" + to_string(s[0])
        + ",\"loaded_count\":" + to_string(s[1])
        + ",\"online_count\":" + to_string(s[2])
        + ",\"hellfire_count\":" + to_string(s[3])
        + ",\"first_frame_count\":" + to_string(s[4]))

    let emit_n = r0_session_count(sid)
    if emit_n < 10 {
        panic("pe_diablo1_classic_track FAIL [r0 emit count] expected=>=10 got=" + to_string(emit_n))
    }

    cleanup_pd1ct()
    let s2 = pd1ct_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_diablo1_classic_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_diablo1_classic_track self_test PASS (steps=" + to_string(s[0])
        + ", loaded=" + to_string(s[1]) + ", online=" + to_string(s[2])
        + ", hellfire=" + to_string(s[3]) + ", first_frame=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pd1ct_stats()
            println("step_count\t" + to_string(s[0]))
            println("loaded_count\t" + to_string(s[1]))
            println("online_count\t" + to_string(s[2]))
            println("hellfire_count\t" + to_string(s[3]))
            println("first_frame_count\t" + to_string(s[4]))
            return
        }
        if sub == "loaded" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                println("step_dll_loaded\t" + to_string(step_dll_loaded(sid)))
                return
            }
            println("usage: hexa run pe_diablo1_classic_track.hexa loaded <step_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let pk = to_int(a[3])
                println("count_by_phase_kind\t" + to_string(count_by_phase_kind(pk)))
                return
            }
            println("usage: hexa run pe_diablo1_classic_track.hexa count <phase_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pd1ct()
            println("cleaned: " + pd1ct_dir())
            return
        }
        if sub == "dir" {
            println(pd1ct_dir())
            return
        }
    }
    println("usage: hexa run pe_diablo1_classic_track.hexa { self-test | stats | loaded <step_id> | count <phase_kind> | cleanup | dir }")
}
