// ─── record_websocket_event: CompleteUpgrade/Send row ───
fn record_websocket_event(evt_id: int, w_kind: str, ws_synth: str, frame_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_winhttp_core FAIL [record_websocket_event] evt_id<=0") }
    if w_kind == "" { panic("pe_winhttp_core FAIL [record_websocket_event] w_kind=empty") }
    if ws_synth == "" { panic("pe_winhttp_core FAIL [record_websocket_event] ws_synth=empty") }
    if frame_synth == "" { panic("pe_winhttp_core FAIL [record_websocket_event] frame_synth=empty") }
