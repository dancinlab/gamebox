}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pwh_count_rows(pwh_syscall_invoke_path(), 4)
}

fn session_event_count() -> int {
    return pwh_count_rows(pwh_session_event_path(), 5)
}

fn request_event_count() -> int {
    return pwh_count_rows(pwh_request_event_path(), 5)
}

fn options_event_count() -> int {
    return pwh_count_rows(pwh_options_event_path(), 5)
}

fn websocket_event_count() -> int {
    return pwh_count_rows(pwh_websocket_event_path(), 5)
}

fn pwh_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(session_event_count())
    out.push(request_event_count())
    out.push(options_event_count())
    out.push(websocket_event_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pwh-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pwh()

    // ─── 1. syscall_invoke × 12 (one per fn, 4 group coverage) ───
    //   SESSION group (3)
    record_syscall_invoke(1, 0, "WinHttpOpen", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpOpen")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"WinHttpOpen\",\"fn_group\":\"session\",\"status\":\"PARTIAL\",\"pszAgentW\":\"Battle.net_Agent_2.30.0_WinHTTP\",\"dwAccessType\":\"WINHTTP_ACCESS_TYPE_DEFAULT_PROXY_0\",\"pszProxyW\":\"WINHTTP_NO_PROXY_NAME\",\"pszProxyBypassW\":\"WINHTTP_NO_PROXY_BYPASS\",\"dwFlags\":0,\"out_hSession\":\"0xB1010100_HINTERNET_session\",\"return_handle_nonzero\":true")
    record_syscall_invoke(2, 1, "WinHttpCloseHandle", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpCloseHandle")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":1,\"fn_name\":\"WinHttpCloseHandle\",\"fn_group\":\"session\",\"status\":\"PARTIAL\",\"hInternet\":\"0xB1010100_HINTERNET_session\",\"return_bool\":\"TRUE_1\",\"battle_net_agent_clean_shutdown\":true")
    record_syscall_invoke(3, 2, "WinHttpConnect", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpConnect")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":2,\"fn_name\":\"WinHttpConnect\",\"fn_group\":\"session\",\"status\":\"PARTIAL\",\"hSession\":\"0xB1010100\",\"pswzServerName\":\"us.battle.net\",\"nServerPort\":\"INTERNET_DEFAULT_HTTPS_PORT_443\",\"dwReserved\":0,\"out_hConnect\":\"0xB1020100_HINTERNET_connection\",\"battle_net_us_region_baseline\":true")

    //   REQUEST group (4)
    record_syscall_invoke(4, 3, "WinHttpOpenRequest", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpOpenRequest")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":3,\"fn_name\":\"WinHttpOpenRequest\",\"fn_group\":\"request\",\"status\":\"PARTIAL\",\"hConnect\":\"0xB1020100\",\"pwszVerb\":\"GET\",\"pwszObjectName\":\"/oauth/token\",\"pwszVersion\":\"HTTP/1.1\",\"pwszReferrer\":\"WINHTTP_NO_REFERER\",\"ppwszAcceptTypes\":\"WINHTTP_DEFAULT_ACCEPT_TYPES\",\"dwFlags\":\"WINHTTP_FLAG_SECURE_0x800000\",\"out_hRequest\":\"0xB1030100_HINTERNET_request\",\"https_secure\":true")
    record_syscall_invoke(5, 4, "WinHttpSendRequest", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpSendRequest")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":4,\"fn_name\":\"WinHttpSendRequest\",\"fn_group\":\"request\",\"status\":\"PARTIAL\",\"hRequest\":\"0xB1030100\",\"pwszHeaders\":\"Authorization:_Basic_synth\",\"dwHeadersLength\":-1,\"lpOptional\":\"WINHTTP_NO_REQUEST_DATA\",\"dwOptionalLength\":0,\"dwTotalLength\":0,\"dwContext\":0,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(6, 5, "WinHttpReceiveResponse", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpReceiveResponse")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":5,\"fn_name\":\"WinHttpReceiveResponse\",\"fn_group\":\"request\",\"status\":\"PARTIAL\",\"hRequest\":\"0xB1030100\",\"lpReserved\":\"NULL\",\"return_bool\":\"TRUE_1\",\"http_status_synth\":\"200_OK\",\"battle_net_oauth_token_received\":true")
    record_syscall_invoke(7, 6, "WinHttpReadData", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpReadData")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":6,\"fn_name\":\"WinHttpReadData\",\"fn_group\":\"request\",\"status\":\"PARTIAL\",\"hRequest\":\"0xB1030100\",\"lpBuffer\":\"0xC0010100_buf_4096\",\"dwNumberOfBytesToRead\":4096,\"out_lpdwNumberOfBytesRead\":1024,\"return_bool\":\"TRUE_1\",\"body_synth\":\"json_oauth_access_token_synth\"")

    //   OPTIONS group (3)
    record_syscall_invoke(8, 7, "WinHttpSetOption", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpSetOption")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":7,\"fn_name\":\"WinHttpSetOption\",\"fn_group\":\"options\",\"status\":\"PARTIAL\",\"hInternet\":\"0xB1010100\",\"dwOption\":\"WINHTTP_OPTION_CONNECT_TIMEOUT_1\",\"lpBuffer\":\"30000_ms\",\"dwBufferLength\":4,\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(9, 8, "WinHttpQueryOption", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpQueryOption")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":9,\"fn_kind\":8,\"fn_name\":\"WinHttpQueryOption\",\"fn_group\":\"options\",\"status\":\"PARTIAL\",\"hInternet\":\"0xB1030100\",\"dwOption\":\"WINHTTP_OPTION_SECURITY_FLAGS_31\",\"lpBuffer\":\"0xC0020100_4B\",\"dwBufferLength\":4,\"out_security_flags\":\"SECURITY_FLAG_STRENGTH_STRONG_0x20000000\",\"return_bool\":\"TRUE_1\"")
    record_syscall_invoke(10, 9, "WinHttpQueryHeaders", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpQueryHeaders")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":10,\"fn_kind\":9,\"fn_name\":\"WinHttpQueryHeaders\",\"fn_group\":\"options\",\"status\":\"PARTIAL\",\"hRequest\":\"0xB1030100\",\"dwInfoLevel\":\"WINHTTP_QUERY_STATUS_CODE_19\",\"pwszName\":\"WINHTTP_HEADER_NAME_BY_INDEX_NULL\",\"out_status_code\":200,\"return_bool\":\"TRUE_1\",\"battle_net_rest_200_ok_baseline\":true")

    //   WEBSOCKET group (2)
    record_syscall_invoke(11, 10, "WinHttpWebSocketCompleteUpgrade", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpWebSocketCompleteUpgrade")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":11,\"fn_kind\":10,\"fn_name\":\"WinHttpWebSocketCompleteUpgrade\",\"fn_group\":\"websocket\",\"status\":\"PARTIAL\",\"hRequest\":\"0xB1030100\",\"pContext\":0,\"out_hWebSocket\":\"0xB1040100_HINTERNET_websocket\",\"battle_net_realtime_push_baseline\":true,\"upgrade_protocol_synth\":\"HTTP_101_Switching_Protocols\"")
    record_syscall_invoke(12, 11, "WinHttpWebSocketSend", "PARTIAL")
    println("__WINHTTP__ PARTIAL WinHttpWebSocketSend")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":12,\"fn_kind\":11,\"fn_name\":\"WinHttpWebSocketSend\",\"fn_group\":\"websocket\",\"status\":\"PARTIAL\",\"hWebSocket\":\"0xB1040100\",\"eBufferType\":\"WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE_0\",\"pvBuffer\":\"0xC0030100_payload_synth\",\"dwBufferLength\":256,\"return_dword\":\"NO_ERROR_0\",\"frame_synth\":\"binary_256B_battle_net_event\"")

    // ─── 2. session_event × 3 (open/close/connect) ───
    record_session_event(1, "open_battle_net_agent_2_30_0", "0xB1010100_HINTERNET_session", "WINHTTP_ACCESS_TYPE_DEFAULT_PROXY_0", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"session_event\",\"evt_id\":1,\"s_kind\":\"open_battle_net_agent_2_30_0\",\"sess_synth\":\"0xB1010100_HINTERNET_session\",\"target_synth\":\"WINHTTP_ACCESS_TYPE_DEFAULT_PROXY_0\",\"battle_net_agent_user_agent_baseline\":true,\"status\":\"PARTIAL\"")
    record_session_event(2, "close_session_clean", "0xB1010100_HINTERNET_session", "shutdown_clean", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"session_event\",\"evt_id\":2,\"s_kind\":\"close_session_clean\",\"sess_synth\":\"0xB1010100_HINTERNET_session\",\"target_synth\":\"shutdown_clean\",\"return_bool\":\"TRUE_1\",\"status\":\"PARTIAL\"")
    record_session_event(3, "connect_us_battle_net_443", "0xB1020100_HINTERNET_connection", "us.battle.net:443_HTTPS", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"session_event\",\"evt_id\":3,\"s_kind\":\"connect_us_battle_net_443\",\"sess_synth\":\"0xB1020100_HINTERNET_connection\",\"target_synth\":\"us.battle.net:443_HTTPS\",\"battle_net_oauth_endpoint_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── 3. request_event × 4 (open/send/receive/read) ───
    record_request_event(1, "open_get_oauth_token_https", "0xB1030100_HINTERNET_request", "GET_/oauth/token_HTTPS_secure", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"request_event\",\"evt_id\":1,\"r_kind\":\"open_get_oauth_token_https\",\"req_synth\":\"0xB1030100_HINTERNET_request\",\"body_synth\":\"GET_/oauth/token_HTTPS_secure\",\"battle_net_oauth_token_endpoint_baseline\":true,\"status\":\"PARTIAL\"")
    record_request_event(2, "send_authorization_basic", "0xB1030100", "Authorization:_Basic_synth_no_body", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"request_event\",\"evt_id\":2,\"r_kind\":\"send_authorization_basic\",\"req_synth\":\"0xB1030100\",\"body_synth\":\"Authorization:_Basic_synth_no_body\",\"oauth_basic_auth_baseline\":true,\"status\":\"PARTIAL\"")
    record_request_event(3, "receive_response_200_ok", "0xB1030100", "HTTP_200_OK_application_json", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"request_event\",\"evt_id\":3,\"r_kind\":\"receive_response_200_ok\",\"req_synth\":\"0xB1030100\",\"body_synth\":\"HTTP_200_OK_application_json\",\"battle_net_oauth_200_ok_baseline\":true,\"status\":\"PARTIAL\"")
    record_request_event(4, "read_data_4096_to_1024", "0xB1030100", "json_oauth_access_token_1024B_synth", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"request_event\",\"evt_id\":4,\"r_kind\":\"read_data_4096_to_1024\",\"req_synth\":\"0xB1030100\",\"body_synth\":\"json_oauth_access_token_1024B_synth\",\"d4_launcher_rest_token_payload_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── 4. options_event × 3 (set/query/headers) ───
    record_options_event(1, "set_connect_timeout_30s", "0xB1010100", "WINHTTP_OPTION_CONNECT_TIMEOUT_1_30000ms", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"options_event\",\"evt_id\":1,\"o_kind\":\"set_connect_timeout_30s\",\"target_synth\":\"0xB1010100\",\"opt_synth\":\"WINHTTP_OPTION_CONNECT_TIMEOUT_1_30000ms\",\"battle_net_robust_timeout_baseline\":true,\"status\":\"PARTIAL\"")
    record_options_event(2, "query_security_flags_strong", "0xB1030100", "WINHTTP_OPTION_SECURITY_FLAGS_31_STRONG_0x20000000", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"options_event\",\"evt_id\":2,\"o_kind\":\"query_security_flags_strong\",\"target_synth\":\"0xB1030100\",\"opt_synth\":\"WINHTTP_OPTION_SECURITY_FLAGS_31_STRONG_0x20000000\",\"tls12_strong_baseline\":true,\"status\":\"PARTIAL\"")
    record_options_event(3, "query_status_code_200", "0xB1030100", "WINHTTP_QUERY_STATUS_CODE_19_200", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"options_event\",\"evt_id\":3,\"o_kind\":\"query_status_code_200\",\"target_synth\":\"0xB1030100\",\"opt_synth\":\"WINHTTP_QUERY_STATUS_CODE_19_200\",\"http_200_ok\":true,\"status\":\"PARTIAL\"")

    // ─── 5. websocket_event × 2 (upgrade/send) ───
    record_websocket_event(1, "complete_upgrade_101_switching", "0xB1040100_HINTERNET_websocket", "HTTP_101_Switching_Protocols_synth", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"websocket_event\",\"evt_id\":1,\"w_kind\":\"complete_upgrade_101_switching\",\"ws_synth\":\"0xB1040100_HINTERNET_websocket\",\"frame_synth\":\"HTTP_101_Switching_Protocols_synth\",\"battle_net_realtime_push_upgrade_baseline\":true,\"status\":\"PARTIAL\"")
    record_websocket_event(2, "send_binary_256B_event", "0xB1040100", "binary_256B_battle_net_event_synth", "PARTIAL")
    r0_emit("pe_winhttp_core_record", "\"kind\":\"websocket_event\",\"evt_id\":2,\"w_kind\":\"send_binary_256B_event\",\"ws_synth\":\"0xB1040100\",\"frame_synth\":\"binary_256B_battle_net_event_synth\",\"return_dword\":\"NO_ERROR_0\",\"d4_realtime_event_push_baseline\":true,\"status\":\"PARTIAL\"")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 12 {
        panic("pe_winhttp_core FAIL [syscall_invoke_count] expected=12 got=" + to_string(si))
    }
    let se = session_event_count()
    if se != 3 {
        panic("pe_winhttp_core FAIL [session_event_count] expected=3 got=" + to_string(se))
    }
    let re = request_event_count()
    if re != 4 {
        panic("pe_winhttp_core FAIL [request_event_count] expected=4 got=" + to_string(re))
    }
    let oe = options_event_count()
    if oe != 3 {
        panic("pe_winhttp_core FAIL [options_event_count] expected=3 got=" + to_string(oe))
    }
    let we = websocket_event_count()
    if we != 2 {
        panic("pe_winhttp_core FAIL [websocket_event_count] expected=2 got=" + to_string(we))
    }

    // ─── helper name + group classification sanity ───
    if fn_kind_name(0) != "WinHttpOpen" { panic("pe_winhttp_core FAIL [fn_kind_name(0)]") }
    if fn_kind_name(2) != "WinHttpConnect" { panic("pe_winhttp_core FAIL [fn_kind_name(2)]") }
    if fn_kind_name(5) != "WinHttpReceiveResponse" { panic("pe_winhttp_core FAIL [fn_kind_name(5)]") }
    if fn_kind_name(9) != "WinHttpQueryHeaders" { panic("pe_winhttp_core FAIL [fn_kind_name(9)]") }
    if fn_kind_name(11) != "WinHttpWebSocketSend" { panic("pe_winhttp_core FAIL [fn_kind_name(11)]") }
    if fn_kind_name(99) != "unknown" { panic("pe_winhttp_core FAIL [fn_kind_name(99)]") }
    if fn_group_name(0) != "session" { panic("pe_winhttp_core FAIL [fn_group_name(0)]") }
    if fn_group_name(3) != "request" { panic("pe_winhttp_core FAIL [fn_group_name(3)]") }
    if fn_group_name(7) != "options" { panic("pe_winhttp_core FAIL [fn_group_name(7)]") }
    if fn_group_name(10) != "websocket" { panic("pe_winhttp_core FAIL [fn_group_name(10)]") }
    if fn_group_name(99) != "unknown" { panic("pe_winhttp_core FAIL [fn_group_name(99)]") }

    // ─── stats sanity ───
    let s = pwh_stats()
    if len(s) != 5 { panic("pe_winhttp_core FAIL [stats len] expected=5 got=" + to_string(len(s))) }
    if s[0] != 12 { panic("pe_winhttp_core FAIL [stats syscall_invoke_count] expected=12 got=" + to_string(s[0])) }
    if s[1] != 3 { panic("pe_winhttp_core FAIL [stats session_event_count] expected=3 got=" + to_string(s[1])) }
    if s[2] != 4 { panic("pe_winhttp_core FAIL [stats request_event_count] expected=4 got=" + to_string(s[2])) }
    if s[3] != 3 { panic("pe_winhttp_core FAIL [stats options_event_count] expected=3 got=" + to_string(s[3])) }
    if s[4] != 2 { panic("pe_winhttp_core FAIL [stats websocket_event_count] expected=2 got=" + to_string(s[4])) }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_winhttp_core_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"session_event_count\":" + to_string(s[1])
        + ",\"request_event_count\":" + to_string(s[2])
        + ",\"options_event_count\":" + to_string(s[3])
        + ",\"websocket_event_count\":" + to_string(s[4]))

    r0_emit("pe_winhttp_core_summary",
        "\"target\":\"WINHTTP.dll\",\"fn_total\":12,\"fn_emit_partial\":12,\"groups\":[\"session\",\"request\",\"options\",\"websocket\"],\"session_synth\":\"0xB1010100\",\"connection_synth\":\"0xB1020100\",\"request_synth\":\"0xB1030100\",\"websocket_synth\":\"0xB1040100\",\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"posture\":\"PARTIAL\"")

    r0_emit("pe_winhttp_core_kpi",
        "\"session_emits\":3,\"request_emits\":4,\"options_emits\":3,\"websocket_emits\":2,\"real_syscall\":false,\"warden_compat_long_horizon\":true,\"warden_natural_env_alignment_indirect\":true,\"battle_net_oauth_token_baseline\":true,\"d4_launcher_rest_baseline\":true,\"battle_net_realtime_push_baseline\":true,\"nsurlsession_nsurlrequest_binding\":false,\"cfnetwork_cfhttpmessage_cfreadstream_binding\":false,\"network_framework_nw_connection_binding\":false")

    // ─── cycle 59 → 60 WINHTTP coverage progression evidence emit ───
    r0_emit("pe_winhttp_core_coverage_progression",
        "\"surface\":\"WINHTTP_full_435_fn\",\"cycle_59_count\":398,\"cycle_60_count\":410,\"delta\":12,\"cycle_59_percent\":91.49,\"cycle_60_percent\":94.25,\"cycle_60_module\":\"pe_winhttp_core.hexa\",\"long_horizon_cycles_remaining\":\"few (full ~435 fn = nearing completion)\",\"track_bp1_cycle_increment\":12,\"track_bp_bundled_part_1_of_3\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_winhttp_core_round_trip_matrix",
        "\"surface\":\"WINHTTP_core_12_fn\",\"fn_partial\":12,\"fn_groups\":4,\"shim_kind\":\"skeleton\",\"real_syscall\":false,\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real WinHttpOpen + WinHttpSendRequest + WinHttpReceiveResponse + WinHttpReadData + WinHttpWebSocketSend = NSURLSession + NSURLRequest + NSURLSessionDataTask + NSURLSessionWebSocketTask + CFNetwork CFHTTPMessage / CFReadStream + Network.framework nw_connection bridge pending separate cycle (long-horizon HTTPS + WebSocket pipeline)\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    // ─── Track BP1 expansion emit (cycle 60, WINHTTP +12 fn) ───
    r0_emit("pe_winhttp_core_bp1_expansion",
        "\"track\":\"BP1\",\"cycle\":60,\"surface\":\"WINHTTP_new\",\"new_fn\":12,\"groups\":[\"session\",\"request\",\"options\",\"websocket\"],\"session_count\":3,\"request_count\":4,\"options_count\":3,\"websocket_count\":2,\"emit_format\":\"__WINHTTP__ PARTIAL <fn>\",\"additive_only\":true,\"existing_modules_preserved\":true,\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK_2026_05_03\",\"cond_1_evidence_augment\":true,\"track_bp_bundled_part_1_of_3\":true,\"modern_post_wininet_http_websocket_family\":true")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_winhttp_core FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pwh()
    let s2 = pwh_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_winhttp_core FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_winhttp_core self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", session_event=" + to_string(s[1])
        + ", request_event=" + to_string(s[2]) + ", options_event=" + to_string(s[3])
        + ", websocket_event=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pwh_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("session_event_count\t" + to_string(s[1]))
            println("request_event_count\t" + to_string(s[2]))
            println("options_event_count\t" + to_string(s[3]))
            println("websocket_event_count\t" + to_string(s[4]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_winhttp_core.hexa fn-kind-name <int>")
            return
        }
        if sub == "fn-group-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_group_name(k))
                return
            }
            println("usage: hexa run pe_winhttp_core.hexa fn-group-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pwh()
            println("cleaned: " + pwh_dir())
            return
        }
        if sub == "dir" {
            println(pwh_dir())
            return
        }
    }
    println("usage: hexa run pe_winhttp_core.hexa { self-test | stats | fn-kind-name <int> | fn-group-name <int> | cleanup | dir }")
}
