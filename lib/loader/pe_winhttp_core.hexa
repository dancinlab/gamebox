// lib/loader/pe_winhttp_core.hexa — WINHTTP.dll modern HTTP API surface (skeleton-tier)
//
// own1: Hexa pure. Wine/CrossOver/Whisky/GPTK 의존 0. ReactOS/Wine winhttp source 인용 0.
//       winhttp.dll 직접 binding 0. macOS NSURLSession / NSURLRequest / NSURLResponse /
//       CFNetwork CFHTTPMessage / CFReadStream / NSURLSessionWebSocketTask /
//       Network.framework nw_connection / nw_protocol_options 직접 binding 0.
//       NOTE: WINHTTP 측 modern post-WININET HTTP/HTTPS + WebSocket (Win8+) — Battle.net Agent
//       authentication + CDN download + Diablo IV launcher REST + WebSocket realtime push
//       round-trip baseline (long-horizon production smoke pending separate cycle).
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
// online_expansion_lockin: L1+L2+L3+L4+L5 OK 사용자 lock-in 2026-05-03.
//
// Track BP1 — WINHTTP session/request/options/websocket surface 12 fn skeleton-tier.
// cycle 59 398/435 (~91.49%) → cycle 60 ~410/435 (~94.25%) (+12 fn, BP bundled part 1/3).
//
// 대상 fn (12 fn — 4 group, fn_kind 0..11):
//   SESSION   (3): WinHttpOpen(0) / WinHttpCloseHandle(1) / WinHttpConnect(2)
//   REQUEST   (4): WinHttpOpenRequest(3) / WinHttpSendRequest(4) /
//                  WinHttpReceiveResponse(5) / WinHttpReadData(6)
//   OPTIONS   (3): WinHttpSetOption(7) / WinHttpQueryOption(8) / WinHttpQueryHeaders(9)
//   WEBSOCKET (2): WinHttpWebSocketCompleteUpgrade(10) / WinHttpWebSocketSend(11)
//
// synthetic struct families:
//   HINTERNET session 0xB1010100 / connection 0xB1020100 / request 0xB1030100 /
//             websocket 0xB1040100 opaque (synthetic).
//   WINHTTP_ACCESS_TYPE_DEFAULT_PROXY 0 / NO_PROXY 1 / NAMED_PROXY 3 /
//                       AUTOMATIC_PROXY 4.
//   WINHTTP_FLAG_SECURE 0x800000 (HTTPS) / WINHTTP_FLAG_BYPASS_PROXY_CACHE 0x100.
//   WINHTTP_OPTION_SECURITY_FLAGS 31 / OPTION_CLIENT_CERT_CONTEXT 47 /
//                  OPTION_CONNECT_TIMEOUT 1 / OPTION_RECEIVE_TIMEOUT 6.
//   WINHTTP_HEADER_NAME_BY_INDEX_NULL / WINHTTP_QUERY_STATUS_CODE 19 /
//                                       WINHTTP_QUERY_CONTENT_TYPE 1.
//   WINHTTP_WEB_SOCKET_BUFFER_TYPE BinaryMessage 0 / BinaryFragment 1 /
//                                  UtfMessage 2 / UtfFragment 3 / Close 4.
//
// persist schema (TSV — 5 table):
//   syscall_invoke / session_event / request_event / options_event / websocket_event.
// 식별자: type/mod/handle/class/interface/module/import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwh_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_winhttp_core"
}

fn pwh_syscall_invoke_path() -> str {
    return pwh_dir() + "/syscall_invoke.tsv"
}

fn pwh_session_event_path() -> str {
    return pwh_dir() + "/session_event.tsv"
}

fn pwh_request_event_path() -> str {
    return pwh_dir() + "/request_event.tsv"
}

fn pwh_options_event_path() -> str {
    return pwh_dir() + "/options_event.tsv"
}

fn pwh_websocket_event_path() -> str {
    return pwh_dir() + "/websocket_event.tsv"
}

fn pwh_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwh_dir() + "'")
}

fn cleanup_pwh() -> void {
    pwh_ensure_dir()
    let _ = exec("rm -f '" + pwh_syscall_invoke_path() + "' '" + pwh_session_event_path()
        + "' '" + pwh_request_event_path() + "' '" + pwh_options_event_path()
        + "' '" + pwh_websocket_event_path() + "'")
}

// ─── 공통 file IO ───
fn pwh_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwh_append_row(path: str, row: str) -> void {
    pwh_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pwh_count_rows(path: str, min_cols: int) -> int {
    let t = pwh_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (12 fn coverage, fn_kind 0..11) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "WinHttpOpen" }
    if k == 1 { return "WinHttpCloseHandle" }
    if k == 2 { return "WinHttpConnect" }
    if k == 3 { return "WinHttpOpenRequest" }
    if k == 4 { return "WinHttpSendRequest" }
    if k == 5 { return "WinHttpReceiveResponse" }
    if k == 6 { return "WinHttpReadData" }
    if k == 7 { return "WinHttpSetOption" }
    if k == 8 { return "WinHttpQueryOption" }
    if k == 9 { return "WinHttpQueryHeaders" }
    if k == 10 { return "WinHttpWebSocketCompleteUpgrade" }
    if k == 11 { return "WinHttpWebSocketSend" }
    return "unknown"
}

// ─── helper: fn_group_name (4 group classification) ───
fn fn_group_name(k: int) -> str {
    if k >= 0 {
        if k <= 2 {
            return "session"
        }
    }
    if k >= 3 {
        if k <= 6 {
            return "request"
        }
    }
    if k >= 7 {
        if k <= 9 {
            return "options"
        }
    }
    if k >= 10 {
        if k <= 11 {
            return "websocket"
        }
    }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: WINHTTP fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_winhttp_core FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_winhttp_core FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 11 {
        panic("pe_winhttp_core FAIL [record_syscall_invoke] expected=fn_kind<=11 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_winhttp_core FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_winhttp_core FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pwh_append_row(pwh_syscall_invoke_path(), row)
}

// ─── record_session_event: WinHttpOpen/CloseHandle/Connect row ───
fn record_session_event(evt_id: int, s_kind: str, sess_synth: str, target_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_winhttp_core FAIL [record_session_event] evt_id<=0") }
    if s_kind == "" { panic("pe_winhttp_core FAIL [record_session_event] s_kind=empty") }
    if sess_synth == "" { panic("pe_winhttp_core FAIL [record_session_event] sess_synth=empty") }
    if target_synth == "" { panic("pe_winhttp_core FAIL [record_session_event] target_synth=empty") }
    if status == "" { panic("pe_winhttp_core FAIL [record_session_event] status=empty") }
    let row = to_string(evt_id) + "\t" + s_kind + "\t" + sess_synth + "\t" + target_synth + "\t" + status + "\n"
    pwh_append_row(pwh_session_event_path(), row)
}

// ─── record_request_event: OpenRequest/SendRequest/ReceiveResponse/ReadData row ───
fn record_request_event(evt_id: int, r_kind: str, req_synth: str, body_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_winhttp_core FAIL [record_request_event] evt_id<=0") }
    if r_kind == "" { panic("pe_winhttp_core FAIL [record_request_event] r_kind=empty") }
    if req_synth == "" { panic("pe_winhttp_core FAIL [record_request_event] req_synth=empty") }
    if body_synth == "" { panic("pe_winhttp_core FAIL [record_request_event] body_synth=empty") }
    if status == "" { panic("pe_winhttp_core FAIL [record_request_event] status=empty") }
    let row = to_string(evt_id) + "\t" + r_kind + "\t" + req_synth + "\t" + body_synth + "\t" + status + "\n"
    pwh_append_row(pwh_request_event_path(), row)
}

// ─── record_options_event: SetOption/QueryOption/QueryHeaders row ───
fn record_options_event(evt_id: int, o_kind: str, target_synth: str, opt_synth: str, status: str) -> void {
    if evt_id <= 0 { panic("pe_winhttp_core FAIL [record_options_event] evt_id<=0") }
    if o_kind == "" { panic("pe_winhttp_core FAIL [record_options_event] o_kind=empty") }
    if target_synth == "" { panic("pe_winhttp_core FAIL [record_options_event] target_synth=empty") }
    if opt_synth == "" { panic("pe_winhttp_core FAIL [record_options_event] opt_synth=empty") }
