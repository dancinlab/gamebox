// lib/loader/pe_dpc_simulate.hexa — cycle 70 Deferred Procedure Call simulation telemetry
//
// kernel DPC (Deferred Procedure Call) 동작을 user-mode 에서 시뮬레이션 — driver /
// anti-cheat 가 kernel timer 동작 (importance level / cpu affinity / IRQL elevation)
// 을 probe 할 때 plausible telemetry 를 제공한다. 실 KeInsertQueueDpc / DPC ISR
// 호출 X — pure persistence tracker.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 DPC entry tracker — 실 kernel DPC 호출 X (stage6+).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// importance_kind code:
//   1 = low
//   2 = medium
//   3 = medium_high
//   4 = high
//
// elevated:
//   0 = IRQL 비상승 (passive)
//   1 = IRQL DISPATCH_LEVEL 상승
//
// persist schema (TSV — dpcs.tsv):
//   dpc_id<int> \t importance_kind<int> \t cpu_id<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pds_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dpc_simulate"
}

fn pds_dpcs_path() -> str {
    return pds_dir() + "/dpcs.tsv"
}

fn pds_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pds_dir() + "'")
}

fn cleanup_pds() -> void {
    pds_ensure_dir()
    let _ = exec("rm -f '" + pds_dpcs_path() + "'")
}

// ─── 공통 file IO ───
fn pds_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pds_append_row(path: str, row: str) -> void {
    pds_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dpc: DPC 1 건 기록 ───
fn record_dpc(dpc_id: int, importance_kind: int, cpu_id: int, elevated: int) -> void {
    if dpc_id <= 0 {
        panic("pe_dpc_simulate FAIL [record_dpc] expected=dpc_id>0 got=" + to_string(dpc_id))
    }
    if importance_kind < 1 {
        panic("pe_dpc_simulate FAIL [record_dpc] expected=importance_kind>=1 got=" + to_string(importance_kind))
    }
    if importance_kind > 4 {
        panic("pe_dpc_simulate FAIL [record_dpc] expected=importance_kind<=4 got=" + to_string(importance_kind))
    }
    if cpu_id < 0 {
        panic("pe_dpc_simulate FAIL [record_dpc] expected=cpu_id>=0 got=" + to_string(cpu_id))
    }
    if elevated < 0 {
        panic("pe_dpc_simulate FAIL [record_dpc] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_dpc_simulate FAIL [record_dpc] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(dpc_id) + "\t" + to_string(importance_kind)
        + "\t" + to_string(cpu_id) + "\t" + to_string(elevated) + "\n"
    pds_append_row(pds_dpcs_path(), row)
}

// ─── dpc_count: total DPC 수 ───
fn dpc_count() -> int {
    let t = pds_read_table(pds_dpcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_importance: 특정 importance_kind 의 DPC 수 ───
fn count_by_importance(importance_kind: int) -> int {
    let t = pds_read_table(pds_dpcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == importance_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── elevated_count: elevated=1 인 DPC 수 ───
fn elevated_count() -> int {
    let t = pds_read_table(pds_dpcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── distinct_cpus: 사용된 cpu_id 의 distinct 수 ───
fn distinct_cpus() -> int {
    let t = pds_read_table(pds_dpcs_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut seen = []
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                let cid = to_int(parts[2])
                let mut found = false
                let j = 0
                while j < len(seen) {
                    if seen[j] == cid {
                        found = true
                    }
                    j = j + 1
                }
                if !found {
                    seen.push(cid)
                }
            }
        }
        i = i + 1
    }
    return len(seen)
}

// ─── dpc_cpu_id: 특정 dpc_id 의 cpu_id (없으면 -1) ───
fn dpc_cpu_id(dpc_id: int) -> int {
    let t = pds_read_table(pds_dpcs_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == dpc_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pds_stats: [dpc_count, elevated_count, distinct_cpus, count_by_importance(3)] ───
fn pds_stats() -> array {
    let mut out = []
    out.push(dpc_count())
    out.push(elevated_count())
    out.push(distinct_cpus())
    out.push(count_by_importance(3))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pds-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pds()

    // 2. record 5 DPCs (≥3 importance_kinds, ≥2 cpu_ids, ≥2 elevated)
    record_dpc(170001, 1, 0, 0)
    r0_emit("pe_dpc_simulate_record",
        "\"dpc_id\":170001,\"importance_kind\":1,\"cpu_id\":0,\"elevated\":0,\"target\":\"low\"")

    record_dpc(170002, 2, 0, 1)
    r0_emit("pe_dpc_simulate_record",
        "\"dpc_id\":170002,\"importance_kind\":2,\"cpu_id\":0,\"elevated\":1,\"target\":\"medium\"")

    record_dpc(170003, 3, 1, 0)
    r0_emit("pe_dpc_simulate_record",
        "\"dpc_id\":170003,\"importance_kind\":3,\"cpu_id\":1,\"elevated\":0,\"target\":\"medium_high\"")

    record_dpc(170004, 3, 1, 1)
    r0_emit("pe_dpc_simulate_record",
        "\"dpc_id\":170004,\"importance_kind\":3,\"cpu_id\":1,\"elevated\":1,\"target\":\"medium_high\"")

    record_dpc(170005, 4, 1, 0)
    r0_emit("pe_dpc_simulate_record",
        "\"dpc_id\":170005,\"importance_kind\":4,\"cpu_id\":1,\"elevated\":0,\"target\":\"high\"")

    // 3. dpc_count = 5
    let c = dpc_count()
    if c != 5 {
        panic("pe_dpc_simulate FAIL [dpc_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_importance sanity
    let i1 = count_by_importance(1)
    if i1 != 1 {
        panic("pe_dpc_simulate FAIL [count_by_importance(1)] expected=1 got=" + to_string(i1))
    }
    let i2 = count_by_importance(2)
    if i2 != 1 {
        panic("pe_dpc_simulate FAIL [count_by_importance(2)] expected=1 got=" + to_string(i2))
    }
    let i3 = count_by_importance(3)
    if i3 != 2 {
        panic("pe_dpc_simulate FAIL [count_by_importance(3)] expected=2 got=" + to_string(i3))
    }
    let i4 = count_by_importance(4)
    if i4 != 1 {
        panic("pe_dpc_simulate FAIL [count_by_importance(4)] expected=1 got=" + to_string(i4))
    }
    let i99 = count_by_importance(99)
    if i99 != 0 {
        panic("pe_dpc_simulate FAIL [count_by_importance(99)] expected=0 got=" + to_string(i99))
    }

    // 5. elevated_count = 2
    let ec = elevated_count()
    if ec != 2 {
        panic("pe_dpc_simulate FAIL [elevated_count] expected=2 got=" + to_string(ec))
    }

    // 6. distinct_cpus = 2 (cpu 0, 1)
    let dc = distinct_cpus()
    if dc != 2 {
        panic("pe_dpc_simulate FAIL [distinct_cpus] expected=2 got=" + to_string(dc))
    }

    // 7. dpc_cpu_id sanity
    let cpu2 = dpc_cpu_id(170002)
    if cpu2 != 0 {
        panic("pe_dpc_simulate FAIL [dpc_cpu_id(170002)] expected=0 got=" + to_string(cpu2))
    }
    let cpu4 = dpc_cpu_id(170004)
    if cpu4 != 1 {
        panic("pe_dpc_simulate FAIL [dpc_cpu_id(170004)] expected=1 got=" + to_string(cpu4))
    }
    let cpu_miss = dpc_cpu_id(9999)
    if cpu_miss != -1 {
        panic("pe_dpc_simulate FAIL [dpc_cpu_id(9999)] expected=-1 got=" + to_string(cpu_miss))
    }

    // 8. pds_stats() = [5, 2, 2, 2]
    let s = pds_stats()
    if len(s) != 4 {
        panic("pe_dpc_simulate FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_dpc_simulate FAIL [stats dpc_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 2 {
        panic("pe_dpc_simulate FAIL [stats elevated_count] expected=2 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_dpc_simulate FAIL [stats distinct_cpus] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_dpc_simulate FAIL [stats count_imp(3)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_dpc_simulate_stats",
        "\"dpc_count\":" + to_string(s[0])
        + ",\"elevated_count\":" + to_string(s[1])
        + ",\"distinct_cpus\":" + to_string(s[2])
        + ",\"imp_medium_high\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_dpc_simulate FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pds()
    let s2 = pds_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dpc_simulate FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dpc_simulate self_test PASS (dpcs=" + to_string(s[0])
        + ", elevated=" + to_string(s[1]) + ", cpus=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pds_stats()
            println("dpc_count\t" + to_string(s[0]))
            println("elevated_count\t" + to_string(s[1]))
            println("distinct_cpus\t" + to_string(s[2]))
            println("count_imp_medium_high\t" + to_string(s[3]))
            return
        }
        if sub == "cpu" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("dpc_cpu_id\t" + to_string(dpc_cpu_id(did)))
                return
            }
            println("usage: hexa run pe_dpc_simulate.hexa cpu <dpc_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let imp = to_int(a[3])
                println("count_by_importance\t" + to_string(count_by_importance(imp)))
                return
            }
            println("usage: hexa run pe_dpc_simulate.hexa count <importance_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pds()
            println("cleaned: " + pds_dir())
            return
        }
        if sub == "dir" {
            println(pds_dir())
            return
        }
    }
    println("usage: hexa run pe_dpc_simulate.hexa { self-test | stats | cpu <dpc_id> | count <importance_kind> | cleanup | dir }")
}
