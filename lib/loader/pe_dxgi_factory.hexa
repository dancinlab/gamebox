// lib/loader/pe_dxgi_factory.hexa — cycle76 DXGI IDXGIFactory6/7 telemetry skeleton
//
// IDXGIFactory6/7::EnumAdapters / EnumAdapterByGpuPreference / EnumWarpAdapter /
// IDXGIAdapter::EnumOutputs telemetry tracker. GPU adapter discovery + display
// attachment query. 실 DXGI / D3D 호출 X — enum-id 별 adapter_count / high_perf
// 만 기록.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 factory enum tracker — IDXGIFactory 인스턴스 생성 / EnumAdapters
//   호출 X.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// enum_kind code:
//   1 = adapters             (IDXGIFactory::EnumAdapters)
//   2 = outputs              (IDXGIAdapter::EnumOutputs)
//   3 = adapters_warp        (IDXGIFactory4::EnumWarpAdapter)
//   4 = adapters_high_perf   (IDXGIFactory6::EnumAdapterByGpuPreference)
//
// high_perf flag:
//   0 = default / unspecified
//   1 = HIGH_PERFORMANCE GPU preference 적용
//
// persist schema (TSV — enums.tsv):
//   enum_id<int> \t enum_kind<int> \t adapter_count<int> \t high_perf<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdf_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_dxgi_factory"
}

fn pdf_enums_path() -> str {
    return pdf_dir() + "/enums.tsv"
}

fn pdf_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdf_dir() + "'")
}

fn cleanup_pdf() -> void {
    pdf_ensure_dir()
    let _ = exec("rm -f '" + pdf_enums_path() + "'")
}

// ─── 공통 file IO ───
fn pdf_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdf_append_row(path: str, row: str) -> void {
    pdf_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_enum: factory enum 1 건 기록 ───
fn record_enum(enum_id: int, enum_kind: int, adapter_count: int, high_perf: int) -> void {
    if enum_id <= 0 {
        panic("pe_dxgi_factory FAIL [record_enum] expected=enum_id>0 got=" + to_string(enum_id))
    }
    if enum_kind < 1 {
        panic("pe_dxgi_factory FAIL [record_enum] expected=enum_kind>=1 got=" + to_string(enum_kind))
    }
    if enum_kind > 4 {
        panic("pe_dxgi_factory FAIL [record_enum] expected=enum_kind<=4 got=" + to_string(enum_kind))
    }
    if adapter_count < 0 {
        panic("pe_dxgi_factory FAIL [record_enum] expected=adapter_count>=0 got=" + to_string(adapter_count))
    }
    if high_perf < 0 {
        panic("pe_dxgi_factory FAIL [record_enum] expected=high_perf>=0 got=" + to_string(high_perf))
    }
    if high_perf > 1 {
        panic("pe_dxgi_factory FAIL [record_enum] expected=high_perf<=1 got=" + to_string(high_perf))
    }
    let row = to_string(enum_id) + "\t" + to_string(enum_kind)
        + "\t" + to_string(adapter_count) + "\t" + to_string(high_perf) + "\n"
    pdf_append_row(pdf_enums_path(), row)
}

// ─── enum_count: total enum 수 ───
fn enum_count() -> int {
    let t = pdf_read_table(pdf_enums_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_adapter_count: 모든 enum adapter_count 합 ───
fn total_adapter_count() -> int {
    let t = pdf_read_table(pdf_enums_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_enum_kind: 특정 enum_kind 의 enum 수 ───
fn count_by_enum_kind(kind: int) -> int {
    let t = pdf_read_table(pdf_enums_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── high_perf_count: high_perf=1 인 enum 수 ───
fn high_perf_count() -> int {
    let t = pdf_read_table(pdf_enums_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── enum_adapter_count: 특정 enum_id 의 adapter_count (없으면 0) ───
fn enum_adapter_count(enum_id: int) -> int {
    let t = pdf_read_table(pdf_enums_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == enum_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdf_stats: [enum_count, total_adapter_count, count_by_enum_kind(1), high_perf_count] ───
fn pdf_stats() -> array {
    let mut out = []
    out.push(enum_count())
    out.push(total_adapter_count())
    out.push(count_by_enum_kind(1))
    out.push(high_perf_count())
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdf-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdf()

    // 2. record 5 enums across 3 enum_kinds (1, 2, 4) with 2 high_perf
    record_enum(760101, 1, 2, 0)
    r0_emit("pe_dxgi_factory_record",
        "\"enum_id\":760101,\"enum_kind\":1,\"adapter_count\":2,\"high_perf\":0,\"target\":\"adapters\"")

    record_enum(760102, 1, 3, 0)
    r0_emit("pe_dxgi_factory_record",
        "\"enum_id\":760102,\"enum_kind\":1,\"adapter_count\":3,\"high_perf\":0,\"target\":\"adapters\"")

    record_enum(760103, 2, 4, 0)
    r0_emit("pe_dxgi_factory_record",
        "\"enum_id\":760103,\"enum_kind\":2,\"adapter_count\":4,\"high_perf\":0,\"target\":\"outputs\"")

    record_enum(760104, 4, 2, 1)
    r0_emit("pe_dxgi_factory_record",
        "\"enum_id\":760104,\"enum_kind\":4,\"adapter_count\":2,\"high_perf\":1,\"target\":\"adapters_high_perf\"")

    record_enum(760105, 4, 1, 1)
    r0_emit("pe_dxgi_factory_record",
        "\"enum_id\":760105,\"enum_kind\":4,\"adapter_count\":1,\"high_perf\":1,\"target\":\"adapters_high_perf\"")

    // 3. enum_count = 5
    let c = enum_count()
    if c != 5 {
        panic("pe_dxgi_factory FAIL [enum_count] expected=5 got=" + to_string(c))
    }

    // 4. total_adapter_count = 2+3+4+2+1 = 12
    let tac = total_adapter_count()
    if tac != 12 {
        panic("pe_dxgi_factory FAIL [total_adapter_count] expected=12 got=" + to_string(tac))
    }

    // 5. count_by_enum_kind sanity
    let k1 = count_by_enum_kind(1)
    if k1 != 2 {
        panic("pe_dxgi_factory FAIL [count_by_enum_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_enum_kind(2)
    if k2 != 1 {
        panic("pe_dxgi_factory FAIL [count_by_enum_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_enum_kind(3)
    if k3 != 0 {
        panic("pe_dxgi_factory FAIL [count_by_enum_kind(3)] expected=0 got=" + to_string(k3))
    }
    let k4 = count_by_enum_kind(4)
    if k4 != 2 {
        panic("pe_dxgi_factory FAIL [count_by_enum_kind(4)] expected=2 got=" + to_string(k4))
    }
    let k99 = count_by_enum_kind(99)
    if k99 != 0 {
        panic("pe_dxgi_factory FAIL [count_by_enum_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. high_perf_count = 2
    let hp = high_perf_count()
    if hp != 2 {
        panic("pe_dxgi_factory FAIL [high_perf_count] expected=2 got=" + to_string(hp))
    }

    // 7. enum_adapter_count sanity
    let a1 = enum_adapter_count(760102)
    if a1 != 3 {
        panic("pe_dxgi_factory FAIL [enum_adapter_count(760102)] expected=3 got=" + to_string(a1))
    }
    let a2 = enum_adapter_count(760103)
    if a2 != 4 {
        panic("pe_dxgi_factory FAIL [enum_adapter_count(760103)] expected=4 got=" + to_string(a2))
    }
    let a_miss = enum_adapter_count(9999)
    if a_miss != 0 {
        panic("pe_dxgi_factory FAIL [enum_adapter_count(9999)] expected=0 got=" + to_string(a_miss))
    }

    // 8. pdf_stats() = [5, 12, 2, 2]
    let s = pdf_stats()
    if len(s) != 4 {
        panic("pe_dxgi_factory FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_dxgi_factory FAIL [stats enum_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 12 {
        panic("pe_dxgi_factory FAIL [stats total_adapter_count] expected=12 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_dxgi_factory FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_dxgi_factory FAIL [stats high_perf] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_dxgi_factory_stats",
        "\"enum_count\":" + to_string(s[0])
        + ",\"total_adapter_count\":" + to_string(s[1])
        + ",\"kind_adapters\":" + to_string(s[2])
        + ",\"high_perf\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_dxgi_factory FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdf()
    let s2 = pdf_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_dxgi_factory FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_dxgi_factory self_test PASS (enums=" + to_string(s[0])
        + ", adapters=" + to_string(s[1]) + ", high_perf=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdf_stats()
            println("enum_count\t" + to_string(s[0]))
            println("total_adapter_count\t" + to_string(s[1]))
            println("count_kind_adapters\t" + to_string(s[2]))
            println("high_perf_count\t" + to_string(s[3]))
            return
        }
        if sub == "adapters" {
            if len(a) >= 4 {
                let eid = to_int(a[3])
                println("enum_adapter_count\t" + to_string(enum_adapter_count(eid)))
                return
            }
            println("usage: hexa run pe_dxgi_factory.hexa adapters <enum_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_enum_kind\t" + to_string(count_by_enum_kind(kind)))
                return
            }
            println("usage: hexa run pe_dxgi_factory.hexa count <enum_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdf()
            println("cleaned: " + pdf_dir())
            return
        }
        if sub == "dir" {
            println(pdf_dir())
            return
        }
    }
    println("usage: hexa run pe_dxgi_factory.hexa { self-test | stats | adapters <enum_id> | count <enum_kind> | cleanup | dir }")
}
