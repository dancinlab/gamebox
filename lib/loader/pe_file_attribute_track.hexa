// lib/loader/pe_file_attribute_track.hexa — cycle 73 file attribute tracker skeleton
//
// Win32 GetFileAttributes / SetFileAttributesEx → BSD chmod / lchmod bridge.
// READONLY / HIDDEN / SYSTEM / ARCHIVE / REPARSE_POINT 등 attribute flag access
// 를 추적한다. 본 module 은 attribute op tracker — 실 chmod() / lchmod() 호출 X
// (stage6 native helper bridge 가 담당).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// op_kind code:
//   1 = get          (GetFileAttributes / GetFileAttributesEx)
//   2 = set          (SetFileAttributes)
//   3 = set_ex       (SetFileAttributesEx)
//
// handle_kind code:
//   1 = path         (path-string 기반 op)
//   2 = handle       (HANDLE 기반 op)
//
// attribute_flags = Win32 FILE_ATTRIBUTE_* bitmask (READONLY=0x1, HIDDEN=0x2,
// SYSTEM=0x4, ARCHIVE=0x20, REPARSE_POINT=0x400 …)
//
// persist schema (TSV — ops.tsv):
//   op_id<int> \t op_kind<int> \t attribute_flags<int> \t handle_kind<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pfat_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_file_attribute_track"
}

fn pfat_ops_path() -> str {
    return pfat_dir() + "/ops.tsv"
}

fn pfat_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pfat_dir() + "'")
}

fn cleanup_pfat() -> void {
    pfat_ensure_dir()
    let _ = exec("rm -f '" + pfat_ops_path() + "'")
}

// ─── 공통 file IO ───
fn pfat_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pfat_append_row(path: str, row: str) -> void {
    pfat_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_op: attribute op 1 건 기록 ───
fn record_op(op_id: int, op_kind: int, attribute_flags: int, handle_kind: int) -> void {
    if op_id <= 0 {
        panic("pe_file_attribute_track FAIL [record_op] expected=op_id>0 got=" + to_string(op_id))
    }
    if op_kind < 1 {
        panic("pe_file_attribute_track FAIL [record_op] expected=op_kind>=1 got=" + to_string(op_kind))
    }
    if op_kind > 3 {
        panic("pe_file_attribute_track FAIL [record_op] expected=op_kind<=3 got=" + to_string(op_kind))
    }
    if attribute_flags < 0 {
        panic("pe_file_attribute_track FAIL [record_op] expected=attribute_flags>=0 got=" + to_string(attribute_flags))
    }
    if handle_kind < 1 {
        panic("pe_file_attribute_track FAIL [record_op] expected=handle_kind>=1 got=" + to_string(handle_kind))
    }
    if handle_kind > 2 {
        panic("pe_file_attribute_track FAIL [record_op] expected=handle_kind<=2 got=" + to_string(handle_kind))
    }
    let row = to_string(op_id) + "\t" + to_string(op_kind)
        + "\t" + to_string(attribute_flags) + "\t" + to_string(handle_kind) + "\n"
    pfat_append_row(pfat_ops_path(), row)
}

// ─── op_count: total op 수 ───
fn op_count() -> int {
    let t = pfat_read_table(pfat_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_attribute_flags: 모든 op attribute_flags 합 ───
fn total_attribute_flags() -> int {
    let t = pfat_read_table(pfat_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_op_kind: 특정 op_kind 의 op 수 ───
fn count_by_op_kind(kind: int) -> int {
    let t = pfat_read_table(pfat_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_handle_kind: 특정 handle_kind 의 op 수 ───
fn count_by_handle_kind(hk: int) -> int {
    let t = pfat_read_table(pfat_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == hk {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── op_attribute_flags: 특정 op_id 의 attribute_flags (없으면 0) ───
fn op_attribute_flags(op_id: int) -> int {
    let t = pfat_read_table(pfat_ops_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == op_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pfat_stats: [op_count, total_attribute_flags, count_by_op_kind(1), count_by_handle_kind(1)] ───
fn pfat_stats() -> array {
    let mut out = []
    out.push(op_count())
    out.push(total_attribute_flags())
    out.push(count_by_op_kind(1))
    out.push(count_by_handle_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pfat-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pfat()

    // 2. record 5 ops — 3 op_kinds (1=get, 2=set, 3=set_ex), 2 handle_kinds (1=path, 2=handle)
    //    READONLY=0x1, HIDDEN=0x2, SYSTEM=0x4, ARCHIVE=0x20, REPARSE_POINT=0x400
    record_op(120001, 1, 1, 1)         // get + READONLY + path
    r0_emit("pe_file_attribute_track_record",
        "\"op_id\":120001,\"op_kind\":1,\"attribute_flags\":1,\"handle_kind\":1,\"target\":\"get\"")

    record_op(120002, 1, 2, 2)         // get + HIDDEN + handle
    r0_emit("pe_file_attribute_track_record",
        "\"op_id\":120002,\"op_kind\":1,\"attribute_flags\":2,\"handle_kind\":2,\"target\":\"get\"")

    record_op(120003, 2, 4, 1)         // set + SYSTEM + path
    r0_emit("pe_file_attribute_track_record",
        "\"op_id\":120003,\"op_kind\":2,\"attribute_flags\":4,\"handle_kind\":1,\"target\":\"set\"")

    record_op(120004, 3, 32, 1)        // set_ex + ARCHIVE + path
    r0_emit("pe_file_attribute_track_record",
        "\"op_id\":120004,\"op_kind\":3,\"attribute_flags\":32,\"handle_kind\":1,\"target\":\"set_ex\"")

    record_op(120005, 1, 1024, 2)      // get + REPARSE_POINT + handle
    r0_emit("pe_file_attribute_track_record",
        "\"op_id\":120005,\"op_kind\":1,\"attribute_flags\":1024,\"handle_kind\":2,\"target\":\"get\"")

    // 3. op_count = 5
    let c = op_count()
    if c != 5 {
        panic("pe_file_attribute_track FAIL [op_count] expected=5 got=" + to_string(c))
    }

    // 4. total_attribute_flags = 1 + 2 + 4 + 32 + 1024 = 1063
    let tf = total_attribute_flags()
    if tf != 1063 {
        panic("pe_file_attribute_track FAIL [total_attribute_flags] expected=1063 got=" + to_string(tf))
    }

    // 5. count_by_op_kind sanity
    let k1 = count_by_op_kind(1)
    if k1 != 3 {
        panic("pe_file_attribute_track FAIL [count_by_op_kind(1)] expected=3 got=" + to_string(k1))
    }
    let k2 = count_by_op_kind(2)
    if k2 != 1 {
        panic("pe_file_attribute_track FAIL [count_by_op_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_op_kind(3)
    if k3 != 1 {
        panic("pe_file_attribute_track FAIL [count_by_op_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k99 = count_by_op_kind(99)
    if k99 != 0 {
        panic("pe_file_attribute_track FAIL [count_by_op_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_handle_kind sanity
    let h1 = count_by_handle_kind(1)
    if h1 != 3 {
        panic("pe_file_attribute_track FAIL [count_by_handle_kind(1)] expected=3 got=" + to_string(h1))
    }
    let h2 = count_by_handle_kind(2)
    if h2 != 2 {
        panic("pe_file_attribute_track FAIL [count_by_handle_kind(2)] expected=2 got=" + to_string(h2))
    }
    let h99 = count_by_handle_kind(99)
    if h99 != 0 {
        panic("pe_file_attribute_track FAIL [count_by_handle_kind(99)] expected=0 got=" + to_string(h99))
    }

    // 7. op_attribute_flags sanity
    let f1 = op_attribute_flags(120001)
    if f1 != 1 {
        panic("pe_file_attribute_track FAIL [op_attribute_flags(120001)] expected=1 got=" + to_string(f1))
    }
    let f5 = op_attribute_flags(120005)
    if f5 != 1024 {
        panic("pe_file_attribute_track FAIL [op_attribute_flags(120005)] expected=1024 got=" + to_string(f5))
    }
    let f_miss = op_attribute_flags(9999)
    if f_miss != 0 {
        panic("pe_file_attribute_track FAIL [op_attribute_flags(9999)] expected=0 got=" + to_string(f_miss))
    }

    // 8. pfat_stats() = [5, 1063, 3, 3]
    let s = pfat_stats()
    if len(s) != 4 {
        panic("pe_file_attribute_track FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_file_attribute_track FAIL [stats op_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 1063 {
        panic("pe_file_attribute_track FAIL [stats total_attribute_flags] expected=1063 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_file_attribute_track FAIL [stats count_kind_get] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 3 {
        panic("pe_file_attribute_track FAIL [stats count_handle_path] expected=3 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_file_attribute_track_stats",
        "\"op_count\":" + to_string(s[0])
        + ",\"total_attribute_flags\":" + to_string(s[1])
        + ",\"kind_get\":" + to_string(s[2])
        + ",\"handle_path\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_file_attribute_track FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pfat()
    let s2 = pfat_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_file_attribute_track FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_file_attribute_track self_test PASS (ops=" + to_string(s[0])
        + ", flags=" + to_string(s[1]) + ", kind_get=" + to_string(s[2])
        + ", handle_path=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pfat_stats()
            println("op_count\t" + to_string(s[0]))
            println("total_attribute_flags\t" + to_string(s[1]))
            println("count_kind_get\t" + to_string(s[2]))
            println("count_handle_path\t" + to_string(s[3]))
            return
        }
        if sub == "flags" {
            if len(a) >= 4 {
                let oid = to_int(a[3])
                println("op_attribute_flags\t" + to_string(op_attribute_flags(oid)))
                return
            }
            println("usage: hexa run pe_file_attribute_track.hexa flags <op_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_op_kind\t" + to_string(count_by_op_kind(kind)))
                return
            }
            println("usage: hexa run pe_file_attribute_track.hexa count <op_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pfat()
            println("cleaned: " + pfat_dir())
            return
        }
        if sub == "dir" {
            println(pfat_dir())
            return
        }
    }
    println("usage: hexa run pe_file_attribute_track.hexa { self-test | stats | flags <op_id> | count <op_kind> | cleanup | dir }")
}
