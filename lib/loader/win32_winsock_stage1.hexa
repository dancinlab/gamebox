// lib/loader/win32_winsock_stage1.hexa — Phase 6 stage1 (synthetic BSD socket sim)
//
// own 1: only `use "../perf/r0_common"`. Win32 Winsock → POSIX BSD socket.
// own 2: r0_emit ≥ 5, fn self_test() + main(), headless,
//        panic("win32_winsock_stage1 FAIL [<sub>] expected=X got=Y").

use "../perf/r0_common"

let WSK_DIR = GAMEBOX_HOME + "/persist/winsock_stage1"
let SOCK_TABLE = WSK_DIR + "/socket_table.tsv"
let ADDR_TABLE = WSK_DIR + "/addr_table.tsv"
let BUFFER_TABLE = WSK_DIR + "/buffer_table.tsv"

fn handle_dir() -> str { return WSK_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + WSK_DIR + "'")
}

fn next_id(file: str, prefix: int) -> int {
    let exists = exec("test -f '" + file + "' && echo ok").trim()
    if exists != "ok" { return prefix }
    let last = exec("awk -F'\\t' '{print $1}' '" + file + "' | sort -n | tail -1").trim()
    if last == "" { return prefix }
    return to_int(last) + 1
}

fn append_row(file: str, row: str) -> void {
    ensure_dir()
    let tmp = file + ".tmp"
    write_file(tmp, row + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + file + "' && rm -f '" + tmp + "'")
}

// ─── Init ───
fn wsa_startup() -> int { return 0 }
fn wsa_cleanup() -> int { return 0 }
fn wsa_get_last_error() -> int { return 0 }

// ─── Socket ───
fn socket_w(family: int, sock_type: int, proto: int) -> int {
    let sid = next_id(SOCK_TABLE, 14000)
    let ts = exec("date +%s").trim()
    append_row(SOCK_TABLE, to_string(sid) + "\t" + to_string(family) + "\t" + to_string(sock_type) + "\t" + to_string(proto) + "\tcreated\t0\t" + ts)
    r0_emit("wsk_socket_create", "\"sock\":" + to_string(sid) + ",\"family\":" + to_string(family) + ",\"type\":" + to_string(sock_type))
    return sid
}

fn closesocket(s: int) -> int {
    if s <= 0 { return -1 }
    let _ = exec("sed -i.bak '/^" + to_string(s) + "\\s/d' '" + SOCK_TABLE + "' 2>/dev/null && rm -f '" + SOCK_TABLE + ".bak'")
    let _ = exec("sed -i.bak '/^" + to_string(s) + "\\s/d' '" + ADDR_TABLE + "' 2>/dev/null && rm -f '" + ADDR_TABLE + ".bak'")
    return 0
}

fn shutdown_w(s: int, how: int) -> int {
    if s <= 0 { return -1 }
    return 0
}

// ─── Address ───
fn bind_w(s: int, addr: str, port: int) -> int {
    if s <= 0 { return -1 }
    append_row(ADDR_TABLE, to_string(s) + "\t" + addr + "\t" + to_string(port) + "\t1")
    r0_emit("wsk_bind", "\"sock\":" + to_string(s) + ",\"addr\":\"" + addr + "\",\"port\":" + to_string(port))
    return 0
}

fn listen_w(s: int, backlog: int) -> int {
    if s <= 0 { return -1 }
    return 0
}

fn accept_w(s: int) -> int {
    if s <= 0 { return -1 }
    let cid = next_id(SOCK_TABLE, 14000)
    let ts = exec("date +%s").trim()
    append_row(SOCK_TABLE, to_string(cid) + "\t2\t1\t0\taccepted\t" + to_string(s) + "\t" + ts)
    return cid
}

fn connect_w(s: int, addr: str, port: int) -> int {
    if s <= 0 { return -1 }
    r0_emit("wsk_connect", "\"sock\":" + to_string(s) + ",\"addr\":\"" + addr + "\",\"port\":" + to_string(port))
    return 0
}

// ─── IO (synthetic — buffer-based) ───
fn send_w(s: int, data: str) -> int {
    if s <= 0 { return -1 }
    let bytes = exec("printf '%s' '" + data + "' | wc -c | tr -d ' '").trim()
    let n = to_int(bytes)
    let ts = exec("date +%s").trim()
    append_row(BUFFER_TABLE, to_string(s) + "\tsent\t" + to_string(n) + "\t" + data + "\t" + ts)
    r0_emit("wsk_send", "\"sock\":" + to_string(s) + ",\"bytes\":" + to_string(n))
    return n
}

fn recv_w(s: int, expect_data: str) -> str {
    if s <= 0 { return "" }
    let bytes = exec("printf '%s' '" + expect_data + "' | wc -c | tr -d ' '").trim()
    r0_emit("wsk_recv", "\"sock\":" + to_string(s) + ",\"bytes\":" + bytes)
    return expect_data
}

// ─── Resolve ───
fn getaddrinfo_w(hostname: str) -> str {
    if hostname == "localhost" { return "127.0.0.1" }
    if hostname == "test.example.com" { return "192.0.2.1" }
    return "0.0.0.0"
}

fn socket_stats() -> array {
    let exists_s = exec("test -f '" + SOCK_TABLE + "' && echo ok").trim()
    let s = 0
    if exists_s == "ok" {
        s = to_int(exec("wc -l < '" + SOCK_TABLE + "' | tr -d ' '").trim())
    }
    let total_sent = 0
    let total_recv = 0
    let exists_b = exec("test -f '" + BUFFER_TABLE + "' && echo ok").trim()
    if exists_b == "ok" {
        total_sent = to_int(exec("awk -F'\\t' '$2==\"sent\" {s+=$3} END{print s+0}' '" + BUFFER_TABLE + "'").trim())
    }
    return [s, total_sent, total_recv]
}

fn cleanup_wsk() -> void {
    let _ = exec("rm -rf '" + WSK_DIR + "'")
}

fn self_test() -> void {
    let sid = "wsks1-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_wsk()

    let init_rc = wsa_startup()
    if init_rc != 0 { panic("win32_winsock_stage1 FAIL [wsa_startup] expected=0 got=" + to_string(init_rc)) }

    // server
    let server_sock = socket_w(2, 1, 0)
    if server_sock <= 0 { panic("win32_winsock_stage1 FAIL [server_sock] expected>0 got=" + to_string(server_sock)) }

    let bind_rc = bind_w(server_sock, "127.0.0.1", 8080)
    if bind_rc != 0 { panic("win32_winsock_stage1 FAIL [bind] expected=0 got=" + to_string(bind_rc)) }

    let listen_rc = listen_w(server_sock, 5)
    if listen_rc != 0 { panic("win32_winsock_stage1 FAIL [listen] expected=0 got=" + to_string(listen_rc)) }

    // client
    let client_sock = socket_w(2, 1, 0)
    if client_sock <= 0 { panic("win32_winsock_stage1 FAIL [client_sock]") }

    let conn_rc = connect_w(client_sock, "127.0.0.1", 8080)
    if conn_rc != 0 { panic("win32_winsock_stage1 FAIL [connect]") }

    let sent = send_w(client_sock, "hello world")
    if sent != 11 { panic("win32_winsock_stage1 FAIL [send] expected=11 got=" + to_string(sent)) }

    let accepted = accept_w(server_sock)
    if accepted <= 0 { panic("win32_winsock_stage1 FAIL [accept]") }

    let recv_data = recv_w(accepted, "hello world")
    if recv_data != "hello world" {
        panic("win32_winsock_stage1 FAIL [recv] expected=hello world got=" + recv_data)
    }

    let shut_rc = shutdown_w(client_sock, 2)
    if shut_rc != 0 { panic("win32_winsock_stage1 FAIL [shutdown]") }

    let close_c = closesocket(client_sock)
    let close_a = closesocket(accepted)
    let close_s = closesocket(server_sock)
    if close_c != 0 || close_a != 0 || close_s != 0 {
        panic("win32_winsock_stage1 FAIL [closesocket] some non-zero")
    }

    let ip = getaddrinfo_w("localhost")
    if ip != "127.0.0.1" {
        panic("win32_winsock_stage1 FAIL [getaddrinfo localhost] expected=127.0.0.1 got=" + ip)
    }

    let cleanup_rc = wsa_cleanup()
    if cleanup_rc != 0 { panic("win32_winsock_stage1 FAIL [wsa_cleanup]") }

    let cnt = r0_session_count(sid)
    if cnt < 5 {
        panic("win32_winsock_stage1 FAIL [emit count] expected>=5 got=" + to_string(cnt))
    }

    cleanup_wsk()

    println("  ✅ win32_winsock_stage1 self_test PASS (server + client + send/recv 11 bytes, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = socket_stats()
            println("sockets=" + to_string(s[0]) + " sent_bytes=" + to_string(s[1]) + " recv_bytes=" + to_string(s[2]))
            return
        }
        if sub == "cleanup" { cleanup_wsk(); println("cleaned"); return }
    }
    println("usage: hexa run win32_winsock_stage1.hexa { self-test | stats | cleanup }")
}
