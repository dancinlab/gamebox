// lib/loader/pe_signal_translation.hexa — cycle70 Mach/POSIX signal → Win32 EXCEPTION_RECORD translation skeleton
//
// macOS host runtime 가 SIGSEGV / SIGFPE / SIGILL / SIGTRAP / SIGABRT 등을
// 받았을 때 Win32 PE 의 EXCEPTION_RECORD (ExceptionCode + ExceptionAddress)
// 으로 정규화. faulting_addr 는 KB 단위 정수로 압축 (TSV row 친화).
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 signal translation tracker — 실 sigaction() / Mach exception
//   port 등록 X (stage6).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// posix_signal code (참고치):
//    4 = SIGILL
//    5 = SIGTRAP
//    6 = SIGABRT
//    8 = SIGFPE
//   11 = SIGSEGV
//
// win32_exception code (참고치, NTSTATUS):
//   0xC0000005 = EXCEPTION_ACCESS_VIOLATION       (SIGSEGV)
//   0xC000008C = EXCEPTION_FLT_DENORMAL_OPERAND   (SIGFPE — denormal)
//   0xC000008D = EXCEPTION_FLT_DIVIDE_BY_ZERO     (SIGFPE — div0)
//   0xC000008E = EXCEPTION_FLT_INEXACT_RESULT     (SIGFPE — inexact)
//   0xC000001D = EXCEPTION_ILLEGAL_INSTRUCTION    (SIGILL)
//   0x80000003 = EXCEPTION_BREAKPOINT             (SIGTRAP)
//   0xC0000354 = EXCEPTION_NONCONTINUABLE         (SIGABRT)
//
// persist schema (TSV — signals.tsv):
//   signal_id<int> \t posix_signal<int> \t win32_exception<int> \t faulting_addr_kb<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pst_sig_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_signal_translation"
}

fn pst_sig_signals_path() -> str {
    return pst_sig_dir() + "/signals.tsv"
}

fn pst_sig_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pst_sig_dir() + "'")
}

fn cleanup_pst_sig() -> void {
    pst_sig_ensure_dir()
    let _ = exec("rm -f '" + pst_sig_signals_path() + "'")
}

// ─── 공통 file IO ───
fn pst_sig_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pst_sig_append_row(path: str, row: str) -> void {
    pst_sig_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_signal: signal translation 1 건 기록 ───
fn record_signal(signal_id: int, posix_signal: int, win32_exception: int, faulting_addr_kb: int) -> void {
    if signal_id <= 0 {
        panic("pe_signal_translation FAIL [record_signal] expected=signal_id>0 got=" + to_string(signal_id))
    }
    if posix_signal < 1 {
        panic("pe_signal_translation FAIL [record_signal] expected=posix_signal>=1 got=" + to_string(posix_signal))
    }
    if posix_signal > 64 {
        panic("pe_signal_translation FAIL [record_signal] expected=posix_signal<=64 got=" + to_string(posix_signal))
    }
    if win32_exception < 0 {
        panic("pe_signal_translation FAIL [record_signal] expected=win32_exception>=0 got=" + to_string(win32_exception))
    }
    if faulting_addr_kb < 0 {
        panic("pe_signal_translation FAIL [record_signal] expected=faulting_addr_kb>=0 got=" + to_string(faulting_addr_kb))
    }
    let row = to_string(signal_id) + "\t" + to_string(posix_signal)
        + "\t" + to_string(win32_exception) + "\t" + to_string(faulting_addr_kb) + "\n"
    pst_sig_append_row(pst_sig_signals_path(), row)
}

// ─── signal_count: total signal 수 ───
fn signal_count() -> int {
    let t = pst_sig_read_table(pst_sig_signals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_posix: 특정 posix_signal 의 signal 수 ───
fn count_by_posix(posix_signal: int) -> int {
    let t = pst_sig_read_table(pst_sig_signals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == posix_signal {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_win32: 특정 win32_exception 의 signal 수 ───
fn count_by_win32(win32_exception: int) -> int {
    let t = pst_sig_read_table(pst_sig_signals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == win32_exception {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_faulting_kb: 모든 signal faulting_addr_kb 합 ───
fn total_faulting_kb() -> int {
    let t = pst_sig_read_table(pst_sig_signals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── signal_faulting_kb: 특정 signal_id 의 faulting_addr_kb (없으면 0) ───
fn signal_faulting_kb(signal_id: int) -> int {
    let t = pst_sig_read_table(pst_sig_signals_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == signal_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pst_sig_stats: [signal_count, total_faulting_kb, count_by_posix(11), count_by_posix(8)] ───
fn pst_sig_stats() -> array {
    let mut out = []
    out.push(signal_count())
    out.push(total_faulting_kb())
    out.push(count_by_posix(11))
    out.push(count_by_posix(8))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pst-sig-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pst_sig()

    // 2. record 5 signals (≥3 posix_signals: 11/8/4 + 11 dup + 5)
    //    SIGSEGV → EXCEPTION_ACCESS_VIOLATION
    record_signal(700001, 11, 3221225477, 4096)
    r0_emit("pe_signal_translation_record",
        "\"signal_id\":700001,\"posix_signal\":11,\"win32_exception\":3221225477,\"faulting_addr_kb\":4096,\"target\":\"SIGSEGV\"")

    //    SIGFPE → EXCEPTION_FLT_DIVIDE_BY_ZERO
    record_signal(700002, 8, 3221225613, 8192)
    r0_emit("pe_signal_translation_record",
        "\"signal_id\":700002,\"posix_signal\":8,\"win32_exception\":3221225613,\"faulting_addr_kb\":8192,\"target\":\"SIGFPE_DIV0\"")

    //    SIGILL → EXCEPTION_ILLEGAL_INSTRUCTION
    record_signal(700003, 4, 3221225501, 12288)
    r0_emit("pe_signal_translation_record",
        "\"signal_id\":700003,\"posix_signal\":4,\"win32_exception\":3221225501,\"faulting_addr_kb\":12288,\"target\":\"SIGILL\"")

    //    SIGSEGV (dup posix) → EXCEPTION_ACCESS_VIOLATION
    record_signal(700004, 11, 3221225477, 16384)
    r0_emit("pe_signal_translation_record",
        "\"signal_id\":700004,\"posix_signal\":11,\"win32_exception\":3221225477,\"faulting_addr_kb\":16384,\"target\":\"SIGSEGV\"")

    //    SIGTRAP → EXCEPTION_BREAKPOINT
    record_signal(700005, 5, 2147483651, 2048)
    r0_emit("pe_signal_translation_record",
        "\"signal_id\":700005,\"posix_signal\":5,\"win32_exception\":2147483651,\"faulting_addr_kb\":2048,\"target\":\"SIGTRAP\"")

    // 3. signal_count = 5
    let c = signal_count()
    if c != 5 {
        panic("pe_signal_translation FAIL [signal_count] expected=5 got=" + to_string(c))
    }

    // 4. total_faulting_kb = 4096 + 8192 + 12288 + 16384 + 2048 = 43008
    let tk = total_faulting_kb()
    if tk != 43008 {
        panic("pe_signal_translation FAIL [total_faulting_kb] expected=43008 got=" + to_string(tk))
    }

    // 5. count_by_posix sanity
    let p11 = count_by_posix(11)
    if p11 != 2 {
        panic("pe_signal_translation FAIL [count_by_posix(11)] expected=2 got=" + to_string(p11))
    }
    let p8 = count_by_posix(8)
    if p8 != 1 {
        panic("pe_signal_translation FAIL [count_by_posix(8)] expected=1 got=" + to_string(p8))
    }
    let p4 = count_by_posix(4)
    if p4 != 1 {
        panic("pe_signal_translation FAIL [count_by_posix(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_posix(5)
    if p5 != 1 {
        panic("pe_signal_translation FAIL [count_by_posix(5)] expected=1 got=" + to_string(p5))
    }
    let p99 = count_by_posix(63)
    if p99 != 0 {
        panic("pe_signal_translation FAIL [count_by_posix(63)] expected=0 got=" + to_string(p99))
    }

    // 6. count_by_win32 sanity (EXCEPTION_ACCESS_VIOLATION = 0xC0000005 = 3221225477)
    let w_av = count_by_win32(3221225477)
    if w_av != 2 {
        panic("pe_signal_translation FAIL [count_by_win32(AV)] expected=2 got=" + to_string(w_av))
    }
    let w_div = count_by_win32(3221225613)
    if w_div != 1 {
        panic("pe_signal_translation FAIL [count_by_win32(DIV0)] expected=1 got=" + to_string(w_div))
    }
    let w_miss = count_by_win32(0)
    if w_miss != 0 {
        panic("pe_signal_translation FAIL [count_by_win32(0)] expected=0 got=" + to_string(w_miss))
    }

    // 7. signal_faulting_kb sanity
    let f2 = signal_faulting_kb(700002)
    if f2 != 8192 {
        panic("pe_signal_translation FAIL [signal_faulting_kb(700002)] expected=8192 got=" + to_string(f2))
    }
    let f4 = signal_faulting_kb(700004)
    if f4 != 16384 {
        panic("pe_signal_translation FAIL [signal_faulting_kb(700004)] expected=16384 got=" + to_string(f4))
    }
    let f_miss = signal_faulting_kb(9999)
    if f_miss != 0 {
        panic("pe_signal_translation FAIL [signal_faulting_kb(9999)] expected=0 got=" + to_string(f_miss))
    }

    // 8. pst_sig_stats() = [5, 43008, 2, 1]
    let s = pst_sig_stats()
    if len(s) != 4 {
        panic("pe_signal_translation FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_signal_translation FAIL [stats signal_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 43008 {
        panic("pe_signal_translation FAIL [stats total_faulting_kb] expected=43008 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_signal_translation FAIL [stats posix(11)] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_signal_translation FAIL [stats posix(8)] expected=1 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_signal_translation_stats",
        "\"signal_count\":" + to_string(s[0])
        + ",\"total_faulting_kb\":" + to_string(s[1])
        + ",\"posix_segv\":" + to_string(s[2])
        + ",\"posix_fpe\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_signal_translation FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pst_sig()
    let s2 = pst_sig_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_signal_translation FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_signal_translation self_test PASS (signals=" + to_string(s[0])
        + ", faulting_kb=" + to_string(s[1]) + ", segv=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pst_sig_stats()
            println("signal_count\t" + to_string(s[0]))
            println("total_faulting_kb\t" + to_string(s[1]))
            println("count_posix_segv\t" + to_string(s[2]))
            println("count_posix_fpe\t" + to_string(s[3]))
            return
        }
        if sub == "addr" {
            if len(a) >= 4 {
                let sigid = to_int(a[3])
                println("signal_faulting_kb\t" + to_string(signal_faulting_kb(sigid)))
                return
            }
            println("usage: hexa run pe_signal_translation.hexa addr <signal_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let psig = to_int(a[3])
                println("count_by_posix\t" + to_string(count_by_posix(psig)))
                return
            }
            println("usage: hexa run pe_signal_translation.hexa count <posix_signal>")
            return
        }
        if sub == "cleanup" {
            cleanup_pst_sig()
            println("cleaned: " + pst_sig_dir())
            return
        }
        if sub == "dir" {
            println(pst_sig_dir())
            return
        }
    }
    println("usage: hexa run pe_signal_translation.hexa { self-test | stats | addr <signal_id> | count <posix_signal> | cleanup | dir }")
}
