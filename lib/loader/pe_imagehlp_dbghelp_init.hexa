// lib/loader/pe_imagehlp_dbghelp_init.hexa — ImageHlp/DbgHelp init tracker
//
// ImageHlp.dll / DbgHelp.dll = symbol resolution + crash dump + image cert.
// Battle.net Setup 의 missing DLL 일부 — anti-debug 및 crash dump path 에서 호출.
// SymInitialize → fake handle (Apple-native debug API X — synthetic process handle).
// MiniDumpWriteDump → /tmp/<pid>.dmp 저장 (Apple Crashreporter 별도 — 호환 layer 만).
// SymFromAddr / SymGetLineFromAddr64 → dlsym + addr2line 조합 (best-effort).
// ImageGetCertificateData → PE Authenticode cert chunk 추출 (offline parse).
// own1: MSDN DbgHelp reference only. Wine dbghelp 인용 X.
//
// own 1 enforcement: Wine / Reactos / CrossOver / community 코드 0 줄.
//   본 module 은 ImageHlp/DbgHelp init/call 1-건 tracker — 실 native dispatch X.
//   Apple-native mapping 은 docstring 만 (실 helper.mm bridge stage6).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// func_kind code:
//   1 = SymInitialize
//   2 = SymCleanup
//   3 = SymFromAddr
//   4 = SymGetLineFromAddr64
//   5 = MiniDumpWriteDump
//   6 = ImageGetCertificateData
//
// dll_kind code:
//   1 = imagehlp
//   2 = dbghelp
//
// persist schema (TSV — calls.tsv):
//   call_id<int> \t func_kind<int> \t sym_count<int> \t dll_kind<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pidi_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_imagehlp_dbghelp_init"
}

fn pidi_calls_path() -> str {
    return pidi_dir() + "/calls.tsv"
}

fn pidi_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pidi_dir() + "'")
}

fn cleanup_pidi() -> void {
    pidi_ensure_dir()
    let _ = exec("rm -f '" + pidi_calls_path() + "'")
}

// ─── 공통 file IO ───
fn pidi_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pidi_append_row(path: str, row: str) -> void {
    pidi_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_call: ImageHlp/DbgHelp 호출 1 건 기록 ───
fn record_call(call_id: int, func_kind: int, sym_count: int, dll_kind: int) -> void {
    if call_id <= 0 {
        panic("pe_imagehlp_dbghelp_init FAIL [record_call] expected=call_id>0 got=" + to_string(call_id))
    }
    if func_kind < 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [record_call] expected=func_kind>=1 got=" + to_string(func_kind))
    }
    if func_kind > 6 {
        panic("pe_imagehlp_dbghelp_init FAIL [record_call] expected=func_kind<=6 got=" + to_string(func_kind))
    }
    if sym_count < 0 {
        panic("pe_imagehlp_dbghelp_init FAIL [record_call] expected=sym_count>=0 got=" + to_string(sym_count))
    }
    if dll_kind < 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [record_call] expected=dll_kind>=1 got=" + to_string(dll_kind))
    }
    if dll_kind > 2 {
        panic("pe_imagehlp_dbghelp_init FAIL [record_call] expected=dll_kind<=2 got=" + to_string(dll_kind))
    }
    let row = to_string(call_id) + "\t" + to_string(func_kind)
        + "\t" + to_string(sym_count) + "\t" + to_string(dll_kind) + "\n"
    pidi_append_row(pidi_calls_path(), row)
}

// ─── call_count: total call 수 ───
fn call_count() -> int {
    let t = pidi_read_table(pidi_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_func_kind: 특정 func_kind 의 호출 수 ───
fn count_by_func_kind(func_kind: int) -> int {
    let t = pidi_read_table(pidi_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == func_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_dll_kind: 특정 dll_kind 의 호출 수 ───
fn count_by_dll_kind(dll_kind: int) -> int {
    let t = pidi_read_table(pidi_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == dll_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_sym_count: 모든 호출 sym_count 합 ───
fn total_sym_count() -> int {
    let t = pidi_read_table(pidi_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── init_count: SymInitialize (func_kind=1) 호출 수 ───
fn init_count() -> int {
    return count_by_func_kind(1)
}

// ─── call_sym_count: 특정 call_id 의 sym_count (없으면 0) ───
fn call_sym_count(call_id: int) -> int {
    let t = pidi_read_table(pidi_calls_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == call_id {
                    return to_int(parts[2])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pidi_stats: [call_count, init_count, total_sym_count, count_by_dll_kind(2)] ───
fn pidi_stats() -> array {
    let mut out = []
    out.push(call_count())
    out.push(init_count())
    out.push(total_sym_count())
    out.push(count_by_dll_kind(2))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pidi-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pidi()

    // 2. record 5 calls (≥3 func_kinds, both dll_kinds)
    //    func_kinds: 1 (SymInitialize), 3 (SymFromAddr), 5 (MiniDumpWriteDump),
    //                6 (ImageGetCertificateData), 2 (SymCleanup)
    //    dll_kinds: 2 (dbghelp) ×4, 1 (imagehlp) ×1

    // call 1: SymInitialize → dbghelp → 0 syms loaded (init only)
    record_call(910001, 1, 0, 2)
    r0_emit("pe_imagehlp_dbghelp_init_record",
        "\"call_id\":910001,\"func_kind\":1,\"sym_count\":0,\"dll_kind\":2,\"target\":\"SymInitialize\",\"native\":\"fake_handle\"")

    // call 2: SymFromAddr → dbghelp → 1 sym resolved
    record_call(910002, 3, 1, 2)
    r0_emit("pe_imagehlp_dbghelp_init_record",
        "\"call_id\":910002,\"func_kind\":3,\"sym_count\":1,\"dll_kind\":2,\"target\":\"SymFromAddr\",\"native\":\"dlsym\"")

    // call 3: MiniDumpWriteDump → dbghelp → 42 syms in dump
    record_call(910003, 5, 42, 2)
    r0_emit("pe_imagehlp_dbghelp_init_record",
        "\"call_id\":910003,\"func_kind\":5,\"sym_count\":42,\"dll_kind\":2,\"target\":\"MiniDumpWriteDump\",\"native\":\"/tmp/<pid>.dmp\"")

    // call 4: ImageGetCertificateData → imagehlp → 1 cert chunk
    record_call(910004, 6, 1, 1)
    r0_emit("pe_imagehlp_dbghelp_init_record",
        "\"call_id\":910004,\"func_kind\":6,\"sym_count\":1,\"dll_kind\":1,\"target\":\"ImageGetCertificateData\",\"native\":\"pe_authenticode_parse\"")

    // call 5: SymCleanup → dbghelp → 0 syms (release)
    record_call(910005, 2, 0, 2)
    r0_emit("pe_imagehlp_dbghelp_init_record",
        "\"call_id\":910005,\"func_kind\":2,\"sym_count\":0,\"dll_kind\":2,\"target\":\"SymCleanup\",\"native\":\"release_fake_handle\"")

    // 3. call_count = 5
    let c = call_count()
    if c != 5 {
        panic("pe_imagehlp_dbghelp_init FAIL [call_count] expected=5 got=" + to_string(c))
    }

    // 4. count_by_func_kind sanity (≥3 distinct)
    let fk1 = count_by_func_kind(1)
    if fk1 != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_func_kind(1)] expected=1 got=" + to_string(fk1))
    }
    let fk2 = count_by_func_kind(2)
    if fk2 != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_func_kind(2)] expected=1 got=" + to_string(fk2))
    }
    let fk3 = count_by_func_kind(3)
    if fk3 != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_func_kind(3)] expected=1 got=" + to_string(fk3))
    }
    let fk5 = count_by_func_kind(5)
    if fk5 != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_func_kind(5)] expected=1 got=" + to_string(fk5))
    }
    let fk6 = count_by_func_kind(6)
    if fk6 != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_func_kind(6)] expected=1 got=" + to_string(fk6))
    }
    let fk4 = count_by_func_kind(4)
    if fk4 != 0 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_func_kind(4)] expected=0 got=" + to_string(fk4))
    }

    // 5. count_by_dll_kind — both covered
    let dk1 = count_by_dll_kind(1)
    if dk1 != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_dll_kind(1)] expected=1 got=" + to_string(dk1))
    }
    let dk2 = count_by_dll_kind(2)
    if dk2 != 4 {
        panic("pe_imagehlp_dbghelp_init FAIL [count_by_dll_kind(2)] expected=4 got=" + to_string(dk2))
    }

    // 6. init_count = 1
    let ic = init_count()
    if ic != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [init_count] expected=1 got=" + to_string(ic))
    }

    // 7. total_sym_count = 0 + 1 + 42 + 1 + 0 = 44
    let tsc = total_sym_count()
    if tsc != 44 {
        panic("pe_imagehlp_dbghelp_init FAIL [total_sym_count] expected=44 got=" + to_string(tsc))
    }

    // 8. call_sym_count sanity
    let sc1 = call_sym_count(910003)
    if sc1 != 42 {
        panic("pe_imagehlp_dbghelp_init FAIL [call_sym_count(910003)] expected=42 got=" + to_string(sc1))
    }
    let sc2 = call_sym_count(910004)
    if sc2 != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [call_sym_count(910004)] expected=1 got=" + to_string(sc2))
    }
    let sc_miss = call_sym_count(9999)
    if sc_miss != 0 {
        panic("pe_imagehlp_dbghelp_init FAIL [call_sym_count(9999)] expected=0 got=" + to_string(sc_miss))
    }

    // 9. pidi_stats() = [5, 1, 44, 4]
    let s = pidi_stats()
    if len(s) != 4 {
        panic("pe_imagehlp_dbghelp_init FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_imagehlp_dbghelp_init FAIL [stats call_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 1 {
        panic("pe_imagehlp_dbghelp_init FAIL [stats init_count] expected=1 got=" + to_string(s[1]))
    }
    if s[2] != 44 {
        panic("pe_imagehlp_dbghelp_init FAIL [stats total_sym_count] expected=44 got=" + to_string(s[2]))
    }
    if s[3] != 4 {
        panic("pe_imagehlp_dbghelp_init FAIL [stats dbghelp_count] expected=4 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_imagehlp_dbghelp_init_stats",
        "\"call_count\":" + to_string(s[0])
        + ",\"init_count\":" + to_string(s[1])
        + ",\"total_sym_count\":" + to_string(s[2])
        + ",\"dbghelp_count\":" + to_string(s[3]))

    // 11. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_imagehlp_dbghelp_init FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_pidi()
    let s2 = pidi_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_imagehlp_dbghelp_init FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_imagehlp_dbghelp_init self_test PASS (calls=" + to_string(s[0])
        + ", init=" + to_string(s[1]) + ", total_sym=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pidi_stats()
            println("call_count\t" + to_string(s[0]))
            println("init_count\t" + to_string(s[1]))
            println("total_sym_count\t" + to_string(s[2]))
            println("dbghelp_count\t" + to_string(s[3]))
            return
        }
        if sub == "sym" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                println("call_sym_count\t" + to_string(call_sym_count(cid)))
                return
            }
            println("usage: hexa run pe_imagehlp_dbghelp_init.hexa sym <call_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let mode = a[3]
                let val = to_int(a[4])
                if mode == "func" {
                    println("count_by_func_kind\t" + to_string(count_by_func_kind(val)))
                    return
                }
                if mode == "dll" {
                    println("count_by_dll_kind\t" + to_string(count_by_dll_kind(val)))
                    return
                }
                println("usage: hexa run pe_imagehlp_dbghelp_init.hexa count { func <func_kind> | dll <dll_kind> }")
                return
            }
            println("usage: hexa run pe_imagehlp_dbghelp_init.hexa count { func <func_kind> | dll <dll_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_pidi()
            println("cleaned: " + pidi_dir())
            return
        }
        if sub == "dir" {
            println(pidi_dir())
            return
        }
    }
    println("usage: hexa run pe_imagehlp_dbghelp_init.hexa { self-test | stats | sym <call_id> | count func <func_kind> | count dll <dll_kind> | cleanup | dir }")
}
