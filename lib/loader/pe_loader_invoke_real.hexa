// lib/loader/pe_loader_invoke_real.hexa — cycle 82 R2 phase 2 PE loader → helper.mm IPC invoke tracker
//
// cycle 80 pe_section_mapper_real (skeleton) + R1 phase 1 pe_native_mmap_real
// 의 IPC stub 호출 추적기. PE loader pipeline 의 각 phase 가 host helper.mm
// 으로 발사하는 IPC 요청 1 건씩 row 로 누적 — 실제 helper.mm spawn / IPC frame
// dispatch 는 본 module 범위 밖 (stage7 helper.mm + cycle 83 phase 3+).
//
// PE loader phase pipeline:
//   1 = section_map  → pe_section_mapper_real → helper.mm mmap(2)
//   2 = reloc_apply  → pe_reloc_applier_real  → helper.mm mprotect(2) RW window
//   3 = tls_init     → pe_tls_init_real       → helper.mm pthread_key_create
//   4 = entry_invoke → pe_entry_call          → helper.mm dlopen + dlsym + jump
//   5 = cleanup      → munmap/dlclose 회수    → helper.mm cleanup IPC
// own1: PE/COFF spec + Apple dyld(1) + helper.mm self impl 만 참조,
//       Wine ntdll/loader 코드 0 줄.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄. 본 module 은
// invoke tracker — 실 helper.mm spawn / pipe write X (cycle 83+).
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// phase_kind code:
//   1 = section_map
//   2 = reloc_apply
//   3 = tls_init
//   4 = entry_invoke
//   5 = cleanup
//
// ipc_kind code (STAGE7_HELPER_MM_IPC_SPEC.md 정합 — 1..8):
//   1 = mmap
//   2 = mprotect
//   3 = munmap
//   4 = dlopen
//   5 = dlsym
//   6 = dlclose
//   7 = pthread_key_create
//   8 = pthread_jit_write_protect_np
//
// elevated: 0 = normal, 1 = privileged frame (entitlement / JIT / W^X transition)
//
// persist schema (TSV — invokes.tsv):
//   invoke_id<int> \t phase_kind<int> \t ipc_kind<int> \t elevated<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn plir_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_loader_invoke_real"
}

fn plir_invokes_path() -> str {
    return plir_dir() + "/invokes.tsv"
}

fn plir_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + plir_dir() + "'")
}

fn cleanup_plir() -> void {
    plir_ensure_dir()
    let _ = exec("rm -f '" + plir_invokes_path() + "'")
}

// ─── 공통 file IO ───
fn plir_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn plir_append_row(path: str, row: str) -> void {
    plir_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_invoke: helper.mm IPC invoke 1 건 기록 ───
fn record_invoke(invoke_id: int, phase_kind: int, ipc_kind: int, elevated: int) -> void {
    if invoke_id <= 0 {
        panic("pe_loader_invoke_real FAIL [record_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if phase_kind < 1 {
        panic("pe_loader_invoke_real FAIL [record_invoke] expected=phase_kind>=1 got=" + to_string(phase_kind))
    }
    if phase_kind > 5 {
        panic("pe_loader_invoke_real FAIL [record_invoke] expected=phase_kind<=5 got=" + to_string(phase_kind))
    }
    if ipc_kind < 1 {
        panic("pe_loader_invoke_real FAIL [record_invoke] expected=ipc_kind>=1 got=" + to_string(ipc_kind))
    }
    if ipc_kind > 8 {
        panic("pe_loader_invoke_real FAIL [record_invoke] expected=ipc_kind<=8 got=" + to_string(ipc_kind))
    }
    if elevated < 0 {
        panic("pe_loader_invoke_real FAIL [record_invoke] expected=elevated>=0 got=" + to_string(elevated))
    }
    if elevated > 1 {
        panic("pe_loader_invoke_real FAIL [record_invoke] expected=elevated<=1 got=" + to_string(elevated))
    }
    let row = to_string(invoke_id) + "\t" + to_string(phase_kind)
        + "\t" + to_string(ipc_kind) + "\t" + to_string(elevated) + "\n"
    plir_append_row(plir_invokes_path(), row)
}

// ─── invoke_count: total invoke 수 ───
fn invoke_count() -> int {
    let t = plir_read_table(plir_invokes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_phase_kind: 특정 phase_kind 의 invoke 수 ───
fn count_by_phase_kind(phase_kind: int) -> int {
    let t = plir_read_table(plir_invokes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == phase_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_ipc_kind: 특정 ipc_kind 의 invoke 수 ───
fn count_by_ipc_kind(ipc_kind: int) -> int {
    let t = plir_read_table(plir_invokes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == ipc_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── elevated_count: elevated=1 인 invoke 수 ───
fn elevated_count() -> int {
    let t = plir_read_table(plir_invokes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[3]) == 1 {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── entry_invoke_count: phase_kind=4 의 invoke 수 ───
fn entry_invoke_count() -> int {
    return count_by_phase_kind(4)
}

// ─── invoke_phase: 특정 invoke_id 의 phase_kind (없으면 0) ───
fn invoke_phase(invoke_id: int) -> int {
    let t = plir_read_table(plir_invokes_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == invoke_id {
                    return to_int(parts[1])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── plir_stats: [invoke_count, entry_invoke_count, elevated_count, count_by_ipc_kind(1)] ───
fn plir_stats() -> array {
    let mut out = []
    out.push(invoke_count())
    out.push(entry_invoke_count())
    out.push(elevated_count())
    out.push(count_by_ipc_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "plir-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_plir()

    // 2. record 6 invokes covering all 5 phase_kinds (1..5) and ≥3 ipc_kinds
    //    invoke 1: section_map  → mmap                      (phase=1, ipc=1, elev=0)
    //    invoke 2: section_map  → mprotect                  (phase=1, ipc=2, elev=0)
    //    invoke 3: reloc_apply  → mprotect (W^X transition) (phase=2, ipc=2, elev=1)
    //    invoke 4: tls_init     → pthread_key_create        (phase=3, ipc=7, elev=0)
    //    invoke 5: entry_invoke → dlopen                    (phase=4, ipc=4, elev=1)
    //    invoke 6: cleanup      → munmap                    (phase=5, ipc=3, elev=0)
    record_invoke(120001, 1, 1, 0)
    r0_emit("pe_loader_invoke_real_record",
        "\"invoke_id\":120001,\"phase_kind\":1,\"ipc_kind\":1,\"elevated\":0,\"target\":\"section_map.mmap\"")

    record_invoke(120002, 1, 2, 0)
    r0_emit("pe_loader_invoke_real_record",
        "\"invoke_id\":120002,\"phase_kind\":1,\"ipc_kind\":2,\"elevated\":0,\"target\":\"section_map.mprotect\"")

    record_invoke(120003, 2, 2, 1)
    r0_emit("pe_loader_invoke_real_record",
        "\"invoke_id\":120003,\"phase_kind\":2,\"ipc_kind\":2,\"elevated\":1,\"target\":\"reloc_apply.mprotect_wx\"")

    record_invoke(120004, 3, 7, 0)
    r0_emit("pe_loader_invoke_real_record",
        "\"invoke_id\":120004,\"phase_kind\":3,\"ipc_kind\":7,\"elevated\":0,\"target\":\"tls_init.pthread_key_create\"")

    record_invoke(120005, 4, 4, 1)
    r0_emit("pe_loader_invoke_real_record",
        "\"invoke_id\":120005,\"phase_kind\":4,\"ipc_kind\":4,\"elevated\":1,\"target\":\"entry_invoke.dlopen\"")

    record_invoke(120006, 5, 3, 0)
    r0_emit("pe_loader_invoke_real_record",
        "\"invoke_id\":120006,\"phase_kind\":5,\"ipc_kind\":3,\"elevated\":0,\"target\":\"cleanup.munmap\"")

    // 3. invoke_count = 6
    let c = invoke_count()
    if c != 6 {
        panic("pe_loader_invoke_real FAIL [invoke_count] expected=6 got=" + to_string(c))
    }

    // 4. count_by_phase_kind sanity — all 5 phase_kinds covered
    let p1 = count_by_phase_kind(1)
    if p1 != 2 {
        panic("pe_loader_invoke_real FAIL [count_by_phase_kind(1)] expected=2 got=" + to_string(p1))
    }
    let p2 = count_by_phase_kind(2)
    if p2 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_phase_kind(2)] expected=1 got=" + to_string(p2))
    }
    let p3 = count_by_phase_kind(3)
    if p3 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_phase_kind(3)] expected=1 got=" + to_string(p3))
    }
    let p4 = count_by_phase_kind(4)
    if p4 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_phase_kind(4)] expected=1 got=" + to_string(p4))
    }
    let p5 = count_by_phase_kind(5)
    if p5 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_phase_kind(5)] expected=1 got=" + to_string(p5))
    }
    let p99 = count_by_phase_kind(99)
    if p99 != 0 {
        panic("pe_loader_invoke_real FAIL [count_by_phase_kind(99)] expected=0 got=" + to_string(p99))
    }

    // 5. count_by_ipc_kind sanity — ≥3 ipc_kinds covered (1, 2, 3, 4, 7 = 5 distinct)
    let ik1 = count_by_ipc_kind(1)
    if ik1 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_ipc_kind(1)] expected=1 got=" + to_string(ik1))
    }
    let ik2 = count_by_ipc_kind(2)
    if ik2 != 2 {
        panic("pe_loader_invoke_real FAIL [count_by_ipc_kind(2)] expected=2 got=" + to_string(ik2))
    }
    let ik3 = count_by_ipc_kind(3)
    if ik3 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_ipc_kind(3)] expected=1 got=" + to_string(ik3))
    }
    let ik4 = count_by_ipc_kind(4)
    if ik4 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_ipc_kind(4)] expected=1 got=" + to_string(ik4))
    }
    let ik7 = count_by_ipc_kind(7)
    if ik7 != 1 {
        panic("pe_loader_invoke_real FAIL [count_by_ipc_kind(7)] expected=1 got=" + to_string(ik7))
    }
    let ik5 = count_by_ipc_kind(5)
    if ik5 != 0 {
        panic("pe_loader_invoke_real FAIL [count_by_ipc_kind(5)] expected=0 got=" + to_string(ik5))
    }

    // 6. elevated_count = 2 (invoke 3 reloc W^X, invoke 5 entry dlopen)
    let ec = elevated_count()
    if ec != 2 {
        panic("pe_loader_invoke_real FAIL [elevated_count] expected=2 got=" + to_string(ec))
    }

    // 7. entry_invoke_count = count_by_phase_kind(4) = 1
    let eic = entry_invoke_count()
    if eic != 1 {
        panic("pe_loader_invoke_real FAIL [entry_invoke_count] expected=1 got=" + to_string(eic))
    }
    if eic != count_by_phase_kind(4) {
        panic("pe_loader_invoke_real FAIL [entry_invoke_count==count_by_phase_kind(4)] mismatch")
    }

    // 8. invoke_phase sanity
    let ph3 = invoke_phase(120003)
    if ph3 != 2 {
        panic("pe_loader_invoke_real FAIL [invoke_phase(120003)] expected=2 got=" + to_string(ph3))
    }
    let ph5 = invoke_phase(120005)
    if ph5 != 4 {
        panic("pe_loader_invoke_real FAIL [invoke_phase(120005)] expected=4 got=" + to_string(ph5))
    }
    let ph_miss = invoke_phase(9999)
    if ph_miss != 0 {
        panic("pe_loader_invoke_real FAIL [invoke_phase(9999)] expected=0 got=" + to_string(ph_miss))
    }

    // 9. plir_stats() = [6, 1, 2, 1]
    let s = plir_stats()
    if len(s) != 4 {
        panic("pe_loader_invoke_real FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_loader_invoke_real FAIL [stats invoke_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 1 {
        panic("pe_loader_invoke_real FAIL [stats entry_invoke_count] expected=1 got=" + to_string(s[1]))
    }
    if s[2] != 2 {
        panic("pe_loader_invoke_real FAIL [stats elevated_count] expected=2 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_loader_invoke_real FAIL [stats ipc_kind_mmap] expected=1 got=" + to_string(s[3]))
    }

    // 10. emit stats
    r0_emit("pe_loader_invoke_real_stats",
        "\"invoke_count\":" + to_string(s[0])
        + ",\"entry_invoke_count\":" + to_string(s[1])
        + ",\"elevated_count\":" + to_string(s[2])
        + ",\"ipc_kind_mmap\":" + to_string(s[3]))

    // 11. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_loader_invoke_real FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 12. cleanup → stats 모두 0
    cleanup_plir()
    let s2 = plir_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_loader_invoke_real FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_loader_invoke_real self_test PASS (invokes=" + to_string(s[0])
        + ", entry=" + to_string(s[1]) + ", elevated=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = plir_stats()
            println("invoke_count\t" + to_string(s[0]))
            println("entry_invoke_count\t" + to_string(s[1]))
            println("elevated_count\t" + to_string(s[2]))
            println("ipc_kind_mmap\t" + to_string(s[3]))
            return
        }
        if sub == "phase" {
            if len(a) >= 4 {
                let iid = to_int(a[3])
                println("invoke_phase\t" + to_string(invoke_phase(iid)))
                return
            }
            println("usage: hexa run pe_loader_invoke_real.hexa phase <invoke_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 5 {
                let what = a[3]
                let val = to_int(a[4])
                if what == "phase" {
                    println("count_by_phase_kind\t" + to_string(count_by_phase_kind(val)))
                    return
                }
                if what == "ipc" {
                    println("count_by_ipc_kind\t" + to_string(count_by_ipc_kind(val)))
                    return
                }
                println("usage: hexa run pe_loader_invoke_real.hexa count { phase <phase_kind> | ipc <ipc_kind> }")
                return
            }
            println("usage: hexa run pe_loader_invoke_real.hexa count { phase <phase_kind> | ipc <ipc_kind> }")
            return
        }
        if sub == "cleanup" {
            cleanup_plir()
            println("cleaned: " + plir_dir())
            return
        }
        if sub == "dir" {
            println(plir_dir())
            return
        }
    }
    println("usage: hexa run pe_loader_invoke_real.hexa { self-test | stats | phase <invoke_id> | count phase <phase_kind> | count ipc <ipc_kind> | cleanup | dir }")
}
