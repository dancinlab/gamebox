// lib/loader/pe_wait_for_single_object.hexa — cycle 71 WaitForSingleObject(Ex)
//
// Win32 WaitForSingleObject / WaitForSingleObjectEx dispatch telemetry.
// Single object wait — Event / Mutex / Semaphore / Thread / Process handle
// 중 1 개를 대상으로 signaled / timeout / abandoned / failed return 분류.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 wait dispatch tracker — 실 WaitForSingleObject() 호출 X.
// own 2 mandate: r0_emit ≥ 7 + self_test() + main() dispatch + headless safe + panic 형식.
//
// object_kind code:
//   1 = event
//   2 = mutex
//   3 = semaphore
//   4 = thread
//   5 = process
//
// wait_result code:
//   0 = signaled    (WAIT_OBJECT_0)
//   1 = timeout     (WAIT_TIMEOUT)
//   2 = abandoned   (WAIT_ABANDONED — mutex 한정 실세계 반환)
//   3 = failed      (WAIT_FAILED)
//
// persist schema (TSV — waits.tsv):
//   wait_id<int> \t object_kind<int> \t wait_result<int> \t wait_us<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwfso_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_wait_for_single_object"
}

fn pwfso_waits_path() -> str {
    return pwfso_dir() + "/waits.tsv"
}

fn pwfso_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwfso_dir() + "'")
}

fn cleanup_pwfso() -> void {
    pwfso_ensure_dir()
    let _ = exec("rm -f '" + pwfso_waits_path() + "'")
}

// ─── 공통 file IO ───
fn pwfso_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwfso_append_row(path: str, row: str) -> void {
    pwfso_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_wait: WaitForSingleObject 호출 1 건 기록 ───
fn record_wait(wait_id: int, object_kind: int, wait_result: int, wait_us: int) -> void {
    if wait_id <= 0 {
        panic("pe_wait_for_single_object FAIL [record_wait] expected=wait_id>0 got=" + to_string(wait_id))
    }
    if object_kind < 1 {
        panic("pe_wait_for_single_object FAIL [record_wait] expected=object_kind>=1 got=" + to_string(object_kind))
    }
    if object_kind > 5 {
        panic("pe_wait_for_single_object FAIL [record_wait] expected=object_kind<=5 got=" + to_string(object_kind))
    }
    if wait_result < 0 {
        panic("pe_wait_for_single_object FAIL [record_wait] expected=wait_result>=0 got=" + to_string(wait_result))
    }
    if wait_result > 3 {
        panic("pe_wait_for_single_object FAIL [record_wait] expected=wait_result<=3 got=" + to_string(wait_result))
    }
    if wait_us < 0 {
        panic("pe_wait_for_single_object FAIL [record_wait] expected=wait_us>=0 got=" + to_string(wait_us))
    }
    let row = to_string(wait_id) + "\t" + to_string(object_kind)
        + "\t" + to_string(wait_result) + "\t" + to_string(wait_us) + "\n"
    pwfso_append_row(pwfso_waits_path(), row)
}

// ─── wait_count: total wait 수 ───
fn wait_count() -> int {
    let t = pwfso_read_table(pwfso_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_wait_us: 모든 wait 의 wait_us 합 ───
fn total_wait_us() -> int {
    let t = pwfso_read_table(pwfso_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_object_kind: 특정 object_kind 의 wait 수 ───
fn count_by_object_kind(kind: int) -> int {
    let t = pwfso_read_table(pwfso_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── count_by_result: 특정 wait_result 의 wait 수 ───
fn count_by_result(result: int) -> int {
    let t = pwfso_read_table(pwfso_waits_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[2]) == result {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── wait_elapsed_us: 특정 wait_id 의 wait_us (없으면 -1) ───
fn wait_elapsed_us(wait_id: int) -> int {
    let t = pwfso_read_table(pwfso_waits_path())
    if t == "" {
        return -1
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == wait_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return -1
}

// ─── pwfso_stats: [wait_count, total_wait_us, signaled, timeout, event_kind] ───
fn pwfso_stats() -> array {
    let mut out = []
    out.push(wait_count())
    out.push(total_wait_us())
    out.push(count_by_result(0))
    out.push(count_by_result(1))
    out.push(count_by_object_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pwfso-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pwfso()

    // 2. record 6 waits — 5 distinct object_kinds, 4 distinct wait_results
    //    layout:
    //      810001 event(1)     signaled(0)   50us
    //      810002 mutex(2)     signaled(0)   100us
    //      810003 semaphore(3) timeout(1)    5000us
    //      810004 thread(4)    signaled(0)   200us
    //      810005 process(5)   abandoned(2)  1500us
    //      810006 event(1)     failed(3)     75us
    //    sum wait_us = 50+100+5000+200+1500+75 = 6925
    record_wait(810001, 1, 0, 50)
    r0_emit("pe_wait_for_single_object_record",
        "\"wait_id\":810001,\"object_kind\":1,\"wait_result\":0,\"wait_us\":50,\"target\":\"event_signaled\"")

    record_wait(810002, 2, 0, 100)
    r0_emit("pe_wait_for_single_object_record",
        "\"wait_id\":810002,\"object_kind\":2,\"wait_result\":0,\"wait_us\":100,\"target\":\"mutex_signaled\"")

    record_wait(810003, 3, 1, 5000)
    r0_emit("pe_wait_for_single_object_record",
        "\"wait_id\":810003,\"object_kind\":3,\"wait_result\":1,\"wait_us\":5000,\"target\":\"semaphore_timeout\"")

    record_wait(810004, 4, 0, 200)
    r0_emit("pe_wait_for_single_object_record",
        "\"wait_id\":810004,\"object_kind\":4,\"wait_result\":0,\"wait_us\":200,\"target\":\"thread_signaled\"")

    record_wait(810005, 5, 2, 1500)
    r0_emit("pe_wait_for_single_object_record",
        "\"wait_id\":810005,\"object_kind\":5,\"wait_result\":2,\"wait_us\":1500,\"target\":\"process_abandoned\"")

    record_wait(810006, 1, 3, 75)
    r0_emit("pe_wait_for_single_object_record",
        "\"wait_id\":810006,\"object_kind\":1,\"wait_result\":3,\"wait_us\":75,\"target\":\"event_failed\"")

    // 3. wait_count = 6
    let c = wait_count()
    if c != 6 {
        panic("pe_wait_for_single_object FAIL [wait_count] expected=6 got=" + to_string(c))
    }

    // 4. total_wait_us = 6925
    let tw = total_wait_us()
    if tw != 6925 {
        panic("pe_wait_for_single_object FAIL [total_wait_us] expected=6925 got=" + to_string(tw))
    }

    // 5. count_by_object_kind sanity (5 distinct kinds, event appears twice)
    let k1 = count_by_object_kind(1)
    if k1 != 2 {
        panic("pe_wait_for_single_object FAIL [count_by_object_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_object_kind(2)
    if k2 != 1 {
        panic("pe_wait_for_single_object FAIL [count_by_object_kind(2)] expected=1 got=" + to_string(k2))
    }
    let k3 = count_by_object_kind(3)
    if k3 != 1 {
        panic("pe_wait_for_single_object FAIL [count_by_object_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k4 = count_by_object_kind(4)
    if k4 != 1 {
        panic("pe_wait_for_single_object FAIL [count_by_object_kind(4)] expected=1 got=" + to_string(k4))
    }
    let k5 = count_by_object_kind(5)
    if k5 != 1 {
        panic("pe_wait_for_single_object FAIL [count_by_object_kind(5)] expected=1 got=" + to_string(k5))
    }
    let k99 = count_by_object_kind(99)
    if k99 != 0 {
        panic("pe_wait_for_single_object FAIL [count_by_object_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 6. count_by_result sanity (4 distinct results)
    let r0 = count_by_result(0)
    if r0 != 3 {
        panic("pe_wait_for_single_object FAIL [count_by_result(0)] expected=3 got=" + to_string(r0))
    }
    let r1 = count_by_result(1)
    if r1 != 1 {
        panic("pe_wait_for_single_object FAIL [count_by_result(1)] expected=1 got=" + to_string(r1))
    }
    let r2 = count_by_result(2)
    if r2 != 1 {
        panic("pe_wait_for_single_object FAIL [count_by_result(2)] expected=1 got=" + to_string(r2))
    }
    let r3 = count_by_result(3)
    if r3 != 1 {
        panic("pe_wait_for_single_object FAIL [count_by_result(3)] expected=1 got=" + to_string(r3))
    }

    // 7. wait_elapsed_us sanity
    let e1 = wait_elapsed_us(810003)
    if e1 != 5000 {
        panic("pe_wait_for_single_object FAIL [wait_elapsed_us(810003)] expected=5000 got=" + to_string(e1))
    }
    let e2 = wait_elapsed_us(810005)
    if e2 != 1500 {
        panic("pe_wait_for_single_object FAIL [wait_elapsed_us(810005)] expected=1500 got=" + to_string(e2))
    }
    let e_miss = wait_elapsed_us(9999)
    if e_miss != -1 {
        panic("pe_wait_for_single_object FAIL [wait_elapsed_us(9999)] expected=-1 got=" + to_string(e_miss))
    }

    // 8. pwfso_stats() = [6, 6925, 3, 1, 2]
    let s = pwfso_stats()
    if len(s) != 5 {
        panic("pe_wait_for_single_object FAIL [stats len] expected=5 got=" + to_string(len(s)))
    }
    if s[0] != 6 {
        panic("pe_wait_for_single_object FAIL [stats wait_count] expected=6 got=" + to_string(s[0]))
    }
    if s[1] != 6925 {
        panic("pe_wait_for_single_object FAIL [stats total_wait_us] expected=6925 got=" + to_string(s[1]))
    }
    if s[2] != 3 {
        panic("pe_wait_for_single_object FAIL [stats signaled] expected=3 got=" + to_string(s[2]))
    }
    if s[3] != 1 {
        panic("pe_wait_for_single_object FAIL [stats timeout] expected=1 got=" + to_string(s[3]))
    }
    if s[4] != 2 {
        panic("pe_wait_for_single_object FAIL [stats event_kind] expected=2 got=" + to_string(s[4]))
    }

    // 9. emit stats
    r0_emit("pe_wait_for_single_object_stats",
        "\"wait_count\":" + to_string(s[0])
        + ",\"total_wait_us\":" + to_string(s[1])
        + ",\"signaled\":" + to_string(s[2])
        + ",\"timeout\":" + to_string(s[3])
        + ",\"event_kind\":" + to_string(s[4]))

    // 10. emit count >= 7 (6 records + 1 stats = 7)
    let emit_n = r0_session_count(sid)
    if emit_n < 7 {
        panic("pe_wait_for_single_object FAIL [r0 emit count] expected=>=7 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pwfso()
    let s2 = pwfso_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_wait_for_single_object FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_wait_for_single_object self_test PASS (waits=" + to_string(s[0])
        + ", wait_us=" + to_string(s[1]) + ", signaled=" + to_string(s[2])
        + ", timeout=" + to_string(s[3]) + ", event=" + to_string(s[4])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pwfso_stats()
            println("wait_count\t" + to_string(s[0]))
            println("total_wait_us\t" + to_string(s[1]))
            println("signaled_count\t" + to_string(s[2]))
            println("timeout_count\t" + to_string(s[3]))
            println("event_kind_count\t" + to_string(s[4]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let wid = to_int(a[3])
                println("wait_elapsed_us\t" + to_string(wait_elapsed_us(wid)))
                return
            }
            println("usage: hexa run pe_wait_for_single_object.hexa elapsed <wait_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_object_kind\t" + to_string(count_by_object_kind(kind)))
                return
            }
            println("usage: hexa run pe_wait_for_single_object.hexa count <object_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pwfso()
            println("cleaned: " + pwfso_dir())
            return
        }
        if sub == "dir" {
            println(pwfso_dir())
            return
        }
    }
    println("usage: hexa run pe_wait_for_single_object.hexa { self-test | stats | elapsed <wait_id> | count <object_kind> | cleanup | dir }")
}
