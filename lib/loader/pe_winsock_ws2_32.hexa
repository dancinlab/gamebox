// lib/loader/pe_winsock_ws2_32.hexa — WS2_32.dll Winsock 2 syscall surface tracker (skeleton-tier)
//
// own1: Hexa pure. Wine / CrossOver / Whisky / GPTK / community wrapper 의존 0. OpenSSL /
//       BoringSSL / libcurl / mbedtls / Wine ws2_32 source 측 코드 인용 0. winsock2.h reference
//       shape 만 (sockaddr_in / WSAData). 실 socket(2) / connect / send-recv = 미수행.
// own2: r0_emit ≥ 14 + self_test() ≥ 12 record + main() dispatch + headless safe + panic 형식.
//       PARTIAL emit 명시 — production smoke + full coverage pending separate cycle.
// online_expansion_lockin: L1 (EULA/ToS) + L2 (Warden long-horizon) + L3 (multi-year) +
//                          L4 (D2R online single target) + L5 (Track J/K/L parallel) ALL OK
//                          (사용자 lock-in 2026-05-03).
//
// Track K1 — Winsock 2 (ws2_32.dll) syscall surface coverage 20 fn (skeleton row 만).
// 대상: WSAStartup/WSACleanup, socket/closesocket, connect/bind/listen/accept, send/recv/
// WSASend/WSARecv, WSASocket/WSAEventSelect/WSAWaitForMultipleEvents, getaddrinfo/freeaddrinfo/
// gethostbyname, select/WSAPoll.
//
// SOCKADDR_IN synthetic 16 byte (sin_family 0x0002 LE + sin_port htons(443) + sin_addr
// 1.2.3.4 + sin_zero ×8). WSAData synthetic wVersion 0x0202.
//
// persist schema (TSV — 4 table): syscall_invoke / sock_lifecycle / io_round_trip / dns_round_trip.
// 식별자 주의: type / mod / handle / class / interface / module / import 모두 hexa 예약어 — 사용 X.

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pwsock_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_winsock_ws2_32"
}

fn pwsock_syscall_invoke_path() -> str {
    return pwsock_dir() + "/syscall_invoke.tsv"
}

fn pwsock_sock_lifecycle_path() -> str {
    return pwsock_dir() + "/sock_lifecycle.tsv"
}

fn pwsock_io_round_trip_path() -> str {
    return pwsock_dir() + "/io_round_trip.tsv"
}

fn pwsock_dns_round_trip_path() -> str {
    return pwsock_dir() + "/dns_round_trip.tsv"
}

fn pwsock_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pwsock_dir() + "'")
}

fn cleanup_pwsock() -> void {
    pwsock_ensure_dir()
    let _ = exec("rm -f '" + pwsock_syscall_invoke_path() + "' '" + pwsock_sock_lifecycle_path()
        + "' '" + pwsock_io_round_trip_path() + "' '" + pwsock_dns_round_trip_path() + "'")
}

// ─── 공통 file IO ───
fn pwsock_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pwsock_append_row(path: str, row: str) -> void {
    pwsock_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

fn pwsock_count_rows(path: str, min_cols: int) -> int {
    let t = pwsock_read_table(path)
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= min_cols {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── helper: fn_kind_name (20 fn coverage) ───
fn fn_kind_name(k: int) -> str {
    if k == 0 { return "WSAStartup" }
    if k == 1 { return "WSACleanup" }
    if k == 2 { return "socket" }
    if k == 3 { return "closesocket" }
    if k == 4 { return "connect" }
    if k == 5 { return "bind" }
    if k == 6 { return "listen" }
    if k == 7 { return "accept" }
    if k == 8 { return "send" }
    if k == 9 { return "recv" }
    if k == 10 { return "WSASend" }
    if k == 11 { return "WSARecv" }
    if k == 12 { return "WSASocket" }
    if k == 13 { return "WSAEventSelect" }
    if k == 14 { return "WSAWaitForMultipleEvents" }
    if k == 15 { return "getaddrinfo" }
    if k == 16 { return "freeaddrinfo" }
    if k == 17 { return "gethostbyname" }
    if k == 18 { return "select" }
    if k == 19 { return "WSAPoll" }
    return "unknown"
}

// ─── persist row helpers ───

// ─── record_syscall_invoke: WS2_32 fn invoke milestone (skeleton row) ───
fn record_syscall_invoke(invoke_id: int, fn_kind: int, fn_name: str, status: str) -> void {
    if invoke_id <= 0 {
        panic("pe_winsock_ws2_32 FAIL [record_syscall_invoke] expected=invoke_id>0 got=" + to_string(invoke_id))
    }
    if fn_kind < 0 {
        panic("pe_winsock_ws2_32 FAIL [record_syscall_invoke] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 19 {
        panic("pe_winsock_ws2_32 FAIL [record_syscall_invoke] expected=fn_kind<=19 got=" + to_string(fn_kind))
    }
    if fn_name == "" {
        panic("pe_winsock_ws2_32 FAIL [record_syscall_invoke] expected=fn_name!=empty got=empty")
    }
    if status == "" {
        panic("pe_winsock_ws2_32 FAIL [record_syscall_invoke] expected=status!=empty got=empty")
    }
    let row = to_string(invoke_id) + "\t" + to_string(fn_kind) + "\t"
        + fn_name + "\t" + status + "\n"
    pwsock_append_row(pwsock_syscall_invoke_path(), row)
}

// ─── record_sock_lifecycle: socket fd lifecycle row (open / connect / accept / close) ───
fn record_sock_lifecycle(life_id: int, op: str, fd_hex: str, af: int, kind: int) -> void {
    if life_id <= 0 {
        panic("pe_winsock_ws2_32 FAIL [record_sock_lifecycle] expected=life_id>0 got=" + to_string(life_id))
    }
    if op == "" {
        panic("pe_winsock_ws2_32 FAIL [record_sock_lifecycle] expected=op!=empty got=empty")
    }
    if fd_hex == "" {
        panic("pe_winsock_ws2_32 FAIL [record_sock_lifecycle] expected=fd_hex!=empty got=empty")
    }
    if af < 0 {
        panic("pe_winsock_ws2_32 FAIL [record_sock_lifecycle] expected=af>=0 got=" + to_string(af))
    }
    if kind < 0 {
        panic("pe_winsock_ws2_32 FAIL [record_sock_lifecycle] expected=kind>=0 got=" + to_string(kind))
    }
    let row = to_string(life_id) + "\t" + op + "\t" + fd_hex + "\t"
        + to_string(af) + "\t" + to_string(kind) + "\n"
    pwsock_append_row(pwsock_sock_lifecycle_path(), row)
}

// ─── record_io_round_trip: send / recv / WSASend / WSARecv synthetic byte counter ───
fn record_io_round_trip(io_id: int, kind: str, direction: str, bytes_synth: int, status: str) -> void {
    if io_id <= 0 {
        panic("pe_winsock_ws2_32 FAIL [record_io_round_trip] expected=io_id>0 got=" + to_string(io_id))
    }
    if kind == "" {
        panic("pe_winsock_ws2_32 FAIL [record_io_round_trip] expected=kind!=empty got=empty")
    }
    if direction == "" {
        panic("pe_winsock_ws2_32 FAIL [record_io_round_trip] expected=direction!=empty got=empty")
    }
    if bytes_synth < 0 {
        panic("pe_winsock_ws2_32 FAIL [record_io_round_trip] expected=bytes_synth>=0 got=" + to_string(bytes_synth))
    }
    if status == "" {
        panic("pe_winsock_ws2_32 FAIL [record_io_round_trip] expected=status!=empty got=empty")
    }
    let row = to_string(io_id) + "\t" + kind + "\t" + direction + "\t"
        + to_string(bytes_synth) + "\t" + status + "\n"
    pwsock_append_row(pwsock_io_round_trip_path(), row)
}

// ─── record_dns_round_trip: getaddrinfo / freeaddrinfo / gethostbyname stub ───
fn record_dns_round_trip(dns_id: int, fn_kind: int, hostname: str, result_count: int, status: str) -> void {
    if dns_id <= 0 {
        panic("pe_winsock_ws2_32 FAIL [record_dns_round_trip] expected=dns_id>0 got=" + to_string(dns_id))
    }
    if fn_kind < 0 {
        panic("pe_winsock_ws2_32 FAIL [record_dns_round_trip] expected=fn_kind>=0 got=" + to_string(fn_kind))
    }
    if fn_kind > 19 {
        panic("pe_winsock_ws2_32 FAIL [record_dns_round_trip] expected=fn_kind<=19 got=" + to_string(fn_kind))
    }
    if hostname == "" {
        panic("pe_winsock_ws2_32 FAIL [record_dns_round_trip] expected=hostname!=empty got=empty")
    }
    if result_count < 0 {
        panic("pe_winsock_ws2_32 FAIL [record_dns_round_trip] expected=result_count>=0 got=" + to_string(result_count))
    }
    if status == "" {
        panic("pe_winsock_ws2_32 FAIL [record_dns_round_trip] expected=status!=empty got=empty")
    }
    let row = to_string(dns_id) + "\t" + to_string(fn_kind) + "\t"
        + hostname + "\t" + to_string(result_count) + "\t" + status + "\n"
    pwsock_append_row(pwsock_dns_round_trip_path(), row)
}

// ─── statistics ───
fn syscall_invoke_count() -> int {
    return pwsock_count_rows(pwsock_syscall_invoke_path(), 4)
}

fn sock_lifecycle_count() -> int {
    return pwsock_count_rows(pwsock_sock_lifecycle_path(), 5)
}

fn io_round_trip_count() -> int {
    return pwsock_count_rows(pwsock_io_round_trip_path(), 5)
}

fn dns_round_trip_count() -> int {
    return pwsock_count_rows(pwsock_dns_round_trip_path(), 5)
}

fn pwsock_stats() -> array {
    let mut out = []
    out.push(syscall_invoke_count())
    out.push(sock_lifecycle_count())
    out.push(io_round_trip_count())
    out.push(dns_round_trip_count())
    return out
}

// ─── self_test ≥ 12 record + r0_emit ≥ 14 ───
fn self_test() -> void {
    let sid = "pwsock-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_pwsock()

    // ─── 1. syscall_invoke × 8 (8 representative WS2_32 fn) ───
    record_syscall_invoke(1, 0, "WSAStartup", "PARTIAL")
    println("__WINSOCK__ PARTIAL WSAStartup")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":1,\"fn_kind\":0,\"fn_name\":\"WSAStartup\",\"status\":\"PARTIAL\",\"wsadata_wversion\":\"0x0202\",\"wsadata_imaxsockets\":\"0x7FFF\"")
    record_syscall_invoke(2, 2, "socket", "PARTIAL")
    println("__WINSOCK__ PARTIAL socket")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":2,\"fn_kind\":2,\"fn_name\":\"socket\",\"status\":\"PARTIAL\",\"af\":2,\"sock_kind\":1,\"protocol\":6")
    record_syscall_invoke(3, 4, "connect", "PARTIAL")
    println("__WINSOCK__ PARTIAL connect")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":3,\"fn_kind\":4,\"fn_name\":\"connect\",\"status\":\"PARTIAL\",\"sockaddr_in_hex\":\"02000001BB01020304000000000000\"")
    record_syscall_invoke(4, 8, "send", "PARTIAL")
    println("__WINSOCK__ PARTIAL send")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":4,\"fn_kind\":8,\"fn_name\":\"send\",\"status\":\"PARTIAL\",\"bytes_synth\":256")
    record_syscall_invoke(5, 9, "recv", "PARTIAL")
    println("__WINSOCK__ PARTIAL recv")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":5,\"fn_kind\":9,\"fn_name\":\"recv\",\"status\":\"PARTIAL\",\"bytes_synth\":1024")
    record_syscall_invoke(6, 10, "WSASend", "PARTIAL")
    println("__WINSOCK__ PARTIAL WSASend")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":6,\"fn_kind\":10,\"fn_name\":\"WSASend\",\"status\":\"PARTIAL\",\"async\":true,\"wsabuf_count\":2")
    record_syscall_invoke(7, 13, "WSAEventSelect", "PARTIAL")
    println("__WINSOCK__ PARTIAL WSAEventSelect")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":7,\"fn_kind\":13,\"fn_name\":\"WSAEventSelect\",\"status\":\"PARTIAL\",\"event_mask\":\"0x00000023\"")
    record_syscall_invoke(8, 18, "select", "PARTIAL")
    println("__WINSOCK__ PARTIAL select")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"syscall_invoke\",\"invoke_id\":8,\"fn_kind\":18,\"fn_name\":\"select\",\"status\":\"PARTIAL\",\"nfds\":1,\"timeout_ms\":5000")

    // ─── 2. sock_lifecycle × 4 (open / connect / accept / close, synthetic fd) ───
    record_sock_lifecycle(1, "open", "0x00000280", 2, 1)
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"sock_lifecycle\",\"life_id\":1,\"op\":\"open\",\"fd_hex\":\"0x00000280\",\"af\":2,\"sock_kind\":1,\"af_name\":\"AF_INET\"")
    record_sock_lifecycle(2, "connect", "0x00000280", 2, 1)
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"sock_lifecycle\",\"life_id\":2,\"op\":\"connect\",\"fd_hex\":\"0x00000280\",\"target\":\"1.2.3.4:443\",\"sockaddr_synth_bytes\":16")
    record_sock_lifecycle(3, "accept", "0x00000284", 2, 1)
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"sock_lifecycle\",\"life_id\":3,\"op\":\"accept\",\"fd_hex\":\"0x00000284\",\"af\":2,\"sock_kind\":1,\"server_side\":true")
    record_sock_lifecycle(4, "close", "0x00000280", 2, 1)
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"sock_lifecycle\",\"life_id\":4,\"op\":\"close\",\"fd_hex\":\"0x00000280\",\"af\":2,\"sock_kind\":1,\"closesocket\":true")

    // ─── 3. io_round_trip × 4 (sync send/recv + async WSASend/WSARecv, synthetic bytes) ───
    record_io_round_trip(1, "send", "tx", 256, "PARTIAL")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"io_round_trip\",\"io_id\":1,\"io_kind\":\"send\",\"direction\":\"tx\",\"bytes_synth\":256,\"status\":\"PARTIAL\",\"sync\":true")
    record_io_round_trip(2, "recv", "rx", 1024, "PARTIAL")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"io_round_trip\",\"io_id\":2,\"io_kind\":\"recv\",\"direction\":\"rx\",\"bytes_synth\":1024,\"status\":\"PARTIAL\",\"sync\":true")
    record_io_round_trip(3, "WSASend", "tx", 4096, "PARTIAL")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"io_round_trip\",\"io_id\":3,\"io_kind\":\"WSASend\",\"direction\":\"tx\",\"bytes_synth\":4096,\"status\":\"PARTIAL\",\"async\":true,\"wsabuf_count\":2")
    record_io_round_trip(4, "WSARecv", "rx", 8192, "PARTIAL")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"io_round_trip\",\"io_id\":4,\"io_kind\":\"WSARecv\",\"direction\":\"rx\",\"bytes_synth\":8192,\"status\":\"PARTIAL\",\"async\":true,\"wsabuf_count\":4")

    // ─── 4. dns_round_trip × 2 (getaddrinfo + gethostbyname, synthetic Battle.net hostname) ───
    record_dns_round_trip(1, 15, "us.actual.battle.net", 4, "PARTIAL")
    println("__WINSOCK__ PARTIAL getaddrinfo")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"dns_round_trip\",\"dns_id\":1,\"fn_kind\":15,\"fn_name\":\"getaddrinfo\",\"hostname\":\"us.actual.battle.net\",\"result_count\":4,\"status\":\"PARTIAL\",\"family\":\"AF_INET\"")
    record_dns_round_trip(2, 17, "us.actual.battle.net", 1, "PARTIAL")
    println("__WINSOCK__ PARTIAL gethostbyname")
    r0_emit("pe_winsock_ws2_32_record", "\"kind\":\"dns_round_trip\",\"dns_id\":2,\"fn_kind\":17,\"fn_name\":\"gethostbyname\",\"hostname\":\"us.actual.battle.net\",\"result_count\":1,\"status\":\"PARTIAL\",\"legacy\":true")

    // ─── assertions: count ───
    let si = syscall_invoke_count()
    if si != 8 {
        panic("pe_winsock_ws2_32 FAIL [syscall_invoke_count] expected=8 got=" + to_string(si))
    }
    let sl = sock_lifecycle_count()
    if sl != 4 {
        panic("pe_winsock_ws2_32 FAIL [sock_lifecycle_count] expected=4 got=" + to_string(sl))
    }
    let io = io_round_trip_count()
    if io != 4 {
        panic("pe_winsock_ws2_32 FAIL [io_round_trip_count] expected=4 got=" + to_string(io))
    }
    let dn = dns_round_trip_count()
    if dn != 2 {
        panic("pe_winsock_ws2_32 FAIL [dns_round_trip_count] expected=2 got=" + to_string(dn))
    }

    // ─── helper name sanity ───
    if fn_kind_name(0) != "WSAStartup" {
        panic("pe_winsock_ws2_32 FAIL [fn_kind_name(0)]")
    }
    if fn_kind_name(2) != "socket" {
        panic("pe_winsock_ws2_32 FAIL [fn_kind_name(2)]")
    }
    if fn_kind_name(4) != "connect" {
        panic("pe_winsock_ws2_32 FAIL [fn_kind_name(4)]")
    }
    if fn_kind_name(15) != "getaddrinfo" {
        panic("pe_winsock_ws2_32 FAIL [fn_kind_name(15)]")
    }
    if fn_kind_name(19) != "WSAPoll" {
        panic("pe_winsock_ws2_32 FAIL [fn_kind_name(19)]")
    }
    if fn_kind_name(99) != "unknown" {
        panic("pe_winsock_ws2_32 FAIL [fn_kind_name(99)]")
    }

    // ─── stats sanity ───
    let s = pwsock_stats()
    if len(s) != 4 {
        panic("pe_winsock_ws2_32 FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 8 {
        panic("pe_winsock_ws2_32 FAIL [stats syscall_invoke_count] expected=8 got=" + to_string(s[0]))
    }
    if s[1] != 4 {
        panic("pe_winsock_ws2_32 FAIL [stats sock_lifecycle_count] expected=4 got=" + to_string(s[1]))
    }
    if s[2] != 4 {
        panic("pe_winsock_ws2_32 FAIL [stats io_round_trip_count] expected=4 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_winsock_ws2_32 FAIL [stats dns_round_trip_count] expected=2 got=" + to_string(s[3]))
    }

    // ─── stats / summary / KPI emit ───
    r0_emit("pe_winsock_ws2_32_stats",
        "\"syscall_invoke_count\":" + to_string(s[0])
        + ",\"sock_lifecycle_count\":" + to_string(s[1])
        + ",\"io_round_trip_count\":" + to_string(s[2])
        + ",\"dns_round_trip_count\":" + to_string(s[3]))

    r0_emit("pe_winsock_ws2_32_summary",
        "\"target\":\"WS2_32.dll\",\"fn_total\":20,\"fn_emit_partial\":10,\"sockaddr_in_synth_bytes\":16,\"wsadata_wversion\":\"0x0202\",\"shim_kind\":\"skeleton\",\"network\":\"none\",\"posture\":\"PARTIAL\"")

    r0_emit("pe_winsock_ws2_32_kpi",
        "\"sync_io_emits\":2,\"async_io_emits\":2,\"dns_emits\":2,\"lifecycle_emits\":4,\"network_real\":false,\"warden_compat_long_horizon\":true")

    // ─── PARTIAL round-trip matrix emit (cond evidence augment, NOT met promotion) ───
    r0_emit("pe_winsock_ws2_32_round_trip_matrix",
        "\"surface\":\"WS2_32_full_20_fn\",\"fn_partial\":10,\"fn_skeleton_only\":10,\"shim_kind\":\"skeleton\",\"network\":\"none\",\"cond\":\"loader_win32.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"real socket(2) + connect + send/recv pending separate cycle\",\"warden_compat_horizon\":\"long_horizon_L2\",\"online_expansion_lockin\":\"L1+L2+L3+L4+L5_OK\"")

    let emit_n = r0_session_count(sid)
    if emit_n < 14 {
        panic("pe_winsock_ws2_32 FAIL [r0 emit count] expected=>=14 got=" + to_string(emit_n))
    }

    // ─── cleanup → 모든 stats 0 ───
    cleanup_pwsock()
    let s2 = pwsock_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_winsock_ws2_32 FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_winsock_ws2_32 self_test PASS (syscall_invoke="
        + to_string(s[0]) + ", sock_lifecycle=" + to_string(s[1])
        + ", io_round_trip=" + to_string(s[2]) + ", dns_round_trip=" + to_string(s[3])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pwsock_stats()
            println("syscall_invoke_count\t" + to_string(s[0]))
            println("sock_lifecycle_count\t" + to_string(s[1]))
            println("io_round_trip_count\t" + to_string(s[2]))
            println("dns_round_trip_count\t" + to_string(s[3]))
            return
        }
        if sub == "fn-kind-name" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                println(fn_kind_name(k))
                return
            }
            println("usage: hexa run pe_winsock_ws2_32.hexa fn-kind-name <int>")
            return
        }
        if sub == "cleanup" {
            cleanup_pwsock()
            println("cleaned: " + pwsock_dir())
            return
        }
        if sub == "dir" {
            println(pwsock_dir())
            return
        }
    }
    println("usage: hexa run pe_winsock_ws2_32.hexa { self-test | stats | fn-kind-name <int> | cleanup | dir }")
}
