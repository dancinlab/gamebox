// lib/loader/pe_d3d12_mesh_shader.hexa — D3D12 mesh / amplification shader telemetry skeleton
//
// airgenome-gamebox cycle 76 — ID3D12GraphicsCommandList6::DispatchMesh tracker.
// mesh shader pipeline (amplification → mesh → pixel) 의 dispatch 1 건 단위로
// thread group / primitive 통계 누적.
//
// own 1 enforcement: Wine / CrossOver / community 코드 0 줄.
//   본 module 은 D3D12 dispatch tracker — 실 ID3D12GraphicsCommandList6 호출 X (stage6).
// own 2 mandate: r0_emit ≥ 6 + self_test() + main() dispatch + headless safe + panic 형식.
//
// shader_kind code:
//   1 = mesh
//   2 = amplification
//   3 = mesh_amp_pair  (amplification → mesh chain dispatch)
//
// persist schema (TSV — dispatches.tsv):
//   dispatch_id<int> \t shader_kind<int> \t thread_groups<int> \t primitive_count<int>

use "../perf/r0_common"

// ─── persist directory + schema paths ───
fn pdms_dir() -> str {
    return GAMEBOX_HOME + "/persist/pe_d3d12_mesh_shader"
}

fn pdms_dispatches_path() -> str {
    return pdms_dir() + "/dispatches.tsv"
}

fn pdms_ensure_dir() -> void {
    let _ = exec("mkdir -p '" + pdms_dir() + "'")
}

fn cleanup_pdms() -> void {
    pdms_ensure_dir()
    let _ = exec("rm -f '" + pdms_dispatches_path() + "'")
}

// ─── 공통 file IO ───
fn pdms_read_table(path: str) -> str {
    let exists = exec("test -f '" + path + "' && echo y || echo n").trim()
    if exists != "y" {
        return ""
    }
    return exec("cat '" + path + "' 2>/dev/null")
}

fn pdms_append_row(path: str, row: str) -> void {
    pdms_ensure_dir()
    let tmp = path + ".add.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// ─── record_dispatch: dispatch 1 건 기록 ───
fn record_dispatch(dispatch_id: int, shader_kind: int, thread_groups: int, primitive_count: int) -> void {
    if dispatch_id <= 0 {
        panic("pe_d3d12_mesh_shader FAIL [record_dispatch] expected=dispatch_id>0 got=" + to_string(dispatch_id))
    }
    if shader_kind < 1 {
        panic("pe_d3d12_mesh_shader FAIL [record_dispatch] expected=shader_kind>=1 got=" + to_string(shader_kind))
    }
    if shader_kind > 3 {
        panic("pe_d3d12_mesh_shader FAIL [record_dispatch] expected=shader_kind<=3 got=" + to_string(shader_kind))
    }
    if thread_groups < 0 {
        panic("pe_d3d12_mesh_shader FAIL [record_dispatch] expected=thread_groups>=0 got=" + to_string(thread_groups))
    }
    if primitive_count < 0 {
        panic("pe_d3d12_mesh_shader FAIL [record_dispatch] expected=primitive_count>=0 got=" + to_string(primitive_count))
    }
    let row = to_string(dispatch_id) + "\t" + to_string(shader_kind)
        + "\t" + to_string(thread_groups) + "\t" + to_string(primitive_count) + "\n"
    pdms_append_row(pdms_dispatches_path(), row)
}

// ─── dispatch_count: total dispatch 수 ───
fn dispatch_count() -> int {
    let t = pdms_read_table(pdms_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── total_thread_groups: 모든 dispatch 의 thread_groups 합 ───
fn total_thread_groups() -> int {
    let t = pdms_read_table(pdms_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[2])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── total_primitives: 모든 dispatch 의 primitive_count 합 ───
fn total_primitives() -> int {
    let t = pdms_read_table(pdms_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut sum = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                sum = sum + to_int(parts[3])
            }
        }
        i = i + 1
    }
    return sum
}

// ─── count_by_shader_kind: 특정 shader_kind 의 dispatch 수 ───
fn count_by_shader_kind(shader_kind: int) -> int {
    let t = pdms_read_table(pdms_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    let mut cnt = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[1]) == shader_kind {
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    return cnt
}

// ─── dispatch_primitive_count: 특정 dispatch_id 의 primitive_count (없으면 0) ───
fn dispatch_primitive_count(dispatch_id: int) -> int {
    let t = pdms_read_table(pdms_dispatches_path())
    if t == "" {
        return 0
    }
    let lines = t.split("\n")
    let n = len(lines)
    let i = 0
    while i < n {
        let line = lines[i]
        if line != "" {
            let parts = line.split("\t")
            if len(parts) >= 4 {
                if to_int(parts[0]) == dispatch_id {
                    return to_int(parts[3])
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ─── pdms_stats: [dispatch_count, total_thread_groups, total_primitives, count_by_shader_kind(1)] ───
fn pdms_stats() -> array {
    let mut out = []
    out.push(dispatch_count())
    out.push(total_thread_groups())
    out.push(total_primitives())
    out.push(count_by_shader_kind(1))
    return out
}

// ─── self_test ───
fn self_test() -> void {
    let sid = "pdms-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    cleanup_pdms()

    // 2. record 5 dispatches across ≥2 shader_kinds (1=mesh, 2=amplification, 3=pair)
    record_dispatch(760001, 1, 64, 1024)
    r0_emit("pe_d3d12_mesh_shader_record",
        "\"dispatch_id\":760001,\"shader_kind\":1,\"thread_groups\":64,\"primitive_count\":1024,\"target\":\"mesh\"")

    record_dispatch(760002, 2, 32, 0)
    r0_emit("pe_d3d12_mesh_shader_record",
        "\"dispatch_id\":760002,\"shader_kind\":2,\"thread_groups\":32,\"primitive_count\":0,\"target\":\"amplification\"")

    record_dispatch(760003, 1, 128, 2048)
    r0_emit("pe_d3d12_mesh_shader_record",
        "\"dispatch_id\":760003,\"shader_kind\":1,\"thread_groups\":128,\"primitive_count\":2048,\"target\":\"mesh\"")

    record_dispatch(760004, 3, 96, 1536)
    r0_emit("pe_d3d12_mesh_shader_record",
        "\"dispatch_id\":760004,\"shader_kind\":3,\"thread_groups\":96,\"primitive_count\":1536,\"target\":\"mesh_amp_pair\"")

    record_dispatch(760005, 2, 16, 0)
    r0_emit("pe_d3d12_mesh_shader_record",
        "\"dispatch_id\":760005,\"shader_kind\":2,\"thread_groups\":16,\"primitive_count\":0,\"target\":\"amplification\"")

    // 3. dispatch_count = 5
    let c = dispatch_count()
    if c != 5 {
        panic("pe_d3d12_mesh_shader FAIL [dispatch_count] expected=5 got=" + to_string(c))
    }

    // 4. total_thread_groups = 336
    let tg = total_thread_groups()
    if tg != 336 {
        panic("pe_d3d12_mesh_shader FAIL [total_thread_groups] expected=336 got=" + to_string(tg))
    }

    // 5. total_primitives = 4608
    let tp = total_primitives()
    if tp != 4608 {
        panic("pe_d3d12_mesh_shader FAIL [total_primitives] expected=4608 got=" + to_string(tp))
    }

    // 6. count_by_shader_kind sanity
    let k1 = count_by_shader_kind(1)
    if k1 != 2 {
        panic("pe_d3d12_mesh_shader FAIL [count_by_shader_kind(1)] expected=2 got=" + to_string(k1))
    }
    let k2 = count_by_shader_kind(2)
    if k2 != 2 {
        panic("pe_d3d12_mesh_shader FAIL [count_by_shader_kind(2)] expected=2 got=" + to_string(k2))
    }
    let k3 = count_by_shader_kind(3)
    if k3 != 1 {
        panic("pe_d3d12_mesh_shader FAIL [count_by_shader_kind(3)] expected=1 got=" + to_string(k3))
    }
    let k99 = count_by_shader_kind(99)
    if k99 != 0 {
        panic("pe_d3d12_mesh_shader FAIL [count_by_shader_kind(99)] expected=0 got=" + to_string(k99))
    }

    // 7. dispatch_primitive_count sanity
    let p1 = dispatch_primitive_count(760001)
    if p1 != 1024 {
        panic("pe_d3d12_mesh_shader FAIL [dispatch_primitive_count(760001)] expected=1024 got=" + to_string(p1))
    }
    let p4 = dispatch_primitive_count(760004)
    if p4 != 1536 {
        panic("pe_d3d12_mesh_shader FAIL [dispatch_primitive_count(760004)] expected=1536 got=" + to_string(p4))
    }
    let p_miss = dispatch_primitive_count(9999)
    if p_miss != 0 {
        panic("pe_d3d12_mesh_shader FAIL [dispatch_primitive_count(9999)] expected=0 got=" + to_string(p_miss))
    }

    // 8. pdms_stats() = [5, 336, 4608, 2]
    let s = pdms_stats()
    if len(s) != 4 {
        panic("pe_d3d12_mesh_shader FAIL [stats len] expected=4 got=" + to_string(len(s)))
    }
    if s[0] != 5 {
        panic("pe_d3d12_mesh_shader FAIL [stats dispatch_count] expected=5 got=" + to_string(s[0]))
    }
    if s[1] != 336 {
        panic("pe_d3d12_mesh_shader FAIL [stats total_thread_groups] expected=336 got=" + to_string(s[1]))
    }
    if s[2] != 4608 {
        panic("pe_d3d12_mesh_shader FAIL [stats total_primitives] expected=4608 got=" + to_string(s[2]))
    }
    if s[3] != 2 {
        panic("pe_d3d12_mesh_shader FAIL [stats count_kind(1)] expected=2 got=" + to_string(s[3]))
    }

    // 9. emit stats
    r0_emit("pe_d3d12_mesh_shader_stats",
        "\"dispatch_count\":" + to_string(s[0])
        + ",\"total_thread_groups\":" + to_string(s[1])
        + ",\"total_primitives\":" + to_string(s[2])
        + ",\"kind_mesh\":" + to_string(s[3]))

    // 10. emit count >= 6 (5 records + 1 stats = 6)
    let emit_n = r0_session_count(sid)
    if emit_n < 6 {
        panic("pe_d3d12_mesh_shader FAIL [r0 emit count] expected=>=6 got=" + to_string(emit_n))
    }

    // 11. cleanup → stats 모두 0
    cleanup_pdms()
    let s2 = pdms_stats()
    let i = 0
    while i < len(s2) {
        if s2[i] != 0 {
            panic("pe_d3d12_mesh_shader FAIL [cleanup stats[" + to_string(i)
                + "]] expected=0 got=" + to_string(s2[i]))
        }
        i = i + 1
    }

    println("  ✅ pe_d3d12_mesh_shader self_test PASS (dispatches=" + to_string(s[0])
        + ", thread_groups=" + to_string(s[1]) + ", prims=" + to_string(s[2])
        + ", emits=" + to_string(emit_n) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "stats" {
            let s = pdms_stats()
            println("dispatch_count\t" + to_string(s[0]))
            println("total_thread_groups\t" + to_string(s[1]))
            println("total_primitives\t" + to_string(s[2]))
            println("count_kind_mesh\t" + to_string(s[3]))
            return
        }
        if sub == "prims" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                println("dispatch_primitive_count\t" + to_string(dispatch_primitive_count(did)))
                return
            }
            println("usage: hexa run pe_d3d12_mesh_shader.hexa prims <dispatch_id>")
            return
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kind = to_int(a[3])
                println("count_by_shader_kind\t" + to_string(count_by_shader_kind(kind)))
                return
            }
            println("usage: hexa run pe_d3d12_mesh_shader.hexa count <shader_kind>")
            return
        }
        if sub == "cleanup" {
            cleanup_pdms()
            println("cleaned: " + pdms_dir())
            return
        }
        if sub == "dir" {
            println(pdms_dir())
            return
        }
    }
    println("usage: hexa run pe_d3d12_mesh_shader.hexa { self-test | stats | prims <dispatch_id> | count <shader_kind> | cleanup | dir }")
}
