// lib/perf/c_bnet_token_refresh_track.hexa — CN-108 skeleton manjeom 15/15
//
// Battle.net OAuth2 token refresh timing tracker — Phase 2.
// 목적: token expires_in - threshold(60s) 시점에 사전 갱신, disconnect 방지.
//
// 무기: token table (token_id, issued_ts, expires_in_s) + columnar (token × refresh latency).
// 효과: token 만료로 인한 disconnect 방지 (us.battle.net OAuth2 RFC 6749 호환).

use "./r0_common"

let BTRT_DIR = GAMEBOX_HOME + "/persist/bnet_token_refresh"
let TOKEN_TABLE = BTRT_DIR + "/tokens.tsv"
let REFRESH_LOG = BTRT_DIR + "/refresh.tsv"

fn btrt_dir() -> str { return BTRT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + BTRT_DIR + "'")
}

// ─── token 등록 (token_id → issued_ts, expires_in_s) ───
//   동일 token_id 는 덮어쓰기 (refresh 시 재등록).
fn record_token(token_id: str, issued_ts: int, expires_in_s: int) -> void {
    ensure_dir()
    if token_id == "" { panic("c_bnet_token_refresh_track FAIL [record_token empty id]") }
    // 중복 제거
    let exists = exec("test -f '" + TOKEN_TABLE + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v t='" + token_id + "' '$1!=t' '" + TOKEN_TABLE + "' > '" + TOKEN_TABLE + ".tmp' && mv '" + TOKEN_TABLE + ".tmp' '" + TOKEN_TABLE + "'")
    }
    let line = token_id + "\t" + to_string(issued_ts) + "\t" + to_string(expires_in_s)
    let tmp = TOKEN_TABLE + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + TOKEN_TABLE + "' && rm -f '" + tmp + "'")
    r0_emit("bnet_token_recorded", "\"id\":\"" + token_id + "\",\"issued\":" + to_string(issued_ts) + ",\"exp_in\":" + to_string(expires_in_s))
}

// ─── token lookup helpers ───
fn lookup_issued(token_id: str) -> int {
    let exists = exec("test -f '" + TOKEN_TABLE + "' && echo ok").trim()
    if exists != "ok" { return -1 }
    let r = exec("awk -F'\\t' -v t='" + token_id + "' '$1==t {print $2; exit}' '" + TOKEN_TABLE + "'").trim()
    if r == "" { return -1 }
    return to_int(r)
}

fn lookup_expires_in(token_id: str) -> int {
    let exists = exec("test -f '" + TOKEN_TABLE + "' && echo ok").trim()
    if exists != "ok" { return -1 }
    let r = exec("awk -F'\\t' -v t='" + token_id + "' '$1==t {print $3; exit}' '" + TOKEN_TABLE + "'").trim()
    if r == "" { return -1 }
    return to_int(r)
}

// ─── needs_refresh: 현재 시각이 (issued + expires_in - threshold) 이상이면 true ───
fn needs_refresh(token_id: str, now_ts: int, threshold_s: int) -> bool {
    let issued = lookup_issued(token_id)
    if issued < 0 { return false }
    let exp_in = lookup_expires_in(token_id)
    if exp_in < 0 { return false }
    let refresh_at = issued + exp_in - threshold_s
    if now_ts >= refresh_at {
        r0_emit("bnet_token_refresh_due", "\"id\":\"" + token_id + "\",\"now\":" + to_string(now_ts) + ",\"refresh_at\":" + to_string(refresh_at))
        return true
    }
    return false
}

// ─── next_refresh_at: 사전 갱신 시각 = issued + expires_in - threshold ───
fn next_refresh_at(token_id: str, threshold_s: int) -> int {
    let issued = lookup_issued(token_id)
    if issued < 0 { return -1 }
    let exp_in = lookup_expires_in(token_id)
    if exp_in < 0 { return -1 }
    return issued + exp_in - threshold_s
}

// ─── refresh 기록 (token_id, latency_ms) ───
fn record_refresh(token_id: str, latency_ms: int) -> void {
    ensure_dir()
    if token_id == "" { panic("c_bnet_token_refresh_track FAIL [record_refresh empty id]") }
    let ts = exec("date +%s").trim()
    let line = ts + "\t" + token_id + "\t" + to_string(latency_ms)
    let tmp = REFRESH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + REFRESH_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("bnet_token_refreshed", "\"id\":\"" + token_id + "\",\"latency_ms\":" + to_string(latency_ms))
}

fn refresh_history_count() -> int {
    let exists = exec("test -f '" + REFRESH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + REFRESH_LOG + "' | tr -d ' '").trim())
}

fn token_count() -> int {
    let exists = exec("test -f '" + TOKEN_TABLE + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + TOKEN_TABLE + "' | tr -d ' '").trim())
}

fn cleanup_btrt() -> void {
    let _ = exec("rm -rf '" + BTRT_DIR + "'")
}

fn self_test() -> void {
    let sid = "btrt-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_btrt()

    let now = to_int(exec("date +%s").trim())
    let threshold = 60

    // token A: issued now, expires_in 3600 (1h) → refresh_at = now + 3540 → not due now
    record_token("tok_a", now, 3600)
    // token B: issued now, expires_in 1800 (30min) → refresh_at = now + 1740 → not due
    record_token("tok_b", now, 1800)
    // token C: issued (now - 7200), expires_in 3600 → refresh_at = now - 3660 → way overdue
    record_token("tok_c", now - 7200, 3600)

    if token_count() != 3 { panic("c_bnet_token_refresh_track FAIL [token_count] expected=3 got=" + to_string(token_count())) }

    // tok_a — 1h fresh, threshold 60s → 갱신 불필요
    if needs_refresh("tok_a", now, threshold) {
        panic("c_bnet_token_refresh_track FAIL [needs_refresh tok_a] should be false")
    }
    // tok_b — 30min fresh → 갱신 불필요
    if needs_refresh("tok_b", now, threshold) {
        panic("c_bnet_token_refresh_track FAIL [needs_refresh tok_b] should be false")
    }
    // tok_c — 만료된 token → 갱신 필요
    if !needs_refresh("tok_c", now, threshold) {
        panic("c_bnet_token_refresh_track FAIL [needs_refresh tok_c] should be true")
    }

    // tok_a 의 refresh_at 검증: issued + 3600 - 60 = now + 3540
    let ra = next_refresh_at("tok_a", threshold)
    let expected_a = now + 3540
    if ra != expected_a {
        panic("c_bnet_token_refresh_track FAIL [next_refresh_at tok_a] expected=" + to_string(expected_a) + " got=" + to_string(ra))
    }

    // tok_c 의 refresh_at: (now - 7200) + 3600 - 60 = now - 3660
    let rc = next_refresh_at("tok_c", threshold)
    let expected_c = now - 3660
    if rc != expected_c {
        panic("c_bnet_token_refresh_track FAIL [next_refresh_at tok_c] expected=" + to_string(expected_c) + " got=" + to_string(rc))
    }

    // 미존재 token
    let rm = next_refresh_at("nonexistent", threshold)
    if rm != -1 {
        panic("c_bnet_token_refresh_track FAIL [next_refresh_at miss] expected=-1 got=" + to_string(rm))
    }
    if needs_refresh("nonexistent", now, threshold) {
        panic("c_bnet_token_refresh_track FAIL [needs_refresh miss] should be false")
    }

    // 만료 token 갱신 → record_refresh + record_token (renewed)
    record_refresh("tok_c", 120)
    record_token("tok_c", now, 3600)

    // 두 번째 갱신
    record_refresh("tok_a", 95)

    let hist = refresh_history_count()
    if hist != 2 { panic("c_bnet_token_refresh_track FAIL [history] expected=2 got=" + to_string(hist)) }

    // tok_c 재등록 후 needs_refresh = false
    if needs_refresh("tok_c", now, threshold) {
        panic("c_bnet_token_refresh_track FAIL [tok_c after refresh] should be false")
    }

    r0_emit("bnet_token_summary", "\"tokens\":" + to_string(token_count()) + ",\"refreshes\":" + to_string(hist))

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_bnet_token_refresh_track FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    // ─── synthetic token refresh state machine round-trip (Track-N cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track-N mission: battlenet cond.3 (OAuth 2-leg + token refresh track live)
    // 측 evidence augment. cond.3 status `partial` 영구 유지 — 실 OAuth2 refresh
    // endpoint + 실 RFC 6749 grant_type=refresh_token round-trip 측 production smoke
    // gate transitive (network-dependent, blk.1 + Track-K syscall perfection 정합).
    //
    // synthetic token refresh state machine: VALID → NEAR_EXPIRY → REFRESH_REQUEST
    // → REFRESH_SUCCESS → REFRESH_FAIL_RETRY 5 transition. hexa-native loop only —
    // 실 token signing key 0, refresh_token bearer 0, OAuth2 server endpoint 0,
    // exponential backoff 측 실 timer 0 (synthetic constant only). payload =
    // token_id + refresh_attempt_count + backoff_ms_simulated.
    // round-trip emit = `__BNET_TOKEN__ PARTIAL <state>` per row.
    //
    // own1: Wine 0 / token forge 0 / refresh_token spoof 0.
    // own2: PARTIAL emit explicit (NOT PASS — production smoke deferred).
    let synth_token_id = "tok-synth-" + exec("date +%s").trim()

    println("__BNET_TOKEN__ PARTIAL VALID")
    r0_emit("c_bnet_token_refresh_synthetic_state",
        "\"stage\":\"token_refresh_state_machine\",\"token_id\":\"" + synth_token_id + "\",\"refresh_state_kind\":\"VALID\",\"refresh_attempt_count\":0,\"backoff_ms_simulated\":0,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"permanent_until_real_network — blk.1 transitive\"")

    println("__BNET_TOKEN__ PARTIAL NEAR_EXPIRY")
    r0_emit("c_bnet_token_refresh_synthetic_state",
        "\"stage\":\"token_refresh_state_machine\",\"token_id\":\"" + synth_token_id + "\",\"refresh_state_kind\":\"NEAR_EXPIRY\",\"refresh_attempt_count\":0,\"backoff_ms_simulated\":0,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__BNET_TOKEN__ PARTIAL REFRESH_REQUEST")
    r0_emit("c_bnet_token_refresh_synthetic_state",
        "\"stage\":\"token_refresh_state_machine\",\"token_id\":\"" + synth_token_id + "\",\"refresh_state_kind\":\"REFRESH_REQUEST\",\"refresh_attempt_count\":1,\"backoff_ms_simulated\":0,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__BNET_TOKEN__ PARTIAL REFRESH_SUCCESS")
    r0_emit("c_bnet_token_refresh_synthetic_state",
        "\"stage\":\"token_refresh_state_machine\",\"token_id\":\"" + synth_token_id + "\",\"refresh_state_kind\":\"REFRESH_SUCCESS\",\"refresh_attempt_count\":1,\"backoff_ms_simulated\":0,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__BNET_TOKEN__ PARTIAL REFRESH_FAIL_RETRY")
    r0_emit("c_bnet_token_refresh_synthetic_state",
        "\"stage\":\"token_refresh_state_machine\",\"token_id\":\"" + synth_token_id + "\",\"refresh_state_kind\":\"REFRESH_FAIL_RETRY\",\"refresh_attempt_count\":2,\"backoff_ms_simulated\":2000,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    r0_emit("c_bnet_token_refresh_synthetic_round_trip_matrix",
        "\"states_total\":5,\"states_partial\":5,\"states_pass\":0,\"token_id\":\"" + synth_token_id + "\",\"transport_kind\":\"synthetic_inline\",\"network\":\"none\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"track\":\"N3\",\"lockin_iso\":\"2026-05-03\"")

    cleanup_btrt()

    println("  ✅ c_bnet_token_refresh_track self_test PASS (3 tokens, threshold=60s, refreshes=" + to_string(hist) + ", +5 synthetic state PARTIAL transitions, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "refresh" && len(a) >= 5 {
            record_refresh(a[3], to_int(a[4]))
            println("recorded")
            return
        }
        if sub == "stats" {
            println("tokens=" + to_string(token_count()) + " refreshes=" + to_string(refresh_history_count()))
            return
        }
        if sub == "cleanup" { cleanup_btrt(); println("cleaned"); return }
    }
    println("usage: hexa run c_bnet_token_refresh_track.hexa { self-test | refresh <token_id> <latency_ms> | stats | cleanup }")
}
