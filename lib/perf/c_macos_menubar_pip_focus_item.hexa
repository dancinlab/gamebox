// lib/perf/c_macos_menubar_pip_focus_item.hexa — CN-216 skeleton manjeom 15/15
//
// macOS 메뉴바 의 "Focus PIP" menu item 추적 — Ctrl+G 단축키와 동일 동작
// 메뉴바 vector. NSMenu 의 "Focus PIP" item 을 사용자가 메뉴바에서 click
// 시 main↔PIP focus toggle. CN-208 (Ctrl+G hotkey) 와 동기 — 둘 다 같은
// focus state 변경. 본 모듈은 action × from_focus × to_focus × elapsed
// 4-key 컬럼 로그로 메뉴바 PIP focus 전환 정량화만 담당.
//
// 무기: action × from × to × elapsed 4-key columnar log.
// 효과: 메뉴바 PIP focus 전환 정량화 → Ctrl+G hotkey 와의 사용 분포 비교.

use "./r0_common"

let MMPFI_DIR = GAMEBOX_HOME + "/persist/macos_menubar_pip_focus_item"
let ACTION_LOG = MMPFI_DIR + "/actions.tsv"

fn mmpfi_dir() -> str { return MMPFI_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + MMPFI_DIR + "'")
}

// ─── action 등록 ───
//   action_id (event sequence id),
//   from_focus (1=main, 2=pip),
//   to_focus   (1=main, 2=pip),
//   elapsed_us (메뉴바 click → focus 전환 완료 us).
fn record_action(action_id: int, from_focus: int, to_focus: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(action_id) + "\t" + to_string(from_focus) + "\t" + to_string(to_focus) + "\t" + to_string(elapsed_us)
    let tmp = ACTION_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + ACTION_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("mmpfi_record", "\"action\":" + to_string(action_id) + ",\"from\":" + to_string(from_focus) + ",\"to\":" + to_string(to_focus) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── action_count — 등록된 action 행 수 ───
fn action_count() -> int {
    let exists = exec("test -f '" + ACTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + ACTION_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_elapsed_us — 모든 action elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + ACTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + ACTION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_main_to_pip — from=1 & to=2 행 수 ───
fn count_main_to_pip() -> int {
    let exists = exec("test -f '" + ACTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$2==1 && $3==2 {n++} END{print n+0}' '" + ACTION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_pip_to_main — from=2 & to=1 행 수 ───
fn count_pip_to_main() -> int {
    let exists = exec("test -f '" + ACTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$2==2 && $3==1 {n++} END{print n+0}' '" + ACTION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── action_elapsed — 특정 action_id 의 elapsed_us ───
//   미등록 action_id 는 0.
fn action_elapsed(action_id: int) -> int {
    let exists = exec("test -f '" + ACTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(action_id) + " '$1==a {s+=$4} END{print s+0}' '" + ACTION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── mmpfi_stats — [action_count, total_elapsed_us, count_main_to_pip, count_pip_to_main] ───
fn mmpfi_stats() -> array {
    return [action_count(), total_elapsed_us(), count_main_to_pip(), count_pip_to_main()]
}

fn cleanup_mmpfi() -> void {
    let _ = exec("rm -rf '" + MMPFI_DIR + "'")
}

fn self_test() -> void {
    let sid = "mmpfi-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_mmpfi()

    // 합성 action 3 종 — 메뉴바 click 시퀀스:
    //   67001: main(1) → pip(2)  150 us
    //   67002: pip(2)  → main(1) 120 us
    //   67003: main(1) → pip(2)  130 us
    record_action(67001, 1, 2, 150)
    record_action(67002, 2, 1, 120)
    record_action(67003, 1, 2, 130)

    // action_count = 3
    let ac = action_count()
    if ac != 3 { panic("c_macos_menubar_pip_focus_item FAIL [action_count] expected=3 got=" + to_string(ac)) }

    // total_elapsed_us = 150+120+130 = 400
    let te = total_elapsed_us()
    if te != 400 { panic("c_macos_menubar_pip_focus_item FAIL [total_elapsed_us] expected=400 got=" + to_string(te)) }

    // count_main_to_pip = 2 (67001 + 67003)
    let cm2p = count_main_to_pip()
    if cm2p != 2 { panic("c_macos_menubar_pip_focus_item FAIL [count_main_to_pip] expected=2 got=" + to_string(cm2p)) }

    // count_pip_to_main = 1 (67002)
    let cp2m = count_pip_to_main()
    if cp2m != 1 { panic("c_macos_menubar_pip_focus_item FAIL [count_pip_to_main] expected=1 got=" + to_string(cp2m)) }

    // action_elapsed 개별 검증
    let e1 = action_elapsed(67001)
    if e1 != 150 { panic("c_macos_menubar_pip_focus_item FAIL [elapsed 67001] expected=150 got=" + to_string(e1)) }
    let e2 = action_elapsed(67002)
    if e2 != 120 { panic("c_macos_menubar_pip_focus_item FAIL [elapsed 67002] expected=120 got=" + to_string(e2)) }
    let e3 = action_elapsed(67003)
    if e3 != 130 { panic("c_macos_menubar_pip_focus_item FAIL [elapsed 67003] expected=130 got=" + to_string(e3)) }
    // 미등록 action_id 는 0
    let e4 = action_elapsed(9999)
    if e4 != 0 { panic("c_macos_menubar_pip_focus_item FAIL [elapsed unknown] expected=0 got=" + to_string(e4)) }

    let stats = mmpfi_stats()
    if stats[0] != 3 { panic("c_macos_menubar_pip_focus_item FAIL [stats actions] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 400 { panic("c_macos_menubar_pip_focus_item FAIL [stats total_us] expected=400 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_macos_menubar_pip_focus_item FAIL [stats m2p] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_macos_menubar_pip_focus_item FAIL [stats p2m] expected=1 got=" + to_string(stats[3])) }

    r0_emit("mmpfi_summary", "\"actions\":" + to_string(stats[0]) + ",\"total_us\":" + to_string(stats[1]) + ",\"m2p\":" + to_string(stats[2]) + ",\"p2m\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_macos_menubar_pip_focus_item FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic NSStatusBar PIP focus round-trip (Track BI — diablo2_resurrected cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BI mission: c_macos_* family 100% completion cycle (Track BF 1/4 → BI 4/4) —
    // c_macos_menubar_pip_focus_item 측 Apple-native synthetic round-trip 추가.
    // NSStatusBarItem PIP focus lifecycle (request → focus_swap → main_pip_swap → notify)
    // 측 spec freeze. Apple-native scaffold only (own1 정합, AVPictureInPictureController
    // binary linkage 0).
    //
    // (a) synthetic 4-phase PIP focus lifecycle —
    //     focus_request → focus_swap → main_pip_swap → notify_dispatch:
    //     phase_count               4
    //     pip_obj_off               0x180054000         (synthetic AVPictureInPictureController RVA)
    //     lifecycle_kind            "synthetic_inline"  (실 AVPictureInPictureController 호출 X)
    //
    // (b) synthetic from × to 4-slot focus swap matrix —
    //     2 from_window (main/pip) × 2 to_window (main/pip) = 4 slots:
    //     slot_total                4
    //     m2p_slot_count            1                   (main → pip transition)
    //     p2m_slot_count            1                   (pip → main transition)
    //     identity_slot_count       2                   (main→main / pip→pip no-op)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = pip_focus_phase(scaffold) → walk_focus_swap_matrix(scaffold).
    //              hexa-native loop only — 실 AVPictureInPictureController.startPictureInPicture 0,
    //              real NSWindow.makeKeyAndOrderFront 0.
    //
    // synthetic PIP focus phase emit
    r0_emit("c_macos_menubar_pip_focus_item_synthetic_phase",
        "\"stage\":\"pip_focus_phase\",\"phase_count\":4,\"pip_obj_off\":\"0x180054000\",\"lifecycle_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real AVPictureInPictureController binary linkage\"")
    println("__MACOS_PIP__ PARTIAL pip_focus_phase")

    // synthetic from × to focus swap matrix emit
    r0_emit("c_macos_menubar_pip_focus_item_synthetic_matrix",
        "\"stage\":\"focus_swap_matrix\",\"slot_total\":4,\"m2p_slot_count\":1,\"p2m_slot_count\":1,\"identity_slot_count\":2,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real AVPictureInPictureController binary linkage\"")
    println("__MACOS_PIP__ PARTIAL focus_swap_matrix")

    cleanup_mmpfi()

    println("  ✅ c_macos_menubar_pip_focus_item self_test PASS (3 actions, total=400 us, m2p=2, p2m=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = mmpfi_stats()
            println("actions=" + to_string(s[0]) + " total_us=" + to_string(s[1]) + " m2p=" + to_string(s[2]) + " p2m=" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let aid = to_int(a[3])
                let us = action_elapsed(aid)
                println(to_string(us))
                return
            }
        }
        if sub == "cleanup" { cleanup_mmpfi(); println("cleaned"); return }
    }
    println("usage: hexa run c_macos_menubar_pip_focus_item.hexa { self-test | stats | elapsed <action_id> | cleanup }")
}
