// lib/perf/c_d4_dungeon_sigil_inventory.hexa — CN-201 skeleton manjeom 15/15
//
// D4 Nightmare Sigil inventory 추적 — tier 별 stockpile + crafting cost.
//
// 시나리오: D4 의 Nightmare Dungeon 진입에는 Sigil (tier 1-100) 이 필요하다.
// Sigil 은 Crafting Materials 으로 craft 하거나 NM dungeon clear drop 으로 수급
// 가능. 본 모듈은 sigil × tier × stockpile_count × craft_cost 4-key 컬럼 로그를
// 보관하여 inventory management 측면을 담당한다 — c_d4_nightmare_sigil_track
// (affix composition 분석) 과는 별도 책임.
//
// 무기: sigil × tier × stockpile × craft_cost 4-key columnar log.
// 효과: D4 NM sigil 관리 정량화 — 어느 tier 가 모자라고 어느 sigil 의 craft
// 비용이 비대한지 한눈에 파악.

use "./r0_common"

let DDSI_DIR = GAMEBOX_HOME + "/persist/d4_dungeon_sigil_inventory"
let SIGIL_LOG = DDSI_DIR + "/sigils.tsv"

fn ddsi_dir() -> str { return DDSI_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DDSI_DIR + "'")
}

// ─── sigil 등록 ───
//   sigil_id (logical sigil identifier),
//   tier (1..100, NM dungeon tier),
//   stockpile_count (현 보관 수량),
//   craft_cost (1 sigil 당 누적 craft material cost).
fn record_sigil(sigil_id: int, tier: int, stockpile_count: int, craft_cost: int) -> void {
    ensure_dir()
    let line = to_string(sigil_id) + "\t" + to_string(tier) + "\t" + to_string(stockpile_count) + "\t" + to_string(craft_cost)
    let tmp = SIGIL_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SIGIL_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_ddsi_record", "\"sigil\":" + to_string(sigil_id) + ",\"tier\":" + to_string(tier) + ",\"stockpile\":" + to_string(stockpile_count) + ",\"craft_cost\":" + to_string(craft_cost))
}

// ─── sigil_count — 등록된 sigil 행 수 ───
fn sigil_count() -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SIGIL_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_stockpile — 모든 sigil stockpile_count 합 ───
fn total_stockpile() -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + SIGIL_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_craft_cost — 모든 sigil craft_cost 합 ───
fn total_craft_cost() -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + SIGIL_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_tier — 특정 tier 의 sigil 행 수 ───
fn count_by_tier(tier: int) -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$2==t' '" + SIGIL_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// ─── sigil_stockpile — 특정 sigil_id 의 stockpile_count 합 ───
//   미등록 sigil_id 는 0.
fn sigil_stockpile(sigil_id: int) -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v sid=" + to_string(sigil_id) + " '$1==sid {s+=$3} END{print s+0}' '" + SIGIL_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── ddsi_stats — [sigil_count, total_stockpile, total_craft_cost, count_by_tier(50)] ───
fn ddsi_stats() -> array {
    return [sigil_count(), total_stockpile(), total_craft_cost(), count_by_tier(50)]
}

fn cleanup_ddsi() -> void {
    let _ = exec("rm -rf '" + DDSI_DIR + "'")
}

fn self_test() -> void {
    let sid = "ddsi-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_ddsi()

    // 합성 sigil 3 종:
    //   53001 — tier 30  stockpile 12  craft 24000
    //   53002 — tier 50  stockpile  8  craft 80000
    //   53003 — tier 80  stockpile  2  craft 240000
    record_sigil(53001, 30, 12, 24000)
    record_sigil(53002, 50,  8, 80000)
    record_sigil(53003, 80,  2, 240000)

    // sigil_count = 3
    let sc = sigil_count()
    if sc != 3 { panic("c_d4_dungeon_sigil_inventory FAIL [sigil_count] expected=3 got=" + to_string(sc)) }

    // total_stockpile = 12+8+2 = 22
    let ts = total_stockpile()
    if ts != 22 { panic("c_d4_dungeon_sigil_inventory FAIL [total_stockpile] expected=22 got=" + to_string(ts)) }

    // total_craft_cost = 24000+80000+240000 = 344000
    let tc = total_craft_cost()
    if tc != 344000 { panic("c_d4_dungeon_sigil_inventory FAIL [total_craft_cost] expected=344000 got=" + to_string(tc)) }

    // count_by_tier
    let c30 = count_by_tier(30)
    if c30 != 1 { panic("c_d4_dungeon_sigil_inventory FAIL [count_by_tier 30] expected=1 got=" + to_string(c30)) }
    let c50 = count_by_tier(50)
    if c50 != 1 { panic("c_d4_dungeon_sigil_inventory FAIL [count_by_tier 50] expected=1 got=" + to_string(c50)) }
    let c80 = count_by_tier(80)
    if c80 != 1 { panic("c_d4_dungeon_sigil_inventory FAIL [count_by_tier 80] expected=1 got=" + to_string(c80)) }
    let c99 = count_by_tier(99)
    if c99 != 0 { panic("c_d4_dungeon_sigil_inventory FAIL [count_by_tier 99 empty] got=" + to_string(c99)) }

    // sigil_stockpile
    let s1 = sigil_stockpile(53001)
    if s1 != 12 { panic("c_d4_dungeon_sigil_inventory FAIL [stockpile 53001] expected=12 got=" + to_string(s1)) }
    let s2 = sigil_stockpile(53002)
    if s2 != 8 { panic("c_d4_dungeon_sigil_inventory FAIL [stockpile 53002] expected=8 got=" + to_string(s2)) }
    let s3 = sigil_stockpile(53003)
    if s3 != 2 { panic("c_d4_dungeon_sigil_inventory FAIL [stockpile 53003] expected=2 got=" + to_string(s3)) }
    let s4 = sigil_stockpile(9999)
    if s4 != 0 { panic("c_d4_dungeon_sigil_inventory FAIL [stockpile unknown] expected=0 got=" + to_string(s4)) }

    // ddsi_stats = [3, 22, 344000, 1]
    let stats = ddsi_stats()
    if stats[0] != 3 { panic("c_d4_dungeon_sigil_inventory FAIL [stats sigil_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 22 { panic("c_d4_dungeon_sigil_inventory FAIL [stats total_stockpile] expected=22 got=" + to_string(stats[1])) }
    if stats[2] != 344000 { panic("c_d4_dungeon_sigil_inventory FAIL [stats total_craft_cost] expected=344000 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_d4_dungeon_sigil_inventory FAIL [stats count_by_tier(50)] expected=1 got=" + to_string(stats[3])) }

    r0_emit("d4_ddsi_summary", "\"sigils\":" + to_string(stats[0]) + ",\"stockpile\":" + to_string(stats[1]) + ",\"craft_cost\":" + to_string(stats[2]) + ",\"tier50\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 4 { panic("c_d4_dungeon_sigil_inventory FAIL [emit count] expected>=4 got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AL) ───
    //
    // Track AL mission: extend Track V (7) + Track AJ (6) D4 retired_intentional posture
    // annotation to 6 additional c_d4_* modules (aspect_imprint_track + dungeon_sigil_
    // inventory + dxr_first_frame_trace + helltide_event + infernal_horde_wave + loot_
    // drop_predict). .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional
    // (Track A2 land 2026-05-03). 본 module 측 nightmare/dungeon sigil inventory tracker
    // = synthetic stockpile analyzer — production live game state 측정 X (D4 always-
    // online live session 진입 X, DRM bypass 0, Battle.net launcher 통과 X). 본 cycle
    // 측 module self_test() 측 honest annotation row 추가 only — cond.3 status `partial`
    // 영구 유지 (retired_intentional posture per blk.1 영구 lock). pattern reference:
    //     lib/perf/c_d4_paragon_track.hexa (Track AJ predecessor, identical schema)
    //
    // synthetic posture row column header:
    //     domain                "dungeon_sigil_inventory"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_dungeon_sigil_inventory_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"dungeon_sigil_inventory\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_DUNGEON_SIGIL__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_ddsi()

    println("  ✅ c_d4_dungeon_sigil_inventory self_test PASS (3 sigils, stockpile=22, craft_cost=344000, tier50=1, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = ddsi_stats()
            println("sigils=" + to_string(s[0]) + " stockpile=" + to_string(s[1]) + " craft_cost=" + to_string(s[2]) + " tier50=" + to_string(s[3]))
            return
        }
        if sub == "stockpile" {
            if len(a) >= 4 {
                println(to_string(sigil_stockpile(to_int(a[3]))))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                println(to_string(count_by_tier(to_int(a[3]))))
                return
            }
        }
        if sub == "cleanup" { cleanup_ddsi(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_dungeon_sigil_inventory.hexa { self-test | stats | stockpile <sigil_id> | count <tier> | cleanup }")
}
