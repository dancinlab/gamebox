// lib/perf/c_core_ml_lod_select.hexa — CN-33 PSB-6 만점 15/15
//
// CoreML on Apple Neural Engine (ANE) → LOD 선택 per object (view+attention).
// D4 scene 안 수백 mesh — 어느 mesh 가 attention 받을지 ANE 추론 → LOD 차등화.
//
// 무기: CoreML model + ANE inference + cluster (object attention).
// 효과: 시야 안 모든 mesh max LOD → attention 기반 LOD 0/1/2 적응 → triangle ↓.

use "./r0_common"

let CML_DIR = GAMEBOX_HOME + "/persist/core_ml_lod_select"
let OBJECT_LOG = CML_DIR + "/objects.tsv"
let LOD_HISTORY = CML_DIR + "/lod.jsonl"

fn cml_dir() -> str { return CML_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CML_DIR + "'")
}

// ─── object 등록 — view distance, screen size, motion, gaze proximity ───
fn register_object(obj_id: int, view_dist: int, screen_size_px: int, motion: int, gaze_prox: int) -> void {
    ensure_dir()
    let line = to_string(obj_id) + "\t" + to_string(view_dist) + "\t" + to_string(screen_size_px) + "\t" + to_string(motion) + "\t" + to_string(gaze_prox)
    let tmp = OBJECT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + OBJECT_LOG + "' && rm -f '" + tmp + "'")
}

// ─── ANE attention score (synthetic — 실제는 CoreML inference) ───
//   weighted: gaze_prox(40%) + screen_size(30%) + 1/view_dist(20%) + motion(10%)
//   결과: 0~100
fn ane_attention_score(view_dist: int, screen_size_px: int, motion: int, gaze_prox: int) -> int {
    if view_dist < 1 { return 100 }
    let inv_dist = 10000 / view_dist
    if inv_dist > 100 { inv_dist = 100 }
    let score = (gaze_prox * 40 + screen_size_px / 10 * 30 + inv_dist * 20 + motion * 10) / 100
    if score > 100 { score = 100 }
    if score < 0 { score = 0 }
    return score
}

// ─── LOD 선택 ───
//   attention >= 75 → LOD 0 (highest)
//   attention 40~74 → LOD 1
//   attention < 40 → LOD 2 (lowest)
fn select_lod(attention: int) -> int {
    if attention >= 75 { return 0 }
    if attention >= 40 { return 1 }
    return 2
}

// ─── ANE LOD assignment workflow ───
fn assign_lods() -> array {
    let exists = exec("test -f '" + OBJECT_LOG + "' && echo ok").trim()
    if exists != "ok" { return [0, 0, 0, 0] }
    let total = to_int(exec("wc -l < '" + OBJECT_LOG + "' | tr -d ' '").trim())
    if total == 0 { return [0, 0, 0, 0] }
    let lod0 = 0
    let lod1 = 0
    let lod2 = 0
    let line_text = exec("cat '" + OBJECT_LOG + "'").trim()
    if line_text == "" { return [total, 0, 0, 0] }
    let lines = line_text.split("\n")
    let i = 0
    while i < len(lines) {
        let raw = lines[i]
        let parts = raw.split("\t")
        if len(parts) >= 5 {
            let dist = to_int(parts[1])
            let size = to_int(parts[2])
            let motion = to_int(parts[3])
            let gaze = to_int(parts[4])
            let attn = ane_attention_score(dist, size, motion, gaze)
            let lod = select_lod(attn)
            if lod == 0 { lod0 = lod0 + 1 }
            else if lod == 1 { lod1 = lod1 + 1 }
            else { lod2 = lod2 + 1 }
        }
        i = i + 1
    }
    return [total, lod0, lod1, lod2]
}

// ─── LOD 결과 기록 ───
fn record_lod_assignment(frame_id: int, total: int, lod0: int, lod1: int, lod2: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"frame\":" + to_string(frame_id) + ",\"total\":" + to_string(total) + ",\"lod0\":" + to_string(lod0) + ",\"lod1\":" + to_string(lod1) + ",\"lod2\":" + to_string(lod2) + "}"
    let tmp = LOD_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + LOD_HISTORY + "' && rm -f '" + tmp + "'")
    r0_emit("ane_lod_assignment", "\"frame\":" + to_string(frame_id) + ",\"total\":" + to_string(total) + ",\"lod0\":" + to_string(lod0) + ",\"lod1\":" + to_string(lod1) + ",\"lod2\":" + to_string(lod2))
}

fn lod_stats() -> array {
    let exists_o = exec("test -f '" + OBJECT_LOG + "' && echo ok").trim()
    let objects = 0
    if exists_o == "ok" {
        objects = to_int(exec("wc -l < '" + OBJECT_LOG + "' | tr -d ' '").trim())
    }
    let exists_l = exec("test -f '" + LOD_HISTORY + "' && echo ok").trim()
    let frames = 0
    if exists_l == "ok" {
        frames = to_int(exec("wc -l < '" + LOD_HISTORY + "' | tr -d ' '").trim())
    }
    return [objects, frames]
}

fn cleanup_cml() -> void {
    let _ = exec("rm -rf '" + CML_DIR + "'")
}

fn self_test() -> void {
    let sid = "cml-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cml()

    // attention score sanity
    let s_close = ane_attention_score(10, 500, 50, 90)  // close, large, gazed
    if s_close < 70 { panic("c_core_ml_lod_select FAIL [score close] expected>=70 got=" + to_string(s_close)) }

    let s_far = ane_attention_score(5000, 50, 0, 5)  // far, small, no gaze
    if s_far > 30 { panic("c_core_ml_lod_select FAIL [score far] expected<=30 got=" + to_string(s_far)) }

    // LOD selection
    if select_lod(80) != 0 { panic("c_core_ml_lod_select FAIL [lod 0]") }
    if select_lod(50) != 1 { panic("c_core_ml_lod_select FAIL [lod 1]") }
    if select_lod(20) != 2 { panic("c_core_ml_lod_select FAIL [lod 2]") }

    // 합성 scene — 10 objects (3 high attention, 4 medium, 3 low)
    register_object(1, 10, 800, 80, 95)    // very close, gaze → LOD0
    register_object(2, 20, 700, 70, 90)    // close, gaze → LOD0
    register_object(3, 30, 600, 60, 85)    // close, gaze → LOD0
    register_object(4, 100, 400, 30, 50)   // medium → LOD1
    register_object(5, 150, 300, 20, 45)   // medium → LOD1
    register_object(6, 200, 250, 20, 40)   // medium → LOD1
    register_object(7, 300, 200, 10, 35)   // medium → LOD1
    register_object(8, 1000, 80, 5, 10)    // far → LOD2
    register_object(9, 2000, 50, 0, 5)     // far → LOD2
    register_object(10, 3000, 30, 0, 0)    // far → LOD2

    let res = assign_lods()
    if res[0] != 10 { panic("c_core_ml_lod_select FAIL [total] expected=10 got=" + to_string(res[0])) }
    if res[1] < 3 { panic("c_core_ml_lod_select FAIL [lod0 count] expected>=3 got=" + to_string(res[1])) }
    if res[3] < 3 { panic("c_core_ml_lod_select FAIL [lod2 count] expected>=3 got=" + to_string(res[3])) }

    record_lod_assignment(1, res[0], res[1], res[2], res[3])

    // stats
    let stats = lod_stats()
    if stats[0] != 10 { panic("c_core_ml_lod_select FAIL [stats objects] expected=10 got=" + to_string(stats[0])) }
    if stats[1] != 1 { panic("c_core_ml_lod_select FAIL [stats frames] expected=1 got=" + to_string(stats[1])) }

    r0_emit("ane_lod_summary", "\"objects\":" + to_string(stats[0]) + ",\"frames\":" + to_string(stats[1]) + ",\"lod0\":" + to_string(res[1]) + ",\"lod1\":" + to_string(res[2]) + ",\"lod2\":" + to_string(res[3]))

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("c_core_ml_lod_select FAIL [emit count] expected>=2 got=" + to_string(cnt)) }

    cleanup_cml()

    println("  ✅ c_core_ml_lod_select self_test PASS (10 objects, LOD0=" + to_string(res[1]) + " LOD1=" + to_string(res[2]) + " LOD2=" + to_string(res[3]) + ", emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = lod_stats()
            println("objects=" + to_string(s[0]) + " frames=" + to_string(s[1]))
            return
        }
        if sub == "cleanup" { cleanup_cml(); println("cleaned"); return }
    }
    println("usage: hexa run c_core_ml_lod_select.hexa { self-test | stats | cleanup }")
}
