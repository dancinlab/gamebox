// lib/perf/c_d2r_first_frame_trace.hexa — CN-70 skeleton manjeom 15/15
//
// D2R first frame 까지 milestone 추적 — D2R.exe entry → D3D11 device init →
// menu shader 로드 → 첫 logo 화면.
//
// 무기: state machine (8 milestones) + columnar (시간 elapsed per milestone).
// 효과: D2R launch 진척률 가시화 — Phase 4 의 핵심 progress 지표.

use "./r0_common"

let D2R_DIR = GAMEBOX_HOME + "/persist/d2r_first_frame_trace"
let MILESTONE_LOG = D2R_DIR + "/milestones.tsv"

fn d2r_dir() -> str { return D2R_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + D2R_DIR + "'")
}

// ─── D2R launch milestones (8 단계) ───
fn milestones() -> array {
    return [
        "exe_loaded",       // D2R.exe PE loaded
        "win32_init",       // KERNEL32/USER32 init done
        "d3d11_device",     // D3D11 device created
        "swapchain",        // swap chain ready
        "menu_shader",      // 메인 메뉴 shader 로드
        "menu_texture",     // logo + UI 텍스처 로드
        "first_present",    // 첫 frame Present()
        "menu_input"        // 메인 메뉴 input 받기 시작
    ]
}

fn record_milestone(name: str, elapsed_ms: int, ok: bool) -> void {
    ensure_dir()
    let s = "fail"
    if ok { s = "pass" }
    let ts = exec("date +%s").trim()
    let line = ts + "\t" + name + "\t" + to_string(elapsed_ms) + "\t" + s
    let tmp = MILESTONE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MILESTONE_LOG + "' && rm -f '" + tmp + "'")
    if ok {
        r0_emit("d2r_milestone", "\"name\":\"" + name + "\",\"elapsed_ms\":" + to_string(elapsed_ms))
    } else {
        r0_emit("d2r_milestone_blocked", "\"name\":\"" + name + "\"")
    }
}

fn furthest() -> str {
    let exists = exec("test -f '" + MILESTONE_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let ms = milestones()
    let i = len(ms) - 1
    while i >= 0 {
        let cnt_str = exec("awk -F'\\t' -v m='" + ms[i] + "' '$2==m && $4==\"pass\"' '" + MILESTONE_LOG + "' | wc -l | tr -d ' '").trim()
        if cnt_str != "" {
            let cnt = to_int(cnt_str)
            if cnt > 0 { return ms[i] }
        }
        i = i - 1
    }
    return ""
}

fn progress_pct() -> int {
    let ms = milestones()
    let total = len(ms)
    let f = furthest()
    if f == "" { return 0 }
    let i = 0
    while i < total {
        if ms[i] == f { return (i + 1) * 100 / total }
        i = i + 1
    }
    return 0
}

fn d2r_stats() -> int {
    let exists = exec("test -f '" + MILESTONE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + MILESTONE_LOG + "' | tr -d ' '").trim())
}

fn cleanup_d2r() -> void {
    let _ = exec("rm -rf '" + D2R_DIR + "'")
}

fn self_test() -> void {
    let sid = "d2r-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_d2r()

    let ms = milestones()
    if len(ms) != 8 { panic("c_d2r_first_frame_trace FAIL [milestones] expected=8 got=" + to_string(len(ms))) }

    // synthetic — 현재 시점 가능 milestones (skeleton):
    record_milestone("exe_loaded", 100, false)        // PE map 미구현
    record_milestone("win32_init", 0, false)          // blocked
    record_milestone("d3d11_device", 0, false)        // blocked
    record_milestone("swapchain", 0, false)
    record_milestone("menu_shader", 0, false)
    record_milestone("menu_texture", 0, false)
    record_milestone("first_present", 0, false)
    record_milestone("menu_input", 0, false)

    let pct = progress_pct()
    if pct != 0 { panic("c_d2r_first_frame_trace FAIL [pct should be 0 — all blocked]") }

    // synthetic — D2R first frame 도달 가정 (미래 모습)
    record_milestone("exe_loaded", 100, true)
    record_milestone("win32_init", 200, true)
    record_milestone("d3d11_device", 500, true)

    let f = furthest()
    if f != "d3d11_device" { panic("c_d2r_first_frame_trace FAIL [furthest] got=" + f) }

    let pct2 = progress_pct()
    if pct2 != 37 { panic("c_d2r_first_frame_trace FAIL [pct] expected=37 got=" + to_string(pct2)) }

    let stats = d2r_stats()
    if stats != 11 { panic("c_d2r_first_frame_trace FAIL [stats] expected=11 got=" + to_string(stats)) }

    r0_emit("d2r_summary", "\"milestones\":11,\"pct\":" + to_string(pct2) + ",\"furthest\":\"" + f + "\"")

    let cnt = r0_session_count(sid)
    if cnt < 8 { panic("c_d2r_first_frame_trace FAIL [emit count] got=" + to_string(cnt)) }

    // ─── synthetic first-frame instrumentation trace (cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track G mission: D2R cond.3 (D3D11 renderer init + first-frame draw + dx11
    // pipeline warm) 측 evidence augment. cond.3 측 status `partial` 영구 유지 —
    // real GPU submit timestamp 측 loader_dx blk.1 D3DMetal binary licence transitive
    // (영구 외부 의존, met 승격 X).
    //
    // (a) synthetic frame_id_0 trace — D3D11 first frame instrumentation column header:
    //     frame_id                  0                 (frame 0 / first present)
    //     render_command_count      8                 (8 phase milestones x 1 cmd each)
    //     gpu_submit_ts_ns          0                 (synthetic — D3DMetal blk.1 transitive)
    //     present_kind              "synthetic_inline" (실 IDXGISwapChain::Present X)
    //
    // round-trip = synthesize_frame_0(scaffold) → walk_render_commands(scaffold) →
    //              tag_gpu_submit_ts(scaffold). hexa-native loop only — 실 GPU
    //              command queue submit 0, D3DMetal binary linkage 0.
    //
    // synthetic frame_0 instrumentation emit
    r0_emit("c_d2r_first_frame_trace_synthetic_frame_0",
        "\"stage\":\"frame_0_synthetic\",\"frame_id\":0,\"render_command_count\":8,\"gpu_submit_ts_ns\":0,\"present_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_gpu_gap\":\"permanent — loader_dx blk.1 D3DMetal binary licence dependent\"")
    println("__D2R_TRACE__ PARTIAL frame_0_synthetic")

    cleanup_d2r()

    println("  ✅ c_d2r_first_frame_trace self_test PASS (8 milestones, synthetic furthest=d3d11_device 37%, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "progress" {
            let p = progress_pct()
            let f = furthest()
            println("D2R first frame: " + to_string(p) + "% (furthest=" + f + ")")
            return
        }
        if sub == "stats" { println(to_string(d2r_stats())); return }
        if sub == "cleanup" { cleanup_d2r(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_first_frame_trace.hexa { self-test | progress | stats | cleanup }")
}
