// lib/perf/c_cs2_source2_pso_genome.hexa — CN-163 skeleton manjeom 15/15
//
// CS2 (Source 2) PSO 60-byte hexagon genome 매핑 — own 2 D2 pso_genome 의
// Source 2 변형. own 2 의 PSO genome 모듈은 D2R/D4 의 PSO 를 60-byte
// hexagonal hash 으로 매핑한다. CS2 의 Source 2 엔진은 다른 PSO layout
// (Diablo 와 다름) — Source 2 는 vertex/pixel/compute shader 별 다른
// 패턴을 가진다. 본 모듈은 shader_type × hexagon_size_bytes ×
// matched_count 4-key 추적. offline path (sv_lan 1 + bot match) 한정.
//
// 무기: pso × shader_type × hexagon_size × matched 4-key 로그.
// 효과: Source 2 PSO genome 분류 정량화 → Apple D3DMetal 변환 시 cluster
// 식별, 다른 Source 2 게임 (DOTA 2, Half-Life Alyx 등) generic 재사용.

use "./r0_common"

let CSPG_DIR = GAMEBOX_HOME + "/persist/cs2_source2_pso_genome"
let CSPG_LOG = CSPG_DIR + "/psos.tsv"

fn cspg_dir() -> str { return CSPG_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CSPG_DIR + "'")
}

// ─── PSO 등록 ───
//   pso_id (Source 2 PSO 의 unique key),
//   shader_type (1=vertex, 2=pixel, 3=compute),
//   hexagon_size_bytes (60-byte hexagonal hash 고정 길이),
//   matched_count (이 PSO 가 cluster 에서 매칭된 횟수).
fn record_pso(pso_id: int, shader_type: int, hexagon_size_bytes: int, matched_count: int) -> void {
    ensure_dir()
    let line = to_string(pso_id) + "\t" + to_string(shader_type) + "\t" + to_string(hexagon_size_bytes) + "\t" + to_string(matched_count)
    let tmp = CSPG_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CSPG_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("cs2_source2_pso_genome_record", "\"pso\":" + to_string(pso_id) + ",\"shader_type\":" + to_string(shader_type) + ",\"hexagon_size\":" + to_string(hexagon_size_bytes) + ",\"matched\":" + to_string(matched_count))
}

// ─── pso_count — 등록된 PSO 행 수 ───
fn pso_count() -> int {
    let exists = exec("test -f '" + CSPG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + CSPG_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_hexagon_size_bytes — 모든 PSO hexagon_size 합 ───
fn total_hexagon_size_bytes() -> int {
    let exists = exec("test -f '" + CSPG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + CSPG_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_matched_count — 모든 PSO matched_count 합 ───
fn total_matched_count() -> int {
    let exists = exec("test -f '" + CSPG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + CSPG_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_shader_type — 특정 shader_type 의 PSO 수 ───
//   shader_type: 1=vertex, 2=pixel, 3=compute. 미등록은 0.
fn count_by_shader_type(shader_type: int) -> int {
    let exists = exec("test -f '" + CSPG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v t=" + to_string(shader_type) + " '$2==t {c++} END{print c+0}' '" + CSPG_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── pso_hexagon_size — pso_id 의 hexagon_size_bytes 반환 ───
//   미등록 pso_id 는 0.
fn pso_hexagon_size(pso_id: int) -> int {
    let exists = exec("test -f '" + CSPG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v p=" + to_string(pso_id) + " '$1==p {print $3; exit}' '" + CSPG_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_hexagon_size_per_pso_bytes — total_size / pso_count ───
//   pso_count 0 이면 0 반환 (divide-by-zero guard).
fn avg_hexagon_size_per_pso_bytes() -> int {
    let pc = pso_count()
    if pc == 0 { return 0 }
    let ts = total_hexagon_size_bytes()
    return ts / pc
}

// ─── cspg_stats — [pso_count, total_hexagon_size_bytes, total_matched_count, avg] ───
fn cspg_stats() -> array {
    return [pso_count(), total_hexagon_size_bytes(), total_matched_count(), avg_hexagon_size_per_pso_bytes()]
}

fn cleanup_cspg() -> void {
    let _ = exec("rm -rf '" + CSPG_DIR + "'")
}

fn self_test() -> void {
    let sid = "cspg-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cspg()

    // 합성 PSO 3 종 (Source 2 shader stage 별):
    //   pso_id=17001 vertex shader   : hexagon_size=60, matched=240
    //   pso_id=17002 pixel  shader   : hexagon_size=60, matched=480
    //   pso_id=17003 compute shader  : hexagon_size=60, matched=120
    record_pso(17001, 1, 60, 240)
    record_pso(17002, 2, 60, 480)
    record_pso(17003, 3, 60, 120)

    // pso_count = 3
    let pc = pso_count()
    if pc != 3 { panic("c_cs2_source2_pso_genome FAIL [pso_count] expected=3 got=" + to_string(pc)) }

    // total_hexagon_size_bytes = 60+60+60 = 180
    let ts = total_hexagon_size_bytes()
    if ts != 180 { panic("c_cs2_source2_pso_genome FAIL [total_hexagon_size] expected=180 got=" + to_string(ts)) }

    // total_matched_count = 240+480+120 = 840
    let tm = total_matched_count()
    if tm != 840 { panic("c_cs2_source2_pso_genome FAIL [total_matched] expected=840 got=" + to_string(tm)) }

    // count_by_shader_type: 1=1, 2=1, 3=1, 99=0
    let cv = count_by_shader_type(1)
    if cv != 1 { panic("c_cs2_source2_pso_genome FAIL [count vertex] expected=1 got=" + to_string(cv)) }
    let cp = count_by_shader_type(2)
    if cp != 1 { panic("c_cs2_source2_pso_genome FAIL [count pixel] expected=1 got=" + to_string(cp)) }
    let cc = count_by_shader_type(3)
    if cc != 1 { panic("c_cs2_source2_pso_genome FAIL [count compute] expected=1 got=" + to_string(cc)) }
    let cu = count_by_shader_type(99)
    if cu != 0 { panic("c_cs2_source2_pso_genome FAIL [count unknown] expected=0 got=" + to_string(cu)) }

    // pso_hexagon_size: 17001=60, 17002=60, 17003=60, 9999=0
    let h1 = pso_hexagon_size(17001)
    if h1 != 60 { panic("c_cs2_source2_pso_genome FAIL [size 17001] expected=60 got=" + to_string(h1)) }
    let h2 = pso_hexagon_size(17002)
    if h2 != 60 { panic("c_cs2_source2_pso_genome FAIL [size 17002] expected=60 got=" + to_string(h2)) }
    let h3 = pso_hexagon_size(17003)
    if h3 != 60 { panic("c_cs2_source2_pso_genome FAIL [size 17003] expected=60 got=" + to_string(h3)) }
    let h4 = pso_hexagon_size(9999)
    if h4 != 0 { panic("c_cs2_source2_pso_genome FAIL [size unknown] expected=0 got=" + to_string(h4)) }

    // avg_hexagon_size_per_pso_bytes = 180/3 = 60
    let avg = avg_hexagon_size_per_pso_bytes()
    if avg != 60 { panic("c_cs2_source2_pso_genome FAIL [avg] expected=60 got=" + to_string(avg)) }

    // cspg_stats = [3, 180, 840, 60]
    let stats = cspg_stats()
    if stats[0] != 3 { panic("c_cs2_source2_pso_genome FAIL [stats pso_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 180 { panic("c_cs2_source2_pso_genome FAIL [stats total_size] expected=180 got=" + to_string(stats[1])) }
    if stats[2] != 840 { panic("c_cs2_source2_pso_genome FAIL [stats total_matched] expected=840 got=" + to_string(stats[2])) }
    if stats[3] != 60 { panic("c_cs2_source2_pso_genome FAIL [stats avg] expected=60 got=" + to_string(stats[3])) }

    r0_emit("cs2_source2_pso_genome_summary", "\"pso_count\":" + to_string(stats[0]) + ",\"total_hexagon_size\":" + to_string(stats[1]) + ",\"total_matched\":" + to_string(stats[2]) + ",\"avg\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_cs2_source2_pso_genome FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic CS2 Source 2 PSO genome retired_intentional posture annotation (Track AT) ───
    // Track AT mission: annotate ALL 3 c_cs2_*.hexa perf modules with RETIRED_INTENTIONAL
    // posture, mirroring Track V/AJ/AL D4 retired_intentional pattern. .roadmap.cs2 blk.1
    // status_enum_adopted = retired_intentional (Track C 4-game adoption 2026-05-03,
    // vac_anticheat). 본 module 측 Source 2 PSO 60-byte hexagon genome 매핑 = synthetic
    // shader stage analyzer — production live VAC-protected session 측 PSO harvest 측정
    // X (own1 Wine 0 / NO VAC bypass / NO anti-cheat circumvention, Trusted Mode bypass
    // 0). 본 cycle 측 module self_test() honest annotation row 추가 only — cs2.cond.2
    // status `partial` 영구 유지 (retired_intentional posture per blk.1 영구 lock;
    // vac_anticheat 영구 외부 boundary). pattern reference:
    //     lib/perf/c_d4_aspect_imprint_track.hexa (Track AL predecessor, schema adapted
    //     from always_online_drm to vac_anticheat blocker class)
    // synthetic posture row column header:
    //     domain                "source2_pso_genome"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live VAC-protected session enter)
    //     vac_bypass            "0"                    (own1 Wine 0 / no AC circumvention)
    //     anti_cheat_evade      "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "cs2.blk.1"            (vac_anticheat)
    //     adoption_iso          "2026-05-03"           (Track C retired_intentional adopt)
    r0_emit("c_cs2_source2_pso_genome_retired_intentional",
        "\"stage\":\"cs2_source2_synthetic\",\"domain\":\"source2_pso_genome\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"vac_bypass\":0,\"anti_cheat_evade\":0,\"blocker_ref\":\"cs2.blk.1\",\"blocker_class\":\"vac_anticheat\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"cs2.cond.2\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__CS2_GENOME__ RETIRED_INTENTIONAL cs2_source2_synthetic")

    cleanup_cspg()

    println("  ✅ c_cs2_source2_pso_genome self_test PASS (3 PSOs, total_hexagon_size=180 B, total_matched=840, avg=60 B, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = cspg_stats()
            println("pso_count=" + to_string(s[0]) + " total_hexagon_size_bytes=" + to_string(s[1]) + " total_matched_count=" + to_string(s[2]) + " avg=" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                let sz = pso_hexagon_size(pid)
                println(to_string(sz))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let st = to_int(a[3])
                let n = count_by_shader_type(st)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_cspg(); println("cleaned"); return }
    }
    println("usage: hexa run c_cs2_source2_pso_genome.hexa { self-test | stats | size <pso_id> | count <shader_type> | cleanup }")
}
