// lib/perf/c_display_mode_input_focus_routing.hexa — CN-210 skeleton manjeom 15/15
//
// 3-mode display (창 / 전체화면 / PIP) 의 keyboard / mouse / trackpad input
// event 가 어느 window (main / pip) 로 라우팅되는지 추적. PIP mode 에서는
// main 창과 PIP 창 둘 다 작동 가능해야 한다는 사용자 directive 에 따라
// event × source_mode × target_window × delivered 4-key 컬럼 로그로
// routing 정합성을 정량화 — 실제 OS event tap / responder chain 후킹은
// host 측 책임, 본 모듈은 집계 / 카운트만 담당.
//
// 무기: event × source_mode × target_window × delivered 4-key columnar log.
// 효과: 창/전체화면/PIP 모드 전환 시 input event drop / mis-route 정량화.

use "./r0_common"

let DMIFR_DIR = GAMEBOX_HOME + "/persist/display_mode_input_focus_routing"
let DMIFR_LOG = DMIFR_DIR + "/inputs.tsv"

fn dmifr_dir() -> str { return DMIFR_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMIFR_DIR + "'")
}

// ─── input event 등록 ───
//   event_id        — 이벤트 일련 번호 (host 측 monotonic seq),
//   source_mode     — 1=keyboard, 2=mouse, 3=trackpad,
//   target_window   — 1=main, 2=pip,
//   delivered       — 0=dropped, 1=delivered.
fn record_input(event_id: int, source_mode: int, target_window: int, delivered: int) -> void {
    ensure_dir()
    let line = to_string(event_id) + "\t" + to_string(source_mode) + "\t" + to_string(target_window) + "\t" + to_string(delivered)
    let tmp = DMIFR_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DMIFR_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dmifr_record", "\"event\":" + to_string(event_id) + ",\"src\":" + to_string(source_mode) + ",\"tgt\":" + to_string(target_window) + ",\"delivered\":" + to_string(delivered))
}

// ─── input_count — 등록된 input 행 수 ───
fn input_count() -> int {
    let exists = exec("test -f '" + DMIFR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + DMIFR_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── delivered_count — delivered=1 인 행 수 ───
fn delivered_count() -> int {
    let exists = exec("test -f '" + DMIFR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==1 {c++} END{print c+0}' '" + DMIFR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dropped_count — delivered=0 인 행 수 ───
fn dropped_count() -> int {
    let exists = exec("test -f '" + DMIFR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==0 {c++} END{print c+0}' '" + DMIFR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_source_mode — 특정 source_mode 행 수 ───
fn count_by_source_mode(mode: int) -> int {
    let exists = exec("test -f '" + DMIFR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(mode) + " '$2==m {c++} END{print c+0}' '" + DMIFR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_target_window — 특정 target_window 행 수 ───
fn count_by_target_window(target: int) -> int {
    let exists = exec("test -f '" + DMIFR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v t=" + to_string(target) + " '$3==t {c++} END{print c+0}' '" + DMIFR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dmifr_stats — [input_count, delivered_count, target=main, target=pip] ───
fn dmifr_stats() -> array {
    return [input_count(), delivered_count(), count_by_target_window(1), count_by_target_window(2)]
}

fn cleanup_dmifr() -> void {
    let _ = exec("rm -rf '" + DMIFR_DIR + "'")
}

fn self_test() -> void {
    let sid = "dmifr-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dmifr()

    // 합성 input events 5 종:
    //   61001 keyboard  → main  delivered
    //   61002 mouse     → main  delivered
    //   61003 keyboard  → pip   delivered
    //   61004 mouse     → pip   delivered
    //   61005 trackpad  → main  DROPPED
    record_input(61001, 1, 1, 1)
    record_input(61002, 2, 1, 1)
    record_input(61003, 1, 2, 1)
    record_input(61004, 2, 2, 1)
    record_input(61005, 3, 1, 0)

    // input_count = 5
    let ic = input_count()
    if ic != 5 { panic("c_display_mode_input_focus_routing FAIL [input_count] expected=5 got=" + to_string(ic)) }

    // delivered_count = 4
    let dc = delivered_count()
    if dc != 4 { panic("c_display_mode_input_focus_routing FAIL [delivered_count] expected=4 got=" + to_string(dc)) }

    // dropped_count = 1
    let dr = dropped_count()
    if dr != 1 { panic("c_display_mode_input_focus_routing FAIL [dropped_count] expected=1 got=" + to_string(dr)) }

    // count_by_source_mode: keyboard=2, mouse=2, trackpad=1, unknown=0
    let sk = count_by_source_mode(1)
    if sk != 2 { panic("c_display_mode_input_focus_routing FAIL [src=1 keyboard] expected=2 got=" + to_string(sk)) }
    let sm = count_by_source_mode(2)
    if sm != 2 { panic("c_display_mode_input_focus_routing FAIL [src=2 mouse] expected=2 got=" + to_string(sm)) }
    let st = count_by_source_mode(3)
    if st != 1 { panic("c_display_mode_input_focus_routing FAIL [src=3 trackpad] expected=1 got=" + to_string(st)) }
    let su = count_by_source_mode(99)
    if su != 0 { panic("c_display_mode_input_focus_routing FAIL [src=99 unknown] expected=0 got=" + to_string(su)) }

    // count_by_target_window: main=3 (61001+61002+61005), pip=2 (61003+61004), unknown=0
    let tm = count_by_target_window(1)
    if tm != 3 { panic("c_display_mode_input_focus_routing FAIL [tgt=1 main] expected=3 got=" + to_string(tm)) }
    let tp = count_by_target_window(2)
    if tp != 2 { panic("c_display_mode_input_focus_routing FAIL [tgt=2 pip] expected=2 got=" + to_string(tp)) }
    let tu = count_by_target_window(99)
    if tu != 0 { panic("c_display_mode_input_focus_routing FAIL [tgt=99 unknown] expected=0 got=" + to_string(tu)) }

    // dmifr_stats = [5, 4, 3, 2]
    let stats = dmifr_stats()
    if stats[0] != 5 { panic("c_display_mode_input_focus_routing FAIL [stats input] expected=5 got=" + to_string(stats[0])) }
    if stats[1] != 4 { panic("c_display_mode_input_focus_routing FAIL [stats delivered] expected=4 got=" + to_string(stats[1])) }
    if stats[2] != 3 { panic("c_display_mode_input_focus_routing FAIL [stats main] expected=3 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_display_mode_input_focus_routing FAIL [stats pip] expected=2 got=" + to_string(stats[3])) }

    r0_emit("dmifr_summary", "\"input\":" + to_string(stats[0]) + ",\"delivered\":" + to_string(stats[1]) + ",\"dropped\":" + to_string(dr) + ",\"main\":" + to_string(stats[2]) + ",\"pip\":" + to_string(stats[3]))

    // record × 5 + summary × 1 = ≥ 6 emits
    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_display_mode_input_focus_routing FAIL [emit count] expected>=6 got=" + to_string(cnt)) }

    // ─── synthetic input focus routing round-trip (Track BJ — d2r cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BJ mission: c_display_* family completion cycle (8/8) — c_display_mode_input_focus_routing
    // 측 NSEvent.firstResponder synthetic round-trip. Focus routing lifecycle
    // (capture_event → resolve_responder → dispatch_target → audit_drop) 측 spec freeze.
    // Apple-native scaffold only (D3DMetal binary licence transitive — loader_dx blk.1),
    // DX11 input-thread routing cross-link Metal layer evidence.
    //
    // (a) synthetic 4-phase input focus routing pipeline —
    //     capture_nsevent → resolve_first_responder → dispatch_target_window → audit_drop_decision:
    //     phase_count               4
    //     focus_routing_off         0x180052000         (synthetic NSEvent dispatch RVA)
    //     pipeline_kind             "synthetic_inline"  (실 NSResponder chain walk X)
    //
    // (b) synthetic event_kind × target 16-slot routing matrix —
    //     4 event_kind (key/mouse/scroll/gesture) × 4 target (main/pip/menu/dropped) = 16 slots:
    //     slot_total                16
    //     delivered_slot_count      12                  (target ≠ dropped)
    //     dropped_slot_count        4                   (target = dropped)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_focus_phase(scaffold) → walk_routing_matrix(scaffold).
    //              hexa-native loop only — 실 NSEvent.firstResponder 0,
    //              real sendEvent: 0.
    //
    // synthetic focus routing phase emit
    r0_emit("c_display_mode_input_focus_routing_synthetic_phase",
        "\"stage\":\"focus_routing_phase\",\"phase_count\":4,\"focus_routing_off\":\"0x180052000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_FOCUS__ PARTIAL focus_routing_phase")

    // synthetic event_kind × target matrix emit
    r0_emit("c_display_mode_input_focus_routing_synthetic_matrix",
        "\"stage\":\"routing_matrix\",\"slot_total\":16,\"delivered_slot_count\":12,\"dropped_slot_count\":4,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_FOCUS__ PARTIAL routing_matrix")

    cleanup_dmifr()

    println("  ✅ c_display_mode_input_focus_routing self_test PASS (5 inputs, 4 delivered, 1 dropped, main=3, pip=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dmifr_stats()
            println("input=" + to_string(s[0]) + " delivered=" + to_string(s[1]) + " main=" + to_string(s[2]) + " pip=" + to_string(s[3]))
            return
        }
        if sub == "count_source" {
            if len(a) >= 4 {
                let m = to_int(a[3])
                let c = count_by_source_mode(m)
                println(to_string(c))
                return
            }
        }
        if sub == "count_target" {
            if len(a) >= 4 {
                let t = to_int(a[3])
                let c = count_by_target_window(t)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_dmifr(); println("cleaned"); return }
    }
    println("usage: hexa run c_display_mode_input_focus_routing.hexa { self-test | stats | count_source <source_mode> | count_target <target_window> | cleanup }")
}
