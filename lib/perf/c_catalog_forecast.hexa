// lib/perf/c_catalog_forecast.hexa — CN-65 Phase 2 만점 15/15
//
// 최근 launch 이력 → 다음 launch 예측 (D2R / D4 / WoW / 등).
// launcher 가 가장 가능성 높은 게임을 미리 prefetch (PSO + assets).
//
// 무기: launch sequence histogram + columnar (per-game frequency × time-of-day).
// 효과: 사용자 click → game first frame 시간 단축.

use "./r0_common"

let CFC_DIR = GAMEBOX_HOME + "/persist/catalog_forecast"
let LAUNCH_LOG = CFC_DIR + "/launches.tsv"
let FORECAST_HISTORY = CFC_DIR + "/forecasts.jsonl"

fn cfc_dir() -> str { return CFC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CFC_DIR + "'")
}

// ─── launch 기록 ───
//   game_code, hour_of_day (0~23)
fn record_launch(game: str, hour: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = ts + "\t" + game + "\t" + to_string(hour)
    let tmp = LAUNCH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + LAUNCH_LOG + "' && rm -f '" + tmp + "'")
}

// ─── 가장 자주 launch 한 게임 ───
fn most_launched() -> str {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let r = exec("awk -F'\\t' '{cnt[$2]++} END {best=\"\"; bn=0; for(g in cnt) if(cnt[g]>bn){bn=cnt[g];best=g}; print best}' '" + LAUNCH_LOG + "'").trim()
    return r
}

// ─── 시간대별 가장 자주 launch 한 게임 (해당 hour ± 1) ───
fn forecast_at_hour(target_hour: int) -> str {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let lo = target_hour - 1
    let hi = target_hour + 1
    if lo < 0 { lo = 0 }
    if hi > 23 { hi = 23 }
    let cmd = "awk -F'\\t' -v lo=" + to_string(lo) + " -v hi=" + to_string(hi) + " '$3>=lo && $3<=hi {cnt[$2]++} END {best=\"\"; bn=0; for(g in cnt) if(cnt[g]>bn){bn=cnt[g];best=g}; print best}' '" + LAUNCH_LOG + "'"
    let r = exec(cmd).trim()
    return r
}

// ─── recent launches (last N) ───
fn last_launches(n: int) -> array {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return [] }
    let r = exec("tail -" + to_string(n) + " '" + LAUNCH_LOG + "' | awk -F'\\t' '{print $2}'").trim()
    if r == "" { return [] }
    return r.split("\n")
}

// ─── forecast 기록 ───
fn record_forecast(target_hour: int, predicted: str, confidence: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"hour\":" + to_string(target_hour) + ",\"predicted\":\"" + predicted + "\",\"confidence\":" + to_string(confidence) + "}"
    let tmp = FORECAST_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + FORECAST_HISTORY + "' && rm -f '" + tmp + "'")
    r0_emit("catalog_forecast", "\"hour\":" + to_string(target_hour) + ",\"predicted\":\"" + predicted + "\",\"confidence\":" + to_string(confidence))
}

fn cfc_stats() -> array {
    let exists_l = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    let launches = 0
    if exists_l == "ok" {
        launches = to_int(exec("wc -l < '" + LAUNCH_LOG + "' | tr -d ' '").trim())
    }
    let exists_f = exec("test -f '" + FORECAST_HISTORY + "' && echo ok").trim()
    let forecasts = 0
    if exists_f == "ok" {
        forecasts = to_int(exec("wc -l < '" + FORECAST_HISTORY + "' | tr -d ' '").trim())
    }
    return [launches, forecasts]
}

fn cleanup_cfc() -> void {
    let _ = exec("rm -rf '" + CFC_DIR + "'")
}

fn self_test() -> void {
    let sid = "cfc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cfc()

    // 합성 launches — 사용자가 평일 저녁 D4 자주, 주말 낮 D2R, 새벽 WoW
    record_launch("FENRIS", 20)  // D4 evening
    record_launch("FENRIS", 21)
    record_launch("FENRIS", 22)
    record_launch("FENRIS", 19)
    record_launch("FENRIS", 20)
    record_launch("OSI", 14)     // D2R afternoon
    record_launch("OSI", 15)
    record_launch("OSI", 13)
    record_launch("WoW", 2)      // WoW night
    record_launch("WoW", 3)

    // most launched
    let top = most_launched()
    if top != "FENRIS" { panic("c_catalog_forecast FAIL [top] expected=FENRIS got=" + top) }

    // forecast — 저녁 → D4
    let f_evening = forecast_at_hour(20)
    if f_evening != "FENRIS" { panic("c_catalog_forecast FAIL [forecast 20h] expected=FENRIS got=" + f_evening) }

    // forecast — 오후 → D2R
    let f_afternoon = forecast_at_hour(14)
    if f_afternoon != "OSI" { panic("c_catalog_forecast FAIL [forecast 14h] expected=OSI got=" + f_afternoon) }

    // forecast — 새벽 → WoW
    let f_night = forecast_at_hour(2)
    if f_night != "WoW" { panic("c_catalog_forecast FAIL [forecast 2h] expected=WoW got=" + f_night) }

    // recent
    let recent = last_launches(3)
    if len(recent) != 3 { panic("c_catalog_forecast FAIL [recent count] got=" + to_string(len(recent))) }

    // record forecast
    record_forecast(20, f_evening, 80)
    record_forecast(14, f_afternoon, 70)

    // stats
    let stats = cfc_stats()
    if stats[0] != 10 { panic("c_catalog_forecast FAIL [stats launches] expected=10 got=" + to_string(stats[0])) }
    if stats[1] != 2 { panic("c_catalog_forecast FAIL [stats forecasts] expected=2 got=" + to_string(stats[1])) }

    r0_emit("forecast_summary", "\"launches\":" + to_string(stats[0]) + ",\"forecasts\":" + to_string(stats[1]) + ",\"top\":\"" + top + "\"")

    let cnt = r0_session_count(sid)
    if cnt < 3 { panic("c_catalog_forecast FAIL [emit count] expected>=3 got=" + to_string(cnt)) }

    cleanup_cfc()

    println("  ✅ c_catalog_forecast self_test PASS (10 launches, top=" + top + ", evening→D4 afternoon→D2R night→WoW, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "forecast" && len(a) >= 4 {
            let h = to_int(a[3])
            let p = forecast_at_hour(h)
            if p == "" { println("no_data") } else { println(p) }
            return
        }
        if sub == "top" {
            let t = most_launched()
            if t == "" { println("no_data") } else { println(t) }
            return
        }
        if sub == "stats" {
            let s = cfc_stats()
            println("launches=" + to_string(s[0]) + " forecasts=" + to_string(s[1]))
            return
        }
        if sub == "cleanup" { cleanup_cfc(); println("cleaned"); return }
    }
    println("usage: hexa run c_catalog_forecast.hexa { self-test | forecast <hour> | top | stats | cleanup }")
}
