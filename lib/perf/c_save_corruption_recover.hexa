// lib/perf/c_save_corruption_recover.hexa — CN-116 skeleton manjeom 15/15
//
// D2R/D4 save 파일 손상 시 backup snapshot 에서 복구.
// 매 N 분 backup snapshot 기록 → 손상 검출 시 가장 최근 valid snapshot 으로 복구.
//
// 무기: snapshot table (save_id, path, ts, checksum, valid) + latest valid resolver.
// 효과: corrupt save 발생해도 직전 valid 상태 즉시 복원 (data loss 최소화).

use "./r0_common"

let SCR_DIR = GAMEBOX_HOME + "/persist/save_corruption_recover"
let SNAP_LOG = SCR_DIR + "/snapshots.tsv"
let RECOVER_LOG = SCR_DIR + "/recovers.tsv"

fn scr_dir() -> str { return SCR_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + SCR_DIR + "'")
}

// checksum 0 == corrupt sentinel (실 file 검증 없이 메타만 사용)
fn checksum_valid(checksum: int) -> bool {
    if checksum == 0 { return false }
    return true
}

fn record_snapshot(save_id: str, snapshot_path: str, ts: int, checksum: int) -> void {
    ensure_dir()
    let valid = "0"
    if checksum_valid(checksum) { valid = "1" }
    let line = save_id + "\t" + snapshot_path + "\t" + to_string(ts) + "\t" + to_string(checksum) + "\t" + valid
    let tmp = SNAP_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SNAP_LOG + "' && rm -f '" + tmp + "'")
    if valid == "1" {
        r0_emit("save_snapshot_ok", "\"id\":\"" + save_id + "\",\"ts\":" + to_string(ts) + ",\"cs\":" + to_string(checksum))
    } else {
        r0_emit("save_snapshot_corrupt", "\"id\":\"" + save_id + "\",\"ts\":" + to_string(ts))
    }
}

fn snapshot_count(save_id: str) -> int {
    let exists = exec("test -f '" + SNAP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v s='" + save_id + "' '$1==s' '" + SNAP_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// 가장 최근 valid snapshot path (없으면 "")
fn latest_valid_snapshot(save_id: str) -> str {
    let exists = exec("test -f '" + SNAP_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let r = exec("awk -F'\\t' -v s='" + save_id + "' '$1==s && $5==1 {print $3\"\\t\"$2}' '" + SNAP_LOG + "' | sort -k1,1nr | head -1 | cut -f2").trim()
    return r
}

fn recover(save_id: str, target_path: str) -> str {
    ensure_dir()
    let src = latest_valid_snapshot(save_id)
    if src == "" {
        r0_emit("save_recover_fail", "\"id\":\"" + save_id + "\",\"reason\":\"no_valid_snapshot\"")
        return ""
    }
    let line = save_id + "\t" + src + "\t" + target_path
    let tmp = RECOVER_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + RECOVER_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("save_recover_ok", "\"id\":\"" + save_id + "\",\"src\":\"" + src + "\",\"dst\":\"" + target_path + "\"")
    return src
}

fn recover_count() -> int {
    let exists = exec("test -f '" + RECOVER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + RECOVER_LOG + "' | tr -d ' '").trim())
}

fn cleanup_scr() -> void {
    let _ = exec("rm -rf '" + SCR_DIR + "'")
}

fn self_test() -> void {
    let sid = "scr-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_scr()

    if checksum_valid(0) { panic("c_save_corruption_recover FAIL [checksum 0 must be invalid]") }
    if !checksum_valid(12345) { panic("c_save_corruption_recover FAIL [checksum nonzero must be valid]") }

    // 3 snapshot: 1 valid (ts=100, cs=0xAAAA) / 2 corrupt (ts=200, cs=0) / 3 valid (ts=300, cs=0xBBBB)
    record_snapshot("Joe.d2s", "/snap/joe-100.bak", 100, 43690)
    record_snapshot("Joe.d2s", "/snap/joe-200.bak", 200, 0)
    record_snapshot("Joe.d2s", "/snap/joe-300.bak", 300, 48059)

    let total = snapshot_count("Joe.d2s")
    if total != 3 { panic("c_save_corruption_recover FAIL [count] expected=3 got=" + to_string(total)) }

    let zero = snapshot_count("Anna.d2s")
    if zero != 0 { panic("c_save_corruption_recover FAIL [unknown id count] expected=0 got=" + to_string(zero)) }

    let latest = latest_valid_snapshot("Joe.d2s")
    if latest != "/snap/joe-300.bak" { panic("c_save_corruption_recover FAIL [latest valid] expected=/snap/joe-300.bak got=" + latest) }

    let miss = latest_valid_snapshot("Nobody.d2s")
    if miss != "" { panic("c_save_corruption_recover FAIL [latest miss must be empty]") }

    let used = recover("Joe.d2s", "/restore/joe.d2s")
    if used != "/snap/joe-300.bak" { panic("c_save_corruption_recover FAIL [recover src] got=" + used) }

    let no_src = recover("Nobody.d2s", "/restore/nobody.d2s")
    if no_src != "" { panic("c_save_corruption_recover FAIL [recover w/o snapshot must return empty]") }

    let rc = recover_count()
    if rc != 1 { panic("c_save_corruption_recover FAIL [recover count] expected=1 got=" + to_string(rc)) }

    r0_emit("save_recover_summary", "\"snapshots\":" + to_string(total) + ",\"recovers\":" + to_string(rc))

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_save_corruption_recover FAIL [emit] got=" + to_string(cnt)) }

    cleanup_scr()

    println("  ✅ c_save_corruption_recover self_test PASS (3 snapshots [valid/corrupt/valid] → latest=300, recover ok, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "latest" && len(a) >= 4 {
            let p = latest_valid_snapshot(a[3])
            if p == "" { println("none") } else { println(p) }
            return
        }
        if sub == "count" && len(a) >= 4 {
            println(to_string(snapshot_count(a[3])))
            return
        }
        if sub == "recover" && len(a) >= 5 {
            let r = recover(a[3], a[4])
            if r == "" { println("fail") } else { println("ok " + r) }
            return
        }
        if sub == "cleanup" { cleanup_scr(); println("cleaned"); return }
    }
    println("usage: hexa run c_save_corruption_recover.hexa { self-test | latest <save_id> | count <save_id> | recover <save_id> <target> | cleanup }")
}
