// lib/perf/c_d4_tempering_affix_reroll.hexa — CN-185 skeleton manjeom 15/15
//
// D4 Tempering 시스템 추적 — 사용자가 craft 한 affix manual 을 item 에 적용.
// limited reroll attempts (default 5) — fail 시 item brick. item × manual_id ×
// reroll_count × success 4-key columnar log. c_d4_aspect_imprint_track 과 별도
// — Tempering 은 affix add, Aspect 는 legendary power add.
//
// 무기: item × manual × reroll × success 4-key columnar log + sum/avg.
// 효과: D4 Tempering RNG 정량화 — affix manual 별 평균 reroll, 평균 success%.

use "./r0_common"

let DTAR_DIR = GAMEBOX_HOME + "/persist/d4_tempering_affix_reroll"
let TEMPER_LOG = DTAR_DIR + "/tempers.tsv"

fn dtar_dir() -> str { return DTAR_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DTAR_DIR + "'")
}

// ─── temper 등록 ───
//   item_id (item instance id),
//   manual_id (affix manual id — 1001=weapon dmg, 1002=atk speed, 1003=cdr 등),
//   reroll_count (이 item 에 reroll 시도 횟수, 1..5),
//   success_pct (원하는 affix 명중률 % — host 측 계산).
fn record_temper(item_id: int, manual_id: int, reroll_count: int, success_pct: int) -> void {
    ensure_dir()
    let line = to_string(item_id) + "\t" + to_string(manual_id) + "\t" + to_string(reroll_count) + "\t" + to_string(success_pct)
    let tmp = TEMPER_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + TEMPER_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_temper_record", "\"item\":" + to_string(item_id) + ",\"manual\":" + to_string(manual_id) + ",\"rerolls\":" + to_string(reroll_count) + ",\"success_pct\":" + to_string(success_pct))
}

// ─── temper_count — 등록된 temper 행 수 ───
fn temper_count() -> int {
    let exists = exec("test -f '" + TEMPER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + TEMPER_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_rerolls — 모든 temper reroll_count 합 ───
fn total_rerolls() -> int {
    let exists = exec("test -f '" + TEMPER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + TEMPER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_success_pct — 모든 temper success_pct 합 ───
fn total_success_pct() -> int {
    let exists = exec("test -f '" + TEMPER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + TEMPER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_rerolls_per_item — total_rerolls / temper_count ───
//   temper_count 0 이면 0 반환 (divide-by-zero guard).
fn avg_rerolls_per_item() -> int {
    let tc = temper_count()
    if tc == 0 { return 0 }
    return total_rerolls() / tc
}

// ─── avg_success_pct — total_success_pct / temper_count ───
//   temper_count 0 이면 0 반환 (divide-by-zero guard).
fn avg_success_pct() -> int {
    let tc = temper_count()
    if tc == 0 { return 0 }
    return total_success_pct() / tc
}

// ─── item_rerolls — 특정 item_id 의 누적 reroll_count ───
//   item_id 미등록이면 0.
fn item_rerolls(item_id: int) -> int {
    let exists = exec("test -f '" + TEMPER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v i=" + to_string(item_id) + " '$1==i {s+=$3} END{print s+0}' '" + TEMPER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dtar_stats — [temper_count, total_rerolls, total_success_pct, avg_rerolls_per_item] ───
fn dtar_stats() -> array {
    return [temper_count(), total_rerolls(), total_success_pct(), avg_rerolls_per_item()]
}

fn cleanup_dtar() -> void {
    let _ = exec("rm -rf '" + DTAR_DIR + "'")
}

fn self_test() -> void {
    let sid = "dtar-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dtar()

    // 합성 temper 3 종:
    //   item_id=40001 (chestguard, weapon damage manual)    : manual=1001, rerolls=3, success=33%
    //   item_id=40002 (gloves, attack speed manual)          : manual=1002, rerolls=4, success=50%
    //   item_id=40003 (helm, cooldown reduction manual)      : manual=1003, rerolls=2, success=80%
    record_temper(40001, 1001, 3, 33)
    record_temper(40002, 1002, 4, 50)
    record_temper(40003, 1003, 2, 80)

    // temper_count = 3
    let tc = temper_count()
    if tc != 3 { panic("c_d4_tempering_affix_reroll FAIL [temper_count] expected=3 got=" + to_string(tc)) }

    // total_rerolls = 3+4+2 = 9
    let tr = total_rerolls()
    if tr != 9 { panic("c_d4_tempering_affix_reroll FAIL [total_rerolls] expected=9 got=" + to_string(tr)) }

    // total_success_pct = 33+50+80 = 163
    let ts = total_success_pct()
    if ts != 163 { panic("c_d4_tempering_affix_reroll FAIL [total_success_pct] expected=163 got=" + to_string(ts)) }

    // avg_rerolls_per_item = 9 / 3 = 3
    let ar = avg_rerolls_per_item()
    if ar != 3 { panic("c_d4_tempering_affix_reroll FAIL [avg_rerolls_per_item] expected=3 got=" + to_string(ar)) }

    // avg_success_pct = 163 / 3 = 54 (int trunc)
    let asp = avg_success_pct()
    if asp != 54 { panic("c_d4_tempering_affix_reroll FAIL [avg_success_pct] expected=54 got=" + to_string(asp)) }

    // item_rerolls per item
    let r1 = item_rerolls(40001)
    if r1 != 3 { panic("c_d4_tempering_affix_reroll FAIL [item_rerolls 40001] expected=3 got=" + to_string(r1)) }
    let r2 = item_rerolls(40002)
    if r2 != 4 { panic("c_d4_tempering_affix_reroll FAIL [item_rerolls 40002] expected=4 got=" + to_string(r2)) }
    let r3 = item_rerolls(40003)
    if r3 != 2 { panic("c_d4_tempering_affix_reroll FAIL [item_rerolls 40003] expected=2 got=" + to_string(r3)) }
    // 미등록 item_id 는 0
    let r4 = item_rerolls(9999)
    if r4 != 0 { panic("c_d4_tempering_affix_reroll FAIL [item_rerolls unknown] expected=0 got=" + to_string(r4)) }

    let stats = dtar_stats()
    if stats[0] != 3 { panic("c_d4_tempering_affix_reroll FAIL [stats temper_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 9 { panic("c_d4_tempering_affix_reroll FAIL [stats total_rerolls] expected=9 got=" + to_string(stats[1])) }
    if stats[2] != 163 { panic("c_d4_tempering_affix_reroll FAIL [stats total_success_pct] expected=163 got=" + to_string(stats[2])) }
    if stats[3] != 3 { panic("c_d4_tempering_affix_reroll FAIL [stats avg_rerolls] expected=3 got=" + to_string(stats[3])) }

    r0_emit("d4_temper_summary", "\"tempers\":" + to_string(stats[0]) + ",\"rerolls\":" + to_string(stats[1]) + ",\"success_total\":" + to_string(stats[2]) + ",\"avg_rerolls\":" + to_string(stats[3]) + ",\"avg_success\":" + to_string(asp))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d4_tempering_affix_reroll FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic D4 tempering retired_intentional posture annotation (Track V) ───
    //
    // Track V mission: D4 always-online DRM honest spec freeze posture annotation.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land).
    // 본 module 측 tempering affix reroll = synthetic temper table + reroll / success_pct
    // — production live game state 측정 X (D4 always-online live session 진입 X, DRM
    // bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_intentional
    // posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "tempering_affix_reroll"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_tempering_affix_reroll_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"tempering_affix_reroll\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_TEMPERING__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dtar()

    println("  ✅ c_d4_tempering_affix_reroll self_test PASS (3 tempers, 9 rerolls, 163 success_pct, avg_rerolls=3, avg_success=54%, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dtar_stats()
            println("tempers=" + to_string(s[0]) + " rerolls=" + to_string(s[1]) + " success_total=" + to_string(s[2]) + " avg_rerolls=" + to_string(s[3]))
            return
        }
        if sub == "rerolls" {
            if len(a) >= 4 {
                let iid = to_int(a[3])
                let n = item_rerolls(iid)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_dtar(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_tempering_affix_reroll.hexa { self-test | stats | rerolls <item_id> | cleanup }")
}
