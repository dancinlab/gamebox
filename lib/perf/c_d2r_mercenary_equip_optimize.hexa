// lib/perf/c_d2r_mercenary_equip_optimize.hexa — CN-183 skeleton manjeom 15/15
//
// D2R mercenary 장비 최적화 추적 — 4 종 mercenary (Act 1 Rogue / Act 2 Desert /
// Act 3 Iron Wolf / Act 5 Barbarian) 각각이 사용하는 weapon class 가 다르므로
// 최적 runeword (Insight = meditation aura, Infinity = conviction aura,
// Pride = concentration aura) 선택이 build 효율을 좌우한다. 본 모듈은 merc
// 단위 (merc_class × runeword_id × dps_increase × cost_runes) 의 집계만 담당
// — 실제 runeword 생성은 host 측 책임.
//
// 무기: merc × runeword × dps_inc × cost 4-key columnar log + sum/by-class.
// 효과: merc 장비 build 정량화 (총 dps 증가, rune 비용, class 별 분포).

use "./r0_common"

let DMEO_DIR = GAMEBOX_HOME + "/persist/d2r_mercenary_equip_optimize"
let MERC_LOG = DMEO_DIR + "/mercs.tsv"

fn dmeo_dir() -> str { return DMEO_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMEO_DIR + "'")
}

// ─── merc 등록 ───
//   merc_class (1=desert, 2=iron_wolf, 3=rogue, 4=barbarian),
//   runeword_id (Insight / Infinity / Pride 등 logical id),
//   dps_increase_pct (장착 후 dps 증가율 % — host 측 측정),
//   cost_rune_count (runeword 제작에 들어간 rune 개수).
fn record_merc(merc_class: int, runeword_id: int, dps_increase_pct: int, cost_rune_count: int) -> void {
    ensure_dir()
    let line = to_string(merc_class) + "\t" + to_string(runeword_id) + "\t" + to_string(dps_increase_pct) + "\t" + to_string(cost_rune_count)
    let tmp = MERC_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MERC_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dmeo_merc_record", "\"merc\":" + to_string(merc_class) + ",\"runeword\":" + to_string(runeword_id) + ",\"dps_inc\":" + to_string(dps_increase_pct) + ",\"runes\":" + to_string(cost_rune_count))
}

// ─── merc_record_count — 등록된 merc 행 수 ───
fn merc_record_count() -> int {
    let exists = exec("test -f '" + MERC_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + MERC_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_dps_increase — 모든 merc dps_increase_pct 합 ───
fn total_dps_increase() -> int {
    let exists = exec("test -f '" + MERC_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + MERC_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_cost_runes — 모든 merc cost_rune_count 합 ───
fn total_cost_runes() -> int {
    let exists = exec("test -f '" + MERC_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + MERC_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_merc_class — merc_class 행 수 ───
fn count_by_merc_class(merc_class: int) -> int {
    let exists = exec("test -f '" + MERC_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(merc_class) + " '$1==m {c+=1} END{print c+0}' '" + MERC_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── merc_dps_increase — merc_class 의 dps_increase_pct 합 ───
//   미등록 merc_class 는 0.
fn merc_dps_increase(merc_class: int) -> int {
    let exists = exec("test -f '" + MERC_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(merc_class) + " '$1==m {s+=$3} END{print s+0}' '" + MERC_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dmeo_stats — [merc_record_count, total_dps_increase, total_cost_runes, count_by_merc_class(1)] ───
fn dmeo_stats() -> array {
    return [merc_record_count(), total_dps_increase(), total_cost_runes(), count_by_merc_class(1)]
}

fn cleanup_dmeo() -> void {
    let _ = exec("rm -rf '" + DMEO_DIR + "'")
}

fn self_test() -> void {
    let sid = "dmeo-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dmeo()

    // 합성 merc 3 종:
    //   Desert merc (merc_class=1) — Insight Polearm (runeword 38001) / +120% dps / 4 runes
    //   Iron Wolf  (merc_class=2) — Insight Crystal Sword (runeword 38002) / +80% dps / 4 runes
    //   Barbarian  (merc_class=4) — Pride Polearm (runeword 38003) / +180% dps / 4 runes
    record_merc(1, 38001, 120, 4)
    record_merc(2, 38002, 80, 4)
    record_merc(4, 38003, 180, 4)

    // merc_record_count = 3
    let mc = merc_record_count()
    if mc != 3 { panic("c_d2r_mercenary_equip_optimize FAIL [merc_record_count] expected=3 got=" + to_string(mc)) }

    // total_dps_increase = 120+80+180 = 380
    let td = total_dps_increase()
    if td != 380 { panic("c_d2r_mercenary_equip_optimize FAIL [total_dps_increase] expected=380 got=" + to_string(td)) }

    // total_cost_runes = 4+4+4 = 12
    let tr = total_cost_runes()
    if tr != 12 { panic("c_d2r_mercenary_equip_optimize FAIL [total_cost_runes] expected=12 got=" + to_string(tr)) }

    // count_by_merc_class:
    //   1 (desert) = 1, 2 (iron_wolf) = 1, 3 (rogue) = 0, 4 (barbarian) = 1, 99 (unknown) = 0
    let c1 = count_by_merc_class(1)
    if c1 != 1 { panic("c_d2r_mercenary_equip_optimize FAIL [count 1] expected=1 got=" + to_string(c1)) }
    let c2 = count_by_merc_class(2)
    if c2 != 1 { panic("c_d2r_mercenary_equip_optimize FAIL [count 2] expected=1 got=" + to_string(c2)) }
    let c3 = count_by_merc_class(3)
    if c3 != 0 { panic("c_d2r_mercenary_equip_optimize FAIL [count 3] expected=0 got=" + to_string(c3)) }
    let c4 = count_by_merc_class(4)
    if c4 != 1 { panic("c_d2r_mercenary_equip_optimize FAIL [count 4] expected=1 got=" + to_string(c4)) }
    let c99 = count_by_merc_class(99)
    if c99 != 0 { panic("c_d2r_mercenary_equip_optimize FAIL [count 99] expected=0 got=" + to_string(c99)) }

    // merc_dps_increase:
    //   1=120, 2=80, 4=180, 3=0, 99=0
    let d1 = merc_dps_increase(1)
    if d1 != 120 { panic("c_d2r_mercenary_equip_optimize FAIL [dps 1] expected=120 got=" + to_string(d1)) }
    let d2 = merc_dps_increase(2)
    if d2 != 80 { panic("c_d2r_mercenary_equip_optimize FAIL [dps 2] expected=80 got=" + to_string(d2)) }
    let d4 = merc_dps_increase(4)
    if d4 != 180 { panic("c_d2r_mercenary_equip_optimize FAIL [dps 4] expected=180 got=" + to_string(d4)) }
    let d3 = merc_dps_increase(3)
    if d3 != 0 { panic("c_d2r_mercenary_equip_optimize FAIL [dps 3] expected=0 got=" + to_string(d3)) }
    let d99 = merc_dps_increase(99)
    if d99 != 0 { panic("c_d2r_mercenary_equip_optimize FAIL [dps 99] expected=0 got=" + to_string(d99)) }

    let stats = dmeo_stats()
    if stats[0] != 3 { panic("c_d2r_mercenary_equip_optimize FAIL [stats count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 380 { panic("c_d2r_mercenary_equip_optimize FAIL [stats dps] expected=380 got=" + to_string(stats[1])) }
    if stats[2] != 12 { panic("c_d2r_mercenary_equip_optimize FAIL [stats runes] expected=12 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_d2r_mercenary_equip_optimize FAIL [stats class1] expected=1 got=" + to_string(stats[3])) }

    r0_emit("dmeo_summary", "\"mercs\":" + to_string(stats[0]) + ",\"dps_inc\":" + to_string(stats[1]) + ",\"runes\":" + to_string(stats[2]) + ",\"desert\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d2r_mercenary_equip_optimize FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic mercenary loadout state machine round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track U mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic mercenary loadout state machine 4-phase — hire → equip →
    //     resurrect → dismiss (merc lifecycle):
    //     phase_count                4                  (hire/equip/resurrect/dismiss)
    //     merc_table_off             0x140084000        (synthetic D2GAME.dll merc RVA)
    //     loadout_kind               "synthetic_inline" (실 merc inv slot bind X)
    //
    // (b) synthetic equip optimization scaffold — 4 merc class × runeword aura match
    //     walk:
    //     class_count                4                  (rogue/desert/iron_wolf/barbarian)
    //     equipped_count             3                  (3 of 4 classes loadout walked)
    //     dps_total                  380                (120+80+180 dps_inc aggregate)
    //     optimize_kind              "synthetic_inline" (실 dps recompute X)
    //
    // round-trip = synthesize_merc_phase(scaffold) → walk_equip_optimize(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll merc tick 0,
    //              real loadout calc 0.
    //
    // synthetic merc phase emit
    r0_emit("c_d2r_mercenary_equip_optimize_synthetic_merc_phase",
        "\"stage\":\"merc_phase\",\"phase_count\":4,\"merc_table_off\":\"0x140084000\",\"loadout_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_MERC__ PARTIAL merc_phase")

    // synthetic equip optimize emit
    r0_emit("c_d2r_mercenary_equip_optimize_synthetic_equip_optimize",
        "\"stage\":\"equip_optimize\",\"class_count\":4,\"equipped_count\":3,\"dps_total\":380,\"optimize_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_MERC__ PARTIAL equip_optimize")

    cleanup_dmeo()

    println("  ✅ c_d2r_mercenary_equip_optimize self_test PASS (3 mercs, dps_inc=380, runes=12, desert=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dmeo_stats()
            println("mercs=" + to_string(s[0]) + " dps_inc=" + to_string(s[1]) + " runes=" + to_string(s[2]) + " desert=" + to_string(s[3]))
            return
        }
        if sub == "dps" {
            if len(a) >= 4 {
                let mc = to_int(a[3])
                let v = merc_dps_increase(mc)
                println(to_string(v))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let mc = to_int(a[3])
                let v = count_by_merc_class(mc)
                println(to_string(v))
                return
            }
        }
        if sub == "cleanup" { cleanup_dmeo(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_mercenary_equip_optimize.hexa { self-test | stats | dps <merc_class> | count <merc_class> | cleanup }")
}
