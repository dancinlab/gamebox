// lib/perf/c_i386_calling_frame_track.hexa — CN-97 skeleton manjeom 15/15
//
// Phase 1 i386 calling frame 추적 — 호출 별 stack frame 사이즈 + cleanup 책임.
// cdecl/stdcall/fastcall/thiscall 분포 + ESP delta 분석.
//
// 무기: call frame table + columnar (conv × arg_count × cleanup).
// 효과: stack imbalance bug 사전 검출 (caller vs callee cleanup 불일치).

use "./r0_common"

let CICT_DIR = GAMEBOX_HOME + "/persist/i386_calling_frame"
let CALL_LOG = CICT_DIR + "/calls.tsv"

fn cict_dir() -> str { return CICT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CICT_DIR + "'")
}

fn record_call(symbol: str, conv: str, arg_count: int, ok: bool) -> void {
    ensure_dir()
    let s = "fail"
    if ok { s = "pass" }
    let line = symbol + "\t" + conv + "\t" + to_string(arg_count) + "\t" + s
    let tmp = CALL_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CALL_LOG + "' && rm -f '" + tmp + "'")
    if ok {
        r0_emit("i386_call_ok", "\"sym\":\"" + symbol + "\",\"conv\":\"" + conv + "\",\"args\":" + to_string(arg_count))
    } else {
        r0_emit("i386_call_imbalance", "\"sym\":\"" + symbol + "\",\"conv\":\"" + conv + "\"")
    }
}

fn call_count() -> int {
    let exists = exec("test -f '" + CALL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + CALL_LOG + "' | tr -d ' '").trim())
}

fn conv_count(conv: str) -> int {
    let exists = exec("test -f '" + CALL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + conv + "' '$2==c' '" + CALL_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn imbalance_count() -> int {
    let exists = exec("test -f '" + CALL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$4==\"fail\"' '" + CALL_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_cict() -> void {
    let _ = exec("rm -rf '" + CICT_DIR + "'")
}

fn self_test() -> void {
    let sid = "cict-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cict()

    record_call("CreateFileA", "stdcall", 7, true)
    record_call("ReadFile", "stdcall", 5, true)
    record_call("GetModuleHandleA", "stdcall", 1, true)
    record_call("printf", "cdecl", 3, true)
    record_call("malloc", "cdecl", 1, true)
    record_call("AlphaBlend", "stdcall", 11, true)
    record_call("buggy_call", "stdcall", 4, false)   // imbalance

    let cnt = call_count()
    if cnt != 7 { panic("c_i386_calling_frame_track FAIL [count] expected=7 got=" + to_string(cnt)) }

    let std = conv_count("stdcall")
    if std != 5 { panic("c_i386_calling_frame_track FAIL [stdcall] expected=5 got=" + to_string(std)) }

    let cd = conv_count("cdecl")
    if cd != 2 { panic("c_i386_calling_frame_track FAIL [cdecl] expected=2 got=" + to_string(cd)) }

    let imb = imbalance_count()
    if imb != 1 { panic("c_i386_calling_frame_track FAIL [imbalance] expected=1 got=" + to_string(imb)) }

    r0_emit("i386_call_summary", "\"calls\":" + to_string(cnt) + ",\"stdcall\":" + to_string(std) + ",\"cdecl\":" + to_string(cd) + ",\"imbalance\":" + to_string(imb))

    let cnt_e = r0_session_count(sid)
    if cnt_e < 7 { panic("c_i386_calling_frame_track FAIL [emit] got=" + to_string(cnt_e)) }

    cleanup_cict()

    println("  ✅ c_i386_calling_frame_track self_test PASS (7 calls: 5 stdcall / 2 cdecl / 1 imbalance, emits=" + to_string(cnt_e) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "call" && len(a) >= 7 {
            let ok = a[6] == "1"
            record_call(a[3], a[4], to_int(a[5]), ok)
            println("recorded")
            return
        }
        if sub == "stats" {
            println("calls=" + to_string(call_count()) + " stdcall=" + to_string(conv_count("stdcall")) + " cdecl=" + to_string(conv_count("cdecl")) + " imbalance=" + to_string(imbalance_count()))
            return
        }
        if sub == "cleanup" { cleanup_cict(); println("cleaned"); return }
    }
    println("usage: hexa run c_i386_calling_frame_track.hexa { self-test | call <sym> <conv> <argc> <ok0_1> | stats | cleanup }")
}
