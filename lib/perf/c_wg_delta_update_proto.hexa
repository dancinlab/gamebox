// lib/perf/c_wg_delta_update_proto.hexa — CN-175 skeleton manjeom 15/15
//
// WGC (Wargaming.net Game Center) chunk delta update protocol 추적 — Steam
// content depot 와 다른 자체 방식. WGC 가 game asset patch 적용 시 자체 chunk
// delta protocol 을 사용하여 변경된 byte 만 전송한다. 본 모듈은 patch 단위
// (patch_id × delta_size_bytes × full_size_bytes × elapsed_us) 의 집계와
// delta 효율 (delta/full ratio) 정량화만 담당 — 실제 chunk patch 적용은 host
// 측 책임.
//
// 무기: patch × delta × full × elapsed 4-key columnar log + sum/ratio.
// 효과: WGC delta update 효율 정량화 → 신규 distribution path. 다른 launcher
// 자체 update protocol generic 흡수 후보 인프라.

use "./r0_common"

let WDUP_DIR = GAMEBOX_HOME + "/persist/wg_delta_update_proto"
let PATCH_LOG = WDUP_DIR + "/patches.tsv"

fn wdup_dir() -> str { return WDUP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + WDUP_DIR + "'")
}

// ─── patch 등록 ───
//   patch_id (WoT 1.x / WoWS 13.x / WoT 2.0 등 logical name 의 hash),
//   delta_size_bytes (chunk delta 전송 byte),
//   full_size_bytes (asset 원본 크기 byte),
//   elapsed_us (patch 적용 누적 시간 µs — host 측 측정).
fn record_patch(patch_id: int, delta_size_bytes: int, full_size_bytes: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(patch_id) + "\t" + to_string(delta_size_bytes) + "\t" + to_string(full_size_bytes) + "\t" + to_string(elapsed_us)
    let tmp = PATCH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PATCH_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("wg_delta_update_record", "\"patch\":" + to_string(patch_id) + ",\"delta\":" + to_string(delta_size_bytes) + ",\"full\":" + to_string(full_size_bytes) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── patch_count — 등록된 patch 행 수 ───
fn patch_count() -> int {
    let exists = exec("test -f '" + PATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + PATCH_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_delta_bytes — 모든 patch delta_size_bytes 합 ───
fn total_delta_bytes() -> int {
    let exists = exec("test -f '" + PATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + PATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_full_bytes — 모든 patch full_size_bytes 합 ───
fn total_full_bytes() -> int {
    let exists = exec("test -f '" + PATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + PATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_elapsed_us — 모든 patch elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + PATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + PATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── delta_ratio_pct — (total_delta * 100) / total_full ───
//   full 0 이면 0 반환 (divide-by-zero guard).
fn delta_ratio_pct() -> int {
    let tf = total_full_bytes()
    if tf == 0 { return 0 }
    let td = total_delta_bytes()
    return (td * 100) / tf
}

// ─── patch_delta_bytes — patch_id 의 delta_size_bytes ───
//   patch_id 미등록이면 0.
fn patch_delta_bytes(patch_id: int) -> int {
    let exists = exec("test -f '" + PATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v p=" + to_string(patch_id) + " '$1==p {s+=$2} END{print s+0}' '" + PATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── wdup_stats — [patch_count, total_delta_bytes, total_full_bytes, delta_ratio_pct] ───
fn wdup_stats() -> array {
    return [patch_count(), total_delta_bytes(), total_full_bytes(), delta_ratio_pct()]
}

fn cleanup_wdup() -> void {
    let _ = exec("rm -rf '" + WDUP_DIR + "'")
}

fn self_test() -> void {
    let sid = "wdup-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_wdup()

    // 합성 patch 3 종:
    //   WoT 1.x patch       (id=30001) — delta 1 MB / full 100 MB / 80000 µs
    //   WoWS 13.x patch     (id=30002) — delta 2 MB / full 200 MB / 160000 µs
    //   WoT 2.0 major patch (id=30003) — delta 10 MB / full 100 MB / 240000 µs
    record_patch(30001, 1048576, 104857600, 80000)
    record_patch(30002, 2097152, 209715200, 160000)
    record_patch(30003, 10485760, 104857600, 240000)

    // patch_count = 3
    let pc = patch_count()
    if pc != 3 { panic("c_wg_delta_update_proto FAIL [patch_count] expected=3 got=" + to_string(pc)) }

    // total_delta_bytes = 1048576+2097152+10485760 = 13631488
    let td = total_delta_bytes()
    if td != 13631488 { panic("c_wg_delta_update_proto FAIL [total_delta_bytes] expected=13631488 got=" + to_string(td)) }

    // total_full_bytes = 104857600+209715200+104857600 = 419430400
    let tf = total_full_bytes()
    if tf != 419430400 { panic("c_wg_delta_update_proto FAIL [total_full_bytes] expected=419430400 got=" + to_string(tf)) }

    // total_elapsed_us = 80000+160000+240000 = 480000
    let te = total_elapsed_us()
    if te != 480000 { panic("c_wg_delta_update_proto FAIL [total_elapsed_us] expected=480000 got=" + to_string(te)) }

    // delta_ratio_pct = (13631488 * 100) / 419430400 = 1363148800 / 419430400 = 3 (int trunc)
    let drp = delta_ratio_pct()
    if drp != 3 { panic("c_wg_delta_update_proto FAIL [delta_ratio_pct] expected=3 got=" + to_string(drp)) }

    // patch_delta_bytes per patch
    let d1 = patch_delta_bytes(30001)
    if d1 != 1048576 { panic("c_wg_delta_update_proto FAIL [delta 30001] expected=1048576 got=" + to_string(d1)) }
    let d2 = patch_delta_bytes(30002)
    if d2 != 2097152 { panic("c_wg_delta_update_proto FAIL [delta 30002] expected=2097152 got=" + to_string(d2)) }
    let d3 = patch_delta_bytes(30003)
    if d3 != 10485760 { panic("c_wg_delta_update_proto FAIL [delta 30003] expected=10485760 got=" + to_string(d3)) }
    // 미등록 patch_id 는 0
    let d4 = patch_delta_bytes(9999)
    if d4 != 0 { panic("c_wg_delta_update_proto FAIL [delta unknown] expected=0 got=" + to_string(d4)) }

    let stats = wdup_stats()
    if stats[0] != 3 { panic("c_wg_delta_update_proto FAIL [stats patches] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 13631488 { panic("c_wg_delta_update_proto FAIL [stats delta] expected=13631488 got=" + to_string(stats[1])) }
    if stats[2] != 419430400 { panic("c_wg_delta_update_proto FAIL [stats full] expected=419430400 got=" + to_string(stats[2])) }
    if stats[3] != 3 { panic("c_wg_delta_update_proto FAIL [stats ratio] expected=3 got=" + to_string(stats[3])) }

    r0_emit("wg_delta_update_summary", "\"patches\":" + to_string(stats[0]) + ",\"delta\":" + to_string(stats[1]) + ",\"full\":" + to_string(stats[2]) + ",\"ratio_pct\":" + to_string(stats[3]) + ",\"elapsed_us\":" + to_string(te))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_wg_delta_update_proto FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic WG delta update protocol round-trip (Track BJ — battlenet cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BJ mission: c_wg/c_wgc_* family completion cycle (6/6) — c_wg_delta_update_proto
    // 측 WG xdelta3-style differential patch synthetic round-trip. Delta
    // lifecycle (probe_old_hash → fetch_delta → apply_xdelta → verify_new_hash)
    // 측 spec freeze. Production smoke gated on user network smoke (battlenet blk.1
    // transitive) + 자연 환경 정합 long-horizon work, met 승격 X.
    //
    // (a) synthetic 4-phase delta update protocol pipeline —
    //     probe_old_file_hash → fetch_delta_patch → apply_xdelta_decode → verify_new_file_hash:
    //     phase_count               4
    //     delta_update_off          0x14014A000         (synthetic WG patch client RVA)
    //     pipeline_kind             "synthetic_inline"  (실 xdelta3 라이브러리 호출 X)
    //
    // (b) synthetic patch_kind × ratio_class 16-slot delta matrix —
    //     4 patch_kind (minor/major/hotfix/asset) × 4 ratio_class (1%/5%/10%/full) = 16 slots:
    //     slot_total                16
    //     compact_slot_count        12                  (ratio_class ≤ 10%)
    //     bulky_slot_count          4                   (ratio_class = full)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_delta_phase(scaffold) → walk_ratio_matrix(scaffold).
    //              hexa-native loop only — 실 xdelta3 decode 0,
    //              real SHA-256 verify 0.
    //
    // synthetic delta update phase emit
    r0_emit("c_wg_delta_update_proto_synthetic_phase",
        "\"stage\":\"delta_update_phase\",\"phase_count\":4,\"delta_update_off\":\"0x14014A000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"network_gap\":\"production smoke gated on user network smoke + 자연 환경 정합 long-horizon\"")
    println("__WG_DELTA__ PARTIAL delta_update_phase")

    // synthetic patch × ratio matrix emit
    r0_emit("c_wg_delta_update_proto_synthetic_matrix",
        "\"stage\":\"ratio_matrix\",\"slot_total\":16,\"compact_slot_count\":12,\"bulky_slot_count\":4,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"network_gap\":\"production smoke gated on user network smoke + 자연 환경 정합 long-horizon\"")
    println("__WG_DELTA__ PARTIAL ratio_matrix")

    cleanup_wdup()

    println("  ✅ c_wg_delta_update_proto self_test PASS (3 patches, delta=13631488 B, full=419430400 B, ratio=3%, elapsed=480000 µs, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = wdup_stats()
            println("patches=" + to_string(s[0]) + " delta_bytes=" + to_string(s[1]) + " full_bytes=" + to_string(s[2]) + " ratio_pct=" + to_string(s[3]))
            return
        }
        if sub == "delta" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                let db = patch_delta_bytes(pid)
                println(to_string(db))
                return
            }
        }
        if sub == "cleanup" { cleanup_wdup(); println("cleaned"); return }
    }
    println("usage: hexa run c_wg_delta_update_proto.hexa { self-test | stats | delta <patch_id> | cleanup }")
}
