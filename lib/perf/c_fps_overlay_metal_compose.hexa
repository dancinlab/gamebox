// lib/perf/c_fps_overlay_metal_compose.hexa — CN-217 skeleton manjeom 15/15
//
// FPS overlay Metal compose layer 추적 — Apple-native 자체 overlay 렌더 (own 1
// 정합). FPS counter 를 game frame 위에 overlay 로 표시하기 위해 Metal CALayer
// 또는 별도 swap chain 으로 compose. compose × overlay_size × text_glyph_count
// × elapsed 추적.
//
// 무기: compose × size × glyph × elapsed 4-key 컬럼 로그.
// 효과: FPS overlay 렌더 비용 정량화.

use "./r0_common"

let FOMC_DIR = GAMEBOX_HOME + "/persist/fps_overlay_metal_compose"
let COMPOSE_LOG = FOMC_DIR + "/composes.tsv"

fn fomc_dir() -> str { return FOMC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + FOMC_DIR + "'")
}

// ─── compose 등록 ───
//   compose_id (overlay compose 이벤트 id),
//   overlay_w / overlay_h (overlay 크기 px),
//   elapsed_us (compose 소요 us).
fn record_compose(compose_id: int, overlay_w: int, overlay_h: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(compose_id) + "\t" + to_string(overlay_w) + "\t" + to_string(overlay_h) + "\t" + to_string(elapsed_us)
    let tmp = COMPOSE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + COMPOSE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("fomc_record", "\"compose\":" + to_string(compose_id) + ",\"w\":" + to_string(overlay_w) + ",\"h\":" + to_string(overlay_h) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── compose_count — 등록된 compose 행 수 ───
fn compose_count() -> int {
    let exists = exec("test -f '" + COMPOSE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + COMPOSE_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_pixels — sum of (overlay_w * overlay_h) ───
fn total_pixels() -> int {
    let exists = exec("test -f '" + COMPOSE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2*$3} END{print s+0}' '" + COMPOSE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_elapsed_us — 모든 compose elapsed 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + COMPOSE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + COMPOSE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_elapsed_us — total / count, 0-guard ───
fn avg_elapsed_us() -> int {
    let cc = compose_count()
    if cc == 0 { return 0 }
    return total_elapsed_us() / cc
}

// ─── compose_elapsed — compose_id 의 elapsed_us, 미등록이면 0 ───
fn compose_elapsed(compose_id: int) -> int {
    let exists = exec("test -f '" + COMPOSE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v c=" + to_string(compose_id) + " '$1==c {s+=$4} END{print s+0}' '" + COMPOSE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── fomc_stats — [compose_count, total_pixels, total_elapsed_us, avg_elapsed_us] ───
fn fomc_stats() -> array {
    return [compose_count(), total_pixels(), total_elapsed_us(), avg_elapsed_us()]
}

fn cleanup_fomc() -> void {
    let _ = exec("rm -rf '" + FOMC_DIR + "'")
}

fn self_test() -> void {
    let sid = "fomc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_fomc()

    // 합성 compose 3 종 (200×60 overlay):
    //   68001 — elapsed 50 us
    //   68002 — elapsed 40 us
    //   68003 — elapsed 45 us
    record_compose(68001, 200, 60, 50)
    record_compose(68002, 200, 60, 40)
    record_compose(68003, 200, 60, 45)

    // compose_count = 3
    let cc = compose_count()
    if cc != 3 { panic("c_fps_overlay_metal_compose FAIL [compose_count] expected=3 got=" + to_string(cc)) }

    // total_pixels = 200*60 * 3 = 36000
    let tp = total_pixels()
    if tp != 36000 { panic("c_fps_overlay_metal_compose FAIL [total_pixels] expected=36000 got=" + to_string(tp)) }

    // total_elapsed_us = 50+40+45 = 135
    let te = total_elapsed_us()
    if te != 135 { panic("c_fps_overlay_metal_compose FAIL [total_elapsed_us] expected=135 got=" + to_string(te)) }

    // avg_elapsed_us = 135 / 3 = 45
    let avg = avg_elapsed_us()
    if avg != 45 { panic("c_fps_overlay_metal_compose FAIL [avg_elapsed_us] expected=45 got=" + to_string(avg)) }

    // compose_elapsed:
    //   68001 = 50, 68003 = 45, 9999 (미등록) = 0
    let e1 = compose_elapsed(68001)
    if e1 != 50 { panic("c_fps_overlay_metal_compose FAIL [elapsed 68001] expected=50 got=" + to_string(e1)) }
    let e3 = compose_elapsed(68003)
    if e3 != 45 { panic("c_fps_overlay_metal_compose FAIL [elapsed 68003] expected=45 got=" + to_string(e3)) }
    let e9 = compose_elapsed(9999)
    if e9 != 0 { panic("c_fps_overlay_metal_compose FAIL [elapsed unknown] expected=0 got=" + to_string(e9)) }

    let stats = fomc_stats()
    if stats[0] != 3 { panic("c_fps_overlay_metal_compose FAIL [stats count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 36000 { panic("c_fps_overlay_metal_compose FAIL [stats pixels] expected=36000 got=" + to_string(stats[1])) }
    if stats[2] != 135 { panic("c_fps_overlay_metal_compose FAIL [stats total_us] expected=135 got=" + to_string(stats[2])) }
    if stats[3] != 45 { panic("c_fps_overlay_metal_compose FAIL [stats avg_us] expected=45 got=" + to_string(stats[3])) }

    r0_emit("fomc_summary", "\"composes\":" + to_string(stats[0]) + ",\"pixels\":" + to_string(stats[1]) + ",\"total_us\":" + to_string(stats[2]) + ",\"avg_us\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_fps_overlay_metal_compose FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic Metal overlay compose round-trip (Track BI — diablo2_resurrected cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BI mission: c_fps_* family 100% completion cycle (Track BF 1/4 → BI 4/4) —
    // c_fps_overlay_metal_compose 측 Apple-native synthetic round-trip 추가. Metal
    // overlay compose lifecycle (drawable_acquire → encoder_begin → blit_compose → present)
    // 측 spec freeze. Apple-native scaffold only (own1 정합, CAMetalLayer
    // binary linkage 0).
    //
    // (a) synthetic 4-phase overlay compose lifecycle —
    //     drawable_acquire → encoder_begin → blit_compose → present_drawable:
    //     phase_count               4
    //     overlay_compose_off       0x18005A000         (synthetic CAMetalLayer drawable RVA)
    //     lifecycle_kind            "synthetic_inline"  (실 CAMetalLayer.nextDrawable 호출 X)
    //
    // (b) synthetic resolution × format 16-slot compose matrix —
    //     4 resolution (720p/1080p/1440p/4K) × 4 format (BGRA8/RGBA16F/RG11B10F/RGBA10A2) = 16 slots:
    //     slot_total                16
    //     bgra8_slot_count          4                   (BGRA8 × 4 res — common overlay format)
    //     hdr_slot_count            8                   (RGBA16F + RG11B10F × 4 res — HDR mix)
    //     rgba10_slot_count         4                   (RGBA10A2 × 4 res — wide gamut)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = overlay_compose_phase(scaffold) → walk_resolution_format_matrix(scaffold).
    //              hexa-native loop only — 실 MTLCommandQueue.commandBuffer 0,
    //              real CAMetalLayer.drawableSize 0.
    //
    // synthetic overlay compose phase emit
    r0_emit("c_fps_overlay_metal_compose_synthetic_phase",
        "\"stage\":\"overlay_compose_phase\",\"phase_count\":4,\"overlay_compose_off\":\"0x18005A000\",\"lifecycle_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real CAMetalLayer binary linkage\"")
    println("__FPS_OVERLAY__ PARTIAL overlay_compose_phase")

    // synthetic resolution × format compose matrix emit
    r0_emit("c_fps_overlay_metal_compose_synthetic_matrix",
        "\"stage\":\"resolution_format_matrix\",\"slot_total\":16,\"bgra8_slot_count\":4,\"hdr_slot_count\":8,\"rgba10_slot_count\":4,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real CAMetalLayer binary linkage\"")
    println("__FPS_OVERLAY__ PARTIAL resolution_format_matrix")

    cleanup_fomc()

    println("  ✅ c_fps_overlay_metal_compose self_test PASS (3 composes, 36000 pixels, total=135 us, avg=45 us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = fomc_stats()
            println("composes=" + to_string(s[0]) + " pixels=" + to_string(s[1]) + " total_us=" + to_string(s[2]) + " avg_us=" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                let us = compose_elapsed(cid)
                println(to_string(us))
                return
            }
        }
        if sub == "cleanup" { cleanup_fomc(); println("cleaned"); return }
    }
    println("usage: hexa run c_fps_overlay_metal_compose.hexa { self-test | stats | elapsed <compose_id> | cleanup }")
}
