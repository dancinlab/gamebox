// lib/perf/c_macos_menubar_display_mode_submenu.hexa — CN-214 skeleton manjeom 15/15
//
// macOS 메뉴바 의 3-mode display submenu 추적 — NSStatusBarItem 의 NSMenu 안
// display mode submenu (창모드 / 전체화면 / PIP) 에서 사용자가 메뉴바 →
// submenu → 모드 선택 시 selection × from_mode × to_mode × elapsed 4-key 를
// columnar log 로 기록한다. CN-209 (transition_perf) 의 메뉴바-trigger 변형.
//
// 무기: selection × from × to × elapsed 4-key columnar log + count/sum.
// 효과: 메뉴바 사용자 행동 정량화 → 모드 전환 UX 핫패스 식별.

use "./r0_common"

let MMDMS_DIR = GAMEBOX_HOME + "/persist/macos_menubar_display_mode_submenu"
let SELECTION_LOG = MMDMS_DIR + "/selections.tsv"

fn mmdms_dir() -> str { return MMDMS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + MMDMS_DIR + "'")
}

// ─── selection 등록 ───
//   selection_id (메뉴바 submenu 선택 이벤트 id),
//   from_mode (1=window, 2=fullscreen, 3=pip),
//   to_mode   (1=window, 2=fullscreen, 3=pip),
//   elapsed_us (선택 → 모드 전환 완료까지 누적 시간 us — host 측 측정).
fn record_selection(selection_id: int, from_mode: int, to_mode: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(selection_id) + "\t" + to_string(from_mode) + "\t" + to_string(to_mode) + "\t" + to_string(elapsed_us)
    let tmp = SELECTION_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SELECTION_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("mmdms_record", "\"selection\":" + to_string(selection_id) + ",\"from\":" + to_string(from_mode) + ",\"to\":" + to_string(to_mode) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── selection_count — 등록된 selection 행 수 ───
fn selection_count() -> int {
    let exists = exec("test -f '" + SELECTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SELECTION_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_elapsed_us — 모든 selection elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + SELECTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + SELECTION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_to_mode — to_mode 별 selection 수 ───
fn count_by_to_mode(mode: int) -> int {
    let exists = exec("test -f '" + SELECTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(mode) + " '$3==m {c++} END{print c+0}' '" + SELECTION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── selection_elapsed — selection_id 의 elapsed_us 조회 ───
//   selection_id 미등록이면 0.
fn selection_elapsed(selection_id: int) -> int {
    let exists = exec("test -f '" + SELECTION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v s=" + to_string(selection_id) + " '$1==s {e+=$4} END{print e+0}' '" + SELECTION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── mmdms_stats — [selection_count, total_elapsed_us, count_by_to_mode(2), count_by_to_mode(3)] ───
fn mmdms_stats() -> array {
    return [selection_count(), total_elapsed_us(), count_by_to_mode(2), count_by_to_mode(3)]
}

fn cleanup_mmdms() -> void {
    let _ = exec("rm -rf '" + MMDMS_DIR + "'")
}

fn self_test() -> void {
    let sid = "mmdms-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_mmdms()

    // 합성 selection 3 종 (메뉴바 submenu 선택):
    //   65001: window → fullscreen / 240000 us
    //   65002: fullscreen → pip    / 320000 us
    //   65003: pip → window        / 180000 us
    record_selection(65001, 1, 2, 240000)
    record_selection(65002, 2, 3, 320000)
    record_selection(65003, 3, 1, 180000)

    // selection_count = 3
    let sc = selection_count()
    if sc != 3 { panic("c_macos_menubar_display_mode_submenu FAIL [selection_count] expected=3 got=" + to_string(sc)) }

    // total_elapsed_us = 240000+320000+180000 = 740000
    let te = total_elapsed_us()
    if te != 740000 { panic("c_macos_menubar_display_mode_submenu FAIL [total_elapsed_us] expected=740000 got=" + to_string(te)) }

    // count_by_to_mode: 1=1, 2=1, 3=1, 99=0
    let c1 = count_by_to_mode(1)
    if c1 != 1 { panic("c_macos_menubar_display_mode_submenu FAIL [count_by_to_mode 1] expected=1 got=" + to_string(c1)) }
    let c2 = count_by_to_mode(2)
    if c2 != 1 { panic("c_macos_menubar_display_mode_submenu FAIL [count_by_to_mode 2] expected=1 got=" + to_string(c2)) }
    let c3 = count_by_to_mode(3)
    if c3 != 1 { panic("c_macos_menubar_display_mode_submenu FAIL [count_by_to_mode 3] expected=1 got=" + to_string(c3)) }
    let c99 = count_by_to_mode(99)
    if c99 != 0 { panic("c_macos_menubar_display_mode_submenu FAIL [count_by_to_mode 99] expected=0 got=" + to_string(c99)) }

    // selection_elapsed: 65001=240000, 65002=320000, 65003=180000, 9999=0
    let e1 = selection_elapsed(65001)
    if e1 != 240000 { panic("c_macos_menubar_display_mode_submenu FAIL [selection_elapsed 65001] expected=240000 got=" + to_string(e1)) }
    let e2 = selection_elapsed(65002)
    if e2 != 320000 { panic("c_macos_menubar_display_mode_submenu FAIL [selection_elapsed 65002] expected=320000 got=" + to_string(e2)) }
    let e3 = selection_elapsed(65003)
    if e3 != 180000 { panic("c_macos_menubar_display_mode_submenu FAIL [selection_elapsed 65003] expected=180000 got=" + to_string(e3)) }
    let e4 = selection_elapsed(9999)
    if e4 != 0 { panic("c_macos_menubar_display_mode_submenu FAIL [selection_elapsed unknown] expected=0 got=" + to_string(e4)) }

    let stats = mmdms_stats()
    if stats[0] != 3 { panic("c_macos_menubar_display_mode_submenu FAIL [stats count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 740000 { panic("c_macos_menubar_display_mode_submenu FAIL [stats total_elapsed_us] expected=740000 got=" + to_string(stats[1])) }
    if stats[2] != 1 { panic("c_macos_menubar_display_mode_submenu FAIL [stats to=2] expected=1 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_macos_menubar_display_mode_submenu FAIL [stats to=3] expected=1 got=" + to_string(stats[3])) }

    r0_emit("mmdms_summary", "\"selections\":" + to_string(stats[0]) + ",\"total_elapsed_us\":" + to_string(stats[1]) + ",\"to_fullscreen\":" + to_string(stats[2]) + ",\"to_pip\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_macos_menubar_display_mode_submenu FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic NSMenu submenu mode-switch round-trip (Track BI — diablo2_resurrected cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BI mission: c_macos_* family 100% completion cycle (Track BF 1/4 → BI 4/4) —
    // c_macos_menubar_display_mode_submenu 측 Apple-native synthetic round-trip 추가.
    // NSMenu submenu mode-switch lifecycle (open → highlight → click → switch dispatch)
    // 측 spec freeze. Apple-native scaffold only (own1 정합, NSMenu binary linkage 0).
    //
    // (a) synthetic 4-phase NSMenu submenu lifecycle —
    //     submenu_open → highlight_track → click_dispatch → mode_switch:
    //     phase_count               4
    //     submenu_off               0x180050000         (synthetic NSMenu submenu RVA)
    //     lifecycle_kind            "synthetic_inline"  (실 NSMenu trackingMode 호출 X)
    //
    // (b) synthetic from × to 9-slot mode-switch matrix —
    //     3 from_mode (window/fullscreen/pip) × 3 to_mode (window/fullscreen/pip) = 9 slots:
    //     slot_total                9
    //     valid_switch_count        6                   (from != to, distinct mode transition)
    //     identity_slot_count       3                   (from == to, no-op skip)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = submenu_open_phase(scaffold) → walk_mode_switch_matrix(scaffold).
    //              hexa-native loop only — 실 NSMenuDelegate.menuWillOpen 0,
    //              real NSEvent dispatch 0.
    //
    // synthetic submenu open phase emit
    r0_emit("c_macos_menubar_display_mode_submenu_synthetic_phase",
        "\"stage\":\"submenu_open_phase\",\"phase_count\":4,\"submenu_off\":\"0x180050000\",\"lifecycle_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real NSMenu binary linkage\"")
    println("__MACOS_SUBMENU__ PARTIAL submenu_open_phase")

    // synthetic from × to mode-switch matrix emit
    r0_emit("c_macos_menubar_display_mode_submenu_synthetic_matrix",
        "\"stage\":\"mode_switch_matrix\",\"slot_total\":9,\"valid_switch_count\":6,\"identity_slot_count\":3,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real NSMenu binary linkage\"")
    println("__MACOS_SUBMENU__ PARTIAL mode_switch_matrix")

    cleanup_mmdms()

    println("  ✅ c_macos_menubar_display_mode_submenu self_test PASS (3 selections, total_elapsed_us=740000, to_fs=1, to_pip=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = mmdms_stats()
            println("selections=" + to_string(s[0]) + " total_elapsed_us=" + to_string(s[1]) + " to_fs=" + to_string(s[2]) + " to_pip=" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                let us = selection_elapsed(sid)
                println(to_string(us))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let m = to_int(a[3])
                let c = count_by_to_mode(m)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_mmdms(); println("cleaned"); return }
    }
    println("usage: hexa run c_macos_menubar_display_mode_submenu.hexa { self-test | stats | elapsed <selection_id> | count <to_mode> | cleanup }")
}
