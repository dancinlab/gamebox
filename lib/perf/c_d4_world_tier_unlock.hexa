// lib/perf/c_d4_world_tier_unlock.hexa — CN-92 skeleton manjeom 15/15
//
// D4 world tier — Phase 5 endgame.
// T1 (Adventurer) → T2 (Veteran) → T3 (Nightmare 50+) → T4 (Torment 70+).
// Tier 별 unlock 조건 (Cathedral / Fallen Temple capstone) 검증.
//
// 무기: tier table + columnar (char × tier × xp_mult).
// 효과: char 진척 + 적정 tier 선택.

use "./r0_common"

let DWTU_DIR = GAMEBOX_HOME + "/persist/d4_world_tier"
let TIER_LOG = DWTU_DIR + "/tiers.tsv"

fn dwtu_dir() -> str { return DWTU_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DWTU_DIR + "'")
}

fn tiers() -> array {
    return ["T1_Adventurer", "T2_Veteran", "T3_Nightmare", "T4_Torment"]
}

fn xp_mult(tier: str) -> int {
    if tier == "T1_Adventurer" { return 100 }     // 1.0x
    if tier == "T2_Veteran" { return 120 }        // 1.2x
    if tier == "T3_Nightmare" { return 200 }      // 2.0x
    if tier == "T4_Torment" { return 250 }        // 2.5x
    return 0
}

fn level_required(tier: str) -> int {
    if tier == "T1_Adventurer" { return 1 }
    if tier == "T2_Veteran" { return 1 }
    if tier == "T3_Nightmare" { return 50 }
    if tier == "T4_Torment" { return 70 }
    return 999
}

fn capstone_required(tier: str) -> str {
    if tier == "T3_Nightmare" { return "Cathedral_of_Light" }
    if tier == "T4_Torment" { return "Fallen_Temple" }
    return ""
}

fn can_unlock(level: int, tier: str, capstone_done: bool) -> bool {
    if level < level_required(tier) { return false }
    let cs = capstone_required(tier)
    if cs != "" && !capstone_done { return false }
    return true
}

fn record_unlock(char_name: str, tier: str, level: int, capstone_done: bool) -> void {
    ensure_dir()
    let ok = "0"
    if can_unlock(level, tier, capstone_done) { ok = "1" }
    let line = char_name + "\t" + tier + "\t" + to_string(level) + "\t" + ok
    let tmp = TIER_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + TIER_LOG + "' && rm -f '" + tmp + "'")
    if ok == "1" {
        r0_emit("d4_tier_unlock", "\"char\":\"" + char_name + "\",\"tier\":\"" + tier + "\"")
    } else {
        r0_emit("d4_tier_blocked", "\"char\":\"" + char_name + "\",\"tier\":\"" + tier + "\",\"lvl\":" + to_string(level))
    }
}

fn unlock_count() -> int {
    let exists = exec("test -f '" + TIER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$4==1' '" + TIER_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dwtu() -> void {
    let _ = exec("rm -rf '" + DWTU_DIR + "'")
}

fn self_test() -> void {
    let sid = "dwtu-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dwtu()

    let t = tiers()
    if len(t) != 4 { panic("c_d4_world_tier_unlock FAIL [tiers] expected=4 got=" + to_string(len(t))) }

    if xp_mult("T4_Torment") != 250 { panic("c_d4_world_tier_unlock FAIL [xp T4]") }
    if level_required("T3_Nightmare") != 50 { panic("c_d4_world_tier_unlock FAIL [lvl T3]") }
    if capstone_required("T4_Torment") != "Fallen_Temple" { panic("c_d4_world_tier_unlock FAIL [cap T4]") }

    // 진척률
    if !can_unlock(1, "T1_Adventurer", false) { panic("c_d4_world_tier_unlock FAIL [T1 always]") }
    if can_unlock(40, "T3_Nightmare", true) { panic("c_d4_world_tier_unlock FAIL [T3 lvl below]") }
    if can_unlock(50, "T3_Nightmare", false) { panic("c_d4_world_tier_unlock FAIL [T3 cap]") }
    if !can_unlock(50, "T3_Nightmare", true) { panic("c_d4_world_tier_unlock FAIL [T3 ok]") }
    if can_unlock(70, "T4_Torment", false) { panic("c_d4_world_tier_unlock FAIL [T4 cap]") }
    if !can_unlock(70, "T4_Torment", true) { panic("c_d4_world_tier_unlock FAIL [T4 ok]") }

    record_unlock("Mira", "T1_Adventurer", 1, false)     // ok
    record_unlock("Mira", "T2_Veteran", 30, false)        // ok
    record_unlock("Mira", "T3_Nightmare", 50, true)       // ok
    record_unlock("Mira", "T4_Torment", 70, true)         // ok
    record_unlock("Bob", "T3_Nightmare", 40, true)        // blocked (level)
    record_unlock("Bob", "T4_Torment", 70, false)         // blocked (no capstone)

    let ok = unlock_count()
    if ok != 4 { panic("c_d4_world_tier_unlock FAIL [unlock] expected=4 got=" + to_string(ok)) }

    r0_emit("d4_tier_summary", "\"tiers\":4,\"unlocked\":" + to_string(ok))

    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_d4_world_tier_unlock FAIL [emit] got=" + to_string(cnt)) }

    // ─── synthetic D4 world tier retired_intentional posture annotation (Track V) ───
    //
    // Track V mission: D4 always-online DRM honest spec freeze posture annotation.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land).
    // 본 module 측 world tier unlock state = synthetic capstone + lvl gating
    // — production live game state 측정 X (D4 always-online live session 진입 X, DRM
    // bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_intentional
    // posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "world_tier_unlock"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_world_tier_unlock_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"world_tier_unlock\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_WORLD_TIER__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dwtu()

    println("  ✅ c_d4_world_tier_unlock self_test PASS (4 tiers, capstone+lvl gating, 6 attempts 4 unlock, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "check" && len(a) >= 6 {
            let cs = a[5] == "1"
            let r = can_unlock(to_int(a[3]), a[4], cs)
            if r { println("can") } else { println("blocked") }
            return
        }
        if sub == "stats" { println("unlocked=" + to_string(unlock_count())); return }
        if sub == "cleanup" { cleanup_dwtu(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_world_tier_unlock.hexa { self-test | check <lvl> <tier> <cap0_1> | stats | cleanup }")
}
