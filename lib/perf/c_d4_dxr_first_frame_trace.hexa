// lib/perf/c_d4_dxr_first_frame_trace.hexa — CN-73 skeleton manjeom 15/15
//
// D4 first frame 까지 milestone — D4.exe → DX12 device → DXR enabled →
// AS build → 첫 ray trace → 첫 present.
//
// 무기: state machine (10 milestones, DXR 특화) + columnar.
// 효과: D4 launch 진척률 (Phase 4-D4 핵심 지표).

use "./r0_common"

let D4_DIR = GAMEBOX_HOME + "/persist/d4_dxr_first_frame"
let MILESTONE_LOG = D4_DIR + "/milestones.tsv"

fn d4_dir() -> str { return D4_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + D4_DIR + "'")
}

fn milestones() -> array {
    return [
        "exe_loaded",       // D4.exe PE loaded
        "win32_init",       // Win32 subsystem init
        "d3d12_device",     // D3D12 device
        "dxr_enabled",      // DXR (raytracing) enabled
        "swapchain",        // swap chain
        "as_build",         // bottom-level + top-level AS built
        "rt_pso",           // raytracing PSO compiled
        "menu_shader",      // 메뉴 shaders
        "first_rt_dispatch",// 첫 ray trace dispatch
        "first_present"     // 첫 frame present
    ]
}

fn record_milestone(name: str, elapsed_ms: int, ok: bool) -> void {
    ensure_dir()
    let s = "fail"
    if ok { s = "pass" }
    let ts = exec("date +%s").trim()
    let line = ts + "\t" + name + "\t" + to_string(elapsed_ms) + "\t" + s
    let tmp = MILESTONE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MILESTONE_LOG + "' && rm -f '" + tmp + "'")
    if ok {
        r0_emit("d4_milestone", "\"name\":\"" + name + "\",\"elapsed_ms\":" + to_string(elapsed_ms))
    } else {
        r0_emit("d4_milestone_blocked", "\"name\":\"" + name + "\"")
    }
}

fn furthest() -> str {
    let exists = exec("test -f '" + MILESTONE_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let ms = milestones()
    let i = len(ms) - 1
    while i >= 0 {
        let cnt_str = exec("awk -F'\\t' -v m='" + ms[i] + "' '$2==m && $4==\"pass\"' '" + MILESTONE_LOG + "' | wc -l | tr -d ' '").trim()
        if cnt_str != "" {
            let cnt = to_int(cnt_str)
            if cnt > 0 { return ms[i] }
        }
        i = i - 1
    }
    return ""
}

fn progress_pct() -> int {
    let ms = milestones()
    let total = len(ms)
    let f = furthest()
    if f == "" { return 0 }
    let i = 0
    while i < total {
        if ms[i] == f { return (i + 1) * 100 / total }
        i = i + 1
    }
    return 0
}

fn d4_stats() -> int {
    let exists = exec("test -f '" + MILESTONE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + MILESTONE_LOG + "' | tr -d ' '").trim())
}

fn cleanup_d4() -> void {
    let _ = exec("rm -rf '" + D4_DIR + "'")
}

fn self_test() -> void {
    let sid = "d4-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_d4()

    let ms = milestones()
    if len(ms) != 10 { panic("c_d4_dxr_first_frame_trace FAIL [milestones] expected=10 got=" + to_string(len(ms))) }

    // 합성 — 현재 시점 (skeleton only, 모두 fail)
    let i = 0
    while i < len(ms) {
        record_milestone(ms[i], 0, false)
        i = i + 1
    }
    let pct0 = progress_pct()
    if pct0 != 0 { panic("c_d4_dxr_first_frame_trace FAIL [pct 0]") }

    // 합성 — 미래 시나리오 (D4 first frame 도달)
    record_milestone("exe_loaded", 200, true)
    record_milestone("win32_init", 350, true)
    record_milestone("d3d12_device", 800, true)
    record_milestone("dxr_enabled", 850, true)
    record_milestone("swapchain", 900, true)

    let f = furthest()
    if f != "swapchain" { panic("c_d4_dxr_first_frame_trace FAIL [furthest] got=" + f) }

    let pct = progress_pct()
    if pct != 50 { panic("c_d4_dxr_first_frame_trace FAIL [pct] expected=50 got=" + to_string(pct)) }

    let stats = d4_stats()
    if stats != 15 { panic("c_d4_dxr_first_frame_trace FAIL [stats] expected=15 got=" + to_string(stats)) }

    r0_emit("d4_summary", "\"milestones\":15,\"pct\":" + to_string(pct) + ",\"furthest\":\"" + f + "\"")

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 10 { panic("c_d4_dxr_first_frame_trace FAIL [emit count] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AL) ───
    //
    // Track AL mission: extend Track V (7) + Track AJ (6) D4 retired_intentional posture
    // annotation to 6 additional c_d4_* modules (aspect_imprint_track + dungeon_sigil_
    // inventory + dxr_first_frame_trace + helltide_event + infernal_horde_wave + loot_
    // drop_predict). .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional
    // (Track A2 land 2026-05-03). 본 module 측 DXR first-frame ray-trace milestone
    // tracker = synthetic launch trace — D4 live session X (DRM 0, Battle.net 통과 X,
    // loader_dx blk.1 D3DMetal cross-blocked). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지
    // (retired_intentional posture per blk.1 영구 lock). pattern reference:
    //     lib/perf/c_d4_paragon_track.hexa (Track AJ predecessor, identical schema)
    //
    // synthetic posture row column header:
    //     domain                "dxr_first_frame_trace"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_dxr_first_frame_trace_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"dxr_first_frame_trace\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_DXR_FIRST_FRAME__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_d4()

    println("  ✅ c_d4_dxr_first_frame_trace self_test PASS (10 milestones, synthetic furthest=swapchain 50%, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "progress" {
            let p = progress_pct()
            let f = furthest()
            println("D4 first frame: " + to_string(p) + "% (furthest=" + f + ")")
            return
        }
        if sub == "stats" { println(to_string(d4_stats())); return }
        if sub == "cleanup" { cleanup_d4(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_dxr_first_frame_trace.hexa { self-test | progress | stats | cleanup }")
}
