// lib/perf/c_d4_nightmare_sigil_track.hexa — CN-120 skeleton manjeom 15/15
//
// D4 nightmare sigil — Phase 5 endgame loop.
// tier (1..100) × dungeon × affix(예: "burning"/"shock"/"vampiric"/"resist_phys") 조합 추적.
// sigil 1개당 affix 최대 3 슬롯 (positive/negative mix) — composition tracking.
//
// 무기: tier table + columnar (sigil × dungeon × affix1/2/3).
// 효과: 어떤 affix 조합이 가장 자주 등장하는지, 위험 affix("burning"+"shock") 동시 발현 회피.

use "./r0_common"

let DNST_DIR = GAMEBOX_HOME + "/persist/d4_nightmare_sigil"
let SIGIL_LOG = DNST_DIR + "/sigils.tsv"

fn dnst_dir() -> str { return DNST_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DNST_DIR + "'")
}

fn min_tier() -> int { return 1 }
fn max_tier() -> int { return 100 }

fn tier_valid(tier: int) -> bool {
    if tier < min_tier() { return false }
    if tier > max_tier() { return false }
    return true
}

fn record_sigil(tier: int, dungeon: str, affix1: str, affix2: str, affix3: str) -> void {
    if !tier_valid(tier) { panic("c_d4_nightmare_sigil_track FAIL [tier OOB] got=" + to_string(tier)) }
    ensure_dir()
    let line = to_string(tier) + "\t" + dungeon + "\t" + affix1 + "\t" + affix2 + "\t" + affix3
    let tmp = SIGIL_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SIGIL_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_sigil_record", "\"tier\":" + to_string(tier) + ",\"dungeon\":\"" + dungeon + "\",\"a1\":\"" + affix1 + "\",\"a2\":\"" + affix2 + "\",\"a3\":\"" + affix3 + "\"")
}

fn sigil_count() -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + SIGIL_LOG + "' | tr -d ' '").trim())
}

fn sigil_count_at_tier(tier: int) -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$1==t' '" + SIGIL_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn has_affix(affix: str) -> int {
    let exists = exec("test -f '" + SIGIL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v a='" + affix + "' '$3==a || $4==a || $5==a' '" + SIGIL_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dnst() -> void {
    let _ = exec("rm -rf '" + DNST_DIR + "'")
}

fn self_test() -> void {
    let sid = "dnst-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dnst()

    if min_tier() != 1 { panic("c_d4_nightmare_sigil_track FAIL [min_tier] got=" + to_string(min_tier())) }
    if max_tier() != 100 { panic("c_d4_nightmare_sigil_track FAIL [max_tier] got=" + to_string(max_tier())) }

    if !tier_valid(1) { panic("c_d4_nightmare_sigil_track FAIL [tier_valid 1]") }
    if !tier_valid(100) { panic("c_d4_nightmare_sigil_track FAIL [tier_valid 100]") }
    if tier_valid(0) { panic("c_d4_nightmare_sigil_track FAIL [tier_valid 0 OOB]") }
    if tier_valid(101) { panic("c_d4_nightmare_sigil_track FAIL [tier_valid 101 OOB]") }

    // 5 sigil 등록 (tier 5/8/10 mix) — affix 다양화
    record_sigil(5,  "blind_burrows",   "burning",   "shock",     "resist_phys")
    record_sigil(5,  "guulrahn_canals", "burning",   "vampiric",  "extra_health")
    record_sigil(8,  "sirocco_caverns", "shock",     "burning",   "cold_enchanted")
    record_sigil(8,  "anica_claim",     "vampiric",  "shock",     "resist_phys")
    record_sigil(10, "demonic_hordes",  "burning",   "resist_phys", "thorns")

    let total = sigil_count()
    if total != 5 { panic("c_d4_nightmare_sigil_track FAIL [total] expected=5 got=" + to_string(total)) }

    let t5 = sigil_count_at_tier(5)
    if t5 != 2 { panic("c_d4_nightmare_sigil_track FAIL [tier5 count] expected=2 got=" + to_string(t5)) }
    let t8 = sigil_count_at_tier(8)
    if t8 != 2 { panic("c_d4_nightmare_sigil_track FAIL [tier8 count] expected=2 got=" + to_string(t8)) }
    let t10 = sigil_count_at_tier(10)
    if t10 != 1 { panic("c_d4_nightmare_sigil_track FAIL [tier10 count] expected=1 got=" + to_string(t10)) }
    let t99 = sigil_count_at_tier(99)
    if t99 != 0 { panic("c_d4_nightmare_sigil_track FAIL [tier99 empty] got=" + to_string(t99)) }

    // affix 빈도: burning 4 (sigil 1,2,3,5), shock 3 (1,3,4), vampiric 2 (2,4), resist_phys 3 (1,4,5), thorns 1 (5)
    let burn = has_affix("burning")
    if burn != 4 { panic("c_d4_nightmare_sigil_track FAIL [burning] expected=4 got=" + to_string(burn)) }
    let shock = has_affix("shock")
    if shock != 3 { panic("c_d4_nightmare_sigil_track FAIL [shock] expected=3 got=" + to_string(shock)) }
    let vamp = has_affix("vampiric")
    if vamp != 2 { panic("c_d4_nightmare_sigil_track FAIL [vampiric] expected=2 got=" + to_string(vamp)) }
    let rphys = has_affix("resist_phys")
    if rphys != 3 { panic("c_d4_nightmare_sigil_track FAIL [resist_phys] expected=3 got=" + to_string(rphys)) }
    let thorns = has_affix("thorns")
    if thorns != 1 { panic("c_d4_nightmare_sigil_track FAIL [thorns] expected=1 got=" + to_string(thorns)) }
    let none = has_affix("nonexistent_affix")
    if none != 0 { panic("c_d4_nightmare_sigil_track FAIL [missing affix] got=" + to_string(none)) }

    r0_emit("d4_sigil_summary", "\"sigils\":" + to_string(total) + ",\"burning\":" + to_string(burn) + ",\"shock\":" + to_string(shock) + ",\"vampiric\":" + to_string(vamp))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 5 { panic("c_d4_nightmare_sigil_track FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track BA) ───
    //
    // Track BA mission: extend Track V (7) + Track AJ (6) + Track AL (6) D4 retired_
    // intentional posture annotation to 6 additional c_d4_* modules. cumulative
    // coverage 25/27 = ~92.6%. .roadmap.diablo4 blk.1 status_enum_adopted = retired_
    // intentional (Track A2 land 2026-05-03). 본 module 측 nightmare dungeon sigil
    // tier + affix tracker = synthetic build analyzer — production live game state
    // 측정 X (D4 always-online live session 진입 X, DRM bypass 0, Battle.net launcher
    // 통과 X). cond.3 status `partial` 영구 유지 (retired_intentional posture per
    // blk.1 영구 lock). pattern reference: lib/perf/c_d4_aspect_imprint_track.hexa
    // (Track AL predecessor, identical schema).
    //
    // synthetic posture row column header:
    //     domain                "nightmare_sigil_track"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_nightmare_sigil_track_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"nightmare_sigil_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\",\"track\":\"BA\"")
    println("__D4_NIGHTMARE_SIGIL__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dnst()

    println("  ✅ c_d4_nightmare_sigil_track self_test PASS (tier 1..100, 5 sigils, burning=" + to_string(burn) + " shock=" + to_string(shock) + " vampiric=" + to_string(vamp) + ", emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "record" && len(a) >= 8 {
            record_sigil(to_int(a[3]), a[4], a[5], a[6], a[7])
            println("recorded")
            return
        }
        if sub == "count" {
            println(to_string(sigil_count()))
            return
        }
        if sub == "tier" && len(a) >= 4 {
            println(to_string(sigil_count_at_tier(to_int(a[3]))))
            return
        }
        if sub == "affix" && len(a) >= 4 {
            println(to_string(has_affix(a[3])))
            return
        }
        if sub == "cleanup" { cleanup_dnst(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_nightmare_sigil_track.hexa { self-test | record <tier> <dungeon> <a1> <a2> <a3> | count | tier <t> | affix <name> | cleanup }")
}
