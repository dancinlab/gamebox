// lib/perf/c_install_progress_bar.hexa — CN-78 skeleton manjeom 15/15
//
// Phase 1 install UX — Battle.net-Setup.exe 진행 % 추정.
// installer 단계별 weight (다운로드 70%, IAT bind 5%, 압축 풀기 20%, 등록 5%) →
// 현재 step + bytes 진척으로 % bar 산출.
//
// 무기: weighted step table + columnar (per-step elapsed_ms).
// 효과: install UI dialog 에 정확한 % 표시 (사용자 신뢰).

use "./r0_common"

let CIPB_DIR = GAMEBOX_HOME + "/persist/install_progress"
let STEP_LOG = CIPB_DIR + "/steps.tsv"

fn cipb_dir() -> str { return CIPB_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CIPB_DIR + "'")
}

fn step_names() -> array {
    return ["pe_parse", "iat_bind", "download", "extract", "register"]
}

fn step_weight(name: str) -> int {
    if name == "pe_parse" { return 5 }
    if name == "iat_bind" { return 5 }
    if name == "download" { return 65 }
    if name == "extract" { return 20 }
    if name == "register" { return 5 }
    return 0
}

fn record_step(name: str, elapsed_ms: int, pct_within: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = ts + "\t" + name + "\t" + to_string(elapsed_ms) + "\t" + to_string(pct_within)
    let tmp = STEP_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + STEP_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("install_step", "\"step\":\"" + name + "\",\"pct_within\":" + to_string(pct_within))
}

// 현재 전체 % = 완료된 step weights 합 + 현재 step (weight × pct_within / 100)
fn overall_pct() -> int {
    let exists = exec("test -f '" + STEP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let names = step_names()
    let i = 0
    let total = 0
    while i < len(names) {
        let n = names[i]
        let last = exec("awk -F'\\t' -v s='" + n + "' '$2==s {p=$4} END{print p+0}' '" + STEP_LOG + "'").trim()
        let pct_within = 0
        if last != "" { pct_within = to_int(last) }
        let w = step_weight(n)
        total = total + w * pct_within / 100
        i = i + 1
    }
    if total > 100 { return 100 }
    return total
}

fn step_count() -> int {
    let exists = exec("test -f '" + STEP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + STEP_LOG + "' | tr -d ' '").trim())
}

fn cleanup_cipb() -> void {
    let _ = exec("rm -rf '" + CIPB_DIR + "'")
}

fn self_test() -> void {
    let sid = "cipb-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cipb()

    let names = step_names()
    if len(names) != 5 { panic("c_install_progress_bar FAIL [steps] expected=5 got=" + to_string(len(names))) }

    let sum = step_weight("pe_parse") + step_weight("iat_bind") + step_weight("download") + step_weight("extract") + step_weight("register")
    if sum != 100 { panic("c_install_progress_bar FAIL [weight sum] expected=100 got=" + to_string(sum)) }

    // 0% — nothing yet
    let p0 = overall_pct()
    if p0 != 0 { panic("c_install_progress_bar FAIL [empty pct] expected=0 got=" + to_string(p0)) }

    record_step("pe_parse", 50, 100)        // +5 → 5%
    record_step("iat_bind", 30, 100)        // +5 → 10%
    record_step("download", 5000, 50)       // +32.5 → 42%
    let p_mid = overall_pct()
    if p_mid != 42 { panic("c_install_progress_bar FAIL [mid pct] expected=42 got=" + to_string(p_mid)) }

    record_step("download", 10000, 100)     // download 완료 → 75%
    record_step("extract", 2000, 50)        // extract 50% → 85%
    let p_late = overall_pct()
    if p_late != 85 { panic("c_install_progress_bar FAIL [late pct] expected=85 got=" + to_string(p_late)) }

    record_step("extract", 4000, 100)       // 95%
    record_step("register", 200, 100)       // 100%
    let p_done = overall_pct()
    if p_done != 100 { panic("c_install_progress_bar FAIL [done pct] expected=100 got=" + to_string(p_done)) }

    let cnt_steps = step_count()
    if cnt_steps != 7 { panic("c_install_progress_bar FAIL [step count] expected=7 got=" + to_string(cnt_steps)) }

    r0_emit("install_progress_summary", "\"final_pct\":" + to_string(p_done) + ",\"steps\":" + to_string(cnt_steps))

    let cnt = r0_session_count(sid)
    if cnt < 7 { panic("c_install_progress_bar FAIL [emit] got=" + to_string(cnt)) }

    // ─── synthetic install progress-bar state machine round-trip (Track-AR cond.3 EVIDENCE AUGMENT — partial 유지, cond.2 cross-link) ───
    //
    // Track-AR mission: battlenet cond.2 setup install phase staging 측 evidence augment
    // cross-link. cond.3 status `partial` 영구 유지 — 실 install phase progress
    // pe_parse → iat_bind → download → extract → register 측 cond.2 met (offline shim)
    // territory, 본 cycle 측 cond.3 측 cross-link evidence augment 만 추가.
    //
    // synthetic progress state machine: PE_PARSE → IAT_BIND → DOWNLOAD → EXTRACT
    // → REGISTER 5 transition. hexa-native loop only — 실 PE binary parse 0, 실 IAT
    // resolve 0, 실 download 0, 실 extract 0.
    // payload = progress_session_id + phase_kind + weight_pct_simulated.
    // round-trip emit = `__INSTALL_PROGRESS__ PARTIAL <state>` per row.
    //
    // own1: Wine 0 / installer launch 0 / disk write 0 / real PE parse 0.
    // own2: PARTIAL emit explicit (NOT PASS — production smoke deferred).
    let prog_sid = "prog-synth-" + exec("date +%s").trim()

    println("__INSTALL_PROGRESS__ PARTIAL PE_PARSE")
    r0_emit("c_install_progress_bar_synthetic_state",
        "\"stage\":\"progress_bar_state_machine\",\"progress_session_id\":\"" + prog_sid + "\",\"phase_kind\":\"PE_PARSE\",\"weight_pct_simulated\":10,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"permanent_until_real_network — blk.1 transitive\"")

    println("__INSTALL_PROGRESS__ PARTIAL IAT_BIND")
    r0_emit("c_install_progress_bar_synthetic_state",
        "\"stage\":\"progress_bar_state_machine\",\"progress_session_id\":\"" + prog_sid + "\",\"phase_kind\":\"IAT_BIND\",\"weight_pct_simulated\":10,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__INSTALL_PROGRESS__ PARTIAL DOWNLOAD")
    r0_emit("c_install_progress_bar_synthetic_state",
        "\"stage\":\"progress_bar_state_machine\",\"progress_session_id\":\"" + prog_sid + "\",\"phase_kind\":\"DOWNLOAD\",\"weight_pct_simulated\":65,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__INSTALL_PROGRESS__ PARTIAL EXTRACT")
    r0_emit("c_install_progress_bar_synthetic_state",
        "\"stage\":\"progress_bar_state_machine\",\"progress_session_id\":\"" + prog_sid + "\",\"phase_kind\":\"EXTRACT\",\"weight_pct_simulated\":20,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__INSTALL_PROGRESS__ PARTIAL REGISTER")
    r0_emit("c_install_progress_bar_synthetic_state",
        "\"stage\":\"progress_bar_state_machine\",\"progress_session_id\":\"" + prog_sid + "\",\"phase_kind\":\"REGISTER\",\"weight_pct_simulated\":5,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    r0_emit("c_install_progress_bar_synthetic_round_trip_matrix",
        "\"states_total\":5,\"states_partial\":5,\"states_pass\":0,\"progress_session_id\":\"" + prog_sid + "\",\"transport_kind\":\"synthetic_inline\",\"network\":\"none\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"track\":\"AR\",\"lockin_iso\":\"2026-05-04\"")

    cleanup_cipb()

    println("  ✅ c_install_progress_bar self_test PASS (5 steps weight sum=100, 7 records, 42→85→100%, +5 synthetic progress state PARTIAL transitions, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "step" && len(a) >= 6 {
            record_step(a[3], to_int(a[4]), to_int(a[5]))
            println("recorded")
            return
        }
        if sub == "pct" { println(to_string(overall_pct()) + "%"); return }
        if sub == "cleanup" { cleanup_cipb(); println("cleaned"); return }
    }
    println("usage: hexa run c_install_progress_bar.hexa { self-test | step <name> <ms> <pct> | pct | cleanup }")
}
