// lib/perf/c_cs2_tier0_plat_shim.hexa — CN-170 skeleton manjeom 14/15 (B=4)
//
// CS2 (Source 2) Valve `tier0.dll` Plat_* 함수 DIY shim 추적 — Source 2 진입
// prerequisite. CS2 의 Source 2 엔진은 Valve 자체 `tier0.dll` 의 platform
// 추상화 layer 의존 — `Plat_RegisterModule`, `Plat_GetRegisteredModules`,
// `Plat_AssertNotMainThread` 등 함수 stub 필요. closure path B 적용 시
// reverse-engineered DIY shim 작성. offline path 만 의미 (online VAC 거부
// directive). 만점 14/15 (B=4 — prerequisite).
//
// 무기: api × call_count × stub_kind × elapsed 4-key 컬럼 로그.
// 효과: Source 2 진입 prereq tier0 shim 부담 정량화, 다른 Source 2 게임
// (DOTA 2, HL Alyx) generic 흡수 가능.

use "./r0_common"

let CTPS_DIR = GAMEBOX_HOME + "/persist/cs2_tier0_plat_shim"
let API_LOG = CTPS_DIR + "/apis.tsv"

fn ctps_dir() -> str { return CTPS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CTPS_DIR + "'")
}

// ─── api 등록 ───
//   api_id (Plat_RegisterModule / Plat_GetRegisteredModules / Plat_AssertNotMainThread 등 hash),
//   call_count (이 api 누적 호출 횟수),
//   stub_kind (1=register, 2=query, 3=assert, 4=other),
//   elapsed_us (이 api 누적 elapsed micro-seconds).
fn record_api(api_id: int, call_count: int, stub_kind: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(api_id) + "\t" + to_string(call_count) + "\t" + to_string(stub_kind) + "\t" + to_string(elapsed_us)
    let tmp = API_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + API_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("cs2_tier0_plat_record", "\"api\":" + to_string(api_id) + ",\"calls\":" + to_string(call_count) + ",\"kind\":" + to_string(stub_kind) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── api_count — 등록된 api 행 수 ───
fn api_count() -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + API_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_calls — 모든 api call_count 합 ───
fn total_calls() -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_elapsed_us — 모든 api elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_kind — stub_kind 별 api 행 수 ───
//   1=register, 2=query, 3=assert, 4=other. 미등록 kind 면 0.
fn count_by_kind(stub_kind: int) -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(stub_kind) + " '$3==k {c+=1} END{print c+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── api_calls — 특정 api_id 의 call_count 합 ───
//   미등록 api_id 면 0 반환.
fn api_calls(api_id: int) -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(api_id) + " '$1==a {s+=$2} END{print s+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_elapsed_per_call_ns — (total_elapsed_us * 1000) / total_calls ───
//   us → ns 단위 환산 후 call 수로 나눔. total_calls 0 이면 0 (divide-by-zero guard).
fn avg_elapsed_per_call_ns() -> int {
    let tc = total_calls()
    if tc == 0 { return 0 }
    let te = total_elapsed_us()
    return (te * 1000) / tc
}

// ─── ctps_stats — [api_count, total_calls, total_elapsed_us, count_by_kind(1)] ───
fn ctps_stats() -> array {
    return [api_count(), total_calls(), total_elapsed_us(), count_by_kind(1)]
}

fn cleanup_ctps() -> void {
    let _ = exec("rm -rf '" + CTPS_DIR + "'")
}

fn self_test() -> void {
    let sid = "ctps-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_ctps()

    // 합성 api 3 종 (Valve tier0.dll Plat_* DIY shim):
    //   Plat_RegisterModule         (id=24001) — 120 calls / register / 240 us
    //   Plat_GetRegisteredModules   (id=24002) — 240 calls / query    / 480 us
    //   Plat_AssertNotMainThread    (id=24003) — 600 calls / assert   / 600 us
    record_api(24001, 120, 1, 240)
    record_api(24002, 240, 2, 480)
    record_api(24003, 600, 3, 600)

    // api_count = 3
    let ac = api_count()
    if ac != 3 { panic("c_cs2_tier0_plat_shim FAIL [api_count] expected=3 got=" + to_string(ac)) }

    // total_calls = 120+240+600 = 960
    let tc = total_calls()
    if tc != 960 { panic("c_cs2_tier0_plat_shim FAIL [total_calls] expected=960 got=" + to_string(tc)) }

    // total_elapsed_us = 240+480+600 = 1320
    let te = total_elapsed_us()
    if te != 1320 { panic("c_cs2_tier0_plat_shim FAIL [total_elapsed_us] expected=1320 got=" + to_string(te)) }

    // count_by_kind: 1=1, 2=1, 3=1, 4=0, 99=0
    let k1 = count_by_kind(1)
    if k1 != 1 { panic("c_cs2_tier0_plat_shim FAIL [count_by_kind 1] expected=1 got=" + to_string(k1)) }
    let k2 = count_by_kind(2)
    if k2 != 1 { panic("c_cs2_tier0_plat_shim FAIL [count_by_kind 2] expected=1 got=" + to_string(k2)) }
    let k3 = count_by_kind(3)
    if k3 != 1 { panic("c_cs2_tier0_plat_shim FAIL [count_by_kind 3] expected=1 got=" + to_string(k3)) }
    let k4 = count_by_kind(4)
    if k4 != 0 { panic("c_cs2_tier0_plat_shim FAIL [count_by_kind 4] expected=0 got=" + to_string(k4)) }
    let k99 = count_by_kind(99)
    if k99 != 0 { panic("c_cs2_tier0_plat_shim FAIL [count_by_kind 99] expected=0 got=" + to_string(k99)) }

    // api_calls:
    //   24001 → 120, 24002 → 240, 24003 → 600, 9999 (미등록) → 0
    let c1 = api_calls(24001)
    if c1 != 120 { panic("c_cs2_tier0_plat_shim FAIL [calls 24001] expected=120 got=" + to_string(c1)) }
    let c2 = api_calls(24002)
    if c2 != 240 { panic("c_cs2_tier0_plat_shim FAIL [calls 24002] expected=240 got=" + to_string(c2)) }
    let c3 = api_calls(24003)
    if c3 != 600 { panic("c_cs2_tier0_plat_shim FAIL [calls 24003] expected=600 got=" + to_string(c3)) }
    let c4 = api_calls(9999)
    if c4 != 0 { panic("c_cs2_tier0_plat_shim FAIL [calls unknown] expected=0 got=" + to_string(c4)) }

    // avg_elapsed_per_call_ns = (1320 * 1000) / 960 = 1320000/960 = 1375 (int trunc)
    let avg = avg_elapsed_per_call_ns()
    if avg != 1375 { panic("c_cs2_tier0_plat_shim FAIL [avg_ns] expected=1375 got=" + to_string(avg)) }

    let stats = ctps_stats()
    if stats[0] != 3 { panic("c_cs2_tier0_plat_shim FAIL [stats apis] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 960 { panic("c_cs2_tier0_plat_shim FAIL [stats total_calls] expected=960 got=" + to_string(stats[1])) }
    if stats[2] != 1320 { panic("c_cs2_tier0_plat_shim FAIL [stats total_elapsed_us] expected=1320 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_cs2_tier0_plat_shim FAIL [stats register] expected=1 got=" + to_string(stats[3])) }

    r0_emit("cs2_tier0_plat_summary", "\"apis\":" + to_string(stats[0]) + ",\"total_calls\":" + to_string(stats[1]) + ",\"total_elapsed_us\":" + to_string(stats[2]) + ",\"register\":" + to_string(stats[3]) + ",\"avg_ns\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_cs2_tier0_plat_shim FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic CS2 tier0 platform shim retired_intentional posture annotation (Track AT) ───
    // Track AT mission: annotate ALL 3 c_cs2_*.hexa perf modules with RETIRED_INTENTIONAL
    // posture, mirroring Track V/AJ/AL D4 retired_intentional pattern. .roadmap.cs2 blk.1
    // status_enum_adopted = retired_intentional (Track C 4-game adoption 2026-05-03,
    // vac_anticheat). 본 module 측 Valve tier0.dll Plat_* DIY shim tracker = synthetic
    // Source 2 prereq analyzer — production live tier0.dll runtime resolve 측 VAC
    // integrity check 우회 측정 X (own1 Wine 0 / NO VAC bypass / NO anti-cheat tampering,
    // reverse-engineered DIY shim stub-only synthetic). 본 cycle module self_test()
    // honest annotation row 추가 only — cs2.cond.2 status `partial` 영구 유지 (retired_
    // intentional posture per blk.1 영구 lock; vac_anticheat 영구 외부 boundary).
    // pattern reference:
    //     lib/perf/c_d4_aspect_imprint_track.hexa (Track AL predecessor, schema adapted
    //     from always_online_drm to vac_anticheat blocker class)
    // synthetic posture row column header:
    //     domain                "tier0_plat_shim"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live tier0.dll runtime resolve / no Source 2 enter)
    //     vac_bypass            "0"                    (own1 Wine 0 / no AC circumvention)
    //     anti_cheat_evade      "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "cs2.blk.1"            (vac_anticheat)
    //     adoption_iso          "2026-05-03"           (Track C retired_intentional adopt)
    r0_emit("c_cs2_tier0_plat_shim_retired_intentional",
        "\"stage\":\"cs2_tier0_synthetic\",\"domain\":\"tier0_plat_shim\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"vac_bypass\":0,\"anti_cheat_evade\":0,\"blocker_ref\":\"cs2.blk.1\",\"blocker_class\":\"vac_anticheat\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"cs2.cond.2\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__CS2_TIER0__ RETIRED_INTENTIONAL cs2_tier0_synthetic")

    cleanup_ctps()

    println("  ✅ c_cs2_tier0_plat_shim self_test PASS (3 apis, 960 calls, 1320 us, register=1, avg=1375 ns/call, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = ctps_stats()
            println("apis=" + to_string(s[0]) + " total_calls=" + to_string(s[1]) + " total_elapsed_us=" + to_string(s[2]) + " register=" + to_string(s[3]))
            return
        }
        if sub == "calls" {
            if len(a) >= 4 {
                let aid = to_int(a[3])
                let n = api_calls(aid)
                println(to_string(n))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let kk = to_int(a[3])
                let n = count_by_kind(kk)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_ctps(); println("cleaned"); return }
    }
    println("usage: hexa run c_cs2_tier0_plat_shim.hexa { self-test | stats | calls <api_id> | count <stub_kind> | cleanup }")
}
