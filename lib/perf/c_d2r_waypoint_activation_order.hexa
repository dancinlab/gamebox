// lib/perf/c_d2r_waypoint_activation_order.hexa — CN-189 skeleton manjeom 15/15
//
// D2R waypoint network 활성 순서 추적 — Diablo II Resurrected 의 5 act 각각 약
// 6 waypoint, 합계 ~30 waypoint network 를 사용자가 act progression 에 따라
// 순차 활성화 한다. 본 모듈은 (waypoint_id × act × order_idx × activation_us)
// 4-key columnar log 로 활성 timing 을 집계하여 D2R speedrun / progression 을
// 정량화 한다 — forecast 측면에서 다음 waypoint 도달 ETA 산출의 base data 가 됨.
//
// 무기: waypoint × act × order × activation 4-key 컬럼 로그 + sum/avg/per-act.
// 효과: D2R speedrun pacing 정량화 → next-waypoint ETA 추정의 ground truth.

use "./r0_common"

let DWAO_DIR = GAMEBOX_HOME + "/persist/d2r_waypoint_activation_order"
let DWAO_LOG = DWAO_DIR + "/waypoints.tsv"

fn dwao_dir() -> str { return DWAO_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DWAO_DIR + "'")
}

// ─── waypoint 활성 등록 ───
//   waypoint_id (D2R waypoint 고유 id, 예: 43001 Stony Field),
//   act (1-5, D2R 의 5 act),
//   order_idx (act 내 활성 순서 idx),
//   activation_us (활성 시각 — micro-second epoch / relative).
fn record_wp(waypoint_id: int, act: int, order_idx: int, activation_us: int) -> void {
    ensure_dir()
    let line = to_string(waypoint_id) + "\t" + to_string(act) + "\t" + to_string(order_idx) + "\t" + to_string(activation_us)
    let tmp = DWAO_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DWAO_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dwao_record", "\"waypoint\":" + to_string(waypoint_id) + ",\"act\":" + to_string(act) + ",\"order\":" + to_string(order_idx) + ",\"activation_us\":" + to_string(activation_us))
}

// ─── wp_count — 등록된 waypoint 행 수 ───
fn wp_count() -> int {
    let exists = exec("test -f '" + DWAO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + DWAO_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_activation_us — 모든 waypoint activation_us 합 ───
fn total_activation_us() -> int {
    let exists = exec("test -f '" + DWAO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + DWAO_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_act — 특정 act 의 waypoint 수 ───
fn count_by_act(act: int) -> int {
    let exists = exec("test -f '" + DWAO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(act) + " '$2==a {n++} END{print n+0}' '" + DWAO_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_activation_us — total_activation_us / wp_count ───
//   wp_count 0 이면 0 반환 (divide-by-zero guard).
fn avg_activation_us() -> int {
    let c = wp_count()
    if c == 0 { return 0 }
    let t = total_activation_us()
    return t / c
}

// ─── wp_activation_us — 특정 waypoint_id 의 activation_us ───
//   미등록이면 0 반환.
fn wp_activation_us(waypoint_id: int) -> int {
    let exists = exec("test -f '" + DWAO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v w=" + to_string(waypoint_id) + " '$1==w {s+=$4} END{print s+0}' '" + DWAO_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dwao_stats — [wp_count, total_activation_us, count_by_act(1), avg_activation_us] ───
fn dwao_stats() -> array {
    return [wp_count(), total_activation_us(), count_by_act(1), avg_activation_us()]
}

fn cleanup_dwao() -> void {
    let _ = exec("rm -rf '" + DWAO_DIR + "'")
}

fn self_test() -> void {
    let sid = "dwao-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dwao()

    // 합성 waypoint 3 종:
    //   43001 Stony Field (Act 1) — order_idx=2,  activation_us=900000000
    //   43002 Far Oasis   (Act 2) — order_idx=8,  activation_us=2400000000
    //   43003 Lost City   (Act 2) — order_idx=10, activation_us=3000000000
    record_wp(43001, 1, 2, 900000000)
    record_wp(43002, 2, 8, 2400000000)
    record_wp(43003, 2, 10, 3000000000)

    // wp_count = 3
    let c = wp_count()
    if c != 3 { panic("c_d2r_waypoint_activation_order FAIL [wp_count] expected=3 got=" + to_string(c)) }

    // total_activation_us = 900000000 + 2400000000 + 3000000000 = 6300000000
    let t = total_activation_us()
    if t != 6300000000 { panic("c_d2r_waypoint_activation_order FAIL [total_activation_us] expected=6300000000 got=" + to_string(t)) }

    // count_by_act: act 1 = 1, act 2 = 2, act 3 = 0, act 99 = 0
    let a1 = count_by_act(1)
    if a1 != 1 { panic("c_d2r_waypoint_activation_order FAIL [count_by_act 1] expected=1 got=" + to_string(a1)) }
    let a2 = count_by_act(2)
    if a2 != 2 { panic("c_d2r_waypoint_activation_order FAIL [count_by_act 2] expected=2 got=" + to_string(a2)) }
    let a3 = count_by_act(3)
    if a3 != 0 { panic("c_d2r_waypoint_activation_order FAIL [count_by_act 3] expected=0 got=" + to_string(a3)) }
    let a99 = count_by_act(99)
    if a99 != 0 { panic("c_d2r_waypoint_activation_order FAIL [count_by_act 99] expected=0 got=" + to_string(a99)) }

    // avg_activation_us = 6300000000 / 3 = 2100000000
    let avg = avg_activation_us()
    if avg != 2100000000 { panic("c_d2r_waypoint_activation_order FAIL [avg_activation_us] expected=2100000000 got=" + to_string(avg)) }

    // wp_activation_us per waypoint
    let w1 = wp_activation_us(43001)
    if w1 != 900000000 { panic("c_d2r_waypoint_activation_order FAIL [wp_activation_us 43001] expected=900000000 got=" + to_string(w1)) }
    let w2 = wp_activation_us(43002)
    if w2 != 2400000000 { panic("c_d2r_waypoint_activation_order FAIL [wp_activation_us 43002] expected=2400000000 got=" + to_string(w2)) }
    let w3 = wp_activation_us(43003)
    if w3 != 3000000000 { panic("c_d2r_waypoint_activation_order FAIL [wp_activation_us 43003] expected=3000000000 got=" + to_string(w3)) }
    let w_unknown = wp_activation_us(9999)
    if w_unknown != 0 { panic("c_d2r_waypoint_activation_order FAIL [wp_activation_us unknown] expected=0 got=" + to_string(w_unknown)) }

    // dwao_stats() = [3, 6300000000, 1, 2100000000]
    let stats = dwao_stats()
    if stats[0] != 3 { panic("c_d2r_waypoint_activation_order FAIL [stats wp_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 6300000000 { panic("c_d2r_waypoint_activation_order FAIL [stats total_activation_us] expected=6300000000 got=" + to_string(stats[1])) }
    if stats[2] != 1 { panic("c_d2r_waypoint_activation_order FAIL [stats count_by_act_1] expected=1 got=" + to_string(stats[2])) }
    if stats[3] != 2100000000 { panic("c_d2r_waypoint_activation_order FAIL [stats avg_activation_us] expected=2100000000 got=" + to_string(stats[3])) }

    r0_emit("dwao_summary", "\"wp_count\":" + to_string(stats[0]) + ",\"total_activation_us\":" + to_string(stats[1]) + ",\"act1_count\":" + to_string(stats[2]) + ",\"avg_activation_us\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d2r_waypoint_activation_order FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic waypoint activation order state machine round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track AK mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic waypoint activation state machine 4-phase cycle —
    //     discover → tag → activate → traverse (waypoint network walking):
    //     phase_count               4                   (discover/tag/activate/traverse)
    //     wp_table_off              0x1400A0000         (synthetic D2GAME.dll RVA)
    //     wp_kind                   "synthetic_inline"  (실 waypoint tick X)
    //
    // (b) synthetic 5-act × ~6-waypoint = 30 slot act distribution scaffold —
    //     Joe's Stony Field (Act 1) + Far Oasis (Act 2) + Lost City (Act 2):
    //     act_total                 5                   (D2R 5 act)
    //     wp_per_act_avg            6                   (~30 waypoint / 5 act)
    //     wp_total_network          30                  (D2R full waypoint network)
    //     wp_active_count           3                   (3 sample waypoints walked)
    //     act1_count                1                   (Stony Field)
    //     act2_count                2                   (Far Oasis + Lost City)
    //     dist_kind                 "synthetic_inline"  (실 waypoint log lookup X)
    //
    // round-trip = synthesize_wp_phase(scaffold) → walk_act_distribution(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll waypoint tick 0,
    //              real waypoint network activation 0.
    //
    // synthetic wp phase emit
    r0_emit("c_d2r_waypoint_activation_order_synthetic_phase",
        "\"stage\":\"wp_phase\",\"phase_count\":4,\"wp_table_off\":\"0x1400A0000\",\"wp_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_WP__ PARTIAL wp_phase")

    // synthetic act distribution emit
    r0_emit("c_d2r_waypoint_activation_order_synthetic_distribution",
        "\"stage\":\"act_distribution\",\"act_total\":5,\"wp_per_act_avg\":6,\"wp_total_network\":30,\"wp_active_count\":3,\"act1_count\":1,\"act2_count\":2,\"dist_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_WP__ PARTIAL act_distribution")

    cleanup_dwao()

    println("  ✅ c_d2r_waypoint_activation_order self_test PASS (3 waypoints, total=6300000000 us, act1=1, avg=2100000000 us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dwao_stats()
            println("wp_count=" + to_string(s[0]) + " total_activation_us=" + to_string(s[1]) + " act1_count=" + to_string(s[2]) + " avg_activation_us=" + to_string(s[3]))
            return
        }
        if sub == "act" {
            if len(a) >= 4 {
                let act = to_int(a[3])
                let n = count_by_act(act)
                println(to_string(n))
                return
            }
        }
        if sub == "wp" {
            if len(a) >= 4 {
                let wid = to_int(a[3])
                let us = wp_activation_us(wid)
                println(to_string(us))
                return
            }
        }
        if sub == "cleanup" { cleanup_dwao(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_waypoint_activation_order.hexa { self-test | stats | act <act> | wp <waypoint_id> | cleanup }")
}
