// lib/perf/r0_session.hexa — 게임 세션 lifecycle + JSONL 코디네이터
//
// 게임 launch 시 session 생성, parser/cache_watch/heap_sample 호출, 종료 시 close.
//
// upstream candidate: directory listing builtin (현재 ls/find exec 우회),
//                     JSON parsing (현재 grep -o 우회).

use "./r0_common"

fn session_start(game: str, pid: int) -> str {
    let sid = r0_new_sid()
    r0_session_set(sid)
    r0_emit("session_start", "\"game\":\"" + game + "\",\"pid\":" + to_string(pid))
    return sid
}

fn session_end(sid: str) -> void {
    let prev = r0_session_get()
    r0_session_set(sid)
    r0_emit("session_end", "")
    r0_session_set(prev)
    if prev == sid {
        let _ = exec("rm -f '" + R0_CURRENT_SESSION_PTR + "'")
    }
}

fn session_list() -> int {
    r0_ensure_dirs()
    let listing = exec("ls -1 '" + R0_SESSIONS + "'/*.jsonl 2>/dev/null")
    if listing == "" {
        println("(no sessions)")
        return 0
    }
    let cnt_str = exec("printf '%s' '" + listing + "' | grep -c .").trim()
    let cnt = to_int(cnt_str)
    println(listing)
    return cnt
}

fn session_show(sid: str) -> void {
    let f = r0_session_path(sid)
    let exists = exec("test -f '" + f + "' && echo ok").trim()
    if exists != "ok" {
        panic("session not found: " + sid)
    }
    let cnt = r0_session_count(sid)
    println("session " + sid)
    println("  path:   " + f)
    println("  events: " + to_string(cnt))
    let by_type = exec("grep -o '\"event\":\"[^\"]*\"' '" + f + "' | sort | uniq -c | sort -rn")
    println("  by_event_type:")
    println(by_type)
}

fn session_current() -> void {
    let sid = r0_session_get()
    if sid == "no-session" {
        println("(no current session)")
    } else {
        println(sid)
    }
}

fn self_test() -> void {
    // 1. start a session
    let sid = session_start("selftest", 0)

    // 2. emit a few events directly
    r0_emit("test_event_1", "\"k\":1")
    r0_emit("test_event_2", "\"k\":2,\"v\":\"hello\"")

    // 3. end
    session_end(sid)

    // 4. verify
    let f = r0_session_path(sid)
    let exists = exec("test -f '" + f + "' && echo ok").trim()
    if exists != "ok" {
        panic("r0_session FAIL [file not created]")
    }
    let cnt = r0_session_count(sid)
    // session_start + test_event_1 + test_event_2 + session_end = 4
    if cnt != 4 {
        panic("r0_session FAIL [count] expected=4 got=" + to_string(cnt))
    }

    // 5. event_type 검증
    let starts = exec("grep -c 'session_start' '" + f + "'").trim()
    let ends = exec("grep -c 'session_end' '" + f + "'").trim()
    if starts != "1" || ends != "1" {
        panic("r0_session FAIL [start/end count] starts=" + starts + " ends=" + ends)
    }

    println("  ✅ r0_session self_test PASS (4 events: start+2 test+end, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "list" {
            let _ = session_list()
            return
        }
        if sub == "current" {
            session_current()
            return
        }
        if sub == "show" {
            if len(a) >= 4 {
                session_show(a[3])
                return
            }
        }
        if sub == "start" {
            if len(a) >= 5 {
                let sid = session_start(a[3], to_int(a[4]))
                println(sid)
                return
            }
        }
        if sub == "end" {
            if len(a) >= 4 {
                session_end(a[3])
                println("ended: " + a[3])
                return
            }
        }
    }
    println("usage: hexa run r0_session.hexa { self-test | list | current | show <sid> | start <game> <pid> | end <sid> }")
}
