// lib/perf/c_d4_infernal_horde_wave.hexa — CN-194 skeleton manjeom 15/15
//
// D4 Infernal Horde rogue-lite wave 추적 — Season 5+ horde mechanic.
// Infernal Horde 는 wave-based combat (1-10 wave) + 매 wave 종료 시 boon
// (3 random buff offer 中 1 택) selection 으로 진행한다. 본 모듈은
// wave × difficulty × enemy_count × boon_kind 4-key columnar log 만 담당 —
// 다음 wave 의 boon 후보 예측은 host 측 책임.
//
// 무기: wave × difficulty × enemy × boon 4-key 컬럼 로그 + 집계.
// 효과: D4 Infernal Horde 진행 정량화 → tier × boon 선택 분포 추적.

use "./r0_common"

let DIHW_DIR = GAMEBOX_HOME + "/persist/d4_infernal_horde_wave"
let WAVE_LOG = DIHW_DIR + "/waves.tsv"

fn dihw_dir() -> str { return DIHW_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DIHW_DIR + "'")
}

// ─── wave 등록 ───
//   wave_id (Infernal Horde 진행 wave 의 고유 id),
//   difficulty_tier (1-8 — Torment IV 등 난이도 단계),
//   enemy_count (해당 wave 내 등장한 적 수),
//   boon_kind (1=offensive / 2=defensive / 3=utility — 선택된 buff 분류).
fn record_wave(wave_id: int, difficulty_tier: int, enemy_count: int, boon_kind: int) -> void {
    ensure_dir()
    let line = to_string(wave_id) + "\t" + to_string(difficulty_tier) + "\t" + to_string(enemy_count) + "\t" + to_string(boon_kind)
    let tmp = WAVE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + WAVE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dihw_record", "\"wave\":" + to_string(wave_id) + ",\"tier\":" + to_string(difficulty_tier) + ",\"enemies\":" + to_string(enemy_count) + ",\"boon\":" + to_string(boon_kind))
}

// ─── wave_count — 등록된 wave 행 수 ───
fn wave_count() -> int {
    let exists = exec("test -f '" + WAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + WAVE_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_enemies — 모든 wave enemy_count 합 ───
fn total_enemies() -> int {
    let exists = exec("test -f '" + WAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + WAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_difficulty — 특정 tier 의 wave 수 ───
fn count_by_difficulty(tier: int) -> int {
    let exists = exec("test -f '" + WAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$2==t {n+=1} END{print n+0}' '" + WAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_boon_kind — 특정 boon_kind 의 wave 수 ───
fn count_by_boon_kind(kind: int) -> int {
    let exists = exec("test -f '" + WAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$4==k {n+=1} END{print n+0}' '" + WAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── wave_enemies — 특정 wave_id 의 enemy_count ───
//   미등록 wave_id 는 0.
fn wave_enemies(wave_id: int) -> int {
    let exists = exec("test -f '" + WAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v w=" + to_string(wave_id) + " '$1==w {s+=$3} END{print s+0}' '" + WAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dihw_stats — [wave_count, total_enemies, count_by_difficulty(8), count_by_boon_kind(1)] ───
fn dihw_stats() -> array {
    return [wave_count(), total_enemies(), count_by_difficulty(8), count_by_boon_kind(1)]
}

fn cleanup_dihw() -> void {
    let _ = exec("rm -rf '" + DIHW_DIR + "'")
}

fn self_test() -> void {
    let sid = "dihw-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dihw()

    // 합성 wave 3 종 (D4 Infernal Horde 한 run 의 1 / 5 / 10 wave 발췌):
    //   48001 (wave 1, tier 5)        — 24 enemies, offensive boon
    //   48002 (wave 5, tier 8)        — 72 enemies, defensive boon
    //   48003 (wave 10 boss, tier 8)  — 12 enemies (boss), utility boon
    record_wave(48001, 5, 24, 1)
    record_wave(48002, 8, 72, 2)
    record_wave(48003, 8, 12, 3)

    // wave_count = 3
    let wc = wave_count()
    if wc != 3 { panic("c_d4_infernal_horde_wave FAIL [wave_count] expected=3 got=" + to_string(wc)) }

    // total_enemies = 24+72+12 = 108
    let te = total_enemies()
    if te != 108 { panic("c_d4_infernal_horde_wave FAIL [total_enemies] expected=108 got=" + to_string(te)) }

    // count_by_difficulty: 5→1, 8→2, 99→0
    let cd5 = count_by_difficulty(5)
    if cd5 != 1 { panic("c_d4_infernal_horde_wave FAIL [count_by_difficulty 5] expected=1 got=" + to_string(cd5)) }
    let cd8 = count_by_difficulty(8)
    if cd8 != 2 { panic("c_d4_infernal_horde_wave FAIL [count_by_difficulty 8] expected=2 got=" + to_string(cd8)) }
    let cd99 = count_by_difficulty(99)
    if cd99 != 0 { panic("c_d4_infernal_horde_wave FAIL [count_by_difficulty 99] expected=0 got=" + to_string(cd99)) }

    // count_by_boon_kind: 1→1, 2→1, 3→1, 99→0
    let cb1 = count_by_boon_kind(1)
    if cb1 != 1 { panic("c_d4_infernal_horde_wave FAIL [count_by_boon_kind 1] expected=1 got=" + to_string(cb1)) }
    let cb2 = count_by_boon_kind(2)
    if cb2 != 1 { panic("c_d4_infernal_horde_wave FAIL [count_by_boon_kind 2] expected=1 got=" + to_string(cb2)) }
    let cb3 = count_by_boon_kind(3)
    if cb3 != 1 { panic("c_d4_infernal_horde_wave FAIL [count_by_boon_kind 3] expected=1 got=" + to_string(cb3)) }
    let cb99 = count_by_boon_kind(99)
    if cb99 != 0 { panic("c_d4_infernal_horde_wave FAIL [count_by_boon_kind 99] expected=0 got=" + to_string(cb99)) }

    // wave_enemies: 48001→24, 48002→72, 48003→12, 9999→0
    let w1 = wave_enemies(48001)
    if w1 != 24 { panic("c_d4_infernal_horde_wave FAIL [wave_enemies 48001] expected=24 got=" + to_string(w1)) }
    let w2 = wave_enemies(48002)
    if w2 != 72 { panic("c_d4_infernal_horde_wave FAIL [wave_enemies 48002] expected=72 got=" + to_string(w2)) }
    let w3 = wave_enemies(48003)
    if w3 != 12 { panic("c_d4_infernal_horde_wave FAIL [wave_enemies 48003] expected=12 got=" + to_string(w3)) }
    let w4 = wave_enemies(9999)
    if w4 != 0 { panic("c_d4_infernal_horde_wave FAIL [wave_enemies unknown] expected=0 got=" + to_string(w4)) }

    // dihw_stats = [3, 108, 2, 1]
    let stats = dihw_stats()
    if stats[0] != 3 { panic("c_d4_infernal_horde_wave FAIL [stats wave_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 108 { panic("c_d4_infernal_horde_wave FAIL [stats total_enemies] expected=108 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_d4_infernal_horde_wave FAIL [stats tier8] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_d4_infernal_horde_wave FAIL [stats boon1] expected=1 got=" + to_string(stats[3])) }

    r0_emit("dihw_summary", "\"waves\":" + to_string(stats[0]) + ",\"enemies\":" + to_string(stats[1]) + ",\"tier8\":" + to_string(stats[2]) + ",\"offensive\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d4_infernal_horde_wave FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AL) ───
    //
    // Track AL mission: extend Track V (7) + Track AJ (6) D4 retired_intentional posture
    // annotation to 6 additional c_d4_* modules (aspect_imprint_track + dungeon_sigil_
    // inventory + dxr_first_frame_trace + helltide_event + infernal_horde_wave + loot_
    // drop_predict). .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional
    // (Track A2 land 2026-05-03). 본 module 측 infernal horde wave/boon/tier tracker =
    // synthetic wave analyzer — production live game state 측정 X (D4 always-online live
    // session 진입 X, DRM bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self
    // _test() 측 honest annotation row 추가 only — cond.3 status `partial` 영구 유지
    // (retired_intentional posture per blk.1 영구 lock). pattern reference:
    //     lib/perf/c_d4_paragon_track.hexa (Track AJ predecessor, identical schema)
    //
    // synthetic posture row column header:
    //     domain                "infernal_horde_wave"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_infernal_horde_wave_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"infernal_horde_wave\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_INFERNAL_HORDE__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dihw()

    println("  ✅ c_d4_infernal_horde_wave self_test PASS (3 waves, 108 enemies, tier8=2, offensive=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dihw_stats()
            println("waves=" + to_string(s[0]) + " enemies=" + to_string(s[1]) + " tier8=" + to_string(s[2]) + " offensive=" + to_string(s[3]))
            return
        }
        if sub == "enemies" {
            if len(a) >= 4 {
                let wid = to_int(a[3])
                let n = wave_enemies(wid)
                println(to_string(n))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let tier = to_int(a[3])
                let n = count_by_difficulty(tier)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_dihw(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_infernal_horde_wave.hexa { self-test | stats | enemies <wave_id> | count <difficulty_tier> | cleanup }")
}
