// lib/perf/r0_heap_sample.hexa — Metal heap stats 샘플
//
// vmmap-based fallback (MTL_HUD heap stats 가 정식). 단순 sample / synthetic.
//
// upstream candidate: high-precision sleep_ms, native fs/proc readers,
//                     bit ops (heap genome 인코딩용).

use "./r0_common"

// PID 단일 sample — vmmap 으로 IOSurface/IOAccelerator/MALLOC_LARGE 합산 (KB)
fn sample_pid(pid: int) -> int {
    let pid_s = to_string(pid)
    let alive = exec("kill -0 " + pid_s + " 2>/dev/null && echo ok").trim()
    if alive != "ok" {
        return 0
    }
    let vm = exec("vmmap " + pid_s + " 2>/dev/null")
    if vm == "" {
        return 0
    }
    // heap 추정 (KB)
    let tex_kb = to_int(exec("printf '%s' '" + vm + "' | grep -E 'IOSurface|IOAccelerator' | awk '{gsub(/K/,\"\",$NF); s+=$NF+0} END{print s+0}'").trim())
    let buf_kb = to_int(exec("printf '%s' '" + vm + "' | grep -E 'MALLOC_LARGE' | awk '{gsub(/K/,\"\",$NF); s+=$NF+0} END{print s+0}'").trim())
    let tot_kb = to_int(exec("printf '%s' '" + vm + "' | grep -E '^TOTAL' | tail -1 | awk '{gsub(/K/,\"\",$2); print $2+0}'").trim())

    let tex_mb = tex_kb / 1024
    let buf_mb = buf_kb / 1024
    let peak_mb = tot_kb / 1024

    let payload = "\"pid\":" + pid_s + ",\"tex_active_mb\":" + to_string(tex_mb) + ",\"tex_evicted_mb\":0,\"buf_active_mb\":" + to_string(buf_mb) + ",\"frag_pct\":0,\"peak_mb\":" + to_string(peak_mb)
    r0_emit("heap_sample", payload)
    return 1
}

// 합성 sample — self-test 용
fn sample_synthetic(tex: int, evict: int, buf: int, frag: int, peak: int) -> void {
    let payload = "\"pid\":99999,\"tex_active_mb\":" + to_string(tex) + ",\"tex_evicted_mb\":" + to_string(evict) + ",\"buf_active_mb\":" + to_string(buf) + ",\"frag_pct\":" + to_string(frag) + ",\"peak_mb\":" + to_string(peak)
    r0_emit("heap_sample", payload)
}

fn self_test() -> void {
    let sid = "r0heap-" + exec("date +%s").trim()
    r0_session_set(sid)

    sample_synthetic(1000, 0,   200, 5,  1300)
    sample_synthetic(1100, 50,  220, 8,  1500)
    sample_synthetic(1200, 100, 240, 12, 1700)
    sample_synthetic(1400, 200, 260, 20, 2000)
    sample_synthetic(1500, 250, 280, 35, 2200)

    let cnt = r0_session_count(sid)
    if cnt != 5 {
        panic("r0_heap_sample FAIL [count] expected=5 got=" + to_string(cnt))
    }

    // 마지막 sample 이 frag_pct=35 인지 검증 (anomaly 라벨 후속 의존성 확인)
    let last = exec("tail -1 '" + r0_session_path(sid) + "' | grep -o 'frag_pct\":[0-9]*' | cut -d: -f2").trim()
    if last != "35" {
        panic("r0_heap_sample FAIL [last frag_pct] expected=35 got=" + last)
    }
    println("  ✅ r0_heap_sample self_test PASS (5 samples, last frag=35, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "once" {
            if len(a) >= 4 {
                let n = sample_pid(to_int(a[3]))
                println("samples: " + to_string(n))
                return
            }
        }
    }
    println("usage: hexa run r0_heap_sample.hexa { self-test | once <pid> }")
}
