// lib/perf/c_bnet_warden_environment_compat.hexa — Track-J Warden honest detection-surface tracker
//
// Battle.net / Blizzard user-mode anti-cheat (Warden) detection-surface 추적 모듈.
// **bypass / evasion / circumvent / hook-chain shim / signature spoof / NOP-patch / memory-scan dodge
// 0줄** — 본 모듈은 honest detection-vector enumeration tracker only. 만약 Warden 이 scan 한다면
// 어떤 vector 가 관측될 수 있는지 high-level 명칭만 추적 (research-direction reference).
//
// 무기: vector enumeration (5+ category) + TSV columnar persist (detect_id / vector_id / signal_kind /
//       observation_kind / risk_kind / severity_kind).
// 효과: 자연 환경 정합 (natural environment alignment, Track-K Win32 syscall perfection 측 long-horizon
//       reference) — Warden 검출 회피가 아닌, 실 Windows 환경과의 syscall / module / process tree
//       fingerprint 정합 측 future-cycle research-direction.
//
// own1 (Wine 0): Wine / CrossOver / Whisky / GPTK 측 fetch / import 0줄 — 본 모듈도 동일.
// own2 (honest emit): 모든 emit 은 `__BNET_WARDEN__ DETECTION_TRACKED <vector>` 의 honest tracking
//                     posture only (NOT BYPASS, NOT EVADE, NOT PASS_via_circumvention).
//
// reserved-word 회피: type / mod / handle / class / interface / module / import 사용 X →
//                    track_kind / vector_id / signal_kind / observation_kind / risk_kind / severity_kind 사용.
//
// cross-reference: docs/WARDEN_HONEST_FREEZE.md (sister freeze doc, 본 cycle land) +
//                  docs/GAMEGUARD_HONEST_FREEZE.md (predecessor sister doc, kernel-mode counterpart).
//
// TSV persist schema (vectors.tsv):
//   ts_unix    detect_id    vector_id    signal_kind    observation_kind    risk_kind    severity_kind

use "./r0_common"

let WARDEN_DIR = GAMEBOX_HOME + "/persist/c_bnet_warden_environment_compat"
let VECTORS_LOG = WARDEN_DIR + "/vectors.tsv"

fn warden_dir() -> str { return WARDEN_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + WARDEN_DIR + "'")
}

// ─── Warden detection vectors (5+ honest categories, NOT bypass) ───
//
// 각 vector 는 외부 공개 자료 (Wikipedia / Glider lawsuit public docs / Russinovich Windows
// Internals) 수준의 high-level 명칭만이며, 회피 방법 / 회피 코드 / 회피 pattern 측 본 모듈 + 본
// 함수 + 본 freeze doc 측 영구 0줄.
fn vectors() -> array {
    return [
        "memory_scan_periodicity",   // Warden 측 client process memory periodic scan (외부 공개 high-level)
        "loaded_dll_list_check",      // PEB Ldr 측 loaded DLL list enumeration check (high-level)
        "process_tree_fingerprint",   // process parent/child tree shape fingerprint (high-level)
        "syscall_pattern_fingerprint",// NTDLL syscall sequence pattern fingerprint (high-level)
        "file_integrity_hash",        // 게임 binary + .pak file integrity hash check (high-level)
        "hwid_machine_id_attest",     // H/W identifier + machine_id server-side attest (high-level)
        "anti_debug_timing"           // RDTSC / NtQueryInformationProcess timing 측 anti-debug (high-level)
    ]
}

// ─── signal_kind enum (honest tracking posture only) ───
fn signal_kinds() -> array {
    return [
        "DETECTION_TRACKED",          // honest tracking — 본 모듈 의 1 차 posture
        "OBSERVED_INERT",              // 관측되었으나 action X (inert posture)
        "BLOCK_ACKNOWLEDGED"           // block 발생 시 honest acknowledge (NOT bypass)
    ]
}

// ─── observation_kind enum (what gamebox would honestly observe) ───
fn observation_kinds() -> array {
    return [
        "apple_silicon_mac_unique",   // Mac native env = unique fingerprint vs Windows
        "wine_zero_no_wineloader",    // own1 Wine 0 — wineloader.exe 측 LDR_DATA_TABLE entry 없음
        "no_native_windows_proc_tree",// macOS native = Windows process tree 부재
        "non_ntdll_syscall_path",      // mach trap + BSD syscall (non-NTDLL surface)
        "missing_windows_drivers"      // Win32 driver presence absent (.sys 측 절대 X)
    ]
}

// ─── risk_kind enum (EULA / ban risk acknowledgment) ───
fn risk_kinds() -> array {
    return [
        "eula_violation_acknowledged",   // L1 lock-in: Mac unauthorized platform
        "warden_detection_acknowledged", // L2 lock-in: detection risk
        "ban_probability_high"           // unsupported platform high ban probability
    ]
}

fn record_vector(detect_id: str, vector_id: str, signal_kind: str, observation_kind: str, risk_kind: str, severity_kind: str) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = ts + "\t" + detect_id + "\t" + vector_id + "\t" + signal_kind + "\t" + observation_kind + "\t" + risk_kind + "\t" + severity_kind
    let tmp = VECTORS_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + VECTORS_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("warden_detection_tracked", "\"detect_id\":\"" + detect_id + "\",\"vector_id\":\"" + vector_id + "\",\"signal_kind\":\"" + signal_kind + "\",\"observation_kind\":\"" + observation_kind + "\",\"risk_kind\":\"" + risk_kind + "\",\"severity_kind\":\"" + severity_kind + "\"")
}

fn vector_count() -> int {
    let exists = exec("test -f '" + VECTORS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + VECTORS_LOG + "' | tr -d ' '").trim())
}

fn distinct_vector_count() -> int {
    let exists = exec("test -f '" + VECTORS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let cnt_str = exec("awk -F'\\t' '{print $3}' '" + VECTORS_LOG + "' | sort -u | wc -l | tr -d ' '").trim()
    if cnt_str == "" { return 0 }
    return to_int(cnt_str)
}

fn cleanup_warden() -> void {
    let _ = exec("rm -rf '" + WARDEN_DIR + "'")
}

fn self_test() -> void {
    let sid = "warden-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_warden()

    let vs = vectors()
    if len(vs) < 5 { panic("c_bnet_warden_environment_compat FAIL [vectors] expected>=5 got=" + to_string(len(vs))) }

    let sks = signal_kinds()
    if len(sks) != 3 { panic("c_bnet_warden_environment_compat FAIL [signal_kinds] expected=3 got=" + to_string(len(sks))) }

    let oks = observation_kinds()
    if len(oks) != 5 { panic("c_bnet_warden_environment_compat FAIL [observation_kinds] expected=5 got=" + to_string(len(oks))) }

    let rks = risk_kinds()
    if len(rks) != 3 { panic("c_bnet_warden_environment_compat FAIL [risk_kinds] expected=3 got=" + to_string(len(rks))) }

    // ─── synthetic detection-vector enumeration (honest tracking, NOT bypass) ───
    //
    // 각 row 의 signal_kind = "DETECTION_TRACKED" (NOT "BYPASS", NOT "EVADE", NOT
    // "PASS_via_circumvention"). 본 self_test 의 emit 은 "만약 Warden 이 scan 한다면 본 환경에서
    // 무엇을 honestly 관측 할 것인가" 의 reference 만이며, 회피 방법 / 회피 코드 / 회피 pattern
    // 측 영구 0줄.

    record_vector("warden-001", "memory_scan_periodicity",   "DETECTION_TRACKED", "apple_silicon_mac_unique",   "warden_detection_acknowledged", "high")
    record_vector("warden-002", "loaded_dll_list_check",      "DETECTION_TRACKED", "wine_zero_no_wineloader",    "warden_detection_acknowledged", "high")
    record_vector("warden-003", "process_tree_fingerprint",   "DETECTION_TRACKED", "no_native_windows_proc_tree","warden_detection_acknowledged", "high")
    record_vector("warden-004", "syscall_pattern_fingerprint","DETECTION_TRACKED", "non_ntdll_syscall_path",     "warden_detection_acknowledged", "critical")
    record_vector("warden-005", "file_integrity_hash",        "DETECTION_TRACKED", "missing_windows_drivers",    "warden_detection_acknowledged", "medium")
    record_vector("warden-006", "hwid_machine_id_attest",     "DETECTION_TRACKED", "apple_silicon_mac_unique",   "eula_violation_acknowledged",   "critical")
    record_vector("warden-007", "anti_debug_timing",          "DETECTION_TRACKED", "non_ntdll_syscall_path",     "ban_probability_high",          "medium")

    let vc = vector_count()
    if vc != 7 { panic("c_bnet_warden_environment_compat FAIL [vector_count] expected=7 got=" + to_string(vc)) }

    let dvc = distinct_vector_count()
    if dvc != 7 { panic("c_bnet_warden_environment_compat FAIL [distinct] expected=7 got=" + to_string(dvc)) }

    // ─── honest tracking posture emit (NOT bypass) — 7 detection-vectors enumerated ───
    //
    // 본 emit 은 "DETECTION_TRACKED" posture (honest tracking) — bypass / evasion / circumvent
    // 측 본 모듈 + 본 emit + 본 self_test 측 영구 0줄. 모든 vector 는 high-level 명칭만이며,
    // 실 회피 방법 / 회피 코드 / 회피 pattern 측 본 cycle + 본 cycle 의 모든 sister cycle (Track-J
    // / Track-K / Track-L) 측 영구 out-of-scope.
    println("__BNET_WARDEN__ DETECTION_TRACKED memory_scan_periodicity")
    println("__BNET_WARDEN__ DETECTION_TRACKED loaded_dll_list_check")
    println("__BNET_WARDEN__ DETECTION_TRACKED process_tree_fingerprint")
    println("__BNET_WARDEN__ DETECTION_TRACKED syscall_pattern_fingerprint")
    println("__BNET_WARDEN__ DETECTION_TRACKED file_integrity_hash")
    println("__BNET_WARDEN__ DETECTION_TRACKED hwid_machine_id_attest")
    println("__BNET_WARDEN__ DETECTION_TRACKED anti_debug_timing")

    r0_emit("c_bnet_warden_environment_compat_summary",
        "\"vectors\":7,\"distinct_vectors\":7,\"signal_kind\":\"DETECTION_TRACKED\",\"posture\":\"honest_tracking_no_bypass\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"natural_env_align_gap\":\"permanent_research_direction — Track-K Win32 syscall perfection long-horizon\",\"online_expansion_lockin\":\"L1+L2_acknowledged\"")

    let cnt = r0_session_count(sid)
    if cnt < 7 { panic("c_bnet_warden_environment_compat FAIL [emit count] got=" + to_string(cnt)) }

    cleanup_warden()

    println("  ✅ c_bnet_warden_environment_compat self_test PASS (7 vectors DETECTION_TRACKED, 7 distinct, no bypass / no evasion / no circumvent, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "vectors" {
            let vs = vectors()
            let i = 0
            while i < len(vs) {
                println(vs[i])
                i = i + 1
            }
            return
        }
        if sub == "stats" { println(to_string(vector_count())); return }
        if sub == "distinct" { println(to_string(distinct_vector_count())); return }
        if sub == "cleanup" { cleanup_warden(); println("cleaned"); return }
    }
    println("usage: hexa run c_bnet_warden_environment_compat.hexa { self-test | vectors | stats | distinct | cleanup }")
}
