// lib/perf/c_d4_dxr_bvh_compact.hexa — CN-81 skeleton manjeom 15/15
//
// D4 DXR BVH compaction — bottom-level AS 메모리 회수.
// 빌드된 BVH 가 lifetime 후 dirty fragment 차지 → compact 호출로 회수.
//
// 무기: BLAS table (size before/after compact) + columnar (compact savings).
// 효과: D4 long session VRAM pressure ↓ (BVH 재빌드 없이).

use "./r0_common"

let DBVH_DIR = GAMEBOX_HOME + "/persist/d4_dxr_bvh_compact"
let BLAS_LOG = DBVH_DIR + "/blas.tsv"

fn dbvh_dir() -> str { return DBVH_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DBVH_DIR + "'")
}

fn record_blas(blas_id: str, before_kb: int, after_kb: int) -> void {
    ensure_dir()
    let saved = before_kb - after_kb
    let line = blas_id + "\t" + to_string(before_kb) + "\t" + to_string(after_kb) + "\t" + to_string(saved)
    let tmp = BLAS_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + BLAS_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_blas_compact", "\"id\":\"" + blas_id + "\",\"saved_kb\":" + to_string(saved))
}

fn total_before() -> int {
    let exists = exec("test -f '" + BLAS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + BLAS_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn total_after() -> int {
    let exists = exec("test -f '" + BLAS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + BLAS_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn savings_pct() -> int {
    let b = total_before()
    if b == 0 { return 0 }
    let a = total_after()
    return (b - a) * 100 / b
}

fn blas_count() -> int {
    let exists = exec("test -f '" + BLAS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + BLAS_LOG + "' | tr -d ' '").trim())
}

fn cleanup_dbvh() -> void {
    let _ = exec("rm -rf '" + DBVH_DIR + "'")
}

fn self_test() -> void {
    let sid = "dbvh-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dbvh()

    // synthetic BLAS — 5 blas with 30~50% compaction
    record_blas("dungeon_wall", 1024, 600)      // 41% saved
    record_blas("monster_skel", 512, 320)       // 37%
    record_blas("loot_chest", 256, 180)         // 30%
    record_blas("npc_npc", 768, 400)            // 48%
    record_blas("env_tree", 2048, 1200)         // 41%

    let cnt = blas_count()
    if cnt != 5 { panic("c_d4_dxr_bvh_compact FAIL [count] expected=5 got=" + to_string(cnt)) }

    let b = total_before()
    if b != 4608 { panic("c_d4_dxr_bvh_compact FAIL [before] expected=4608 got=" + to_string(b)) }

    let a = total_after()
    if a != 2700 { panic("c_d4_dxr_bvh_compact FAIL [after] expected=2700 got=" + to_string(a)) }

    let pct = savings_pct()
    if pct < 38 || pct > 44 { panic("c_d4_dxr_bvh_compact FAIL [pct] expected ~41 got=" + to_string(pct)) }

    r0_emit("d4_bvh_summary", "\"blas\":" + to_string(cnt) + ",\"saved_kb\":" + to_string(b - a) + ",\"pct\":" + to_string(pct))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 5 { panic("c_d4_dxr_bvh_compact FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track BA) ───
    //
    // Track BA mission: extend Track V (7) + Track AJ (6) + Track AL (6) D4 retired_
    // intentional posture annotation to 6 additional c_d4_* modules (dxr_bvh_compact +
    // living_steel_economy + nightmare_sigil_track + occultist_enchant_roll + whisper_
    // bounty_optimize + xp_curve_predict). cumulative coverage 25/27 = ~92.6%.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land
    // 2026-05-03). 본 module 측 BLAS compaction tracker = synthetic build analyzer —
    // production live game state 측정 X (D4 always-online live session 진입 X, DRM
    // bypass 0, Battle.net launcher 통과 X) AND loader_dx blk.1 D3DMetal cross-block
    // (DXR ray-trace path is direct loader_dx cond.2 dependency). cond.3 status
    // `partial` 영구 유지 (retired_intentional posture per blk.1 영구 lock). pattern
    // reference: lib/perf/c_d4_aspect_imprint_track.hexa (Track AL predecessor).
    //
    // synthetic posture row column header:
    //     domain                "dxr_bvh_compact"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     cross_block_ref       "loader_dx.blk.1"      (D3DMetal binary licence — DXR path)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_dxr_bvh_compact_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"dxr_bvh_compact\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"cross_block_ref\":\"loader_dx.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\",\"track\":\"BA\"")
    println("__D4_DXR_BVH_COMPACT__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dbvh()

    println("  ✅ c_d4_dxr_bvh_compact self_test PASS (5 BLAS, " + to_string(b - a) + " kb saved (" + to_string(pct) + "%), emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "compact" && len(a) >= 6 {
            record_blas(a[3], to_int(a[4]), to_int(a[5]))
            println("recorded")
            return
        }
        if sub == "stats" {
            println("blas=" + to_string(blas_count()) + " before=" + to_string(total_before()) + "kb after=" + to_string(total_after()) + "kb pct=" + to_string(savings_pct()))
            return
        }
        if sub == "cleanup" { cleanup_dbvh(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_dxr_bvh_compact.hexa { self-test | compact <id> <before_kb> <after_kb> | stats | cleanup }")
}
