// lib/perf/c_d2r_char_skill_tree.hexa — CN-83 skeleton manjeom 15/15
//
// D2R character skill tree state — Phase 5 gameplay loop.
// 7 classes × 3 trees × 30 skills = 630 skill slots, 각 0~20 level.
//
// 무기: skill table + columnar (per-class skill point distribution).
// 효과: char build 분석 (예: Necro summoner build vs poison dagger).

use "./r0_common"

let DCST_DIR = GAMEBOX_HOME + "/persist/d2r_skill_tree"
let SKILL_LOG = DCST_DIR + "/skills.tsv"

fn dcst_dir() -> str { return DCST_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DCST_DIR + "'")
}

fn classes() -> array {
    return ["amazon", "barbarian", "necromancer", "paladin", "sorceress", "druid", "assassin"]
}

fn skills_per_tree() -> int { return 30 }
fn trees_per_class() -> int { return 3 }
fn max_level() -> int { return 20 }

fn record_skill(char_name: str, class_name: str, tree: str, skill_idx: int, level: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + SKILL_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v t='" + tree + "' -v i=" + to_string(skill_idx) + " '!($1==c && $3==t && $4==i)' '" + SKILL_LOG + "' > '" + SKILL_LOG + ".tmp' && mv '" + SKILL_LOG + ".tmp' '" + SKILL_LOG + "'")
    }
    let line = char_name + "\t" + class_name + "\t" + tree + "\t" + to_string(skill_idx) + "\t" + to_string(level)
    let tmp = SKILL_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SKILL_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d2r_skill_set", "\"char\":\"" + char_name + "\",\"tree\":\"" + tree + "\",\"idx\":" + to_string(skill_idx) + ",\"lvl\":" + to_string(level))
}

fn total_points(char_name: str) -> int {
    let exists = exec("test -f '" + SKILL_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c {s+=$5} END{print s+0}' '" + SKILL_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn dominant_tree(char_name: str) -> str {
    let exists = exec("test -f '" + SKILL_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c {a[$3]+=$5} END{m=0; for(k in a) if(a[k]>m){m=a[k]; n=k} print n}' '" + SKILL_LOG + "'").trim()
    return r
}

fn cleanup_dcst() -> void {
    let _ = exec("rm -rf '" + DCST_DIR + "'")
}

fn self_test() -> void {
    let sid = "dcst-skill-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dcst()

    let cls = classes()
    if len(cls) != 7 { panic("c_d2r_char_skill_tree FAIL [classes] expected=7 got=" + to_string(len(cls))) }

    let total_slots = len(cls) * trees_per_class() * skills_per_tree()
    if total_slots != 630 { panic("c_d2r_char_skill_tree FAIL [slot total] expected=630 got=" + to_string(total_slots)) }

    // synthetic Necro summoner build
    record_skill("Joe", "necromancer", "summoning", 0, 20)   // skeleton mastery
    record_skill("Joe", "necromancer", "summoning", 1, 20)   // raise skeleton
    record_skill("Joe", "necromancer", "summoning", 2, 5)
    record_skill("Joe", "necromancer", "curses", 0, 1)
    record_skill("Joe", "necromancer", "poison_bone", 0, 5)

    let pts = total_points("Joe")
    if pts != 51 { panic("c_d2r_char_skill_tree FAIL [points] expected=51 got=" + to_string(pts)) }

    let dom = dominant_tree("Joe")
    if dom != "summoning" { panic("c_d2r_char_skill_tree FAIL [dominant] got=" + dom) }

    // overwrite — same skill 다시 set
    record_skill("Joe", "necromancer", "summoning", 0, 18)
    let pts2 = total_points("Joe")
    if pts2 != 49 { panic("c_d2r_char_skill_tree FAIL [overwrite] expected=49 got=" + to_string(pts2)) }

    r0_emit("d2r_skill_summary", "\"char\":\"Joe\",\"points\":" + to_string(pts2) + ",\"dom\":\"" + dom + "\"")

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_d2r_char_skill_tree FAIL [emit] got=" + to_string(cnt)) }

    // ─── synthetic char skill tree state machine round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track AK mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic 7-class skill tree state machine class-phase cycle —
    //     amazon → barbarian → necromancer → paladin → sorceress → druid → assassin:
    //     phase_count               7                   (7 D2R classes)
    //     skill_table_off           0x140098000         (synthetic D2GAME.dll RVA)
    //     class_kind                "synthetic_inline"  (실 skill tree tick X)
    //
    // (b) synthetic 3-tree × 30-skill = 90 slot/class distribution scaffold —
    //     necromancer summoning build skeleton:
    //     tree_total                3                   (per-class tree count)
    //     skill_per_tree            30                  (per-tree skill count)
    //     slot_total_per_class      90                  (3 tree × 30 skill)
    //     dominant_invested_pts     49                  (Joe necro post-overwrite)
    //     dist_kind                 "synthetic_inline"  (실 skill log lookup X)
    //
    // round-trip = synthesize_class_phase(scaffold) → walk_tree_distribution(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll skill tree tick 0,
    //              real char skill 0.
    //
    // synthetic class phase emit
    r0_emit("c_d2r_char_skill_tree_synthetic_phase",
        "\"stage\":\"class_phase\",\"phase_count\":7,\"skill_table_off\":\"0x140098000\",\"class_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_SKILL__ PARTIAL class_phase")

    // synthetic tree distribution emit
    r0_emit("c_d2r_char_skill_tree_synthetic_distribution",
        "\"stage\":\"tree_distribution\",\"tree_total\":3,\"skill_per_tree\":30,\"slot_total_per_class\":90,\"dominant_invested_pts\":49,\"dist_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_SKILL__ PARTIAL tree_distribution")

    cleanup_dcst()

    println("  ✅ c_d2r_char_skill_tree self_test PASS (7 cls × 3 tree × 30 skill = 630 slots, dominant=" + dom + ", emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 7 {
            record_skill(a[3], a[4], a[5], to_int(a[6]), to_int(a[7]))
            println("recorded")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("char=" + a[3] + " points=" + to_string(total_points(a[3])) + " dominant=" + dominant_tree(a[3]))
            return
        }
        if sub == "cleanup" { cleanup_dcst(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_char_skill_tree.hexa { self-test | set <char> <cls> <tree> <idx> <lvl> | stats <char> | cleanup }")
}
