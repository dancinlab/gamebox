// lib/perf/c_d2r_gamble_npc_roll.hexa — CN-197 skeleton manjeom 15/15
//
// D2R Gheed/Anya/Elzix gambling NPC RNG 추적 — magic/rare/unique drop probability.
// D2R 의 gambling NPC (Gheed Act 1, Elzix Act 2 등) 가 사용자의 gold 를 받고
// 랜덤 magic+ item 을 출력한다. roll × item_kind × quality_roll × cost_gold 를
// 4-key 컬럼 로그로 누적해 Gheed gambling 효율을 정량화한다.
//
// 무기: roll × item_kind × quality × gold 4-key columnar log.
// 효과: D2R gambling 결과 RNG 분포 정량화 → magic vs rare vs unique 비율,
//       NPC 별 평균 cost, item_kind 별 hit 분포 등 사후 분석 가능.

use "./r0_common"

let DGNR_DIR = GAMEBOX_HOME + "/persist/d2r_gamble_npc_roll"
let DGNR_LOG = DGNR_DIR + "/rolls.tsv"

fn dgnr_dir() -> str { return DGNR_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DGNR_DIR + "'")
}

// ─── roll 등록 ───
//   roll_id (이번 gamble roll 식별자),
//   item_kind (1=armor, 2=weapon, 3=jewelry),
//   quality_roll (1=magic, 2=rare, 3=unique, 4=set),
//   cost_gold (이 roll 에 소비된 gold).
fn record_roll(roll_id: int, item_kind: int, quality_roll: int, cost_gold: int) -> void {
    ensure_dir()
    let line = to_string(roll_id) + "\t" + to_string(item_kind) + "\t" + to_string(quality_roll) + "\t" + to_string(cost_gold)
    let tmp = DGNR_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DGNR_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d2r_gamble_npc_roll_record", "\"roll\":" + to_string(roll_id) + ",\"kind\":" + to_string(item_kind) + ",\"quality\":" + to_string(quality_roll) + ",\"gold\":" + to_string(cost_gold))
}

// ─── roll_count — 등록된 roll 행 수 ───
fn roll_count() -> int {
    let exists = exec("test -f '" + DGNR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + DGNR_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_gold — 모든 roll cost_gold 합 ───
fn total_gold() -> int {
    let exists = exec("test -f '" + DGNR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + DGNR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_item_kind — item_kind 일치 roll 행 수 ───
fn count_by_item_kind(kind: int) -> int {
    let exists = exec("test -f '" + DGNR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$2==k {c++} END{print c+0}' '" + DGNR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_quality — quality_roll 일치 roll 행 수 ───
fn count_by_quality(quality: int) -> int {
    let exists = exec("test -f '" + DGNR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v q=" + to_string(quality) + " '$3==q {c++} END{print c+0}' '" + DGNR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── roll_cost — roll_id 의 cost_gold (미등록 → 0) ───
fn roll_cost(roll_id: int) -> int {
    let exists = exec("test -f '" + DGNR_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v r=" + to_string(roll_id) + " '$1==r {s+=$4} END{print s+0}' '" + DGNR_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dgnr_stats — [roll_count, total_gold, count_by_item_kind(2), count_by_quality(2)] ───
fn dgnr_stats() -> array {
    return [roll_count(), total_gold(), count_by_item_kind(2), count_by_quality(2)]
}

fn cleanup_dgnr() -> void {
    let _ = exec("rm -rf '" + DGNR_DIR + "'")
}

fn self_test() -> void {
    let sid = "dgnr-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dgnr()

    // 합성 gambling roll 3 종:
    //   roll 51001 — helm magic   (armor   / magic  / 15000 gold)
    //   roll 51002 — sword rare   (weapon  / rare   / 20000 gold)
    //   roll 51003 — amulet unique(jewelry / unique / 25000 gold)
    record_roll(51001, 1, 1, 15000)
    record_roll(51002, 2, 2, 20000)
    record_roll(51003, 3, 3, 25000)

    // roll_count = 3
    let rc = roll_count()
    if rc != 3 { panic("c_d2r_gamble_npc_roll FAIL [roll_count] expected=3 got=" + to_string(rc)) }

    // total_gold = 15000+20000+25000 = 60000
    let tg = total_gold()
    if tg != 60000 { panic("c_d2r_gamble_npc_roll FAIL [total_gold] expected=60000 got=" + to_string(tg)) }

    // count_by_item_kind: 1=armor(1), 2=weapon(1), 3=jewelry(1), 99=unknown(0)
    let k1 = count_by_item_kind(1)
    if k1 != 1 { panic("c_d2r_gamble_npc_roll FAIL [kind 1] expected=1 got=" + to_string(k1)) }
    let k2 = count_by_item_kind(2)
    if k2 != 1 { panic("c_d2r_gamble_npc_roll FAIL [kind 2] expected=1 got=" + to_string(k2)) }
    let k3 = count_by_item_kind(3)
    if k3 != 1 { panic("c_d2r_gamble_npc_roll FAIL [kind 3] expected=1 got=" + to_string(k3)) }
    let k99 = count_by_item_kind(99)
    if k99 != 0 { panic("c_d2r_gamble_npc_roll FAIL [kind 99] expected=0 got=" + to_string(k99)) }

    // count_by_quality: 1=magic(1), 2=rare(1), 3=unique(1), 4=set(0), 99=unknown(0)
    let q1 = count_by_quality(1)
    if q1 != 1 { panic("c_d2r_gamble_npc_roll FAIL [quality 1] expected=1 got=" + to_string(q1)) }
    let q2 = count_by_quality(2)
    if q2 != 1 { panic("c_d2r_gamble_npc_roll FAIL [quality 2] expected=1 got=" + to_string(q2)) }
    let q3 = count_by_quality(3)
    if q3 != 1 { panic("c_d2r_gamble_npc_roll FAIL [quality 3] expected=1 got=" + to_string(q3)) }
    let q4 = count_by_quality(4)
    if q4 != 0 { panic("c_d2r_gamble_npc_roll FAIL [quality 4] expected=0 got=" + to_string(q4)) }
    let q99 = count_by_quality(99)
    if q99 != 0 { panic("c_d2r_gamble_npc_roll FAIL [quality 99] expected=0 got=" + to_string(q99)) }

    // roll_cost: 51001=15000, 51002=20000, 51003=25000, 9999=0 (미등록)
    let c1 = roll_cost(51001)
    if c1 != 15000 { panic("c_d2r_gamble_npc_roll FAIL [cost 51001] expected=15000 got=" + to_string(c1)) }
    let c2 = roll_cost(51002)
    if c2 != 20000 { panic("c_d2r_gamble_npc_roll FAIL [cost 51002] expected=20000 got=" + to_string(c2)) }
    let c3 = roll_cost(51003)
    if c3 != 25000 { panic("c_d2r_gamble_npc_roll FAIL [cost 51003] expected=25000 got=" + to_string(c3)) }
    let c4 = roll_cost(9999)
    if c4 != 0 { panic("c_d2r_gamble_npc_roll FAIL [cost unknown] expected=0 got=" + to_string(c4)) }

    // dgnr_stats = [3, 60000, count_by_item_kind(2)=1, count_by_quality(2)=1]
    let stats = dgnr_stats()
    if stats[0] != 3 { panic("c_d2r_gamble_npc_roll FAIL [stats rolls] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 60000 { panic("c_d2r_gamble_npc_roll FAIL [stats gold] expected=60000 got=" + to_string(stats[1])) }
    if stats[2] != 1 { panic("c_d2r_gamble_npc_roll FAIL [stats weapons] expected=1 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_d2r_gamble_npc_roll FAIL [stats rare] expected=1 got=" + to_string(stats[3])) }

    r0_emit("d2r_gamble_npc_roll_summary", "\"rolls\":" + to_string(stats[0]) + ",\"gold\":" + to_string(stats[1]) + ",\"weapons\":" + to_string(stats[2]) + ",\"rare\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d2r_gamble_npc_roll FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic Gamble NPC roll state machine round-trip (Track BA cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BA mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic Gheed/Anya gamble state machine 4-phase cycle —
    //     vendor_open → gold_check → roll_quality → buy_or_pass
    //     (Act 1 Gheed / Act 5 Anya gamble vendor):
    //     phase_count               4                   (open/gold/roll/buy)
    //     gamble_table_off          0x1400A6000         (synthetic D2GAME.dll RVA)
    //     vendor_kind_count         2                   (gheed + anya)
    //     gamble_kind               "synthetic_inline"  (실 gamble vendor tick X)
    //
    // (b) synthetic quality_tier × buy_count matrix scaffold —
    //     5 quality tiers (normal/magic/rare/set/unique) × 3 roll attempts:
    //     quality_tier_total        5                   (normal/magic/rare/set/unique)
    //     roll_total_synthetic      3                   (synthetic 3 rolls)
    //     gold_total_synthetic      60000               (3 × ~20000 avg gamble cost)
    //     weapon_kind_count         1                   (synthetic 1 weapon roll)
    //     rare_kind_count           1                   (synthetic 1 rare quality)
    //     pass_count_synthetic      0                   (synthetic 0 pass — all bought)
    //     matrix_kind               "synthetic_inline"  (실 gamble log lookup X)
    //
    // round-trip = synthesize_gamble_phase(scaffold) → walk_quality_buy_matrix(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll gamble RNG tick 0,
    //              real Gheed/Anya inventory roll 0.
    //
    // synthetic gamble phase emit
    r0_emit("c_d2r_gamble_npc_roll_synthetic_phase",
        "\"stage\":\"gamble_phase\",\"phase_count\":4,\"gamble_table_off\":\"0x1400A6000\",\"vendor_kind_count\":2,\"gamble_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\",\"track\":\"BA\"")
    println("__D2R_GAMBLE__ PARTIAL gamble_phase")

    // synthetic quality buy matrix emit
    r0_emit("c_d2r_gamble_npc_roll_synthetic_matrix",
        "\"stage\":\"quality_buy_matrix\",\"quality_tier_total\":5,\"roll_total_synthetic\":3,\"gold_total_synthetic\":60000,\"weapon_kind_count\":1,\"rare_kind_count\":1,\"pass_count_synthetic\":0,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\",\"track\":\"BA\"")
    println("__D2R_GAMBLE__ PARTIAL quality_buy_matrix")

    cleanup_dgnr()

    println("  ✅ c_d2r_gamble_npc_roll self_test PASS (3 rolls, 60000 gold, weapons=1, rare=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dgnr_stats()
            println("rolls=" + to_string(s[0]) + " gold=" + to_string(s[1]) + " weapons=" + to_string(s[2]) + " rare=" + to_string(s[3]))
            return
        }
        if sub == "cost" {
            if len(a) >= 4 {
                let rid = to_int(a[3])
                let g = roll_cost(rid)
                println(to_string(g))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let q = to_int(a[3])
                let c = count_by_quality(q)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_dgnr(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_gamble_npc_roll.hexa { self-test | stats | cost <roll_id> | count <quality_roll> | cleanup }")
}
