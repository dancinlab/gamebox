// lib/perf/c_d2r_class_skill_synergy.hexa — CN-181 skeleton manjeom 15/15
//
// D2R class skill synergy chain 추적 — sorceress fire/ice/light, paladin auras,
// druid summons. D2R 의 class skill tree 는 동일 element/계열 skill 을 함께
// 투자하면 synergy bonus 가 누적된다 — 예: sorceress Fire Ball + Fire Bolt +
// Inferno + Meteor 4-skill 체인은 base damage 에 80% bonus, paladin Holy Fire
// + Resist Fire + Salvation 3-aura stack 은 60% bonus, druid Spirit Wolf +
// Dire Wolf + Grizzly 3-summon chain 은 45% bonus 를 부여한다. 본 모듈은
// class × synergy_chain_len × bonus_pct × skill_invested 4-key columnar 로그
// 를 영구화하여 build optimal synergy 를 정량화한다 — 실제 game install 후
// validated 가능, skeleton 단계는 합성 데이터.
//
// 무기: class × chain_len × bonus_pct × skill_invested 4-key columnar log.
// 효과: D2R class 별 build 의 optimal synergy 정량화 → respec 의사결정 지원.

use "./r0_common"

let DCSS_DIR = GAMEBOX_HOME + "/persist/d2r_class_skill_synergy"
let CLASS_LOG = DCSS_DIR + "/classes.tsv"

fn dcss_dir() -> str { return DCSS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DCSS_DIR + "'")
}

// ─── class synergy 등록 ───
//   class_id (D2R class 식별자 — Sorceress/Paladin/Druid 등),
//   synergy_chain_len (이 build 가 묶은 skill 수),
//   bonus_pct (chain 누적 bonus %),
//   skill_invested (해당 chain 에 투자한 skill point).
fn record_class(class_id: int, synergy_chain_len: int, bonus_pct: int, skill_invested: int) -> void {
    ensure_dir()
    let line = to_string(class_id) + "\t" + to_string(synergy_chain_len) + "\t" + to_string(bonus_pct) + "\t" + to_string(skill_invested)
    let tmp = CLASS_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CLASS_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d2r_class_synergy_record", "\"class\":" + to_string(class_id) + ",\"chain_len\":" + to_string(synergy_chain_len) + ",\"bonus_pct\":" + to_string(bonus_pct) + ",\"skill_invested\":" + to_string(skill_invested))
}

// ─── class_count — 등록된 class 행 수 ───
fn class_count() -> int {
    let exists = exec("test -f '" + CLASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + CLASS_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_chain_len — synergy_chain_len 합 ───
fn total_chain_len() -> int {
    let exists = exec("test -f '" + CLASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + CLASS_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_bonus_pct — bonus_pct 합 ───
fn total_bonus_pct() -> int {
    let exists = exec("test -f '" + CLASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + CLASS_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_skill_invested — skill_invested 합 ───
fn total_skill_invested() -> int {
    let exists = exec("test -f '" + CLASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + CLASS_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_bonus_per_chain_pct — total_bonus / total_chain_len (int trunc) ───
//   chain 길이 0 이면 0 반환 (divide-by-zero guard).
fn avg_bonus_per_chain_pct() -> int {
    let tcl = total_chain_len()
    if tcl == 0 { return 0 }
    let tbp = total_bonus_pct()
    return tbp / tcl
}

// ─── class_bonus_pct — 특정 class 의 bonus_pct ───
//   class_id 미등록이면 0.
fn class_bonus_pct(class_id: int) -> int {
    let exists = exec("test -f '" + CLASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v c=" + to_string(class_id) + " '$1==c {s+=$3} END{print s+0}' '" + CLASS_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dcss_stats — [class_count, total_chain_len, total_bonus_pct, total_skill_invested] ───
fn dcss_stats() -> array {
    return [class_count(), total_chain_len(), total_bonus_pct(), total_skill_invested()]
}

fn cleanup_dcss() -> void {
    let _ = exec("rm -rf '" + DCSS_DIR + "'")
}

fn self_test() -> void {
    let sid = "dcss-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dcss()

    // 합성 class 3 종:
    //   Sorceress fire chain (id=36001) — Fire Ball + Bolt + Inferno + Meteor
    //     synergy_chain_len=4, bonus_pct=80, skill_invested=80
    //   Paladin aura stack (id=36002) — Holy Fire + Resist Fire + Salvation
    //     synergy_chain_len=3, bonus_pct=60, skill_invested=60
    //   Druid summon (id=36003) — Spirit Wolf + Dire Wolf + Grizzly
    //     synergy_chain_len=3, bonus_pct=45, skill_invested=45
    record_class(36001, 4, 80, 80)
    record_class(36002, 3, 60, 60)
    record_class(36003, 3, 45, 45)

    // class_count = 3
    let cc = class_count()
    if cc != 3 { panic("c_d2r_class_skill_synergy FAIL [class_count] expected=3 got=" + to_string(cc)) }

    // total_chain_len = 4+3+3 = 10
    let tcl = total_chain_len()
    if tcl != 10 { panic("c_d2r_class_skill_synergy FAIL [total_chain_len] expected=10 got=" + to_string(tcl)) }

    // total_bonus_pct = 80+60+45 = 185
    let tbp = total_bonus_pct()
    if tbp != 185 { panic("c_d2r_class_skill_synergy FAIL [total_bonus_pct] expected=185 got=" + to_string(tbp)) }

    // total_skill_invested = 80+60+45 = 185
    let tsi = total_skill_invested()
    if tsi != 185 { panic("c_d2r_class_skill_synergy FAIL [total_skill_invested] expected=185 got=" + to_string(tsi)) }

    // avg_bonus_per_chain_pct = 185 / 10 = 18 (int trunc)
    let avg = avg_bonus_per_chain_pct()
    if avg != 18 { panic("c_d2r_class_skill_synergy FAIL [avg_bonus_per_chain_pct] expected=18 got=" + to_string(avg)) }

    // class_bonus_pct lookups
    let b1 = class_bonus_pct(36001)
    if b1 != 80 { panic("c_d2r_class_skill_synergy FAIL [bonus 36001] expected=80 got=" + to_string(b1)) }
    let b2 = class_bonus_pct(36002)
    if b2 != 60 { panic("c_d2r_class_skill_synergy FAIL [bonus 36002] expected=60 got=" + to_string(b2)) }
    let b3 = class_bonus_pct(36003)
    if b3 != 45 { panic("c_d2r_class_skill_synergy FAIL [bonus 36003] expected=45 got=" + to_string(b3)) }
    // 미등록 class_id 는 0
    let b4 = class_bonus_pct(9999)
    if b4 != 0 { panic("c_d2r_class_skill_synergy FAIL [bonus unknown] expected=0 got=" + to_string(b4)) }

    let stats = dcss_stats()
    if stats[0] != 3 { panic("c_d2r_class_skill_synergy FAIL [stats class_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 10 { panic("c_d2r_class_skill_synergy FAIL [stats chain_len] expected=10 got=" + to_string(stats[1])) }
    if stats[2] != 185 { panic("c_d2r_class_skill_synergy FAIL [stats bonus_pct] expected=185 got=" + to_string(stats[2])) }
    if stats[3] != 185 { panic("c_d2r_class_skill_synergy FAIL [stats skill_invested] expected=185 got=" + to_string(stats[3])) }

    r0_emit("d2r_class_synergy_summary", "\"classes\":" + to_string(stats[0]) + ",\"chain_len\":" + to_string(stats[1]) + ",\"bonus_pct\":" + to_string(stats[2]) + ",\"skill_invested\":" + to_string(stats[3]) + ",\"avg_bonus_per_chain\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d2r_class_skill_synergy FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic class skill synergy state machine round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track AK mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic synergy chain state machine 4-phase cycle —
    //     register → resolve → bonus_apply → tally (synergy bonus aggregation):
    //     phase_count               4                   (register/resolve/apply/tally)
    //     synergy_table_off         0x14009A000         (synthetic D2GAME.dll RVA)
    //     synergy_kind              "synthetic_inline"  (실 synergy resolve tick X)
    //
    // (b) synthetic 3-class chain aggregation scaffold —
    //     Sorceress fire (4 skill, 80%) + Paladin aura (3 skill, 60%) +
    //     Druid summon (3 skill, 45%):
    //     class_count               3                   (3 D2R classes registered)
    //     total_chain_len           10                  (4 + 3 + 3)
    //     total_bonus_pct           185                 (80 + 60 + 45)
    //     avg_bonus_per_chain_pct   18                  (185 / 10 int trunc)
    //     agg_kind                  "synthetic_inline"  (실 class log lookup X)
    //
    // round-trip = synthesize_synergy_phase(scaffold) → walk_chain_aggregation(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll synergy bonus tick 0,
    //              real class skill resolve 0.
    //
    // synthetic synergy phase emit
    r0_emit("c_d2r_class_skill_synergy_synthetic_phase",
        "\"stage\":\"synergy_phase\",\"phase_count\":4,\"synergy_table_off\":\"0x14009A000\",\"synergy_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_SYNERGY__ PARTIAL synergy_phase")

    // synthetic chain aggregation emit
    r0_emit("c_d2r_class_skill_synergy_synthetic_aggregation",
        "\"stage\":\"chain_aggregation\",\"class_count\":3,\"total_chain_len\":10,\"total_bonus_pct\":185,\"avg_bonus_per_chain_pct\":18,\"agg_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_SYNERGY__ PARTIAL chain_aggregation")

    cleanup_dcss()

    println("  ✅ c_d2r_class_skill_synergy self_test PASS (3 classes, chain_len=10, bonus_pct=185, skill_invested=185, avg=18, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dcss_stats()
            println("classes=" + to_string(s[0]) + " chain_len=" + to_string(s[1]) + " bonus_pct=" + to_string(s[2]) + " skill_invested=" + to_string(s[3]))
            return
        }
        if sub == "bonus" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                let bp = class_bonus_pct(cid)
                println(to_string(bp))
                return
            }
        }
        if sub == "cleanup" { cleanup_dcss(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_class_skill_synergy.hexa { self-test | stats | bonus <class_id> | cleanup }")
}
