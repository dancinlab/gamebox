// lib/perf/c_agi_integration.hexa — CN-17 PSB-3 sketch (만점 15/15)
//
// gamebox forge ring → airgenome MAIN harvest 정합.
// 게임 워크로드를 airgenome 의 새로운 sub-genome 으로 통합.
// 효과: gamebox 가 "gamebox closure" 외에도 "airgenome MAIN closure" 에 기여.
//
// 무기: harvest_integ 확장 + airgenome MAIN 트랙 연결 + 60-byte 게놈 통합.
//
// own 1 + own 2 mandate.
// own 2 invariant 2 (모듈 끼리 import 금지) 정합 — 우리는 ring file 만 작성,
// airgenome harvest 가 흡수 (외부 의존성 X).

use "./r0_common"

let AGI_DIR = GAMEBOX_HOME + "/persist/agi_integration"
let GAMEBOX_FORGE = GAMEBOX_HOME + "/forge"
let AIRGENOME_FORGE = HOME + "/core/airgenome/forge"
let MAIN_RING = AGI_DIR + "/gamebox_main.ring"
let MAPPING_PATH = AGI_DIR + "/main_mapping.tsv"

fn agi_dir() -> str { return AGI_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + AGI_DIR + "'")
}

// ─── gamebox forge ring → airgenome 60-byte hexagon mapping ───
//   gamebox 의 다양한 schema (frame, heap, PSO 등) → airgenome 의 6축 (CPU/RAM/GPU/NPU/Power/IO)
fn install_main_mapping() -> void {
    ensure_dir()
    let _rm = exec("rm -f '" + MAPPING_PATH + "'")
    let m = ""
    // gamebox component → airgenome 6축
    m = m + "frametime\tgpu_ms,cpu_ms\tGPU,CPU\n"
    m = m + "heap\ttex_active_mb,buf_active_mb\tRAM,RAM\n"
    m = m + "pso\tcompile_count\tCPU\n"
    m = m + "frame_cmd\tdraw_count,state_chg\tCPU,GPU\n"
    m = m + "shader_aging\tage_bucket\tIO\n"
    m = m + "input_latency\tlatency_us\tIO\n"
    m = m + "audio_dsp\tcpu_cost_us\tCPU\n"
    write_file(MAPPING_PATH, m)
}

// ─── 단일 gamebox component value → 6축 (60 byte) 게놈 변환 ───
//   axis: CPU=0, RAM=1, GPU=2, NPU=3, Power=4, IO=5
fn map_to_airgenome_axes(component: str, value: int) -> array {
    // 각 6축 = 0~100 byte (가정 — 실제 airgenome core 는 60 byte 6 dim)
    let axes = [0, 0, 0, 0, 0, 0]
    if component == "frametime" || component == "frame_cmd" {
        axes[2] = value  // GPU
    }
    if component == "heap" {
        axes[1] = value  // RAM
    }
    if component == "pso" {
        axes[0] = value  // CPU
    }
    if component == "shader_aging" || component == "input_latency" {
        axes[5] = value  // IO
    }
    if component == "audio_dsp" {
        axes[0] = value  // CPU
    }
    return axes
}

// ─── 60-byte ring 형식으로 한 줄 작성 ───
//   [ts, component, cpu, ram, gpu, npu, power, io]
fn append_main_genome(component: str, cpu: int, ram: int, gpu: int, npu: int, power: int, io: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"comp\":\"" + component + "\",\"cpu\":" + to_string(cpu) + ",\"ram\":" + to_string(ram) + ",\"gpu\":" + to_string(gpu) + ",\"npu\":" + to_string(npu) + ",\"power\":" + to_string(power) + ",\"io\":" + to_string(io) + "}"
    let tmp = MAIN_RING + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MAIN_RING + "' && rm -f '" + tmp + "'")
    r0_emit("agi_main_genome", "\"comp\":\"" + component + "\",\"axes\":[" + to_string(cpu) + "," + to_string(ram) + "," + to_string(gpu) + "," + to_string(npu) + "," + to_string(power) + "," + to_string(io) + "]")
}

// ─── airgenome MAIN harvest 와 sync ───
//   gamebox forge → airgenome forge 로 ring 파일 복사 (synthetic — 실제로는 airgenome 의
//   modules/harvest.hexa 가 forge/ 디렉토리 흡수)
fn sync_to_airgenome() -> int {
    let exists = exec("test -f '" + MAIN_RING + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    // synthetic — 실제 환경 (airgenome dir 부재) 에서 SKIP
    let ag_exists = exec("test -d '" + AIRGENOME_FORGE + "' && echo ok 2>/dev/null").trim()
    if ag_exists != "ok" {
        r0_emit("agi_sync_skip", "\"reason\":\"airgenome_forge_missing\"")
        return 0
    }
    // sync — gamebox_main.ring 을 airgenome forge 로 복사
    let _cp = exec("cp '" + MAIN_RING + "' '" + AIRGENOME_FORGE + "/gamebox_main.ring' 2>/dev/null && echo ok").trim()
    let count = to_int(exec("wc -l < '" + MAIN_RING + "' | tr -d ' '").trim())
    r0_emit("agi_sync", "\"copied\":" + to_string(count) + ",\"target\":\"" + AIRGENOME_FORGE + "/gamebox_main.ring\"")
    return count
}

// ─── stats ───
fn agi_stats() -> array {
    let exists = exec("test -f '" + MAIN_RING + "' && echo ok").trim()
    let records = 0
    if exists == "ok" {
        records = to_int(exec("wc -l < '" + MAIN_RING + "' | tr -d ' '").trim())
    }
    let exists_m = exec("test -f '" + MAPPING_PATH + "' && echo ok").trim()
    let mappings = 0
    if exists_m == "ok" {
        mappings = to_int(exec("wc -l < '" + MAPPING_PATH + "' | tr -d ' '").trim())
    }
    return [records, mappings]
}

fn cleanup_agi() -> void {
    let _ = exec("rm -rf '" + AGI_DIR + "'")
}

fn self_test() -> void {
    let sid = "agi-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_agi()
    install_main_mapping()

    // 1. mapping 검증
    let m_stats = agi_stats()
    if m_stats[1] != 7 {
        panic("c_agi_integration FAIL [mapping count] expected=7 got=" + to_string(m_stats[1]))
    }

    // 2. axis mapping 검증
    let axes_pso = map_to_airgenome_axes("pso", 50)
    if axes_pso[0] != 50 {
        panic("c_agi_integration FAIL [pso → CPU] expected=50 got=" + to_string(axes_pso[0]))
    }
    let axes_heap = map_to_airgenome_axes("heap", 1024)
    if axes_heap[1] != 1024 {
        panic("c_agi_integration FAIL [heap → RAM] expected=1024 got=" + to_string(axes_heap[1]))
    }
    let axes_frame = map_to_airgenome_axes("frametime", 16)
    if axes_frame[2] != 16 {
        panic("c_agi_integration FAIL [frametime → GPU] expected=16 got=" + to_string(axes_frame[2]))
    }

    // 3. 60-byte genome record (3 components)
    append_main_genome("pso", 80, 0, 0, 0, 0, 0)
    append_main_genome("heap", 0, 1500, 0, 0, 0, 0)
    append_main_genome("frametime", 0, 0, 18, 0, 0, 0)

    let stats = agi_stats()
    if stats[0] != 3 {
        panic("c_agi_integration FAIL [genome records] expected=3 got=" + to_string(stats[0]))
    }

    // 4. sync (airgenome forge 부재 — SKIP)
    let synced = sync_to_airgenome()
    // synced 는 0 또는 3 (airgenome 존재 여부 따라)

    // 5. summary
    r0_emit("agi_summary", "\"records\":" + to_string(stats[0]) + ",\"mappings\":" + to_string(stats[1]) + ",\"synced\":" + to_string(synced))

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_agi_integration FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    cleanup_agi()

    println("  ✅ c_agi_integration self_test PASS (7 mappings, 3 genome records, sync=" + to_string(synced) + ", emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "install" { install_main_mapping(); println("mapping installed"); return }
        if sub == "stats" {
            let s = agi_stats()
            println("records=" + to_string(s[0]) + " mappings=" + to_string(s[1]))
            return
        }
        if sub == "sync" {
            let n = sync_to_airgenome()
            println("synced=" + to_string(n))
            return
        }
        if sub == "cleanup" { cleanup_agi(); println("cleaned"); return }
    }
    println("usage: hexa run c_agi_integration.hexa { self-test | install | stats | sync | cleanup }")
}
