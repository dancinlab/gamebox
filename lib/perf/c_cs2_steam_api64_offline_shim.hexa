// lib/perf/c_cs2_steam_api64_offline_shim.hexa — CN-162 skeleton manjeom 14/15 (B=4 — offline-only)
//
// CS2 (Source 2) Steam-less Goldberg-style steam_api64.dll stub 추적 — CS2 가
// Steam client 없이 offline 실행되려면 `steam_api64.dll` 의 SteamAPI_Init,
// SteamUser_GetSteamID, SteamUtils_GetAppID 등 함수 stub 필요 (Goldberg
// emulator 패턴). 각 stub 의 call_count + 반환값 + elapsed 추적. multiplayer
// 거부 directive 정합 (offline only). 만점 14/15 (B=4 — offline-only).
//
// 무기: api × call_count × stub_returned × elapsed_us 4-key 로그.
// 효과: Steam-less offline launch 정량화 — Elden Ring (CN-Z3 후속) 등 다른
// Steam 의존 게임 generic 흡수 가능.

use "./r0_common"

let CSAOS_DIR = GAMEBOX_HOME + "/persist/cs2_steam_api64_offline_shim"
let API_LOG = CSAOS_DIR + "/apis.tsv"

fn csaos_dir() -> str { return CSAOS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CSAOS_DIR + "'")
}

// ─── api 등록 ───
//   api_id (SteamAPI_Init / SteamUser_GetSteamID / SteamUtils_GetAppID 등 hash),
//   call_count (이 api 누적 호출 횟수),
//   stub_returned (0=stub_returned_default, 1=stub_returned_synthetic),
//   elapsed_us (이 api 누적 elapsed micro-seconds).
fn record_api(api_id: int, call_count: int, stub_returned: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(api_id) + "\t" + to_string(call_count) + "\t" + to_string(stub_returned) + "\t" + to_string(elapsed_us)
    let tmp = API_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + API_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("cs2_steam_api64_record", "\"api\":" + to_string(api_id) + ",\"calls\":" + to_string(call_count) + ",\"synthetic\":" + to_string(stub_returned) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── api_count — 등록된 api 행 수 ───
fn api_count() -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + API_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_calls — 모든 api call_count 합 ───
fn total_calls() -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_elapsed_us — 모든 api elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── synthetic_returned_count — stub_returned==1 인 api 수 ───
fn synthetic_returned_count() -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==1 {c+=1} END{print c+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_elapsed_per_call_ns — (total_elapsed_us * 1000) / total_calls ───
//   us → ns 단위 환산 후 call 수로 나눔. total_calls 0 이면 0 (divide-by-zero guard).
fn avg_elapsed_per_call_ns() -> int {
    let tc = total_calls()
    if tc == 0 { return 0 }
    let te = total_elapsed_us()
    return (te * 1000) / tc
}

// ─── api_calls — 특정 api_id 의 call_count 합 ───
//   미등록 api_id 면 0 반환.
fn api_calls(api_id: int) -> int {
    let exists = exec("test -f '" + API_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(api_id) + " '$1==a {s+=$2} END{print s+0}' '" + API_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── csaos_stats — [api_count, total_calls, total_elapsed_us, synthetic_returned_count] ───
fn csaos_stats() -> array {
    return [api_count(), total_calls(), total_elapsed_us(), synthetic_returned_count()]
}

fn cleanup_csaos() -> void {
    let _ = exec("rm -rf '" + CSAOS_DIR + "'")
}

fn self_test() -> void {
    let sid = "csaos-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_csaos()

    // 합성 api 3 종 (Goldberg-style steam_api64.dll stub):
    //   SteamAPI_Init        (id=16001) — 1 call    / synthetic / 240 us
    //   SteamUser_GetSteamID (id=16002) — 480 calls / synthetic / 1440 us
    //   SteamUtils_GetAppID  (id=16003) — 240 calls / default   / 480 us
    record_api(16001, 1, 1, 240)
    record_api(16002, 480, 1, 1440)
    record_api(16003, 240, 0, 480)

    // api_count = 3
    let ac = api_count()
    if ac != 3 { panic("c_cs2_steam_api64_offline_shim FAIL [api_count] expected=3 got=" + to_string(ac)) }

    // total_calls = 1+480+240 = 721
    let tc = total_calls()
    if tc != 721 { panic("c_cs2_steam_api64_offline_shim FAIL [total_calls] expected=721 got=" + to_string(tc)) }

    // total_elapsed_us = 240+1440+480 = 2160
    let te = total_elapsed_us()
    if te != 2160 { panic("c_cs2_steam_api64_offline_shim FAIL [total_elapsed_us] expected=2160 got=" + to_string(te)) }

    // synthetic_returned_count = 2 (16001 + 16002)
    let sr = synthetic_returned_count()
    if sr != 2 { panic("c_cs2_steam_api64_offline_shim FAIL [synthetic_returned_count] expected=2 got=" + to_string(sr)) }

    // avg_elapsed_per_call_ns = (2160 * 1000) / 721 = 2160000/721 = 2995 (int trunc)
    let avg = avg_elapsed_per_call_ns()
    if avg != 2995 { panic("c_cs2_steam_api64_offline_shim FAIL [avg_ns] expected=2995 got=" + to_string(avg)) }

    // api_calls:
    //   16001 → 1, 16002 → 480, 16003 → 240, 9999 (미등록) → 0
    let c1 = api_calls(16001)
    if c1 != 1 { panic("c_cs2_steam_api64_offline_shim FAIL [calls 16001] expected=1 got=" + to_string(c1)) }
    let c2 = api_calls(16002)
    if c2 != 480 { panic("c_cs2_steam_api64_offline_shim FAIL [calls 16002] expected=480 got=" + to_string(c2)) }
    let c3 = api_calls(16003)
    if c3 != 240 { panic("c_cs2_steam_api64_offline_shim FAIL [calls 16003] expected=240 got=" + to_string(c3)) }
    let c4 = api_calls(9999)
    if c4 != 0 { panic("c_cs2_steam_api64_offline_shim FAIL [calls unknown] expected=0 got=" + to_string(c4)) }

    let stats = csaos_stats()
    if stats[0] != 3 { panic("c_cs2_steam_api64_offline_shim FAIL [stats apis] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 721 { panic("c_cs2_steam_api64_offline_shim FAIL [stats total_calls] expected=721 got=" + to_string(stats[1])) }
    if stats[2] != 2160 { panic("c_cs2_steam_api64_offline_shim FAIL [stats total_elapsed_us] expected=2160 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_cs2_steam_api64_offline_shim FAIL [stats synthetic] expected=2 got=" + to_string(stats[3])) }

    r0_emit("cs2_steam_api64_summary", "\"apis\":" + to_string(stats[0]) + ",\"total_calls\":" + to_string(stats[1]) + ",\"total_elapsed_us\":" + to_string(stats[2]) + ",\"synthetic\":" + to_string(stats[3]) + ",\"avg_ns\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_cs2_steam_api64_offline_shim FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic CS2 Steam API 64 offline shim retired_intentional posture annotation (Track AT) ───
    // Track AT mission: annotate ALL 3 c_cs2_*.hexa perf modules with RETIRED_INTENTIONAL
    // posture, mirroring Track V/AJ/AL D4 retired_intentional pattern. .roadmap.cs2 blk.1
    // status_enum_adopted = retired_intentional (Track C 4-game adoption 2026-05-03,
    // vac_anticheat). 본 module 측 Goldberg-style steam_api64.dll stub tracker =
    // synthetic Steam-less offline analyzer — production live cs2.exe launch 측 Steam
    // ticket detect 우회 측정 X (own1 Wine 0 / NO VAC ticket bypass / NO Steam online
    // ticket forge, online ticket 우회 X 정책). 본 cycle module self_test() honest
    // annotation row 추가 only — cs2.cond.1 status `partial` 영구 유지 (retired_
    // intentional posture per blk.1 영구 lock; vac_anticheat 영구 외부 boundary).
    // pattern reference:
    //     lib/perf/c_d4_aspect_imprint_track.hexa (Track AL predecessor, schema adapted
    //     from always_online_drm to vac_anticheat blocker class)
    // synthetic posture row column header:
    //     domain                "steam_api64_offline_shim"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live cs2.exe launch / no Steam ticket forge)
    //     vac_bypass            "0"                    (own1 Wine 0 / no AC circumvention)
    //     anti_cheat_evade      "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "cs2.blk.1"            (vac_anticheat)
    //     adoption_iso          "2026-05-03"           (Track C retired_intentional adopt)
    r0_emit("c_cs2_steam_api64_offline_shim_retired_intentional",
        "\"stage\":\"cs2_steam_api64_synthetic\",\"domain\":\"steam_api64_offline_shim\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"vac_bypass\":0,\"anti_cheat_evade\":0,\"blocker_ref\":\"cs2.blk.1\",\"blocker_class\":\"vac_anticheat\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"cs2.cond.1\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__CS2_LAUNCH__ RETIRED_INTENTIONAL cs2_steam_api64_synthetic")

    cleanup_csaos()

    println("  ✅ c_cs2_steam_api64_offline_shim self_test PASS (3 apis, 721 calls, 2160 us, synthetic=2, avg=2995 ns/call, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = csaos_stats()
            println("apis=" + to_string(s[0]) + " total_calls=" + to_string(s[1]) + " total_elapsed_us=" + to_string(s[2]) + " synthetic=" + to_string(s[3]))
            return
        }
        if sub == "calls" {
            if len(a) >= 4 {
                let aid = to_int(a[3])
                let n = api_calls(aid)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_csaos(); println("cleaned"); return }
    }
    println("usage: hexa run c_cs2_steam_api64_offline_shim.hexa { self-test | stats | calls <api_id> | cleanup }")
}
