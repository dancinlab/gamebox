// lib/perf/harvest_integ.hexa — M7 harvest 통합 (multi-schema ring 흡수)
//
// gamebox 의 c_*.hexa 가 작성한 forge/genomes-gptk-*.ring 파일들을 흡수.
// 각 record 는 자기 component 별 axes/rec_bytes 를 헤더에 포함 (자유 schema).
// invariant 1-4 (airgenome) 위반 없음 — gamebox 측만 변경, airgenome core/modules 미수정.
//
// upstream candidate: native readdir + JSON parsing (현재 ls/grep 우회).

use "./r0_common"

let FORGE_DIR = GAMEBOX_HOME + "/forge"

// 단일 ring 파일 흡수 — line 별 component / rec_bytes 추출 + 라인 수 반환
fn ingest_ring(path: str) -> array {
    let _check = exec("test -f '" + path + "' && echo ok").trim()
    if _check != "ok" {
        return ["", 0, 0]
    }
    let line_count_str = exec("wc -l < '" + path + "' | tr -d ' '").trim()
    let line_count = to_int(line_count_str)
    if line_count == 0 {
        return ["", 0, 0]
    }
    // 첫 줄에서 component / rec_bytes 추출
    let first = exec("head -1 '" + path + "'")
    let component = exec("printf '%s' '" + first + "' | grep -oE '\"component\":\"[A-Z_]+\"' | head -1 | sed 's/.*\"component\":\"\\([A-Z_]*\\)\".*/\\1/'").trim()
    let rec_bytes_str = exec("printf '%s' '" + first + "' | grep -oE '\"rec_bytes\":[0-9]+' | head -1 | sed 's/.*://'").trim()
    let rec_bytes = 0
    if rec_bytes_str != "" {
        rec_bytes = to_int(rec_bytes_str)
    }
    return [component, line_count, rec_bytes]
}

// forge 디렉토리 내 모든 *.ring 파일 흡수
fn ingest_all() -> array {
    r0_ensure_dirs()
    let _mk = exec("mkdir -p '" + FORGE_DIR + "'")
    let listing = exec("ls -1 '" + FORGE_DIR + "'/*.ring 2>/dev/null")
    if listing == "" {
        return []
    }
    // line 별 path
    let paths_n_str = exec("printf '%s' '" + listing + "' | grep -c .").trim()
    let paths_n = to_int(paths_n_str)
    let i = 1
    let summaries = []
    while i <= paths_n {
        let path = exec("printf '%s' '" + listing + "' | sed -n '" + to_string(i) + "p'").trim()
        let s = ingest_ring(path)
        if s[0] != "" {
            summaries = summaries + [[path, s[0], s[1], s[2]]]
            r0_emit("ring_ingest", "\"path\":\"" + path + "\",\"component\":\"" + s[0] + "\",\"records\":" + to_string(s[1]) + ",\"rec_bytes\":" + to_string(s[2]))
        }
        i = i + 1
    }
    return summaries
}

// 모든 component 별 record 수 합 (요약)
fn total_records(summaries: array) -> int {
    let total = 0
    let i = 0
    while i < len(summaries) {
        total = total + summaries[i][2]
        i = i + 1
    }
    return total
}

// ─── self-test ───
fn self_test() -> void {
    let sid = "harvest-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 합성 ring 파일들 작성
    let _mk = exec("mkdir -p '" + FORGE_DIR + "'")
    let test_ring_a = FORGE_DIR + "/genomes-gptk-test-a.ring"
    let test_ring_b = FORGE_DIR + "/genomes-gptk-test-b.ring"

    // ring A: component=TESTA, axes=3, rec_bytes=12
    let line_a = "{\"axes\":3,\"rec_bytes\":12,\"component\":\"TESTA\",\"x\":1}\n{\"axes\":3,\"rec_bytes\":12,\"component\":\"TESTA\",\"x\":2}\n"
    write_file(test_ring_a, line_a)

    // ring B: component=TESTB, axes=5, rec_bytes=20
    let line_b = "{\"axes\":5,\"rec_bytes\":20,\"component\":\"TESTB\",\"y\":10}\n{\"axes\":5,\"rec_bytes\":20,\"component\":\"TESTB\",\"y\":20}\n{\"axes\":5,\"rec_bytes\":20,\"component\":\"TESTB\",\"y\":30}\n"
    write_file(test_ring_b, line_b)

    // 1. 단일 ring 흡수
    let s_a = ingest_ring(test_ring_a)
    if s_a[0] != "TESTA" {
        panic("harvest FAIL [ingest A component] expected=TESTA got=" + s_a[0])
    }
    if s_a[1] != 2 {
        panic("harvest FAIL [ingest A count] expected=2 got=" + to_string(s_a[1]))
    }
    if s_a[2] != 12 {
        panic("harvest FAIL [ingest A rec_bytes] expected=12 got=" + to_string(s_a[2]))
    }

    let s_b = ingest_ring(test_ring_b)
    if s_b[0] != "TESTB" {
        panic("harvest FAIL [ingest B component] expected=TESTB got=" + s_b[0])
    }
    if s_b[1] != 3 {
        panic("harvest FAIL [ingest B count] expected=3 got=" + to_string(s_b[1]))
    }

    // 2. 전체 흡수 — 우리 ring 2 + 기존에 다른 c_*.hexa 의 ring 도 있을 수 있음 (≥ 2)
    let all = ingest_all()
    if len(all) < 2 {
        panic("harvest FAIL [ingest_all count] expected>=2 got=" + to_string(len(all)))
    }

    // 3. cleanup
    let _rm = exec("rm -f '" + test_ring_a + "' '" + test_ring_b + "'")

    println("  ✅ harvest_integ self_test PASS (2 test rings + total_all=" + to_string(len(all)) + " ingested, sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "all" {
            let s = ingest_all()
            println("ingested rings: " + to_string(len(s)))
            return
        }
    }
    println("usage: hexa run harvest_integ.hexa { self-test | all }")
}
