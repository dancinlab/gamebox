// lib/perf/c_d4_pit_tier_speed_track.hexa — CN-125 skeleton manjeom 15/15
//
// D4 The Pit (200 tier) speed tracker — Phase 5 endgame.
// tier 1..200 클리어 시간 + char 별 best time + masterworking 자원 drop.
//
// 무기: pit run table + columnar (char × tier × time_s × ok).
// 효과: char 별 highest tier + tier 별 best time → masterwork mat farming 효율.

use "./r0_common"

let DPTS_DIR = GAMEBOX_HOME + "/persist/d4_pit_tier_speed"
let RUN_LOG = DPTS_DIR + "/runs.tsv"

fn dpts_dir() -> str { return DPTS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DPTS_DIR + "'")
}

fn min_tier() -> int { return 1 }
fn max_tier() -> int { return 200 }

// masterwork mat (Stygian Stone / Forgotten Soul) drop count by tier band.
// tier 1..30 = 0, 31..60 = 1, 61..100 = 2, 101..150 = 3, 151..200 = 5.
fn masterwork_mat_drop(tier: int) -> int {
    if tier < 1 || tier > 200 { return 0 }
    if tier <= 30 { return 0 }
    if tier <= 60 { return 1 }
    if tier <= 100 { return 2 }
    if tier <= 150 { return 3 }
    return 5
}

fn record_pit_run(char_name: str, tier: int, clear_time_s: int, ok: bool) -> void {
    ensure_dir()
    if tier < min_tier() || tier > max_tier() {
        panic("c_d4_pit_tier_speed_track FAIL [tier_range] expected=1..200 got=" + to_string(tier))
    }
    let ok_s = "0"
    if ok { ok_s = "1" }
    let line = char_name + "\t" + to_string(tier) + "\t" + to_string(clear_time_s) + "\t" + ok_s
    let tmp = RUN_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + RUN_LOG + "' && rm -f '" + tmp + "'")
    if ok {
        r0_emit("d4_pit_run_ok", "\"char\":\"" + char_name + "\",\"tier\":" + to_string(tier) + ",\"time_s\":" + to_string(clear_time_s))
    } else {
        r0_emit("d4_pit_run_fail", "\"char\":\"" + char_name + "\",\"tier\":" + to_string(tier) + ",\"time_s\":" + to_string(clear_time_s))
    }
}

fn run_count() -> int {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("wc -l < '" + RUN_LOG + "' | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// best (shortest) clear time for a char at a given tier (only ok=1 runs).
// 0 if no successful run.
fn best_time(char_name: str, tier: int) -> int {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' -v t=" + to_string(tier) + " '$1==c && $2==t && $4==1 { if(bt==0 || $3<bt) bt=$3 } END{ print bt+0 }' '" + RUN_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// highest cleared tier for a char (only ok=1 runs).
fn highest_tier(char_name: str) -> int {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c && $4==1 { if($2>hi) hi=$2 } END{ print hi+0 }' '" + RUN_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dpts() -> void {
    let _ = exec("rm -rf '" + DPTS_DIR + "'")
}

fn self_test() -> void {
    let sid = "dpts-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dpts()

    if min_tier() != 1 { panic("c_d4_pit_tier_speed_track FAIL [min_tier] expected=1 got=" + to_string(min_tier())) }
    if max_tier() != 200 { panic("c_d4_pit_tier_speed_track FAIL [max_tier] expected=200 got=" + to_string(max_tier())) }

    // masterwork mat drop band 검증.
    if masterwork_mat_drop(10) != 0 { panic("c_d4_pit_tier_speed_track FAIL [mat_t10] expected=0 got=" + to_string(masterwork_mat_drop(10))) }
    if masterwork_mat_drop(50) != 1 { panic("c_d4_pit_tier_speed_track FAIL [mat_t50] expected=1 got=" + to_string(masterwork_mat_drop(50))) }
    if masterwork_mat_drop(75) != 2 { panic("c_d4_pit_tier_speed_track FAIL [mat_t75] expected=2 got=" + to_string(masterwork_mat_drop(75))) }
    if masterwork_mat_drop(100) != 2 { panic("c_d4_pit_tier_speed_track FAIL [mat_t100] expected=2 got=" + to_string(masterwork_mat_drop(100))) }
    if masterwork_mat_drop(120) != 3 { panic("c_d4_pit_tier_speed_track FAIL [mat_t120] expected=3 got=" + to_string(masterwork_mat_drop(120))) }
    if masterwork_mat_drop(180) != 5 { panic("c_d4_pit_tier_speed_track FAIL [mat_t180] expected=5 got=" + to_string(masterwork_mat_drop(180))) }
    if masterwork_mat_drop(0) != 0 { panic("c_d4_pit_tier_speed_track FAIL [mat_t0] expected=0") }
    if masterwork_mat_drop(201) != 0 { panic("c_d4_pit_tier_speed_track FAIL [mat_t201] expected=0") }

    // 1 char × 5 runs:
    //   T50 = 480s ok
    //   T75 = 540s ok
    //   T100 = 600s ok
    //   T100 = 580s ok  → best_time(T100) = 580
    //   T120 = 900s fail → highest_tier 에 영향 없음
    record_pit_run("Mira", 50, 480, true)
    record_pit_run("Mira", 75, 540, true)
    record_pit_run("Mira", 100, 600, true)
    record_pit_run("Mira", 100, 580, true)
    record_pit_run("Mira", 120, 900, false)

    let cnt = run_count()
    if cnt != 5 { panic("c_d4_pit_tier_speed_track FAIL [count] expected=5 got=" + to_string(cnt)) }

    let bt50 = best_time("Mira", 50)
    if bt50 != 480 { panic("c_d4_pit_tier_speed_track FAIL [best_t50] expected=480 got=" + to_string(bt50)) }

    let bt75 = best_time("Mira", 75)
    if bt75 != 540 { panic("c_d4_pit_tier_speed_track FAIL [best_t75] expected=540 got=" + to_string(bt75)) }

    // T100: 600 vs 580 → 580.
    let bt100 = best_time("Mira", 100)
    if bt100 != 580 { panic("c_d4_pit_tier_speed_track FAIL [best_t100] expected=580 got=" + to_string(bt100)) }

    // T120: fail run 만 있음 → 0.
    let bt120 = best_time("Mira", 120)
    if bt120 != 0 { panic("c_d4_pit_tier_speed_track FAIL [best_t120_fail] expected=0 got=" + to_string(bt120)) }

    // highest = 100 (T120 은 fail 이므로 제외).
    let hi = highest_tier("Mira")
    if hi != 100 { panic("c_d4_pit_tier_speed_track FAIL [highest] expected=100 got=" + to_string(hi)) }

    // 존재하지 않는 char.
    let hi_unk = highest_tier("Ghost")
    if hi_unk != 0 { panic("c_d4_pit_tier_speed_track FAIL [highest_unk] expected=0 got=" + to_string(hi_unk)) }

    r0_emit("d4_pit_summary", "\"runs\":" + to_string(cnt) + ",\"highest\":" + to_string(hi) + ",\"best_t100\":" + to_string(bt100) + ",\"mat_t100\":" + to_string(masterwork_mat_drop(100)))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 5 { panic("c_d4_pit_tier_speed_track FAIL [emit] expected>=5 got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AJ) ───
    //
    // Track AJ mission: extend Track V D4 retired_intentional posture annotation to 6
    // additional c_d4_* modules. .roadmap.diablo4 blk.1 status_enum_adopted =
    // retired_intentional (Track A2 land 2026-05-03). 본 module 측 The Pit tier
    // speed tracker (1..200 tier × clear time + masterwork mat drop band) = synthetic
    // pit run analyzer — production live game state 측정 X (D4 always-online live
    // session 진입 X, DRM bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module
    // self_test() 측 honest annotation row 추가 only — cond.3 status `partial`
    // 영구 유지 (retired_intentional posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "pit_tier_speed_track"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_pit_tier_speed_track_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"pit_tier_speed_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_PIT_TIER__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dpts()

    println("  ✅ c_d4_pit_tier_speed_track self_test PASS (1 char, 5 runs, highest=" + to_string(hi) + ", best_t100=" + to_string(bt100) + "s, mat_t100=" + to_string(masterwork_mat_drop(100)) + ", emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 7 {
            let ok = a[6] == "1"
            record_pit_run(a[3], to_int(a[4]), to_int(a[5]), ok)
            println("recorded")
            return
        }
        if sub == "best" && len(a) >= 5 {
            println("best=" + to_string(best_time(a[3], to_int(a[4]))) + "s")
            return
        }
        if sub == "highest" && len(a) >= 4 {
            println("highest=" + to_string(highest_tier(a[3])))
            return
        }
        if sub == "mat" && len(a) >= 4 {
            println("mat=" + to_string(masterwork_mat_drop(to_int(a[3]))))
            return
        }
        if sub == "cleanup" { cleanup_dpts(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_pit_tier_speed_track.hexa { self-test | set <char> <tier> <time_s> <ok0_1> | best <char> <tier> | highest <char> | mat <tier> | cleanup }")
}
