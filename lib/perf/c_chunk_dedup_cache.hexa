// lib/perf/c_chunk_dedup_cache.hexa — CN-133 skeleton manjeom 15/15
//
// Phase 3 download chunk content-addressed cache — 같은 sha256 chunk 재다운 X.
// Battle.net + Steam 공통 — 동일 콘텐츠 chunk 는 1회만 받고 재사용.
//
// 무기: chunk dedup table (sha, bytes, source) + columnar (sha × source × bytes).
// 효과: 패치/재설치 시 동일 chunk 재다운로드 제거 — bandwidth 절약.

use "./r0_common"

let CCDC_DIR = GAMEBOX_HOME + "/persist/chunk_dedup_cache"
let DEDUP_LOG = CCDC_DIR + "/dedup.tsv"

fn ccdc_dir() -> str { return CCDC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CCDC_DIR + "'")
}

fn record_chunk(sha: str, bytes: int, source: str) -> void {
    ensure_dir()
    let line = sha + "\t" + to_string(bytes) + "\t" + source
    let tmp = DEDUP_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DEDUP_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("chunk_dedup", "\"sha\":\"" + sha + "\",\"bytes\":" + to_string(bytes) + ",\"source\":\"" + source + "\"")
}

fn cache_hit_count() -> int {
    let exists = exec("test -f '" + DEDUP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$3==\"cached\"' '" + DEDUP_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cache_miss_count() -> int {
    let exists = exec("test -f '" + DEDUP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$3==\"downloaded\"' '" + DEDUP_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn hit_rate_pct() -> int {
    let hit = cache_hit_count()
    let miss = cache_miss_count()
    let total = hit + miss
    if total == 0 { return 0 }
    return (hit * 100) / total
}

fn bytes_saved() -> int {
    let exists = exec("test -f '" + DEDUP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$3==\"cached\"{s+=$2} END{print s+0}' '" + DEDUP_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_ccdc() -> void {
    let _ = exec("rm -rf '" + CCDC_DIR + "'")
}

fn self_test() -> void {
    let sid = "ccdc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_ccdc()

    // 10 chunks 등록 — 7 downloaded, 3 cached
    let chunk_size = 4194304   // 4 MB
    let i = 0
    while i < 7 {
        record_chunk("sha_dl_" + to_string(i), chunk_size, "downloaded")
        i = i + 1
    }
    let j = 0
    while j < 3 {
        record_chunk("sha_ca_" + to_string(j), chunk_size, "cached")
        j = j + 1
    }

    let hit = cache_hit_count()
    if hit != 3 { panic("c_chunk_dedup_cache FAIL [hit] expected=3 got=" + to_string(hit)) }

    let miss = cache_miss_count()
    if miss != 7 { panic("c_chunk_dedup_cache FAIL [miss] expected=7 got=" + to_string(miss)) }

    let rate = hit_rate_pct()
    if rate != 30 { panic("c_chunk_dedup_cache FAIL [rate] expected=30 got=" + to_string(rate)) }

    let saved = bytes_saved()
    if saved != 3 * chunk_size { panic("c_chunk_dedup_cache FAIL [saved] expected=" + to_string(3 * chunk_size) + " got=" + to_string(saved)) }

    r0_emit("chunk_dedup_summary", "\"hit\":" + to_string(hit) + ",\"miss\":" + to_string(miss) + ",\"rate\":" + to_string(rate) + ",\"saved\":" + to_string(saved))

    let cnt = r0_session_count(sid)
    if cnt < 10 { panic("c_chunk_dedup_cache FAIL [emit] got=" + to_string(cnt)) }

    cleanup_ccdc()

    println("  ✅ c_chunk_dedup_cache self_test PASS (10 chunks: 7 downloaded + 3 cached, hit_rate=30%, saved=" + to_string(saved) + " bytes, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "chunk" && len(a) >= 6 {
            record_chunk(a[3], to_int(a[4]), a[5])
            println("recorded")
            return
        }
        if sub == "stats" {
            println("hit=" + to_string(cache_hit_count()) + " miss=" + to_string(cache_miss_count()) + " rate=" + to_string(hit_rate_pct()) + "% saved=" + to_string(bytes_saved()))
            return
        }
        if sub == "cleanup" { cleanup_ccdc(); println("cleaned"); return }
    }
    println("usage: hexa run c_chunk_dedup_cache.hexa { self-test | chunk <sha> <bytes> <source> | stats | cleanup }")
}
