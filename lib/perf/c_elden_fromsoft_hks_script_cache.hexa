// lib/perf/c_elden_fromsoft_hks_script_cache.hexa — CN-169 skeleton manjeom 15/15
//
// Elden Ring / FromSoft 자체 엔진의 HKS (Havok Script — Lua 기반 modified)
// game logic 캐시 추적 — boss AI / NPC dialogue / 환경 trigger 등 매 frame
// HKS interpreter 가 bytecode 를 평가한다. script bytecode cache 가 cold
// 상태이면 frame hitch 가 발생 → bytecode_kb / eval_count / cache_hit_count
// 4-key 컬럼 로그로 cache 적중률을 정량화한다. BigWorld Python (CN-167) 과
// 다른 stack (Lua-style) 이며 Sekiro / Nightreign 등 FromSoft 게임에 generic
// 재사용 가능 — 신규 영역.
//
// 무기: script × bytecode_kb × eval_count × cache_hit 4-key columnar log.
// 효과: HKS script cache 적중률 baseline → FromSoft 엔진 game logic 가속.

use "./r0_common"

let EFHSC_DIR = GAMEBOX_HOME + "/persist/elden_fromsoft_hks_script_cache"
let SCRIPT_LOG = EFHSC_DIR + "/scripts.tsv"

fn efhsc_dir() -> str { return EFHSC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + EFHSC_DIR + "'")
}

// ─── HKS script 등록 ───
//   script_id (boss_godrick.hks / npc_finger_maiden.hks 등 logical name hash),
//   bytecode_kb (compiled HKS bytecode 크기 KB),
//   eval_count (interpreter 호출 누적 횟수),
//   cache_hit_count (bytecode cache 적중 횟수 — host 측 측정).
fn record_script(script_id: int, bytecode_kb: int, eval_count: int, cache_hit_count: int) -> void {
    ensure_dir()
    let line = to_string(script_id) + "\t" + to_string(bytecode_kb) + "\t" + to_string(eval_count) + "\t" + to_string(cache_hit_count)
    let tmp = SCRIPT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SCRIPT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("efhsc_record", "\"script\":" + to_string(script_id) + ",\"bytecode_kb\":" + to_string(bytecode_kb) + ",\"evals\":" + to_string(eval_count) + ",\"hits\":" + to_string(cache_hit_count))
}

// ─── script_count — 등록된 HKS script 행 수 ───
fn script_count() -> int {
    let exists = exec("test -f '" + SCRIPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SCRIPT_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_bytecode_kb — 모든 script bytecode_kb 합 ───
fn total_bytecode_kb() -> int {
    let exists = exec("test -f '" + SCRIPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + SCRIPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_evals — 모든 script eval_count 합 ───
fn total_evals() -> int {
    let exists = exec("test -f '" + SCRIPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + SCRIPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_cache_hits — 모든 script cache_hit_count 합 ───
fn total_cache_hits() -> int {
    let exists = exec("test -f '" + SCRIPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + SCRIPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── cache_hit_rate_pct — (total_cache_hits * 100) / total_evals ───
//   eval 0 이면 0 반환 (divide-by-zero guard). int truncation.
fn cache_hit_rate_pct() -> int {
    let te = total_evals()
    if te == 0 { return 0 }
    let th = total_cache_hits()
    return (th * 100) / te
}

// ─── script_bytecode_kb — 특정 script_id 의 bytecode_kb ───
//   미등록 script_id 는 0 반환.
fn script_bytecode_kb(script_id: int) -> int {
    let exists = exec("test -f '" + SCRIPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(script_id) + " '$1==a {s+=$2} END{print s+0}' '" + SCRIPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── efhsc_stats — [script_count, total_bytecode_kb, total_evals, cache_hit_rate_pct] ───
fn efhsc_stats() -> array {
    return [script_count(), total_bytecode_kb(), total_evals(), cache_hit_rate_pct()]
}

fn cleanup_efhsc() -> void {
    let _ = exec("rm -rf '" + EFHSC_DIR + "'")
}

fn self_test() -> void {
    let sid = "efhsc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_efhsc()

    // 합성 HKS scripts 3 종:
    //   boss_godrick.hks (id=23001) — Godrick boss AI / 64 KB / 480 evals / 420 hits
    //   npc_finger_maiden.hks (id=23002) — Finger Maiden / 32 KB / 120 evals / 110 hits
    //   env_grace_check.hks (id=23003) — Site of Grace trigger / 16 KB / 2400 evals / 2380 hits
    record_script(23001, 64, 480, 420)
    record_script(23002, 32, 120, 110)
    record_script(23003, 16, 2400, 2380)

    // script_count = 3
    let sc = script_count()
    if sc != 3 { panic("c_elden_fromsoft_hks_script_cache FAIL [script_count] expected=3 got=" + to_string(sc)) }

    // total_bytecode_kb = 64+32+16 = 112
    let tb = total_bytecode_kb()
    if tb != 112 { panic("c_elden_fromsoft_hks_script_cache FAIL [total_bytecode_kb] expected=112 got=" + to_string(tb)) }

    // total_evals = 480+120+2400 = 3000
    let te = total_evals()
    if te != 3000 { panic("c_elden_fromsoft_hks_script_cache FAIL [total_evals] expected=3000 got=" + to_string(te)) }

    // total_cache_hits = 420+110+2380 = 2910
    let th = total_cache_hits()
    if th != 2910 { panic("c_elden_fromsoft_hks_script_cache FAIL [total_cache_hits] expected=2910 got=" + to_string(th)) }

    // cache_hit_rate_pct = (2910 * 100) / 3000 = 291000/3000 = 97 (int trunc)
    let hr = cache_hit_rate_pct()
    if hr != 97 { panic("c_elden_fromsoft_hks_script_cache FAIL [cache_hit_rate_pct] expected=97 got=" + to_string(hr)) }

    // script_bytecode_kb 개별 조회
    let b1 = script_bytecode_kb(23001)
    if b1 != 64 { panic("c_elden_fromsoft_hks_script_cache FAIL [bytecode 23001] expected=64 got=" + to_string(b1)) }
    let b2 = script_bytecode_kb(23002)
    if b2 != 32 { panic("c_elden_fromsoft_hks_script_cache FAIL [bytecode 23002] expected=32 got=" + to_string(b2)) }
    let b3 = script_bytecode_kb(23003)
    if b3 != 16 { panic("c_elden_fromsoft_hks_script_cache FAIL [bytecode 23003] expected=16 got=" + to_string(b3)) }
    // 미등록 script_id 는 0
    let b4 = script_bytecode_kb(9999)
    if b4 != 0 { panic("c_elden_fromsoft_hks_script_cache FAIL [bytecode unknown] expected=0 got=" + to_string(b4)) }

    let stats = efhsc_stats()
    if stats[0] != 3 { panic("c_elden_fromsoft_hks_script_cache FAIL [stats scripts] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 112 { panic("c_elden_fromsoft_hks_script_cache FAIL [stats bytecode_kb] expected=112 got=" + to_string(stats[1])) }
    if stats[2] != 3000 { panic("c_elden_fromsoft_hks_script_cache FAIL [stats evals] expected=3000 got=" + to_string(stats[2])) }
    if stats[3] != 97 { panic("c_elden_fromsoft_hks_script_cache FAIL [stats hit_rate] expected=97 got=" + to_string(stats[3])) }

    r0_emit("efhsc_summary", "\"scripts\":" + to_string(stats[0]) + ",\"bytecode_kb\":" + to_string(stats[1]) + ",\"evals\":" + to_string(stats[2]) + ",\"hit_rate_pct\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_elden_fromsoft_hks_script_cache FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic Elden Ring retired_intentional posture annotation (Track AS) ───
    //
    // Track AS mission: Elden Ring blk.1 retired_intentional posture annotation
    // (mirror D4 Track V/AJ/AL pattern, EAC anti-tamper class). .roadmap.elden_ring
    // blk.1 status_enum_adopted = retired_intentional (block-acknowledged =
    // PASS-equivalent posture, own1 Wine 0 + own2 honest emit, no AC bypass / no
    // anti-tamper bypass). 본 module 측 FromSoftware Havok Script (HKS) bytecode
    // cache 4-key trace (script × bytecode × eval × hit) = synthetic — FromSoft
    // engine 핵심 surface 측 live game session X (EAC kernel driver block
    // transitive). cond.2 status `partial` 영구 유지 (retired_intentional posture
    // per blk.1 영구 lock).
    // pattern reference:
    //     lib/perf/c_d4_dxr_first_frame_trace.hexa (Track AL predecessor, schema mirror)
    //
    // synthetic posture row column header:
    //     domain                "fromsoft_hks_script_cache"
    //     posture               "retired_intentional"
    //     production_smoke      "no_attempt"
    //     drm_bypass            "0"                    (own1 Wine 0)
    //     ac_bypass             "0"                    (own1 honest acknowledgment)
    //     anti_tamper_bypass    "0"                    (EAC anti-tamper boundary)
    //     blocker_ref           "elden_ring.blk.1"     (eac_anti_tamper)
    //     adoption_iso          "2026-05-03"           (Track C 4-game retired_intentional)
    r0_emit("c_elden_fromsoft_hks_script_cache_retired_intentional",
        "\"stage\":\"elden_ring_engine_synthetic\",\"domain\":\"fromsoft_hks_script_cache\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"ac_bypass\":0,\"anti_tamper_bypass\":0,\"blocker_ref\":\"elden_ring.blk.1\",\"blocker_class\":\"eac_anti_tamper\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"elden_ring.cond.2\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__ELDEN_HKS_SCRIPT_CACHE__ RETIRED_INTENTIONAL elden_ring_engine_synthetic")

    cleanup_efhsc()

    println("  ✅ c_elden_fromsoft_hks_script_cache self_test PASS (3 scripts, 112 KB bytecode, 3000 evals, hit_rate=97%, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = efhsc_stats()
            println("scripts=" + to_string(s[0]) + " bytecode_kb=" + to_string(s[1]) + " evals=" + to_string(s[2]) + " hit_rate_pct=" + to_string(s[3]))
            return
        }
        if sub == "bytecode" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                let kb = script_bytecode_kb(sid)
                println(to_string(kb))
                return
            }
        }
        if sub == "cleanup" { cleanup_efhsc(); println("cleaned"); return }
    }
    println("usage: hexa run c_elden_fromsoft_hks_script_cache.hexa { self-test | stats | bytecode <script_id> | cleanup }")
}
