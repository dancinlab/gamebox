// lib/perf/c_lineage_classic_r28_native_first_frame.hexa — CN-154 skeleton manjeom 15/15
//
// 리니지 클래식 r28 (NCSOFT 신작 2026-02-07) first frame trace — Win64 PE +
// OpenGL 4.3 native. 본 r28 은 1998 원판이 아닌 NCSOFT 2026 신작으로 Windows
// 10/11 64bit + OpenGL 4.3+ + 16GB RAM 권장 사양. closure path B 직접 적용
// 가능 (PURPLE STORE 통해 Windows native PE 다운로드). cold/warm/hot frame
// 별 OpenGL context init + GL state setup + first draw 시간 추적으로 cold
// launch 비용 정량화.
//
// 무기: frame × opengl_init × glcontext × first_draw 4-key columnar log.
// 효과: L Classic r28 cold-launch latency 정량화 → Apple Metal 변환
// (OpenGL → Metal Translation Layer Apple 자체 path) 가능성 평가 baseline.

use "./r0_common"

let LCRNFF_DIR = GAMEBOX_HOME + "/persist/lineage_classic_r28_native_first_frame"
let FRAME_LOG = LCRNFF_DIR + "/frames.tsv"

fn lcrnff_dir() -> str { return LCRNFF_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + LCRNFF_DIR + "'")
}

// ─── frame 등록 ───
//   frame_id (cold/warm/hot 시나리오 구분 id),
//   opengl_init_us (OpenGL context 생성 + extension probe us),
//   glcontext_us (GL state setup — VAO/program/uniform bind us),
//   first_draw_us (첫 glDrawElements / SwapBuffers us).
fn record_frame(frame_id: int, opengl_init_us: int, glcontext_us: int, first_draw_us: int) -> void {
    ensure_dir()
    let line = to_string(frame_id) + "\t" + to_string(opengl_init_us) + "\t" + to_string(glcontext_us) + "\t" + to_string(first_draw_us)
    let tmp = FRAME_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + FRAME_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("lcrnff_record", "\"frame\":" + to_string(frame_id) + ",\"opengl_init_us\":" + to_string(opengl_init_us) + ",\"glcontext_us\":" + to_string(glcontext_us) + ",\"first_draw_us\":" + to_string(first_draw_us))
}

// ─── frame_count — 등록된 frame 행 수 ───
fn frame_count() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + FRAME_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_opengl_init_us — 모든 frame opengl_init 합 ───
fn total_opengl_init_us() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_glcontext_us — 모든 frame glcontext 합 ───
fn total_glcontext_us() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_first_draw_us — 모든 frame first_draw 합 ───
fn total_first_draw_us() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_first_draw_us — total_first_draw / frame_count ───
//   frame_count 0 이면 0 반환 (divide-by-zero guard).
fn avg_first_draw_us() -> int {
    let fc = frame_count()
    if fc == 0 { return 0 }
    let tf = total_first_draw_us()
    return tf / fc
}

// ─── frame_total_us — 특정 frame_id 의 opengl_init + glcontext + first_draw ───
//   frame_id 미등록이면 0.
fn frame_total_us(frame_id: int) -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v f=" + to_string(frame_id) + " '$1==f {s+=$2+$3+$4} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── lcrnff_stats — [frame_count, total_opengl_init_us, total_glcontext_us, total_first_draw_us] ───
fn lcrnff_stats() -> array {
    return [frame_count(), total_opengl_init_us(), total_glcontext_us(), total_first_draw_us()]
}

fn cleanup_lcrnff() -> void {
    let _ = exec("rm -rf '" + LCRNFF_DIR + "'")
}

fn self_test() -> void {
    let sid = "lcrnff-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_lcrnff()

    // 합성 frame 3 종:
    //   frame 8001 (cold, 첫 launch)        — opengl_init 180000 us / glcontext 85000 us / first_draw 42000 us
    //   frame 8002 (warm, GL cache)         — opengl_init 64000 us  / glcontext 28000 us / first_draw 18000 us
    //   frame 8003 (hot, 동일 character)    — opengl_init 24000 us  / glcontext 12000 us / first_draw 8000 us
    record_frame(8001, 180000, 85000, 42000)
    record_frame(8002, 64000, 28000, 18000)
    record_frame(8003, 24000, 12000, 8000)

    // frame_count = 3
    let fc = frame_count()
    if fc != 3 { panic("c_lineage_classic_r28_native_first_frame FAIL [frame_count] expected=3 got=" + to_string(fc)) }

    // total_opengl_init_us = 180000+64000+24000 = 268000
    let toi = total_opengl_init_us()
    if toi != 268000 { panic("c_lineage_classic_r28_native_first_frame FAIL [total_opengl_init_us] expected=268000 got=" + to_string(toi)) }

    // total_glcontext_us = 85000+28000+12000 = 125000
    let tgc = total_glcontext_us()
    if tgc != 125000 { panic("c_lineage_classic_r28_native_first_frame FAIL [total_glcontext_us] expected=125000 got=" + to_string(tgc)) }

    // total_first_draw_us = 42000+18000+8000 = 68000
    let tfd = total_first_draw_us()
    if tfd != 68000 { panic("c_lineage_classic_r28_native_first_frame FAIL [total_first_draw_us] expected=68000 got=" + to_string(tfd)) }

    // avg_first_draw_us = 68000 / 3 = 22666 (int trunc)
    let avg = avg_first_draw_us()
    if avg != 22666 { panic("c_lineage_classic_r28_native_first_frame FAIL [avg_first_draw_us] expected=22666 got=" + to_string(avg)) }

    // frame_total_us:
    //   8001 cold  = 180000+85000+42000 = 307000
    //   8002 warm  = 64000+28000+18000 = 110000
    //   8003 hot   = 24000+12000+8000 = 44000
    let ft1 = frame_total_us(8001)
    if ft1 != 307000 { panic("c_lineage_classic_r28_native_first_frame FAIL [frame_total 8001] expected=307000 got=" + to_string(ft1)) }
    let ft2 = frame_total_us(8002)
    if ft2 != 110000 { panic("c_lineage_classic_r28_native_first_frame FAIL [frame_total 8002] expected=110000 got=" + to_string(ft2)) }
    let ft3 = frame_total_us(8003)
    if ft3 != 44000 { panic("c_lineage_classic_r28_native_first_frame FAIL [frame_total 8003] expected=44000 got=" + to_string(ft3)) }
    // 미등록 frame_id 는 0
    let ft4 = frame_total_us(9999)
    if ft4 != 0 { panic("c_lineage_classic_r28_native_first_frame FAIL [frame_total unknown] expected=0 got=" + to_string(ft4)) }

    let stats = lcrnff_stats()
    if stats[0] != 3 { panic("c_lineage_classic_r28_native_first_frame FAIL [stats frames] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 268000 { panic("c_lineage_classic_r28_native_first_frame FAIL [stats opengl_init] expected=268000 got=" + to_string(stats[1])) }
    if stats[2] != 125000 { panic("c_lineage_classic_r28_native_first_frame FAIL [stats glcontext] expected=125000 got=" + to_string(stats[2])) }
    if stats[3] != 68000 { panic("c_lineage_classic_r28_native_first_frame FAIL [stats first_draw] expected=68000 got=" + to_string(stats[3])) }

    r0_emit("lcrnff_summary", "\"frames\":" + to_string(stats[0]) + ",\"opengl_init_us\":" + to_string(stats[1]) + ",\"glcontext_us\":" + to_string(stats[2]) + ",\"first_draw_us\":" + to_string(stats[3]) + ",\"avg_first_draw_us\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_lineage_classic_r28_native_first_frame FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    cleanup_lcrnff()

    println("  ✅ c_lineage_classic_r28_native_first_frame self_test PASS (3 frames, opengl_init=268000 us, glcontext=125000 us, first_draw=68000 us, avg_first_draw=22666 us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = lcrnff_stats()
            println("frames=" + to_string(s[0]) + " opengl_init_us=" + to_string(s[1]) + " glcontext_us=" + to_string(s[2]) + " first_draw_us=" + to_string(s[3]))
            return
        }
        if sub == "total" {
            if len(a) >= 4 {
                let fid = to_int(a[3])
                let us = frame_total_us(fid)
                println(to_string(us))
                return
            }
        }
        if sub == "cleanup" { cleanup_lcrnff(); println("cleaned"); return }
    }
    println("usage: hexa run c_lineage_classic_r28_native_first_frame.hexa { self-test | stats | total <frame_id> | cleanup }")
}
