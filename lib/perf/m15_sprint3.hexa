// lib/perf/m15_sprint3.hexa — M15 Sprint 3 측정 harness
//
// PERF_PLAN.md § Sprint 3 검증 protocol:
//   M13 (C-SHADER-WARM++) + M14 (C-CORRELATE) + M12 (C-SHADER-SEQ) 통합 활성
//   상태에서 M10 baseline 대비 stutter 추가 5%↓ / multi-anomaly correlation
//   precision ≥ 80% / next-zone prediction accuracy ≥ 70% 게이트.
//
// own 1 (production module) + own 2 (R0 instrumentation emit) — only use r0_common.
// hexa-lang stage1 제약 (try/catch 없음, float 없음, bit-ops 없음) 적용.
//
// % 표현 — stage1 float 부재로 모든 % 는 *deci-percent* (tenths of a percent)
// 정수로 표현.  e.g.  -10.0% → -100,  94.4% → 944,  75.0% → 750.
//
// upstream candidates:
//   - native CSV writer (현재 manual concat)
//   - float % representation (현재 deci-percent int)
//   - native percentile / multi-source label fusion (현재 insertion sort 우회)

use "./r0_common"

let M15_SPRINT3_DIR        = GAMEBOX_HOME + "/sprint3"
let M15_COMPARISON_CSV     = M15_SPRINT3_DIR + "/comparison.csv"
let M15_CSV_HEADER         = "game,scenario,m10_stutter,m13_stutter,m13_delta_dpct,m14_tp,m14_fp,m14_total,m14_precision_dpct,m12_correct,m12_total,m12_acc_dpct,m13_pass,m14_pass,m12_pass"

// gate thresholds (deci-percent)
let M15_M13_TARGET_DPCT     = 0 - 50    // ≤ -5.0%   (M10 대비 stutter 추가 감소)
let M15_M14_TARGET_DPCT     = 800       // ≥ 80.0%   (correlation precision)
let M15_M12_TARGET_DPCT     = 700       // ≥ 70.0%   (next-zone prediction)

// ───────────────────────────────────────────────────────────────────────────
// dir / catalog
// ───────────────────────────────────────────────────────────────────────────

fn sprint3_dir() -> str {
    let _ = exec("mkdir -p '" + M15_SPRINT3_DIR + "'")
    return M15_SPRINT3_DIR + "/"
}

fn comparison_csv_path() -> str {
    return M15_COMPARISON_CSV
}

// ───────────────────────────────────────────────────────────────────────────
// int math helpers
// ───────────────────────────────────────────────────────────────────────────

// abs(int) — stage1 has no Math.abs
fn m15_abs(x: int) -> int {
    if x < 0 { return 0 - x }
    return x
}

// deci-percent delta : (cur - base) / base * 1000  (rounded toward zero)
// base == 0 → 0 (undefined regression skipped)
fn m15_dpct(base: int, cur: int) -> int {
    if base == 0 { return 0 }
    let diff = cur - base
    let neg = false
    if diff < 0 { neg = true diff = 0 - diff }
    let b = base
    if b < 0 { b = 0 - b }
    let r = (diff * 1000) / b
    if neg { r = 0 - r }
    return r
}

// bool→str (stage1)
fn m15_b2s(b: bool) -> str {
    if b { return "true" }
    return "false"
}

// ───────────────────────────────────────────────────────────────────────────
// M13 vs M10 stutter delta
//   m10_stutter : C-SHADER-WARM 만 활성 시 stutter count
//   m13_stutter : C-SHADER-WARM++ 추가 활성 시 stutter count
//   반환: (m13 - m10) / m10 * 1000  (deci-percent)
//   negative → improvement.  Sprint 3 게이트: ≤ -50 (5%+ 추가 감소)
// ───────────────────────────────────────────────────────────────────────────

fn compare_warmpp_vs_warm(m10_stutter: int, m13_stutter: int) -> int {
    if m10_stutter < 0 {
        panic("m15_sprint3 FAIL [compare_warmpp_vs_warm m10<0] m10=" + to_string(m10_stutter))
    }
    if m13_stutter < 0 {
        panic("m15_sprint3 FAIL [compare_warmpp_vs_warm m13<0] m13=" + to_string(m13_stutter))
    }
    return m15_dpct(m10_stutter, m13_stutter)
}

// ───────────────────────────────────────────────────────────────────────────
// M14 correlation accuracy (multi-source label fusion)
//   true_positives  : 정확히 동일 root-cause 로 fuse 된 anomaly cluster 수
//   false_positives : 다른 root-cause 임에도 같은 cluster 로 fuse 된 수
//   total           : 전체 anomaly cluster 수 (parameter validity guard 용)
//   반환: precision% deci-percent — tp / (tp + fp) * 1000
//   tp+fp == 0 → 0 (no positive labels)
// ───────────────────────────────────────────────────────────────────────────

fn measure_correlation_accuracy(true_positives: int, false_positives: int, total: int) -> int {
    if true_positives < 0 {
        panic("m15_sprint3 FAIL [measure_correlation_accuracy tp<0] tp=" + to_string(true_positives))
    }
    if false_positives < 0 {
        panic("m15_sprint3 FAIL [measure_correlation_accuracy fp<0] fp=" + to_string(false_positives))
    }
    if total < 0 {
        panic("m15_sprint3 FAIL [measure_correlation_accuracy total<0] total=" + to_string(total))
    }
    if (true_positives + false_positives) > total {
        panic("m15_sprint3 FAIL [measure_correlation_accuracy tp+fp>total] tp=" + to_string(true_positives)
            + " fp=" + to_string(false_positives) + " total=" + to_string(total))
    }
    let denom = true_positives + false_positives
    if denom == 0 { return 0 }
    return (true_positives * 1000) / denom
}

// ───────────────────────────────────────────────────────────────────────────
// M12 next-zone prediction accuracy
//   correct : sequence model 이 next zone 을 정확히 예측한 횟수
//   total   : 전체 prediction 시도 수
//   반환: accuracy% deci-percent — correct / total * 1000
//   total == 0 → 0
// ───────────────────────────────────────────────────────────────────────────

fn measure_seq_accuracy(correct: int, total: int) -> int {
    if correct < 0 {
        panic("m15_sprint3 FAIL [measure_seq_accuracy correct<0] correct=" + to_string(correct))
    }
    if total < 0 {
        panic("m15_sprint3 FAIL [measure_seq_accuracy total<0] total=" + to_string(total))
    }
    if correct > total {
        panic("m15_sprint3 FAIL [measure_seq_accuracy correct>total] correct=" + to_string(correct)
            + " total=" + to_string(total))
    }
    if total == 0 { return 0 }
    return (correct * 1000) / total
}

// ───────────────────────────────────────────────────────────────────────────
// gate_check_sprint3
//   m13_delta : compare_warmpp_vs_warm 출력 (deci-percent)
//   m14_acc   : measure_correlation_accuracy 출력 (deci-percent)
//   m12_acc   : measure_seq_accuracy 출력 (deci-percent)
//   반환: [m13_pass, m14_pass, m12_pass]  (bool)
//     m13_pass : m13_delta ≤ -50      (5%+ 추가 감소)
//     m14_pass : m14_acc   ≥ 800      (80%+ precision)
//     m12_pass : m12_acc   ≥ 700      (70%+ accuracy)
// ───────────────────────────────────────────────────────────────────────────

fn gate_check_sprint3(m13_delta: int, m14_acc: int, m12_acc: int) -> array {
    let m13_pass = false
    if m13_delta <= M15_M13_TARGET_DPCT { m13_pass = true }

    let m14_pass = false
    if m14_acc >= M15_M14_TARGET_DPCT { m14_pass = true }

    let m12_pass = false
    if m12_acc >= M15_M12_TARGET_DPCT { m12_pass = true }

    return [m13_pass, m14_pass, m12_pass]
}

// ───────────────────────────────────────────────────────────────────────────
// CSV 기록
// ───────────────────────────────────────────────────────────────────────────

fn m15_ensure_csv() -> void {
    let _ = exec("mkdir -p '" + M15_SPRINT3_DIR + "'")
    let exists = exec("test -f '" + M15_COMPARISON_CSV + "' && echo ok").trim()
    if exists != "ok" {
        write_file(M15_COMPARISON_CSV, M15_CSV_HEADER + "\n")
    }
}

// record_comparison_s3
//   results shape (10-tuple):
//     [m10_stutter, m13_stutter, m13_delta_dpct,
//      m14_tp, m14_fp, m14_total, m14_precision_dpct,
//      m12_correct, m12_total, m12_acc_dpct]
fn record_comparison_s3(game: str, scenario: str, results: array) -> void {
    if len(results) != 10 {
        panic("m15_sprint3 FAIL [record_comparison_s3 results shape] expected=10 got=" + to_string(len(results)))
    }
    m15_ensure_csv()
    let m10_stutter         = results[0]
    let m13_stutter         = results[1]
    let m13_delta_dpct      = results[2]
    let m14_tp              = results[3]
    let m14_fp              = results[4]
    let m14_total           = results[5]
    let m14_precision_dpct  = results[6]
    let m12_correct         = results[7]
    let m12_total           = results[8]
    let m12_acc_dpct        = results[9]

    let gate = gate_check_sprint3(m13_delta_dpct, m14_precision_dpct, m12_acc_dpct)
    let row = game + "," + scenario
        + "," + to_string(m10_stutter)
        + "," + to_string(m13_stutter)
        + "," + to_string(m13_delta_dpct)
        + "," + to_string(m14_tp)
        + "," + to_string(m14_fp)
        + "," + to_string(m14_total)
        + "," + to_string(m14_precision_dpct)
        + "," + to_string(m12_correct)
        + "," + to_string(m12_total)
        + "," + to_string(m12_acc_dpct)
        + "," + m15_b2s(gate[0])
        + "," + m15_b2s(gate[1])
        + "," + m15_b2s(gate[2])
        + "\n"
    let tmp = M15_COMPARISON_CSV + ".emit.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + M15_COMPARISON_CSV + "' && rm -f '" + tmp + "'")

    r0_emit("sprint3_m13_delta",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"m10_stutter\":" + to_string(m10_stutter)
        + ",\"m13_stutter\":" + to_string(m13_stutter)
        + ",\"m13_delta_dpct\":" + to_string(m13_delta_dpct)
        + ",\"m13_pass\":" + m15_b2s(gate[0]))

    r0_emit("sprint3_m14_acc",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"tp\":" + to_string(m14_tp)
        + ",\"fp\":" + to_string(m14_fp)
        + ",\"total\":" + to_string(m14_total)
        + ",\"precision_dpct\":" + to_string(m14_precision_dpct)
        + ",\"m14_pass\":" + m15_b2s(gate[1]))

    r0_emit("sprint3_m12_acc",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"correct\":" + to_string(m12_correct)
        + ",\"total\":" + to_string(m12_total)
        + ",\"acc_dpct\":" + to_string(m12_acc_dpct)
        + ",\"m12_pass\":" + m15_b2s(gate[2]))

    r0_emit("sprint3_gate",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"m13_pass\":" + m15_b2s(gate[0])
        + ",\"m14_pass\":" + m15_b2s(gate[1])
        + ",\"m12_pass\":" + m15_b2s(gate[2]))
}

// ───────────────────────────────────────────────────────────────────────────
// run_sprint3_measurement — D2R + D4 5 scenarios sweep (synthetic)
//   각 (game, scenario) 에 대해 합성 stutter / correlation / seq 산출 →
//   record_comparison_s3.  반환: gate 모두 통과한 (game,scenario) 수.
// ───────────────────────────────────────────────────────────────────────────

let M15_LCG_MOD = 2147483648

fn m15_lcg_next(state: int) -> int {
    let s = state
    if s < 0 { s = 0 - s }
    if s < 0 { s = 0 }
    s = s % M15_LCG_MOD
    s = (s * 1664525 + 1013904223) % M15_LCG_MOD
    if s < 0 { s = s + M15_LCG_MOD }
    return s
}

fn run_sprint3_measurement() -> int {
    let games = ["d2r", "d4"]
    let d2r_scn = [
        "campaign_act1",
        "coop_4player",
        "cinematic_intro",
        "character_entry",
        "cold_launch"
    ]
    let d4_scn = [
        "open_world_fractured_peaks",
        "zone_transition",
        "boss_world_boss",
        "kyovashad_city",
        "cold_launch"
    ]
    let pass_cnt = 0
    let i = 0
    while i < len(games) {
        let g = games[i]
        let scn = d2r_scn
        if g == "d4" { scn = d4_scn }
        let j = 0
        while j < len(scn) {
            let sc = scn[j]
            let seed = (i + 1) * 1000 + (j + 1) * 7
            let s = m15_lcg_next(seed)

            // synthetic m10/m13 stutter — m13 always 7~12% lower than m10
            let m10 = 80 + (s % 40)            // 80..119
            s = m15_lcg_next(s)
            let drop = 7 + (s % 6)             // 7..12% drop
            let m13 = m10 - ((m10 * drop) / 100)
            let m13_delta = compare_warmpp_vs_warm(m10, m13)

            // synthetic m14 correlation — tp ~85%, fp ~5%, fn implicit
            s = m15_lcg_next(s)
            let total = 100
            let tp = 80 + (s % 10)             // 80..89
            s = m15_lcg_next(s)
            let fp = 3 + (s % 5)               // 3..7
            let m14_acc = measure_correlation_accuracy(tp, fp, total)

            // synthetic m12 seq — correct ~72..78 / 100
            s = m15_lcg_next(s)
            let correct = 72 + (s % 7)
            let m12_acc = measure_seq_accuracy(correct, total)

            let results = [
                m10, m13, m13_delta,
                tp, fp, total, m14_acc,
                correct, total, m12_acc
            ]
            record_comparison_s3(g, sc, results)
            let gate = gate_check_sprint3(m13_delta, m14_acc, m12_acc)
            if gate[0] && gate[1] && gate[2] {
                pass_cnt = pass_cnt + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    r0_emit("sprint3_sweep_done",
        "\"games\":" + to_string(len(games))
        + ",\"pass_cnt\":" + to_string(pass_cnt))
    return pass_cnt
}

fn sprint3_summary() -> str {
    m15_ensure_csv()
    let s = exec("cat '" + M15_COMPARISON_CSV + "' 2>/dev/null")
    return s
}

// ───────────────────────────────────────────────────────────────────────────
// self_test
// ───────────────────────────────────────────────────────────────────────────

fn self_test() -> void {
    let sid = "m15s3-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. cleanup
    let _mk = exec("mkdir -p '" + M15_SPRINT3_DIR + "'")
    let _rm = exec("rm -f '" + M15_COMPARISON_CSV + "'")
    let dir = sprint3_dir()
    let dir_ok = exec("test -d '" + M15_SPRINT3_DIR + "' && echo ok").trim()
    if dir_ok != "ok" {
        panic("m15_sprint3 FAIL [sprint3_dir] dir not created: " + dir)
    }
    let csv_path = comparison_csv_path()
    if csv_path != M15_COMPARISON_CSV {
        panic("m15_sprint3 FAIL [comparison_csv_path] expected=" + M15_COMPARISON_CSV + " got=" + csv_path)
    }

    // 2. m13_delta = compare_warmpp_vs_warm(100, 90)
    //    → (90-100)/100*1000 = -10000/100 = -100  (-10.0%, > 5% improvement)
    let m13_delta = compare_warmpp_vs_warm(100, 90)
    if m13_delta != 0 - 100 {
        panic("m15_sprint3 FAIL [m13_delta] expected=-100 got=" + to_string(m13_delta))
    }

    // 3. m14_acc = measure_correlation_accuracy(85, 5, 100)
    //    → tp/(tp+fp)*1000 = 85*1000/(85+5) = 85000/90 = 944  (94.4%)
    let m14_acc = measure_correlation_accuracy(85, 5, 100)
    if m14_acc != 944 {
        panic("m15_sprint3 FAIL [m14_acc] expected=944 got=" + to_string(m14_acc))
    }

    // 4. m12_acc = measure_seq_accuracy(75, 100)
    //    → 75*1000/100 = 750  (75.0%)
    let m12_acc = measure_seq_accuracy(75, 100)
    if m12_acc != 750 {
        panic("m15_sprint3 FAIL [m12_acc] expected=750 got=" + to_string(m12_acc))
    }

    // 5. gate = gate_check_sprint3(-100, 944, 750) → [true, true, true]
    let gate = gate_check_sprint3(0 - 100, 944, 750)
    if len(gate) != 3 {
        panic("m15_sprint3 FAIL [gate shape] expected=3 got=" + to_string(len(gate)))
    }
    if !gate[0] {
        panic("m15_sprint3 FAIL [gate m13_pass] expected=true m13_delta=-100 (need ≤ -50)")
    }
    if !gate[1] {
        panic("m15_sprint3 FAIL [gate m14_pass] expected=true m14_acc=944 (need ≥ 800)")
    }
    if !gate[2] {
        panic("m15_sprint3 FAIL [gate m12_pass] expected=true m12_acc=750 (need ≥ 700)")
    }

    // 6. record_comparison_s3 → CSV row + 4 emit (m13/m14/m12/gate)
    let results = [
        100, 90, m13_delta,
        85, 5, 100, m14_acc,
        75, 100, m12_acc
    ]
    record_comparison_s3("d4", "open_world", results)

    // 7. emit ≥ 4 already from record_comparison_s3 (4 emits).  추가 marker 1 개
    r0_emit("sprint3_self_test_marker",
        "\"sid\":\"" + sid + "\",\"phase\":\"after_record\""
        + ",\"m13_delta\":" + to_string(m13_delta)
        + ",\"m14_acc\":" + to_string(m14_acc)
        + ",\"m12_acc\":" + to_string(m12_acc))

    // CSV sanity — header + 1 row, gate columns true,true,true
    let summary = sprint3_summary()
    if summary == "" {
        panic("m15_sprint3 FAIL [summary empty]")
    }
    let line_cnt = to_int(exec("wc -l < '" + M15_COMPARISON_CSV + "' | tr -d ' '").trim())
    if line_cnt < 2 {
        panic("m15_sprint3 FAIL [summary line count] expected>=2 got=" + to_string(line_cnt))
    }
    let header_line = exec("head -1 '" + M15_COMPARISON_CSV + "'").trim()
    if header_line != M15_CSV_HEADER {
        panic("m15_sprint3 FAIL [csv header mismatch] got=" + header_line)
    }
    let gate_field = exec("tail -1 '" + M15_COMPARISON_CSV + "' | awk -F',' '{print $13\",\"$14\",\"$15}'").trim()
    if gate_field != "true,true,true" {
        panic("m15_sprint3 FAIL [csv gate fields] expected=true,true,true got=" + gate_field)
    }

    // 추가 검증 — divide-by-zero guard
    let zero_m13 = compare_warmpp_vs_warm(0, 0)
    if zero_m13 != 0 {
        panic("m15_sprint3 FAIL [m13 zero guard] expected=0 got=" + to_string(zero_m13))
    }
    let zero_m14 = measure_correlation_accuracy(0, 0, 0)
    if zero_m14 != 0 {
        panic("m15_sprint3 FAIL [m14 zero guard] expected=0 got=" + to_string(zero_m14))
    }
    let zero_m12 = measure_seq_accuracy(0, 0)
    if zero_m12 != 0 {
        panic("m15_sprint3 FAIL [m12 zero guard] expected=0 got=" + to_string(zero_m12))
    }

    // 추가 검증 — gate regression (Sprint 3 효과 부족)
    let bad_gate = gate_check_sprint3(0 - 30, 750, 650)
    if bad_gate[0] {
        panic("m15_sprint3 FAIL [gate m13 regression] should fail at -30 dpct (need ≤ -50)")
    }
    if bad_gate[1] {
        panic("m15_sprint3 FAIL [gate m14 regression] should fail at 750 dpct (need ≥ 800)")
    }
    if bad_gate[2] {
        panic("m15_sprint3 FAIL [gate m12 regression] should fail at 650 dpct (need ≥ 700)")
    }

    // 추가 검증 — boundary
    let edge_gate = gate_check_sprint3(0 - 50, 800, 700)
    if !edge_gate[0] {
        panic("m15_sprint3 FAIL [gate m13 edge] -50 dpct must pass (boundary inclusive)")
    }
    if !edge_gate[1] {
        panic("m15_sprint3 FAIL [gate m14 edge] 800 dpct must pass (boundary inclusive)")
    }
    if !edge_gate[2] {
        panic("m15_sprint3 FAIL [gate m12 edge] 700 dpct must pass (boundary inclusive)")
    }

    // emit count check (≥ 4)
    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 4 {
        panic("m15_sprint3 FAIL [emit count<4] got=" + to_string(emit_cnt))
    }

    // 8. cleanup — keep CSV (production artifact); emit count 검증으로 마무리.

    // 9. PASS banner
    println("  ✅ m15_sprint3 self_test PASS (m13 -10%, m14 94.4%, m12 75%, gate all passed, sid=" + sid + ")")
}

// ───────────────────────────────────────────────────────────────────────────
// main — CLI dispatch
// ───────────────────────────────────────────────────────────────────────────

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "dir" {
            println(sprint3_dir())
            return
        }
        if sub == "csv-path" {
            println(comparison_csv_path())
            return
        }
        if sub == "summary" {
            let s = sprint3_summary()
            println(s)
            return
        }
        if sub == "compare-warmpp" {
            // compare-warmpp <m10_stutter> <m13_stutter>
            if len(a) >= 5 {
                let r = compare_warmpp_vs_warm(to_int(a[3]), to_int(a[4]))
                println("m13_delta_dpct=" + to_string(r))
                return
            }
            println("usage: compare-warmpp <m10_stutter> <m13_stutter>")
            return
        }
        if sub == "correlate-acc" {
            // correlate-acc <tp> <fp> <total>
            if len(a) >= 6 {
                let r = measure_correlation_accuracy(to_int(a[3]), to_int(a[4]), to_int(a[5]))
                println("precision_dpct=" + to_string(r))
                return
            }
            println("usage: correlate-acc <tp> <fp> <total>")
            return
        }
        if sub == "seq-acc" {
            // seq-acc <correct> <total>
            if len(a) >= 5 {
                let r = measure_seq_accuracy(to_int(a[3]), to_int(a[4]))
                println("acc_dpct=" + to_string(r))
                return
            }
            println("usage: seq-acc <correct> <total>")
            return
        }
        if sub == "run-sweep" {
            let pass = run_sprint3_measurement()
            println("sprint3 sweep done — pass=" + to_string(pass))
            return
        }
    }
    println("usage: hexa run m15_sprint3.hexa { self-test | dir | csv-path | summary"
        + " | compare-warmpp <m10> <m13> | correlate-acc <tp> <fp> <total>"
        + " | seq-acc <correct> <total> | run-sweep }")
}
