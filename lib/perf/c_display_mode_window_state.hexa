// lib/perf/c_display_mode_window_state.hexa — CN-205 skeleton manjeom 15/15
//
// 창모드 (Windowed) display state machine 추적 — gamebox 의 3-mode display
// 인프라 (창모드 / 전체화면 / PIP) 중 1/3. gamebox 가 게임을 창모드로 실행
// 할 때 NSWindow / CALayer / Metal swap chain 의 state 를 추적한다. 사용자
// directive: "창모드 ↔ 전체화면 ↔ PIP" 3 모드 전환 가능. 본 모듈은 창모드
// 한정으로 window_id × width × height × focus_state 4-key columnar log 와
// 집계 (window_count / total dim / focused_count / per-window dim) 만 담당.
//
// 무기: window × dim_w × dim_h × focus 4-key 컬럼 로그.
// 효과: 창모드 state machine 정량화 — gamebox 의 모든 게임 (D2R / D4 /
// WoT / WoWS / Elden Ring) 에 공통으로 깔리는 창모드 인프라.

use "./r0_common"

let DMWS_DIR = GAMEBOX_HOME + "/persist/display_mode_window_state"
let WINDOW_LOG = DMWS_DIR + "/windows.tsv"

fn dmws_dir() -> str { return DMWS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMWS_DIR + "'")
}

// ─── window 등록 ───
//   window_id (NSWindow id 의 int hash),
//   width / height (창 dimension px),
//   focus_state (0=blur, 1=focused, 2=minimized).
fn record_window(window_id: int, width: int, height: int, focus_state: int) -> void {
    ensure_dir()
    let line = to_string(window_id) + "\t" + to_string(width) + "\t" + to_string(height) + "\t" + to_string(focus_state)
    let tmp = WINDOW_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + WINDOW_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dmws_record", "\"window\":" + to_string(window_id) + ",\"w\":" + to_string(width) + ",\"h\":" + to_string(height) + ",\"focus\":" + to_string(focus_state))
}

// ─── window_count — 등록된 window 행 수 ───
fn window_count() -> int {
    let exists = exec("test -f '" + WINDOW_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + WINDOW_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_width — 모든 window width 합 ───
fn total_width() -> int {
    let exists = exec("test -f '" + WINDOW_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + WINDOW_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_height — 모든 window height 합 ───
fn total_height() -> int {
    let exists = exec("test -f '" + WINDOW_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + WINDOW_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── focused_count — focus_state==1 인 window 수 ───
fn focused_count() -> int {
    return count_by_focus_state(1)
}

// ─── count_by_focus_state — 주어진 focus_state 의 window 수 ───
fn count_by_focus_state(state: int) -> int {
    let exists = exec("test -f '" + WINDOW_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v st=" + to_string(state) + " '$4==st {c++} END{print c+0}' '" + WINDOW_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── window_dimensions — 그 window 의 width × height ───
//   미등록 window_id 는 0.
fn window_dimensions(window_id: int) -> int {
    let exists = exec("test -f '" + WINDOW_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v w=" + to_string(window_id) + " '$1==w {print $2*$3; exit} END{}' '" + WINDOW_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dmws_stats — [window_count, total_width, total_height, focused_count] ───
fn dmws_stats() -> array {
    return [window_count(), total_width(), total_height(), focused_count()]
}

fn cleanup_dmws() -> void {
    let _ = exec("rm -rf '" + DMWS_DIR + "'")
}

fn self_test() -> void {
    let sid = "dmws-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dmws()

    // 합성 window 3 종:
    //   D2R         (id=56001) — 1280 × 720 / focused (1)
    //   D4          (id=56002) — 1920 × 1080 / blurred (0)
    //   Elden Ring  (id=56003) — 2560 × 1440 / minimized (2)
    record_window(56001, 1280, 720, 1)
    record_window(56002, 1920, 1080, 0)
    record_window(56003, 2560, 1440, 2)

    // window_count = 3
    let wc = window_count()
    if wc != 3 { panic("c_display_mode_window_state FAIL [window_count] expected=3 got=" + to_string(wc)) }

    // total_width = 1280+1920+2560 = 5760
    let tw = total_width()
    if tw != 5760 { panic("c_display_mode_window_state FAIL [total_width] expected=5760 got=" + to_string(tw)) }

    // total_height = 720+1080+1440 = 3240
    let th = total_height()
    if th != 3240 { panic("c_display_mode_window_state FAIL [total_height] expected=3240 got=" + to_string(th)) }

    // focused_count = 1 (56001 만 focus_state=1)
    let fc = focused_count()
    if fc != 1 { panic("c_display_mode_window_state FAIL [focused_count] expected=1 got=" + to_string(fc)) }

    // count_by_focus_state — 0/1/2 각각 1, 99 는 0
    let c0 = count_by_focus_state(0)
    if c0 != 1 { panic("c_display_mode_window_state FAIL [count blur] expected=1 got=" + to_string(c0)) }
    let c1 = count_by_focus_state(1)
    if c1 != 1 { panic("c_display_mode_window_state FAIL [count focused] expected=1 got=" + to_string(c1)) }
    let c2 = count_by_focus_state(2)
    if c2 != 1 { panic("c_display_mode_window_state FAIL [count minimized] expected=1 got=" + to_string(c2)) }
    let c99 = count_by_focus_state(99)
    if c99 != 0 { panic("c_display_mode_window_state FAIL [count unknown] expected=0 got=" + to_string(c99)) }

    // window_dimensions:
    //   56001 → 1280 × 720  = 921600
    //   56002 → 1920 × 1080 = 2073600
    //   56003 → 2560 × 1440 = 3686400
    let d1 = window_dimensions(56001)
    if d1 != 921600 { panic("c_display_mode_window_state FAIL [dim 56001] expected=921600 got=" + to_string(d1)) }
    let d2 = window_dimensions(56002)
    if d2 != 2073600 { panic("c_display_mode_window_state FAIL [dim 56002] expected=2073600 got=" + to_string(d2)) }
    let d3 = window_dimensions(56003)
    if d3 != 3686400 { panic("c_display_mode_window_state FAIL [dim 56003] expected=3686400 got=" + to_string(d3)) }
    // 미등록 window_id 는 0
    let d4 = window_dimensions(9999)
    if d4 != 0 { panic("c_display_mode_window_state FAIL [dim unknown] expected=0 got=" + to_string(d4)) }

    let stats = dmws_stats()
    if stats[0] != 3 { panic("c_display_mode_window_state FAIL [stats windows] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 5760 { panic("c_display_mode_window_state FAIL [stats total_w] expected=5760 got=" + to_string(stats[1])) }
    if stats[2] != 3240 { panic("c_display_mode_window_state FAIL [stats total_h] expected=3240 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_display_mode_window_state FAIL [stats focused] expected=1 got=" + to_string(stats[3])) }

    r0_emit("dmws_summary", "\"windows\":" + to_string(stats[0]) + ",\"total_w\":" + to_string(stats[1]) + ",\"total_h\":" + to_string(stats[2]) + ",\"focused\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_display_mode_window_state FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic window state round-trip (Track BJ — d2r cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BJ mission: c_display_* family completion cycle (8/8) — c_display_mode_window_state
    // 측 NSWindow geometry/focus synthetic round-trip. Window state lifecycle
    // (probe_frame → query_focus → snapshot_state → emit_state) 측 spec freeze.
    // Apple-native scaffold only (D3DMetal binary licence transitive — loader_dx blk.1),
    // DX11 swap-chain backbuffer cross-link Metal layer evidence.
    //
    // (a) synthetic 4-phase window state pipeline —
    //     probe_nswindow_frame → query_focused_flag → snapshot_state_record → emit_state_log:
    //     phase_count               4
    //     window_state_off          0x18005C000         (synthetic NSWindow state RVA)
    //     pipeline_kind             "synthetic_inline"  (실 NSWindow.frame 호출 X)
    //
    // (b) synthetic size_class × focus 16-slot state matrix —
    //     4 size_class (s/m/l/xl) × 4 focus_kind (focused/unfocused/minimized/hidden) = 16 slots:
    //     slot_total                16
    //     active_slot_count         8                   (focus_kind focused/unfocused)
    //     inactive_slot_count       8                   (focus_kind minimized/hidden)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_state_phase(scaffold) → walk_state_matrix(scaffold).
    //              hexa-native loop only — 실 NSWindow.isKeyWindow 0,
    //              real frame size mutation 0.
    //
    // synthetic window state phase emit
    r0_emit("c_display_mode_window_state_synthetic_phase",
        "\"stage\":\"window_state_phase\",\"phase_count\":4,\"window_state_off\":\"0x18005C000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_WINDOW__ PARTIAL window_state_phase")

    // synthetic size × focus matrix emit
    r0_emit("c_display_mode_window_state_synthetic_matrix",
        "\"stage\":\"state_matrix\",\"slot_total\":16,\"active_slot_count\":8,\"inactive_slot_count\":8,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_WINDOW__ PARTIAL state_matrix")

    cleanup_dmws()

    println("  ✅ c_display_mode_window_state self_test PASS (3 windows, total=5760x3240, focused=1, dim[56001]=921600, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dmws_stats()
            println("windows=" + to_string(s[0]) + " total_w=" + to_string(s[1]) + " total_h=" + to_string(s[2]) + " focused=" + to_string(s[3]))
            return
        }
        if sub == "dim" {
            if len(a) >= 4 {
                let wid = to_int(a[3])
                let d = window_dimensions(wid)
                println(to_string(d))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let st = to_int(a[3])
                let c = count_by_focus_state(st)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_dmws(); println("cleaned"); return }
    }
    println("usage: hexa run c_display_mode_window_state.hexa { self-test | stats | dim <window_id> | count <focus_state> | cleanup }")
}
