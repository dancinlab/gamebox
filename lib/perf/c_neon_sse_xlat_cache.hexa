// lib/perf/c_neon_sse_xlat_cache.hexa — CN-30 PSB-6 만점 15/15
//
// x86 SSE/AVX → ARM NEON instruction translation cache (Win32 shim level).
// D2R/D4 inline asm/SSE intrinsic 함수 — 동일 SSE pattern 반복 → NEON 변환 cache.
//
// 무기: APBF (SSE pattern dedup) + columnar (NEON instruction histogram).
// 효과: 매 SSE 호출마다 translate 비용 → 1회 + 99회 lookup.

use "./r0_common"

let NSC_DIR = GAMEBOX_HOME + "/persist/neon_sse_xlat_cache"
let CACHE_PATH = NSC_DIR + "/xlat_cache.tsv"
let HIT_HISTORY = NSC_DIR + "/hits.jsonl"

fn nsc_dir() -> str { return NSC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + NSC_DIR + "'")
}

// ─── SSE pattern → NEON translation cache lookup ───
//   sse_hash = SSE 명령 sequence 해시 (예: "SSE2_paddw_movdqa_psrlw_3")
//   neon_seq = ARM NEON 변환 결과 (예: "NEON_addv_ld1q_ushr_3")
fn lookup(sse_hash: str) -> str {
    let exists = exec("test -f '" + CACHE_PATH + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let line = exec("grep -E '^" + sse_hash + "[[:space:]]' '" + CACHE_PATH + "' 2>/dev/null | head -1").trim()
    if line == "" { return "" }
    let parts = line.split("\t")
    if len(parts) < 2 { return "" }
    return parts[1]
}

// ─── store translation ───
fn store(sse_hash: str, neon_seq: str) -> void {
    ensure_dir()
    let existing = lookup(sse_hash)
    if existing != "" { return }  // already cached
    let line = sse_hash + "\t" + neon_seq
    let tmp = CACHE_PATH + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CACHE_PATH + "' && rm -f '" + tmp + "'")
}

// ─── translate (cache 우선, miss → 변환 + store) ───
//   real translation 은 외부 — 여기서는 synthetic (uppercase echo)
fn synthetic_translate(sse_hash: str) -> str {
    return "NEON_" + sse_hash
}

fn translate_cached(sse_hash: str) -> array {
    let hit = lookup(sse_hash)
    if hit != "" {
        record_hit(sse_hash, true)
        return [hit, 1]  // hit
    }
    let neon = synthetic_translate(sse_hash)
    store(sse_hash, neon)
    record_hit(sse_hash, false)
    return [neon, 0]  // miss
}

// ─── hit/miss 기록 ───
fn record_hit(sse_hash: str, is_hit: bool) -> void {
    ensure_dir()
    let h = "false"
    if is_hit { h = "true" }
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"sse\":\"" + sse_hash + "\",\"hit\":" + h + "}"
    let tmp = HIT_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + HIT_HISTORY + "' && rm -f '" + tmp + "'")
}

// ─── hit ratio ───
fn hit_ratio() -> int {
    let exists = exec("test -f '" + HIT_HISTORY + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let total = to_int(exec("wc -l < '" + HIT_HISTORY + "' | tr -d ' '").trim())
    if total == 0 { return 0 }
    let hits = to_int(exec("grep -c '\"hit\":true' '" + HIT_HISTORY + "' 2>/dev/null").trim())
    return hits * 1000 / total
}

fn xlat_stats() -> array {
    let exists_c = exec("test -f '" + CACHE_PATH + "' && echo ok").trim()
    let entries = 0
    if exists_c == "ok" {
        entries = to_int(exec("wc -l < '" + CACHE_PATH + "' | tr -d ' '").trim())
    }
    let exists_h = exec("test -f '" + HIT_HISTORY + "' && echo ok").trim()
    let total = 0
    let hits = 0
    if exists_h == "ok" {
        total = to_int(exec("wc -l < '" + HIT_HISTORY + "' | tr -d ' '").trim())
        let hit_str = exec("grep -c '\"hit\":true' '" + HIT_HISTORY + "' 2>/dev/null").trim()
        if hit_str != "" { hits = to_int(hit_str) }
    }
    return [entries, total, hits]
}

fn cleanup_nsc() -> void {
    let _ = exec("rm -rf '" + NSC_DIR + "'")
}

fn self_test() -> void {
    let sid = "nsc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_nsc()

    // 합성 SSE patterns — 5개 unique, 각 20번 호출 (총 100, miss=5, hit=95)
    let patterns = ["SSE_paddw_movdqa_3", "SSE_psrlw_andpd_8", "SSE_pcmpeqb_4", "SSE_movups_addps_2", "SSE_xorps_subss_5"]
    let i = 0
    while i < 100 {
        let p = patterns[i % 5]
        let _ = translate_cached(p)
        i = i + 1
    }

    // hit ratio — 95% (95 hits / 100 total)
    let ratio = hit_ratio()
    if ratio < 940 {
        panic("c_neon_sse_xlat_cache FAIL [hit ratio] expected>=940 got=" + to_string(ratio))
    }

    // verify lookup works
    let hit = lookup("SSE_paddw_movdqa_3")
    if hit != "NEON_SSE_paddw_movdqa_3" {
        panic("c_neon_sse_xlat_cache FAIL [lookup] expected NEON_SSE_paddw_movdqa_3 got=" + hit)
    }

    // miss case
    let miss = lookup("SSE_unknown_pattern")
    if miss != "" {
        panic("c_neon_sse_xlat_cache FAIL [miss] expected empty got=" + miss)
    }

    // stats
    let stats = xlat_stats()
    if stats[0] != 5 { panic("c_neon_sse_xlat_cache FAIL [stats entries] expected=5 got=" + to_string(stats[0])) }
    if stats[1] != 100 { panic("c_neon_sse_xlat_cache FAIL [stats total] expected=100 got=" + to_string(stats[1])) }
    if stats[2] != 95 { panic("c_neon_sse_xlat_cache FAIL [stats hits] expected=95 got=" + to_string(stats[2])) }

    r0_emit("neon_sse_xlat_summary", "\"entries\":" + to_string(stats[0]) + ",\"total\":" + to_string(stats[1]) + ",\"hits\":" + to_string(stats[2]) + ",\"ratio\":" + to_string(ratio))

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("c_neon_sse_xlat_cache FAIL [emit count] expected>=1 got=" + to_string(cnt)) }

    cleanup_nsc()

    println("  ✅ c_neon_sse_xlat_cache self_test PASS (5 entries, 100 calls, " + to_string(stats[2]) + " hits, ratio " + to_string(ratio) + "‰, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = xlat_stats()
            println("entries=" + to_string(s[0]) + " total=" + to_string(s[1]) + " hits=" + to_string(s[2]))
            return
        }
        if sub == "cleanup" { cleanup_nsc(); println("cleaned"); return }
    }
    println("usage: hexa run c_neon_sse_xlat_cache.hexa { self-test | stats | cleanup }")
}
