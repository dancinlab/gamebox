// lib/perf/c_elden_eac_kernel_driver_avoid_track.hexa — CN-179 skeleton manjeom 15/15
//
// Elden Ring EAC kernel driver (EasyAntiCheat.sys) 부재 환경 추적 — Apple Silicon
// 자연 회피. EAC 는 Windows kernel driver (`EasyAntiCheat.sys`) 가 핵심. macOS
// Apple Silicon 환경에서는 driver 자체 load 불가능 → 게임 process 가 자동으로
// offline mode 진입 (FromSoft 정식 mechanism — `start_game_in_offline_mode.exe`
// 와 동등 효과). own 1 정합 (Wine 0줄, EAC bypass 시도 X — 단순 환경 부재).
//
// 무기: launch × driver_status × game_state × elapsed 4-key 컬럼 로그.
// 효과: EAC kernel driver 부재 시 게임 동작 정량화 — own 1 환경 보호.

use "./r0_common"

let EEKDAT_DIR = GAMEBOX_HOME + "/persist/elden_eac_kernel_driver_avoid_track"
let LAUNCH_LOG = EEKDAT_DIR + "/launches.tsv"

fn eekdat_dir() -> str { return EEKDAT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + EEKDAT_DIR + "'")
}

// ─── launch 등록 ───
//   launch_id (게임 launch sequence id),
//   driver_status (0=absent, 1=loaded, 2=unloaded_post),
//   game_state (1=offline, 2=online_attempt, 3=launch_fail),
//   elapsed_us (launch → state 결정까지 elapsed microseconds).
fn record_launch(launch_id: int, driver_status: int, game_state: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(launch_id) + "\t" + to_string(driver_status) + "\t" + to_string(game_state) + "\t" + to_string(elapsed_us)
    let tmp = LAUNCH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + LAUNCH_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("eekdat_record", "\"launch\":" + to_string(launch_id) + ",\"driver\":" + to_string(driver_status) + ",\"state\":" + to_string(game_state) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── launch_count — 등록된 launch 행 수 ───
fn launch_count() -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + LAUNCH_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── count_by_driver_status — driver_status 컬럼 == status 행 수 ───
fn count_by_driver_status(status: int) -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v v=" + to_string(status) + " '$2==v {c++} END{print c+0}' '" + LAUNCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_game_state — game_state 컬럼 == state 행 수 ───
fn count_by_game_state(state: int) -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v v=" + to_string(state) + " '$3==v {c++} END{print c+0}' '" + LAUNCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_elapsed_us — 모든 launch elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + LAUNCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── offline_mode_count — game_state == 1 (offline) launch 수 ───
fn offline_mode_count() -> int {
    return count_by_game_state(1)
}

// ─── eekdat_stats — [launch_count, count_by_driver_status(0), offline_mode_count, total_elapsed_us] ───
fn eekdat_stats() -> array {
    return [launch_count(), count_by_driver_status(0), offline_mode_count(), total_elapsed_us()]
}

fn cleanup_eekdat() -> void {
    let _ = exec("rm -rf '" + EEKDAT_DIR + "'")
}

fn self_test() -> void {
    let sid = "eekdat-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_eekdat()

    // 합성 launch 4 종 (driver 부재 환경 — Apple Silicon 자연 회피):
    //   launch 34001 — driver absent, offline, 1.80 s
    //   launch 34002 — driver absent, offline, 1.70 s
    //   launch 34003 — driver absent, offline, 1.90 s
    //   launch 34004 — driver absent, offline, 1.75 s
    record_launch(34001, 0, 1, 1800000)
    record_launch(34002, 0, 1, 1700000)
    record_launch(34003, 0, 1, 1900000)
    record_launch(34004, 0, 1, 1750000)

    // launch_count = 4
    let lc = launch_count()
    if lc != 4 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [launch_count] expected=4 got=" + to_string(lc)) }

    // count_by_driver_status: 0=4 (모두 absent), 1=0, 2=0
    let d0 = count_by_driver_status(0)
    if d0 != 4 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [driver_status 0] expected=4 got=" + to_string(d0)) }
    let d1 = count_by_driver_status(1)
    if d1 != 0 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [driver_status 1] expected=0 got=" + to_string(d1)) }
    let d2 = count_by_driver_status(2)
    if d2 != 0 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [driver_status 2] expected=0 got=" + to_string(d2)) }

    // count_by_game_state: 1=4 (모두 offline), 2=0, 3=0
    let g1 = count_by_game_state(1)
    if g1 != 4 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [game_state 1] expected=4 got=" + to_string(g1)) }
    let g2 = count_by_game_state(2)
    if g2 != 0 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [game_state 2] expected=0 got=" + to_string(g2)) }
    let g3 = count_by_game_state(3)
    if g3 != 0 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [game_state 3] expected=0 got=" + to_string(g3)) }

    // offline_mode_count = 4
    let omc = offline_mode_count()
    if omc != 4 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [offline_mode_count] expected=4 got=" + to_string(omc)) }

    // total_elapsed_us = 1800000+1700000+1900000+1750000 = 7150000
    let te = total_elapsed_us()
    if te != 7150000 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [total_elapsed_us] expected=7150000 got=" + to_string(te)) }

    let stats = eekdat_stats()
    if stats[0] != 4 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [stats launches] expected=4 got=" + to_string(stats[0])) }
    if stats[1] != 4 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [stats absent] expected=4 got=" + to_string(stats[1])) }
    if stats[2] != 4 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [stats offline] expected=4 got=" + to_string(stats[2])) }
    if stats[3] != 7150000 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [stats elapsed] expected=7150000 got=" + to_string(stats[3])) }

    r0_emit("eekdat_summary", "\"launches\":" + to_string(stats[0]) + ",\"absent\":" + to_string(stats[1]) + ",\"offline\":" + to_string(stats[2]) + ",\"elapsed_us\":" + to_string(stats[3]))

    // record × 4 + summary × 1 = ≥ 5 emits
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_elden_eac_kernel_driver_avoid_track FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    // ─── synthetic Elden Ring retired_intentional posture annotation (Track AS) ───
    //
    // Track AS mission: Elden Ring blk.1 retired_intentional posture annotation
    // (mirror D4 Track V/AJ/AL pattern, EAC anti-tamper class). .roadmap.elden_ring
    // blk.1 status_enum_adopted = retired_intentional (block-acknowledged =
    // PASS-equivalent posture, own1 Wine 0 + own2 honest emit, no AC bypass / no
    // anti-tamper bypass). 본 module 측 EAC kernel driver (EasyAntiCheat.sys) 부재
    // 환경 추적 4-key trace (launch × driver_status × game_state × elapsed) =
    // synthetic — Apple Silicon natural absence path honest tracking, no bypass.
    // own1 Wine 0 + EAC bypass 시도 X — 단순 환경 부재 (driver 자체 load 불가).
    // cond.1 status `partial` 영구 유지 (retired_intentional posture per blk.1
    // 영구 lock).
    // pattern reference:
    //     lib/perf/c_d4_dxr_first_frame_trace.hexa (Track AL predecessor, schema mirror)
    //
    // synthetic posture row column header:
    //     domain                "eac_kernel_driver_avoid_track"
    //     posture               "retired_intentional"
    //     production_smoke      "no_attempt"
    //     drm_bypass            "0"                    (own1 Wine 0)
    //     ac_bypass             "0"                    (own1 honest acknowledgment)
    //     anti_tamper_bypass    "0"                    (EAC kernel driver natural absence)
    //     blocker_ref           "elden_ring.blk.1"     (eac_anti_tamper)
    //     adoption_iso          "2026-05-03"           (Track C 4-game retired_intentional)
    r0_emit("c_elden_eac_kernel_driver_avoid_track_retired_intentional",
        "\"stage\":\"elden_ring_eac_synthetic\",\"domain\":\"eac_kernel_driver_avoid_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"ac_bypass\":0,\"anti_tamper_bypass\":0,\"blocker_ref\":\"elden_ring.blk.1\",\"blocker_class\":\"eac_anti_tamper\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"elden_ring.cond.1\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__ELDEN_EAC_KERNEL_DRIVER_AVOID__ RETIRED_INTENTIONAL elden_ring_eac_synthetic")

    cleanup_eekdat()

    println("  ✅ c_elden_eac_kernel_driver_avoid_track self_test PASS (4 launches, absent=4, offline=4, elapsed_us=7150000, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = eekdat_stats()
            println("launches=" + to_string(s[0]) + " absent=" + to_string(s[1]) + " offline=" + to_string(s[2]) + " elapsed_us=" + to_string(s[3]))
            return
        }
        if sub == "count_status" {
            if len(a) >= 4 {
                let st = to_int(a[3])
                let n = count_by_driver_status(st)
                println(to_string(n))
                return
            }
        }
        if sub == "count_state" {
            if len(a) >= 4 {
                let st = to_int(a[3])
                let n = count_by_game_state(st)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_eekdat(); println("cleaned"); return }
    }
    println("usage: hexa run c_elden_eac_kernel_driver_avoid_track.hexa { self-test | stats | count_status <status> | count_state <state> | cleanup }")
}
