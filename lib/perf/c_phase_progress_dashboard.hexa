// lib/perf/c_phase_progress_dashboard.hexa — CN-82 skeleton manjeom 15/15
//
// D2R/D4 launch roadmap Phase 1-6 진척률 통합 대시보드.
// Phase 1 (PE map + IAT) / 2 (battle.net OAuth) / 3 (download) / 4 (first frame) /
// 5 (gameplay loop) / 6 (live tune) — 각 phase weight + skeleton/validated 상태.
//
// 무기: phase × status table + columnar (validated 가중치).
// 효과: closure path B 진척률 한 눈에 — dashboard 으로 우선순위 결정.

use "./r0_common"

let CPPD_DIR = GAMEBOX_HOME + "/persist/phase_progress_dashboard"
let PHASE_LOG = CPPD_DIR + "/phases.tsv"

fn cppd_dir() -> str { return CPPD_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CPPD_DIR + "'")
}

fn phases() -> array {
    return ["pe_map_iat", "bnet_oauth", "download", "first_frame", "gameplay", "live_tune"]
}

fn phase_weight(name: str) -> int {
    if name == "pe_map_iat" { return 30 }
    if name == "bnet_oauth" { return 15 }
    if name == "download" { return 10 }
    if name == "first_frame" { return 20 }
    if name == "gameplay" { return 15 }
    if name == "live_tune" { return 10 }
    return 0
}

fn status_score(status: str) -> int {
    if status == "skeleton" { return 25 }
    if status == "stage1" { return 50 }
    if status == "stage2" { return 70 }
    if status == "stage3" { return 85 }
    if status == "validated" { return 100 }
    return 0
}

fn record_phase(name: str, status: str) -> void {
    ensure_dir()
    let exists = exec("test -f '" + PHASE_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v p='" + name + "' '$1!=p' '" + PHASE_LOG + "' > '" + PHASE_LOG + ".tmp' && mv '" + PHASE_LOG + ".tmp' '" + PHASE_LOG + "'")
    }
    let line = name + "\t" + status + "\t" + to_string(status_score(status))
    let tmp = PHASE_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PHASE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("phase_update", "\"phase\":\"" + name + "\",\"status\":\"" + status + "\"")
}

fn phase_status(name: str) -> str {
    let exists = exec("test -f '" + PHASE_LOG + "' && echo ok").trim()
    if exists != "ok" { return "none" }
    let r = exec("awk -F'\\t' -v p='" + name + "' '$1==p {print $2}' '" + PHASE_LOG + "' | head -1").trim()
    if r == "" { return "none" }
    return r
}

// closure_pct = sum(weight × score / 100)
fn closure_pct() -> int {
    let p = phases()
    let i = 0
    let total = 0
    while i < len(p) {
        let name = p[i]
        let st = phase_status(name)
        let sc = status_score(st)
        let w = phase_weight(name)
        total = total + w * sc / 100
        i = i + 1
    }
    return total
}

fn cleanup_cppd() -> void {
    let _ = exec("rm -rf '" + CPPD_DIR + "'")
}

fn self_test() -> void {
    let sid = "cppd-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cppd()

    let p = phases()
    if len(p) != 6 { panic("c_phase_progress_dashboard FAIL [phases] expected=6 got=" + to_string(len(p))) }

    let sum_w = phase_weight("pe_map_iat") + phase_weight("bnet_oauth") + phase_weight("download") + phase_weight("first_frame") + phase_weight("gameplay") + phase_weight("live_tune")
    if sum_w != 100 { panic("c_phase_progress_dashboard FAIL [weight sum] expected=100 got=" + to_string(sum_w)) }

    // 0% — none recorded
    let p0 = closure_pct()
    if p0 != 0 { panic("c_phase_progress_dashboard FAIL [empty pct]") }

    // 현재 실제 상태 (cycle 33 시점 — skeleton heavy)
    record_phase("pe_map_iat", "skeleton")    // 30 × 25 / 100 = 7.5
    record_phase("bnet_oauth", "skeleton")    // 15 × 25 / 100 = 3.75
    record_phase("download", "skeleton")      // 10 × 25 / 100 = 2.5
    record_phase("first_frame", "skeleton")   // 20 × 25 / 100 = 5
    record_phase("gameplay", "skeleton")      // 15 × 25 / 100 = 3.75
    record_phase("live_tune", "skeleton")     // 10 × 25 / 100 = 2.5
    // total = 25%

    let p_cur = closure_pct()
    if p_cur != 22 { panic("c_phase_progress_dashboard FAIL [current pct] expected=22 got=" + to_string(p_cur)) }

    // overwrite — Phase 1 stage1 도달 가정
    record_phase("pe_map_iat", "stage1")      // 30 × 50 / 100 = 15
    let p_stage1 = closure_pct()
    if p_stage1 != 30 { panic("c_phase_progress_dashboard FAIL [stage1 pct] expected=30 got=" + to_string(p_stage1)) }

    // Phase 1 validated 가정
    record_phase("pe_map_iat", "validated")   // 30 × 100 / 100 = 30
    let p_v = closure_pct()
    if p_v != 45 { panic("c_phase_progress_dashboard FAIL [validated pct] expected=45 got=" + to_string(p_v)) }

    r0_emit("phase_dashboard_summary", "\"phases\":6,\"closure_pct\":" + to_string(p_v))

    let cnt = r0_session_count(sid)
    if cnt < 8 { panic("c_phase_progress_dashboard FAIL [emit] got=" + to_string(cnt)) }

    cleanup_cppd()

    println("  ✅ c_phase_progress_dashboard self_test PASS (6 phases weight=100, skeleton 22%, Phase1 validated → 45%, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 5 {
            record_phase(a[3], a[4])
            println("recorded")
            return
        }
        if sub == "pct" { println(to_string(closure_pct()) + "%"); return }
        if sub == "status" && len(a) >= 4 {
            println(phase_status(a[3]))
            return
        }
        if sub == "cleanup" { cleanup_cppd(); println("cleaned"); return }
    }
    println("usage: hexa run c_phase_progress_dashboard.hexa { self-test | set <phase> <status> | pct | status <phase> | cleanup }")
}
