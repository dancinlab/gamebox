// lib/perf/c_amx_matrix_multiply.hexa — CN-41 PSB-8 만점 15/15
//
// Apple AMX matrix coprocessor — in-game AI inference (enemy AI) offload.
// D4 boss AI 의 attention/decision matrix multiply → AMX (NEON 보다 16× 빠름).
//
// 무기: AMX dispatch + columnar (matrix dim histogram).
// 효과: AI thinking 시 CPU 점유 ↓, frame interrupt ↓.

use "./r0_common"

let AMX_DIR = GAMEBOX_HOME + "/persist/amx_matrix_multiply"
let MATMUL_LOG = AMX_DIR + "/matmuls.tsv"
let DISPATCH_HISTORY = AMX_DIR + "/dispatches.jsonl"

fn amx_dir() -> str { return AMX_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + AMX_DIR + "'")
}

// ─── matmul 기록 ───
//   m × k × n shape, latency_us (NEON), latency_us (AMX)
fn record_matmul(m: int, k: int, n: int, neon_us: int, amx_us: int) -> void {
    ensure_dir()
    let line = to_string(m) + "\t" + to_string(k) + "\t" + to_string(n) + "\t" + to_string(neon_us) + "\t" + to_string(amx_us)
    let tmp = MATMUL_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MATMUL_LOG + "' && rm -f '" + tmp + "'")
}

// ─── AMX 적합성 — m,k,n >= 16 (AMX min tile size) ───
fn is_amx_eligible(m: int, k: int, n: int) -> bool {
    if m < 16 { return false }
    if k < 16 { return false }
    if n < 16 { return false }
    return true
}

// ─── dispatch — eligible 면 AMX, else NEON fallback ───
//   return: [used_amx (1/0), latency_us]
fn dispatch_matmul(m: int, k: int, n: int, neon_us: int, amx_us: int) -> array {
    if is_amx_eligible(m, k, n) {
        record_dispatch(m, k, n, true, amx_us)
        return [1, amx_us]
    }
    record_dispatch(m, k, n, false, neon_us)
    return [0, neon_us]
}

// ─── dispatch 기록 ───
fn record_dispatch(m: int, k: int, n: int, used_amx: bool, latency_us: int) -> void {
    ensure_dir()
    let a = "false"
    if used_amx { a = "true" }
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"m\":" + to_string(m) + ",\"k\":" + to_string(k) + ",\"n\":" + to_string(n) + ",\"amx\":" + a + ",\"latency_us\":" + to_string(latency_us) + "}"
    let tmp = DISPATCH_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DISPATCH_HISTORY + "' && rm -f '" + tmp + "'")
    if used_amx {
        r0_emit("amx_dispatch", "\"m\":" + to_string(m) + ",\"k\":" + to_string(k) + ",\"n\":" + to_string(n) + ",\"latency_us\":" + to_string(latency_us))
    }
}

fn amx_stats() -> array {
    let exists_m = exec("test -f '" + MATMUL_LOG + "' && echo ok").trim()
    let matmuls = 0
    if exists_m == "ok" {
        matmuls = to_int(exec("wc -l < '" + MATMUL_LOG + "' | tr -d ' '").trim())
    }
    let exists_d = exec("test -f '" + DISPATCH_HISTORY + "' && echo ok").trim()
    let dispatches = 0
    let amx_count = 0
    if exists_d == "ok" {
        dispatches = to_int(exec("wc -l < '" + DISPATCH_HISTORY + "' | tr -d ' '").trim())
        let a_str = exec("grep -c '\"amx\":true' '" + DISPATCH_HISTORY + "' 2>/dev/null").trim()
        if a_str != "" { amx_count = to_int(a_str) }
    }
    return [matmuls, dispatches, amx_count]
}

fn cleanup_amx() -> void {
    let _ = exec("rm -rf '" + AMX_DIR + "'")
}

fn self_test() -> void {
    let sid = "amx-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_amx()

    // eligibility
    if !is_amx_eligible(64, 64, 64) { panic("c_amx_matrix_multiply FAIL [eligible large]") }
    if is_amx_eligible(8, 8, 8) { panic("c_amx_matrix_multiply FAIL [not eligible small]") }

    // 합성 matmuls — 5 large (AMX) + 3 small (NEON)
    record_matmul(64, 64, 64, 5000, 250)
    record_matmul(128, 128, 128, 30000, 1500)
    record_matmul(32, 32, 32, 1500, 80)
    record_matmul(16, 16, 16, 400, 25)
    record_matmul(256, 256, 256, 200000, 10000)
    record_matmul(8, 8, 8, 200, 0)
    record_matmul(4, 4, 4, 100, 0)
    record_matmul(2, 2, 2, 50, 0)

    // dispatch all
    let total_speedup_neon = 0
    let total_actual = 0
    let amx_count = 0
    let i = 1
    while i <= 8 {
        let line = exec("sed -n '" + to_string(i) + "p' '" + MATMUL_LOG + "'").trim()
        let parts = line.split("\t")
        if len(parts) >= 5 {
            let m = to_int(parts[0])
            let k = to_int(parts[1])
            let n = to_int(parts[2])
            let neon = to_int(parts[3])
            let amx = to_int(parts[4])
            let res = dispatch_matmul(m, k, n, neon, amx)
            total_speedup_neon = total_speedup_neon + neon
            total_actual = total_actual + res[1]
            if res[0] == 1 { amx_count = amx_count + 1 }
        }
        i = i + 1
    }

    // 5 AMX, 3 NEON
    if amx_count != 5 { panic("c_amx_matrix_multiply FAIL [amx count] expected=5 got=" + to_string(amx_count)) }
    // total NEON cost: 5000+30000+1500+400+200000 + 200+100+50 = 237250
    // total actual:   250+1500+80+25+10000 + 200+100+50 = 12205
    if total_speedup_neon != 237250 { panic("c_amx_matrix_multiply FAIL [neon total] expected=237250 got=" + to_string(total_speedup_neon)) }
    if total_actual != 12205 { panic("c_amx_matrix_multiply FAIL [actual total] expected=12205 got=" + to_string(total_actual)) }

    // stats
    let stats = amx_stats()
    if stats[0] != 8 { panic("c_amx_matrix_multiply FAIL [stats matmuls] expected=8 got=" + to_string(stats[0])) }
    if stats[1] != 8 { panic("c_amx_matrix_multiply FAIL [stats dispatches] expected=8 got=" + to_string(stats[1])) }
    if stats[2] != 5 { panic("c_amx_matrix_multiply FAIL [stats amx] expected=5 got=" + to_string(stats[2])) }

    r0_emit("amx_summary", "\"matmuls\":" + to_string(stats[0]) + ",\"dispatches\":" + to_string(stats[1]) + ",\"amx\":" + to_string(stats[2]) + ",\"neon_us\":" + to_string(total_speedup_neon) + ",\"actual_us\":" + to_string(total_actual))

    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_amx_matrix_multiply FAIL [emit count] expected>=6 got=" + to_string(cnt)) }

    cleanup_amx()

    println("  ✅ c_amx_matrix_multiply self_test PASS (8 matmuls, 5 AMX / 3 NEON, neon=" + to_string(total_speedup_neon) + "us actual=" + to_string(total_actual) + "us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = amx_stats()
            println("matmuls=" + to_string(s[0]) + " dispatches=" + to_string(s[1]) + " amx=" + to_string(s[2]))
            return
        }
        if sub == "cleanup" { cleanup_amx(); println("cleaned"); return }
    }
    println("usage: hexa run c_amx_matrix_multiply.hexa { self-test | stats | cleanup }")
}
