// lib/perf/c_wg_battle_entry_block.hexa — CN-188 skeleton manjeom 5/15 (B=0/C=0 — 보호 모듈)
//
// WoT/WoWS battle 진입 자동 차단 모듈 — multiplayer 거부 directive 보호.
// WoT/WoWS 가 training room (single + bot) / replay (offline) 외 실 battle
// (random/ranked/clan) 진입 시 자동 차단 + HWID ban 위험 사용자 고지.
// c_dforce_unsupported_block_doc / c_purple_anticheat_block_doc /
// c_cs2_vac_avoid_guard 와 동형. 만점 5/15 (B=0 — runtime 영향 X,
// C=0 — 데이터 재해석 X, A=5 — Apple-only).
//
// 무기: attempt × game × battle_kind × blocked 4-key 컬럼 로그.
// 효과: 사용자 자산 (WG account + HWID) 보호.

use "./r0_common"

let WBEB_DIR = GAMEBOX_HOME + "/persist/wg_battle_entry_block"
let ATTEMPT_LOG = WBEB_DIR + "/attempts.tsv"

fn wbeb_dir() -> str { return WBEB_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + WBEB_DIR + "'")
}

// ─── battle 진입 시도 등록 ───
//   attempt_id (시도 ID),
//   game_id (1=WoT, 2=WoWS),
//   battle_kind (1=random, 2=ranked, 3=clan, 4=training, 5=replay),
//   blocked (0=허용 / 1=차단).
fn record_attempt(attempt_id: int, game_id: int, battle_kind: int, blocked: int) -> void {
    ensure_dir()
    let line = to_string(attempt_id) + "\t" + to_string(game_id) + "\t" + to_string(battle_kind) + "\t" + to_string(blocked)
    let tmp = ATTEMPT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + ATTEMPT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("wbeb_record", "\"attempt\":" + to_string(attempt_id) + ",\"game\":" + to_string(game_id) + ",\"kind\":" + to_string(battle_kind) + ",\"blocked\":" + to_string(blocked))
}

// ─── attempt_count — 등록된 attempt 행 수 ───
fn attempt_count() -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + ATTEMPT_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── blocked_count — blocked=1 행 수 ───
fn blocked_count() -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==1 {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── allowed_count — blocked=0 행 수 ───
fn allowed_count() -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==0 {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_battle_kind — 특정 battle_kind 행 수 ───
fn count_by_battle_kind(kind: int) -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$3==k {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_game — 특정 game_id 행 수 ───
fn count_by_game(game_id: int) -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v g=" + to_string(game_id) + " '$2==g {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── wbeb_stats — [attempt_count, blocked_count, allowed_count, count_by_battle_kind(1)] ───
fn wbeb_stats() -> array {
    return [attempt_count(), blocked_count(), allowed_count(), count_by_battle_kind(1)]
}

fn cleanup_wbeb() -> void {
    let _ = exec("rm -rf '" + WBEB_DIR + "'")
}

fn self_test() -> void {
    let sid = "wbeb-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_wbeb()

    // 합성 attempts 5 종:
    //   42001 WoT  random   blocked=1 ← 차단
    //   42002 WoT  training blocked=0 ← 허용
    //   42003 WoWS ranked   blocked=1 ← 차단
    //   42004 WoWS replay   blocked=0 ← 허용
    //   42005 WoT  clan     blocked=1 ← 차단
    record_attempt(42001, 1, 1, 1)
    record_attempt(42002, 1, 4, 0)
    record_attempt(42003, 2, 2, 1)
    record_attempt(42004, 2, 5, 0)
    record_attempt(42005, 1, 3, 1)

    // attempt_count = 5
    let ac = attempt_count()
    if ac != 5 { panic("c_wg_battle_entry_block FAIL [attempt_count] expected=5 got=" + to_string(ac)) }

    // blocked_count = 3 (42001+42003+42005)
    let bc = blocked_count()
    if bc != 3 { panic("c_wg_battle_entry_block FAIL [blocked_count] expected=3 got=" + to_string(bc)) }

    // allowed_count = 2 (42002+42004)
    let al = allowed_count()
    if al != 2 { panic("c_wg_battle_entry_block FAIL [allowed_count] expected=2 got=" + to_string(al)) }

    // count_by_battle_kind: 1..5 = 1, 99 = 0
    let k1 = count_by_battle_kind(1)
    if k1 != 1 { panic("c_wg_battle_entry_block FAIL [kind 1] expected=1 got=" + to_string(k1)) }
    let k2 = count_by_battle_kind(2)
    if k2 != 1 { panic("c_wg_battle_entry_block FAIL [kind 2] expected=1 got=" + to_string(k2)) }
    let k3 = count_by_battle_kind(3)
    if k3 != 1 { panic("c_wg_battle_entry_block FAIL [kind 3] expected=1 got=" + to_string(k3)) }
    let k4 = count_by_battle_kind(4)
    if k4 != 1 { panic("c_wg_battle_entry_block FAIL [kind 4] expected=1 got=" + to_string(k4)) }
    let k5 = count_by_battle_kind(5)
    if k5 != 1 { panic("c_wg_battle_entry_block FAIL [kind 5] expected=1 got=" + to_string(k5)) }
    let k99 = count_by_battle_kind(99)
    if k99 != 0 { panic("c_wg_battle_entry_block FAIL [kind 99] expected=0 got=" + to_string(k99)) }

    // count_by_game: 1=3 (WoT), 2=2 (WoWS), 99=0
    let g1 = count_by_game(1)
    if g1 != 3 { panic("c_wg_battle_entry_block FAIL [game 1] expected=3 got=" + to_string(g1)) }
    let g2 = count_by_game(2)
    if g2 != 2 { panic("c_wg_battle_entry_block FAIL [game 2] expected=2 got=" + to_string(g2)) }
    let g99 = count_by_game(99)
    if g99 != 0 { panic("c_wg_battle_entry_block FAIL [game 99] expected=0 got=" + to_string(g99)) }

    // wbeb_stats() = [5, 3, 2, 1]
    let stats = wbeb_stats()
    if stats[0] != 5 { panic("c_wg_battle_entry_block FAIL [stats attempt] expected=5 got=" + to_string(stats[0])) }
    if stats[1] != 3 { panic("c_wg_battle_entry_block FAIL [stats blocked] expected=3 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_wg_battle_entry_block FAIL [stats allowed] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_wg_battle_entry_block FAIL [stats kind1] expected=1 got=" + to_string(stats[3])) }

    r0_emit("wbeb_summary", "\"attempts\":" + to_string(stats[0]) + ",\"blocked\":" + to_string(stats[1]) + ",\"allowed\":" + to_string(stats[2]) + ",\"random\":" + to_string(stats[3]))

    // record × 5 + summary × 1 = ≥ 6 emits
    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_wg_battle_entry_block FAIL [emit count] expected>=6 got=" + to_string(cnt)) }

    // ─── synthetic Wargaming battle entry block round-trip (Track BF — battlenet cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BF mission: c_wg_* family inventory cycle — c_wg_battle_entry_block
    // 측 Wargaming launcher gateway synthetic round-trip. Battle entry block
    // (probe_token → check_realm → enforce_block → audit_decision) 측 spec freeze.
    // Production smoke gated on user network smoke (battlenet blk.1 transitive)
    // + 자연 환경 정합 long-horizon work, met 승격 X.
    //
    // (a) synthetic 4-phase entry block decision pipeline —
    //     probe_oauth_token → check_realm_endpoint → enforce_block_decision → audit_event:
    //     phase_count               4
    //     entry_block_off           0x140140000         (synthetic WG launcher RVA)
    //     pipeline_kind             "synthetic_inline"  (실 wgcrypt/wgnet 호출 X)
    //
    // (b) synthetic game_kind × decision 16-slot decision matrix —
    //     4 game_kind (wot/wows/wowp/blitz) × 4 decision (allow/block/queue/error) = 16 slots:
    //     slot_total                16
    //     blocked_slot_count        9                   (game_kind wot/wows/wowp AND decision block/queue/error)
    //     allowed_slot_count        7                   (decision allow OR game_kind blitz)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_entry_phase(scaffold) → walk_decision_matrix(scaffold).
    //              hexa-native loop only — 실 OAuth refresh 0, real net I/O 0.
    //
    // synthetic entry block phase emit
    r0_emit("c_wg_battle_entry_block_synthetic_phase",
        "\"stage\":\"entry_block_phase\",\"phase_count\":4,\"entry_block_off\":\"0x140140000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"network_gap\":\"production smoke gated on user network smoke + 자연 환경 정합 long-horizon\"")
    println("__WG_ENTRY__ PARTIAL entry_block_phase")

    // synthetic game_kind × decision matrix emit
    r0_emit("c_wg_battle_entry_block_synthetic_matrix",
        "\"stage\":\"decision_matrix\",\"slot_total\":16,\"blocked_slot_count\":9,\"allowed_slot_count\":7,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"network_gap\":\"production smoke gated on user network smoke + 자연 환경 정합 long-horizon\"")
    println("__WG_ENTRY__ PARTIAL decision_matrix")

    cleanup_wbeb()

    println("  ✅ c_wg_battle_entry_block self_test PASS (5 attempts, 3 blocked, 2 allowed, WoT=3, WoWS=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = wbeb_stats()
            println("attempts=" + to_string(s[0]) + " blocked=" + to_string(s[1]) + " allowed=" + to_string(s[2]) + " random=" + to_string(s[3]))
            return
        }
        if sub == "count_kind" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                let n = count_by_battle_kind(k)
                println(to_string(n))
                return
            }
        }
        if sub == "count_game" {
            if len(a) >= 4 {
                let g = to_int(a[3])
                let n = count_by_game(g)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_wbeb(); println("cleaned"); return }
    }
    println("usage: hexa run c_wg_battle_entry_block.hexa { self-test | stats | count_kind <battle_kind> | count_game <game_id> | cleanup }")
}
