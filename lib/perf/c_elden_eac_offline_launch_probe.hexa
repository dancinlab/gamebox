// lib/perf/c_elden_eac_offline_launch_probe.hexa — CN-161 skeleton manjeom 15/15
//
// Elden Ring `start_game_in_offline_mode.exe` (FromSoft 정식 EAC toggle) 메커니즘
// 정량화. Elden Ring 은 `start_protected_game.exe` (EAC online launcher) 와
// `start_game_in_offline_mode.exe` (EAC 우회 offline launcher) 두 path 를
// 보유 — 후자가 FromSoft 정식 인정 toggle 이며, EAC 자체가 game launch 에
// 필수 X (online 기능에만 결합). 본 모듈은 두 launch mode × eac_active 상태 ×
// launch_us 4-key 컬럼 로그를 모아 mode 별 평균 / EAC 활성 횟수 / 합계만
// 집계 — 실제 process spawn 은 host 측 책임.
//
// 무기: launch × mode × eac_active × launch_us 4-key 로그 + sum/avg/count.
// 효과: FromSoft 정식 offline mode 메커니즘 정량화 — 다른 EAC 게임
// (Rocket League 등) 에 generic 재사용 가능.

use "./r0_common"

let EELP_DIR = GAMEBOX_HOME + "/persist/elden_eac_offline_launch_probe"
let LAUNCH_LOG = EELP_DIR + "/launches.tsv"

fn eelp_dir() -> str { return EELP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + EELP_DIR + "'")
}

// ─── launch 등록 ───
//   launch_id (단조 증가 id),
//   mode (0=protected_online / 1=offline),
//   eac_active (0/1 — EAC runtime 활성 여부),
//   launch_us (process spawn → main window 도달 us).
fn record_launch(launch_id: int, mode: int, eac_active: int, launch_us: int) -> void {
    ensure_dir()
    let line = to_string(launch_id) + "\t" + to_string(mode) + "\t" + to_string(eac_active) + "\t" + to_string(launch_us)
    let tmp = LAUNCH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + LAUNCH_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("eelp_launch_record", "\"launch\":" + to_string(launch_id) + ",\"mode\":" + to_string(mode) + ",\"eac\":" + to_string(eac_active) + ",\"us\":" + to_string(launch_us))
}

// ─── launch_count — 등록된 launch 행 수 ───
fn launch_count() -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + LAUNCH_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_launch_us — 모든 launch_us 합 ───
fn total_launch_us() -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + LAUNCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_mode — 그 mode 의 launch 수 ───
fn count_by_mode(mode: int) -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(mode) + " '$2==m {c+=1} END{print c+0}' '" + LAUNCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── eac_active_count — eac_active==1 launch 수 ───
fn eac_active_count() -> int {
    let exists = exec("test -f '" + LAUNCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==1 {c+=1} END{print c+0}' '" + LAUNCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── mode_avg_launch_us — 그 mode 의 평균 launch_us ───
//   mode 행이 0 이면 0 반환 (divide-by-zero guard).
fn mode_avg_launch_us(mode: int) -> int {
    let cnt = count_by_mode(mode)
    if cnt == 0 { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(mode) + " '$2==m {s+=$4} END{print s+0}' '" + LAUNCH_LOG + "'").trim()
    if s == "" { return 0 }
    let total = to_int(s)
    return total / cnt
}

// ─── eelp_stats — [launch_count, total_launch_us, count_by_mode(1), eac_active_count] ───
fn eelp_stats() -> array {
    return [launch_count(), total_launch_us(), count_by_mode(1), eac_active_count()]
}

fn cleanup_eelp() -> void {
    let _ = exec("rm -rf '" + EELP_DIR + "'")
}

fn self_test() -> void {
    let sid = "eelp-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_eelp()

    // 합성 launch 4 종:
    //   protected_online ×2 (eac_active=1) — 2.4s / 2.2s
    //   offline          ×2 (eac_active=0) — 1.8s / 1.7s
    record_launch(15001, 0, 1, 2400000)
    record_launch(15002, 0, 1, 2200000)
    record_launch(15003, 1, 0, 1800000)
    record_launch(15004, 1, 0, 1700000)

    // launch_count = 4
    let lc = launch_count()
    if lc != 4 { panic("c_elden_eac_offline_launch_probe FAIL [launch_count] expected=4 got=" + to_string(lc)) }

    // total_launch_us = 2400000+2200000+1800000+1700000 = 8100000
    let tu = total_launch_us()
    if tu != 8100000 { panic("c_elden_eac_offline_launch_probe FAIL [total_launch_us] expected=8100000 got=" + to_string(tu)) }

    // count_by_mode: 0 → 2, 1 → 2, 99 → 0
    let cm0 = count_by_mode(0)
    if cm0 != 2 { panic("c_elden_eac_offline_launch_probe FAIL [count_by_mode 0] expected=2 got=" + to_string(cm0)) }
    let cm1 = count_by_mode(1)
    if cm1 != 2 { panic("c_elden_eac_offline_launch_probe FAIL [count_by_mode 1] expected=2 got=" + to_string(cm1)) }
    let cm99 = count_by_mode(99)
    if cm99 != 0 { panic("c_elden_eac_offline_launch_probe FAIL [count_by_mode 99] expected=0 got=" + to_string(cm99)) }

    // eac_active_count = 2 (15001 + 15002)
    let ea = eac_active_count()
    if ea != 2 { panic("c_elden_eac_offline_launch_probe FAIL [eac_active_count] expected=2 got=" + to_string(ea)) }

    // mode_avg_launch_us:
    //   mode 0 → (2400000+2200000)/2 = 2300000
    //   mode 1 → (1800000+1700000)/2 = 1750000
    //   mode 99 → 0 (guard)
    let avg0 = mode_avg_launch_us(0)
    if avg0 != 2300000 { panic("c_elden_eac_offline_launch_probe FAIL [mode_avg 0] expected=2300000 got=" + to_string(avg0)) }
    let avg1 = mode_avg_launch_us(1)
    if avg1 != 1750000 { panic("c_elden_eac_offline_launch_probe FAIL [mode_avg 1] expected=1750000 got=" + to_string(avg1)) }
    let avg99 = mode_avg_launch_us(99)
    if avg99 != 0 { panic("c_elden_eac_offline_launch_probe FAIL [mode_avg 99] expected=0 got=" + to_string(avg99)) }

    let stats = eelp_stats()
    if stats[0] != 4 { panic("c_elden_eac_offline_launch_probe FAIL [stats launches] expected=4 got=" + to_string(stats[0])) }
    if stats[1] != 8100000 { panic("c_elden_eac_offline_launch_probe FAIL [stats total_us] expected=8100000 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_elden_eac_offline_launch_probe FAIL [stats offline_count] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_elden_eac_offline_launch_probe FAIL [stats eac_active] expected=2 got=" + to_string(stats[3])) }

    r0_emit("eelp_summary", "\"launches\":" + to_string(stats[0]) + ",\"total_us\":" + to_string(stats[1]) + ",\"offline\":" + to_string(stats[2]) + ",\"eac_active\":" + to_string(stats[3]) + ",\"avg_online_us\":" + to_string(avg0) + ",\"avg_offline_us\":" + to_string(avg1))

    // record × 4 + summary × 1 = ≥ 5 emits
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_elden_eac_offline_launch_probe FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    // ─── synthetic Elden Ring retired_intentional posture annotation (Track AS) ───
    //
    // Track AS mission: Elden Ring blk.1 retired_intentional posture annotation
    // (mirror D4 Track V/AJ/AL pattern, EAC anti-tamper class). .roadmap.elden_ring
    // blk.1 status_enum_adopted = retired_intentional (block-acknowledged =
    // PASS-equivalent posture, own1 Wine 0 + own2 honest emit, no AC bypass / no
    // anti-tamper bypass). 본 module 측 EAC offline launch probe 4-key trace
    // (launch × mode × eac_active × elapsed) = synthetic — `start_game_in_offline_
    // mode.exe` FromSoft 정식 mechanism honest detect, no bypass. Production binary
    // smoke X (EAC anti-tamper class boundary). cond.1 status `partial` 영구 유지
    // (retired_intentional posture per blk.1 영구 lock).
    // pattern reference:
    //     lib/perf/c_d4_dxr_first_frame_trace.hexa (Track AL predecessor, schema mirror)
    //
    // synthetic posture row column header:
    //     domain                "eac_offline_launch_probe"
    //     posture               "retired_intentional"
    //     production_smoke      "no_attempt"
    //     drm_bypass            "0"                    (own1 Wine 0)
    //     ac_bypass             "0"                    (own1 honest acknowledgment)
    //     anti_tamper_bypass    "0"                    (EAC anti-tamper boundary)
    //     blocker_ref           "elden_ring.blk.1"     (eac_anti_tamper)
    //     adoption_iso          "2026-05-03"           (Track C 4-game retired_intentional)
    r0_emit("c_elden_eac_offline_launch_probe_retired_intentional",
        "\"stage\":\"elden_ring_eac_synthetic\",\"domain\":\"eac_offline_launch_probe\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"ac_bypass\":0,\"anti_tamper_bypass\":0,\"blocker_ref\":\"elden_ring.blk.1\",\"blocker_class\":\"eac_anti_tamper\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"elden_ring.cond.1\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__ELDEN_EAC_OFFLINE_PROBE__ RETIRED_INTENTIONAL elden_ring_eac_synthetic")

    cleanup_eelp()

    println("  ✅ c_elden_eac_offline_launch_probe self_test PASS (4 launches, total=8100000 us, online_avg=2300000 us, offline_avg=1750000 us, eac_active=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = eelp_stats()
            println("launches=" + to_string(s[0]) + " total_us=" + to_string(s[1]) + " offline=" + to_string(s[2]) + " eac_active=" + to_string(s[3]))
            return
        }
        if sub == "mode_avg" {
            if len(a) >= 4 {
                let m = to_int(a[3])
                let avg = mode_avg_launch_us(m)
                println(to_string(avg))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let m = to_int(a[3])
                let c = count_by_mode(m)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_eelp(); println("cleaned"); return }
    }
    println("usage: hexa run c_elden_eac_offline_launch_probe.hexa { self-test | stats | mode_avg <mode> | count <mode> | cleanup }")
}
