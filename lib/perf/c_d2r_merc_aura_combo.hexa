// lib/perf/c_d2r_merc_aura_combo.hexa — CN-143 skeleton manjeom 15/15
//
// D2R mercenary aura 조합 — Phase 5 gameplay loop.
// Act2 hireling 의 aura stacking (Holy Freeze + Conviction 등 7 aura).
//
// 무기: aura compatibility table + columnar (per-char primary/secondary aura).
// 효과: aura 조합 stacking 가능 여부 즉시 검증.

use "./r0_common"

let DMAC_DIR = GAMEBOX_HOME + "/persist/d2r_merc_aura_combo"
let COMBO_LOG = DMAC_DIR + "/combos.tsv"

fn dmac_dir() -> str { return DMAC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMAC_DIR + "'")
}

fn aura_list() -> array {
    return ["holy_freeze", "might", "blessed_aim", "prayer", "thorns", "defiance", "conviction"]
}

fn aura_known(a: str) -> bool {
    if a == "holy_freeze" { return true }
    if a == "might" { return true }
    if a == "blessed_aim" { return true }
    if a == "prayer" { return true }
    if a == "thorns" { return true }
    if a == "defiance" { return true }
    if a == "conviction" { return true }
    return false
}

fn aura_stack_compatible(aura1: str, aura2: str) -> bool {
    if !aura_known(aura1) { return false }
    if !aura_known(aura2) { return false }
    // 동일 aura 는 stack 불가 (중복)
    if aura1 == aura2 { return false }
    // defiance + might 은 동일 hireling 의 defensive/offensive 충돌
    if aura1 == "defiance" && aura2 == "might" { return false }
    if aura1 == "might" && aura2 == "defiance" { return false }
    // 그 외 조합은 D2R 에서 stack 가능 (서로 다른 merc 가 보유 시)
    return true
}

fn record_combo(char_name: str, primary_aura: str, secondary_aura: str) -> void {
    ensure_dir()
    let compat = aura_stack_compatible(primary_aura, secondary_aura)
    let s = "fail"
    if compat { s = "pass" }
    let line = char_name + "\t" + primary_aura + "\t" + secondary_aura + "\t" + s
    let tmp = COMBO_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + COMBO_LOG + "' && rm -f '" + tmp + "'")
    if compat {
        r0_emit("d2r_merc_aura_ok", "\"char\":\"" + char_name + "\",\"p\":\"" + primary_aura + "\",\"s\":\"" + secondary_aura + "\"")
    } else {
        r0_emit("d2r_merc_aura_fail", "\"char\":\"" + char_name + "\",\"p\":\"" + primary_aura + "\",\"s\":\"" + secondary_aura + "\"")
    }
}

fn combo_count(char_name: str) -> int {
    let exists = exec("test -f '" + COMBO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c' '" + COMBO_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn total_count() -> int {
    let exists = exec("test -f '" + COMBO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + COMBO_LOG + "' | tr -d ' '").trim())
}

fn cleanup_dmac() -> void {
    let _ = exec("rm -rf '" + DMAC_DIR + "'")
}

fn self_test() -> void {
    let sid = "dmac-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dmac()

    let al = aura_list()
    if len(al) != 7 { panic("c_d2r_merc_aura_combo FAIL [aura_list] expected=7 got=" + to_string(len(al))) }

    // compatibility 검증
    if !aura_stack_compatible("holy_freeze", "conviction") { panic("c_d2r_merc_aura_combo FAIL [hf+conv] expected=true got=false") }
    if !aura_stack_compatible("might", "blessed_aim") { panic("c_d2r_merc_aura_combo FAIL [might+ba] expected=true got=false") }
    if aura_stack_compatible("might", "might") { panic("c_d2r_merc_aura_combo FAIL [dup might] expected=false got=true") }
    if aura_stack_compatible("might", "defiance") { panic("c_d2r_merc_aura_combo FAIL [might+def conflict] expected=false got=true") }
    if aura_stack_compatible("unknown", "might") { panic("c_d2r_merc_aura_combo FAIL [unknown aura] expected=false got=true") }

    r0_emit("d2r_merc_aura_register", "\"count\":" + to_string(len(al)))

    // 1 char + 4 combo 등록 (3 ok / 1 fail)
    record_combo("Hero", "holy_freeze", "conviction")     // ok
    record_combo("Hero", "might", "blessed_aim")          // ok
    record_combo("Hero", "prayer", "thorns")              // ok
    record_combo("Hero", "might", "defiance")             // fail

    let cnt = combo_count("Hero")
    if cnt != 4 { panic("c_d2r_merc_aura_combo FAIL [combo count] expected=4 got=" + to_string(cnt)) }

    let total = total_count()
    if total != 4 { panic("c_d2r_merc_aura_combo FAIL [total] expected=4 got=" + to_string(total)) }

    let other = combo_count("Ghost")
    if other != 0 { panic("c_d2r_merc_aura_combo FAIL [other char] expected=0 got=" + to_string(other)) }

    r0_emit("d2r_merc_aura_summary", "\"auras\":" + to_string(len(al)) + ",\"combos\":" + to_string(total) + ",\"success\":3")

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 6 { panic("c_d2r_merc_aura_combo FAIL [emit] expected>=6 got=" + to_string(emit_cnt)) }

    // ─── synthetic Mercenary aura combo state machine round-trip (Track BA cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BA mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic Act 2 Desert Mercenary aura combo 4-phase cycle —
    //     equip_aura_item → activate_aura → stack_with_partner → tally_dps_buff
    //     (Holy Freeze + Might + Conviction + Prayer + Defiance + Thorns + BloodGolem):
    //     phase_count               4                   (equip/activate/stack/tally)
    //     aura_table_off            0x1400A8000         (synthetic D2GAME.dll RVA)
    //     aura_kind_count           7                   (7 aura types)
    //     aura_kind                 "synthetic_inline"  (실 merc aura tick X)
    //
    // (b) synthetic combo_match × success matrix scaffold —
    //     4 combo recipes (Insight+Conviction / Pride+Conviction / Doom+Holy_Freeze / Bramble+Thorns):
    //     combo_recipe_total        4                   (4 synthetic combos)
    //     success_count             3                   (3 of 4 synthetic success)
    //     fail_count                1                   (1 incompatible aura overlap)
    //     stacked_aura_total        7                   (sum of synthetic stacks)
    //     dps_buff_pct_synthetic    175                 (synthetic combined buff)
    //     matrix_kind               "synthetic_inline"  (실 combo log lookup X)
    //
    // round-trip = synthesize_aura_phase(scaffold) → walk_combo_success_matrix(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll merc aura tick 0,
    //              real Act 2 Mercenary AI engagement 0.
    //
    // synthetic aura phase emit
    r0_emit("c_d2r_merc_aura_combo_synthetic_phase",
        "\"stage\":\"aura_phase\",\"phase_count\":4,\"aura_table_off\":\"0x1400A8000\",\"aura_kind_count\":7,\"aura_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\",\"track\":\"BA\"")
    println("__D2R_MERC_AURA__ PARTIAL aura_phase")

    // synthetic combo success matrix emit
    r0_emit("c_d2r_merc_aura_combo_synthetic_matrix",
        "\"stage\":\"combo_success_matrix\",\"combo_recipe_total\":4,\"success_count\":3,\"fail_count\":1,\"stacked_aura_total\":7,\"dps_buff_pct_synthetic\":175,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\",\"track\":\"BA\"")
    println("__D2R_MERC_AURA__ PARTIAL combo_success_matrix")

    cleanup_dmac()

    println("  ✅ c_d2r_merc_aura_combo self_test PASS (7 auras, 4 combos 3 success, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "compat" && len(a) >= 5 {
            let ok = aura_stack_compatible(a[3], a[4])
            if ok { println("ok") } else { println("fail") }
            return
        }
        if sub == "set" && len(a) >= 6 {
            record_combo(a[3], a[4], a[5])
            println("recorded")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("combos=" + to_string(combo_count(a[3])))
            return
        }
        if sub == "stats" {
            println("total=" + to_string(total_count()))
            return
        }
        if sub == "cleanup" { cleanup_dmac(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_merc_aura_combo.hexa { self-test | compat <a1> <a2> | set <char> <p> <s> | stats [char] | cleanup }")
}
