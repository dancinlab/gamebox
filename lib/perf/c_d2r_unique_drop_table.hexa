// lib/perf/c_d2r_unique_drop_table.hexa — CN-129 skeleton manjeom 15/15
//
// D2R unique item drop table — Phase 5 gameplay loop (loot).
// quality level (qlvl) + monster level (mlvl) + magic find (mf%) → unique drop weight.
//
// 무기: tier table (normal/exceptional/elite × mlvl bucket → weight) + columnar (drops/sec).
// 효과: D2R Pindle/Meph/Baal 런 — 어느 mob 가 어느 tier unique 잘 나오는지.

use "./r0_common"

let DUDT_DIR = GAMEBOX_HOME + "/persist/d2r_unique_drop_table"
let DROP_LOG = DUDT_DIR + "/drops.tsv"

fn dudt_dir() -> str { return DUDT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DUDT_DIR + "'")
}

fn unique_tier() -> array {
    return ["normal", "exceptional", "elite"]
}

// base weight: tier 별 base 가중치 (mlvl 1-100 적용 가능 영역).
// normal: 항상 가능 (100), exceptional: mlvl 25+ (30), elite: mlvl 50+ (5).
fn weight(tier: str, mlvl: int) -> int {
    if tier == "normal" {
        if mlvl < 1 { return 0 }
        return 100
    }
    if tier == "exceptional" {
        if mlvl < 25 { return 0 }
        return 30
    }
    if tier == "elite" {
        if mlvl < 50 { return 0 }
        return 5
    }
    return 0
}

// magic find % 적용 — unique 가중치 부스트 (rare+ 가중치와 동일 공식)
fn weight_with_mf(tier: str, mlvl: int, mf_pct: int) -> int {
    let w = weight(tier, mlvl)
    if w == 0 { return 0 }
    return w + w * mf_pct / 100
}

fn record_drop(monster: str, mlvl: int, mf_pct: int, unique_name: str, tier: str) -> void {
    ensure_dir()
    let w = weight_with_mf(tier, mlvl, mf_pct)
    let line = monster + "\t" + to_string(mlvl) + "\t" + to_string(mf_pct) + "\t" + unique_name + "\t" + tier + "\t" + to_string(w)
    let tmp = DROP_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DROP_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d2r_unique_drop", "\"mob\":\"" + monster + "\",\"name\":\"" + unique_name + "\",\"tier\":\"" + tier + "\",\"w\":" + to_string(w))
}

fn drop_count() -> int {
    let exists = exec("test -f '" + DROP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + DROP_LOG + "' | tr -d ' '").trim())
}

fn count_by_tier(tier: str) -> int {
    let exists = exec("test -f '" + DROP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v t='" + tier + "' '$5==t' '" + DROP_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dudt() -> void {
    let _ = exec("rm -rf '" + DUDT_DIR + "'")
}

fn self_test() -> void {
    let sid = "dudt-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dudt()

    let t = unique_tier()
    if len(t) != 3 { panic("c_d2r_unique_drop_table FAIL [tiers] expected=3 got=" + to_string(len(t))) }

    // base weight invariants — normal=100, exceptional=30, elite=5 (mlvl 충분 시)
    if weight("normal", 10) != 100 { panic("c_d2r_unique_drop_table FAIL [normal w] expected=100 got=" + to_string(weight("normal", 10))) }
    if weight("exceptional", 50) != 30 { panic("c_d2r_unique_drop_table FAIL [exc w] expected=30 got=" + to_string(weight("exceptional", 50))) }
    if weight("elite", 80) != 5 { panic("c_d2r_unique_drop_table FAIL [elite w] expected=5 got=" + to_string(weight("elite", 80))) }

    // mlvl gate — exceptional 24 below threshold, elite 49 below threshold
    if weight("exceptional", 24) != 0 { panic("c_d2r_unique_drop_table FAIL [exc gate] expected=0 got=" + to_string(weight("exceptional", 24))) }
    if weight("elite", 49) != 0 { panic("c_d2r_unique_drop_table FAIL [elite gate] expected=0 got=" + to_string(weight("elite", 49))) }

    // mf 100% — weight 2배
    let elite_no_mf = weight_with_mf("elite", 80, 0)
    let elite_mf100 = weight_with_mf("elite", 80, 100)
    if elite_mf100 != elite_no_mf * 2 { panic("c_d2r_unique_drop_table FAIL [mf] expected=" + to_string(elite_no_mf*2) + " got=" + to_string(elite_mf100)) }

    // 5 drop 등록 — normal:2, exceptional:2, elite:1 분포
    record_drop("Andariel", 30, 100, "Vidala's_Barb", "normal")
    record_drop("Mephisto", 50, 150, "Manald_Heal", "normal")
    record_drop("Diablo", 70, 200, "Skin_of_the_Vipermagi", "exceptional")
    record_drop("Baal", 85, 250, "Crown_of_Ages", "exceptional")
    record_drop("Pindleskin", 86, 300, "Shadow_Killer", "elite")

    let total = drop_count()
    if total != 5 { panic("c_d2r_unique_drop_table FAIL [drops] expected=5 got=" + to_string(total)) }

    let n_norm = count_by_tier("normal")
    if n_norm != 2 { panic("c_d2r_unique_drop_table FAIL [normal count] expected=2 got=" + to_string(n_norm)) }

    let n_exc = count_by_tier("exceptional")
    if n_exc != 2 { panic("c_d2r_unique_drop_table FAIL [exc count] expected=2 got=" + to_string(n_exc)) }

    let n_elite = count_by_tier("elite")
    if n_elite != 1 { panic("c_d2r_unique_drop_table FAIL [elite count] expected=1 got=" + to_string(n_elite)) }

    r0_emit("d2r_unique_summary", "\"drops\":" + to_string(total) + ",\"normal\":" + to_string(n_norm) + ",\"exceptional\":" + to_string(n_exc) + ",\"elite\":" + to_string(n_elite))

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_d2r_unique_drop_table FAIL [emit] expected>=5 got=" + to_string(cnt)) }

    // ─── synthetic Unique drop table state machine round-trip (Track BA cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BA mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X. Track BA
    // terminal cycle: cumulative_c_d2r_extended 26/26 (100%) 도달 module.
    //
    // (a) synthetic Unique item drop 4-phase cycle —
    //     monster_kill → mf_modifier → tier_roll → unique_pick_or_fall_through
    //     (Andariel/Mephisto/Diablo/Baal boss + MF modifier):
    //     phase_count               4                   (kill/mf/tier_roll/pick)
    //     unique_table_off          0x1400AE000         (synthetic D2GAME.dll RVA)
    //     tier_total                3                   (normal/exceptional/elite)
    //     drop_kind                 "synthetic_inline"  (실 boss kill tick X)
    //
    // (b) synthetic tier × mf distribution matrix scaffold —
    //     3 tiers × 5 drops / MF 2x synthetic compute:
    //     drop_total_synthetic      5                   (5 synthetic drops)
    //     normal_tier_count         2                   (2 normal-tier uniques)
    //     exceptional_tier_count    2                   (2 exceptional-tier)
    //     elite_tier_count          1                   (1 elite-tier unique)
    //     mf_modifier_synthetic     200                 (MF 2x compute synthetic)
    //     mf_applied_count          5                   (all 5 with MF synthetic)
    //     matrix_kind               "synthetic_inline"  (실 unique drop log lookup X)
    //
    // round-trip = synthesize_drop_phase(scaffold) → walk_tier_mf_matrix(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll unique RNG tick 0,
    //              real boss drop pool walk 0.
    //
    // synthetic drop phase emit
    r0_emit("c_d2r_unique_drop_table_synthetic_phase",
        "\"stage\":\"drop_phase\",\"phase_count\":4,\"unique_table_off\":\"0x1400AE000\",\"tier_total\":3,\"drop_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\",\"track\":\"BA\"")
    println("__D2R_UNIQUE_DROP__ PARTIAL drop_phase")

    // synthetic tier mf matrix emit
    r0_emit("c_d2r_unique_drop_table_synthetic_matrix",
        "\"stage\":\"tier_mf_matrix\",\"drop_total_synthetic\":5,\"normal_tier_count\":2,\"exceptional_tier_count\":2,\"elite_tier_count\":1,\"mf_modifier_synthetic\":200,\"mf_applied_count\":5,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\",\"track\":\"BA\"")
    println("__D2R_UNIQUE_DROP__ PARTIAL tier_mf_matrix")

    cleanup_dudt()

    println("  ✅ c_d2r_unique_drop_table self_test PASS (3 tiers, 5 drops, normal=2/exc=2/elite=1, mf 2x, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "weight" && len(a) >= 6 {
            let w = weight_with_mf(a[3], to_int(a[4]), to_int(a[5]))
            println(to_string(w))
            return
        }
        if sub == "tiers" {
            let t = unique_tier()
            let i = 0
            while i < len(t) { println(t[i]); i = i + 1 }
            return
        }
        if sub == "stats" {
            println("drops=" + to_string(drop_count()) + " normal=" + to_string(count_by_tier("normal")) + " exceptional=" + to_string(count_by_tier("exceptional")) + " elite=" + to_string(count_by_tier("elite")))
            return
        }
        if sub == "cleanup" { cleanup_dudt(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_unique_drop_table.hexa { self-test | weight <tier> <mlvl> <mf_pct> | tiers | stats | cleanup }")
}
