// lib/perf/c_d4_pso_warmup_priority.hexa — CN-103 skeleton manjeom 15/15
//
// Phase 4 D4 PSO warmup 우선순위 — 첫 frame 직전 컴파일할 PSO list.
// stuttering 가장 큰 PSO 부터 (DXR ray gen, mesh shader, deferred lighting).
//
// 무기: PSO priority table + columnar (PSO × first-touch frame × cost_us).
// 효과: D4 첫 5 frame 의 stutter 대폭 감소.

use "./r0_common"

let CDPW_DIR = GAMEBOX_HOME + "/persist/d4_pso_warmup"
let PSO_LOG = CDPW_DIR + "/psos.tsv"

fn cdpw_dir() -> str { return CDPW_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CDPW_DIR + "'")
}

fn record_pso(name: str, first_frame: int, cost_us: int, dispatched: bool) -> void {
    ensure_dir()
    let exists = exec("test -f '" + PSO_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v n='" + name + "' '$1!=n' '" + PSO_LOG + "' > '" + PSO_LOG + ".tmp' && mv '" + PSO_LOG + ".tmp' '" + PSO_LOG + "'")
    }
    let d = "0"
    if dispatched { d = "1" }
    let line = name + "\t" + to_string(first_frame) + "\t" + to_string(cost_us) + "\t" + d
    let tmp = PSO_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PSO_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_pso_warmup", "\"pso\":\"" + name + "\",\"frame\":" + to_string(first_frame) + ",\"cost_us\":" + to_string(cost_us))
}

fn pso_count() -> int {
    let exists = exec("test -f '" + PSO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + PSO_LOG + "' | tr -d ' '").trim())
}

// budget 안에 가장 cost 큰 N 개 선택 (greedy by cost desc until budget)
fn warm_set(budget_us: int) -> int {
    let exists = exec("test -f '" + PSO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("sort -t '\t' -k3 -nr '" + PSO_LOG + "' | awk -F'\\t' -v b=" + to_string(budget_us) + " 'BEGIN{s=0; c=0} {if(s+$3<=b){s+=$3; c++}} END{print c}'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn savings_us(budget_us: int) -> int {
    let exists = exec("test -f '" + PSO_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("sort -t '\t' -k3 -nr '" + PSO_LOG + "' | awk -F'\\t' -v b=" + to_string(budget_us) + " 'BEGIN{s=0} {if(s+$3<=b) s+=$3} END{print s+0}'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_cdpw() -> void {
    let _ = exec("rm -rf '" + CDPW_DIR + "'")
}

fn self_test() -> void {
    let sid = "cdpw-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cdpw()

    // D4 typical 첫 frame PSO (cost descending — 가장 무거운 것)
    record_pso("dxr_raygen_pbr", 1, 50000, false)
    record_pso("mesh_shader_environment", 1, 35000, false)
    record_pso("deferred_lighting_compute", 2, 30000, false)
    record_pso("ssr_trace", 3, 25000, false)
    record_pso("particle_compute", 5, 18000, false)
    record_pso("ui_text_glyph", 1, 8000, false)
    record_pso("postprocess_bloom", 4, 15000, false)
    record_pso("shadow_csm_pass", 2, 22000, false)

    let n = pso_count()
    if n != 8 { panic("c_d4_pso_warmup_priority FAIL [count] expected=8 got=" + to_string(n)) }

    // budget 100ms = 100000us — top cost PSOs 까지
    let warm_n = warm_set(100000)
    // greedy(best-fit, no early break): 50000+35000=85000 (2) → skip 30000/25000/22000/18000(all overflow)
    //   → +15000=100000 (3) → skip 8000 (overflow). 결과 3 PSOs, 100000us.
    if warm_n != 3 { panic("c_d4_pso_warmup_priority FAIL [warm 100ms] expected=3 got=" + to_string(warm_n)) }

    let saved = savings_us(100000)
    if saved != 100000 { panic("c_d4_pso_warmup_priority FAIL [savings] expected=100000 got=" + to_string(saved)) }

    // budget 200ms — more PSOs
    let warm_n2 = warm_set(200000)
    if warm_n2 < 5 { panic("c_d4_pso_warmup_priority FAIL [warm 200ms] expected>=5 got=" + to_string(warm_n2)) }

    r0_emit("d4_pso_summary", "\"psos\":" + to_string(n) + ",\"warm_100ms\":" + to_string(warm_n) + ",\"saved_us\":" + to_string(saved))

    let cnt = r0_session_count(sid)
    if cnt < 8 { panic("c_d4_pso_warmup_priority FAIL [emit] got=" + to_string(cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AJ) ───
    //
    // Track AJ mission: extend Track V D4 retired_intentional posture annotation to 6
    // additional c_d4_* modules. .roadmap.diablo4 blk.1 status_enum_adopted =
    // retired_intentional (Track A2 land 2026-05-03). 본 module 측 DXR PSO warmup
    // priority planner = synthetic PSO cost table + greedy budget selector —
    // production live game state 측정 X (D4 always-online live session 진입 X +
    // loader_dx blk.1 D3DMetal binary licence cross-blocked, DRM bypass 0,
    // Battle.net launcher 통과 X). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_
    // intentional posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "pso_warmup_priority"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_pso_warmup_priority_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"pso_warmup_priority\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_PSO_WARMUP__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_cdpw()

    println("  ✅ c_d4_pso_warmup_priority self_test PASS (8 PSOs, 100ms budget=3 PSOs/100ms saved, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "warm" && len(a) >= 4 {
            println("count=" + to_string(warm_set(to_int(a[3]))) + " saved_us=" + to_string(savings_us(to_int(a[3]))))
            return
        }
        if sub == "stats" { println("psos=" + to_string(pso_count())); return }
        if sub == "cleanup" { cleanup_cdpw(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_pso_warmup_priority.hexa { self-test | warm <budget_us> | stats | cleanup }")
}
