// lib/perf/c_remediate_plan.hexa — CN-16 PSB-3 sketch (만점 15/15)
//
// 라벨 → 자동 행동 (rule engine + multi-component orchestration).
// "PSO compile cascade" → 자동:
//   1. C-PSO-CHAIN 활성화 (다음 PSO 미리 컴파일)
//   2. C-HEAP-DEFRAG 트리거 (메모리 압박 대비)
//   3. Metal queue priority 일시 상승
//   4. 5초 후 normal mode 복귀
//
// 효과: airgenome 이 게임을 *자율 운영*.
//
// own 1 + own 2 mandate.

use "./r0_common"

let REMEDIATE_DIR = GAMEBOX_HOME + "/persist/remediate_plan"
let RULES_PATH = REMEDIATE_DIR + "/rules.tsv"
let HISTORY_PATH = REMEDIATE_DIR + "/history.jsonl"

fn remediate_dir() -> str { return REMEDIATE_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + REMEDIATE_DIR + "'")
}

// ─── built-in rules — label → actions array ───
//   각 rule = "label\taction1,action2,...\tttl_sec"
fn install_built_in_rules() -> void {
    ensure_dir()
    let _rm = exec("rm -f '" + RULES_PATH + "'")
    let rules = ""
    rules = rules + "pso_compile_cascade\tactivate_pso_chain,trigger_heap_defrag,boost_metal_queue\t5\n"
    rules = rules + "OOM_imminent\ttrigger_heap_defrag,evict_cold_textures\t10\n"
    rules = rules + "frag_critical\ttrigger_heap_defrag\t30\n"
    rules = rules + "stutter_spike\tflush_pso_cache,boost_metal_queue\t3\n"
    rules = rules + "zone_transition\tactivate_zone_prefetch,activate_pso_chain\t8\n"
    write_file(RULES_PATH, rules)
}

// ─── rule lookup ───
fn lookup_rule(label: str) -> array {
    let exists = exec("test -f '" + RULES_PATH + "' && echo ok").trim()
    if exists != "ok" { return ["", "", "0"] }
    let line = exec("grep -E '^" + label + "[[:space:]]' '" + RULES_PATH + "' | head -1").trim()
    if line == "" { return ["", "", "0"] }
    let parts = line.split("\t")
    if len(parts) < 3 { return ["", "", "0"] }
    return [parts[0], parts[1], parts[2]]
}

// ─── action 실행 (synthetic — 모든 action 은 noop placeholder) ───
fn execute_action(action: str) -> bool {
    if action == "" { return false }
    if action == "activate_pso_chain" { return true }
    if action == "trigger_heap_defrag" { return true }
    if action == "boost_metal_queue" { return true }
    if action == "evict_cold_textures" { return true }
    if action == "flush_pso_cache" { return true }
    if action == "activate_zone_prefetch" { return true }
    if action == "restore_normal_mode" { return true }
    return false  // unknown action
}

// ─── auto remediate workflow ───
//   label 받으면 rule lookup → 모든 action 실행 → history 기록
//   returns [actions_executed, ttl_sec]
fn auto_remediate(label: str) -> array {
    let rule = lookup_rule(label)
    let action_csv = rule[1]
    let ttl_str = rule[2]
    if action_csv == "" {
        r0_emit("remediate_skip", "\"label\":\"" + label + "\",\"reason\":\"no_rule\"")
        return [0, 0]
    }
    let actions = action_csv.split(",")
    let executed = 0
    let i = 0
    while i < len(actions) {
        let a = actions[i].trim()
        if execute_action(a) {
            executed = executed + 1
            r0_emit("remediate_action", "\"label\":\"" + label + "\",\"action\":\"" + a + "\"")
        }
        i = i + 1
    }
    let ts = exec("date +%s").trim()
    let h_line = "{\"label\":\"" + label + "\",\"actions\":" + to_string(executed) + ",\"ttl\":" + ttl_str + ",\"ts\":" + ts + "}"
    let tmp = HISTORY_PATH + ".tmp"
    write_file(tmp, h_line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + HISTORY_PATH + "' && rm -f '" + tmp + "'")
    return [executed, to_int(ttl_str)]
}

// ─── stats ───
fn remediate_stats() -> array {
    let exists_r = exec("test -f '" + RULES_PATH + "' && echo ok").trim()
    let rules = 0
    if exists_r == "ok" {
        rules = to_int(exec("wc -l < '" + RULES_PATH + "' | tr -d ' '").trim())
    }
    let exists_h = exec("test -f '" + HISTORY_PATH + "' && echo ok").trim()
    let triggers = 0
    let total_actions = 0
    if exists_h == "ok" {
        triggers = to_int(exec("wc -l < '" + HISTORY_PATH + "' | tr -d ' '").trim())
        total_actions = to_int(exec("grep -oE '\"actions\":[0-9]+' '" + HISTORY_PATH + "' | cut -d: -f2 | awk '{s+=$1} END{print s+0}'").trim())
    }
    return [rules, triggers, total_actions]
}

fn cleanup_remediate() -> void {
    let _ = exec("rm -rf '" + REMEDIATE_DIR + "'")
}

fn self_test() -> void {
    let sid = "remediate-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_remediate()
    install_built_in_rules()

    // 1. rule lookup
    let r1 = lookup_rule("pso_compile_cascade")
    if r1[0] != "pso_compile_cascade" {
        panic("c_remediate_plan FAIL [lookup pso] expected=pso_compile_cascade got=" + r1[0])
    }
    if !r1[1].contains("activate_pso_chain") {
        panic("c_remediate_plan FAIL [lookup pso actions] expected contains activate_pso_chain got=" + r1[1])
    }

    let r_unknown = lookup_rule("UnknownLabel")
    if r_unknown[0] != "" {
        panic("c_remediate_plan FAIL [lookup unknown] expected=empty got=" + r_unknown[0])
    }

    // 2. auto_remediate — pso_compile_cascade → 3 actions
    let res1 = auto_remediate("pso_compile_cascade")
    if res1[0] != 3 {
        panic("c_remediate_plan FAIL [actions count pso] expected=3 got=" + to_string(res1[0]))
    }
    if res1[1] != 5 {
        panic("c_remediate_plan FAIL [ttl pso] expected=5 got=" + to_string(res1[1]))
    }

    // 3. OOM_imminent → 2 actions
    let res2 = auto_remediate("OOM_imminent")
    if res2[0] != 2 {
        panic("c_remediate_plan FAIL [actions count OOM] expected=2 got=" + to_string(res2[0]))
    }

    // 4. unknown label → 0 actions
    let res3 = auto_remediate("UnknownLabel")
    if res3[0] != 0 {
        panic("c_remediate_plan FAIL [actions unknown] expected=0 got=" + to_string(res3[0]))
    }

    // 5. action 검증
    let act_ok = execute_action("activate_pso_chain")
    if !act_ok { panic("c_remediate_plan FAIL [action 1]") }
    let act_unknown = execute_action("nonexistent_action")
    if act_unknown { panic("c_remediate_plan FAIL [action unknown]") }

    // 6. stats
    let stats = remediate_stats()
    if stats[0] != 5 { panic("c_remediate_plan FAIL [rules count] expected=5 got=" + to_string(stats[0])) }
    if stats[1] != 2 { panic("c_remediate_plan FAIL [triggers count] expected=2 got=" + to_string(stats[1])) }
    if stats[2] != 5 { panic("c_remediate_plan FAIL [total actions] expected=5 got=" + to_string(stats[2])) }

    r0_emit("remediate_stats", "\"rules\":" + to_string(stats[0]) + ",\"triggers\":" + to_string(stats[1]) + ",\"actions\":" + to_string(stats[2]))

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_remediate_plan FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    cleanup_remediate()

    println("  ✅ c_remediate_plan self_test PASS (5 rules, 2 triggers, 5 actions executed, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "install" { install_built_in_rules(); println("rules installed"); return }
        if sub == "stats" {
            let s = remediate_stats()
            println("rules=" + to_string(s[0]) + " triggers=" + to_string(s[1]) + " actions=" + to_string(s[2]))
            return
        }
        if sub == "remediate" {
            if len(a) >= 4 {
                let r = auto_remediate(a[3])
                println("actions=" + to_string(r[0]) + " ttl=" + to_string(r[1]))
                return
            }
        }
        if sub == "cleanup" { cleanup_remediate(); println("cleaned"); return }
    }
    println("usage: hexa run c_remediate_plan.hexa { self-test | install | stats | remediate <label> | cleanup }")
}
