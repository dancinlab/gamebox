// lib/perf/c_fps_hotkey_handler.hexa — CN-218 skeleton manjeom 15/15
//
// FPS overlay 단축키 핸들러 추적 — 사용자 directive: "fps 표시모드 단축키 필요"
// + "메뉴바에서도 on/off 가능 필요". Ctrl+Shift+F (default, configurable) 와
// 메뉴바 (CN-215) 둘 다 같은 toggle state 를 갱신해야 한다. 본 모듈은
// event × source × new_state × elapsed 4-key 컬럼 로그로 단축키 + 메뉴바
// 양 vector 동기를 정량화 — 실제 hotkey hook / menubar wiring 은 host 측 책임.
//
// 무기: event × source × state × elapsed 4-key columnar log + sum/by-source.
// 효과: 단축키 + 메뉴바 양 vector 동기 정량화 → directive ("양쪽 동시 on/off")
// 실제 충족 여부 측정 가능.

use "./r0_common"

let FHH_DIR = GAMEBOX_HOME + "/persist/fps_hotkey_handler"
let EVENT_LOG = FHH_DIR + "/events.tsv"

fn fhh_dir() -> str { return FHH_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + FHH_DIR + "'")
}

// ─── event 등록 ───
//   event_id (단조 증가 식별자),
//   source (1=hotkey, 2=menubar),
//   new_state (0=off, 1=on),
//   elapsed_us (handler 처리 시간 마이크로초).
fn record_event(event_id: int, source: int, new_state: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(event_id) + "\t" + to_string(source) + "\t" + to_string(new_state) + "\t" + to_string(elapsed_us)
    let tmp = EVENT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + EVENT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("fps_hotkey_event", "\"event\":" + to_string(event_id) + ",\"source\":" + to_string(source) + ",\"state\":" + to_string(new_state) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── event_count — 등록된 event 행 수 ───
fn event_count() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + EVENT_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_elapsed_us — 모든 event elapsed 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_source — source 별 event 수 (1=hotkey, 2=menubar) ───
fn count_by_source(src: int) -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v x=" + to_string(src) + " '$2==x {c++} END{print c+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── on_count — new_state==1 인 event 수 ───
fn on_count() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==1 {c++} END{print c+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── event_elapsed — event_id 의 elapsed_us (미등록 0) ───
fn event_elapsed(event_id: int) -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v e=" + to_string(event_id) + " '$1==e {s+=$4} END{print s+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── fhh_stats — [event_count, total_elapsed_us, count_by_source(1), count_by_source(2)] ───
fn fhh_stats() -> array {
    return [event_count(), total_elapsed_us(), count_by_source(1), count_by_source(2)]
}

fn cleanup_fhh() -> void {
    let _ = exec("rm -rf '" + FHH_DIR + "'")
}

fn self_test() -> void {
    let sid = "fhh-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_fhh()

    // 합성 event 4 종 (alternating source — hotkey / menubar):
    //   69001 hotkey  off→on  30 us
    //   69002 menubar on→off  80 us
    //   69003 hotkey  off→on  28 us
    //   69004 menubar on→off  75 us
    record_event(69001, 1, 1, 30)
    record_event(69002, 2, 0, 80)
    record_event(69003, 1, 1, 28)
    record_event(69004, 2, 0, 75)

    // event_count = 4
    let ec = event_count()
    if ec != 4 { panic("c_fps_hotkey_handler FAIL [event_count] expected=4 got=" + to_string(ec)) }

    // total_elapsed_us = 30+80+28+75 = 213
    let te = total_elapsed_us()
    if te != 213 { panic("c_fps_hotkey_handler FAIL [total_elapsed_us] expected=213 got=" + to_string(te)) }

    // count_by_source: hotkey=2, menubar=2, unknown=0
    let c1 = count_by_source(1)
    if c1 != 2 { panic("c_fps_hotkey_handler FAIL [count hotkey] expected=2 got=" + to_string(c1)) }
    let c2 = count_by_source(2)
    if c2 != 2 { panic("c_fps_hotkey_handler FAIL [count menubar] expected=2 got=" + to_string(c2)) }
    let c99 = count_by_source(99)
    if c99 != 0 { panic("c_fps_hotkey_handler FAIL [count unknown] expected=0 got=" + to_string(c99)) }

    // on_count = 2 (69001 + 69003)
    let onc = on_count()
    if onc != 2 { panic("c_fps_hotkey_handler FAIL [on_count] expected=2 got=" + to_string(onc)) }

    // event_elapsed lookups
    let e1 = event_elapsed(69001)
    if e1 != 30 { panic("c_fps_hotkey_handler FAIL [elapsed 69001] expected=30 got=" + to_string(e1)) }
    let e4 = event_elapsed(69004)
    if e4 != 75 { panic("c_fps_hotkey_handler FAIL [elapsed 69004] expected=75 got=" + to_string(e4)) }
    let e0 = event_elapsed(9999)
    if e0 != 0 { panic("c_fps_hotkey_handler FAIL [elapsed unknown] expected=0 got=" + to_string(e0)) }

    let stats = fhh_stats()
    if stats[0] != 4 { panic("c_fps_hotkey_handler FAIL [stats events] expected=4 got=" + to_string(stats[0])) }
    if stats[1] != 213 { panic("c_fps_hotkey_handler FAIL [stats elapsed] expected=213 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_fps_hotkey_handler FAIL [stats hotkey] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_fps_hotkey_handler FAIL [stats menubar] expected=2 got=" + to_string(stats[3])) }

    r0_emit("fps_hotkey_summary", "\"events\":" + to_string(stats[0]) + ",\"elapsed_us\":" + to_string(stats[1]) + ",\"hotkey\":" + to_string(stats[2]) + ",\"menubar\":" + to_string(stats[3]) + ",\"on\":" + to_string(onc))

    // record × 4 + summary × 1 = ≥ 5 emits
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_fps_hotkey_handler FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    // ─── synthetic FPS overlay hotkey dispatch round-trip (Track BI — diablo2_resurrected cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BI mission: c_fps_* family 100% completion cycle (Track BF 1/4 → BI 4/4) —
    // c_fps_hotkey_handler 측 Apple-native synthetic round-trip 추가. Hotkey
    // dispatch lifecycle (intercept → modifier_match → action_resolve → overlay_toggle)
    // 측 spec freeze. Apple-native scaffold only (own1 정합, NSEvent binary linkage 0).
    //
    // (a) synthetic 4-phase hotkey dispatch lifecycle —
    //     intercept → modifier_match → action_resolve → overlay_toggle:
    //     phase_count               4
    //     hotkey_dispatch_off       0x180056000         (synthetic NSEvent globalMonitor RVA)
    //     lifecycle_kind            "synthetic_inline"  (실 NSEvent.addGlobalMonitorForEvents 호출 X)
    //
    // (b) synthetic source × action 12-slot dispatch matrix —
    //     3 source (hotkey/menubar/api) × 4 action (toggle_on/toggle_off/cycle/reset) = 12 slots:
    //     slot_total                12
    //     hotkey_slot_count         4                   (hotkey source rows)
    //     menubar_slot_count        4                   (menubar source rows)
    //     api_slot_count            4                   (api source rows)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = hotkey_dispatch_phase(scaffold) → walk_source_action_matrix(scaffold).
    //              hexa-native loop only — 실 NSEventModifierFlags 0,
    //              real RegisterEventHotKey 0.
    //
    // synthetic hotkey dispatch phase emit
    r0_emit("c_fps_hotkey_handler_synthetic_phase",
        "\"stage\":\"hotkey_dispatch_phase\",\"phase_count\":4,\"hotkey_dispatch_off\":\"0x180056000\",\"lifecycle_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real NSEvent binary linkage\"")
    println("__FPS_HOTKEY__ PARTIAL hotkey_dispatch_phase")

    // synthetic source × action dispatch matrix emit
    r0_emit("c_fps_hotkey_handler_synthetic_matrix",
        "\"stage\":\"source_action_matrix\",\"slot_total\":12,\"hotkey_slot_count\":4,\"menubar_slot_count\":4,\"api_slot_count\":4,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real NSEvent binary linkage\"")
    println("__FPS_HOTKEY__ PARTIAL source_action_matrix")

    cleanup_fhh()

    println("  ✅ c_fps_hotkey_handler self_test PASS (4 events, 213 us, hotkey=2, menubar=2, on=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = fhh_stats()
            println("events=" + to_string(s[0]) + " elapsed_us=" + to_string(s[1]) + " hotkey=" + to_string(s[2]) + " menubar=" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let eid = to_int(a[3])
                let us = event_elapsed(eid)
                println(to_string(us))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let src = to_int(a[3])
                let c = count_by_source(src)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_fhh(); println("cleaned"); return }
    }
    println("usage: hexa run c_fps_hotkey_handler.hexa { self-test | stats | elapsed <event_id> | count <source> | cleanup }")
}
