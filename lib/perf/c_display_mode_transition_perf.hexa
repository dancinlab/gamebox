// lib/perf/c_display_mode_transition_perf.hexa — CN-209 skeleton manjeom 15/15
//
// 3-mode (창 / 전체화면 / PIP) 전환 perf 추적 — 사용자가 창모드 ↔ 전체화면 ↔ PIP
// 전환 시 Metal swap chain 재구성, NSWindow style mask 변경, frame buffer
// recreate 비용이 발생한다. 각 transition 의 elapsed_us + frame_lost 를 모아
// 3-mode 전환 latency 를 정량화하여 사용자 체감 quality 를 측정한다.
//
// 무기: transition × from_mode × to_mode × elapsed 4-key 컬럼 로그.
// 효과: window↔fullscreen, window↔pip, fullscreen↔pip 전환 비용 정량화.

use "./r0_common"

let DMTP_DIR = GAMEBOX_HOME + "/persist/display_mode_transition_perf"
let TRANSITION_LOG = DMTP_DIR + "/transitions.tsv"

fn dmtp_dir() -> str { return DMTP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMTP_DIR + "'")
}

// ─── transition 등록 ───
//   transition_id (전환 이벤트 고유 id),
//   from_mode (1=window, 2=fullscreen, 3=pip),
//   to_mode   (1=window, 2=fullscreen, 3=pip),
//   elapsed_us (Metal swap chain 재구성 + NSWindow style mask 전환 누적 us).
fn record_transition(transition_id: int, from_mode: int, to_mode: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(transition_id) + "\t" + to_string(from_mode) + "\t" + to_string(to_mode) + "\t" + to_string(elapsed_us)
    let tmp = TRANSITION_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + TRANSITION_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("display_mode_transition_record", "\"tid\":" + to_string(transition_id) + ",\"from\":" + to_string(from_mode) + ",\"to\":" + to_string(to_mode) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── transition_count — 등록된 transition 행 수 ───
fn transition_count() -> int {
    let exists = exec("test -f '" + TRANSITION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + TRANSITION_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_elapsed_us — 모든 transition elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + TRANSITION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + TRANSITION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_to_mode — 특정 to_mode 도착 transition 수 ───
fn count_to_mode(mode: int) -> int {
    let exists = exec("test -f '" + TRANSITION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(mode) + " '$3==m {c++} END{print c+0}' '" + TRANSITION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_from_mode — 특정 from_mode 출발 transition 수 ───
fn count_from_mode(mode: int) -> int {
    let exists = exec("test -f '" + TRANSITION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(mode) + " '$2==m {c++} END{print c+0}' '" + TRANSITION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_elapsed_us — total_elapsed_us / transition_count (int trunc) ───
//   transition 0 이면 0 반환 (divide-by-zero guard).
fn avg_elapsed_us() -> int {
    let cnt = transition_count()
    if cnt == 0 { return 0 }
    let tot = total_elapsed_us()
    return tot / cnt
}

// ─── transition_elapsed — 특정 transition_id 의 elapsed_us ───
//   transition_id 미등록이면 0.
fn transition_elapsed(transition_id: int) -> int {
    let exists = exec("test -f '" + TRANSITION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v t=" + to_string(transition_id) + " '$1==t {s+=$4} END{print s+0}' '" + TRANSITION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dmtp_stats — [transition_count, total_elapsed_us, count_to_mode(2), count_to_mode(3)] ───
fn dmtp_stats() -> array {
    return [transition_count(), total_elapsed_us(), count_to_mode(2), count_to_mode(3)]
}

fn cleanup_dmtp() -> void {
    let _ = exec("rm -rf '" + DMTP_DIR + "'")
}

fn self_test() -> void {
    let sid = "dmtp-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dmtp()

    // 합성 transitions 6 종 (3-mode 사이 모든 전환):
    //   60001: window(1)     → fullscreen(2)  180000 us
    //   60002: fullscreen(2) → window(1)      120000 us
    //   60003: window(1)     → pip(3)          80000 us
    //   60004: pip(3)        → window(1)       60000 us
    //   60005: fullscreen(2) → pip(3)         240000 us
    //   60006: pip(3)        → fullscreen(2)  200000 us
    record_transition(60001, 1, 2, 180000)
    record_transition(60002, 2, 1, 120000)
    record_transition(60003, 1, 3, 80000)
    record_transition(60004, 3, 1, 60000)
    record_transition(60005, 2, 3, 240000)
    record_transition(60006, 3, 2, 200000)

    // transition_count = 6
    let tc = transition_count()
    if tc != 6 { panic("c_display_mode_transition_perf FAIL [transition_count] expected=6 got=" + to_string(tc)) }

    // total_elapsed_us = 180000+120000+80000+60000+240000+200000 = 880000
    let te = total_elapsed_us()
    if te != 880000 { panic("c_display_mode_transition_perf FAIL [total_elapsed_us] expected=880000 got=" + to_string(te)) }

    // count_to_mode: 1=2 (60002, 60004), 2=2 (60001, 60006), 3=2 (60003, 60005)
    let ct1 = count_to_mode(1)
    if ct1 != 2 { panic("c_display_mode_transition_perf FAIL [count_to_mode 1] expected=2 got=" + to_string(ct1)) }
    let ct2 = count_to_mode(2)
    if ct2 != 2 { panic("c_display_mode_transition_perf FAIL [count_to_mode 2] expected=2 got=" + to_string(ct2)) }
    let ct3 = count_to_mode(3)
    if ct3 != 2 { panic("c_display_mode_transition_perf FAIL [count_to_mode 3] expected=2 got=" + to_string(ct3)) }

    // count_from_mode: 1=2 (60001, 60003), 2=2 (60002, 60005), 3=2 (60004, 60006)
    let cf1 = count_from_mode(1)
    if cf1 != 2 { panic("c_display_mode_transition_perf FAIL [count_from_mode 1] expected=2 got=" + to_string(cf1)) }
    let cf2 = count_from_mode(2)
    if cf2 != 2 { panic("c_display_mode_transition_perf FAIL [count_from_mode 2] expected=2 got=" + to_string(cf2)) }
    let cf3 = count_from_mode(3)
    if cf3 != 2 { panic("c_display_mode_transition_perf FAIL [count_from_mode 3] expected=2 got=" + to_string(cf3)) }

    // avg_elapsed_us = 880000 / 6 = 146666 (int trunc)
    let avg = avg_elapsed_us()
    if avg != 146666 { panic("c_display_mode_transition_perf FAIL [avg_elapsed_us] expected=146666 got=" + to_string(avg)) }

    // transition_elapsed lookup
    let e1 = transition_elapsed(60001)
    if e1 != 180000 { panic("c_display_mode_transition_perf FAIL [elapsed 60001] expected=180000 got=" + to_string(e1)) }
    let e5 = transition_elapsed(60005)
    if e5 != 240000 { panic("c_display_mode_transition_perf FAIL [elapsed 60005] expected=240000 got=" + to_string(e5)) }
    // 미등록 transition_id 는 0
    let e_unk = transition_elapsed(9999)
    if e_unk != 0 { panic("c_display_mode_transition_perf FAIL [elapsed unknown] expected=0 got=" + to_string(e_unk)) }

    let stats = dmtp_stats()
    if stats[0] != 6 { panic("c_display_mode_transition_perf FAIL [stats count] expected=6 got=" + to_string(stats[0])) }
    if stats[1] != 880000 { panic("c_display_mode_transition_perf FAIL [stats total] expected=880000 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_display_mode_transition_perf FAIL [stats to_mode 2] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_display_mode_transition_perf FAIL [stats to_mode 3] expected=2 got=" + to_string(stats[3])) }

    r0_emit("display_mode_transition_summary", "\"count\":" + to_string(stats[0]) + ",\"total_us\":" + to_string(stats[1]) + ",\"avg_us\":" + to_string(avg) + ",\"to_fullscreen\":" + to_string(stats[2]) + ",\"to_pip\":" + to_string(stats[3]))

    // record × 6 + summary × 1 = ≥ 7 emits
    let cnt = r0_session_count(sid)
    if cnt < 7 { panic("c_display_mode_transition_perf FAIL [emit count] expected>=7 got=" + to_string(cnt)) }

    // ─── synthetic display mode transition perf round-trip (Track BJ — d2r cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BJ mission: c_display_* family completion cycle (8/8) — c_display_mode_transition_perf
    // 측 mode-switch latency synthetic round-trip. Transition lifecycle
    // (capture_from → request_to → reconfigure_layer → resume_present) 측 spec freeze.
    // Apple-native scaffold only (D3DMetal binary licence transitive — loader_dx blk.1),
    // DX11 mode change cross-link Metal layer evidence.
    //
    // (a) synthetic 4-phase mode transition pipeline —
    //     capture_from_mode → request_to_mode → reconfigure_metal_layer → resume_present_loop:
    //     phase_count               4
    //     transition_off            0x18005A000         (synthetic mode transition RVA)
    //     pipeline_kind             "synthetic_inline"  (실 NSWindow.toggleFullScreen 호출 X)
    //
    // (b) synthetic from_mode × to_mode 16-slot transition matrix —
    //     4 from_mode (window/full/pip/menu) × 4 to_mode (window/full/pip/menu) = 16 slots:
    //     slot_total                16
    //     direct_slot_count         12                  (from ≠ to)
    //     identity_slot_count       4                   (from = to, no-op)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_transition_phase(scaffold) → walk_mode_matrix(scaffold).
    //              hexa-native loop only — 실 NSWindow level mutation 0,
    //              real CAMetalLayer reconfigure 0.
    //
    // synthetic transition phase emit
    r0_emit("c_display_mode_transition_perf_synthetic_phase",
        "\"stage\":\"transition_phase\",\"phase_count\":4,\"transition_off\":\"0x18005A000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_TRANSITION__ PARTIAL transition_phase")

    // synthetic from × to mode matrix emit
    r0_emit("c_display_mode_transition_perf_synthetic_matrix",
        "\"stage\":\"mode_matrix\",\"slot_total\":16,\"direct_slot_count\":12,\"identity_slot_count\":4,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_TRANSITION__ PARTIAL mode_matrix")

    cleanup_dmtp()

    println("  ✅ c_display_mode_transition_perf self_test PASS (6 transitions, total=880000 us, avg=146666 us, to_full=2, to_pip=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dmtp_stats()
            println("transitions=" + to_string(s[0]) + " total_us=" + to_string(s[1]) + " to_fullscreen=" + to_string(s[2]) + " to_pip=" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let tid = to_int(a[3])
                let us = transition_elapsed(tid)
                println(to_string(us))
                return
            }
        }
        if sub == "count_to" {
            if len(a) >= 4 {
                let m = to_int(a[3])
                let c = count_to_mode(m)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_dmtp(); println("cleaned"); return }
    }
    println("usage: hexa run c_display_mode_transition_perf.hexa { self-test | stats | elapsed <transition_id> | count_to <mode> | cleanup }")
}
