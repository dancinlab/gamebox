// lib/perf/c_kernel32_function_growth.hexa — CN-68 skeleton manjeom 15/15
//
// kernel32 함수 mapping 누적 카운트 + Battle.net-Setup 대비 progress.
// 모든 kernel32 관련 모듈 (base + stage1/2/3 + extras) 의 함수 합산.
//
// 무기: multi-file grep + columnar (per-module function count).
// 효과: closure path B Phase 1 의 function-level coverage 단일 지표.

use "./r0_common"

let KFG_DIR = GAMEBOX_HOME + "/persist/kernel32_function_growth"
let SNAPSHOT_LOG = KFG_DIR + "/snapshots.jsonl"

fn kfg_dir() -> str { return KFG_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + KFG_DIR + "'")
}

// ─── kernel32 관련 모듈 list ───
fn kernel32_modules() -> array {
    return [
        "lib/loader/win32_kernel32.hexa",
        "lib/loader/win32_kernel32_stage1.hexa",
        "lib/loader/win32_kernel32_stage2.hexa",
        "lib/loader/win32_kernel32_stage3.hexa",
        "lib/loader/win32_kernel32_extras.hexa"
    ]
}

// ─── 단일 모듈에서 mapping 함수 수 카운트 ───
//   table 안 "FuncName\t..." 패턴 grep
fn count_in_module(path: str) -> int {
    let exists = exec("test -f '" + path + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    // 패턴: t = t + "<UpperCaseStart><lowercase>...<\t...>"
    let r = exec("grep -E 't = t \\+ \"[A-Z][A-Za-z0-9_]+\\\\t' '" + path + "' 2>/dev/null | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// ─── 전체 누적 카운트 ───
fn total_count() -> int {
    let mods = kernel32_modules()
    let i = 0
    let total = 0
    while i < len(mods) {
        total = total + count_in_module(mods[i])
        i = i + 1
    }
    return total
}

// ─── Battle.net-Setup 대비 progress (224 target) ───
fn bnet_progress() -> array {
    let total = total_count()
    let target = 224  // Battle.net-Setup.exe kernel32 imports
    let pct = 0
    if target > 0 { pct = total * 100 / target }
    return [total, target, pct]
}

// ─── 모듈별 breakdown ───
fn module_breakdown() -> array {
    let mods = kernel32_modules()
    let result = []
    let i = 0
    while i < len(mods) {
        let count = count_in_module(mods[i])
        result = result + [[mods[i], count]]
        i = i + 1
    }
    return result
}

// ─── snapshot 기록 ───
fn record_snapshot() -> array {
    let prog = bnet_progress()
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"total\":" + to_string(prog[0]) + ",\"target\":" + to_string(prog[1]) + ",\"pct\":" + to_string(prog[2]) + "}"
    let tmp = SNAPSHOT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SNAPSHOT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("kernel32_growth", "\"total\":" + to_string(prog[0]) + ",\"target\":" + to_string(prog[1]) + ",\"pct\":" + to_string(prog[2]))
    return prog
}

fn snapshot_count() -> int {
    let exists = exec("test -f '" + SNAPSHOT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + SNAPSHOT_LOG + "' | tr -d ' '").trim())
}

fn cleanup_kfg() -> void {
    let _ = exec("rm -rf '" + KFG_DIR + "'")
}

fn self_test() -> void {
    let sid = "kfg-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_kfg()

    // module list
    let mods = kernel32_modules()
    if len(mods) != 5 { panic("c_kernel32_function_growth FAIL [mod count] expected=5 got=" + to_string(len(mods))) }

    // total — base 50 + extras 45+ = 95+
    let total = total_count()
    if total < 80 {
        panic("c_kernel32_function_growth FAIL [total] expected>=80 got=" + to_string(total))
    }

    // Battle.net progress
    let prog = bnet_progress()
    if prog[0] < 80 { panic("c_kernel32_function_growth FAIL [prog total]") }
    if prog[1] != 224 { panic("c_kernel32_function_growth FAIL [prog target]") }
    if prog[2] < 30 {
        panic("c_kernel32_function_growth FAIL [prog pct] expected>=30 got=" + to_string(prog[2]))
    }

    // breakdown
    let bd = module_breakdown()
    if len(bd) != 5 { panic("c_kernel32_function_growth FAIL [breakdown count]") }

    // snapshot
    let snap = record_snapshot()
    if snap[0] != total { panic("c_kernel32_function_growth FAIL [snap total mismatch]") }

    let cnt_snap = snapshot_count()
    if cnt_snap != 1 { panic("c_kernel32_function_growth FAIL [snap log count]") }

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("c_kernel32_function_growth FAIL [emit count]") }

    cleanup_kfg()

    println("  ✅ c_kernel32_function_growth self_test PASS (5 modules, total=" + to_string(total) + "/224 = " + to_string(prog[2]) + "%, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "snapshot" {
            let p = record_snapshot()
            println("kernel32 functions: " + to_string(p[0]) + "/" + to_string(p[1]) + " (" + to_string(p[2]) + "%)")
            return
        }
        if sub == "breakdown" {
            let bd = module_breakdown()
            let i = 0
            while i < len(bd) {
                println(bd[i][0] + "\t" + to_string(bd[i][1]))
                i = i + 1
            }
            return
        }
        if sub == "stats" { println("snapshots=" + to_string(snapshot_count())); return }
        if sub == "cleanup" { cleanup_kfg(); println("cleaned"); return }
    }
    println("usage: hexa run c_kernel32_function_growth.hexa { self-test | snapshot | breakdown | stats | cleanup }")
}
