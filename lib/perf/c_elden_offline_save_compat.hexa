// lib/perf/c_elden_offline_save_compat.hexa — CN-196 skeleton manjeom 15/15
//
// Elden Ring 의 .sl2 save 파일은 online (FromSoft server, multiplayer) 과
// offline (local-only) 으로 분리된다. offline mode (FromSoft 정식 toggle)
// 사용 시 별도 save 슬롯이 적용되며, online 으로 다시 migrate 할 때 호환성
// 검증이 필요하다. 본 모듈은 save 단위 (save_id × char_level × steam_id_present
// × verified) 의 컬럼 로그/집계만 담당 — 실제 .sl2 binary parse 는 host 측 책임.
//
// 무기: save × level × steam_id × verified 4-key columnar log + sum/count.
// 효과: Elden Ring offline save 호환성 정량화 → online migration 차단 방지.

use "./r0_common"

let EOSC_DIR = GAMEBOX_HOME + "/persist/elden_offline_save_compat"
let SAVE_LOG = EOSC_DIR + "/saves.tsv"

fn eosc_dir() -> str { return EOSC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + EOSC_DIR + "'")
}

// ─── save 등록 ───
//   save_id (.sl2 슬롯 식별자),
//   char_level (캐릭터 레벨),
//   steam_id_present (online steam_id 포함 여부 0/1),
//   verified (offline-compat 검증 통과 여부 0/1).
fn record_save(save_id: int, char_level: int, steam_id_present: int, verified: int) -> void {
    ensure_dir()
    let line = to_string(save_id) + "\t" + to_string(char_level) + "\t" + to_string(steam_id_present) + "\t" + to_string(verified)
    let tmp = SAVE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SAVE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("eosc_record", "\"save\":" + to_string(save_id) + ",\"level\":" + to_string(char_level) + ",\"steam_id\":" + to_string(steam_id_present) + ",\"verified\":" + to_string(verified))
}

// ─── save_count — 등록된 save 행 수 ───
fn save_count() -> int {
    let exists = exec("test -f '" + SAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SAVE_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_levels — 모든 save char_level 합 ───
fn total_levels() -> int {
    let exists = exec("test -f '" + SAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + SAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── steam_id_present_count — steam_id_present=1 인 save 수 ───
fn steam_id_present_count() -> int {
    let exists = exec("test -f '" + SAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==1 {c++} END{print c+0}' '" + SAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── verified_count — verified=1 인 save 수 ───
fn verified_count() -> int {
    let exists = exec("test -f '" + SAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==1 {c++} END{print c+0}' '" + SAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── save_level — save_id 의 char_level 조회 ───
//   미등록이면 0.
fn save_level(save_id: int) -> int {
    let exists = exec("test -f '" + SAVE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(save_id) + " '$1==a {print $2; exit}' '" + SAVE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── eosc_stats — [save_count, total_levels, steam_id_present_count, verified_count] ───
fn eosc_stats() -> array {
    return [save_count(), total_levels(), steam_id_present_count(), verified_count()]
}

fn cleanup_eosc() -> void {
    let _ = exec("rm -rf '" + EOSC_DIR + "'")
}

fn self_test() -> void {
    let sid = "eosc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_eosc()

    // 합성 save 3 종:
    //   50001 — offline char level 50 (verified)
    //   50002 — offline char level 100 (verified)
    //   50003 — online char level 80 backup (steam_id_present, not verified)
    record_save(50001, 50, 0, 1)
    record_save(50002, 100, 0, 1)
    record_save(50003, 80, 1, 0)

    // save_count = 3
    let sc = save_count()
    if sc != 3 { panic("c_elden_offline_save_compat FAIL [save_count] expected=3 got=" + to_string(sc)) }

    // total_levels = 50+100+80 = 230
    let tl = total_levels()
    if tl != 230 { panic("c_elden_offline_save_compat FAIL [total_levels] expected=230 got=" + to_string(tl)) }

    // steam_id_present_count = 1 (50003)
    let sp = steam_id_present_count()
    if sp != 1 { panic("c_elden_offline_save_compat FAIL [steam_id_present_count] expected=1 got=" + to_string(sp)) }

    // verified_count = 2 (50001 + 50002)
    let vc = verified_count()
    if vc != 2 { panic("c_elden_offline_save_compat FAIL [verified_count] expected=2 got=" + to_string(vc)) }

    // save_level lookups
    let l1 = save_level(50001)
    if l1 != 50 { panic("c_elden_offline_save_compat FAIL [save_level 50001] expected=50 got=" + to_string(l1)) }
    let l2 = save_level(50002)
    if l2 != 100 { panic("c_elden_offline_save_compat FAIL [save_level 50002] expected=100 got=" + to_string(l2)) }
    let l3 = save_level(50003)
    if l3 != 80 { panic("c_elden_offline_save_compat FAIL [save_level 50003] expected=80 got=" + to_string(l3)) }
    let l4 = save_level(9999)
    if l4 != 0 { panic("c_elden_offline_save_compat FAIL [save_level unknown] expected=0 got=" + to_string(l4)) }

    let stats = eosc_stats()
    if stats[0] != 3 { panic("c_elden_offline_save_compat FAIL [stats save_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 230 { panic("c_elden_offline_save_compat FAIL [stats total_levels] expected=230 got=" + to_string(stats[1])) }
    if stats[2] != 1 { panic("c_elden_offline_save_compat FAIL [stats steam_id] expected=1 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_elden_offline_save_compat FAIL [stats verified] expected=2 got=" + to_string(stats[3])) }

    r0_emit("eosc_summary", "\"saves\":" + to_string(stats[0]) + ",\"levels\":" + to_string(stats[1]) + ",\"steam_id\":" + to_string(stats[2]) + ",\"verified\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_elden_offline_save_compat FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic Elden Ring retired_intentional posture annotation (Track BE) ───
    //
    // Track BE mission: final 4 c_elden_* completion cycle — Track AS (6) cumulative
    // 6/10 → 10/10 100% terminal coverage. .roadmap.elden_ring blk.1 status_enum_
    // adopted = retired_intentional (block-acknowledged = PASS-equivalent posture,
    // own1 Wine 0 + own2 honest emit, no AC bypass / no anti-tamper bypass). 본
    // module 측 offline save compat 3-save trace (save_id × levels × steam_id ×
    // verified) = synthetic — Steam cloud sync 측 transitive online block, save
    // round-trip honest stub (no bypass). cond.3 status `partial` 영구 유지
    // (retired_intentional posture per blk.1 영구 lock).
    // pattern reference:
    //     lib/perf/c_elden_msix_container_extract.hexa (Track AS predecessor, schema mirror)
    //
    // synthetic posture row column header:
    //     domain                "offline_save_compat"
    //     posture               "retired_intentional"
    //     production_smoke      "no_attempt"
    //     drm_bypass            "0"                    (own1 Wine 0)
    //     ac_bypass             "0"                    (own1 honest acknowledgment)
    //     anti_tamper_bypass    "0"                    (EAC anti-tamper boundary)
    //     blocker_ref           "elden_ring.blk.1"     (eac_anti_tamper)
    //     adoption_iso          "2026-05-03"           (Track C 4-game retired_intentional)
    r0_emit("c_elden_offline_save_compat_retired_intentional",
        "\"stage\":\"elden_ring_dist_synthetic\",\"domain\":\"offline_save_compat\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"ac_bypass\":0,\"anti_tamper_bypass\":0,\"blocker_ref\":\"elden_ring.blk.1\",\"blocker_class\":\"eac_anti_tamper\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"elden_ring.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\",\"track\":\"BE\"")
    println("__ELDEN_OFFLINE_SAVE__ RETIRED_INTENTIONAL elden_ring_dist_synthetic")

    cleanup_eosc()

    println("  ✅ c_elden_offline_save_compat self_test PASS (3 saves, 230 levels, steam_id=1, verified=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = eosc_stats()
            println("saves=" + to_string(s[0]) + " levels=" + to_string(s[1]) + " steam_id=" + to_string(s[2]) + " verified=" + to_string(s[3]))
            return
        }
        if sub == "level" {
            if len(a) >= 4 {
                let sv = to_int(a[3])
                let lv = save_level(sv)
                println(to_string(lv))
                return
            }
        }
        if sub == "cleanup" { cleanup_eosc(); println("cleaned"); return }
    }
    println("usage: hexa run c_elden_offline_save_compat.hexa { self-test | stats | level <save_id> | cleanup }")
}
