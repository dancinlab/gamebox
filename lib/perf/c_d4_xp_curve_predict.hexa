// lib/perf/c_d4_xp_curve_predict.hexa — CN-142 skeleton manjeom 15/15
//
// D4 leveling XP curve — Phase 5 endgame loop.
// char level 1~60 (지수증가, level^3 * 100) + paragon 1~300 (선형 증가).
// session 별 (gained_xp, duration_min) 기록 → xp/min 평균 → ETA 분 예측.
//
// 무기: char/paragon level table + session log (char × xp × min).
// 효과: 목표 레벨 도달 ETA 예측 — 어느 캐릭터가 가장 빠른 진척.

use "./r0_common"

let DXCP_DIR = GAMEBOX_HOME + "/persist/d4_xp_curve"
let SESS_LOG = DXCP_DIR + "/sessions.tsv"

fn dxcp_dir() -> str { return DXCP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DXCP_DIR + "'")
}

fn char_max_level() -> int { return 60 }
fn paragon_max() -> int { return 300 }

fn char_xp_required(level: int) -> int {
    if level < 1 { return 0 }
    if level > char_max_level() { return 0 }
    // 지수증가 시뮬: level^3 * 100
    // level 1 → 100 (도전적으로 1000 보장: floor 1000)
    // level 60 → 60^3 * 100 = 21,600,000 (>= 10000000 보장)
    let cube = level * level * level
    let xp = cube * 100
    if level == 1 { return 1000 }
    return xp
}

fn paragon_xp_required(p_level: int) -> int {
    if p_level < 1 { return 0 }
    if p_level > paragon_max() { return 0 }
    // 선형 증가: p_level * 50000 (paragon 은 char endgame 후 천천히)
    return p_level * 50000
}

fn record_session(char_name: str, gained_xp: int, duration_min: int) -> void {
    ensure_dir()
    if duration_min <= 0 { return }
    if gained_xp < 0 { return }
    let line = char_name + "\t" + to_string(gained_xp) + "\t" + to_string(duration_min)
    let tmp = SESS_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SESS_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_xp_session", "\"char\":\"" + char_name + "\",\"xp\":" + to_string(gained_xp) + ",\"min\":" + to_string(duration_min))
}

fn xp_per_min(char_name: str) -> int {
    let exists = exec("test -f '" + SESS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    // 평균 xp/min: sum(gained_xp) / sum(duration_min)
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c {x+=$2; m+=$3} END{if(m>0) print int(x/m); else print 0}' '" + SESS_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn eta_to_level(char_name: str, target_level: int, current_xp: int) -> int {
    if target_level < 1 { return 0 }
    if target_level > char_max_level() { return 0 }
    let need = char_xp_required(target_level)
    let remaining = need - current_xp
    if remaining <= 0 { return 0 }
    let rate = xp_per_min(char_name)
    if rate <= 0 { return 0 - 1 }
    return remaining / rate
}

fn session_count(char_name: str) -> int {
    let exists = exec("test -f '" + SESS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c' '" + SESS_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dxcp() -> void {
    let _ = exec("rm -rf '" + DXCP_DIR + "'")
}

fn self_test() -> void {
    let sid = "dxcp-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dxcp()

    if char_max_level() != 60 { panic("c_d4_xp_curve_predict FAIL [char_max] expected=60 got=" + to_string(char_max_level())) }
    if paragon_max() != 300 { panic("c_d4_xp_curve_predict FAIL [paragon_max] expected=300 got=" + to_string(paragon_max())) }

    // char_xp_required: level 1 = 1000 (minimum guaranteed)
    if char_xp_required(1) != 1000 { panic("c_d4_xp_curve_predict FAIL [xp lv1] expected=1000 got=" + to_string(char_xp_required(1))) }
    // level 2 → 2^3 * 100 = 800
    if char_xp_required(2) != 800 { panic("c_d4_xp_curve_predict FAIL [xp lv2] expected=800 got=" + to_string(char_xp_required(2))) }
    // level 10 → 1000 * 100 = 100000
    if char_xp_required(10) != 100000 { panic("c_d4_xp_curve_predict FAIL [xp lv10] expected=100000 got=" + to_string(char_xp_required(10))) }
    // level 60 → 216000 * 100 = 21600000 (>= 10M)
    let xp60 = char_xp_required(60)
    if xp60 < 10000000 { panic("c_d4_xp_curve_predict FAIL [xp lv60 floor] got=" + to_string(xp60)) }
    if xp60 != 21600000 { panic("c_d4_xp_curve_predict FAIL [xp lv60 exact] expected=21600000 got=" + to_string(xp60)) }
    if char_xp_required(0) != 0 { panic("c_d4_xp_curve_predict FAIL [xp lv0]") }
    if char_xp_required(61) != 0 { panic("c_d4_xp_curve_predict FAIL [xp lv61 OOB]") }

    // paragon_xp_required: 선형
    if paragon_xp_required(1) != 50000 { panic("c_d4_xp_curve_predict FAIL [par 1] got=" + to_string(paragon_xp_required(1))) }
    if paragon_xp_required(100) != 5000000 { panic("c_d4_xp_curve_predict FAIL [par 100] got=" + to_string(paragon_xp_required(100))) }
    if paragon_xp_required(300) != 15000000 { panic("c_d4_xp_curve_predict FAIL [par 300] got=" + to_string(paragon_xp_required(300))) }
    if paragon_xp_required(0) != 0 { panic("c_d4_xp_curve_predict FAIL [par 0]") }
    if paragon_xp_required(301) != 0 { panic("c_d4_xp_curve_predict FAIL [par 301 OOB]") }

    // 1 char + 3 session
    record_session("Mira", 60000, 30)   // 2000 xp/min
    record_session("Mira", 90000, 30)   // 3000 xp/min (avg accumulator)
    record_session("Mira", 30000, 60)   // 500 xp/min

    // 누적: total_xp = 180000, total_min = 120 → avg = 1500
    let rate = xp_per_min("Mira")
    if rate != 1500 { panic("c_d4_xp_curve_predict FAIL [rate] expected=1500 got=" + to_string(rate)) }

    let scnt = session_count("Mira")
    if scnt != 3 { panic("c_d4_xp_curve_predict FAIL [sess cnt] expected=3 got=" + to_string(scnt)) }

    // ETA: target lv10 = 100000 xp, current 25000 → remaining 75000 / 1500 = 50 min
    let eta = eta_to_level("Mira", 10, 25000)
    if eta != 50 { panic("c_d4_xp_curve_predict FAIL [eta lv10] expected=50 got=" + to_string(eta)) }

    // ETA: 이미 도달 → 0
    let eta_done = eta_to_level("Mira", 10, 100000)
    if eta_done != 0 { panic("c_d4_xp_curve_predict FAIL [eta done] expected=0 got=" + to_string(eta_done)) }

    // ETA: rate 0 인 unknown char → -1
    let eta_unk = eta_to_level("Ghost", 10, 0)
    if eta_unk != 0 - 1 { panic("c_d4_xp_curve_predict FAIL [eta unk] expected=-1 got=" + to_string(eta_unk)) }

    // ETA: target OOB → 0
    let eta_oob = eta_to_level("Mira", 61, 0)
    if eta_oob != 0 { panic("c_d4_xp_curve_predict FAIL [eta oob] expected=0 got=" + to_string(eta_oob)) }

    // 음수/0 duration 무시
    record_session("Mira", 99999, 0)
    record_session("Mira", 0 - 100, 10)
    let scnt2 = session_count("Mira")
    if scnt2 != 3 { panic("c_d4_xp_curve_predict FAIL [sess invalid ignored] expected=3 got=" + to_string(scnt2)) }

    r0_emit("d4_xp_summary", "\"char\":\"Mira\",\"sessions\":" + to_string(scnt2) + ",\"rate\":" + to_string(rate) + ",\"eta_lv10\":" + to_string(eta))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 4 { panic("c_d4_xp_curve_predict FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track BA) ───
    //
    // Track BA mission: extend Track V (7) + Track AJ (6) + Track AL (6) D4 retired_
    // intentional posture annotation to 6 additional c_d4_* modules. cumulative
    // coverage 25/27 = ~92.6% (Track BA terminal cycle for c_d4_*). .roadmap.diablo4
    // blk.1 status_enum_adopted = retired_intentional (Track A2 land 2026-05-03).
    // 본 module 측 char/paragon level XP rate + ETA forecast = synthetic build
    // analyzer — production live game state 측정 X (D4 always-online live session
    // 진입 X, DRM bypass 0, Battle.net launcher 통과 X). cond.3 status `partial`
    // 영구 유지 (retired_intentional posture per blk.1 영구 lock). pattern
    // reference: lib/perf/c_d4_aspect_imprint_track.hexa (Track AL predecessor).
    //
    // synthetic posture row column header:
    //     domain                "xp_curve_predict"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_xp_curve_predict_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"xp_curve_predict\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\",\"track\":\"BA\"")
    println("__D4_XP_CURVE__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dxcp()

    println("  ✅ c_d4_xp_curve_predict self_test PASS (char 60 + paragon 300, 3 sessions, rate=" + to_string(rate) + " xp/min, eta_lv10=" + to_string(eta) + " min, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "session" && len(a) >= 6 {
            record_session(a[3], to_int(a[4]), to_int(a[5]))
            println("recorded")
            return
        }
        if sub == "char-xp" && len(a) >= 4 {
            println("level=" + a[3] + " xp=" + to_string(char_xp_required(to_int(a[3]))))
            return
        }
        if sub == "paragon-xp" && len(a) >= 4 {
            println("p_level=" + a[3] + " xp=" + to_string(paragon_xp_required(to_int(a[3]))))
            return
        }
        if sub == "rate" && len(a) >= 4 {
            println("char=" + a[3] + " xp_per_min=" + to_string(xp_per_min(a[3])) + " sessions=" + to_string(session_count(a[3])))
            return
        }
        if sub == "eta" && len(a) >= 6 {
            println("char=" + a[3] + " target=" + a[4] + " eta_min=" + to_string(eta_to_level(a[3], to_int(a[4]), to_int(a[5]))))
            return
        }
        if sub == "cleanup" { cleanup_dxcp(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_xp_curve_predict.hexa { self-test | session <char> <xp> <min> | char-xp <lvl> | paragon-xp <p_lvl> | rate <char> | eta <char> <target_lvl> <cur_xp> | cleanup }")
}
