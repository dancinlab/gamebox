// lib/perf/c_d4_masterworking_amplify.hexa — CN-186 skeleton manjeom 15/15
//
// D4 Masterworking 시스템 추적 — Tempered item 의 모든 affix 를 4 단계로
// amplify 한다. level 4 / 8 / 12 (= +25% / +50% / +75%) 의 break-point 에서
// 모든 affix 가 일괄 강화되며, 진행은 Pit 에서 획득하는 cinder 자원으로
// 결제된다. Tempering (CN-185) 은 affix 를 add 하는 반면 Masterworking 은
// affix 를 scale 한다는 점이 다르다. 본 모듈은 item × tier × amplify_pct ×
// cinder_cost 4-key 컬럼 로그로 cost/benefit 을 정량화한다.
//
// 무기: item × tier × amplify × cinder 4-key columnar log + sum/filter.
// 효과: D4 Masterworking 진행 cost/benefit 정량화 → tier 12 도달까지의
// cinder 소모와 amplify 누적치 추적.

use "./r0_common"

let DMA_DIR = GAMEBOX_HOME + "/persist/d4_masterworking_amplify"
let MASTER_LOG = DMA_DIR + "/masters.tsv"

fn dma_dir() -> str { return DMA_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMA_DIR + "'")
}

// ─── master 등록 ───
//   item_id     (Tempered item 의 logical id),
//   tier        (Masterworking tier 1..12),
//   amplify_pct (해당 tier 시점의 amplify 누적 %, 4/8/12 → 25/50/75),
//   cinder_cost (이 tier 도달까지 누적 cinder 소모량).
fn record_master(item_id: int, tier: int, amplify_pct: int, cinder_cost: int) -> void {
    ensure_dir()
    let line = to_string(item_id) + "\t" + to_string(tier) + "\t" + to_string(amplify_pct) + "\t" + to_string(cinder_cost)
    let tmp = MASTER_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MASTER_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_master_record", "\"item\":" + to_string(item_id) + ",\"tier\":" + to_string(tier) + ",\"amplify_pct\":" + to_string(amplify_pct) + ",\"cinder\":" + to_string(cinder_cost))
}

// ─── master_count — 등록된 master 행 수 ───
fn master_count() -> int {
    let exists = exec("test -f '" + MASTER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + MASTER_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_amplify_pct — 모든 master amplify_pct 합 ───
fn total_amplify_pct() -> int {
    let exists = exec("test -f '" + MASTER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + MASTER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_cinder_cost — 모든 master cinder_cost 합 ───
fn total_cinder_cost() -> int {
    let exists = exec("test -f '" + MASTER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + MASTER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_tier — 특정 tier 행 수 ───
fn count_by_tier(tier: int) -> int {
    let exists = exec("test -f '" + MASTER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$2==t {c++} END{print c+0}' '" + MASTER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── item_amplify_pct — 특정 item_id 의 amplify_pct 합 ───
//   동일 item_id 가 여러 tier breakpoint 에 걸쳐 기록될 수 있으므로 합산.
//   item_id 미등록이면 0.
fn item_amplify_pct(item_id: int) -> int {
    let exists = exec("test -f '" + MASTER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v i=" + to_string(item_id) + " '$1==i {s+=$3} END{print s+0}' '" + MASTER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dma_stats — [master_count, total_amplify_pct, total_cinder_cost, count_by_tier(12)] ───
fn dma_stats() -> array {
    return [master_count(), total_amplify_pct(), total_cinder_cost(), count_by_tier(12)]
}

fn cleanup_dma() -> void {
    let _ = exec("rm -rf '" + DMA_DIR + "'")
}

fn self_test() -> void {
    let sid = "dma-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dma()

    // 합성 master 3 종 (D4 Masterworking break-point):
    //   item 41001 great helm tier 4   → +25% / 80 cinder
    //   item 41002 sword      tier 8   → +50% / 240 cinder
    //   item 41003 chest      tier 12  → +75% / 480 cinder (max)
    record_master(41001, 4,  25, 80)
    record_master(41002, 8,  50, 240)
    record_master(41003, 12, 75, 480)

    // master_count = 3
    let mc = master_count()
    if mc != 3 { panic("c_d4_masterworking_amplify FAIL [master_count] expected=3 got=" + to_string(mc)) }

    // total_amplify_pct = 25 + 50 + 75 = 150
    let tap = total_amplify_pct()
    if tap != 150 { panic("c_d4_masterworking_amplify FAIL [total_amplify_pct] expected=150 got=" + to_string(tap)) }

    // total_cinder_cost = 80 + 240 + 480 = 800
    let tcc = total_cinder_cost()
    if tcc != 800 { panic("c_d4_masterworking_amplify FAIL [total_cinder_cost] expected=800 got=" + to_string(tcc)) }

    // count_by_tier — 4 / 8 / 12 각 1, 99 는 0
    let c4 = count_by_tier(4)
    if c4 != 1 { panic("c_d4_masterworking_amplify FAIL [count_by_tier 4] expected=1 got=" + to_string(c4)) }
    let c8 = count_by_tier(8)
    if c8 != 1 { panic("c_d4_masterworking_amplify FAIL [count_by_tier 8] expected=1 got=" + to_string(c8)) }
    let c12 = count_by_tier(12)
    if c12 != 1 { panic("c_d4_masterworking_amplify FAIL [count_by_tier 12] expected=1 got=" + to_string(c12)) }
    let c99 = count_by_tier(99)
    if c99 != 0 { panic("c_d4_masterworking_amplify FAIL [count_by_tier 99] expected=0 got=" + to_string(c99)) }

    // item_amplify_pct — 41001/41002/41003 각 25/50/75, 9999 는 0
    let i1 = item_amplify_pct(41001)
    if i1 != 25 { panic("c_d4_masterworking_amplify FAIL [item_amplify 41001] expected=25 got=" + to_string(i1)) }
    let i2 = item_amplify_pct(41002)
    if i2 != 50 { panic("c_d4_masterworking_amplify FAIL [item_amplify 41002] expected=50 got=" + to_string(i2)) }
    let i3 = item_amplify_pct(41003)
    if i3 != 75 { panic("c_d4_masterworking_amplify FAIL [item_amplify 41003] expected=75 got=" + to_string(i3)) }
    let i4 = item_amplify_pct(9999)
    if i4 != 0 { panic("c_d4_masterworking_amplify FAIL [item_amplify unknown] expected=0 got=" + to_string(i4)) }

    let stats = dma_stats()
    if stats[0] != 3 { panic("c_d4_masterworking_amplify FAIL [stats masters] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 150 { panic("c_d4_masterworking_amplify FAIL [stats amplify] expected=150 got=" + to_string(stats[1])) }
    if stats[2] != 800 { panic("c_d4_masterworking_amplify FAIL [stats cinder] expected=800 got=" + to_string(stats[2])) }
    if stats[3] != 1 { panic("c_d4_masterworking_amplify FAIL [stats tier12] expected=1 got=" + to_string(stats[3])) }

    r0_emit("d4_master_summary", "\"masters\":" + to_string(stats[0]) + ",\"amplify_pct\":" + to_string(stats[1]) + ",\"cinder\":" + to_string(stats[2]) + ",\"tier12\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d4_masterworking_amplify FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic D4 masterworking retired_intentional posture annotation (Track V) ───
    //
    // Track V mission: D4 always-online DRM honest spec freeze posture annotation.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land).
    // 본 module 측 masterworking amplification = synthetic master table + tier / cinder
    // — production live game state 측정 X (D4 always-online live session 진입 X, DRM
    // bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_intentional
    // posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "masterworking_amplify"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_masterworking_amplify_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"masterworking_amplify\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_MASTERWORKING__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dma()

    println("  ✅ c_d4_masterworking_amplify self_test PASS (3 masters, amplify=150%, cinder=800, tier12=1, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dma_stats()
            println("masters=" + to_string(s[0]) + " amplify_pct=" + to_string(s[1]) + " cinder=" + to_string(s[2]) + " tier12=" + to_string(s[3]))
            return
        }
        if sub == "amplify" {
            if len(a) >= 4 {
                let iid = to_int(a[3])
                let pct = item_amplify_pct(iid)
                println(to_string(pct))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let t = to_int(a[3])
                let c = count_by_tier(t)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_dma(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_masterworking_amplify.hexa { self-test | stats | amplify <item_id> | count <tier> | cleanup }")
}
