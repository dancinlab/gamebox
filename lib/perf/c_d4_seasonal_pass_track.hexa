// lib/perf/c_d4_seasonal_pass_track.hexa — CN-110 skeleton manjeom 15/15
//
// D4 seasonal pass — Phase 5 endgame loop.
// 90 base tiers + 90 prestige tiers (총 180) — 시즌 진척 추적.
// xp_required(tier) = tier * 1000 (선형), reward_kind = favor / cosmetic / legendary.
//
// 무기: tier table + columnar (tier × xp_required × reward_kind).
// 효과: 시즌 효율적 진행 — 어느 tier 가 가장 가성비 reward.

use "./r0_common"

let DSPT_DIR = GAMEBOX_HOME + "/persist/d4_seasonal_pass"
let PASS_LOG = DSPT_DIR + "/pass.tsv"

fn dspt_dir() -> str { return DSPT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DSPT_DIR + "'")
}

fn max_tier() -> int { return 90 }
fn prestige_max() -> int { return 90 }
fn total_tiers() -> int { return max_tier() + prestige_max() }

fn xp_required(tier: int) -> int {
    if tier < 1 { return 0 }
    if tier > total_tiers() { return 0 }
    // 선형: tier 1 = 1000, tier 90 = 90000, prestige 91..180 동일 공식 (continued linear)
    let base_tier = tier
    if base_tier > max_tier() { base_tier = base_tier - max_tier() }
    return base_tier * 1000
}

fn reward_kind(tier: int) -> str {
    if tier < 1 { return "none" }
    if tier > total_tiers() { return "none" }
    // every 10 = legendary (우선순위 1), odd = favor, even = cosmetic
    let m10 = tier - (tier / 10) * 10
    if m10 == 0 { return "legendary" }
    let m2 = tier - (tier / 2) * 2
    if m2 == 1 { return "favor" }
    return "cosmetic"
}

fn record_progress(char_name: str, tier: int, xp_in_tier: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + PASS_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v t=" + to_string(tier) + " '!($1==c && $2==t)' '" + PASS_LOG + "' > '" + PASS_LOG + ".tmp' && mv '" + PASS_LOG + ".tmp' '" + PASS_LOG + "'")
    }
    let rk = reward_kind(tier)
    let line = char_name + "\t" + to_string(tier) + "\t" + to_string(xp_in_tier) + "\t" + rk
    let tmp = PASS_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PASS_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_pass_progress", "\"char\":\"" + char_name + "\",\"tier\":" + to_string(tier) + ",\"xp\":" + to_string(xp_in_tier) + ",\"reward\":\"" + rk + "\"")
}

fn highest_tier(char_name: str) -> int {
    let exists = exec("test -f '" + PASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c {if($2>m) m=$2} END{print m+0}' '" + PASS_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn total_xp(char_name: str) -> int {
    let exists = exec("test -f '" + PASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    // 누적: 1..(highest-1) 의 xp_required 합 + highest tier 의 xp_in_tier
    let top = highest_tier(char_name)
    if top <= 0 { return 0 }
    let cur = exec("awk -F'\\t' -v c='" + char_name + "' -v t=" + to_string(top) + " '$1==c && $2==t {print $3+0; exit}' '" + PASS_LOG + "'").trim()
    let cur_xp = 0
    if cur != "" { cur_xp = to_int(cur) }
    let sum = 0
    let i = 1
    while i < top {
        sum = sum + xp_required(i)
        i = i + 1
    }
    return sum + cur_xp
}

fn legendary_count(char_name: str) -> int {
    let exists = exec("test -f '" + PASS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c && $4==\"legendary\"' '" + PASS_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dspt() -> void {
    let _ = exec("rm -rf '" + DSPT_DIR + "'")
}

fn self_test() -> void {
    let sid = "dspt-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dspt()

    if max_tier() != 90 { panic("c_d4_seasonal_pass_track FAIL [max_tier] expected=90 got=" + to_string(max_tier())) }
    if prestige_max() != 90 { panic("c_d4_seasonal_pass_track FAIL [prestige_max] expected=90 got=" + to_string(prestige_max())) }
    if total_tiers() != 180 { panic("c_d4_seasonal_pass_track FAIL [total_tiers] expected=180 got=" + to_string(total_tiers())) }

    // xp_required: 선형 검증
    if xp_required(1) != 1000 { panic("c_d4_seasonal_pass_track FAIL [xp t1] got=" + to_string(xp_required(1))) }
    if xp_required(2) != 2000 { panic("c_d4_seasonal_pass_track FAIL [xp t2] got=" + to_string(xp_required(2))) }
    if xp_required(90) != 90000 { panic("c_d4_seasonal_pass_track FAIL [xp t90] got=" + to_string(xp_required(90))) }
    // prestige (91..180) — base reset
    if xp_required(91) != 1000 { panic("c_d4_seasonal_pass_track FAIL [xp t91] got=" + to_string(xp_required(91))) }
    if xp_required(180) != 90000 { panic("c_d4_seasonal_pass_track FAIL [xp t180] got=" + to_string(xp_required(180))) }
    if xp_required(0) != 0 { panic("c_d4_seasonal_pass_track FAIL [xp t0]") }
    if xp_required(181) != 0 { panic("c_d4_seasonal_pass_track FAIL [xp t181 OOB]") }

    // reward_kind: every-10 우선
    if reward_kind(10) != "legendary" { panic("c_d4_seasonal_pass_track FAIL [rw t10] got=" + reward_kind(10)) }
    if reward_kind(20) != "legendary" { panic("c_d4_seasonal_pass_track FAIL [rw t20] got=" + reward_kind(20)) }
    if reward_kind(90) != "legendary" { panic("c_d4_seasonal_pass_track FAIL [rw t90] got=" + reward_kind(90)) }
    if reward_kind(1) != "favor" { panic("c_d4_seasonal_pass_track FAIL [rw t1] got=" + reward_kind(1)) }
    if reward_kind(3) != "favor" { panic("c_d4_seasonal_pass_track FAIL [rw t3] got=" + reward_kind(3)) }
    if reward_kind(2) != "cosmetic" { panic("c_d4_seasonal_pass_track FAIL [rw t2] got=" + reward_kind(2)) }
    if reward_kind(4) != "cosmetic" { panic("c_d4_seasonal_pass_track FAIL [rw t4] got=" + reward_kind(4)) }
    if reward_kind(180) != "legendary" { panic("c_d4_seasonal_pass_track FAIL [rw t180]") }

    // 3 char 등록 + 다양한 tier 도달
    record_progress("Mira", 1, 500)        // favor, partial
    record_progress("Mira", 5, 4000)       // favor, partial
    record_progress("Mira", 10, 0)         // legendary, just hit
    record_progress("Bob", 20, 5000)       // legendary, partial
    record_progress("Bob", 25, 0)          // favor
    record_progress("Cleo", 90, 90000)     // legendary, full
    record_progress("Cleo", 100, 5000)     // prestige (cosmetic — t100 every-10 → legendary)

    let mira_top = highest_tier("Mira")
    if mira_top != 10 { panic("c_d4_seasonal_pass_track FAIL [mira top] expected=10 got=" + to_string(mira_top)) }

    let bob_top = highest_tier("Bob")
    if bob_top != 25 { panic("c_d4_seasonal_pass_track FAIL [bob top] expected=25 got=" + to_string(bob_top)) }

    let cleo_top = highest_tier("Cleo")
    if cleo_top != 100 { panic("c_d4_seasonal_pass_track FAIL [cleo top] expected=100 got=" + to_string(cleo_top)) }

    // total_xp: Mira top=10, sum(1..9)*1000 = 45000, cur (tier 10) = 0 → 45000
    let mira_xp = total_xp("Mira")
    if mira_xp != 45000 { panic("c_d4_seasonal_pass_track FAIL [mira xp] expected=45000 got=" + to_string(mira_xp)) }

    // legendary_count: Mira tier 10 = 1
    let mira_leg = legendary_count("Mira")
    if mira_leg != 1 { panic("c_d4_seasonal_pass_track FAIL [mira leg] expected=1 got=" + to_string(mira_leg)) }

    // Cleo: tier 90 + tier 100 (both legendary)
    let cleo_leg = legendary_count("Cleo")
    if cleo_leg != 2 { panic("c_d4_seasonal_pass_track FAIL [cleo leg] expected=2 got=" + to_string(cleo_leg)) }

    // overwrite (idempotent)
    record_progress("Mira", 10, 500)
    let mira_top2 = highest_tier("Mira")
    if mira_top2 != 10 { panic("c_d4_seasonal_pass_track FAIL [mira overwrite top] expected=10 got=" + to_string(mira_top2)) }
    let mira_xp2 = total_xp("Mira")
    if mira_xp2 != 45500 { panic("c_d4_seasonal_pass_track FAIL [mira overwrite xp] expected=45500 got=" + to_string(mira_xp2)) }

    r0_emit("d4_pass_summary", "\"chars\":3,\"mira_top\":" + to_string(mira_top2) + ",\"cleo_leg\":" + to_string(cleo_leg))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 5 { panic("c_d4_seasonal_pass_track FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track BE) ───
    //
    // Track BE mission: final 2 c_d4_* completion cycle — Track V (7) + Track AJ (6)
    // + Track AL (6) + Track BA (6) cumulative 25/27 → 27/27 100% terminal coverage.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land
    // 2026-05-03). 본 module 측 seasonal pass 180-tier xp curve + 3-char progress +
    // legendary reward count = synthetic build analyzer — production live game state
    // 측정 X (D4 always-online live session 진입 X, DRM bypass 0, Battle.net launcher
    // 통과 X). cond.3 status `partial` 영구 유지 (retired_intentional posture per
    // blk.1 영구 lock). pattern reference: lib/perf/c_d4_xp_curve_predict.hexa
    // (Track BA predecessor).
    //
    // synthetic posture row column header:
    //     domain                "seasonal_pass_track"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_seasonal_pass_track_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"seasonal_pass_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\",\"track\":\"BE\"")
    println("__D4_SEASONAL_PASS__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dspt()

    println("  ✅ c_d4_seasonal_pass_track self_test PASS (180 tiers, xp linear, 3 chars, mira_xp=" + to_string(mira_xp2) + ", cleo_leg=" + to_string(cleo_leg) + ", emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "progress" && len(a) >= 6 {
            record_progress(a[3], to_int(a[4]), to_int(a[5]))
            println("recorded")
            return
        }
        if sub == "reward" && len(a) >= 4 {
            println("tier=" + a[3] + " reward=" + reward_kind(to_int(a[3])) + " xp=" + to_string(xp_required(to_int(a[3]))))
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("char=" + a[3] + " top=" + to_string(highest_tier(a[3])) + " xp=" + to_string(total_xp(a[3])) + " leg=" + to_string(legendary_count(a[3])))
            return
        }
        if sub == "cleanup" { cleanup_dspt(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_seasonal_pass_track.hexa { self-test | progress <char> <tier> <xp> | reward <tier> | stats <char> | cleanup }")
}
