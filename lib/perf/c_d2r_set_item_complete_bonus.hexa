// lib/perf/c_d2r_set_item_complete_bonus.hexa — CN-198 skeleton manjeom 15/15
//
// D2R set item 완성 bonus 추적 — Tal Rasha / Trang-Oul / Immortal King 등 set
// item 시리즈는 일정 piece 수 이상 장착 시 partial bonus, 전 piece 장착 시
// full set bonus (예: Tal Rasha 5/5 = +30% all res, Immortal King 6/6 = +75%
// all res) 가 발동된다. 본 모듈은 set 단위 (set_id × pieces_owned ×
// pieces_total × bonus_pct) 의 진행도를 columnar log 로 누적하여 set item
// progression 정량화 만 담당 — 실제 piece equip 판정은 host 측 책임.
//
// 무기: set × owned × total × bonus 4-key columnar log + sum/complete-count.
// 효과: D2R set item progression 정량화 → partial vs complete set bonus 의
// 효과 (res%, mf%, gf%) 비교 → end-game build 의 set 우선순위 결정.

use "./r0_common"

let DSICB_DIR = GAMEBOX_HOME + "/persist/d2r_set_item_complete_bonus"
let SET_LOG = DSICB_DIR + "/sets.tsv"

fn dsicb_dir() -> str { return DSICB_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DSICB_DIR + "'")
}

// ─── set 등록 ───
//   set_id (Tal Rasha / Immortal King / Trang-Oul 등 set 의 고유 id),
//   pieces_owned (현재 장착 중 piece 수),
//   pieces_total (set 의 전체 piece 수),
//   bonus_pct (해당 owned/total 단계의 bonus % — host 측에서 lookup).
fn record_set(set_id: int, pieces_owned: int, pieces_total: int, bonus_pct: int) -> void {
    ensure_dir()
    let line = to_string(set_id) + "\t" + to_string(pieces_owned) + "\t" + to_string(pieces_total) + "\t" + to_string(bonus_pct)
    let tmp = SET_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SET_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d2r_set_record", "\"set\":" + to_string(set_id) + ",\"owned\":" + to_string(pieces_owned) + ",\"total\":" + to_string(pieces_total) + ",\"bonus_pct\":" + to_string(bonus_pct))
}

// ─── set_record_count — 등록된 set 행 수 ───
fn set_record_count() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SET_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_owned — 모든 set 의 pieces_owned 합 ───
fn total_owned() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_pieces — 모든 set 의 pieces_total 합 ───
fn total_pieces() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_bonus_pct — 모든 set 의 bonus_pct 합 ───
fn total_bonus_pct() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── complete_set_count — pieces_owned == pieces_total 인 set 수 ───
fn complete_set_count() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$2==$3 {c++} END{print c+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── set_bonus — 특정 set_id 의 bonus_pct ───
//   해당 set_id 가 여러 행이면 합산. 미등록이면 0.
fn set_bonus(set_id: int) -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v s=" + to_string(set_id) + " '$1==s {b+=$4} END{print b+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dsicb_stats — [set_record_count, total_owned, total_pieces, complete_set_count] ───
fn dsicb_stats() -> array {
    return [set_record_count(), total_owned(), total_pieces(), complete_set_count()]
}

fn cleanup_dsicb() -> void {
    let _ = exec("rm -rf '" + DSICB_DIR + "'")
}

fn self_test() -> void {
    let sid = "dsicb-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dsicb()

    // 합성 set 3 종:
    //   Tal Rasha 5/5 complete       (id=52001) — owned=5, total=5, bonus=30 (+30% all res)
    //   Immortal King 4/6 partial    (id=52002) — owned=4, total=6, bonus=15 (partial)
    //   Trang-Oul 3/3 complete       (id=52003) — owned=3, total=3, bonus=25 (full set)
    record_set(52001, 5, 5, 30)
    record_set(52002, 4, 6, 15)
    record_set(52003, 3, 3, 25)

    // set_record_count = 3
    let rc = set_record_count()
    if rc != 3 { panic("c_d2r_set_item_complete_bonus FAIL [set_record_count] expected=3 got=" + to_string(rc)) }

    // total_owned = 5+4+3 = 12
    let to = total_owned()
    if to != 12 { panic("c_d2r_set_item_complete_bonus FAIL [total_owned] expected=12 got=" + to_string(to)) }

    // total_pieces = 5+6+3 = 14
    let tp = total_pieces()
    if tp != 14 { panic("c_d2r_set_item_complete_bonus FAIL [total_pieces] expected=14 got=" + to_string(tp)) }

    // total_bonus_pct = 30+15+25 = 70
    let tb = total_bonus_pct()
    if tb != 70 { panic("c_d2r_set_item_complete_bonus FAIL [total_bonus_pct] expected=70 got=" + to_string(tb)) }

    // complete_set_count = 2 (52001 5/5, 52003 3/3)
    let cc = complete_set_count()
    if cc != 2 { panic("c_d2r_set_item_complete_bonus FAIL [complete_set_count] expected=2 got=" + to_string(cc)) }

    // set_bonus per id
    let b1 = set_bonus(52001)
    if b1 != 30 { panic("c_d2r_set_item_complete_bonus FAIL [bonus 52001] expected=30 got=" + to_string(b1)) }
    let b2 = set_bonus(52002)
    if b2 != 15 { panic("c_d2r_set_item_complete_bonus FAIL [bonus 52002] expected=15 got=" + to_string(b2)) }
    let b3 = set_bonus(52003)
    if b3 != 25 { panic("c_d2r_set_item_complete_bonus FAIL [bonus 52003] expected=25 got=" + to_string(b3)) }
    // 미등록 set_id 는 0
    let b4 = set_bonus(9999)
    if b4 != 0 { panic("c_d2r_set_item_complete_bonus FAIL [bonus unknown] expected=0 got=" + to_string(b4)) }

    let stats = dsicb_stats()
    if stats[0] != 3 { panic("c_d2r_set_item_complete_bonus FAIL [stats records] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 12 { panic("c_d2r_set_item_complete_bonus FAIL [stats owned] expected=12 got=" + to_string(stats[1])) }
    if stats[2] != 14 { panic("c_d2r_set_item_complete_bonus FAIL [stats total] expected=14 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_d2r_set_item_complete_bonus FAIL [stats complete] expected=2 got=" + to_string(stats[3])) }

    r0_emit("d2r_set_summary", "\"records\":" + to_string(stats[0]) + ",\"owned\":" + to_string(stats[1]) + ",\"total\":" + to_string(stats[2]) + ",\"complete\":" + to_string(stats[3]) + ",\"bonus_pct\":" + to_string(tb))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d2r_set_item_complete_bonus FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic set item bonus activation round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track U mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic set item activation state machine 3-phase — equip_piece →
    //     count_owned → activate_bonus (set bonus lifecycle):
    //     phase_count                3                  (equip/count/activate)
    //     setitem_table_off          0x140088000        (synthetic SetItems.txt RVA)
    //     activate_kind              "synthetic_inline" (실 set bonus prop X)
    //
    // (b) synthetic complete set scan scaffold — 3 set × owned/total walk:
    //     set_count                  3                  (Tal Rasha / IK / Trang-Oul)
    //     complete_count             2                  (52001 5/5 + 52003 3/3)
    //     partial_count              1                  (52002 4/6 partial bonus)
    //     bonus_total_pct            70                 (30+15+25 sum bonus_pct)
    //     scan_kind                  "synthetic_inline" (실 piece equip 판정 X)
    //
    // round-trip = synthesize_setitem_phase(scaffold) → walk_complete_scan(scaffold).
    //              hexa-native loop only — 실 SetItems.txt 0, real bonus prop 0.
    //
    // synthetic set item phase emit
    r0_emit("c_d2r_set_item_complete_bonus_synthetic_setitem_phase",
        "\"stage\":\"setitem_phase\",\"phase_count\":3,\"setitem_table_off\":\"0x140088000\",\"activate_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_SETITEM__ PARTIAL setitem_phase")

    // synthetic complete scan emit
    r0_emit("c_d2r_set_item_complete_bonus_synthetic_complete_scan",
        "\"stage\":\"complete_scan\",\"set_count\":3,\"complete_count\":2,\"partial_count\":1,\"bonus_total_pct\":70,\"scan_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_SETITEM__ PARTIAL complete_scan")

    cleanup_dsicb()

    println("  ✅ c_d2r_set_item_complete_bonus self_test PASS (3 sets, owned=12/14, complete=2, bonus_pct=70, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dsicb_stats()
            println("records=" + to_string(s[0]) + " owned=" + to_string(s[1]) + " total=" + to_string(s[2]) + " complete=" + to_string(s[3]))
            return
        }
        if sub == "bonus" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                let b = set_bonus(sid)
                println(to_string(b))
                return
            }
        }
        if sub == "cleanup" { cleanup_dsicb(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_set_item_complete_bonus.hexa { self-test | stats | bonus <set_id> | cleanup }")
}
