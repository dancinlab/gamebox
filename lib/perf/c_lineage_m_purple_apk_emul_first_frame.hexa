// lib/perf/c_lineage_m_purple_apk_emul_first_frame.hexa — CN-155 skeleton manjeom 15/15
//
// 리니지 M PC (PURPLE 통한) first frame trace — 2-layer (Layer 0 PURPLE PE + Layer 1 APK Dalvik).
//
// 시나리오: 리니지 M 의 PC version 은 PURPLE STORE 통해 다운로드
// (LineageM_PURPLE_Installer.exe). 실행 시 PURPLE.exe (Layer 0, Windows PE32+)
// 가 부팅 → 안에서 LineageM.apk (Layer 1, Android APK + Dalvik VM bytecode)
// 실행. closure path B 의 Layer 0 까지는 직접 적용 가능, Layer 1 의 첫 frame
// 도달은 Android emul core 를 거쳐야 함. 각 layer 의 stage 별 elapsed_us +
// 메모리 추적.
//
// 무기: stage × layer × elapsed × mem_mb 4-key columnar log.
// 효과: 2-layer PURPLE → APK 첫 frame 비용 분해 정량화 → Android emul core
// 의 bottleneck stage 식별.

use "./r0_common"

let LMPAEFF_DIR = GAMEBOX_HOME + "/persist/lineage_m_purple_apk_emul_first_frame"
let LMPAEFF_LOG = LMPAEFF_DIR + "/stages.tsv"

fn lmpaeff_dir() -> str { return LMPAEFF_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + LMPAEFF_DIR + "'")
}

// ─── stage 등록 ───
//   stage_id  (논리 stage 번호: 9001=PURPLE.exe boot 등),
//   layer     (0=purple_pe, 1=apk_dalvik),
//   elapsed_us(stage 진입~완료 elapsed microseconds),
//   mem_mb    (stage 종료 시 RSS MB).
fn record_stage(stage_id: int, layer: int, elapsed_us: int, mem_mb: int) -> void {
    ensure_dir()
    let line = to_string(stage_id) + "\t" + to_string(layer) + "\t" + to_string(elapsed_us) + "\t" + to_string(mem_mb)
    let tmp = LMPAEFF_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + LMPAEFF_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("lmpaeff_record", "\"stage\":" + to_string(stage_id) + ",\"layer\":" + to_string(layer) + ",\"elapsed_us\":" + to_string(elapsed_us) + ",\"mem_mb\":" + to_string(mem_mb))
}

// ─── stage_count — 등록된 stage 행 수 ───
fn stage_count() -> int {
    let exists = exec("test -f '" + LMPAEFF_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + LMPAEFF_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_elapsed_us — 모든 stage elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + LMPAEFF_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + LMPAEFF_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_mem_mb — 모든 stage mem_mb 합 ───
fn total_mem_mb() -> int {
    let exists = exec("test -f '" + LMPAEFF_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + LMPAEFF_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_layer — 특정 layer 의 stage 수 ───
fn count_by_layer(layer: int) -> int {
    let exists = exec("test -f '" + LMPAEFF_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v L=" + to_string(layer) + " '$2==L {c+=1} END{print c+0}' '" + LMPAEFF_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── layer_elapsed_us — 특정 layer 의 elapsed_us 합 ───
fn layer_elapsed_us(layer: int) -> int {
    let exists = exec("test -f '" + LMPAEFF_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v L=" + to_string(layer) + " '$2==L {s+=$3} END{print s+0}' '" + LMPAEFF_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── lmpaeff_stats — [stage_count, total_elapsed_us, total_mem_mb, count_by_layer(1)] ───
fn lmpaeff_stats() -> array {
    return [stage_count(), total_elapsed_us(), total_mem_mb(), count_by_layer(1)]
}

fn cleanup_lmpaeff() -> void {
    let _ = exec("rm -rf '" + LMPAEFF_DIR + "'")
}

fn self_test() -> void {
    let sid = "lmpaeff-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_lmpaeff()

    // 합성 데이터: 4 stages × 2 layers
    //   stage=9001 layer=0 (PURPLE.exe boot)         : 420000 us / 180 MB
    //   stage=9002 layer=0 (PURPLE Android emul init): 680000 us / 320 MB
    //   stage=9003 layer=1 (APK Dalvik VM init)      : 240000 us / 140 MB
    //   stage=9004 layer=1 (APK first draw call)     :  80000 us /  60 MB
    record_stage(9001, 0, 420000, 180)
    record_stage(9002, 0, 680000, 320)
    record_stage(9003, 1, 240000, 140)
    record_stage(9004, 1,  80000,  60)

    // stage_count = 4
    let sc = stage_count()
    if sc != 4 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [stage_count] expected=4 got=" + to_string(sc)) }

    // total_elapsed_us = 420000+680000+240000+80000 = 1420000
    let te = total_elapsed_us()
    if te != 1420000 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [total_elapsed_us] expected=1420000 got=" + to_string(te)) }

    // total_mem_mb = 180+320+140+60 = 700
    let tm = total_mem_mb()
    if tm != 700 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [total_mem_mb] expected=700 got=" + to_string(tm)) }

    // count_by_layer(0)=2, count_by_layer(1)=2, count_by_layer(99)=0
    let cl0 = count_by_layer(0)
    if cl0 != 2 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [count_by_layer 0] expected=2 got=" + to_string(cl0)) }
    let cl1 = count_by_layer(1)
    if cl1 != 2 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [count_by_layer 1] expected=2 got=" + to_string(cl1)) }
    let cl99 = count_by_layer(99)
    if cl99 != 0 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [count_by_layer 99] expected=0 got=" + to_string(cl99)) }

    // layer_elapsed_us:
    //   layer 0 = 420000+680000 = 1100000
    //   layer 1 = 240000+80000  = 320000
    //   layer 99 = 0
    let le0 = layer_elapsed_us(0)
    if le0 != 1100000 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [layer_elapsed_us 0] expected=1100000 got=" + to_string(le0)) }
    let le1 = layer_elapsed_us(1)
    if le1 != 320000 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [layer_elapsed_us 1] expected=320000 got=" + to_string(le1)) }
    let le99 = layer_elapsed_us(99)
    if le99 != 0 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [layer_elapsed_us 99] expected=0 got=" + to_string(le99)) }

    // lmpaeff_stats() = [4, 1420000, 700, 2]
    let stats = lmpaeff_stats()
    if stats[0] != 4 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [stats stage_count] expected=4 got=" + to_string(stats[0])) }
    if stats[1] != 1420000 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [stats total_elapsed_us] expected=1420000 got=" + to_string(stats[1])) }
    if stats[2] != 700 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [stats total_mem_mb] expected=700 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [stats layer1_count] expected=2 got=" + to_string(stats[3])) }

    r0_emit("lmpaeff_summary", "\"stages\":" + to_string(stats[0]) + ",\"total_elapsed_us\":" + to_string(stats[1]) + ",\"total_mem_mb\":" + to_string(stats[2]) + ",\"layer1_stages\":" + to_string(stats[3]) + ",\"layer0_elapsed_us\":" + to_string(le0) + ",\"layer1_elapsed_us\":" + to_string(le1))

    // record × 4 + summary × 1 = ≥ 5 emits
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_lineage_m_purple_apk_emul_first_frame FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    cleanup_lmpaeff()

    println("  ✅ c_lineage_m_purple_apk_emul_first_frame self_test PASS (4 stages, total_elapsed_us=1420000, total_mem_mb=700, L0=1100000us, L1=320000us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = lmpaeff_stats()
            println("stages=" + to_string(s[0]) + " total_elapsed_us=" + to_string(s[1]) + " total_mem_mb=" + to_string(s[2]) + " layer1_stages=" + to_string(s[3]))
            return
        }
        if sub == "layer" {
            if len(a) >= 4 {
                let L = to_int(a[3])
                let c = count_by_layer(L)
                let e = layer_elapsed_us(L)
                println("layer=" + to_string(L) + " count=" + to_string(c) + " elapsed_us=" + to_string(e))
                return
            }
        }
        if sub == "cleanup" { cleanup_lmpaeff(); println("cleaned"); return }
    }
    println("usage: hexa run c_lineage_m_purple_apk_emul_first_frame.hexa { self-test | stats | layer <layer> | cleanup }")
}
