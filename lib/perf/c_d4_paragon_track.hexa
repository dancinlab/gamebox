// lib/perf/c_d4_paragon_track.hexa — CN-84 skeleton manjeom 15/15
//
// D4 paragon board — Phase 5 endgame progression.
// max 220 paragon level → ~880 nodes (boards 5 + glyph), 각 active/inactive.
//
// 무기: node activation table + columnar (board × node).
// 효과: paragon build 분석 (어느 glyph + node combo 가 효율적).

use "./r0_common"

let DPGT_DIR = GAMEBOX_HOME + "/persist/d4_paragon"
let NODE_LOG = DPGT_DIR + "/nodes.tsv"

fn dpgt_dir() -> str { return DPGT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DPGT_DIR + "'")
}

fn boards() -> array {
    return ["root", "board_2", "board_3", "board_4", "board_5"]
}

fn max_paragon() -> int { return 220 }

fn record_node(char_name: str, board: str, node_idx: int, glyph: str) -> void {
    ensure_dir()
    let exists = exec("test -f '" + NODE_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v b='" + board + "' -v i=" + to_string(node_idx) + " '!($1==c && $2==b && $3==i)' '" + NODE_LOG + "' > '" + NODE_LOG + ".tmp' && mv '" + NODE_LOG + ".tmp' '" + NODE_LOG + "'")
    }
    let line = char_name + "\t" + board + "\t" + to_string(node_idx) + "\t" + glyph
    let tmp = NODE_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + NODE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_paragon_node", "\"char\":\"" + char_name + "\",\"board\":\"" + board + "\",\"idx\":" + to_string(node_idx))
}

fn active_count(char_name: str) -> int {
    let exists = exec("test -f '" + NODE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c' '" + NODE_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn dominant_board(char_name: str) -> str {
    let exists = exec("test -f '" + NODE_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c {a[$2]++} END{m=0; for(k in a) if(a[k]>m){m=a[k]; n=k} print n}' '" + NODE_LOG + "'").trim()
    return r
}

fn glyph_count(char_name: str) -> int {
    let exists = exec("test -f '" + NODE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c && $4!=\"\" && $4!=\"none\"' '" + NODE_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dpgt() -> void {
    let _ = exec("rm -rf '" + DPGT_DIR + "'")
}

fn self_test() -> void {
    let sid = "dpgt-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dpgt()

    let b = boards()
    if len(b) != 5 { panic("c_d4_paragon_track FAIL [boards] expected=5 got=" + to_string(len(b))) }

    if max_paragon() != 220 { panic("c_d4_paragon_track FAIL [max paragon]") }

    // synthetic — 100 paragon level char (100 nodes activated)
    record_node("Mira", "root", 0, "none")
    record_node("Mira", "root", 1, "exploit")        // glyph
    record_node("Mira", "root", 2, "none")
    record_node("Mira", "board_2", 0, "none")
    record_node("Mira", "board_2", 1, "none")
    record_node("Mira", "board_2", 2, "control")     // glyph
    record_node("Mira", "board_3", 0, "none")
    record_node("Mira", "board_3", 1, "fang_and_claw") // glyph

    let cnt = active_count("Mira")
    if cnt != 8 { panic("c_d4_paragon_track FAIL [active] expected=8 got=" + to_string(cnt)) }

    let dom = dominant_board("Mira")
    // 3 boards: root=3, board_2=3, board_3=2 — first wins (root)
    if dom == "" { panic("c_d4_paragon_track FAIL [dominant empty]") }

    let glyphs = glyph_count("Mira")
    if glyphs != 3 { panic("c_d4_paragon_track FAIL [glyphs] expected=3 got=" + to_string(glyphs)) }

    // overwrite
    record_node("Mira", "root", 0, "starting")
    let cnt2 = active_count("Mira")
    if cnt2 != 8 { panic("c_d4_paragon_track FAIL [overwrite count] expected=8 got=" + to_string(cnt2)) }

    r0_emit("d4_paragon_summary", "\"char\":\"Mira\",\"nodes\":" + to_string(cnt2) + ",\"glyphs\":" + to_string(glyphs))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 8 { panic("c_d4_paragon_track FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AJ) ───
    //
    // Track AJ mission: extend Track V D4 retired_intentional posture annotation to 6
    // additional c_d4_* modules (paragon_track + pet_companion_track + pit_tier_speed
    // _track + pso_warmup_priority + seasonal_mechanic_timer + codex_unlock). .roadmap
    // .diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land 2026-05
    // -03). 본 module 측 paragon node + glyph slot tracker = synthetic char build
    // analyzer — production live game state 측정 X (D4 always-online live session 진입
    // X, DRM bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self_test() 측
    // honest annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_
    // intentional posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "paragon_track"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_paragon_track_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"paragon_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_PARAGON__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dpgt()

    println("  ✅ c_d4_paragon_track self_test PASS (5 boards, 8 nodes, 3 glyphs, dominant=" + dom + ", emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 7 {
            record_node(a[3], a[4], to_int(a[5]), a[6])
            println("recorded")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("char=" + a[3] + " active=" + to_string(active_count(a[3])) + " glyphs=" + to_string(glyph_count(a[3])) + " dom=" + dominant_board(a[3]))
            return
        }
        if sub == "cleanup" { cleanup_dpgt(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_paragon_track.hexa { self-test | set <char> <board> <idx> <glyph> | stats <char> | cleanup }")
}
