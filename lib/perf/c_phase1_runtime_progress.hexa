// lib/perf/c_phase1_runtime_progress.hexa — CN-95 skeleton manjeom 15/15
//
// Phase 1 runtime 진척률 통합 — 6 sub-step 의 현재 stage 추적.
// pe_parse / pe_runtime_map / iat_bind / dll_resolve / relocation / entry_call.
//
// 무기: sub-step table + columnar (step × stage × pct).
// 효과: closure path B Phase 1 진척 시각화 — real runtime 단계의 dashboard.

use "./r0_common"

let CPRP_DIR = GAMEBOX_HOME + "/persist/phase1_runtime_progress"
let STEP_LOG = CPRP_DIR + "/steps.tsv"

fn cprp_dir() -> str { return CPRP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CPRP_DIR + "'")
}

fn substeps() -> array {
    return ["pe_parse", "pe_runtime_map", "iat_bind", "dll_resolve", "relocation", "entry_call"]
}

fn stage_score(stage: str) -> int {
    if stage == "skeleton" { return 25 }
    if stage == "stage1" { return 50 }
    if stage == "stage2" { return 75 }
    if stage == "validated" { return 100 }
    return 0
}

fn record_step(name: str, stage: str) -> void {
    ensure_dir()
    let exists = exec("test -f '" + STEP_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v n='" + name + "' '$1!=n' '" + STEP_LOG + "' > '" + STEP_LOG + ".tmp' && mv '" + STEP_LOG + ".tmp' '" + STEP_LOG + "'")
    }
    let line = name + "\t" + stage + "\t" + to_string(stage_score(stage))
    let tmp = STEP_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + STEP_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("phase1_step", "\"step\":\"" + name + "\",\"stage\":\"" + stage + "\"")
}

fn step_stage(name: str) -> str {
    let exists = exec("test -f '" + STEP_LOG + "' && echo ok").trim()
    if exists != "ok" { return "none" }
    let r = exec("awk -F'\\t' -v n='" + name + "' '$1==n {print $2}' '" + STEP_LOG + "' | head -1").trim()
    if r == "" { return "none" }
    return r
}

fn phase1_pct() -> int {
    let s = substeps()
    let i = 0
    let total = 0
    while i < len(s) {
        let stg = step_stage(s[i])
        total = total + stage_score(stg)
        i = i + 1
    }
    return total / len(s)
}

fn cleanup_cprp() -> void {
    let _ = exec("rm -rf '" + CPRP_DIR + "'")
}

fn self_test() -> void {
    let sid = "cprp-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cprp()

    let s = substeps()
    if len(s) != 6 { panic("c_phase1_runtime_progress FAIL [substeps] expected=6 got=" + to_string(len(s))) }

    let p0 = phase1_pct()
    if p0 != 0 { panic("c_phase1_runtime_progress FAIL [empty pct]") }

    // 현재 실 상태 (cycle 39 시점)
    record_step("pe_parse", "stage2")          // pe_loader_stage1 잘 동작
    record_step("pe_runtime_map", "stage1")    // cycle 38 stage1
    record_step("iat_bind", "stage1")          // cycle 38 stage1
    record_step("dll_resolve", "stage1")       // cycle 39 stage1
    record_step("relocation", "skeleton")      // pe_relocations skeleton
    record_step("entry_call", "stage1")        // cycle 39 stage1

    let pct = phase1_pct()
    // (75+50+50+50+25+50)/6 = 300/6 = 50
    if pct != 50 { panic("c_phase1_runtime_progress FAIL [pct] expected=50 got=" + to_string(pct)) }

    let pe_stage = step_stage("pe_parse")
    if pe_stage != "stage2" { panic("c_phase1_runtime_progress FAIL [pe stage]") }

    // 모두 validated 가정
    record_step("pe_parse", "validated")
    record_step("pe_runtime_map", "validated")
    record_step("iat_bind", "validated")
    record_step("dll_resolve", "validated")
    record_step("relocation", "validated")
    record_step("entry_call", "validated")

    let pct_v = phase1_pct()
    if pct_v != 100 { panic("c_phase1_runtime_progress FAIL [validated pct] expected=100 got=" + to_string(pct_v)) }

    r0_emit("phase1_progress_summary", "\"substeps\":6,\"pct\":" + to_string(pct))

    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_phase1_runtime_progress FAIL [emit] got=" + to_string(cnt)) }

    cleanup_cprp()

    println("  ✅ c_phase1_runtime_progress self_test PASS (6 substeps, current state=50% (stage1 mostly), validated → 100%, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 5 {
            record_step(a[3], a[4])
            println("recorded")
            return
        }
        if sub == "pct" { println(to_string(phase1_pct()) + "%"); return }
        if sub == "stage" && len(a) >= 4 { println(step_stage(a[3])); return }
        if sub == "cleanup" { cleanup_cprp(); println("cleaned"); return }
    }
    println("usage: hexa run c_phase1_runtime_progress.hexa { self-test | set <step> <stage> | pct | stage <step> | cleanup }")
}
