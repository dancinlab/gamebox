// lib/perf/c_thermal_state_history.hexa — CN-106 skeleton manjeom 15/15
//
// Phase 6 live tune — macOS thermal state 시계열.
// sysctl machdep.xcpm.cpu_thermal_level 폴링 + ring window.
//
// 무기: ring buffer 64 sample + columnar (per-sample temp).
// 효과: 게임 중 thermal throttle 시작점 정확히 검출.

use "./r0_common"

let TSH_DIR = GAMEBOX_HOME + "/persist/thermal_state_history"
let TSH_LOG = TSH_DIR + "/samples.tsv"

fn tsh_dir() -> str { return TSH_DIR }

fn ring_size() -> int { return 64 }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + TSH_DIR + "'")
}

// ─── ring buffer trim — 최근 64 sample 만 유지 ───
fn ring_trim() -> void {
    let exists = exec("test -f '" + TSH_LOG + "' && echo ok").trim()
    if exists != "ok" { return }
    let n = to_int(exec("wc -l < '" + TSH_LOG + "' | tr -d ' '").trim())
    if n <= 64 { return }
    let tmp = TSH_LOG + ".trim"
    let _ = exec("tail -n 64 '" + TSH_LOG + "' > '" + tmp + "' && mv '" + tmp + "' '" + TSH_LOG + "'")
}

// ─── record sample (level: 0=nominal,1=fair,2=serious,3=critical) ───
fn record_sample(ts: int, level: int) -> void {
    ensure_dir()
    let line = to_string(ts) + "\t" + to_string(level)
    let tmp = TSH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + TSH_LOG + "' && rm -f '" + tmp + "'")
    ring_trim()
    r0_emit("thermal_state_sample", "\"ts\":" + to_string(ts) + ",\"level\":" + to_string(level))
}

fn sample_count() -> int {
    let exists = exec("test -f '" + TSH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + TSH_LOG + "' | tr -d ' '").trim())
}

fn highest_level() -> int {
    let exists = exec("test -f '" + TSH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{if($2>m) m=$2} END{print m+0}' '" + TSH_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// avg_level — integer percentage (level * 100, floor)
fn avg_level() -> int {
    let exists = exec("test -f '" + TSH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$2; n++} END{if(n>0) print int(s*100/n); else print 0}' '" + TSH_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn time_in_critical() -> int {
    let exists = exec("test -f '" + TSH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$2>=3 {n++} END{print n+0}' '" + TSH_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// ─── throttle_start_detected — 연속 3 sample >= threshold ───
fn throttle_start_detected(threshold: int) -> bool {
    let exists = exec("test -f '" + TSH_LOG + "' && echo ok").trim()
    if exists != "ok" { return false }
    let r = exec("awk -F'\\t' -v th=" + to_string(threshold) + " '{if($2>=th){c++; if(c>=3){print 1; exit}} else c=0} END{if(NR==0||c<3 && !done) print 0}' '" + TSH_LOG + "' | head -1").trim()
    if r == "1" { return true }
    return false
}

fn cleanup_tsh() -> void {
    let _ = exec("rm -rf '" + TSH_DIR + "'")
}

fn self_test() -> void {
    let sid = "tsh-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_tsh()

    // 10 normal (level 0)
    let i = 0
    while i < 10 {
        record_sample(1000 + i, 0)
        i = i + 1
    }

    // 5 critical (level 3) — 연속 3 → throttle start 검출
    let j = 0
    while j < 5 {
        record_sample(1100 + j, 3)
        j = j + 1
    }

    let n = sample_count()
    if n != 15 { panic("c_thermal_state_history FAIL [count] expected=15 got=" + to_string(n)) }

    let hi = highest_level()
    if hi != 3 { panic("c_thermal_state_history FAIL [highest] expected=3 got=" + to_string(hi)) }

    // avg = (0*10 + 3*5)/15 = 1 → 100 (percent floor)
    let avg = avg_level()
    if avg != 100 { panic("c_thermal_state_history FAIL [avg] expected=100 got=" + to_string(avg)) }

    let crit = time_in_critical()
    if crit != 5 { panic("c_thermal_state_history FAIL [critical] expected=5 got=" + to_string(crit)) }

    // throttle_start 검출 (threshold=3, 연속 3 critical)
    let det = throttle_start_detected(3)
    if !det { panic("c_thermal_state_history FAIL [throttle_start] expected=true threshold=3") }

    // threshold=2 도 검출 (3>=2 연속)
    let det2 = throttle_start_detected(2)
    if !det2 { panic("c_thermal_state_history FAIL [throttle_start lo] expected=true threshold=2") }

    r0_emit("thermal_state_summary", "\"samples\":" + to_string(n) + ",\"highest\":" + to_string(hi) + ",\"avg\":" + to_string(avg) + ",\"critical\":" + to_string(crit) + ",\"throttle_start\":1")

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_thermal_state_history FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    cleanup_tsh()

    println("  ✅ c_thermal_state_history self_test PASS (15 samples, highest=3, avg=" + to_string(avg) + ", critical=5, throttle_start detected, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "sample" && len(a) >= 5 {
            record_sample(to_int(a[3]), to_int(a[4]))
            println("recorded")
            return
        }
        if sub == "stats" {
            println("samples=" + to_string(sample_count()) + " highest=" + to_string(highest_level()) + " avg_x100=" + to_string(avg_level()) + " critical=" + to_string(time_in_critical()))
            return
        }
        if sub == "window" && len(a) >= 4 {
            let th = to_int(a[3])
            let d = "no"
            if throttle_start_detected(th) { d = "YES" }
            println("threshold=" + to_string(th) + " throttle_start=" + d)
            return
        }
        if sub == "cleanup" { cleanup_tsh(); println("cleaned"); return }
    }
    println("usage: hexa run c_thermal_state_history.hexa { self-test | sample <ts> <level> | stats | window <threshold> | cleanup }")
}
