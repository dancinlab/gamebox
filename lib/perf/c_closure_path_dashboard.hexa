// lib/perf/c_closure_path_dashboard.hexa — CN-62 만점 15/15
//
// closure path B 종합 dashboard — DLL coverage + IAT resolution + manjeom + commits.
// 단일 명령어로 6-12개월 path 의 현재 진척률 조회.
//
// 무기: aggregator (다른 모듈 호출 + 종합) + columnar (단일 timestamp snapshot).
// 효과: closure path B 의 사용자-읽기 status 보고.

use "./r0_common"

let CDB_DIR = GAMEBOX_HOME + "/persist/closure_path_dashboard"
let SNAPSHOT_LOG = CDB_DIR + "/snapshots.jsonl"

fn cdb_dir() -> str { return CDB_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CDB_DIR + "'")
}

// ─── DLL adapter 수 (lib/loader/win32_*.hexa 파일 카운트) ───
fn count_dll_adapters() -> int {
    let r = exec("ls lib/loader/win32_*.hexa 2>/dev/null | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// ─── manjeom 수 (lib/perf/c_*.hexa 파일 카운트 — 보조 + harvest 등 제외 어려움 — 단순화) ───
fn count_perf_modules() -> int {
    let r = exec("ls lib/perf/c_*.hexa 2>/dev/null | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// ─── git commit 수 ───
fn count_commits() -> int {
    let r = exec("git rev-list --count HEAD 2>/dev/null").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// ─── git latest commit hash ───
fn latest_commit() -> str {
    let r = exec("git log -1 --format='%h %s' 2>/dev/null").trim()
    return r
}

// ─── Battle.net-Setup.exe target — 16 DLL 중 mapped 수 ───
fn bnet_dll_mapped() -> int {
    let mapped = 0
    let bnet_dlls = ["kernel32", "user32", "gdi32", "advapi32", "msvcrt", "ntdll", "winsock", "shell32", "ole32", "oleaut32", "wintrust", "version", "msimg32", "rpcrt4", "uiautomationcore"]
    let i = 0
    while i < len(bnet_dlls) {
        let p = "lib/loader/win32_" + bnet_dlls[i] + ".hexa"
        let exists = exec("test -f '" + p + "' && echo ok").trim()
        if exists == "ok" { mapped = mapped + 1 }
        i = i + 1
    }
    return mapped
}

// ─── snapshot 기록 ───
fn record_snapshot() -> array {
    let dlls = count_dll_adapters()
    let perfs = count_perf_modules()
    let commits = count_commits()
    let bnet = bnet_dll_mapped()
    let target = 16  // Battle.net-Setup.exe DLL count
    let pct = bnet * 100 / target
    let ts = exec("date +%s").trim()
    ensure_dir()
    let line = "{\"ts\":" + ts + ",\"dll_adapters\":" + to_string(dlls) + ",\"perf_modules\":" + to_string(perfs) + ",\"commits\":" + to_string(commits) + ",\"bnet_dll_mapped\":" + to_string(bnet) + ",\"bnet_dll_target\":" + to_string(target) + ",\"bnet_pct\":" + to_string(pct) + "}"
    let tmp = SNAPSHOT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SNAPSHOT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("closure_dashboard_snapshot", "\"dll_adapters\":" + to_string(dlls) + ",\"perf_modules\":" + to_string(perfs) + ",\"bnet_pct\":" + to_string(pct))
    return [dlls, perfs, commits, bnet, target, pct]
}

fn snapshot_count() -> int {
    let exists = exec("test -f '" + SNAPSHOT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + SNAPSHOT_LOG + "' | tr -d ' '").trim())
}

fn cleanup_cdb() -> void {
    let _ = exec("rm -rf '" + CDB_DIR + "'")
}

fn self_test() -> void {
    let sid = "cdb-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cdb()

    // counts
    let dlls = count_dll_adapters()
    if dlls < 10 { panic("c_closure_path_dashboard FAIL [dll count too low] got=" + to_string(dlls)) }

    let perfs = count_perf_modules()
    if perfs < 50 { panic("c_closure_path_dashboard FAIL [perf count too low] got=" + to_string(perfs)) }

    let bnet = bnet_dll_mapped()
    if bnet < 7 { panic("c_closure_path_dashboard FAIL [bnet mapped too low] got=" + to_string(bnet)) }

    let commits = count_commits()
    if commits < 0 { panic("c_closure_path_dashboard FAIL [commits negative]") }

    let last = latest_commit()
    // latest_commit() returns "" when git unavailable (Docker sandbox); allow.

    // snapshot
    let snap = record_snapshot()
    if snap[0] != dlls { panic("c_closure_path_dashboard FAIL [snap dlls]") }
    if snap[3] < 7 { panic("c_closure_path_dashboard FAIL [snap bnet]") }

    let cnt_snap = snapshot_count()
    if cnt_snap != 1 { panic("c_closure_path_dashboard FAIL [snap count] expected=1 got=" + to_string(cnt_snap)) }

    let cnt = r0_session_count(sid)
    if cnt < 1 { panic("c_closure_path_dashboard FAIL [emit count]") }

    cleanup_cdb()

    println("  ✅ c_closure_path_dashboard self_test PASS (DLLs=" + to_string(dlls) + ", perf=" + to_string(perfs) + ", bnet=" + to_string(bnet) + "/16 = " + to_string(snap[5]) + "%, commits=" + to_string(commits) + ", emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "snapshot" {
            let r = record_snapshot()
            println("=== closure path B Dashboard ===")
            println("DLL adapters:        " + to_string(r[0]))
            println("perf modules:        " + to_string(r[1]))
            println("git commits:         " + to_string(r[2]))
            println("Battle.net DLLs:     " + to_string(r[3]) + " / " + to_string(r[4]) + " (" + to_string(r[5]) + "%)")
            println("latest:              " + latest_commit())
            return
        }
        if sub == "stats" {
            println("snapshots=" + to_string(snapshot_count()))
            return
        }
        if sub == "cleanup" { cleanup_cdb(); println("cleaned"); return }
    }
    println("usage: hexa run c_closure_path_dashboard.hexa { self-test | snapshot | stats | cleanup }")
}
