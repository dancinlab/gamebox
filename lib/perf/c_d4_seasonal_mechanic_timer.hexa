// lib/perf/c_d4_seasonal_mechanic_timer.hexa — CN-202 skeleton manjeom 15/15
//
// D4 Seasonal Realm 시즌 mechanic timer 추적 — Diablo IV 의 Seasonal Realm 은
// 매 시즌 ~3 month 주기로 새 mechanic 을 도입한다 (Season 1 Malignant Hearts,
// Season 2 Vampires, Season 3 Constructs, Season 4 Tempering, Season 5 Infernal
// Hordes 등). 본 모듈은 season × start_us × end_us × mechanic_kind 4-key 컬럼
// 로그를 누적하여 시즌 길이 / 진행 mechanic 분포 / 다음 시즌 ETA forecast 를
// 위한 정량 데이터를 제공한다 — 실제 in-game season fetch 는 host 측 책임.
//
// 무기: season × start × end × kind 4-key columnar log + sum/group-by-kind.
// 효과: D4 seasonal progression (mechanic 종류 / 누적 duration) 정량화.

use "./r0_common"

let DSMT_DIR = GAMEBOX_HOME + "/persist/d4_seasonal_mechanic_timer"
let SEASON_LOG = DSMT_DIR + "/seasons.tsv"

fn dsmt_dir() -> str { return DSMT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DSMT_DIR + "'")
}

// ─── season 등록 ───
//   season_id     (Diablo IV Seasonal Realm 시즌 일련번호 — 1, 2, 3, ...),
//   start_us      (시즌 시작 microsecond epoch — host 측 측정),
//   end_us        (시즌 종료 microsecond epoch — 진행 중이면 forecast ETA),
//   mechanic_kind (1=hearts, 2=vampires, 3=constructs, 4=tempering, 5=horde).
fn record_season(season_id: int, start_us: int, end_us: int, mechanic_kind: int) -> void {
    ensure_dir()
    let line = to_string(season_id) + "\t" + to_string(start_us) + "\t" + to_string(end_us) + "\t" + to_string(mechanic_kind)
    let tmp = SEASON_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SEASON_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_season_record", "\"season\":" + to_string(season_id) + ",\"start_us\":" + to_string(start_us) + ",\"end_us\":" + to_string(end_us) + ",\"kind\":" + to_string(mechanic_kind))
}

// ─── season_count — 등록된 season 행 수 ───
fn season_count() -> int {
    let exists = exec("test -f '" + SEASON_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SEASON_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_duration_us — sum of (end_us - start_us) ───
fn total_duration_us() -> int {
    let exists = exec("test -f '" + SEASON_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=($3-$2)} END{print s+0}' '" + SEASON_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_mechanic_kind — 특정 mechanic_kind row 수 ───
fn count_by_mechanic_kind(kind: int) -> int {
    let exists = exec("test -f '" + SEASON_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v k=" + to_string(kind) + " '$4==k {c++} END{print c+0}' '" + SEASON_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── season_duration_us — 특정 season_id 의 (end_us - start_us) ───
//   season_id 미등록이면 0.
fn season_duration_us(season_id: int) -> int {
    let exists = exec("test -f '" + SEASON_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v sid=" + to_string(season_id) + " '$1==sid {s+=($3-$2)} END{print s+0}' '" + SEASON_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dsmt_stats — [season_count, total_duration_us, count(kind=4), count(kind=5)] ───
fn dsmt_stats() -> array {
    return [season_count(), total_duration_us(), count_by_mechanic_kind(4), count_by_mechanic_kind(5)]
}

fn cleanup_dsmt() -> void {
    let _ = exec("rm -rf '" + DSMT_DIR + "'")
}

fn self_test() -> void {
    let sid = "dsmt-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dsmt()

    // 합성 season 3 종:
    //   Season 4 (Tempering)         — 1.0e12 → 1.1e12 us, kind=4
    //   Season 5 (Infernal Hordes)   — 1.1e12 → 1.2e12 us, kind=5
    //   Season 6 (Spiritborn / dlc)  — 1.2e12 → 1.3e12 us, kind=5 (re-use)
    record_season(4, 1000000000000, 1100000000000, 4)
    record_season(5, 1100000000000, 1200000000000, 5)
    record_season(6, 1200000000000, 1300000000000, 5)

    // season_count = 3
    let sc = season_count()
    if sc != 3 { panic("c_d4_seasonal_mechanic_timer FAIL [season_count] expected=3 got=" + to_string(sc)) }

    // total_duration_us = 100000000000 × 3 = 300000000000
    let td = total_duration_us()
    if td != 300000000000 { panic("c_d4_seasonal_mechanic_timer FAIL [total_duration_us] expected=300000000000 got=" + to_string(td)) }

    // count_by_mechanic_kind:
    //   kind=4 → 1 (Tempering)
    //   kind=5 → 2 (Hordes + Spiritborn)
    //   kind=99 → 0
    let c4 = count_by_mechanic_kind(4)
    if c4 != 1 { panic("c_d4_seasonal_mechanic_timer FAIL [count kind=4] expected=1 got=" + to_string(c4)) }
    let c5 = count_by_mechanic_kind(5)
    if c5 != 2 { panic("c_d4_seasonal_mechanic_timer FAIL [count kind=5] expected=2 got=" + to_string(c5)) }
    let c99 = count_by_mechanic_kind(99)
    if c99 != 0 { panic("c_d4_seasonal_mechanic_timer FAIL [count kind=99] expected=0 got=" + to_string(c99)) }

    // season_duration_us:
    //   season_id=4 → 100000000000
    //   season_id=5 → 100000000000
    //   season_id=6 → 100000000000
    //   season_id=99 → 0 (미등록)
    let d4 = season_duration_us(4)
    if d4 != 100000000000 { panic("c_d4_seasonal_mechanic_timer FAIL [duration sid=4] expected=100000000000 got=" + to_string(d4)) }
    let d5 = season_duration_us(5)
    if d5 != 100000000000 { panic("c_d4_seasonal_mechanic_timer FAIL [duration sid=5] expected=100000000000 got=" + to_string(d5)) }
    let d6 = season_duration_us(6)
    if d6 != 100000000000 { panic("c_d4_seasonal_mechanic_timer FAIL [duration sid=6] expected=100000000000 got=" + to_string(d6)) }
    let d99 = season_duration_us(99)
    if d99 != 0 { panic("c_d4_seasonal_mechanic_timer FAIL [duration sid=99] expected=0 got=" + to_string(d99)) }

    let stats = dsmt_stats()
    if stats[0] != 3 { panic("c_d4_seasonal_mechanic_timer FAIL [stats season_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 300000000000 { panic("c_d4_seasonal_mechanic_timer FAIL [stats total_duration] expected=300000000000 got=" + to_string(stats[1])) }
    if stats[2] != 1 { panic("c_d4_seasonal_mechanic_timer FAIL [stats kind=4] expected=1 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_d4_seasonal_mechanic_timer FAIL [stats kind=5] expected=2 got=" + to_string(stats[3])) }

    r0_emit("d4_season_summary", "\"seasons\":" + to_string(stats[0]) + ",\"total_duration_us\":" + to_string(stats[1]) + ",\"tempering\":" + to_string(stats[2]) + ",\"horde\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d4_seasonal_mechanic_timer FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AJ) ───
    //
    // Track AJ mission: extend Track V D4 retired_intentional posture annotation to 6
    // additional c_d4_* modules. .roadmap.diablo4 blk.1 status_enum_adopted =
    // retired_intentional (Track A2 land 2026-05-03). 본 module 측 D4 Seasonal Realm
    // mechanic timer (season × start × end × kind columnar log) = synthetic season
    // duration analyzer — production live game state 측정 X (D4 always-online live
    // session 진입 X, DRM bypass 0, Battle.net launcher 통과 X, Seasonal Realm
    // session fetch host 측 책임). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_
    // intentional posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "seasonal_mechanic_timer"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_seasonal_mechanic_timer_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"seasonal_mechanic_timer\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_SEASONAL_MECHANIC__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dsmt()

    println("  ✅ c_d4_seasonal_mechanic_timer self_test PASS (3 seasons, total_duration=300000000000 us, kind4=1, kind5=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dsmt_stats()
            println("seasons=" + to_string(s[0]) + " total_duration_us=" + to_string(s[1]) + " kind4=" + to_string(s[2]) + " kind5=" + to_string(s[3]))
            return
        }
        if sub == "duration" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                let d = season_duration_us(sid)
                println(to_string(d))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let k = to_int(a[3])
                let c = count_by_mechanic_kind(k)
                println(to_string(c))
                return
            }
        }
        if sub == "cleanup" { cleanup_dsmt(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_seasonal_mechanic_timer.hexa { self-test | stats | duration <season_id> | count <mechanic_kind> | cleanup }")
}
