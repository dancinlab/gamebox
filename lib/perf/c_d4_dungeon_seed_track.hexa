// lib/perf/c_d4_dungeon_seed_track.hexa — CN-104 skeleton manjeom 15/15
//
// D4 nightmare dungeon seed tracker — Phase 5 gameplay loop.
// seed × tier × clear_time_s 추적 → seed 별 farming 효율 분석.
//
// 무기: seed table + columnar (seed × tier × time_s).
// 효과: 가장 빠른 seed 찾기 (tier 별 fastest seed) → glyph leveling 최적화.

use "./r0_common"

let DDST_DIR = GAMEBOX_HOME + "/persist/d4_dungeon_seed"
let RUN_LOG = DDST_DIR + "/runs.tsv"

fn ddst_dir() -> str { return DDST_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DDST_DIR + "'")
}

fn seeds() -> array {
    return ["abandoned_archives", "akkhans_grasp", "blind_burrows", "champions_demise", "dead_mans_dredge"]
}

fn min_tier() -> int { return 1 }
fn max_tier() -> int { return 10 }

fn record_run(seed: str, tier: int, clear_time_s: int) -> void {
    ensure_dir()
    if tier < min_tier() || tier > max_tier() {
        panic("c_d4_dungeon_seed_track FAIL [tier_range] expected=1..10 got=" + to_string(tier))
    }
    let line = seed + "\t" + to_string(tier) + "\t" + to_string(clear_time_s)
    let tmp = RUN_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + RUN_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_dungeon_seed_run", "\"seed\":\"" + seed + "\",\"tier\":" + to_string(tier) + ",\"time_s\":" + to_string(clear_time_s))
}

fn run_count() -> int {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("wc -l < '" + RUN_LOG + "' | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn runs_for_seed(seed: str) -> int {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v s='" + seed + "' '$1==s' '" + RUN_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// avg clear time (seconds) for a given tier across all seeds — integer floor.
fn avg_clear_time_per_tier(tier: int) -> int {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$2==t {s+=$3; n++} END{ if(n>0) printf \"%d\", s/n; else print 0 }' '" + RUN_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// fastest seed name at given tier — empty if no run.
fn fastest_seed_at_tier(tier: int) -> str {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let r = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$2==t { if(best==\"\" || $3<bt) { best=$1; bt=$3 } } END{ print best }' '" + RUN_LOG + "'").trim()
    return r
}

fn fastest_time_at_tier(tier: int) -> int {
    let exists = exec("test -f '" + RUN_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v t=" + to_string(tier) + " '$2==t { if(bt==0 || $3<bt) bt=$3 } END{ print bt+0 }' '" + RUN_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_ddst() -> void {
    let _ = exec("rm -rf '" + DDST_DIR + "'")
}

fn self_test() -> void {
    let sid = "ddst-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_ddst()

    let s = seeds()
    if len(s) != 5 { panic("c_d4_dungeon_seed_track FAIL [seeds] expected=5 got=" + to_string(len(s))) }

    if min_tier() != 1 { panic("c_d4_dungeon_seed_track FAIL [min_tier] expected=1 got=" + to_string(min_tier())) }
    if max_tier() != 10 { panic("c_d4_dungeon_seed_track FAIL [max_tier] expected=10 got=" + to_string(max_tier())) }

    // 5 seeds × 3 tiers (T3, T5, T8). times engineered so fastest seed at each tier is unique.
    // T3: archives=180, akkhans=210, burrows=240, champions=200, dredge=220 → fastest = abandoned_archives
    record_run("abandoned_archives", 3, 180)
    record_run("akkhans_grasp",      3, 210)
    record_run("blind_burrows",      3, 240)
    record_run("champions_demise",   3, 200)
    record_run("dead_mans_dredge",   3, 220)

    // T5: archives=320, akkhans=290, burrows=350, champions=310, dredge=330 → fastest = akkhans_grasp
    record_run("abandoned_archives", 5, 320)
    record_run("akkhans_grasp",      5, 290)
    record_run("blind_burrows",      5, 350)
    record_run("champions_demise",   5, 310)
    record_run("dead_mans_dredge",   5, 330)

    // T8: archives=540, akkhans=560, burrows=520, champions=550, dredge=510 → fastest = dead_mans_dredge
    record_run("abandoned_archives", 8, 540)
    record_run("akkhans_grasp",      8, 560)
    record_run("blind_burrows",      8, 520)
    record_run("champions_demise",   8, 550)
    record_run("dead_mans_dredge",   8, 510)

    let cnt = run_count()
    if cnt != 15 { panic("c_d4_dungeon_seed_track FAIL [count] expected=15 got=" + to_string(cnt)) }

    let per_seed = runs_for_seed("abandoned_archives")
    if per_seed != 3 { panic("c_d4_dungeon_seed_track FAIL [per_seed] expected=3 got=" + to_string(per_seed)) }

    // T3 avg = (180+210+240+200+220)/5 = 1050/5 = 210
    let avg3 = avg_clear_time_per_tier(3)
    if avg3 != 210 { panic("c_d4_dungeon_seed_track FAIL [avg_t3] expected=210 got=" + to_string(avg3)) }

    // T5 avg = (320+290+350+310+330)/5 = 1600/5 = 320
    let avg5 = avg_clear_time_per_tier(5)
    if avg5 != 320 { panic("c_d4_dungeon_seed_track FAIL [avg_t5] expected=320 got=" + to_string(avg5)) }

    // T8 avg = (540+560+520+550+510)/5 = 2680/5 = 536
    let avg8 = avg_clear_time_per_tier(8)
    if avg8 != 536 { panic("c_d4_dungeon_seed_track FAIL [avg_t8] expected=536 got=" + to_string(avg8)) }

    let fast3 = fastest_seed_at_tier(3)
    if fast3 != "abandoned_archives" { panic("c_d4_dungeon_seed_track FAIL [fast_t3] expected=abandoned_archives got=" + fast3) }

    let fast5 = fastest_seed_at_tier(5)
    if fast5 != "akkhans_grasp" { panic("c_d4_dungeon_seed_track FAIL [fast_t5] expected=akkhans_grasp got=" + fast5) }

    let fast8 = fastest_seed_at_tier(8)
    if fast8 != "dead_mans_dredge" { panic("c_d4_dungeon_seed_track FAIL [fast_t8] expected=dead_mans_dredge got=" + fast8) }

    let ftime3 = fastest_time_at_tier(3)
    if ftime3 != 180 { panic("c_d4_dungeon_seed_track FAIL [ftime_t3] expected=180 got=" + to_string(ftime3)) }

    let ftime8 = fastest_time_at_tier(8)
    if ftime8 != 510 { panic("c_d4_dungeon_seed_track FAIL [ftime_t8] expected=510 got=" + to_string(ftime8)) }

    r0_emit("d4_dungeon_seed_summary", "\"runs\":" + to_string(cnt) + ",\"seeds\":" + to_string(len(s)) + ",\"avg_t5\":" + to_string(avg5) + ",\"fastest_t8\":\"" + fast8 + "\"")

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 5 { panic("c_d4_dungeon_seed_track FAIL [emit] expected>=5 got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 dungeon seed retired_intentional posture annotation (Track V) ───
    //
    // Track V mission: D4 always-online DRM honest spec freeze posture annotation.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land).
    // 본 module 측 dungeon seed tracker = synthetic seed table + tier average / fastest
    // — production live game state 측정 X (D4 always-online live session 진입 X, DRM
    // bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_intentional
    // posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "dungeon_seed_track"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_dungeon_seed_track_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"dungeon_seed_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_DUNGEON_SEED__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_ddst()

    println("  ✅ c_d4_dungeon_seed_track self_test PASS (5 seeds, 15 runs, avg_t5=" + to_string(avg5) + "s, fastest_t8=" + fast8 + ", emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 6 {
            record_run(a[3], to_int(a[4]), to_int(a[5]))
            println("recorded")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            let t = to_int(a[3])
            println("tier=" + to_string(t) + " avg=" + to_string(avg_clear_time_per_tier(t)) + " fastest=" + fastest_seed_at_tier(t) + " best_time=" + to_string(fastest_time_at_tier(t)) + "s")
            return
        }
        if sub == "cleanup" { cleanup_ddst(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_dungeon_seed_track.hexa { self-test | set <seed> <tier> <time_s> | stats <tier> | cleanup }")
}
