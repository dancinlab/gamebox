// lib/perf/c_display_mode_pip_focus_ctrl_g.hexa — CN-208 skeleton manjeom 15/15
//
// PIP mode 의 Ctrl+G 단축키 focus toggle 추적 — main ↔ PIP window 사이 input
// 라우팅 정량화. 사용자 directive: "PIP mode 에서 ctrl+g 로 현재 화면과 pip
// 포커싱(작동가능하게) 이동가능". Ctrl+G 키 입력 시 main window ↔ PIP window
// 사이 keyboard/mouse focus 가 전환되어 어느 창이든 input 을 받아 작동 가능
// 해야 한다. 본 모듈은 toggle event 단위로 (event_id × from_focus × to_focus
// × elapsed_us) 4-key columnar log 만 담당 — 실제 NSWindow makeKey /
// CGEventTap routing 은 host 측 책임.
//
// 무기: event × from_focus × to_focus × elapsed 4-key columnar log + sum/avg.
// 효과: PIP focus 전환 latency + 정합성 정량화 → main↔PIP toggle 누락/지연
// (예: makeKeyAndOrderFront 후 first-responder 갱신 fail) 감지.

use "./r0_common"

let DMPFCG_DIR = GAMEBOX_HOME + "/persist/display_mode_pip_focus_ctrl_g"
let EVENT_LOG = DMPFCG_DIR + "/events.tsv"

fn dmpfcg_dir() -> str { return DMPFCG_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMPFCG_DIR + "'")
}

// ─── Ctrl+G focus toggle 등록 ───
//   event_id    (Ctrl+G toggle 시퀀스 번호),
//   from_focus  (1 = main, 2 = pip — toggle 직전 focus 가 머물던 창),
//   to_focus    (1 = main, 2 = pip — toggle 후 first-responder 가 옮겨간 창),
//   elapsed_us  (key-down → makeKey 완료까지의 host 측 측정 마이크로초).
fn record_event(event_id: int, from_focus: int, to_focus: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(event_id) + "\t" + to_string(from_focus) + "\t" + to_string(to_focus) + "\t" + to_string(elapsed_us)
    let tmp = EVENT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + EVENT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dmpfcg_record", "\"event\":" + to_string(event_id) + ",\"from\":" + to_string(from_focus) + ",\"to\":" + to_string(to_focus) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── event_count — 등록된 toggle event 행 수 ───
fn event_count() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + EVENT_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_elapsed_us — 모든 toggle elapsed 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_main_to_pip — from=1 (main) → to=2 (pip) ───
fn count_main_to_pip() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$2==1 && $3==2 {n++} END{print n+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_pip_to_main — from=2 (pip) → to=1 (main) ───
fn count_pip_to_main() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$2==2 && $3==1 {n++} END{print n+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_elapsed_us — total_elapsed_us / event_count (정수, 0-guard) ───
fn avg_elapsed_us() -> int {
    let ec = event_count()
    if ec == 0 { return 0 }
    let te = total_elapsed_us()
    return te / ec
}

// ─── event_elapsed — 특정 event_id 의 elapsed_us (미등록이면 0) ───
fn event_elapsed(event_id: int) -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v e=" + to_string(event_id) + " '$1==e {s+=$4} END{print s+0}' '" + EVENT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dmpfcg_stats — [event_count, total_elapsed_us, count_main_to_pip, count_pip_to_main] ───
fn dmpfcg_stats() -> array {
    return [event_count(), total_elapsed_us(), count_main_to_pip(), count_pip_to_main()]
}

fn cleanup_dmpfcg() -> void {
    let _ = exec("rm -rf '" + DMPFCG_DIR + "'")
}

fn self_test() -> void {
    let sid = "dmpfcg-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dmpfcg()

    // 합성 Ctrl+G toggle 4 회:
    //   59001 — main → pip (80 us)
    //   59002 — pip  → main (60 us)
    //   59003 — main → pip (72 us)
    //   59004 — pip  → main (64 us)
    record_event(59001, 1, 2, 80)
    record_event(59002, 2, 1, 60)
    record_event(59003, 1, 2, 72)
    record_event(59004, 2, 1, 64)

    // event_count = 4
    let ec = event_count()
    if ec != 4 { panic("c_display_mode_pip_focus_ctrl_g FAIL [event_count] expected=4 got=" + to_string(ec)) }

    // total_elapsed_us = 80+60+72+64 = 276
    let te = total_elapsed_us()
    if te != 276 { panic("c_display_mode_pip_focus_ctrl_g FAIL [total_elapsed_us] expected=276 got=" + to_string(te)) }

    // count_main_to_pip = 2 (59001, 59003)
    let cmp = count_main_to_pip()
    if cmp != 2 { panic("c_display_mode_pip_focus_ctrl_g FAIL [count_main_to_pip] expected=2 got=" + to_string(cmp)) }

    // count_pip_to_main = 2 (59002, 59004)
    let cpm = count_pip_to_main()
    if cpm != 2 { panic("c_display_mode_pip_focus_ctrl_g FAIL [count_pip_to_main] expected=2 got=" + to_string(cpm)) }

    // avg_elapsed_us = 276 / 4 = 69
    let avg = avg_elapsed_us()
    if avg != 69 { panic("c_display_mode_pip_focus_ctrl_g FAIL [avg_elapsed_us] expected=69 got=" + to_string(avg)) }

    // event_elapsed lookup
    let e1 = event_elapsed(59001)
    if e1 != 80 { panic("c_display_mode_pip_focus_ctrl_g FAIL [event_elapsed 59001] expected=80 got=" + to_string(e1)) }
    let e2 = event_elapsed(59002)
    if e2 != 60 { panic("c_display_mode_pip_focus_ctrl_g FAIL [event_elapsed 59002] expected=60 got=" + to_string(e2)) }
    let e3 = event_elapsed(59003)
    if e3 != 72 { panic("c_display_mode_pip_focus_ctrl_g FAIL [event_elapsed 59003] expected=72 got=" + to_string(e3)) }
    let e4 = event_elapsed(59004)
    if e4 != 64 { panic("c_display_mode_pip_focus_ctrl_g FAIL [event_elapsed 59004] expected=64 got=" + to_string(e4)) }
    // 미등록 event_id 는 0
    let e5 = event_elapsed(9999)
    if e5 != 0 { panic("c_display_mode_pip_focus_ctrl_g FAIL [event_elapsed unknown] expected=0 got=" + to_string(e5)) }

    let stats = dmpfcg_stats()
    if stats[0] != 4 { panic("c_display_mode_pip_focus_ctrl_g FAIL [stats events] expected=4 got=" + to_string(stats[0])) }
    if stats[1] != 276 { panic("c_display_mode_pip_focus_ctrl_g FAIL [stats total_us] expected=276 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_display_mode_pip_focus_ctrl_g FAIL [stats main->pip] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_display_mode_pip_focus_ctrl_g FAIL [stats pip->main] expected=2 got=" + to_string(stats[3])) }

    r0_emit("dmpfcg_summary", "\"events\":" + to_string(stats[0]) + ",\"total_us\":" + to_string(stats[1]) + ",\"main_to_pip\":" + to_string(stats[2]) + ",\"pip_to_main\":" + to_string(stats[3]) + ",\"avg_us\":" + to_string(avg))

    // record × 4 + summary × 1 = ≥ 5 emits
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_display_mode_pip_focus_ctrl_g FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    // ─── synthetic Ctrl+G PIP focus toggle round-trip (Track BJ — d2r cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BJ mission: c_display_* family completion cycle (8/8) — c_display_mode_pip_focus_ctrl_g
    // 측 Ctrl+G hotkey synthetic round-trip. Focus toggle lifecycle
    // (capture_chord → resolve_kind → toggle_focus → emit_audit) 측 spec freeze.
    // Apple-native scaffold only (D3DMetal binary licence transitive — loader_dx blk.1),
    // DX11 PIP cross-link Metal layer evidence.
    //
    // (a) synthetic 4-phase Ctrl+G focus toggle pipeline —
    //     capture_key_chord → resolve_toggle_kind → toggle_focus_target → emit_audit_event:
    //     phase_count               4
    //     focus_toggle_off          0x180056000         (synthetic Ctrl+G handler RVA)
    //     pipeline_kind             "synthetic_inline"  (실 NSEvent monitor 호출 X)
    //
    // (b) synthetic direction × elapsed_class 16-slot toggle matrix —
    //     4 direction (m2p/p2m/p2x/x2p) × 4 elapsed_class (fast/normal/slow/timeout) = 16 slots:
    //     slot_total                16
    //     fast_slot_count           8                   (elapsed_class fast/normal)
    //     slow_slot_count           8                   (elapsed_class slow/timeout)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_toggle_phase(scaffold) → walk_direction_matrix(scaffold).
    //              hexa-native loop only — 실 NSEvent.addLocalMonitor 0,
    //              real focus state mutation 0.
    //
    // synthetic Ctrl+G focus toggle phase emit
    r0_emit("c_display_mode_pip_focus_ctrl_g_synthetic_phase",
        "\"stage\":\"focus_toggle_phase\",\"phase_count\":4,\"focus_toggle_off\":\"0x180056000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_CTRL_G__ PARTIAL focus_toggle_phase")

    // synthetic direction × elapsed matrix emit
    r0_emit("c_display_mode_pip_focus_ctrl_g_synthetic_matrix",
        "\"stage\":\"direction_matrix\",\"slot_total\":16,\"fast_slot_count\":8,\"slow_slot_count\":8,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_CTRL_G__ PARTIAL direction_matrix")

    cleanup_dmpfcg()

    println("  ✅ c_display_mode_pip_focus_ctrl_g self_test PASS (4 events, total=276 us, main->pip=2, pip->main=2, avg=69 us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dmpfcg_stats()
            println("events=" + to_string(s[0]) + " total_us=" + to_string(s[1]) + " main_to_pip=" + to_string(s[2]) + " pip_to_main=" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let eid = to_int(a[3])
                let us = event_elapsed(eid)
                println(to_string(us))
                return
            }
        }
        if sub == "cleanup" { cleanup_dmpfcg(); println("cleaned"); return }
    }
    println("usage: hexa run c_display_mode_pip_focus_ctrl_g.hexa { self-test | stats | elapsed <event_id> | cleanup }")
}
