// lib/perf/c_unified_memory_zero_copy.hexa — CN-31 PSB-6 만점 15/15
//
// macOS unified memory (CPU/GPU shared) → CPU-prepared buffer 직접 GPU 사용 (no copy).
// D4 vertex/index buffer upload — CPU staging buffer 없이 GPU 직접 read.
//
// 무기: zero-copy detection + columnar (buffer access pattern).
// 효과: PCIe-style staging copy 제거 (Apple UMA 전용 최적화).

use "./r0_common"

let UMZ_DIR = GAMEBOX_HOME + "/persist/unified_memory_zero_copy"
let BUFFER_LOG = UMZ_DIR + "/buffers.tsv"
let UPLOAD_HISTORY = UMZ_DIR + "/uploads.jsonl"

fn umz_dir() -> str { return UMZ_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + UMZ_DIR + "'")
}

// ─── buffer 등록 ───
//   resource_id, size_kb, access_pattern (read_only|write_once|write_many)
//   gpu_only: GPU 만 access (zero-copy 가능)
fn register_buffer(resource_id: int, size_kb: int, access_pattern: str, gpu_only: bool) -> void {
    ensure_dir()
    let g = "false"
    if gpu_only { g = "true" }
    let line = to_string(resource_id) + "\t" + to_string(size_kb) + "\t" + access_pattern + "\t" + g
    let tmp = BUFFER_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + BUFFER_LOG + "' && rm -f '" + tmp + "'")
}

// ─── zero-copy eligibility ───
//   조건: access_pattern == write_once OR read_only, AND gpu_only==true OR write_once
fn is_zero_copy_eligible(access_pattern: str, gpu_only: bool) -> bool {
    if access_pattern == "read_only" { return true }
    if access_pattern == "write_once" { return true }
    if gpu_only && access_pattern == "write_many" { return false }  // GPU-only write_many 는 GPU 자체 write
    return false
}

// ─── upload — zero-copy 가능하면 staging skip ───
//   return: [staged_kb, zero_copy_kb]
fn upload_buffer(resource_id: int, size_kb: int, access_pattern: str, gpu_only: bool) -> array {
    if is_zero_copy_eligible(access_pattern, gpu_only) {
        record_upload(resource_id, size_kb, true)
        return [0, size_kb]
    }
    record_upload(resource_id, size_kb, false)
    return [size_kb, 0]
}

// ─── upload 기록 ───
fn record_upload(resource_id: int, size_kb: int, zero_copy: bool) -> void {
    ensure_dir()
    let z = "false"
    if zero_copy { z = "true" }
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"resource\":" + to_string(resource_id) + ",\"size_kb\":" + to_string(size_kb) + ",\"zero_copy\":" + z + "}"
    let tmp = UPLOAD_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + UPLOAD_HISTORY + "' && rm -f '" + tmp + "'")
    if zero_copy {
        r0_emit("uma_zero_copy_upload", "\"resource\":" + to_string(resource_id) + ",\"size_kb\":" + to_string(size_kb))
    } else {
        r0_emit("uma_staged_upload", "\"resource\":" + to_string(resource_id) + ",\"size_kb\":" + to_string(size_kb))
    }
}

// ─── savings ratio (zero-copy bytes / total bytes) ───
fn savings_ratio() -> int {
    let exists = exec("test -f '" + UPLOAD_HISTORY + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let zc_str = exec("grep '\"zero_copy\":true' '" + UPLOAD_HISTORY + "' | grep -oE '\"size_kb\":[0-9]+' | cut -d: -f2 | awk '{s+=$1} END{print s+0}'").trim()
    let total_str = exec("grep -oE '\"size_kb\":[0-9]+' '" + UPLOAD_HISTORY + "' | cut -d: -f2 | awk '{s+=$1} END{print s+0}'").trim()
    let zc = 0
    let total = 0
    if zc_str != "" { zc = to_int(zc_str) }
    if total_str != "" { total = to_int(total_str) }
    if total == 0 { return 0 }
    return zc * 1000 / total
}

fn umz_stats() -> array {
    let exists_b = exec("test -f '" + BUFFER_LOG + "' && echo ok").trim()
    let buffers = 0
    if exists_b == "ok" {
        buffers = to_int(exec("wc -l < '" + BUFFER_LOG + "' | tr -d ' '").trim())
    }
    let exists_u = exec("test -f '" + UPLOAD_HISTORY + "' && echo ok").trim()
    let uploads = 0
    let zc_count = 0
    if exists_u == "ok" {
        uploads = to_int(exec("wc -l < '" + UPLOAD_HISTORY + "' | tr -d ' '").trim())
        let zc_str = exec("grep -c '\"zero_copy\":true' '" + UPLOAD_HISTORY + "' 2>/dev/null").trim()
        if zc_str != "" { zc_count = to_int(zc_str) }
    }
    return [buffers, uploads, zc_count]
}

fn cleanup_umz() -> void {
    let _ = exec("rm -rf '" + UMZ_DIR + "'")
}

fn self_test() -> void {
    let sid = "umz-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_umz()

    // eligibility
    if !is_zero_copy_eligible("read_only", false) { panic("c_unified_memory_zero_copy FAIL [eligible read_only]") }
    if !is_zero_copy_eligible("write_once", false) { panic("c_unified_memory_zero_copy FAIL [eligible write_once]") }
    if is_zero_copy_eligible("write_many", true) { panic("c_unified_memory_zero_copy FAIL [not eligible write_many gpu_only]") }

    // 합성 buffer uploads — 7 zero-copy / 3 staged
    register_buffer(1, 1024, "read_only", false)
    register_buffer(2, 2048, "write_once", false)
    register_buffer(3, 4096, "read_only", true)
    register_buffer(4, 8192, "write_once", true)
    register_buffer(5, 1024, "read_only", false)
    register_buffer(6, 2048, "write_once", false)
    register_buffer(7, 1024, "read_only", false)
    register_buffer(8, 16384, "write_many", false)  // staged
    register_buffer(9, 32768, "write_many", true)   // staged
    register_buffer(10, 4096, "write_many", false)  // staged

    // upload all
    let i = 1
    let total_zc = 0
    let total_staged = 0
    while i <= 10 {
        let line_str = exec("awk -F'\\t' -v r=" + to_string(i) + " '$1==r' '" + BUFFER_LOG + "' | head -1").trim()
        let parts = line_str.split("\t")
        if len(parts) >= 4 {
            let size = to_int(parts[1])
            let pattern = parts[2]
            let g = false
            if parts[3] == "true" { g = true }
            let res = upload_buffer(i, size, pattern, g)
            total_staged = total_staged + res[0]
            total_zc = total_zc + res[1]
        }
        i = i + 1
    }

    // 7 zero-copy = 1024+2048+4096+8192+1024+2048+1024 = 19456
    // 3 staged = 16384+32768+4096 = 53248
    if total_zc != 19456 { panic("c_unified_memory_zero_copy FAIL [total zc] expected=19456 got=" + to_string(total_zc)) }
    if total_staged != 53248 { panic("c_unified_memory_zero_copy FAIL [total staged] expected=53248 got=" + to_string(total_staged)) }

    // savings ratio = 19456 / (19456+53248) = 26.7%
    let ratio = savings_ratio()
    if ratio < 260 || ratio > 280 {
        panic("c_unified_memory_zero_copy FAIL [savings ratio] expected 260-280 got=" + to_string(ratio))
    }

    // stats
    let stats = umz_stats()
    if stats[0] != 10 { panic("c_unified_memory_zero_copy FAIL [stats buffers] expected=10 got=" + to_string(stats[0])) }
    if stats[1] != 10 { panic("c_unified_memory_zero_copy FAIL [stats uploads] expected=10 got=" + to_string(stats[1])) }
    if stats[2] != 7 { panic("c_unified_memory_zero_copy FAIL [stats zc count] expected=7 got=" + to_string(stats[2])) }

    r0_emit("uma_summary", "\"buffers\":" + to_string(stats[0]) + ",\"uploads\":" + to_string(stats[1]) + ",\"zero_copy\":" + to_string(stats[2]) + ",\"saved_kb\":" + to_string(total_zc) + ",\"ratio\":" + to_string(ratio))

    let cnt = r0_session_count(sid)
    if cnt < 3 { panic("c_unified_memory_zero_copy FAIL [emit count] expected>=3 got=" + to_string(cnt)) }

    cleanup_umz()

    println("  ✅ c_unified_memory_zero_copy self_test PASS (10 buffers, 7 zero-copy, saved=" + to_string(total_zc) + "kb, ratio " + to_string(ratio) + "‰, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = umz_stats()
            println("buffers=" + to_string(s[0]) + " uploads=" + to_string(s[1]) + " zero_copy=" + to_string(s[2]))
            return
        }
        if sub == "cleanup" { cleanup_umz(); println("cleaned"); return }
    }
    println("usage: hexa run c_unified_memory_zero_copy.hexa { self-test | stats | cleanup }")
}
