// lib/perf/c_pe_segment_overlay_predict.hexa — CN-130 skeleton manjeom 15/15
//
// Phase 1 PE anti-debug overlay 검출 — .text 끝 packed code 의심 segment.
// entropy + virt/raw 비율 동시 검사 → packer (UPX/Themida/VMProtect 류) 식별.
//
// 무기: segment table + columnar (per-segment entropy_class × suspect bool).
// 효과: anti-debug / packed PE 즉시 분류 — Phase 1 closure path 정확도 향상.
//
// hexa-lang stage1 제약: float X → entropy 는 int (×10 scale, 6.5 → 65).

use "./r0_common"

let CPSO_DIR = GAMEBOX_HOME + "/persist/pe_segment_overlay"
let SEG_LOG = CPSO_DIR + "/segments.tsv"

fn cpso_dir() -> str { return CPSO_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CPSO_DIR + "'")
}

// entropy: int ×10 scaled (6.5 == 65). 8.0 max == 80.
fn entropy_class(e: int) -> str {
    if e < 40 { return "low" }
    if e <= 60 { return "mid" }
    return "high"
}

// packer suspect: virt > raw * 1.5  AND  entropy > 6.5 (e>65).
//   raw*1.5 → raw*15/10 (int math).
fn packer_suspect(name: str, raw: int, virt: int, entropy: int) -> bool {
    let threshold = raw * 15 / 10
    if virt > threshold && entropy > 65 { return true }
    return false
}

fn record_segment(name: str, raw_size: int, virt_size: int, entropy: int) -> void {
    ensure_dir()
    let cls = entropy_class(entropy)
    let sus = packer_suspect(name, raw_size, virt_size, entropy)
    let sus_tag = "ok"
    if sus { sus_tag = "suspect" }
    let line = name + "\t" + to_string(raw_size) + "\t" + to_string(virt_size) + "\t" + to_string(entropy) + "\t" + cls + "\t" + sus_tag
    let tmp = SEG_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SEG_LOG + "' && rm -f '" + tmp + "'")
    if sus {
        r0_emit("pe_overlay_suspect", "\"name\":\"" + name + "\",\"raw\":" + to_string(raw_size) + ",\"virt\":" + to_string(virt_size) + ",\"entropy\":" + to_string(entropy))
    } else {
        r0_emit("pe_overlay_ok", "\"name\":\"" + name + "\",\"class\":\"" + cls + "\"")
    }
}

fn segment_count() -> int {
    let exists = exec("test -f '" + SEG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + SEG_LOG + "' | tr -d ' '").trim())
}

fn suspect_count() -> int {
    let exists = exec("test -f '" + SEG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$6==\"suspect\"' '" + SEG_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn class_count(cls: str) -> int {
    let exists = exec("test -f '" + SEG_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + cls + "' '$5==c' '" + SEG_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_cpso() -> void {
    let _ = exec("rm -rf '" + CPSO_DIR + "'")
}

fn self_test() -> void {
    let sid = "cpso-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cpso()

    // entropy_class 경계 검증 (×10 scale)
    if entropy_class(35) != "low" { panic("c_pe_segment_overlay_predict FAIL [class low]") }
    if entropy_class(40) != "mid" { panic("c_pe_segment_overlay_predict FAIL [class mid lo]") }
    if entropy_class(55) != "mid" { panic("c_pe_segment_overlay_predict FAIL [class mid hi]") }
    if entropy_class(60) != "mid" { panic("c_pe_segment_overlay_predict FAIL [class 6.0 boundary]") }
    if entropy_class(72) != "high" { panic("c_pe_segment_overlay_predict FAIL [class high]") }

    // packer_suspect 경계
    if packer_suspect(".text", 1000, 1400, 70) != false { panic("c_pe_segment_overlay_predict FAIL [virt ratio under]") }
    if packer_suspect(".text", 1000, 1600, 60) != false { panic("c_pe_segment_overlay_predict FAIL [entropy under]") }
    if packer_suspect(".UPX", 1000, 1600, 70) != true { panic("c_pe_segment_overlay_predict FAIL [suspect detect]") }

    // 정상 5 segment + 의심 .UPX/.Themida
    record_segment(".text",    0x4500, 0x4500, 55)  // mid entropy, raw==virt → ok
    record_segment(".rdata",   0x1200, 0x1200, 35)  // low entropy → ok
    record_segment(".data",    0x800,  0x800,  30)  // low → ok
    record_segment(".UPX0",    0x1000, 0x4000, 72)  // virt 4× raw + high entropy → suspect
    record_segment(".Themida", 0x800,  0x2000, 78)  // virt 4× + very high → suspect

    let n = segment_count()
    if n != 5 { panic("c_pe_segment_overlay_predict FAIL [count] expected=5 got=" + to_string(n)) }

    let sus = suspect_count()
    if sus != 2 { panic("c_pe_segment_overlay_predict FAIL [suspect] expected=2 got=" + to_string(sus)) }

    let lo = class_count("low")
    if lo != 2 { panic("c_pe_segment_overlay_predict FAIL [low class] expected=2 got=" + to_string(lo)) }

    let hi = class_count("high")
    if hi != 2 { panic("c_pe_segment_overlay_predict FAIL [high class] expected=2 got=" + to_string(hi)) }

    let mid = class_count("mid")
    if mid != 1 { panic("c_pe_segment_overlay_predict FAIL [mid class] expected=1 got=" + to_string(mid)) }

    r0_emit("pe_overlay_summary", "\"segments\":" + to_string(n) + ",\"suspects\":" + to_string(sus) + ",\"high_entropy\":" + to_string(hi))

    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_pe_segment_overlay_predict FAIL [emit] got=" + to_string(cnt)) }

    // ─── synthetic PE segment overlay state machine round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track AQ mission: D2R cond.1 (PE parse + IAT real-resolve + mainCRTStartup
    // reach) 측 evidence augment. PE .text 끝 packed code overlay segment
    // entropy + virt/raw 비율 scan path 측 D2R cond.1 + D4 cond.1 cross-link.
    // packer (UPX/Themida/VMProtect) 식별 surface — DRM / DRMmask 영역 cross-link.
    //
    // (a) synthetic segment overlay 4-phase state machine cycle —
    //     scan_segment_table → compute_entropy → compute_virt_ratio → classify_suspect:
    //     phase_count               4                   (4 overlay scan phases)
    //     overlay_table_off         0x14011C000         (synthetic overlay table RVA)
    //     entropy_scale_x10         true                (int ×10 scale 6.5→65)
    //     scan_kind                 "synthetic_inline"  (실 entropy compute X)
    //
    // (b) synthetic 5-segment entropy × suspect distribution scaffold —
    //     .text/.rdata/.data normal + .UPX0/.Themida packer suspect:
    //     segment_total             5                   (5 synthetic segment)
    //     low_entropy_count         2                   (.rdata + .data, e<40)
    //     mid_entropy_count         1                   (.text, 40<=e<=60)
    //     high_entropy_count        2                   (.UPX0 + .Themida, e>60)
    //     suspect_count_synthetic   2                   (UPX + Themida)
    //     virt_ratio_max_x10        40                  (.UPX0 4× raw == 40)
    //     entropy_max_synthetic     78                  (.Themida 7.8 × 10)
    //     dist_kind                 "synthetic_inline"  (실 awk class tally X)
    //
    // round-trip = synthesize_overlay_scan(scaffold) → tally_entropy_distribution(scaffold).
    //              hexa-native loop only — 실 entropy Shannon 계산 0,
    //              real packer unpacking 0.
    //
    // synthetic overlay scan phase emit
    r0_emit("c_pe_segment_overlay_predict_synthetic_phase",
        "\"stage\":\"overlay_scan_phase\",\"phase_count\":4,\"overlay_table_off\":\"0x14011C000\",\"entropy_scale_x10\":true,\"scan_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__PE_OVERLAY__ PARTIAL overlay_scan_phase")

    // synthetic entropy distribution emit
    r0_emit("c_pe_segment_overlay_predict_synthetic_distribution",
        "\"stage\":\"entropy_distribution\",\"segment_total\":5,\"low_entropy_count\":2,\"mid_entropy_count\":1,\"high_entropy_count\":2,\"suspect_count_synthetic\":2,\"virt_ratio_max_x10\":40,\"entropy_max_synthetic\":78,\"dist_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__PE_OVERLAY__ PARTIAL entropy_distribution")

    cleanup_cpso()

    println("  ✅ c_pe_segment_overlay_predict self_test PASS (5 segments: 2 low + 1 mid + 2 high, 2 packer suspects detected, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "record" && len(a) >= 7 {
            record_segment(a[3], to_int(a[4]), to_int(a[5]), to_int(a[6]))
            println("recorded")
            return
        }
        if sub == "stats" {
            println("segments=" + to_string(segment_count()) + " suspects=" + to_string(suspect_count()) + " high=" + to_string(class_count("high")))
            return
        }
        if sub == "cleanup" { cleanup_cpso(); println("cleaned"); return }
    }
    println("usage: hexa run c_pe_segment_overlay_predict.hexa { self-test | record <name> <raw> <virt> <entropy×10> | stats | cleanup }")
}
