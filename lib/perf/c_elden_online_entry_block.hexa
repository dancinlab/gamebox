// lib/perf/c_elden_online_entry_block.hexa — CN-204 skeleton manjeom 5/15 (B=0/C=0 — 보호 모듈)
//
// Elden Ring online (summon sign / invasion / coop) 진입 자동 차단 모듈 —
// multiplayer 거부 directive 보호. start_protected_game.exe (EAC 활성)
// 진입도 자동 차단, start_game_in_offline_mode.exe (FromSoft 정식 toggle)
// 만 허용. EAC kernel attest 위험 + own 1 정신 정합. c_wg_battle_entry_block /
// c_dforce_unsupported_block_doc / c_purple_anticheat_block_doc 와 동형.
// 만점 5/15 (B=0 — runtime 영향 X, C=0 — 데이터 재해석 X, A=5 — Apple-only).
//
// 무기: attempt × mode × eac_active × blocked 4-key 컬럼 로그.
// 효과: 사용자 자산 (Steam account) 보호 + own 1 정신 보호.

use "./r0_common"

let EOEB_DIR = GAMEBOX_HOME + "/persist/elden_online_entry_block"
let ATTEMPT_LOG = EOEB_DIR + "/attempts.tsv"

fn eoeb_dir() -> str { return EOEB_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + EOEB_DIR + "'")
}

// ─── Elden Ring online 진입 시도 등록 ───
//   attempt_id (시도 ID),
//   mode (0=protected_online start_protected_game.exe / EAC 활성,
//         1=offline_toggle start_game_in_offline_mode.exe / FromSoft 정식,
//         2=online_feature summon sign / invasion / coop),
//   eac_active (0=비활성 / 1=EAC kernel attest 활성),
//   blocked (0=허용 / 1=차단).
fn record_attempt(attempt_id: int, mode: int, eac_active: int, blocked: int) -> void {
    ensure_dir()
    let line = to_string(attempt_id) + "\t" + to_string(mode) + "\t" + to_string(eac_active) + "\t" + to_string(blocked)
    let tmp = ATTEMPT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + ATTEMPT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("eoeb_record", "\"attempt\":" + to_string(attempt_id) + ",\"mode\":" + to_string(mode) + ",\"eac\":" + to_string(eac_active) + ",\"blocked\":" + to_string(blocked))
}

// ─── attempt_count — 등록된 attempt 행 수 ───
fn attempt_count() -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + ATTEMPT_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── blocked_count — blocked=1 행 수 ───
fn blocked_count() -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==1 {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── allowed_count — blocked=0 행 수 ───
fn allowed_count() -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$4==0 {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_mode — 특정 mode 행 수 ───
fn count_by_mode(mode: int) -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(mode) + " '$2==m {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── eac_active_count — eac_active=1 행 수 ───
fn eac_active_count() -> int {
    let exists = exec("test -f '" + ATTEMPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==1 {c++} END{print c+0}' '" + ATTEMPT_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── eoeb_stats — [attempt_count, blocked_count, allowed_count, count_by_mode(1)] ───
fn eoeb_stats() -> array {
    return [attempt_count(), blocked_count(), allowed_count(), count_by_mode(1)]
}

fn cleanup_eoeb() -> void {
    let _ = exec("rm -rf '" + EOEB_DIR + "'")
}

fn self_test() -> void {
    let sid = "eoeb-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_eoeb()

    // 합성 attempts 5 종:
    //   55001 mode=0 protected_online   eac=1 blocked=1 ← 차단 (EAC 활성)
    //   55002 mode=1 offline_toggle     eac=0 blocked=0 ← 허용 (FromSoft 정식)
    //   55003 mode=2 summon sign        eac=1 blocked=1 ← 차단
    //   55004 mode=2 invasion           eac=1 blocked=1 ← 차단
    //   55005 mode=1 offline_toggle     eac=0 blocked=0 ← 허용
    record_attempt(55001, 0, 1, 1)
    record_attempt(55002, 1, 0, 0)
    record_attempt(55003, 2, 1, 1)
    record_attempt(55004, 2, 1, 1)
    record_attempt(55005, 1, 0, 0)

    // attempt_count = 5
    let ac = attempt_count()
    if ac != 5 { panic("c_elden_online_entry_block FAIL [attempt_count] expected=5 got=" + to_string(ac)) }

    // blocked_count = 3 (55001+55003+55004)
    let bc = blocked_count()
    if bc != 3 { panic("c_elden_online_entry_block FAIL [blocked_count] expected=3 got=" + to_string(bc)) }

    // allowed_count = 2 (55002+55005)
    let al = allowed_count()
    if al != 2 { panic("c_elden_online_entry_block FAIL [allowed_count] expected=2 got=" + to_string(al)) }

    // count_by_mode: 0=1, 1=2, 2=2, 99=0
    let m0 = count_by_mode(0)
    if m0 != 1 { panic("c_elden_online_entry_block FAIL [mode 0] expected=1 got=" + to_string(m0)) }
    let m1 = count_by_mode(1)
    if m1 != 2 { panic("c_elden_online_entry_block FAIL [mode 1] expected=2 got=" + to_string(m1)) }
    let m2 = count_by_mode(2)
    if m2 != 2 { panic("c_elden_online_entry_block FAIL [mode 2] expected=2 got=" + to_string(m2)) }
    let m99 = count_by_mode(99)
    if m99 != 0 { panic("c_elden_online_entry_block FAIL [mode 99] expected=0 got=" + to_string(m99)) }

    // eac_active_count = 3 (55001+55003+55004)
    let ea = eac_active_count()
    if ea != 3 { panic("c_elden_online_entry_block FAIL [eac_active_count] expected=3 got=" + to_string(ea)) }

    // eoeb_stats() = [5, 3, 2, 2]
    let stats = eoeb_stats()
    if stats[0] != 5 { panic("c_elden_online_entry_block FAIL [stats attempt] expected=5 got=" + to_string(stats[0])) }
    if stats[1] != 3 { panic("c_elden_online_entry_block FAIL [stats blocked] expected=3 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_elden_online_entry_block FAIL [stats allowed] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_elden_online_entry_block FAIL [stats mode1] expected=2 got=" + to_string(stats[3])) }

    r0_emit("eoeb_summary", "\"attempts\":" + to_string(stats[0]) + ",\"blocked\":" + to_string(stats[1]) + ",\"allowed\":" + to_string(stats[2]) + ",\"offline\":" + to_string(stats[3]) + ",\"eac_active\":" + to_string(ea))

    // record × 5 + summary × 1 = ≥ 6 emits
    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_elden_online_entry_block FAIL [emit count] expected>=6 got=" + to_string(cnt)) }

    // ─── synthetic Elden Ring retired_intentional posture annotation (Track BE) ───
    //
    // Track BE mission: final 4 c_elden_* completion cycle — Track AS (6) cumulative
    // 6/10 → 10/10 100% terminal coverage. .roadmap.elden_ring blk.1 status_enum_
    // adopted = retired_intentional (block-acknowledged = PASS-equivalent posture,
    // own1 Wine 0 + own2 honest emit, no AC bypass / no anti-tamper bypass). 본
    // module 측 online entry block 5-attempt trace (attempt × blocked × allowed ×
    // offline × eac_active) = synthetic — `start_game_in_offline_mode.exe` FromSoft
    // 정식 mechanism honest detect, no bypass. cond.1 status `partial` 영구 유지
    // (retired_intentional posture per blk.1 영구 lock).
    // pattern reference:
    //     lib/perf/c_elden_eac_offline_launch_probe.hexa (Track AS predecessor, schema mirror)
    //
    // synthetic posture row column header:
    //     domain                "online_entry_block"
    //     posture               "retired_intentional"
    //     production_smoke      "no_attempt"
    //     drm_bypass            "0"                    (own1 Wine 0)
    //     ac_bypass             "0"                    (own1 honest acknowledgment)
    //     anti_tamper_bypass    "0"                    (EAC anti-tamper boundary)
    //     blocker_ref           "elden_ring.blk.1"     (eac_anti_tamper)
    //     adoption_iso          "2026-05-03"           (Track C 4-game retired_intentional)
    r0_emit("c_elden_online_entry_block_retired_intentional",
        "\"stage\":\"elden_ring_eac_synthetic\",\"domain\":\"online_entry_block\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"ac_bypass\":0,\"anti_tamper_bypass\":0,\"blocker_ref\":\"elden_ring.blk.1\",\"blocker_class\":\"eac_anti_tamper\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"elden_ring.cond.1\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\",\"track\":\"BE\"")
    println("__ELDEN_ONLINE_ENTRY__ RETIRED_INTENTIONAL elden_ring_eac_synthetic")

    cleanup_eoeb()

    println("  ✅ c_elden_online_entry_block self_test PASS (5 attempts, 3 blocked, 2 allowed, offline=2, eac_active=3, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = eoeb_stats()
            println("attempts=" + to_string(s[0]) + " blocked=" + to_string(s[1]) + " allowed=" + to_string(s[2]) + " offline=" + to_string(s[3]))
            return
        }
        if sub == "count_mode" {
            if len(a) >= 4 {
                let m = to_int(a[3])
                let n = count_by_mode(m)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_eoeb(); println("cleaned"); return }
    }
    println("usage: hexa run c_elden_online_entry_block.hexa { self-test | stats | count_mode <mode> | cleanup }")
}
