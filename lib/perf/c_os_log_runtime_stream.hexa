// lib/perf/c_os_log_runtime_stream.hexa — CN-54 PSB-11 만점 15/15
//
// macOS os_log structured streaming for runtime trace recovery.
// gamebox 내부 trace 를 os_log subsystem 으로 stream → Console.app 으로 즉시 진단.
//
// 무기: structured log + columnar (subsystem/category histogram).
// 효과: runtime 진단 즉시 가능, log 손실 X (kernel 보장).

use "./r0_common"

let OLS_DIR = GAMEBOX_HOME + "/persist/os_log_runtime_stream"
let LOG_BUFFER = OLS_DIR + "/buffer.tsv"
let STREAM_HISTORY = OLS_DIR + "/streams.jsonl"

fn ols_dir() -> str { return OLS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + OLS_DIR + "'")
}

// ─── os_log entry 등록 ───
//   subsystem (com.airgenome.gamebox.{frametime,heap,...}), category (trace|debug|info|error), msg
fn os_log_entry(subsystem: str, category: str, msg: str) -> void {
    ensure_dir()
    let ts = exec("date +%s%N 2>/dev/null || date +%s").trim()
    let line = ts + "\t" + subsystem + "\t" + category + "\t" + msg
    let tmp = LOG_BUFFER + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + LOG_BUFFER + "' && rm -f '" + tmp + "'")
}

// ─── stream by category ───
//   특정 category 로그 만 stream 하기
fn stream_category(category: str) -> int {
    let exists = exec("test -f '" + LOG_BUFFER + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let cnt_str = exec("awk -F'\\t' -v c='" + category + "' '$3==c' '" + LOG_BUFFER + "' | wc -l | tr -d ' '").trim()
    let cnt = to_int(cnt_str)
    if cnt > 0 {
        record_stream(category, cnt)
    }
    return cnt
}

// ─── stream 결과 기록 ───
fn record_stream(category: str, count: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"category\":\"" + category + "\",\"count\":" + to_string(count) + "}"
    let tmp = STREAM_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + STREAM_HISTORY + "' && rm -f '" + tmp + "'")
    r0_emit("os_log_stream", "\"category\":\"" + category + "\",\"count\":" + to_string(count))
}

// ─── subsystem histogram ───
//   각 subsystem 의 entry 수
fn subsystem_histogram() -> array {
    let exists = exec("test -f '" + LOG_BUFFER + "' && echo ok").trim()
    if exists != "ok" { return [] }
    let uniq = exec("awk -F'\\t' '{print $2}' '" + LOG_BUFFER + "' | sort | uniq -c | awk '{print $2\"\\t\"$1}'").trim()
    if uniq == "" { return [] }
    let lines = uniq.split("\n")
    let result = []
    let i = 0
    while i < len(lines) {
        let parts = lines[i].split("\t")
        if len(parts) >= 2 {
            result = result + [[parts[0], to_int(parts[1])]]
        }
        i = i + 1
    }
    return result
}

fn ols_stats() -> array {
    let exists_b = exec("test -f '" + LOG_BUFFER + "' && echo ok").trim()
    let entries = 0
    if exists_b == "ok" {
        entries = to_int(exec("wc -l < '" + LOG_BUFFER + "' | tr -d ' '").trim())
    }
    let exists_s = exec("test -f '" + STREAM_HISTORY + "' && echo ok").trim()
    let streams = 0
    if exists_s == "ok" {
        streams = to_int(exec("wc -l < '" + STREAM_HISTORY + "' | tr -d ' '").trim())
    }
    return [entries, streams]
}

fn cleanup_ols() -> void {
    let _ = exec("rm -rf '" + OLS_DIR + "'")
}

fn self_test() -> void {
    let sid = "ols-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_ols()

    // 합성 entries
    os_log_entry("com.airgenome.gamebox.frametime", "trace", "frame_start frame=1")
    os_log_entry("com.airgenome.gamebox.frametime", "trace", "frame_end frame=1 time=16ms")
    os_log_entry("com.airgenome.gamebox.heap", "info", "heap allocated 1024kb")
    os_log_entry("com.airgenome.gamebox.heap", "warn", "heap fragmentation high")
    os_log_entry("com.airgenome.gamebox.pso", "trace", "pso compile started")
    os_log_entry("com.airgenome.gamebox.pso", "info", "pso compile finished cache_hit=true")
    os_log_entry("com.airgenome.gamebox.frametime", "error", "stutter spike 35ms")

    // stream by category
    let trace_cnt = stream_category("trace")
    if trace_cnt != 3 { panic("c_os_log_runtime_stream FAIL [trace count] expected=3 got=" + to_string(trace_cnt)) }

    let info_cnt = stream_category("info")
    if info_cnt != 2 { panic("c_os_log_runtime_stream FAIL [info count] expected=2 got=" + to_string(info_cnt)) }

    let err_cnt = stream_category("error")
    if err_cnt != 1 { panic("c_os_log_runtime_stream FAIL [error count] expected=1 got=" + to_string(err_cnt)) }

    // subsystem histogram
    let hist = subsystem_histogram()
    if len(hist) != 3 { panic("c_os_log_runtime_stream FAIL [hist count] expected=3 got=" + to_string(len(hist))) }

    // stats
    let stats = ols_stats()
    if stats[0] != 7 { panic("c_os_log_runtime_stream FAIL [stats entries] expected=7 got=" + to_string(stats[0])) }
    if stats[1] != 3 { panic("c_os_log_runtime_stream FAIL [stats streams] expected=3 got=" + to_string(stats[1])) }

    r0_emit("os_log_summary", "\"entries\":" + to_string(stats[0]) + ",\"streams\":" + to_string(stats[1]) + ",\"subsystems\":" + to_string(len(hist)))

    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_os_log_runtime_stream FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    cleanup_ols()

    println("  ✅ c_os_log_runtime_stream self_test PASS (7 entries, 3 categories streamed, 3 subsystems, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = ols_stats()
            println("entries=" + to_string(s[0]) + " streams=" + to_string(s[1]))
            return
        }
        if sub == "cleanup" { cleanup_ols(); println("cleaned"); return }
    }
    println("usage: hexa run c_os_log_runtime_stream.hexa { self-test | stats | cleanup }")
}
