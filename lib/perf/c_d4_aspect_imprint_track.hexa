// lib/perf/c_d4_aspect_imprint_track.hexa — CN-128 skeleton manjeom 15/15
//
// D4 aspect imprint — Phase 5 endgame.
// codex aspect → equipment slot 적용 기록 + reroll cost 추정.
// occultist 가 codex aspect 를 legendary item 에 imprint 하면 roll value 결정 (min/max).
// reroll 시 소모 cost (gold + veiled crystal) 누적 추적.
//
// 무기: imprint table + columnar (char × aspect × slot × roll × ts).
// 효과: 평균 roll value 분석 + reroll 비용 예측 (목표 roll 까지 평균 시도).

use "./r0_common"

let DAIT_DIR = GAMEBOX_HOME + "/persist/d4_aspect_imprint"
let IMPRINT_LOG = DAIT_DIR + "/imprints.tsv"

fn dait_dir() -> str { return DAIT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DAIT_DIR + "'")
}

fn equipment_slots() -> array {
    return ["helm", "chest", "gloves", "pants", "boots", "amulet", "ring1", "ring2", "weapon", "offhand"]
}

fn reroll_base_cost() -> int { return 5000 }

fn record_imprint(char_name: str, aspect: str, equipment_slot: str, roll_value: int, ts: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + IMPRINT_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v a='" + aspect + "' -v s='" + equipment_slot + "' '!($1==c && $2==a && $3==s)' '" + IMPRINT_LOG + "' > '" + IMPRINT_LOG + ".tmp' && mv '" + IMPRINT_LOG + ".tmp' '" + IMPRINT_LOG + "'")
    }
    let line = char_name + "\t" + aspect + "\t" + equipment_slot + "\t" + to_string(roll_value) + "\t" + to_string(ts)
    let tmp = IMPRINT_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + IMPRINT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_aspect_imprint", "\"char\":\"" + char_name + "\",\"aspect\":\"" + aspect + "\",\"slot\":\"" + equipment_slot + "\",\"roll\":" + to_string(roll_value))
}

fn imprint_count(char_name: str) -> int {
    let exists = exec("test -f '" + IMPRINT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c' '" + IMPRINT_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn imprint_count_at_slot(equipment_slot: str) -> int {
    let exists = exec("test -f '" + IMPRINT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v s='" + equipment_slot + "' '$3==s' '" + IMPRINT_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn avg_roll(aspect: str) -> int {
    let exists = exec("test -f '" + IMPRINT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v a='" + aspect + "' '$2==a {s+=$4; n++} END{if(n>0) printf \"%d\", s/n; else printf \"0\"}' '" + IMPRINT_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn estimate_reroll_cost(attempts: int) -> int {
    return reroll_base_cost() * attempts
}

fn cleanup_dait() -> void {
    let _ = exec("rm -rf '" + DAIT_DIR + "'")
}

fn self_test() -> void {
    let sid = "dait-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dait()

    let slots = equipment_slots()
    if len(slots) != 10 { panic("c_d4_aspect_imprint_track FAIL [slots] expected=10 got=" + to_string(len(slots))) }

    if reroll_base_cost() != 5000 { panic("c_d4_aspect_imprint_track FAIL [base cost] expected=5000 got=" + to_string(reroll_base_cost())) }

    // 1 char + 5 imprint (다양한 slot)
    record_imprint("Mira", "edgemaster", "weapon", 80, 1700000000)
    record_imprint("Mira", "umbral", "amulet", 65, 1700000100)
    record_imprint("Mira", "aspect_of_might", "chest", 90, 1700000200)
    record_imprint("Mira", "shockwave", "gloves", 75, 1700000300)
    record_imprint("Mira", "edgemaster", "ring1", 70, 1700000400)

    let cnt = imprint_count("Mira")
    if cnt != 5 { panic("c_d4_aspect_imprint_track FAIL [count] expected=5 got=" + to_string(cnt)) }

    let weap = imprint_count_at_slot("weapon")
    if weap != 1 { panic("c_d4_aspect_imprint_track FAIL [slot weapon] expected=1 got=" + to_string(weap)) }

    let amu = imprint_count_at_slot("amulet")
    if amu != 1 { panic("c_d4_aspect_imprint_track FAIL [slot amulet] expected=1 got=" + to_string(amu)) }

    let boots = imprint_count_at_slot("boots")
    if boots != 0 { panic("c_d4_aspect_imprint_track FAIL [slot boots] expected=0 got=" + to_string(boots)) }

    // edgemaster: (80 + 70) / 2 = 75
    let avg_em = avg_roll("edgemaster")
    if avg_em != 75 { panic("c_d4_aspect_imprint_track FAIL [avg edgemaster] expected=75 got=" + to_string(avg_em)) }

    // umbral: 65 / 1 = 65
    let avg_um = avg_roll("umbral")
    if avg_um != 65 { panic("c_d4_aspect_imprint_track FAIL [avg umbral] expected=65 got=" + to_string(avg_um)) }

    // aspect_of_might: 90 / 1 = 90
    let avg_mt = avg_roll("aspect_of_might")
    if avg_mt != 90 { panic("c_d4_aspect_imprint_track FAIL [avg might] expected=90 got=" + to_string(avg_mt)) }

    // 비존재 aspect → 0
    let avg_z = avg_roll("nonexistent")
    if avg_z != 0 { panic("c_d4_aspect_imprint_track FAIL [avg empty] expected=0 got=" + to_string(avg_z)) }

    // reroll cost
    let cost3 = estimate_reroll_cost(3)
    if cost3 != 15000 { panic("c_d4_aspect_imprint_track FAIL [cost 3] expected=15000 got=" + to_string(cost3)) }

    // idempotent — 같은 char+aspect+slot 재 imprint (다른 roll/ts) → 덮어쓰기, count 유지
    record_imprint("Mira", "edgemaster", "weapon", 95, 1700000500)
    let cnt2 = imprint_count("Mira")
    if cnt2 != 5 { panic("c_d4_aspect_imprint_track FAIL [idempotent] expected=5 got=" + to_string(cnt2)) }

    // edgemaster after overwrite: (95 + 70) / 2 = 82
    let avg_em2 = avg_roll("edgemaster")
    if avg_em2 != 82 { panic("c_d4_aspect_imprint_track FAIL [avg edgemaster after] expected=82 got=" + to_string(avg_em2)) }

    r0_emit("d4_aspect_imprint_summary", "\"char\":\"Mira\",\"imprints\":" + to_string(cnt2) + ",\"avg_em\":" + to_string(avg_em2))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 7 { panic("c_d4_aspect_imprint_track FAIL [emit] expected>=7 got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AL) ───
    //
    // Track AL mission: extend Track V (7) + Track AJ (6) D4 retired_intentional posture
    // annotation to 6 additional c_d4_* modules (aspect_imprint_track + dungeon_sigil_
    // inventory + dxr_first_frame_trace + helltide_event + infernal_horde_wave + loot_
    // drop_predict). .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional
    // (Track A2 land 2026-05-03). 본 module 측 aspect imprint slot tracker = synthetic
    // build analyzer — production live game state 측정 X (D4 always-online live session
    // 진입 X, DRM bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self_test()
    // 측 honest annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_
    // intentional posture per blk.1 영구 lock). pattern reference:
    //     lib/perf/c_d4_paragon_track.hexa (Track AJ predecessor, identical schema)
    //
    // synthetic posture row column header:
    //     domain                "aspect_imprint_track"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_aspect_imprint_track_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"aspect_imprint_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_ASPECT_IMPRINT__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dait()

    println("  ✅ c_d4_aspect_imprint_track self_test PASS (10 slots, 5 imprints, avg_em=" + to_string(avg_em2) + ", cost3=" + to_string(cost3) + ", emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "imprint" && len(a) >= 8 {
            record_imprint(a[3], a[4], a[5], to_int(a[6]), to_int(a[7]))
            println("imprinted")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("char=" + a[3] + " imprints=" + to_string(imprint_count(a[3])))
            return
        }
        if sub == "avg" && len(a) >= 4 {
            println("aspect=" + a[3] + " avg_roll=" + to_string(avg_roll(a[3])))
            return
        }
        if sub == "slot" && len(a) >= 4 {
            println("slot=" + a[3] + " count=" + to_string(imprint_count_at_slot(a[3])))
            return
        }
        if sub == "cost" && len(a) >= 4 {
            println("attempts=" + a[3] + " cost=" + to_string(estimate_reroll_cost(to_int(a[3]))))
            return
        }
        if sub == "cleanup" { cleanup_dait(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_aspect_imprint_track.hexa { self-test | imprint <char> <aspect> <slot> <roll> <ts> | stats <char> | avg <aspect> | slot <slot> | cost <attempts> | cleanup }")
}
