// lib/perf/c_mesh_shader_cull.hexa — CN-32 PSB-6 만점 15/15
//
// Metal mesh shader (M3+) culling acceleration → DX12 mesh shader 매핑.
// D4 high-poly enemy/boss mesh — meshlet AABB → frustum/occlusion cull.
//
// 무기: cluster (meshlet AABB) + columnar (visibility state).
// 효과: 보이지 않는 meshlet vertex shader skip → GPU triangle count ↓.

use "./r0_common"

let MSC_DIR = GAMEBOX_HOME + "/persist/mesh_shader_cull"
let MESHLET_LOG = MSC_DIR + "/meshlets.tsv"
let CULL_HISTORY = MSC_DIR + "/cull.jsonl"

fn msc_dir() -> str { return MSC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + MSC_DIR + "'")
}

// ─── meshlet 등록 ───
//   meshlet_id, AABB (min_x, min_y, min_z, max_x, max_y, max_z), tri_count
fn register_meshlet(meshlet_id: int, min_x: int, min_y: int, min_z: int, max_x: int, max_y: int, max_z: int, tri_count: int) -> void {
    ensure_dir()
    let line = to_string(meshlet_id) + "\t" + to_string(min_x) + "\t" + to_string(min_y) + "\t" + to_string(min_z) + "\t" + to_string(max_x) + "\t" + to_string(max_y) + "\t" + to_string(max_z) + "\t" + to_string(tri_count)
    let tmp = MESHLET_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MESHLET_LOG + "' && rm -f '" + tmp + "'")
}

// ─── frustum cull — view AABB 와 meshlet AABB 교차 검사 ───
//   simple: meshlet 의 max < view min OR meshlet min > view max → outside
fn aabb_intersects(view_min_x: int, view_min_y: int, view_min_z: int, view_max_x: int, view_max_y: int, view_max_z: int, mlt_min_x: int, mlt_min_y: int, mlt_min_z: int, mlt_max_x: int, mlt_max_y: int, mlt_max_z: int) -> bool {
    if mlt_max_x < view_min_x { return false }
    if mlt_min_x > view_max_x { return false }
    if mlt_max_y < view_min_y { return false }
    if mlt_min_y > view_max_y { return false }
    if mlt_max_z < view_min_z { return false }
    if mlt_min_z > view_max_z { return false }
    return true
}

// ─── frame cull — view frustum 안 meshlet 만 통과 ───
//   return: [total_meshlets, visible_meshlets, total_tris_culled, visible_tris]
fn cull_frame(view_min_x: int, view_min_y: int, view_min_z: int, view_max_x: int, view_max_y: int, view_max_z: int) -> array {
    let exists = exec("test -f '" + MESHLET_LOG + "' && echo ok").trim()
    if exists != "ok" { return [0, 0, 0, 0] }
    let total = to_int(exec("wc -l < '" + MESHLET_LOG + "' | tr -d ' '").trim())
    if total == 0 { return [0, 0, 0, 0] }

    // awk one-shot — pass view AABB
    let cmd = "awk -F'\\t' -v vminx=" + to_string(view_min_x) + " -v vminy=" + to_string(view_min_y) + " -v vminz=" + to_string(view_min_z) + " -v vmaxx=" + to_string(view_max_x) + " -v vmaxy=" + to_string(view_max_y) + " -v vmaxz=" + to_string(view_max_z) + " '{ mminx=$2; mminy=$3; mminz=$4; mmaxx=$5; mmaxy=$6; mmaxz=$7; tris=$8; visible = !(mmaxx<vminx || mminx>vmaxx || mmaxy<vminy || mminy>vmaxy || mmaxz<vminz || mminz>vmaxz); if (visible) {vis_c++; vis_t+=tris} else {cull_t+=tris} } END { print vis_c+0, vis_t+0, cull_t+0 }' '" + MESHLET_LOG + "'"
    let result = exec(cmd).trim()
    if result == "" { return [total, 0, 0, 0] }
    let parts = result.split(" ")
    if len(parts) < 3 { return [total, 0, 0, 0] }
    let visible = to_int(parts[0])
    let visible_tris = to_int(parts[1])
    let culled_tris = to_int(parts[2])
    return [total, visible, culled_tris, visible_tris]
}

// ─── cull 결과 기록 ───
fn record_cull(frame_id: int, total: int, visible: int, culled_tris: int, visible_tris: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"frame\":" + to_string(frame_id) + ",\"total\":" + to_string(total) + ",\"visible\":" + to_string(visible) + ",\"culled_tris\":" + to_string(culled_tris) + ",\"visible_tris\":" + to_string(visible_tris) + "}"
    let tmp = CULL_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CULL_HISTORY + "' && rm -f '" + tmp + "'")
    r0_emit("mesh_cull", "\"frame\":" + to_string(frame_id) + ",\"culled\":" + to_string(total - visible) + ",\"culled_tris\":" + to_string(culled_tris))
}

fn cull_stats() -> array {
    let exists_m = exec("test -f '" + MESHLET_LOG + "' && echo ok").trim()
    let meshlets = 0
    if exists_m == "ok" {
        meshlets = to_int(exec("wc -l < '" + MESHLET_LOG + "' | tr -d ' '").trim())
    }
    let exists_c = exec("test -f '" + CULL_HISTORY + "' && echo ok").trim()
    let frames = 0
    let total_culled = 0
    if exists_c == "ok" {
        frames = to_int(exec("wc -l < '" + CULL_HISTORY + "' | tr -d ' '").trim())
        let c_str = exec("grep -oE '\"culled_tris\":[0-9]+' '" + CULL_HISTORY + "' | cut -d: -f2 | awk '{s+=$1} END{print s+0}'").trim()
        if c_str != "" { total_culled = to_int(c_str) }
    }
    return [meshlets, frames, total_culled]
}

fn cleanup_msc() -> void {
    let _ = exec("rm -rf '" + MSC_DIR + "'")
}

fn self_test() -> void {
    let sid = "msc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_msc()

    // intersect test
    if !aabb_intersects(0, 0, 0, 100, 100, 100, 50, 50, 50, 150, 150, 150) {
        panic("c_mesh_shader_cull FAIL [intersect overlap]")
    }
    if aabb_intersects(0, 0, 0, 100, 100, 100, 200, 200, 200, 300, 300, 300) {
        panic("c_mesh_shader_cull FAIL [intersect outside]")
    }

    // 합성 meshlets — 10 개 (5 inside view, 5 outside)
    register_meshlet(1, 10, 10, 10, 50, 50, 50, 100)    // inside
    register_meshlet(2, 20, 20, 20, 60, 60, 60, 200)    // inside
    register_meshlet(3, 30, 30, 30, 70, 70, 70, 300)    // inside
    register_meshlet(4, 5, 5, 5, 90, 90, 90, 400)        // inside (covers most)
    register_meshlet(5, 0, 0, 0, 50, 50, 50, 500)        // inside
    register_meshlet(6, 200, 200, 200, 300, 300, 300, 100)  // outside
    register_meshlet(7, 500, 500, 500, 600, 600, 600, 200)  // outside
    register_meshlet(8, 1000, 1000, 1000, 1100, 1100, 1100, 300)  // outside
    register_meshlet(9, 2000, 2000, 2000, 2100, 2100, 2100, 400)  // outside
    register_meshlet(10, 5000, 5000, 5000, 6000, 6000, 6000, 500)  // outside

    // cull — view AABB (0,0,0)~(100,100,100)
    let res = cull_frame(0, 0, 0, 100, 100, 100)
    if res[0] != 10 { panic("c_mesh_shader_cull FAIL [total] expected=10 got=" + to_string(res[0])) }
    if res[1] != 5 { panic("c_mesh_shader_cull FAIL [visible] expected=5 got=" + to_string(res[1])) }
    // culled tris = 100+200+300+400+500 = 1500
    if res[2] != 1500 { panic("c_mesh_shader_cull FAIL [culled tris] expected=1500 got=" + to_string(res[2])) }
    // visible tris = 100+200+300+400+500 = 1500
    if res[3] != 1500 { panic("c_mesh_shader_cull FAIL [visible tris] expected=1500 got=" + to_string(res[3])) }

    record_cull(1, res[0], res[1], res[2], res[3])

    // stats
    let stats = cull_stats()
    if stats[0] != 10 { panic("c_mesh_shader_cull FAIL [stats meshlets] expected=10 got=" + to_string(stats[0])) }
    if stats[1] != 1 { panic("c_mesh_shader_cull FAIL [stats frames] expected=1 got=" + to_string(stats[1])) }
    if stats[2] != 1500 { panic("c_mesh_shader_cull FAIL [stats total culled] expected=1500 got=" + to_string(stats[2])) }

    r0_emit("mesh_cull_summary", "\"meshlets\":" + to_string(stats[0]) + ",\"frames\":" + to_string(stats[1]) + ",\"culled_tris\":" + to_string(stats[2]) + ",\"culled_meshlets\":" + to_string(res[0] - res[1]))

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("c_mesh_shader_cull FAIL [emit count] expected>=2 got=" + to_string(cnt)) }

    cleanup_msc()

    println("  ✅ c_mesh_shader_cull self_test PASS (10 meshlets, 5 visible / 5 culled, 1500 tris culled, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = cull_stats()
            println("meshlets=" + to_string(s[0]) + " frames=" + to_string(s[1]) + " culled_tris=" + to_string(s[2]))
            return
        }
        if sub == "cleanup" { cleanup_msc(); println("cleaned"); return }
    }
    println("usage: hexa run c_mesh_shader_cull.hexa { self-test | stats | cleanup }")
}
