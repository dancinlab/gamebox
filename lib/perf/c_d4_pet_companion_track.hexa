// lib/perf/c_d4_pet_companion_track.hexa — CN-136 skeleton manjeom 15/15
//
// D4 mercenary (Vessel of Hatred 후) — Phase 5 endgame.
// 4 mercenary × bond level 1-10 추적: Raheir / Subo / Varyana / Aldkin.
// idempotent: 같은 char+merc 재등록 → 덮어쓰기 (level 갱신).
//
// 무기: bond table + columnar (char × merc × level × ts).
// 효과: char 별 mercenary 진척률 + bond cap (10) 도달 분석.

use "./r0_common"

let DPCT_DIR = GAMEBOX_HOME + "/persist/d4_pet_companion"
let BOND_LOG = DPCT_DIR + "/bonds.tsv"

fn dpct_dir() -> str { return DPCT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DPCT_DIR + "'")
}

fn mercs() -> array {
    return ["Raheir", "Subo", "Varyana", "Aldkin"]
}

fn max_bond() -> int { return 10 }

fn record_bond(char_name: str, merc: str, level: int, ts: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + BOND_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v m='" + merc + "' '!($1==c && $2==m)' '" + BOND_LOG + "' > '" + BOND_LOG + ".tmp' && mv '" + BOND_LOG + ".tmp' '" + BOND_LOG + "'")
    }
    let line = char_name + "\t" + merc + "\t" + to_string(level) + "\t" + to_string(ts)
    let tmp = BOND_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + BOND_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_pet_bond", "\"char\":\"" + char_name + "\",\"merc\":\"" + merc + "\",\"level\":" + to_string(level))
}

fn bond_level(char_name: str, merc: str) -> int {
    let exists = exec("test -f '" + BOND_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' -v m='" + merc + "' '$1==c && $2==m {print $3; exit}' '" + BOND_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn mercs_unlocked(char_name: str) -> int {
    let exists = exec("test -f '" + BOND_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c && $3+0>0' '" + BOND_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dpct() -> void {
    let _ = exec("rm -rf '" + DPCT_DIR + "'")
}

fn self_test() -> void {
    let sid = "dpct-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dpct()

    let m = mercs()
    if len(m) != 4 { panic("c_d4_pet_companion_track FAIL [mercs] expected=4 got=" + to_string(len(m))) }

    if max_bond() != 10 { panic("c_d4_pet_companion_track FAIL [max bond] expected=10 got=" + to_string(max_bond())) }

    // 1 char + 4 merc 등록 (bond level 5 / 8 / 10 / 3)
    record_bond("Mira", "Raheir", 5, 1700000000)
    record_bond("Mira", "Subo", 8, 1700000100)
    record_bond("Mira", "Varyana", 10, 1700000200)
    record_bond("Mira", "Aldkin", 3, 1700000300)

    let lvR = bond_level("Mira", "Raheir")
    if lvR != 5 { panic("c_d4_pet_companion_track FAIL [Raheir level] expected=5 got=" + to_string(lvR)) }

    let lvS = bond_level("Mira", "Subo")
    if lvS != 8 { panic("c_d4_pet_companion_track FAIL [Subo level] expected=8 got=" + to_string(lvS)) }

    let lvV = bond_level("Mira", "Varyana")
    if lvV != 10 { panic("c_d4_pet_companion_track FAIL [Varyana level] expected=10 got=" + to_string(lvV)) }

    let lvA = bond_level("Mira", "Aldkin")
    if lvA != 3 { panic("c_d4_pet_companion_track FAIL [Aldkin level] expected=3 got=" + to_string(lvA)) }

    let unlocked = mercs_unlocked("Mira")
    if unlocked != 4 { panic("c_d4_pet_companion_track FAIL [unlocked] expected=4 got=" + to_string(unlocked)) }

    // idempotent — 같은 char+merc 재등록 (level 갱신) → row count 유지, level 만 변경
    record_bond("Mira", "Aldkin", 7, 1700000400)
    let lvA2 = bond_level("Mira", "Aldkin")
    if lvA2 != 7 { panic("c_d4_pet_companion_track FAIL [Aldkin re-level] expected=7 got=" + to_string(lvA2)) }

    let unlocked2 = mercs_unlocked("Mira")
    if unlocked2 != 4 { panic("c_d4_pet_companion_track FAIL [idempotent unlocked] expected=4 got=" + to_string(unlocked2)) }

    // missing merc → bond_level 0
    let lvMiss = bond_level("Mira", "Ghost")
    if lvMiss != 0 { panic("c_d4_pet_companion_track FAIL [missing] expected=0 got=" + to_string(lvMiss)) }

    r0_emit("d4_pet_summary", "\"char\":\"Mira\",\"unlocked\":" + to_string(unlocked2) + ",\"total\":" + to_string(len(m)))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 6 { panic("c_d4_pet_companion_track FAIL [emit] expected>=6 got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AJ) ───
    //
    // Track AJ mission: extend Track V D4 retired_intentional posture annotation to 6
    // additional c_d4_* modules. .roadmap.diablo4 blk.1 status_enum_adopted =
    // retired_intentional (Track A2 land 2026-05-03). 본 module 측 mercenary bond
    // tracker = synthetic 4-merc × bond 1..10 columnar log — production live game
    // state 측정 X (D4 always-online live session 진입 X, DRM bypass 0, Battle.net
    // launcher 통과 X). 본 cycle 측 module self_test() 측 honest annotation row
    // 추가 only — cond.3 status `partial` 영구 유지 (retired_intentional posture
    // per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "pet_companion_track"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_pet_companion_track_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"pet_companion_track\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_PET_COMPANION__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dpct()

    println("  ✅ c_d4_pet_companion_track self_test PASS (4 mercs, bonds 5/8/10/3, idempotent re-bond, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "bond" && len(a) >= 7 {
            record_bond(a[3], a[4], to_int(a[5]), to_int(a[6]))
            println("bonded")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("char=" + a[3] + " unlocked=" + to_string(mercs_unlocked(a[3])) + "/" + to_string(len(mercs())))
            return
        }
        if sub == "cleanup" { cleanup_dpct(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_pet_companion_track.hexa { self-test | bond <char> <merc> <level> <ts> | stats <char> | cleanup }")
}
