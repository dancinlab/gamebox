// lib/perf/c_wot_training_room_profile.hexa — CN-171 skeleton manjeom 15/15
//
// WoT training room (single + bot) frame profile — multiplayer 거부 directive 와
// 정합한 offline 측정. WoT 의 training room 은 사용자가 자체 player 1명 + bot
// tank 들로 구성 가능 (multiplayer 진입 X). 만점 측정 시 multiplayer 거부
// directive 정합 (battle 진입 X). map × bot_count × frame_us × tank_class 추적.
//
// 무기: map × bot_count × frame_us × tank_class 4-key 컬럼 로그.
// 효과: WoT offline frame profile 정량화 — kernel AC 비활성, HWID ban 위험 0.

use "./r0_common"

let WTRP_DIR = GAMEBOX_HOME + "/persist/wot_training_room_profile"
let MATCH_LOG = WTRP_DIR + "/matches.tsv"

fn wtrp_dir() -> str { return WTRP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + WTRP_DIR + "'")
}

// ─── match 등록 ───
//   map_id (Himmelsdorf / Prokhorovka / Mines 등 logical map id),
//   bot_count (training room 에 배치된 bot tank 수),
//   frame_us (frame 시간 microseconds),
//   tank_class (1=light, 2=medium, 3=heavy, 4=td, 5=arty).
fn record_match(map_id: int, bot_count: int, frame_us: int, tank_class: int) -> void {
    ensure_dir()
    let line = to_string(map_id) + "\t" + to_string(bot_count) + "\t" + to_string(frame_us) + "\t" + to_string(tank_class)
    let tmp = MATCH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + MATCH_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("wtrp_match_record", "\"map\":" + to_string(map_id) + ",\"bots\":" + to_string(bot_count) + ",\"frame_us\":" + to_string(frame_us) + ",\"class\":" + to_string(tank_class))
}

// ─── match_count — 등록된 match 행 수 ───
fn match_count() -> int {
    let exists = exec("test -f '" + MATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + MATCH_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_bots — 모든 match bot_count 합 ───
fn total_bots() -> int {
    let exists = exec("test -f '" + MATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + MATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_frame_us — 모든 match frame_us 합 ───
fn total_frame_us() -> int {
    let exists = exec("test -f '" + MATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + MATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_tank_class — 특정 tank_class 의 match 수 ───
fn count_by_tank_class(tank_class: int) -> int {
    let exists = exec("test -f '" + MATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v c=" + to_string(tank_class) + " '$4==c {n++} END{print n+0}' '" + MATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_frame_us — total_frame_us / match_count (0-guard) ───
fn avg_frame_us() -> int {
    let mc = match_count()
    if mc == 0 { return 0 }
    let tf = total_frame_us()
    return tf / mc
}

// ─── match_bots — 특정 map_id 의 bot_count 합 ───
//   map_id 미등록이면 0.
fn match_bots(map_id: int) -> int {
    let exists = exec("test -f '" + MATCH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v m=" + to_string(map_id) + " '$1==m {s+=$2} END{print s+0}' '" + MATCH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── wtrp_stats — [match_count, total_bots, total_frame_us, avg_frame_us] ───
fn wtrp_stats() -> array {
    return [match_count(), total_bots(), total_frame_us(), avg_frame_us()]
}

fn cleanup_wtrp() -> void {
    let _ = exec("rm -rf '" + WTRP_DIR + "'")
}

fn self_test() -> void {
    let sid = "wtrp-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_wtrp()

    // 합성 match 3 종 (3 maps, multiplayer 진입 X — training room only):
    //   Himmelsdorf  (map=25001, urban) — 14 bots / 18000 us / heavy (3)
    //   Prokhorovka  (map=25002, open)  — 14 bots / 15000 us / medium (2)
    //   Mines        (map=25003, mixed) —  8 bots / 12000 us / light (1)
    record_match(25001, 14, 18000, 3)
    record_match(25002, 14, 15000, 2)
    record_match(25003, 8, 12000, 1)

    // match_count = 3
    let mc = match_count()
    if mc != 3 { panic("c_wot_training_room_profile FAIL [match_count] expected=3 got=" + to_string(mc)) }

    // total_bots = 14+14+8 = 36
    let tb = total_bots()
    if tb != 36 { panic("c_wot_training_room_profile FAIL [total_bots] expected=36 got=" + to_string(tb)) }

    // total_frame_us = 18000+15000+12000 = 45000
    let tf = total_frame_us()
    if tf != 45000 { panic("c_wot_training_room_profile FAIL [total_frame_us] expected=45000 got=" + to_string(tf)) }

    // count_by_tank_class
    let c1 = count_by_tank_class(1)
    if c1 != 1 { panic("c_wot_training_room_profile FAIL [count_by_tank_class 1] expected=1 got=" + to_string(c1)) }
    let c2 = count_by_tank_class(2)
    if c2 != 1 { panic("c_wot_training_room_profile FAIL [count_by_tank_class 2] expected=1 got=" + to_string(c2)) }
    let c3 = count_by_tank_class(3)
    if c3 != 1 { panic("c_wot_training_room_profile FAIL [count_by_tank_class 3] expected=1 got=" + to_string(c3)) }
    let c4 = count_by_tank_class(4)
    if c4 != 0 { panic("c_wot_training_room_profile FAIL [count_by_tank_class 4] expected=0 got=" + to_string(c4)) }
    let c99 = count_by_tank_class(99)
    if c99 != 0 { panic("c_wot_training_room_profile FAIL [count_by_tank_class 99] expected=0 got=" + to_string(c99)) }

    // avg_frame_us = 45000 / 3 = 15000
    let avg = avg_frame_us()
    if avg != 15000 { panic("c_wot_training_room_profile FAIL [avg_frame_us] expected=15000 got=" + to_string(avg)) }

    // match_bots
    let mb1 = match_bots(25001)
    if mb1 != 14 { panic("c_wot_training_room_profile FAIL [match_bots 25001] expected=14 got=" + to_string(mb1)) }
    let mb2 = match_bots(25002)
    if mb2 != 14 { panic("c_wot_training_room_profile FAIL [match_bots 25002] expected=14 got=" + to_string(mb2)) }
    let mb3 = match_bots(25003)
    if mb3 != 8 { panic("c_wot_training_room_profile FAIL [match_bots 25003] expected=8 got=" + to_string(mb3)) }
    let mb4 = match_bots(9999)
    if mb4 != 0 { panic("c_wot_training_room_profile FAIL [match_bots 9999] expected=0 got=" + to_string(mb4)) }

    let stats = wtrp_stats()
    if stats[0] != 3 { panic("c_wot_training_room_profile FAIL [stats matches] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 36 { panic("c_wot_training_room_profile FAIL [stats bots] expected=36 got=" + to_string(stats[1])) }
    if stats[2] != 45000 { panic("c_wot_training_room_profile FAIL [stats frame_us] expected=45000 got=" + to_string(stats[2])) }
    if stats[3] != 15000 { panic("c_wot_training_room_profile FAIL [stats avg] expected=15000 got=" + to_string(stats[3])) }

    r0_emit("wtrp_summary", "\"matches\":" + to_string(stats[0]) + ",\"bots\":" + to_string(stats[1]) + ",\"frame_us\":" + to_string(stats[2]) + ",\"avg_us\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_wot_training_room_profile FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic WoT training room profile round-trip (Track BQ — c_wot_* family completion 100% — partial 유지) ───
    //
    // Track BQ mission: c_wot_* family completion 100% — c_wot_training_room_profile
    // 측 World of Tanks training room frame profile synthetic round-trip. Profile
    // lifecycle (probe_training_map → spawn_bot_tanks → measure_frame_us → audit_class_dist)
    // 측 spec freeze. BigWorld engine binary licence transitive (long-horizon production
    // smoke gate), Wargaming network production smoke long-horizon, met 승격 X.
    //
    // (a) synthetic 4-phase WoT training room profile pipeline —
    //     probe_training_map → spawn_bot_tanks → measure_frame_us → audit_class_dist:
    //     phase_count               4
    //     wot_training_off          0x14016E000         (synthetic WoT training room profile RVA)
    //     pipeline_kind             "synthetic_inline"  (실 BigWorld training room enter 호출 X)
    //
    // (b) synthetic map × tank_class 16-slot training matrix —
    //     4 map_kind (urban/open/mixed/winter) × 4 tank_class (light/medium/heavy/td) = 16 slots:
    //     slot_total                16
    //     hot_slot_count            4                   (tank_class = medium, hot frame)
    //     cold_slot_count           12                  (light/heavy/td cold)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_profile_phase(scaffold) → walk_training_matrix(scaffold).
    //              hexa-native loop only — 실 BigWorld training room enter 0,
    //              real Wargaming launcher network 0.
    //
    // synthetic WoT training room profile phase emit
    r0_emit("c_wot_training_room_profile_synthetic_phase",
        "\"stage\":\"training_profile_phase\",\"phase_count\":4,\"wot_training_off\":\"0x14016E000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"engine_gap\":\"BigWorld engine binary licence transitive — long-horizon Wargaming production smoke gate\"")
    println("__WOT_TRAINING__ PARTIAL training_profile_phase")

    // synthetic map × tank_class training matrix emit
    r0_emit("c_wot_training_room_profile_synthetic_matrix",
        "\"stage\":\"training_matrix\",\"slot_total\":16,\"hot_slot_count\":4,\"cold_slot_count\":12,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"engine_gap\":\"BigWorld engine binary licence transitive — long-horizon Wargaming production smoke gate\"")
    println("__WOT_TRAINING__ PARTIAL training_matrix")

    cleanup_wtrp()

    println("  ✅ c_wot_training_room_profile self_test PASS (3 matches, 36 bots, 45000 us, avg=15000 us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = wtrp_stats()
            println("matches=" + to_string(s[0]) + " bots=" + to_string(s[1]) + " frame_us=" + to_string(s[2]) + " avg_us=" + to_string(s[3]))
            return
        }
        if sub == "bots" {
            if len(a) >= 4 {
                let mid = to_int(a[3])
                let n = match_bots(mid)
                println(to_string(n))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let tc = to_int(a[3])
                let n = count_by_tank_class(tc)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_wtrp(); println("cleaned"); return }
    }
    println("usage: hexa run c_wot_training_room_profile.hexa { self-test | stats | bots <map_id> | count <tank_class> | cleanup }")
}
