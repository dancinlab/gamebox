// lib/perf/c_d2r_act_progression.hexa — CN-111 skeleton manjeom 15/15
//
// D2R 5 act × 3 difficulty (Normal/Nightmare/Hell) campaign progression tracker.
// Phase 5 gameplay loop — char 의 캠페인 단계 즉시 가시화.
//
// 무기: 15 quest table (5 act × 3 diff) + columnar (act × difficulty × completed).
// 효과: char 가 어디까지 클리어했는지 한 줄로 요약 (예: Nightmare Act3).

use "./r0_common"

let DAP_DIR = GAMEBOX_HOME + "/persist/d2r_act_progression"
let QUEST_LOG = DAP_DIR + "/quests.tsv"

fn dap_dir() -> str { return DAP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DAP_DIR + "'")
}

// ─── D2R difficulty / act 정의 ───
fn difficulties() -> array {
    return ["normal", "nightmare", "hell"]
}

fn acts() -> array {
    return ["act1", "act2", "act3", "act4", "act5"]
}

// 각 act 의 main quest 개수 (D2R 기준):
// act1 = 6, act2 = 6, act3 = 6, act4 = 3, act5 = 6
fn quests_per_act(act: str) -> int {
    if act == "act1" { return 6 }
    if act == "act2" { return 6 }
    if act == "act3" { return 6 }
    if act == "act4" { return 3 }
    if act == "act5" { return 6 }
    return 0
}

fn record_quest_done(char_name: str, difficulty: str, act: str, quest_idx: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + QUEST_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v d='" + difficulty + "' -v a='" + act + "' -v i=" + to_string(quest_idx) + " '!($1==c && $2==d && $3==a && $4==i)' '" + QUEST_LOG + "' > '" + QUEST_LOG + ".tmp' && mv '" + QUEST_LOG + ".tmp' '" + QUEST_LOG + "'")
    }
    let line = char_name + "\t" + difficulty + "\t" + act + "\t" + to_string(quest_idx) + "\tdone"
    let tmp = QUEST_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + QUEST_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d2r_quest_done", "\"char\":\"" + char_name + "\",\"diff\":\"" + difficulty + "\",\"act\":\"" + act + "\",\"idx\":" + to_string(quest_idx))
}

fn act_complete(char_name: str, difficulty: str, act: str) -> bool {
    let exists = exec("test -f '" + QUEST_LOG + "' && echo ok").trim()
    if exists != "ok" { return false }
    let need = quests_per_act(act)
    if need == 0 { return false }
    let cnt_str = exec("awk -F'\\t' -v c='" + char_name + "' -v d='" + difficulty + "' -v a='" + act + "' '$1==c && $2==d && $3==a && $5==\"done\"' '" + QUEST_LOG + "' | wc -l | tr -d ' '").trim()
    if cnt_str == "" { return false }
    let cnt = to_int(cnt_str)
    if cnt >= need { return true }
    return false
}

// 가장 진행된 (difficulty, act) 반환 — "diff:act" string.
// 진행 없을시 빈 string.
fn char_at(char_name: str) -> str {
    let diffs = difficulties()
    let as_ = acts()
    let best = ""
    let di = 0
    while di < len(diffs) {
        let d = diffs[di]
        let ai = 0
        while ai < len(as_) {
            let a = as_[ai]
            if act_complete(char_name, d, a) {
                best = d + ":" + a
            }
            ai = ai + 1
        }
        di = di + 1
    }
    return best
}

fn dap_stats() -> int {
    let exists = exec("test -f '" + QUEST_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + QUEST_LOG + "' | tr -d ' '").trim())
}

fn cleanup_dap() -> void {
    let _ = exec("rm -rf '" + DAP_DIR + "'")
}

fn self_test() -> void {
    let sid = "dap-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dap()

    let diffs = difficulties()
    if len(diffs) != 3 { panic("c_d2r_act_progression FAIL [difficulties] expected=3 got=" + to_string(len(diffs))) }

    let as_ = acts()
    if len(as_) != 5 { panic("c_d2r_act_progression FAIL [acts] expected=5 got=" + to_string(len(as_))) }

    let total_slots = len(diffs) * len(as_)
    if total_slots != 15 { panic("c_d2r_act_progression FAIL [slot total] expected=15 got=" + to_string(total_slots)) }

    // synthetic — 1 char "Joe" Normal Act1~5 클리어
    let normal_acts = ["act1", "act2", "act3", "act4", "act5"]
    let na_i = 0
    while na_i < len(normal_acts) {
        let a = normal_acts[na_i]
        let need = quests_per_act(a)
        let qi = 0
        while qi < need {
            record_quest_done("Joe", "normal", a, qi)
            qi = qi + 1
        }
        na_i = na_i + 1
    }

    // Nightmare Act1~3 클리어
    let nm_acts = ["act1", "act2", "act3"]
    let nm_i = 0
    while nm_i < len(nm_acts) {
        let a = nm_acts[nm_i]
        let need = quests_per_act(a)
        let qi = 0
        while qi < need {
            record_quest_done("Joe", "nightmare", a, qi)
            qi = qi + 1
        }
        nm_i = nm_i + 1
    }

    // act_complete 검증
    if !act_complete("Joe", "normal", "act1") { panic("c_d2r_act_progression FAIL [normal act1 should be complete]") }
    if !act_complete("Joe", "normal", "act5") { panic("c_d2r_act_progression FAIL [normal act5 should be complete]") }
    if !act_complete("Joe", "nightmare", "act3") { panic("c_d2r_act_progression FAIL [nightmare act3 should be complete]") }
    if act_complete("Joe", "nightmare", "act4") { panic("c_d2r_act_progression FAIL [nightmare act4 should NOT be complete]") }
    if act_complete("Joe", "hell", "act1") { panic("c_d2r_act_progression FAIL [hell act1 should NOT be complete]") }

    let at = char_at("Joe")
    if at != "nightmare:act3" { panic("c_d2r_act_progression FAIL [char_at] expected=nightmare:act3 got=" + at) }

    // overwrite — 동일 quest 다시 등록해도 row 1 개로 유지
    record_quest_done("Joe", "normal", "act1", 0)
    if !act_complete("Joe", "normal", "act1") { panic("c_d2r_act_progression FAIL [overwrite] act1 still complete") }

    r0_emit("d2r_act_summary", "\"char\":\"Joe\",\"at\":\"" + at + "\",\"slots\":15")

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_d2r_act_progression FAIL [emit count] got=" + to_string(cnt)) }

    // ─── synthetic act progression state machine round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track AI mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic 5-act campaign progression state machine 5-phase cycle —
    //     act1 → act2 → act3 → act4 → act5 (campaign storyline progression):
    //     phase_count               5                   (act1/act2/act3/act4/act5)
    //     act_table_off             0x14008C000         (synthetic D2GAME.dll RVA)
    //     act_kind                  "synthetic_inline"  (실 quest log tick X)
    //
    // (b) synthetic difficulty × act 15-slot completion matrix scaffold —
    //     3 difficulty × 5 act = 15 slot walk:
    //     slot_total                15                  (3 diff × 5 act)
    //     completed_slot_count      8                   (Joe normal 5 + nightmare 3)
    //     matrix_kind               "synthetic_inline"  (실 quest_log lookup X)
    //
    // round-trip = synthesize_act_phase(scaffold) → walk_difficulty_matrix(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll quest log tick 0,
    //              real act progression 0.
    //
    // synthetic act phase emit
    r0_emit("c_d2r_act_progression_synthetic_phase",
        "\"stage\":\"act_phase\",\"phase_count\":5,\"act_table_off\":\"0x14008C000\",\"act_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_ACT__ PARTIAL act_phase")

    // synthetic difficulty matrix emit
    r0_emit("c_d2r_act_progression_synthetic_matrix",
        "\"stage\":\"difficulty_matrix\",\"slot_total\":15,\"completed_slot_count\":8,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_ACT__ PARTIAL difficulty_matrix")

    cleanup_dap()

    println("  ✅ c_d2r_act_progression self_test PASS (3 diff × 5 act = 15 slots, char_at=" + at + ", emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "quest" && len(a) >= 7 {
            record_quest_done(a[3], a[4], a[5], to_int(a[6]))
            println("recorded")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("char=" + a[3] + " at=" + char_at(a[3]) + " rows=" + to_string(dap_stats()))
            return
        }
        if sub == "cleanup" { cleanup_dap(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_act_progression.hexa { self-test | quest <char> <diff> <act> <idx> | stats <char> | cleanup }")
}
