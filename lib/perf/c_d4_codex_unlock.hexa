// lib/perf/c_d4_codex_unlock.hexa — CN-112 skeleton manjeom 15/15
//
// D4 codex of power — Phase 5 endgame.
// dungeon clear 시 legendary aspect 영구 해금 추적.
// weapon / armor / jewelry 슬롯 분류 + idempotent unlock (같은 char+aspect 덮어쓰기).
//
// 무기: aspect table + columnar (char × aspect × dungeon × ts).
// 효과: char 별 codex 진척률 + slot coverage 분석.

use "./r0_common"

let DCDX_DIR = GAMEBOX_HOME + "/persist/d4_codex"
let CODEX_LOG = DCDX_DIR + "/codex.tsv"

fn dcdx_dir() -> str { return DCDX_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DCDX_DIR + "'")
}

fn aspects() -> array {
    return ["aspect_of_might", "edgemaster", "umbral", "berserk_riding", "explosive_mastery", "shockwave", "echoing_fury", "blood_drinker"]
}

fn aspect_slot(name: str) -> str {
    if name == "aspect_of_might" { return "armor" }
    if name == "edgemaster" { return "weapon" }
    if name == "umbral" { return "jewelry" }
    if name == "berserk_riding" { return "armor" }
    if name == "explosive_mastery" { return "weapon" }
    if name == "shockwave" { return "weapon" }
    if name == "echoing_fury" { return "weapon" }
    if name == "blood_drinker" { return "jewelry" }
    return ""
}

fn record_unlock(char_name: str, aspect: str, dungeon: str, ts: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + CODEX_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v a='" + aspect + "' '!($1==c && $2==a)' '" + CODEX_LOG + "' > '" + CODEX_LOG + ".tmp' && mv '" + CODEX_LOG + ".tmp' '" + CODEX_LOG + "'")
    }
    let slot = aspect_slot(aspect)
    let line = char_name + "\t" + aspect + "\t" + slot + "\t" + dungeon + "\t" + to_string(ts)
    let tmp = CODEX_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CODEX_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_codex_unlock", "\"char\":\"" + char_name + "\",\"aspect\":\"" + aspect + "\",\"slot\":\"" + slot + "\",\"dungeon\":\"" + dungeon + "\"")
}

fn unlock_count(char_name: str) -> int {
    let exists = exec("test -f '" + CODEX_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' '$1==c' '" + CODEX_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn has_aspect(char_name: str, aspect: str) -> bool {
    let exists = exec("test -f '" + CODEX_LOG + "' && echo ok").trim()
    if exists != "ok" { return false }
    let r = exec("awk -F'\\t' -v c='" + char_name + "' -v a='" + aspect + "' '$1==c && $2==a' '" + CODEX_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return false }
    return to_int(r) > 0
}

fn cleanup_dcdx() -> void {
    let _ = exec("rm -rf '" + DCDX_DIR + "'")
}

fn self_test() -> void {
    let sid = "dcdx-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dcdx()

    let asp = aspects()
    if len(asp) != 8 { panic("c_d4_codex_unlock FAIL [aspects] expected=8 got=" + to_string(len(asp))) }

    if aspect_slot("edgemaster") != "weapon" { panic("c_d4_codex_unlock FAIL [slot edgemaster] expected=weapon got=" + aspect_slot("edgemaster")) }
    if aspect_slot("aspect_of_might") != "armor" { panic("c_d4_codex_unlock FAIL [slot might] expected=armor got=" + aspect_slot("aspect_of_might")) }
    if aspect_slot("umbral") != "jewelry" { panic("c_d4_codex_unlock FAIL [slot umbral] expected=jewelry got=" + aspect_slot("umbral")) }
    if aspect_slot("blood_drinker") != "jewelry" { panic("c_d4_codex_unlock FAIL [slot blood] expected=jewelry got=" + aspect_slot("blood_drinker")) }

    // 1 char + 5 aspect 해금
    record_unlock("Mira", "edgemaster", "Sirocco_Caverns", 1700000000)
    record_unlock("Mira", "umbral", "Iron_Hold", 1700000100)
    record_unlock("Mira", "aspect_of_might", "Hoarfrost_Demise", 1700000200)
    record_unlock("Mira", "shockwave", "Earthen_Wound", 1700000300)
    record_unlock("Mira", "blood_drinker", "Sunken_Library", 1700000400)

    let cnt = unlock_count("Mira")
    if cnt != 5 { panic("c_d4_codex_unlock FAIL [count] expected=5 got=" + to_string(cnt)) }

    if !has_aspect("Mira", "edgemaster") { panic("c_d4_codex_unlock FAIL [has edgemaster] expected=true got=false") }
    if has_aspect("Mira", "echoing_fury") { panic("c_d4_codex_unlock FAIL [has echoing] expected=false got=true") }

    // idempotent — 같은 char+aspect 재해금 (다른 dungeon/ts) → 덮어쓰기, count 유지
    record_unlock("Mira", "edgemaster", "Domhainne_Tunnels", 1700000500)
    let cnt2 = unlock_count("Mira")
    if cnt2 != 5 { panic("c_d4_codex_unlock FAIL [idempotent] expected=5 got=" + to_string(cnt2)) }

    if !has_aspect("Mira", "edgemaster") { panic("c_d4_codex_unlock FAIL [has after re] expected=true got=false") }

    r0_emit("d4_codex_summary", "\"char\":\"Mira\",\"unlocked\":" + to_string(cnt2) + ",\"total\":" + to_string(len(asp)))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 7 { panic("c_d4_codex_unlock FAIL [emit] expected>=7 got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AJ) ───
    //
    // Track AJ mission: extend Track V D4 retired_intentional posture annotation to 6
    // additional c_d4_* modules. .roadmap.diablo4 blk.1 status_enum_adopted =
    // retired_intentional (Track A2 land 2026-05-03). 본 module 측 codex of power
    // legendary aspect unlock tracker (char × aspect × dungeon × ts) = synthetic
    // codex progression analyzer — production live game state 측정 X (D4 always-
    // online live session 진입 X, DRM bypass 0, Battle.net launcher 통과 X). 본
    // cycle 측 module self_test() 측 honest annotation row 추가 only — cond.3
    // status `partial` 영구 유지 (retired_intentional posture per blk.1 영구
    // lock).
    //
    // synthetic posture row column header:
    //     domain                "codex_unlock"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_codex_unlock_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"codex_unlock\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_CODEX__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dcdx()

    println("  ✅ c_d4_codex_unlock self_test PASS (8 aspects, 3 slots, 5 unlocked + idempotent re-unlock, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "unlock" && len(a) >= 7 {
            record_unlock(a[3], a[4], a[5], to_int(a[6]))
            println("unlocked")
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("char=" + a[3] + " unlocked=" + to_string(unlock_count(a[3])) + "/" + to_string(len(aspects())))
            return
        }
        if sub == "cleanup" { cleanup_dcdx(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_codex_unlock.hexa { self-test | unlock <char> <aspect> <dungeon> <ts> | stats <char> | cleanup }")
}
