// lib/perf/c_metal_res_opt_sampler.hexa — CN-150 skeleton manjeom 15/15
//
// Metal sampler resource optimization 추적 — argument buffer sampler dedup.
// D4 material system 이 같은 (filter, address, LOD bias) sampler 를 material
// 마다 별도 MTLSamplerState 로 생성하면, 동일 spec sampler 가 material 수만큼
// 중복된다. argument buffer 안에서 dedup 으로 1 개만 유지하면 sampler
// descriptor footprint 절감 + cache locality 향상이 가능하다. 본 모듈은 sampler
// set 단위 (set_id × dedup_count × footprint_save_bytes × bind_save_count) 의
// 집계만 담당 — 실제 dedup 은 host (material/argument buffer) 측 책임.
//
// 무기: sampler_set × dedup_count × footprint_save_bytes × bind_save_count
//   4-key columnar log + sum/avg.
// 효과: D4 material/texture binding 단계의 sampler 중복 제거 정량화 →
//   descriptor heap pressure 완화.

use "./r0_common"

let MROS_DIR = GAMEBOX_HOME + "/persist/metal_res_opt_sampler"
let SET_LOG = MROS_DIR + "/sets.tsv"

fn mros_dir() -> str { return MROS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + MROS_DIR + "'")
}

// ─── sampler set 등록 ───
//   set_id (D4 material albedo / normal / PBR 등 logical sampler set 의 hash),
//   dedup_count (이 set 안에서 dedup 으로 제거된 중복 sampler 수),
//   footprint_save_bytes (제거된 sampler 들이 차지했을 descriptor bytes 합),
//   bind_save_count (binding 시점에 절약된 bind 호출 수 — host 측 측정).
fn record_set(set_id: int, dedup_count: int, footprint_save_bytes: int, bind_save_count: int) -> void {
    ensure_dir()
    let line = to_string(set_id) + "\t" + to_string(dedup_count) + "\t" + to_string(footprint_save_bytes) + "\t" + to_string(bind_save_count)
    let tmp = SET_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SET_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("metal_sampler_record", "\"set\":" + to_string(set_id) + ",\"dedup\":" + to_string(dedup_count) + ",\"footprint_save\":" + to_string(footprint_save_bytes) + ",\"bind_save\":" + to_string(bind_save_count))
}

// ─── set_count — 등록된 sampler set 행 수 ───
fn set_count() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SET_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_dedup — 모든 set dedup_count 합 ───
fn total_dedup() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_footprint_save_bytes — 모든 set footprint_save 합 (bytes) ───
fn total_footprint_save_bytes() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_bind_save — 모든 set bind_save_count 합 ───
fn total_bind_save() -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_footprint_per_dedup — total footprint_save / total dedup_count ───
//   각 dedup 된 sampler 1 개당 평균 byte 절감 (= sampler descriptor 1 개 크기 추정).
//   dedup 0 이면 0 반환 (divide-by-zero guard).
fn avg_footprint_per_dedup() -> int {
    let td = total_dedup()
    if td == 0 { return 0 }
    let tf = total_footprint_save_bytes()
    return tf / td
}

// ─── set_save_bytes — 특정 set_id 의 footprint_save_bytes ───
//   set_id 미등록이면 0.
fn set_save_bytes(set_id: int) -> int {
    let exists = exec("test -f '" + SET_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(set_id) + " '$1==a {s+=$3} END{print s+0}' '" + SET_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── mros_stats — [set_count, total_dedup, total_footprint_save_bytes, total_bind_save] ───
fn mros_stats() -> array {
    return [set_count(), total_dedup(), total_footprint_save_bytes(), total_bind_save()]
}

fn cleanup_mros() -> void {
    let _ = exec("rm -rf '" + MROS_DIR + "'")
}

fn self_test() -> void {
    let sid = "mros-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_mros()

    // 합성 sampler set 3 종:
    //   D4 material albedo  sampler set (id=7001) — dedup 24 / save 3072 B / bind 240
    //   D4 material normal  sampler set (id=7002) — dedup 18 / save 2304 B / bind 180
    //   D4 material PBR     sampler set (id=7003) — dedup 12 / save 1536 B / bind 120
    record_set(7001, 24, 3072, 240)
    record_set(7002, 18, 2304, 180)
    record_set(7003, 12, 1536, 120)

    // set_count = 3
    let sc = set_count()
    if sc != 3 { panic("c_metal_res_opt_sampler FAIL [set_count] expected=3 got=" + to_string(sc)) }

    // total_dedup = 24+18+12 = 54
    let td = total_dedup()
    if td != 54 { panic("c_metal_res_opt_sampler FAIL [total_dedup] expected=54 got=" + to_string(td)) }

    // total_footprint_save_bytes = 3072+2304+1536 = 6912
    let tf = total_footprint_save_bytes()
    if tf != 6912 { panic("c_metal_res_opt_sampler FAIL [total_footprint_save_bytes] expected=6912 got=" + to_string(tf)) }

    // total_bind_save = 240+180+120 = 540
    let tb = total_bind_save()
    if tb != 540 { panic("c_metal_res_opt_sampler FAIL [total_bind_save] expected=540 got=" + to_string(tb)) }

    // avg_footprint_per_dedup = 6912 / 54 = 128 (int trunc) — 각 sampler 가 128 B
    let avg = avg_footprint_per_dedup()
    if avg != 128 { panic("c_metal_res_opt_sampler FAIL [avg_footprint_per_dedup] expected=128 got=" + to_string(avg)) }

    // set_save_bytes 개별:
    let b1 = set_save_bytes(7001)
    if b1 != 3072 { panic("c_metal_res_opt_sampler FAIL [set_save_bytes 7001] expected=3072 got=" + to_string(b1)) }
    let b2 = set_save_bytes(7002)
    if b2 != 2304 { panic("c_metal_res_opt_sampler FAIL [set_save_bytes 7002] expected=2304 got=" + to_string(b2)) }
    let b3 = set_save_bytes(7003)
    if b3 != 1536 { panic("c_metal_res_opt_sampler FAIL [set_save_bytes 7003] expected=1536 got=" + to_string(b3)) }
    // 미등록 set_id 는 0
    let b4 = set_save_bytes(9999)
    if b4 != 0 { panic("c_metal_res_opt_sampler FAIL [set_save_bytes unknown] expected=0 got=" + to_string(b4)) }

    let stats = mros_stats()
    if stats[0] != 3 { panic("c_metal_res_opt_sampler FAIL [stats sets] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 54 { panic("c_metal_res_opt_sampler FAIL [stats dedup] expected=54 got=" + to_string(stats[1])) }
    if stats[2] != 6912 { panic("c_metal_res_opt_sampler FAIL [stats footprint_save] expected=6912 got=" + to_string(stats[2])) }
    if stats[3] != 540 { panic("c_metal_res_opt_sampler FAIL [stats bind_save] expected=540 got=" + to_string(stats[3])) }

    r0_emit("metal_sampler_summary", "\"sets\":" + to_string(stats[0]) + ",\"dedup\":" + to_string(stats[1]) + ",\"footprint_save\":" + to_string(stats[2]) + ",\"bind_save\":" + to_string(stats[3]) + ",\"avg_per_dedup\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_metal_res_opt_sampler FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic MTLSamplerState dedup state machine round-trip (cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BB mission: D2R/D4 cond.3 (Apple Metal layer) evidence augment to
    // complete c_metal_* family 11/11. cond.3 status `partial` 영구 유지 —
    // D3DMetal binary licence transitive (loader_dx blk.1) permanent external
    // gate, met 승격 X. Apple-native scaffold only.
    //
    // (a) synthetic MTLSamplerState dedup 4-phase state machine —
    //     descriptor_canonicalize → hash_lookup → dedup_merge → bind_save_count:
    //     phase_count               4                   (canon/lookup/merge/bind)
    //     sampler_obj_off           0x180020000         (synthetic SamplerState RVA)
    //     dedup_kind                "synthetic_inline"  (실 MTLSamplerState.makeSampler X)
    //
    // (b) synthetic filter × address × LOD 18-slot canonical matrix —
    //     3 filter × 3 address × 2 LOD_bias = 18 slot walk:
    //     slot_total                18                  (3 filter × 3 address × 2 LOD)
    //     dispatched_slot_count     7                   (D4 material albedo+normal+PBR)
    //     matrix_kind               "synthetic_inline"  (실 sampler descriptor X)
    //
    // round-trip = synthesize_dedup_phase(scaffold) → walk_canonical_matrix(scaffold).
    //              hexa-native loop only — 실 MTLSamplerState 0,
    //              real argument buffer write 0.
    //
    // synthetic dedup phase emit
    r0_emit("c_metal_res_opt_sampler_synthetic_phase",
        "\"stage\":\"dedup_phase\",\"phase_count\":4,\"sampler_obj_off\":\"0x180020000\",\"dedup_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__METAL_SAMPLER__ PARTIAL dedup_phase")

    // synthetic filter × address × LOD canonical matrix emit
    r0_emit("c_metal_res_opt_sampler_synthetic_matrix",
        "\"stage\":\"canonical_matrix\",\"slot_total\":18,\"dispatched_slot_count\":7,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__METAL_SAMPLER__ PARTIAL canonical_matrix")

    cleanup_mros()

    println("  ✅ c_metal_res_opt_sampler self_test PASS (3 sets, 54 dedup, 6912 B saved, 540 binds, avg=128 B/dedup, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = mros_stats()
            println("sets=" + to_string(s[0]) + " dedup=" + to_string(s[1]) + " footprint_save_bytes=" + to_string(s[2]) + " bind_save=" + to_string(s[3]))
            return
        }
        if sub == "save" {
            if len(a) >= 4 {
                let sid = to_int(a[3])
                let bytes = set_save_bytes(sid)
                println(to_string(bytes))
                return
            }
        }
        if sub == "cleanup" { cleanup_mros(); println("cleaned"); return }
    }
    println("usage: hexa run c_metal_res_opt_sampler.hexa { self-test | stats | save <set_id> | cleanup }")
}
