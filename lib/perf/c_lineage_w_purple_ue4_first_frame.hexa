// lib/perf/c_lineage_w_purple_ue4_first_frame.hexa — CN-156 skeleton manjeom 15/15
//
// 리니지 W (UE4 cross-platform mobile build) first frame trace via PURPLE — 리니지 W
// (2021 NCSOFT) 는 UE4 single global build 으로 mobile + PC PURPLE 모두 동일한
// 바이너리를 공유한다. PURPLE 으로 PC 실행 시 UE4 init → DX11 device + render
// target warm → asset (.pak) load → first draw 의 cold-launch 경로를 거치며,
// mobile-first 빌드라 Apple Silicon native 가 아닌 UE4 mobile renderer (DX11 ES
// profile) 를 사용한다. closure path B 의 Layer 0 (PURPLE) + Layer 1 (UE4 mobile
// build) 각 phase 의 정량화를 담당.
//
// 무기: frame × ue4_init × dx11_warm × asset_load 4-key columnar log + sum/avg.
// 효과: L W cold-launch latency 분해 정량화 → UE4 mobile renderer 의 bottleneck
// (DX11 vs asset) 식별, 다른 UE4 cross-platform 게임 (Aion 2 PURPLE 출시 예정)
// 재사용.

use "./r0_common"

let LWPUFF_DIR = GAMEBOX_HOME + "/persist/lineage_w_purple_ue4_first_frame"
let FRAME_LOG = LWPUFF_DIR + "/frames.tsv"

fn lwpuff_dir() -> str { return LWPUFF_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + LWPUFF_DIR + "'")
}

// ─── frame 등록 ───
//   frame_id (cold/warm/hot 등 logical frame number),
//   ue4_init_us (UE4 engine init μs),
//   dx11_warm_us (DX11 device + render target warm μs),
//   asset_load_us (.pak asset load μs).
fn record_frame(frame_id: int, ue4_init_us: int, dx11_warm_us: int, asset_load_us: int) -> void {
    ensure_dir()
    let line = to_string(frame_id) + "\t" + to_string(ue4_init_us) + "\t" + to_string(dx11_warm_us) + "\t" + to_string(asset_load_us)
    let tmp = FRAME_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + FRAME_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("lwpuff_record", "\"frame\":" + to_string(frame_id) + ",\"ue4_init_us\":" + to_string(ue4_init_us) + ",\"dx11_warm_us\":" + to_string(dx11_warm_us) + ",\"asset_load_us\":" + to_string(asset_load_us))
}

// ─── frame_count — 등록된 frame 행 수 ───
fn frame_count() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + FRAME_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_ue4_init_us — 모든 frame 의 ue4_init_us 합 ───
fn total_ue4_init_us() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_dx11_warm_us — 모든 frame 의 dx11_warm_us 합 ───
fn total_dx11_warm_us() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_asset_load_us — 모든 frame 의 asset_load_us 합 ───
fn total_asset_load_us() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_total_us_per_frame — (ue4_init + dx11_warm + asset_load) total / count ───
//   frame 0 이면 0 반환 (divide-by-zero guard).
fn avg_total_us_per_frame() -> int {
    let fc = frame_count()
    if fc == 0 { return 0 }
    let grand = total_ue4_init_us() + total_dx11_warm_us() + total_asset_load_us()
    return grand / fc
}

// ─── frame_total_us — 그 frame 의 3 stage 합 ───
//   frame_id 미등록이면 0.
fn frame_total_us(frame_id: int) -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v f=" + to_string(frame_id) + " '$1==f {s+=$2+$3+$4} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── lwpuff_stats — [frame_count, total_ue4_init_us, total_dx11_warm_us, total_asset_load_us] ───
fn lwpuff_stats() -> array {
    return [frame_count(), total_ue4_init_us(), total_dx11_warm_us(), total_asset_load_us()]
}

fn cleanup_lwpuff() -> void {
    let _ = exec("rm -rf '" + LWPUFF_DIR + "'")
}

fn self_test() -> void {
    let sid = "lwpuff-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_lwpuff()

    // 합성 데이터 3 frames:
    //   frame 10001 (cold, 첫 launch)        : ue4_init 820000, dx11_warm 380000, asset_load 480000
    //   frame 10002 (warm, PSO cache hit)     : ue4_init 240000, dx11_warm 120000, asset_load 160000
    //   frame 10003 (hot, 동일 zone)          : ue4_init  80000, dx11_warm  40000, asset_load  60000
    record_frame(10001, 820000, 380000, 480000)
    record_frame(10002, 240000, 120000, 160000)
    record_frame(10003, 80000, 40000, 60000)

    // frame_count = 3
    let fc = frame_count()
    if fc != 3 { panic("c_lineage_w_purple_ue4_first_frame FAIL [frame_count] expected=3 got=" + to_string(fc)) }

    // total_ue4_init_us = 820000+240000+80000 = 1140000
    let tu = total_ue4_init_us()
    if tu != 1140000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [total_ue4_init_us] expected=1140000 got=" + to_string(tu)) }

    // total_dx11_warm_us = 380000+120000+40000 = 540000
    let td = total_dx11_warm_us()
    if td != 540000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [total_dx11_warm_us] expected=540000 got=" + to_string(td)) }

    // total_asset_load_us = 480000+160000+60000 = 700000
    let ta = total_asset_load_us()
    if ta != 700000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [total_asset_load_us] expected=700000 got=" + to_string(ta)) }

    // avg_total_us_per_frame = (1140000+540000+700000)/3 = 2380000/3 = 793333 (int trunc)
    let avg = avg_total_us_per_frame()
    if avg != 793333 { panic("c_lineage_w_purple_ue4_first_frame FAIL [avg_total_us_per_frame] expected=793333 got=" + to_string(avg)) }

    // frame_total_us:
    //   10001 = 820000+380000+480000 = 1680000
    //   10002 = 240000+120000+160000 =  520000
    //   10003 =  80000+ 40000+ 60000 =  180000
    //   9999  미등록 = 0
    let f1 = frame_total_us(10001)
    if f1 != 1680000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [frame_total 10001] expected=1680000 got=" + to_string(f1)) }
    let f2 = frame_total_us(10002)
    if f2 != 520000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [frame_total 10002] expected=520000 got=" + to_string(f2)) }
    let f3 = frame_total_us(10003)
    if f3 != 180000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [frame_total 10003] expected=180000 got=" + to_string(f3)) }
    let f4 = frame_total_us(9999)
    if f4 != 0 { panic("c_lineage_w_purple_ue4_first_frame FAIL [frame_total unknown] expected=0 got=" + to_string(f4)) }

    let stats = lwpuff_stats()
    if stats[0] != 3 { panic("c_lineage_w_purple_ue4_first_frame FAIL [stats frames] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 1140000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [stats ue4_init] expected=1140000 got=" + to_string(stats[1])) }
    if stats[2] != 540000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [stats dx11_warm] expected=540000 got=" + to_string(stats[2])) }
    if stats[3] != 700000 { panic("c_lineage_w_purple_ue4_first_frame FAIL [stats asset_load] expected=700000 got=" + to_string(stats[3])) }

    let grand = stats[1] + stats[2] + stats[3]
    r0_emit("lwpuff_summary", "\"frames\":" + to_string(stats[0]) + ",\"ue4_init_us\":" + to_string(stats[1]) + ",\"dx11_warm_us\":" + to_string(stats[2]) + ",\"asset_load_us\":" + to_string(stats[3]) + ",\"grand_total_us\":" + to_string(grand) + ",\"avg_us\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_lineage_w_purple_ue4_first_frame FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    cleanup_lwpuff()

    println("  ✅ c_lineage_w_purple_ue4_first_frame self_test PASS (3 frames, ue4_init=1140000 us, dx11_warm=540000 us, asset_load=700000 us, avg=793333 us, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = lwpuff_stats()
            println("frames=" + to_string(s[0]) + " ue4_init_us=" + to_string(s[1]) + " dx11_warm_us=" + to_string(s[2]) + " asset_load_us=" + to_string(s[3]))
            return
        }
        if sub == "total" {
            if len(a) >= 4 {
                let fid = to_int(a[3])
                let us = frame_total_us(fid)
                println(to_string(us))
                return
            }
        }
        if sub == "cleanup" { cleanup_lwpuff(); println("cleaned"); return }
    }
    println("usage: hexa run c_lineage_w_purple_ue4_first_frame.hexa { self-test | stats | total <frame_id> | cleanup }")
}
