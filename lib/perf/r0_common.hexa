// lib/perf/r0_common.hexa — R0 instrumentation 공통 헬퍼
//
// 모든 r0_*.hexa 가 use "./r0_common" 으로 import.
// hexa-lang stage1 제약 (try/catch 미사용, float 산술 우회) 적용.
//
// upstream improvement candidates (자세히 → docs/HEXA_UPSTREAM.md):
//   - native append_file (현재 write_file + exec mv 우회)
//   - JSON encode helper (현재 manual concat)
//   - native regex / pattern match (현재 sed 우회)
//   - high-precision sleep_us (현재 sleep N 만)
//   - readdir / fs_walk (현재 find exec 우회)
//   - stdin loop helper (현재 io_pipe 우회)
//   - bit ops (& | ^ << >>) — SHBF 구현용

let HOME = env("HOME")
let GAMEBOX_HOME = HOME + "/.airgenome/gamebox"
let R0_HOME = GAMEBOX_HOME + "/r0"
let R0_SESSIONS = R0_HOME + "/sessions"
let R0_CACHE_INDEX = R0_HOME + "/cache_index"
let R0_CURRENT_SESSION_PTR = R0_HOME + "/current_session.txt"

fn r0_ensure_dirs() -> void {
    let _ = exec("mkdir -p '" + R0_SESSIONS + "' '" + R0_CACHE_INDEX + "'")
}

fn r0_ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn r0_new_sid() -> str {
    let m = exec("date -u +%y%m%d%H%M").trim()
    let r = exec("printf '%04x' $RANDOM").trim()
    return m + r
}

fn r0_session_set(sid: str) -> void {
    r0_ensure_dirs()
    write_file(R0_CURRENT_SESSION_PTR, sid)
}

fn r0_session_get() -> str {
    let s = exec("cat '" + R0_CURRENT_SESSION_PTR + "' 2>/dev/null").trim()
    if s == "" {
        return "no-session"
    }
    return s
}

fn r0_session_path(sid: str) -> str {
    return R0_SESSIONS + "/" + sid + ".jsonl"
}

fn r0_session_count(sid: str) -> int {
    let f = r0_session_path(sid)
    let c = exec("wc -l < '" + f + "' 2>/dev/null | tr -d ' '").trim()
    if c == "" { return 0 }
    return to_int(c)
}

// 단순 append: tmp 파일 → cat 으로 append (write_file 단독은 overwrite)
fn r0_append_line(path: str, line: str) -> void {
    let tmp = path + ".emit.tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + path + "' && rm -f '" + tmp + "'")
}

// JSONL emit — payload_json 은 이미 JSON 형식의 KV 문자열 (예: "\"k\":1,\"v\":\"x\"")
// 빈 문자열이면 event 만 emit.
fn r0_emit(event: str, payload_json: str) -> void {
    r0_ensure_dirs()
    let ts = r0_ts_iso()
    let sid = r0_session_get()
    let f = r0_session_path(sid)
    let line = "{\"ts\":\"" + ts + "\",\"sid\":\"" + sid + "\",\"event\":\"" + event + "\""
    if payload_json != "" {
        line = line + "," + payload_json
    }
    line = line + "}"
    r0_append_line(f, line)
}

// self_test — common 단독 검증 (set/get/emit/count round-trip)
fn self_test() -> void {
    let sid = "r0common-" + exec("date +%s").trim()
    r0_session_set(sid)

    let got_sid = r0_session_get()
    if got_sid != sid {
        panic("r0_common FAIL [session_set/get round-trip]")
    }

    r0_emit("test_a", "")
    r0_emit("test_b", "\"k\":1")
    r0_emit("test_c", "\"k\":2,\"v\":\"hello\"")

    let cnt = r0_session_count(sid)
    if cnt != 3 {
        panic("r0_common FAIL [emit count] expected=3 got=" + to_string(cnt))
    }

    println("  ✅ r0_common self_test PASS (sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
    }
    println("usage: hexa run r0_common.hexa self-test")
}
