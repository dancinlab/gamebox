// lib/perf/c_wgc_pe64_loader_probe.hexa — CN-165 skeleton manjeom 14/15 (B=4)
//
// WGC (Wargaming Game Center) PE32+ x86_64 loader 식별 — WGC 의 핵심 binary
// `wgc.exe` + `wgc_renderer_host.exe` + `WargamingErrorMonitor.exe` 가 PE32+
// x86_64 이며, closure path B (install/launch 단계) 적용 시 D4 PE64 loader 의
// ~80% 재사용이 가능하다 (단 Electron/Chromium dependency 추가 필요). 본
// 모듈은 PE 단위 (pe_id × section_count × import_count × size_kb) 의 집계만
// 담당 — 실제 PE parse/load 는 host 측 책임. 만점 14/15 (B=4 — runtime
// gameplay 외 install/launch 단계 한정).
//
// 무기: pe × section × import × size 4-key 컬럼 로그 + sum/avg.
// 효과: WGC PE 분포 정량화 → D4 PE64 재사용률 측정 baseline.

use "./r0_common"

let WPEP_DIR = GAMEBOX_HOME + "/persist/wgc_pe64_loader_probe"
let PE_LOG = WPEP_DIR + "/pes.tsv"

fn wpep_dir() -> str { return WPEP_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + WPEP_DIR + "'")
}

// ─── PE 등록 ───
//   pe_id (wgc.exe / wgc_renderer_host.exe / WargamingErrorMonitor.exe 등 logical name 의 hash),
//   section_count (PE 의 section 수 — text/data/rdata/rsrc 등),
//   import_count (PE 의 import 수 — IAT 엔트리 수),
//   size_kb (PE 파일 크기 KB).
fn record_pe(pe_id: int, section_count: int, import_count: int, size_kb: int) -> void {
    ensure_dir()
    let line = to_string(pe_id) + "\t" + to_string(section_count) + "\t" + to_string(import_count) + "\t" + to_string(size_kb)
    let tmp = PE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("wgc_pe64_record", "\"pe\":" + to_string(pe_id) + ",\"sections\":" + to_string(section_count) + ",\"imports\":" + to_string(import_count) + ",\"size_kb\":" + to_string(size_kb))
}

// ─── pe_count — 등록된 PE 행 수 ───
fn pe_count() -> int {
    let exists = exec("test -f '" + PE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + PE_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_sections — 모든 PE section_count 합 ───
fn total_sections() -> int {
    let exists = exec("test -f '" + PE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + PE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_imports — 모든 PE import_count 합 ───
fn total_imports() -> int {
    let exists = exec("test -f '" + PE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + PE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_size_kb — 모든 PE size_kb 합 (KB) ───
fn total_size_kb() -> int {
    let exists = exec("test -f '" + PE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + PE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_size_kb_per_pe — total_size_kb / pe_count ───
//   pe_count 0 이면 0 반환 (divide-by-zero guard).
fn avg_size_kb_per_pe() -> int {
    let pc = pe_count()
    if pc == 0 { return 0 }
    let ts = total_size_kb()
    return ts / pc
}

// ─── pe_size_kb — 그 PE 의 size_kb (없으면 0) ───
fn pe_size_kb(pe_id: int) -> int {
    let exists = exec("test -f '" + PE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v p=" + to_string(pe_id) + " '$1==p {s+=$4} END{print s+0}' '" + PE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── wpep_stats — [pe_count, total_sections, total_imports, total_size_kb] ───
fn wpep_stats() -> array {
    return [pe_count(), total_sections(), total_imports(), total_size_kb()]
}

fn cleanup_wpep() -> void {
    let _ = exec("rm -rf '" + WPEP_DIR + "'")
}

fn self_test() -> void {
    let sid = "wpep-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_wpep()

    // 합성 PE 3 종 (WGC 핵심 binary):
    //   wgc.exe (id=19001)                     — section=8,  imports=240, size=4800 KB
    //   wgc_renderer_host.exe (id=19002)        — section=12, imports=480, size=8200 KB (Chromium)
    //   WargamingErrorMonitor.exe (id=19003)    — section=6,  imports=120, size=1600 KB
    record_pe(19001, 8, 240, 4800)
    record_pe(19002, 12, 480, 8200)
    record_pe(19003, 6, 120, 1600)

    // pe_count = 3
    let pc = pe_count()
    if pc != 3 { panic("c_wgc_pe64_loader_probe FAIL [pe_count] expected=3 got=" + to_string(pc)) }

    // total_sections = 8+12+6 = 26
    let ts = total_sections()
    if ts != 26 { panic("c_wgc_pe64_loader_probe FAIL [total_sections] expected=26 got=" + to_string(ts)) }

    // total_imports = 240+480+120 = 840
    let ti = total_imports()
    if ti != 840 { panic("c_wgc_pe64_loader_probe FAIL [total_imports] expected=840 got=" + to_string(ti)) }

    // total_size_kb = 4800+8200+1600 = 14600
    let tsk = total_size_kb()
    if tsk != 14600 { panic("c_wgc_pe64_loader_probe FAIL [total_size_kb] expected=14600 got=" + to_string(tsk)) }

    // avg_size_kb_per_pe = 14600 / 3 = 4866 (int trunc)
    let avg = avg_size_kb_per_pe()
    if avg != 4866 { panic("c_wgc_pe64_loader_probe FAIL [avg_size_kb] expected=4866 got=" + to_string(avg)) }

    // pe_size_kb 개별 검증
    let p1 = pe_size_kb(19001)
    if p1 != 4800 { panic("c_wgc_pe64_loader_probe FAIL [pe_size 19001] expected=4800 got=" + to_string(p1)) }
    let p2 = pe_size_kb(19002)
    if p2 != 8200 { panic("c_wgc_pe64_loader_probe FAIL [pe_size 19002] expected=8200 got=" + to_string(p2)) }
    let p3 = pe_size_kb(19003)
    if p3 != 1600 { panic("c_wgc_pe64_loader_probe FAIL [pe_size 19003] expected=1600 got=" + to_string(p3)) }
    // 미등록 pe_id 는 0
    let p4 = pe_size_kb(9999)
    if p4 != 0 { panic("c_wgc_pe64_loader_probe FAIL [pe_size unknown] expected=0 got=" + to_string(p4)) }

    let stats = wpep_stats()
    if stats[0] != 3 { panic("c_wgc_pe64_loader_probe FAIL [stats pe_count] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 26 { panic("c_wgc_pe64_loader_probe FAIL [stats sections] expected=26 got=" + to_string(stats[1])) }
    if stats[2] != 840 { panic("c_wgc_pe64_loader_probe FAIL [stats imports] expected=840 got=" + to_string(stats[2])) }
    if stats[3] != 14600 { panic("c_wgc_pe64_loader_probe FAIL [stats size_kb] expected=14600 got=" + to_string(stats[3])) }

    r0_emit("wgc_pe64_summary", "\"pes\":" + to_string(stats[0]) + ",\"sections\":" + to_string(stats[1]) + ",\"imports\":" + to_string(stats[2]) + ",\"size_kb\":" + to_string(stats[3]) + ",\"avg_kb\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_wgc_pe64_loader_probe FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic WGC PE64 loader probe round-trip (Track BJ — battlenet cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BJ mission: c_wg/c_wgc_* family completion cycle (6/6) — c_wgc_pe64_loader_probe
    // 측 WGC PE32+ x64 binary metadata synthetic round-trip. PE64 probe
    // lifecycle (probe_dos → walk_nt → enumerate_sections → resolve_iat) 측 spec freeze.
    // Production smoke gated on user network smoke (battlenet blk.1 transitive)
    // + 자연 환경 정합 long-horizon work, met 승격 X. WGC binary cross-link battlenet
    // launcher network stack evidence.
    //
    // (a) synthetic 4-phase PE64 loader probe pipeline —
    //     probe_dos_stub → walk_nt_header → enumerate_section_table → resolve_iat_thunks:
    //     phase_count               4
    //     pe64_probe_off            0x140150000         (synthetic WGC PE64 probe RVA)
    //     pipeline_kind             "synthetic_inline"  (실 PE LoadLibrary 호출 X)
    //
    // (b) synthetic image_class × section_class 16-slot probe matrix —
    //     4 image_class (small/med/large/xl) × 4 section_class (.text/.data/.rdata/.rsrc) = 16 slots:
    //     slot_total                16
    //     code_slot_count           4                   (section_class = .text)
    //     data_slot_count           12                  (section_class ≠ .text)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_pe64_phase(scaffold) → walk_section_matrix(scaffold).
    //              hexa-native loop only — 실 PE NT_HEADERS read 0,
    //              real IAT thunk resolution 0.
    //
    // synthetic PE64 probe phase emit
    r0_emit("c_wgc_pe64_loader_probe_synthetic_phase",
        "\"stage\":\"pe64_probe_phase\",\"phase_count\":4,\"pe64_probe_off\":\"0x140150000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"network_gap\":\"production smoke gated on user network smoke + 자연 환경 정합 long-horizon\"")
    println("__WGC_PE64__ PARTIAL pe64_probe_phase")

    // synthetic image × section matrix emit
    r0_emit("c_wgc_pe64_loader_probe_synthetic_matrix",
        "\"stage\":\"section_matrix\",\"slot_total\":16,\"code_slot_count\":4,\"data_slot_count\":12,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"network_gap\":\"production smoke gated on user network smoke + 자연 환경 정합 long-horizon\"")
    println("__WGC_PE64__ PARTIAL section_matrix")

    cleanup_wpep()

    println("  ✅ c_wgc_pe64_loader_probe self_test PASS (3 PEs, 26 sections, 840 imports, 14600 KB, avg=4866 KB, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = wpep_stats()
            println("pes=" + to_string(s[0]) + " sections=" + to_string(s[1]) + " imports=" + to_string(s[2]) + " size_kb=" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let pid = to_int(a[3])
                let kb = pe_size_kb(pid)
                println(to_string(kb))
                return
            }
        }
        if sub == "cleanup" { cleanup_wpep(); println("cleaned"); return }
    }
    println("usage: hexa run c_wgc_pe64_loader_probe.hexa { self-test | stats | size <pe_id> | cleanup }")
}
