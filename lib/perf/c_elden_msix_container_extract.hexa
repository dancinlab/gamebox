// lib/perf/c_elden_msix_container_extract.hexa — CN-173 skeleton manjeom 15/15
//
// Elden Ring Microsoft Store UWP/MSIX container 추출 추적 — Steam 외 정식
// standalone path 신규 영역. Microsoft Store (Xbox PC) 버전은 UWP/MSIX 패키지
// (zip 식 컨테이너) 로 배포된다. closure path B 적용 시 MSIX container 압축
// 해제 → 내부 PE 추출, AppX manifest + asset bundle + license metadata 분리.
// 다른 Microsoft Store 게임 (Forza Horizon, Halo 등) generic 재사용 가능.
//
// 무기: container × file_count × extracted_size_mb × extract_us 4-key columnar log.
// 효과: MSIX UWP container 추출 정량화 — Steam 외 PC distribution path 자체 인프라.

use "./r0_common"

let EMCE_DIR = GAMEBOX_HOME + "/persist/elden_msix_container_extract"
let CONTAINER_LOG = EMCE_DIR + "/containers.tsv"

fn emce_dir() -> str { return EMCE_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + EMCE_DIR + "'")
}

// ─── container 등록 ───
//   container_id (msix package logical id),
//   file_count (container 안 file 수),
//   extracted_size_mb (압축 해제 후 합계 MB),
//   extract_us (압축 해제 누적 us — host 측 측정).
fn record_container(container_id: int, file_count: int, extracted_size_mb: int, extract_us: int) -> void {
    ensure_dir()
    let line = to_string(container_id) + "\t" + to_string(file_count) + "\t" + to_string(extracted_size_mb) + "\t" + to_string(extract_us)
    let tmp = CONTAINER_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CONTAINER_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("elden_msix_container_record", "\"container\":" + to_string(container_id) + ",\"files\":" + to_string(file_count) + ",\"size_mb\":" + to_string(extracted_size_mb) + ",\"extract_us\":" + to_string(extract_us))
}

// ─── container_count — 등록된 container 행 수 ───
fn container_count() -> int {
    let exists = exec("test -f '" + CONTAINER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + CONTAINER_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_files — 모든 container file_count 합 ───
fn total_files() -> int {
    let exists = exec("test -f '" + CONTAINER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + CONTAINER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_size_mb — 모든 container extracted_size_mb 합 (MB) ───
fn total_size_mb() -> int {
    let exists = exec("test -f '" + CONTAINER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + CONTAINER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_extract_us — 모든 container extract_us 합 ───
fn total_extract_us() -> int {
    let exists = exec("test -f '" + CONTAINER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + CONTAINER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_files_per_container — total_files / container_count ───
//   container 0 이면 0 반환 (divide-by-zero guard).
fn avg_files_per_container() -> int {
    let cc = container_count()
    if cc == 0 { return 0 }
    let tf = total_files()
    return tf / cc
}

// ─── container_size_mb — 특정 container_id 의 extracted_size_mb ───
//   container_id 미등록이면 0.
fn container_size_mb(container_id: int) -> int {
    let exists = exec("test -f '" + CONTAINER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v c=" + to_string(container_id) + " '$1==c {s+=$3} END{print s+0}' '" + CONTAINER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── emce_stats — [container_count, total_files, total_size_mb, total_extract_us] ───
fn emce_stats() -> array {
    return [container_count(), total_files(), total_size_mb(), total_extract_us()]
}

fn cleanup_emce() -> void {
    let _ = exec("rm -rf '" + EMCE_DIR + "'")
}

fn self_test() -> void {
    let sid = "emce-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_emce()

    // 합성 container 3 종:
    //   eldenring.msix base                — 4800 files / 58000 MB / 240000000 us
    //   eldenring_dlc_sote.msix             — 2400 files / 18000 MB /  80000000 us
    //   eldenring_appx_manifest.msix        —  120 files /     2 MB /    480000 us
    record_container(27001, 4800, 58000, 240000000)
    record_container(27002, 2400, 18000, 80000000)
    record_container(27003, 120, 2, 480000)

    // container_count = 3
    let cc = container_count()
    if cc != 3 { panic("c_elden_msix_container_extract FAIL [container_count] expected=3 got=" + to_string(cc)) }

    // total_files = 4800+2400+120 = 7320
    let tf = total_files()
    if tf != 7320 { panic("c_elden_msix_container_extract FAIL [total_files] expected=7320 got=" + to_string(tf)) }

    // total_size_mb = 58000+18000+2 = 76002
    let tm = total_size_mb()
    if tm != 76002 { panic("c_elden_msix_container_extract FAIL [total_size_mb] expected=76002 got=" + to_string(tm)) }

    // total_extract_us = 240000000+80000000+480000 = 320480000
    let tu = total_extract_us()
    if tu != 320480000 { panic("c_elden_msix_container_extract FAIL [total_extract_us] expected=320480000 got=" + to_string(tu)) }

    // avg_files_per_container = 7320 / 3 = 2440
    let avg = avg_files_per_container()
    if avg != 2440 { panic("c_elden_msix_container_extract FAIL [avg_files] expected=2440 got=" + to_string(avg)) }

    // container_size_mb 개별 조회
    let s1 = container_size_mb(27001)
    if s1 != 58000 { panic("c_elden_msix_container_extract FAIL [size 27001] expected=58000 got=" + to_string(s1)) }
    let s2 = container_size_mb(27002)
    if s2 != 18000 { panic("c_elden_msix_container_extract FAIL [size 27002] expected=18000 got=" + to_string(s2)) }
    let s3 = container_size_mb(27003)
    if s3 != 2 { panic("c_elden_msix_container_extract FAIL [size 27003] expected=2 got=" + to_string(s3)) }
    // 미등록 container_id 는 0
    let s4 = container_size_mb(9999)
    if s4 != 0 { panic("c_elden_msix_container_extract FAIL [size unknown] expected=0 got=" + to_string(s4)) }

    let stats = emce_stats()
    if stats[0] != 3 { panic("c_elden_msix_container_extract FAIL [stats containers] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 7320 { panic("c_elden_msix_container_extract FAIL [stats files] expected=7320 got=" + to_string(stats[1])) }
    if stats[2] != 76002 { panic("c_elden_msix_container_extract FAIL [stats size_mb] expected=76002 got=" + to_string(stats[2])) }
    if stats[3] != 320480000 { panic("c_elden_msix_container_extract FAIL [stats extract_us] expected=320480000 got=" + to_string(stats[3])) }

    r0_emit("elden_msix_container_summary", "\"containers\":" + to_string(stats[0]) + ",\"files\":" + to_string(stats[1]) + ",\"size_mb\":" + to_string(stats[2]) + ",\"extract_us\":" + to_string(stats[3]) + ",\"avg_files\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_elden_msix_container_extract FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic Elden Ring retired_intentional posture annotation (Track AS) ───
    //
    // Track AS mission: Elden Ring blk.1 retired_intentional posture annotation
    // (mirror D4 Track V/AJ/AL pattern, EAC anti-tamper class). .roadmap.elden_ring
    // blk.1 status_enum_adopted = retired_intentional (block-acknowledged =
    // PASS-equivalent posture, own1 Wine 0 + own2 honest emit, no AC bypass / no
    // anti-tamper bypass). 본 module 측 MS Store MSIX container extract 4-key
    // trace (container × files × size_mb × extract_us) = synthetic — distribution
    // path spec exist, real container round-trip 미land (license_mode=honest_stub,
    // no bypass). cond.3 status `partial` 영구 유지 (retired_intentional posture
    // per blk.1 영구 lock).
    // pattern reference:
    //     lib/perf/c_d4_dxr_first_frame_trace.hexa (Track AL predecessor, schema mirror)
    //
    // synthetic posture row column header:
    //     domain                "msix_container_extract"
    //     posture               "retired_intentional"
    //     production_smoke      "no_attempt"
    //     drm_bypass            "0"                    (own1 Wine 0)
    //     ac_bypass             "0"                    (own1 honest acknowledgment)
    //     anti_tamper_bypass    "0"                    (EAC anti-tamper boundary)
    //     blocker_ref           "elden_ring.blk.1"     (eac_anti_tamper)
    //     adoption_iso          "2026-05-03"           (Track C 4-game retired_intentional)
    r0_emit("c_elden_msix_container_extract_retired_intentional",
        "\"stage\":\"elden_ring_dist_synthetic\",\"domain\":\"msix_container_extract\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"ac_bypass\":0,\"anti_tamper_bypass\":0,\"blocker_ref\":\"elden_ring.blk.1\",\"blocker_class\":\"eac_anti_tamper\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"elden_ring.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__ELDEN_MSIX_CONTAINER__ RETIRED_INTENTIONAL elden_ring_dist_synthetic")

    cleanup_emce()

    println("  ✅ c_elden_msix_container_extract self_test PASS (3 containers, 7320 files, 76002 MB, 320480000 us, avg=2440 files/container, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = emce_stats()
            println("containers=" + to_string(s[0]) + " files=" + to_string(s[1]) + " size_mb=" + to_string(s[2]) + " extract_us=" + to_string(s[3]))
            return
        }
        if sub == "size" {
            if len(a) >= 4 {
                let cid = to_int(a[3])
                let mb = container_size_mb(cid)
                println(to_string(mb))
                return
            }
        }
        if sub == "cleanup" { cleanup_emce(); println("cleaned"); return }
    }
    println("usage: hexa run c_elden_msix_container_extract.hexa { self-test | stats | size <container_id> | cleanup }")
}
