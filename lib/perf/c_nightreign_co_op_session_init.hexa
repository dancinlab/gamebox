// lib/perf/c_nightreign_co_op_session_init.hexa — Track CM (Nightreign fan-out skeleton-tier).
//
// Elden Ring Nightreign 3-player co-op session lifecycle init 추적 — synthetic
// scaffold for FromSoft co-op session model. Apple Silicon kernel mismatch +
// FromSoft online matchmaking server transitive boundary → session_init phase
// 측 retired_intentional posture (inherited from elden_ring_nightreign blk.2
// FromSoft co-op matchmaking new sub-class, Track BY 2026-05-05).
//
// own1: Wine 0 / FromSoft matchmaking server bypass 0 / co-op session emul 0.
// own2: r0_emit ≥ 7 + RETIRED_INTENTIONAL posture explicit.
//
// session_phase code:
//   1 = init_request           (client → server session creation request)
//   2 = init_ack               (server → client session ack)
//   3 = player_join            (3-player slot fill, max 3)
//   4 = sync_baseline          (initial state sync to all 3 players)
//   5 = session_active         (gameplay loop entry)

use "./r0_common"

let CNRSI_DIR = GAMEBOX_HOME + "/persist/c_nightreign_co_op_session_init"
let SESSION_LOG = CNRSI_DIR + "/sessions.tsv"

fn ensure_dir() -> void {
    let _ = exec("mkdir -p '" + CNRSI_DIR + "'")
}

fn record_session(session_id: int, session_phase: int, player_count: int, elapsed_us: int) -> void {
    if session_phase < 1 || session_phase > 5 {
        panic("c_nightreign_co_op_session_init FAIL [record] expected=phase in [1,5] got=" + to_string(session_phase))
    }
    if player_count < 0 || player_count > 3 {
        panic("c_nightreign_co_op_session_init FAIL [record] expected=player_count in [0,3] got=" + to_string(player_count))
    }
    ensure_dir()
    let line = to_string(session_id) + "\t" + to_string(session_phase) + "\t" + to_string(player_count) + "\t" + to_string(elapsed_us)
    let tmp = SESSION_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SESSION_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("cnrsi_record", "\"session\":" + to_string(session_id) + ",\"phase\":" + to_string(session_phase) + ",\"players\":" + to_string(player_count) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

fn session_count() -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SESSION_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

fn count_by_phase(phase: int) -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v v=" + to_string(phase) + " '$2==v {c++} END{print c+0}' '" + SESSION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn max_player_count() -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' 'BEGIN{m=0} {if($3>m) m=$3} END{print m+0}' '" + SESSION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn cnrsi_stats() -> array {
    return [session_count(), count_by_phase(1), count_by_phase(5), max_player_count()]
}

fn cleanup_cnrsi() -> void {
    let _ = exec("rm -rf '" + CNRSI_DIR + "'")
}

fn self_test() -> void {
    let sid = "cnrsi-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cnrsi()

    // 합성 5-phase session lifecycle (synthetic, retired_intentional posture):
    //   session 47001 — phase 1 init_request, 0 players, 100us
    //   session 47001 — phase 2 init_ack, 1 player (host), 200us
    //   session 47001 — phase 3 player_join, 3 players, 5000us
    //   session 47001 — phase 4 sync_baseline, 3 players, 1500us
    //   session 47001 — phase 5 session_active, 3 players, 100us
    record_session(47001, 1, 0, 100)
    record_session(47001, 2, 1, 200)
    record_session(47001, 3, 3, 5000)
    record_session(47001, 4, 3, 1500)
    record_session(47001, 5, 3, 100)

    let sc = session_count()
    if sc != 5 { panic("c_nightreign_co_op_session_init FAIL [count] expected=5 got=" + to_string(sc)) }

    let p1 = count_by_phase(1)
    if p1 != 1 { panic("c_nightreign_co_op_session_init FAIL [phase 1] expected=1 got=" + to_string(p1)) }
    let p5 = count_by_phase(5)
    if p5 != 1 { panic("c_nightreign_co_op_session_init FAIL [phase 5] expected=1 got=" + to_string(p5)) }

    let mp = max_player_count()
    if mp != 3 { panic("c_nightreign_co_op_session_init FAIL [max_players] expected=3 got=" + to_string(mp)) }

    let stats = cnrsi_stats()
    r0_emit("cnrsi_summary", "\"sessions\":" + to_string(stats[0]) + ",\"init_requests\":" + to_string(stats[1]) + ",\"actives\":" + to_string(stats[2]) + ",\"max_players\":" + to_string(stats[3]))

    // ─── retired_intentional posture annotation (Track CM, blk.2 FromSoft co-op matchmaking) ───
    r0_emit("cnrsi_retired_intentional",
        "\"stage\":\"nightreign_co_op_session_synthetic\",\"domain\":\"co_op_session_init\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"matchmaking_bypass\":0,\"blocker_ref\":\"elden_ring_nightreign.blk.2\",\"blocker_class\":\"fromsoft_co_op_matchmaking\",\"adoption_iso\":\"2026-05-05\",\"adoption_track\":\"BY+CM\",\"verdict\":\"RETIRED_INTENTIONAL\"")
    println("__NIGHTREIGN_CO_OP_SESSION__ RETIRED_INTENTIONAL nightreign_co_op_session_synthetic")

    cleanup_cnrsi()

    let cnt = r0_session_count(sid)
    if cnt < 7 { panic("c_nightreign_co_op_session_init FAIL [emit count] expected>=7 got=" + to_string(cnt)) }

    println("  ✅ c_nightreign_co_op_session_init self_test PASS (5 sessions, max_players=3, sid=" + sid + ", emits=" + to_string(cnt) + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = cnrsi_stats()
            println("sessions=" + to_string(s[0]) + " init_req=" + to_string(s[1]) + " active=" + to_string(s[2]) + " max_players=" + to_string(s[3]))
            return
        }
        if sub == "cleanup" { cleanup_cnrsi(); println("cleaned"); return }
    }
    println("usage: hexa run c_nightreign_co_op_session_init.hexa { self-test | stats | cleanup }")
}
