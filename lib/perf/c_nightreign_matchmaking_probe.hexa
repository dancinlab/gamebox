// lib/perf/c_nightreign_matchmaking_probe.hexa — Track CM (Nightreign fan-out skeleton-tier).
//
// Elden Ring Nightreign FromSoft matchmaking server probe — honest detection
// of server availability + handshake state. Apple Silicon natural absence path
// (no FromSoft matchmaking emul, no server bypass). Wine 0 own1 정합.
//
// own1: Wine 0 / FromSoft matchmaking server bypass 0 / handshake spoof 0.
// own2: r0_emit ≥ 7 + RETIRED_INTENTIONAL posture explicit.
//
// probe_state code:
//   1 = dns_lookup            (matchmaking endpoint resolve)
//   2 = tcp_connect           (TLS handshake)
//   3 = handshake_request     (client → server greeting)
//   4 = handshake_response    (server → client; presence/absence detect)
//   5 = matchmaking_idle      (no session attempt — passive probe)

use "./r0_common"

let CNMP_DIR = GAMEBOX_HOME + "/persist/c_nightreign_matchmaking_probe"
let PROBE_LOG = CNMP_DIR + "/probes.tsv"

fn ensure_dir() -> void {
    let _ = exec("mkdir -p '" + CNMP_DIR + "'")
}

fn record_probe(probe_id: int, probe_state: int, server_responded: int, elapsed_us: int) -> void {
    if probe_state < 1 || probe_state > 5 {
        panic("c_nightreign_matchmaking_probe FAIL [record] expected=state in [1,5] got=" + to_string(probe_state))
    }
    if server_responded < 0 || server_responded > 1 {
        panic("c_nightreign_matchmaking_probe FAIL [record] expected=responded in {0,1} got=" + to_string(server_responded))
    }
    ensure_dir()
    let line = to_string(probe_id) + "\t" + to_string(probe_state) + "\t" + to_string(server_responded) + "\t" + to_string(elapsed_us)
    let tmp = PROBE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + PROBE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("cnmp_record", "\"probe\":" + to_string(probe_id) + ",\"state\":" + to_string(probe_state) + ",\"responded\":" + to_string(server_responded) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

fn probe_count() -> int {
    let exists = exec("test -f '" + PROBE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + PROBE_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

fn count_by_state(state: int) -> int {
    let exists = exec("test -f '" + PROBE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v v=" + to_string(state) + " '$2==v {c++} END{print c+0}' '" + PROBE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn count_responded() -> int {
    let exists = exec("test -f '" + PROBE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==1 {c++} END{print c+0}' '" + PROBE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn cnmp_stats() -> array {
    return [probe_count(), count_by_state(5), count_responded(), 0]
}

fn cleanup_cnmp() -> void {
    let _ = exec("rm -rf '" + CNMP_DIR + "'")
}

fn self_test() -> void {
    let sid = "cnmp-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cnmp()

    // 합성 5-state matchmaking probe (synthetic, retired_intentional — server natural absence on Apple stack):
    //   probe 51001 — dns_lookup, no response (Apple Silicon, no matchmaking emul), 5000us
    //   probe 51002 — tcp_connect, no response, 30000us
    //   probe 51003 — handshake_request, no response, 60000us
    //   probe 51004 — handshake_response, no response, 90000us
    //   probe 51005 — matchmaking_idle, no response, 100us (passive idle)
    record_probe(51001, 1, 0, 5000)
    record_probe(51002, 2, 0, 30000)
    record_probe(51003, 3, 0, 60000)
    record_probe(51004, 4, 0, 90000)
    record_probe(51005, 5, 0, 100)

    let pc = probe_count()
    if pc != 5 { panic("c_nightreign_matchmaking_probe FAIL [count] expected=5 got=" + to_string(pc)) }

    let s5 = count_by_state(5)
    if s5 != 1 { panic("c_nightreign_matchmaking_probe FAIL [state 5] expected=1 got=" + to_string(s5)) }

    let resp = count_responded()
    if resp != 0 { panic("c_nightreign_matchmaking_probe FAIL [responded] expected=0 (Apple Silicon natural absence) got=" + to_string(resp)) }

    let stats = cnmp_stats()
    r0_emit("cnmp_summary", "\"probes\":" + to_string(stats[0]) + ",\"idles\":" + to_string(stats[1]) + ",\"responded\":" + to_string(stats[2]))

    // ─── retired_intentional posture annotation (Track CM, blk.2 FromSoft co-op matchmaking + Apple natural absence) ───
    r0_emit("cnmp_retired_intentional",
        "\"stage\":\"nightreign_matchmaking_probe_synthetic\",\"domain\":\"matchmaking_probe\",\"posture\":\"retired_intentional_natural_absence\",\"production_smoke\":\"no_attempt\",\"matchmaking_bypass\":0,\"handshake_spoof\":0,\"blocker_ref\":\"elden_ring_nightreign.blk.2\",\"blocker_class\":\"fromsoft_co_op_matchmaking\",\"adoption_iso\":\"2026-05-05\",\"adoption_track\":\"BY+CM\",\"verdict\":\"RETIRED_INTENTIONAL\"")
    println("__NIGHTREIGN_MATCHMAKING__ RETIRED_INTENTIONAL nightreign_matchmaking_probe_synthetic")

    cleanup_cnmp()

    let cnt = r0_session_count(sid)
    if cnt < 7 { panic("c_nightreign_matchmaking_probe FAIL [emit count] expected>=7 got=" + to_string(cnt)) }

    println("  ✅ c_nightreign_matchmaking_probe self_test PASS (5 probes, responded=0 natural absence, sid=" + sid + ", emits=" + to_string(cnt) + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = cnmp_stats()
            println("probes=" + to_string(s[0]) + " idles=" + to_string(s[1]) + " responded=" + to_string(s[2]))
            return
        }
        if sub == "cleanup" { cleanup_cnmp(); println("cleaned"); return }
    }
    println("usage: hexa run c_nightreign_matchmaking_probe.hexa { self-test | stats | cleanup }")
}
