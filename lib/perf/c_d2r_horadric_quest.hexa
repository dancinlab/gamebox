// lib/perf/c_d2r_horadric_quest.hexa — CN-113 skeleton manjeom 15/15
//
// D2R Act 2 Horadric Quest tracker — Phase 5 gameplay loop.
// Cube + Staff/Amulet/Cube of Inifuss 진행 추적 (6 sub-step).
//
// 무기: 6 step table (act2 main quest line) + idempotent step row.
// 효과: char 의 Horadric Quest 진행률 (0~100%) 즉시 가시화.

use "./r0_common"

let DHQ_DIR = GAMEBOX_HOME + "/persist/d2r_horadric_quest"
let STEP_LOG = DHQ_DIR + "/steps.tsv"

fn dhq_dir() -> str { return DHQ_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DHQ_DIR + "'")
}

// ─── Horadric Quest 6 step (D2R Act 2) ───
// find_cube       — Halls of the Dead 의 Horadric Cube
// find_staff_top  — Far Oasis 의 Horadric Staff Top (Maggot Lair)
// find_staff_shaft— Lost City 의 Staff Shaft (Claw Viper Temple Amulet)
// combine_staff   — Cube 안에서 Top + Shaft → Horadric Staff
// kill_summoner   — Arcane Sanctuary 의 Summoner 처치 (Canyon of Magi 진입)
// kill_duriel     — Tomb of Tal Rasha 의 Duriel 처치 (act2 final)
fn horadric_steps() -> array {
    return ["find_cube", "find_staff_top", "find_staff_shaft", "combine_staff", "kill_summoner", "kill_duriel"]
}

fn step_act(step: str) -> str {
    if step == "find_cube" { return "act2" }
    if step == "find_staff_top" { return "act2" }
    if step == "find_staff_shaft" { return "act2" }
    if step == "combine_staff" { return "act2" }
    if step == "kill_summoner" { return "act2" }
    if step == "kill_duriel" { return "act2" }
    return ""
}

fn record_step(char_name: str, step: str) -> void {
    ensure_dir()
    let exists = exec("test -f '" + STEP_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v c='" + char_name + "' -v s='" + step + "' '!($1==c && $2==s)' '" + STEP_LOG + "' > '" + STEP_LOG + ".tmp' && mv '" + STEP_LOG + ".tmp' '" + STEP_LOG + "'")
    }
    let line = char_name + "\t" + step + "\tdone"
    let tmp = STEP_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + STEP_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d2r_horadric_step", "\"char\":\"" + char_name + "\",\"step\":\"" + step + "\"")
}

fn step_done(char_name: str, step: str) -> bool {
    let exists = exec("test -f '" + STEP_LOG + "' && echo ok").trim()
    if exists != "ok" { return false }
    let cnt_str = exec("awk -F'\\t' -v c='" + char_name + "' -v s='" + step + "' '$1==c && $2==s && $3==\"done\"' '" + STEP_LOG + "' | wc -l | tr -d ' '").trim()
    if cnt_str == "" { return false }
    let cnt = to_int(cnt_str)
    if cnt >= 1 { return true }
    return false
}

// 0~100 %
fn complete_pct(char_name: str) -> int {
    let steps = horadric_steps()
    let total = len(steps)
    if total == 0 { return 0 }
    let done = 0
    let i = 0
    while i < total {
        if step_done(char_name, steps[i]) { done = done + 1 }
        i = i + 1
    }
    return (done * 100) / total
}

fn dhq_stats() -> int {
    let exists = exec("test -f '" + STEP_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + STEP_LOG + "' | tr -d ' '").trim())
}

fn cleanup_dhq() -> void {
    let _ = exec("rm -rf '" + DHQ_DIR + "'")
}

fn self_test() -> void {
    let sid = "dhq-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dhq()

    let steps = horadric_steps()
    if len(steps) != 6 { panic("c_d2r_horadric_quest FAIL [steps] expected=6 got=" + to_string(len(steps))) }

    // 모든 step 은 act2 여야 함
    let i = 0
    while i < len(steps) {
        let a = step_act(steps[i])
        if a != "act2" { panic("c_d2r_horadric_quest FAIL [step_act] step=" + steps[i] + " expected=act2 got=" + a) }
        i = i + 1
    }

    if step_act("nonexistent") != "" { panic("c_d2r_horadric_quest FAIL [unknown step]") }

    // synthetic — 1 char "Joe" 에 4 step 진행
    record_step("Joe", "find_cube")
    record_step("Joe", "find_staff_top")
    record_step("Joe", "find_staff_shaft")
    record_step("Joe", "combine_staff")

    if !step_done("Joe", "find_cube") { panic("c_d2r_horadric_quest FAIL [find_cube done]") }
    if !step_done("Joe", "combine_staff") { panic("c_d2r_horadric_quest FAIL [combine_staff done]") }
    if step_done("Joe", "kill_summoner") { panic("c_d2r_horadric_quest FAIL [kill_summoner should NOT be done]") }
    if step_done("Joe", "kill_duriel") { panic("c_d2r_horadric_quest FAIL [kill_duriel should NOT be done]") }
    if step_done("Other", "find_cube") { panic("c_d2r_horadric_quest FAIL [other char isolation]") }

    // 4/6 = 66 (integer division)
    let pct = complete_pct("Joe")
    if pct != 66 { panic("c_d2r_horadric_quest FAIL [pct] expected=66 got=" + to_string(pct)) }

    // overwrite — 동일 step 다시 등록해도 row 1 개로 유지, pct 동일
    record_step("Joe", "find_cube")
    let pct2 = complete_pct("Joe")
    if pct2 != 66 { panic("c_d2r_horadric_quest FAIL [overwrite pct] expected=66 got=" + to_string(pct2)) }

    let rows = dhq_stats()
    if rows != 4 { panic("c_d2r_horadric_quest FAIL [rows] expected=4 got=" + to_string(rows)) }

    // 2 step 추가 → 100%
    record_step("Joe", "kill_summoner")
    record_step("Joe", "kill_duriel")
    let pct3 = complete_pct("Joe")
    if pct3 != 100 { panic("c_d2r_horadric_quest FAIL [full pct] expected=100 got=" + to_string(pct3)) }

    r0_emit("d2r_horadric_summary", "\"char\":\"Joe\",\"pct\":" + to_string(pct3) + ",\"steps\":6")

    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_d2r_horadric_quest FAIL [emit count] got=" + to_string(cnt)) }

    // ─── synthetic horadric quest stage state machine round-trip (cond.1 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track AI mission: D2R cond.1 (gameplay state machine round-trip) 측 evidence
    // augment. cond.1 측 status `partial` 영구 유지 — real D2R.exe binary smoke
    // 측 Battle.net launcher install 측 영구 외부 의존, met 승격 X.
    //
    // (a) synthetic Act 2 Horadric Quest 6-step state machine cycle —
    //     find_cube → find_staff_top → find_staff_shaft → combine_staff →
    //     kill_summoner → kill_duriel (act2 main quest line):
    //     phase_count               6                   (6 horadric steps)
    //     quest_table_off           0x140094000         (synthetic D2GAME.dll RVA)
    //     quest_kind                "synthetic_inline"  (실 quest log FSM tick X)
    //
    // (b) synthetic step completion percentage progression scaffold —
    //     6 step × done flag walk + complete_pct integer math:
    //     step_total                6                   (act2 horadric line)
    //     done_step_count_partial   4                   (Joe 4/6 = 66%)
    //     done_step_count_full      6                   (Joe 6/6 = 100%)
    //     pct_progression           "0->66->100"        (3-snapshot synthetic)
    //     pct_kind                  "synthetic_inline"  (실 quest_completion tick X)
    //
    // round-trip = synthesize_quest_phase(scaffold) → walk_pct_progression(scaffold).
    //              hexa-native loop only — 실 D2GAME.dll quest log FSM tick 0,
    //              real horadric quest progression 0.
    //
    // synthetic quest phase emit
    r0_emit("c_d2r_horadric_quest_synthetic_phase",
        "\"stage\":\"quest_phase\",\"phase_count\":6,\"quest_table_off\":\"0x140094000\",\"quest_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_QUEST__ PARTIAL quest_phase")

    // synthetic pct progression emit
    r0_emit("c_d2r_horadric_quest_synthetic_pct",
        "\"stage\":\"pct_progression\",\"step_total\":6,\"done_step_count_partial\":4,\"done_step_count_full\":6,\"pct_progression\":\"0->66->100\",\"pct_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.1\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"real_binary_gap\":\"permanent — Battle.net launcher install dependent\"")
    println("__D2R_QUEST__ PARTIAL pct_progression")

    cleanup_dhq()

    println("  ✅ c_d2r_horadric_quest self_test PASS (6 steps, 4/6=66%, full=100%, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "step" && len(a) >= 5 {
            record_step(a[3], a[4])
            println("recorded")
            return
        }
        if sub == "pct" && len(a) >= 4 {
            println("char=" + a[3] + " pct=" + to_string(complete_pct(a[3])))
            return
        }
        if sub == "stats" {
            println("rows=" + to_string(dhq_stats()))
            return
        }
        if sub == "cleanup" { cleanup_dhq(); println("cleaned"); return }
    }
    println("usage: hexa run c_d2r_horadric_quest.hexa { self-test | step <char> <step> | pct <char> | stats | cleanup }")
}
