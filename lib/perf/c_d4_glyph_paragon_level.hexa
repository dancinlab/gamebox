// lib/perf/c_d4_glyph_paragon_level.hexa — CN-184 skeleton manjeom 15/15
//
// D4 Paragon glyph leveling 추적 — Diablo IV Paragon Board 의 glyph socket
// (Magic Find, Wrath, Fortify 등) 은 Nightmare Dungeon clear 로 level 1→21+
// 까지 성장하며 level 별로 영향 radius (tile) 가 확장되고 bonus stat scaling
// 이 적용된다. 본 모듈은 c_d4_paragon_track 와 별도로 glyph 단위 (glyph_id ×
// level × radius_tile × bonus_stat) progression 만 집계한다 — 실제 NMD 진행
// 과 board layout 은 host 측 책임.
//
// 무기: glyph × level × radius_tile × bonus_stat 4-key columnar log + sum/avg.
// 효과: D4 glyph leveling progression 정량화 → Paragon 효율 비교 가능.

use "./r0_common"

let DGPL_DIR = GAMEBOX_HOME + "/persist/d4_glyph_paragon_level"
let GLYPH_LOG = DGPL_DIR + "/glyphs.tsv"

fn dgpl_dir() -> str { return DGPL_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DGPL_DIR + "'")
}

// ─── glyph 등록 ───
//   glyph_id (Wrath / Fortify / Magic Find 등 logical glyph 의 id),
//   level (1..21+ Paragon glyph level),
//   radius_tile (Paragon Board 영향 반경 tile 수),
//   bonus_stat (level 별 누적 bonus stat 값 — host 측 측정).
fn record_glyph(glyph_id: int, level: int, radius_tile: int, bonus_stat: int) -> void {
    ensure_dir()
    let line = to_string(glyph_id) + "\t" + to_string(level) + "\t" + to_string(radius_tile) + "\t" + to_string(bonus_stat)
    let tmp = GLYPH_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + GLYPH_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_glyph_record", "\"glyph\":" + to_string(glyph_id) + ",\"level\":" + to_string(level) + ",\"radius\":" + to_string(radius_tile) + ",\"bonus\":" + to_string(bonus_stat))
}

// ─── glyph_count — 등록된 glyph 행 수 ───
fn glyph_count() -> int {
    let exists = exec("test -f '" + GLYPH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + GLYPH_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_levels — 모든 glyph level 합 ───
fn total_levels() -> int {
    let exists = exec("test -f '" + GLYPH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + GLYPH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_radius — 모든 glyph radius_tile 합 ───
fn total_radius() -> int {
    let exists = exec("test -f '" + GLYPH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + GLYPH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_bonus — 모든 glyph bonus_stat 합 ───
fn total_bonus() -> int {
    let exists = exec("test -f '" + GLYPH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + GLYPH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_bonus_per_level — total_bonus / total_levels (int trunc) ───
//   level 0 이면 0 반환 (divide-by-zero guard).
fn avg_bonus_per_level() -> int {
    let tl = total_levels()
    if tl == 0 { return 0 }
    let tb = total_bonus()
    return tb / tl
}

// ─── glyph_radius — glyph_id 의 radius_tile 조회 ───
//   glyph_id 미등록이면 0.
fn glyph_radius(glyph_id: int) -> int {
    let exists = exec("test -f '" + GLYPH_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v g=" + to_string(glyph_id) + " '$1==g {s+=$3} END{print s+0}' '" + GLYPH_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dgpl_stats — [glyph_count, total_levels, total_radius, total_bonus] ───
fn dgpl_stats() -> array {
    return [glyph_count(), total_levels(), total_radius(), total_bonus()]
}

fn cleanup_dgpl() -> void {
    let _ = exec("rm -rf '" + DGPL_DIR + "'")
}

fn self_test() -> void {
    let sid = "dgpl-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dgpl()

    // 합성 glyph 3 종:
    //   Wrath glyph      (id=39001) — level 15 / radius 4 / bonus 120
    //   Fortify glyph    (id=39002) — level 21 / radius 5 / bonus 160
    //   Magic Find glyph (id=39003) — level 10 / radius 3 / bonus 80
    record_glyph(39001, 15, 4, 120)
    record_glyph(39002, 21, 5, 160)
    record_glyph(39003, 10, 3, 80)

    // glyph_count = 3
    let gc = glyph_count()
    if gc != 3 { panic("c_d4_glyph_paragon_level FAIL [glyph_count] expected=3 got=" + to_string(gc)) }

    // total_levels = 15+21+10 = 46
    let tl = total_levels()
    if tl != 46 { panic("c_d4_glyph_paragon_level FAIL [total_levels] expected=46 got=" + to_string(tl)) }

    // total_radius = 4+5+3 = 12
    let tr = total_radius()
    if tr != 12 { panic("c_d4_glyph_paragon_level FAIL [total_radius] expected=12 got=" + to_string(tr)) }

    // total_bonus = 120+160+80 = 360
    let tb = total_bonus()
    if tb != 360 { panic("c_d4_glyph_paragon_level FAIL [total_bonus] expected=360 got=" + to_string(tb)) }

    // avg_bonus_per_level = 360 / 46 = 7 (int trunc)
    let avg = avg_bonus_per_level()
    if avg != 7 { panic("c_d4_glyph_paragon_level FAIL [avg_bonus] expected=7 got=" + to_string(avg)) }

    // glyph_radius:
    //   Wrath      39001 → 4
    //   Fortify    39002 → 5
    //   Magic Find 39003 → 3
    let r1 = glyph_radius(39001)
    if r1 != 4 { panic("c_d4_glyph_paragon_level FAIL [radius 39001] expected=4 got=" + to_string(r1)) }
    let r2 = glyph_radius(39002)
    if r2 != 5 { panic("c_d4_glyph_paragon_level FAIL [radius 39002] expected=5 got=" + to_string(r2)) }
    let r3 = glyph_radius(39003)
    if r3 != 3 { panic("c_d4_glyph_paragon_level FAIL [radius 39003] expected=3 got=" + to_string(r3)) }
    // 미등록 glyph_id 는 0
    let r4 = glyph_radius(9999)
    if r4 != 0 { panic("c_d4_glyph_paragon_level FAIL [radius unknown] expected=0 got=" + to_string(r4)) }

    let stats = dgpl_stats()
    if stats[0] != 3 { panic("c_d4_glyph_paragon_level FAIL [stats glyphs] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 46 { panic("c_d4_glyph_paragon_level FAIL [stats levels] expected=46 got=" + to_string(stats[1])) }
    if stats[2] != 12 { panic("c_d4_glyph_paragon_level FAIL [stats radius] expected=12 got=" + to_string(stats[2])) }
    if stats[3] != 360 { panic("c_d4_glyph_paragon_level FAIL [stats bonus] expected=360 got=" + to_string(stats[3])) }

    r0_emit("d4_glyph_summary", "\"glyphs\":" + to_string(stats[0]) + ",\"levels\":" + to_string(stats[1]) + ",\"radius\":" + to_string(stats[2]) + ",\"bonus\":" + to_string(stats[3]) + ",\"avg\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d4_glyph_paragon_level FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic D4 glyph/paragon retired_intentional posture annotation (Track V) ───
    //
    // Track V mission: D4 always-online DRM honest spec freeze posture annotation.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land).
    // 본 module 측 glyph + paragon level tracker = synthetic glyph table + radius / bonus
    // — production live game state 측정 X (D4 always-online live session 진입 X, DRM
    // bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module self_test() 측 honest
    // annotation row 추가 only — cond.3 status `partial` 영구 유지 (retired_intentional
    // posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "glyph_paragon_level"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_glyph_paragon_level_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"glyph_paragon_level\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_GLYPH_PARAGON__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dgpl()

    println("  ✅ c_d4_glyph_paragon_level self_test PASS (3 glyphs, 46 levels, 12 radius, 360 bonus, avg=7, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dgpl_stats()
            println("glyphs=" + to_string(s[0]) + " levels=" + to_string(s[1]) + " radius=" + to_string(s[2]) + " bonus=" + to_string(s[3]))
            return
        }
        if sub == "radius" {
            if len(a) >= 4 {
                let gid = to_int(a[3])
                let r = glyph_radius(gid)
                println(to_string(r))
                return
            }
        }
        if sub == "cleanup" { cleanup_dgpl(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_glyph_paragon_level.hexa { self-test | stats | radius <glyph_id> | cleanup }")
}
