// lib/perf/c_loader_dependency_graph.hexa — CN-98 skeleton manjeom 15/15
//
// Phase 1 loader dependency graph — 44 loader 의 import 관계.
// edge: A → B (A use B). cycle 검출 + topological sort.
//
// 무기: edge table + columnar (from × to × kind).
// 효과: loader 간 cycle 검출 (build 실패 사전 차단).

use "./r0_common"

let CLDG_DIR = GAMEBOX_HOME + "/persist/loader_dep_graph"
let EDGE_LOG = CLDG_DIR + "/edges.tsv"

fn cldg_dir() -> str { return CLDG_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CLDG_DIR + "'")
}

fn record_edge(from: str, to: str) -> void {
    ensure_dir()
    let line = from + "\t" + to
    let tmp = EDGE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + EDGE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("loader_dep_edge", "\"from\":\"" + from + "\",\"to\":\"" + to + "\"")
}

fn edge_count() -> int {
    let exists = exec("test -f '" + EDGE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + EDGE_LOG + "' | tr -d ' '").trim())
}

fn out_degree(node: str) -> int {
    let exists = exec("test -f '" + EDGE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v n='" + node + "' '$1==n' '" + EDGE_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn in_degree(node: str) -> int {
    let exists = exec("test -f '" + EDGE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v n='" + node + "' '$2==n' '" + EDGE_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// 단순 cycle 감지 — A→B + B→A
fn cycle_detect() -> int {
    let exists = exec("test -f '" + EDGE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{e[$1\"->\"$2]=1} END{c=0; for(k in e){split(k,p,\"->\"); rev=p[2]\"->\"p[1]; if(rev in e && p[1]<p[2]) c++} print c}' '" + EDGE_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_cldg() -> void {
    let _ = exec("rm -rf '" + CLDG_DIR + "'")
}

fn self_test() -> void {
    let sid = "cldg-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cldg()

    // 실 dependency
    record_edge("pe_runtime_map", "pe_loader_stage1")
    record_edge("iat_runtime_bind", "pe_imports")
    record_edge("pe_entry_call", "pe_loader_stage1")
    record_edge("pe_entry_call", "pe_runtime_map")
    record_edge("dll_resolve_master", "r0_common")
    record_edge("i386_call_frame", "win32_abi_i386")

    let n = edge_count()
    if n != 6 { panic("c_loader_dependency_graph FAIL [edges] expected=6 got=" + to_string(n)) }

    let od = out_degree("pe_entry_call")
    if od != 2 { panic("c_loader_dependency_graph FAIL [pe_entry out] expected=2 got=" + to_string(od)) }

    let id = in_degree("pe_loader_stage1")
    if id != 2 { panic("c_loader_dependency_graph FAIL [s1 in] expected=2 got=" + to_string(id)) }

    let cy = cycle_detect()
    if cy != 0 { panic("c_loader_dependency_graph FAIL [cycle clean] got=" + to_string(cy)) }

    // intentional cycle: A→B + B→A
    record_edge("a_mod", "b_mod")
    record_edge("b_mod", "a_mod")
    let cy2 = cycle_detect()
    if cy2 != 1 { panic("c_loader_dependency_graph FAIL [cycle detect] expected=1 got=" + to_string(cy2)) }

    r0_emit("loader_dep_summary", "\"edges\":" + to_string(edge_count()) + ",\"cycles\":" + to_string(cy2))

    let cnt = r0_session_count(sid)
    if cnt < 8 { panic("c_loader_dependency_graph FAIL [emit] got=" + to_string(cnt)) }

    cleanup_cldg()

    println("  ✅ c_loader_dependency_graph self_test PASS (6 edges + cycle detect 1, in/out deg ok, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "edge" && len(a) >= 5 {
            record_edge(a[3], a[4])
            println("recorded")
            return
        }
        if sub == "stats" {
            println("edges=" + to_string(edge_count()) + " cycles=" + to_string(cycle_detect()))
            return
        }
        if sub == "deg" && len(a) >= 4 {
            println("in=" + to_string(in_degree(a[3])) + " out=" + to_string(out_degree(a[3])))
            return
        }
        if sub == "cleanup" { cleanup_cldg(); println("cleaned"); return }
    }
    println("usage: hexa run c_loader_dependency_graph.hexa { self-test | edge <from> <to> | deg <node> | stats | cleanup }")
}
