// lib/perf/c_oauth_redirect_capture_track.hexa — CN-101 skeleton manjeom 15/15
//
// Phase 2 OAuth redirect_uri 캡처 추적 — Battle.net 의 localhost callback.
// state 파라미터 검증 + code 추출 + nonce 검증.
//
// 무기: redirect event table + columnar (per-event valid/invalid).
// 효과: OAuth flow 중 csrf 공격 차단 (state 위변조 검출).

use "./r0_common"

let CORC_DIR = GAMEBOX_HOME + "/persist/oauth_redirect_capture"
let RED_LOG = CORC_DIR + "/redirects.tsv"

fn corc_dir() -> str { return CORC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CORC_DIR + "'")
}

// state 형식: "<random_32_chars>" — 단순 length 검증
fn state_valid(state: str) -> bool {
    if len(state) < 16 { return false }
    if len(state) > 128 { return false }
    return true
}

// code 형식: 영숫자 (단순 검증)
fn code_valid(code: str) -> bool {
    if len(code) < 8 { return false }
    if code.contains(" ") { return false }
    if code.contains("\t") { return false }
    return true
}

fn record_redirect(state: str, code: str, expected_state: str) -> void {
    ensure_dir()
    let csrf_safe = state == expected_state
    let s_ok = state_valid(state)
    let c_ok = code_valid(code)
    let valid = csrf_safe && s_ok && c_ok
    let v = "0"
    if valid { v = "1" }
    let line = state + "\t" + code + "\t" + v
    let tmp = RED_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + RED_LOG + "' && rm -f '" + tmp + "'")
    if valid {
        r0_emit("oauth_redirect_ok", "\"state_len\":" + to_string(len(state)) + ",\"code_len\":" + to_string(len(code)))
    } else {
        r0_emit("oauth_redirect_blocked", "\"csrf_safe\":" + to_string(csrf_safe) + ",\"state_ok\":" + to_string(s_ok))
    }
}

fn redirect_count() -> int {
    let exists = exec("test -f '" + RED_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + RED_LOG + "' | tr -d ' '").trim())
}

fn valid_count() -> int {
    let exists = exec("test -f '" + RED_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$3==1' '" + RED_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_corc() -> void {
    let _ = exec("rm -rf '" + CORC_DIR + "'")
}

fn self_test() -> void {
    let sid = "corc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_corc()

    if !state_valid("abcdef0123456789") { panic("c_oauth_redirect_capture_track FAIL [state 16]") }
    if state_valid("short") { panic("c_oauth_redirect_capture_track FAIL [state too short]") }
    if !code_valid("MyAuthCode_xyz123") { panic("c_oauth_redirect_capture_track FAIL [code ok]") }
    if code_valid("bad code") { panic("c_oauth_redirect_capture_track FAIL [code space]") }

    let exp_state = "abcdef0123456789xyz"
    record_redirect(exp_state, "VALID_CODE_123", exp_state)               // valid
    record_redirect("DIFF_STATE_xxxxxxxx", "VALID_CODE_456", exp_state)   // CSRF mismatch
    record_redirect(exp_state, "bad code", exp_state)                      // bad code
    record_redirect("short", "VALID_CODE", exp_state)                       // short state

    let total = redirect_count()
    if total != 4 { panic("c_oauth_redirect_capture_track FAIL [total] expected=4 got=" + to_string(total)) }

    let v = valid_count()
    if v != 1 { panic("c_oauth_redirect_capture_track FAIL [valid] expected=1 got=" + to_string(v)) }

    r0_emit("oauth_redirect_summary", "\"total\":" + to_string(total) + ",\"valid\":" + to_string(v) + ",\"blocked\":" + to_string(total - v))

    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_oauth_redirect_capture_track FAIL [emit] got=" + to_string(cnt)) }

    // ─── synthetic OAuth redirect capture state machine round-trip (Track-AR cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track-AR mission: battlenet cond.3 (OAuth 2-leg + login state track live)
    // 측 evidence augment. cond.3 status `partial` 영구 유지 — 실 redirect URI listener
    // (loopback :port) + 실 state CSRF round-trip 측 production smoke gate transitive
    // (network-dependent, blk.1).
    //
    // synthetic redirect capture state machine: STATE_GENERATE → REDIRECT_AWAIT
    // → STATE_VERIFY → CODE_CAPTURE → CSRF_REJECT 5 transition. hexa-native loop
    // only — 실 loopback HTTP listener 0, 실 redirect 0, 실 OAuth2 endpoint 0.
    // payload = redirect_session_id + capture_step_kind + state_len_simulated.
    // round-trip emit = `__OAUTH_REDIRECT__ PARTIAL <state>` per row.
    //
    // own1: Wine 0 / OAuth credential bypass 0 / CSRF spoof 0 / loopback bind 0.
    // own2: PARTIAL emit explicit (NOT PASS — production smoke deferred).
    let red_sid = "red-synth-" + exec("date +%s").trim()

    println("__OAUTH_REDIRECT__ PARTIAL STATE_GENERATE")
    r0_emit("c_oauth_redirect_capture_track_synthetic_state",
        "\"stage\":\"redirect_capture_state_machine\",\"redirect_session_id\":\"" + red_sid + "\",\"capture_step_kind\":\"STATE_GENERATE\",\"state_len_simulated\":32,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"permanent_until_real_network — blk.1 transitive\"")

    println("__OAUTH_REDIRECT__ PARTIAL REDIRECT_AWAIT")
    r0_emit("c_oauth_redirect_capture_track_synthetic_state",
        "\"stage\":\"redirect_capture_state_machine\",\"redirect_session_id\":\"" + red_sid + "\",\"capture_step_kind\":\"REDIRECT_AWAIT\",\"state_len_simulated\":32,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__OAUTH_REDIRECT__ PARTIAL STATE_VERIFY")
    r0_emit("c_oauth_redirect_capture_track_synthetic_state",
        "\"stage\":\"redirect_capture_state_machine\",\"redirect_session_id\":\"" + red_sid + "\",\"capture_step_kind\":\"STATE_VERIFY\",\"state_len_simulated\":32,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__OAUTH_REDIRECT__ PARTIAL CODE_CAPTURE")
    r0_emit("c_oauth_redirect_capture_track_synthetic_state",
        "\"stage\":\"redirect_capture_state_machine\",\"redirect_session_id\":\"" + red_sid + "\",\"capture_step_kind\":\"CODE_CAPTURE\",\"state_len_simulated\":32,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__OAUTH_REDIRECT__ PARTIAL CSRF_REJECT")
    r0_emit("c_oauth_redirect_capture_track_synthetic_state",
        "\"stage\":\"redirect_capture_state_machine\",\"redirect_session_id\":\"" + red_sid + "\",\"capture_step_kind\":\"CSRF_REJECT\",\"state_len_simulated\":32,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    r0_emit("c_oauth_redirect_capture_track_synthetic_round_trip_matrix",
        "\"states_total\":5,\"states_partial\":5,\"states_pass\":0,\"redirect_session_id\":\"" + red_sid + "\",\"transport_kind\":\"synthetic_inline\",\"network\":\"none\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"track\":\"AR\",\"lockin_iso\":\"2026-05-04\"")

    cleanup_corc()

    println("  ✅ c_oauth_redirect_capture_track self_test PASS (4 attempts: 1 valid / 3 blocked CSRF+bad+short, +5 synthetic redirect state PARTIAL transitions, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "capture" && len(a) >= 6 {
            record_redirect(a[3], a[4], a[5])
            println("recorded")
            return
        }
        if sub == "stats" {
            println("total=" + to_string(redirect_count()) + " valid=" + to_string(valid_count()))
            return
        }
        if sub == "cleanup" { cleanup_corc(); println("cleaned"); return }
    }
    println("usage: hexa run c_oauth_redirect_capture_track.hexa { self-test | capture <state> <code> <expected> | stats | cleanup }")
}
