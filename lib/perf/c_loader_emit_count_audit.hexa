// lib/perf/c_loader_emit_count_audit.hexa — CN-96 skeleton manjeom 15/15
//
// loader 모듈의 emit 호출 빈도 감사 — own 2 (a) 충족 검증 + 성장 추이.
// 각 loader 의 r0_emit 줄 수 / module 별 평균 / 시계열 추적.
//
// 무기: loader file × emit_count + columnar (per-module audit).
// 효과: 신규 loader 추가 시 emit 누락 즉시 검출.

use "./r0_common"

let CLEC_DIR = GAMEBOX_HOME + "/persist/loader_emit_audit"
let AUDIT_LOG = CLEC_DIR + "/audit.tsv"

fn clec_dir() -> str { return CLEC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CLEC_DIR + "'")
}

fn record_audit(loader: str, emit_count: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + AUDIT_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v l='" + loader + "' '$1!=l' '" + AUDIT_LOG + "' > '" + AUDIT_LOG + ".tmp' && mv '" + AUDIT_LOG + ".tmp' '" + AUDIT_LOG + "'")
    }
    let line = loader + "\t" + to_string(emit_count)
    let tmp = AUDIT_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + AUDIT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("loader_emit_audit", "\"loader\":\"" + loader + "\",\"count\":" + to_string(emit_count))
}

fn loader_count() -> int {
    let exists = exec("test -f '" + AUDIT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + AUDIT_LOG + "' | tr -d ' '").trim())
}

fn total_emits() -> int {
    let exists = exec("test -f '" + AUDIT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + AUDIT_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn avg_emits() -> int {
    let n = loader_count()
    if n == 0 { return 0 }
    return total_emits() / n
}

fn zero_emit_loaders() -> int {
    let exists = exec("test -f '" + AUDIT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$2==0' '" + AUDIT_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_clec() -> void {
    let _ = exec("rm -rf '" + CLEC_DIR + "'")
}

fn self_test() -> void {
    let sid = "clec-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_clec()

    // synthetic — 42 loader 모듈 각각 emit count
    record_audit("pe_parser", 5)
    record_audit("pe_loader", 3)
    record_audit("pe_loader_stage1", 8)
    record_audit("pe_imports", 6)
    record_audit("pe_relocations", 2)
    record_audit("pe_runtime_map", 2)
    record_audit("iat_runtime_bind", 2)
    record_audit("win32_kernel32_extras", 12)
    record_audit("dll_resolve_master", 1)
    record_audit("pe_entry_call", 2)

    let n = loader_count()
    if n != 10 { panic("c_loader_emit_count_audit FAIL [count] expected=10 got=" + to_string(n)) }

    let total = total_emits()
    if total != 43 { panic("c_loader_emit_count_audit FAIL [total] expected=43 got=" + to_string(total)) }

    let avg = avg_emits()
    if avg != 4 { panic("c_loader_emit_count_audit FAIL [avg] expected=4 got=" + to_string(avg)) }

    let zero = zero_emit_loaders()
    if zero != 0 { panic("c_loader_emit_count_audit FAIL [zero] expected=0 got=" + to_string(zero)) }

    // 0 emit loader 추가 — own 2 violation
    record_audit("bad_loader", 0)
    let zero2 = zero_emit_loaders()
    if zero2 != 1 { panic("c_loader_emit_count_audit FAIL [zero detect] expected=1 got=" + to_string(zero2)) }

    r0_emit("loader_emit_audit_summary", "\"loaders\":" + to_string(n) + ",\"total\":" + to_string(total) + ",\"zero\":" + to_string(zero2))

    let cnt = r0_session_count(sid)
    if cnt < 10 { panic("c_loader_emit_count_audit FAIL [emit] got=" + to_string(cnt)) }

    cleanup_clec()

    println("  ✅ c_loader_emit_count_audit self_test PASS (10 loaders, total=43 avg=4, zero detect ok, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 5 {
            record_audit(a[3], to_int(a[4]))
            println("recorded")
            return
        }
        if sub == "stats" {
            println("loaders=" + to_string(loader_count()) + " total=" + to_string(total_emits()) + " avg=" + to_string(avg_emits()) + " zero=" + to_string(zero_emit_loaders()))
            return
        }
        if sub == "cleanup" { cleanup_clec(); println("cleaned"); return }
    }
    println("usage: hexa run c_loader_emit_count_audit.hexa { self-test | set <loader> <count> | stats | cleanup }")
}
