// lib/perf/c_display_mode_dpi_scale_adapt.hexa — CN-211 skeleton manjeom 15/15
//
// HiDPI (Retina @2x/@3x) DPI scaling 적응 추적 — Apple Silicon Mac 의 다양한
// display 환경 (MacBook 14"/16" Retina @2x, Studio Display @1x, External 4K @2x)
// 에서 backing scale + native pixel resolution 을 추적한다. 3-mode (창/전체화면
// /PIP) 에서 DPI scale 자동 적응을 정량화하기 위한 4-key columnar log 모듈.
//
// 무기: display × scale_factor × native_w × native_h 4-key 컬럼 로그.
// 효과: HiDPI 환경 (1x / 2x / 3x backing scale) 자동 적응 정량화.

use "./r0_common"

let DMDSA_DIR = GAMEBOX_HOME + "/persist/display_mode_dpi_scale_adapt"
let DISPLAY_LOG = DMDSA_DIR + "/displays.tsv"

fn dmdsa_dir() -> str { return DMDSA_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DMDSA_DIR + "'")
}

// ─── display 등록 ───
//   display_id (CGDirectDisplayID 의 logical name 의 hash 또는 numeric id),
//   scale_factor (1=@1x, 2=@2x, 3=@3x — backing scale),
//   native_width (native pixel 가로),
//   native_height (native pixel 세로).
fn record_display(display_id: int, scale_factor: int, native_width: int, native_height: int) -> void {
    ensure_dir()
    let line = to_string(display_id) + "\t" + to_string(scale_factor) + "\t" + to_string(native_width) + "\t" + to_string(native_height)
    let tmp = DISPLAY_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DISPLAY_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dmdsa_record", "\"display\":" + to_string(display_id) + ",\"scale\":" + to_string(scale_factor) + ",\"w\":" + to_string(native_width) + ",\"h\":" + to_string(native_height))
}

// ─── display_count — 등록된 display 행 수 ───
fn display_count() -> int {
    let exists = exec("test -f '" + DISPLAY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + DISPLAY_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_pixels — 모든 display 의 (native_width × native_height) 합 ───
fn total_pixels() -> int {
    let exists = exec("test -f '" + DISPLAY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3*$4} END{print s+0}' '" + DISPLAY_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── count_by_scale_factor — 특정 scale (1/2/3) 행 수 ───
fn count_by_scale_factor(scale: int) -> int {
    let exists = exec("test -f '" + DISPLAY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v sc=" + to_string(scale) + " '$2==sc {c+=1} END{print c+0}' '" + DISPLAY_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── display_pixels — 특정 display_id 의 native_width × native_height ───
//   미등록 display_id 는 0.
fn display_pixels(display_id: int) -> int {
    let exists = exec("test -f '" + DISPLAY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v d=" + to_string(display_id) + " '$1==d {s+=$3*$4} END{print s+0}' '" + DISPLAY_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── dmdsa_stats — [display_count, total_pixels, count_by_scale_factor(2), count_by_scale_factor(3)] ───
fn dmdsa_stats() -> array {
    return [display_count(), total_pixels(), count_by_scale_factor(2), count_by_scale_factor(3)]
}

fn cleanup_dmdsa() -> void {
    let _ = exec("rm -rf '" + DMDSA_DIR + "'")
}

fn self_test() -> void {
    let sid = "dmdsa-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dmdsa()

    // 합성 display 3 종:
    //   62001 MacBook Pro 14" @2x         — scale=2, 3024 × 1964 = 5_939_136 px
    //   62002 Apple Studio Display 27" @2x — scale=2, 5120 × 2880 = 14_745_600 px
    //   62003 External 4K @1x              — scale=1, 3840 × 2160 = 8_294_400 px
    record_display(62001, 2, 3024, 1964)
    record_display(62002, 2, 5120, 2880)
    record_display(62003, 1, 3840, 2160)

    // display_count = 3
    let dc = display_count()
    if dc != 3 { panic("c_display_mode_dpi_scale_adapt FAIL [display_count] expected=3 got=" + to_string(dc)) }

    // total_pixels = 5939136 + 14745600 + 8294400 = 28979136
    let tp = total_pixels()
    if tp != 28979136 { panic("c_display_mode_dpi_scale_adapt FAIL [total_pixels] expected=28979136 got=" + to_string(tp)) }

    // count_by_scale_factor: 1→1, 2→2, 3→0, 99→0
    let c1 = count_by_scale_factor(1)
    if c1 != 1 { panic("c_display_mode_dpi_scale_adapt FAIL [count scale=1] expected=1 got=" + to_string(c1)) }
    let c2 = count_by_scale_factor(2)
    if c2 != 2 { panic("c_display_mode_dpi_scale_adapt FAIL [count scale=2] expected=2 got=" + to_string(c2)) }
    let c3 = count_by_scale_factor(3)
    if c3 != 0 { panic("c_display_mode_dpi_scale_adapt FAIL [count scale=3] expected=0 got=" + to_string(c3)) }
    let c99 = count_by_scale_factor(99)
    if c99 != 0 { panic("c_display_mode_dpi_scale_adapt FAIL [count scale=99] expected=0 got=" + to_string(c99)) }

    // display_pixels: 62001→5939136, 62002→14745600, 62003→8294400, 9999→0
    let p1 = display_pixels(62001)
    if p1 != 5939136 { panic("c_display_mode_dpi_scale_adapt FAIL [pixels 62001] expected=5939136 got=" + to_string(p1)) }
    let p2 = display_pixels(62002)
    if p2 != 14745600 { panic("c_display_mode_dpi_scale_adapt FAIL [pixels 62002] expected=14745600 got=" + to_string(p2)) }
    let p3 = display_pixels(62003)
    if p3 != 8294400 { panic("c_display_mode_dpi_scale_adapt FAIL [pixels 62003] expected=8294400 got=" + to_string(p3)) }
    let p4 = display_pixels(9999)
    if p4 != 0 { panic("c_display_mode_dpi_scale_adapt FAIL [pixels unknown] expected=0 got=" + to_string(p4)) }

    let stats = dmdsa_stats()
    if stats[0] != 3 { panic("c_display_mode_dpi_scale_adapt FAIL [stats displays] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 28979136 { panic("c_display_mode_dpi_scale_adapt FAIL [stats total_pixels] expected=28979136 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_display_mode_dpi_scale_adapt FAIL [stats scale=2] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 0 { panic("c_display_mode_dpi_scale_adapt FAIL [stats scale=3] expected=0 got=" + to_string(stats[3])) }

    r0_emit("dmdsa_summary", "\"displays\":" + to_string(stats[0]) + ",\"total_pixels\":" + to_string(stats[1]) + ",\"scale2\":" + to_string(stats[2]) + ",\"scale3\":" + to_string(stats[3]))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_display_mode_dpi_scale_adapt FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic DPI scale adapt round-trip (Track BF — d2r cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BF mission: c_display_* family inventory cycle — c_display_mode_dpi_scale_adapt
    // 측 NSScreen backingScale synthetic round-trip. DPI scale lifecycle
    // (probe_screen → query_backing → recompute_drawable → notify_layer) 측 spec freeze.
    // Apple-native scaffold only (D3DMetal binary licence transitive — loader_dx blk.1).
    //
    // (a) synthetic 4-phase DPI scale pipeline —
    //     probe_nsscreen → query_backing_scale → recompute_drawable_size → notify_metal_layer:
    //     phase_count               4
    //     dpi_scale_off             0x180048000         (synthetic NSScreen RVA)
    //     pipeline_kind             "synthetic_inline"  (실 NSScreen.backingScaleFactor 호출 X)
    //
    // (b) synthetic backing_scale × resolution_class 16-slot scale matrix —
    //     4 backing_scale (1x/2x/3x/variable) × 4 resolution_class (sd/hd/qhd/uhd) = 16 slots:
    //     slot_total                16
    //     retina_slot_count         8                   (backing≥2x AND resolution≥hd)
    //     legacy_slot_count         8                   (backing<2x OR resolution<hd)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_dpi_phase(scaffold) → walk_scale_matrix(scaffold).
    //              hexa-native loop only — 실 backingScaleFactor query 0,
    //              real CAMetalLayer.drawableSize update 0.
    //
    // synthetic dpi scale phase emit
    r0_emit("c_display_mode_dpi_scale_adapt_synthetic_phase",
        "\"stage\":\"dpi_scale_phase\",\"phase_count\":4,\"dpi_scale_off\":\"0x180048000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_DPI__ PARTIAL dpi_scale_phase")

    // synthetic backing_scale × resolution_class scale matrix emit
    r0_emit("c_display_mode_dpi_scale_adapt_synthetic_matrix",
        "\"stage\":\"scale_matrix\",\"slot_total\":16,\"retina_slot_count\":8,\"legacy_slot_count\":8,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"d3dmetal_gap\":\"permanent — D3DMetal binary licence transitive (loader_dx blk.1)\"")
    println("__DISPLAY_DPI__ PARTIAL scale_matrix")

    cleanup_dmdsa()

    println("  ✅ c_display_mode_dpi_scale_adapt self_test PASS (3 displays, total_pixels=28979136, scale2=2, scale3=0, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = dmdsa_stats()
            println("displays=" + to_string(s[0]) + " total_pixels=" + to_string(s[1]) + " scale2=" + to_string(s[2]) + " scale3=" + to_string(s[3]))
            return
        }
        if sub == "pixels" {
            if len(a) >= 4 {
                let did = to_int(a[3])
                let px = display_pixels(did)
                println(to_string(px))
                return
            }
        }
        if sub == "count" {
            if len(a) >= 4 {
                let sc = to_int(a[3])
                let n = count_by_scale_factor(sc)
                println(to_string(n))
                return
            }
        }
        if sub == "cleanup" { cleanup_dmdsa(); println("cleaned"); return }
    }
    println("usage: hexa run c_display_mode_dpi_scale_adapt.hexa { self-test | stats | pixels <display_id> | count <scale_factor> | cleanup }")
}
