// lib/perf/m1_baseline.hexa — M1 baseline 측정 harness
//
// PERF_PLAN.md § 12 측정 protocol 구현:
//   D2R 5 시나리오 × 30분 × 3회 + D4 5 시나리오 × 30분 × 3회
//   각 run = JSONL frame_tick + heap_sample + pso_compiled events
//   median P50 / P99 frametime 추출 → baseline 표
//
// own 1 (production module) + own 2 (R0 instrumentation emit) — only use r0_common.
// hexa-lang stage1 제약 (try/catch 없음, float 없음, bit-ops 없음) 적용.
//
// upstream candidates:
//   - native CSV writer (현재 manual concat)
//   - high-precision sleep_us (real_measure 구현 시 instrumentation 윈도)
//   - native sort/percentile (현재 insertion sort 우회)

use "./r0_common"

let M1_BASELINE_DIR = GAMEBOX_HOME + "/baseline"
let M1_SUMMARY_CSV = M1_BASELINE_DIR + "/game_scenario_results.csv"
let M1_CSV_HEADER = "game,scenario,run,fps_avg,fps_p99,frametime_p50_us,frametime_p99_us,stutter_count"

// ───────────────────────────────────────────────────────────────────────────
// dir / catalog
// ───────────────────────────────────────────────────────────────────────────

fn baseline_dir() -> str {
    let _ = exec("mkdir -p '" + M1_BASELINE_DIR + "'")
    return M1_BASELINE_DIR + "/"
}

fn d2r_scenarios() -> array {
    return [
        "campaign_act1",
        "coop_4player",
        "cinematic_intro",
        "character_entry",
        "cold_launch"
    ]
}

fn d4_scenarios() -> array {
    return [
        "open_world_fractured_peaks",
        "zone_transition",
        "boss_world_boss",
        "kyovashad_city",
        "cold_launch"
    ]
}

// ───────────────────────────────────────────────────────────────────────────
// int math helpers (P50/P99 + median) — float 없이 정수만
// ───────────────────────────────────────────────────────────────────────────

fn m1_isort(xs: array) -> array {
    let n = len(xs)
    let copy = []
    let i = 0
    while i < n {
        copy = copy + [xs[i]]
        i = i + 1
    }
    let k = 1
    while k < n {
        let v = copy[k]
        let j = k - 1
        let done = false
        while j >= 0 && !done {
            if copy[j] > v {
                copy[j + 1] = copy[j]
                j = j - 1
            } else {
                done = true
            }
        }
        copy[j + 1] = v
        k = k + 1
    }
    return copy
}

fn m1_percentile(xs: array, pct: int) -> int {
    let n = len(xs)
    if n == 0 { return 0 }
    let s = m1_isort(xs)
    // floor((n-1) * pct / 100)
    let idx = ((n - 1) * pct) / 100
    if idx < 0 { idx = 0 }
    if idx >= n { idx = n - 1 }
    return s[idx]
}

fn m1_median_int(xs: array) -> int {
    return m1_percentile(xs, 50)
}

fn m1_avg_int(xs: array) -> int {
    let n = len(xs)
    if n == 0 { return 0 }
    let s = 0
    let i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s / n
}

// ───────────────────────────────────────────────────────────────────────────
// synthetic measurement — real game 부재 시 200 frame_tick + 5 heap + 3 pso
// emit JSONL events (own 2). seed 로 재현성 (hash-mix LCG).
// ───────────────────────────────────────────────────────────────────────────

// 2^31 = 2147483648 — modulus for the 32-bit LCG (Numerical Recipes constants).
// hexa-lang stage1 has BigInt-style ints w/o auto-truncation, so we modulo
// manually each step to prevent unbounded growth (→ OOM in long loops).
let M1_LCG_MOD = 2147483648

fn m1_lcg_next(state: int) -> int {
    let s = state
    if s < 0 { s = 0 - s }
    if s < 0 { s = 0 }
    s = s % M1_LCG_MOD
    s = (s * 1664525 + 1013904223) % M1_LCG_MOD
    if s < 0 { s = s + M1_LCG_MOD }
    return s
}

// PERF_PLAN.md spec calls for 200 frame_tick but stage1 hexa-lang +
// docker 4g cap can't sustain repeated 200-element insertion-sort + 100+ exec
// emits across 7+ runs (median_of_3 needs 3 runs, self_test exercises 2 tracks
// of 3 + 1 standalone = 7).  Cap at 100 frames per scenario to fit in docker
// mem ceiling — preserves P50/P99/stutter signal (100 frames ≈ 1.7s at 60fps).
// Real-game `real_measure` will use full duration via session JSONL parsing,
// not this synthetic path.  Upstream candidate: native sort + bounded emit.
let M1_FRAMES_PER_SCENARIO = 60

fn synthetic_measure(game: str, scenario: str, seed: int) -> array {
    let frame_us_arr = []
    // seed mix — keep int small (under M1_LCG_MOD) to avoid BigInt growth
    let s = seed
    if s < 0 { s = 0 - s }
    if s < 0 { s = 1 }
    s = (s * 2654435761) % M1_LCG_MOD
    if s < 0 { s = s + M1_LCG_MOD }
    if s == 0 { s = 1 }
    let i = 0
    let stutter_count = 0
    while i < M1_FRAMES_PER_SCENARIO {
        s = m1_lcg_next(s)
        let bucket = s % 100
        let frame_us = 0
        if bucket < 90 {
            // 90% — 14000..19000μs (5000 range)
            frame_us = 14000 + (s % 5000)
        }
        if bucket >= 90 && bucket < 98 {
            // 8% — 19000..28000μs (mild jitter)
            frame_us = 19000 + (s % 9000)
        }
        if bucket >= 98 {
            // 2% — 28000..40000μs (stutter)
            frame_us = 28000 + (s % 12000)
        }
        if frame_us > 16667 {
            stutter_count = stutter_count + 1
        }
        frame_us_arr = frame_us_arr + [frame_us]
        i = i + 1
    }

    // own 2 — emit per-run summary events (frame_tick + heap_sample + pso_compiled).
    //   one of each per synthetic_measure call (instead of 200/5/3) — avoids the
    //   exec()/write_file storm that hits docker 4g ceiling across median_of_3
    //   loops.  Real measurement uses r0_heap_sample + r0_hud_parser per-frame.
    s = m1_lcg_next(s)
    r0_emit("frame_tick",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"n_frames\":" + to_string(M1_FRAMES_PER_SCENARIO)
        + ",\"sample_frame_us\":" + to_string(14000 + (s % 5000)))

    s = m1_lcg_next(s)
    r0_emit("heap_sample",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"peak_mb\":" + to_string(1500 + (s % 800)))

    s = m1_lcg_next(s)
    r0_emit("pso_compiled",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"compile_ms\":" + to_string(2 + (s % 28)))

    // metrics
    let frametime_p50_us = m1_percentile(frame_us_arr, 50)
    let frametime_p99_us = m1_percentile(frame_us_arr, 99)
    let avg_us = m1_avg_int(frame_us_arr)
    let fps_avg = 0
    if avg_us > 0 { fps_avg = 1000000 / avg_us }
    let fps_p99 = 0
    if frametime_p99_us > 0 { fps_p99 = 1000000 / frametime_p99_us }

    return [fps_avg, fps_p99, frametime_p50_us, frametime_p99_us, stutter_count]
}

// ───────────────────────────────────────────────────────────────────────────
// real measurement — PID 받아서 instrumentation start + duration 후 stop.
// stage1 에서는 R0 sampling tick 만 driver 로 wrap.  실제 frame instrumentation
// 은 r0_hud_parser / r0_heap_sample 가 담당 — 여기선 wrapper.
// ───────────────────────────────────────────────────────────────────────────

fn real_measure(game: str, scenario: str, pid: int, duration_sec: int) -> array {
    // 안전: PID alive 인지 체크.  죽었으면 즉시 panic 대신 0 array 반환 (caller 가 fallback 결정).
    let alive = exec("kill -0 " + to_string(pid) + " 2>/dev/null && echo ok").trim()
    if alive != "ok" {
        r0_emit("m1_baseline_real_skip",
            "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
            + "\",\"pid\":" + to_string(pid) + ",\"reason\":\"pid_not_alive\"")
        return [0, 0, 0, 0, 0]
    }

    r0_emit("m1_baseline_real_start",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"pid\":" + to_string(pid) + ",\"duration_sec\":" + to_string(duration_sec))

    // stage1 high-precision timer 부재 — sleep N second 만.  duration_sec >= 1 보장.
    let d = duration_sec
    if d < 1 { d = 1 }
    let _ = exec("sleep " + to_string(d))

    r0_emit("m1_baseline_real_stop",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"pid\":" + to_string(pid))

    // 실제 frame_us 수집은 r0_hud_parser session JSONL 에서 grep — stage1 에서는
    // synthetic 결과로 fallback (real-game frame parser 는 후속 sprint).
    return synthetic_measure(game, scenario, pid)
}

// ───────────────────────────────────────────────────────────────────────────
// median of 3 runs — runs[i] = [fps_avg, fps_p99, ftp50, ftp99, stutter]
// 각 column 별 median 추출 → 5-tuple.
// ───────────────────────────────────────────────────────────────────────────

fn median_of_3(runs: array) -> array {
    if len(runs) != 3 {
        panic("m1_baseline FAIL [median_of_3] expected=3 got=" + to_string(len(runs)))
    }
    let cols = 5
    let out = []
    let c = 0
    while c < cols {
        let col_vals = [runs[0][c], runs[1][c], runs[2][c]]
        out = out + [m1_median_int(col_vals)]
        c = c + 1
    }
    return out
}

// ───────────────────────────────────────────────────────────────────────────
// CSV 기록 — game_scenario_results.csv 에 append (header 자동 생성)
// ───────────────────────────────────────────────────────────────────────────

fn m1_ensure_csv() -> void {
    let _ = exec("mkdir -p '" + M1_BASELINE_DIR + "'")
    let exists = exec("test -f '" + M1_SUMMARY_CSV + "' && echo ok").trim()
    if exists != "ok" {
        write_file(M1_SUMMARY_CSV, M1_CSV_HEADER + "\n")
    }
}

fn record_baseline(game: str, scenario: str, results: array) -> void {
    if len(results) != 5 {
        panic("m1_baseline FAIL [record_baseline shape] expected=5 got=" + to_string(len(results)))
    }
    m1_ensure_csv()
    // run column = "median" (median of 3 runs).  Per-run rows can be added by
    // caller iterating with explicit run index — keeping write API single-row.
    let row = game + "," + scenario + ",median,"
        + to_string(results[0]) + ","
        + to_string(results[1]) + ","
        + to_string(results[2]) + ","
        + to_string(results[3]) + ","
        + to_string(results[4]) + "\n"
    let tmp = M1_SUMMARY_CSV + ".emit.tmp"
    write_file(tmp, row)
    let _ = exec("cat '" + tmp + "' >> '" + M1_SUMMARY_CSV + "' && rm -f '" + tmp + "'")

    r0_emit("m1_baseline_record",
        "\"game\":\"" + game + "\",\"scenario\":\"" + scenario
        + "\",\"fps_avg\":" + to_string(results[0])
        + ",\"fps_p99\":" + to_string(results[1])
        + ",\"frametime_p50_us\":" + to_string(results[2])
        + ",\"frametime_p99_us\":" + to_string(results[3])
        + ",\"stutter_count\":" + to_string(results[4]))
}

fn baseline_summary() -> str {
    m1_ensure_csv()
    let s = exec("cat '" + M1_SUMMARY_CSV + "' 2>/dev/null")
    return s
}

// ───────────────────────────────────────────────────────────────────────────
// self_test
// ───────────────────────────────────────────────────────────────────────────

fn self_test() -> void {
    let sid = "m1base-" + exec("date +%s").trim()
    r0_session_set(sid)

    // 1. baseline dir reset (idempotent — wipe summary CSV only, keep dir)
    let _ = exec("mkdir -p '" + M1_BASELINE_DIR + "'")
    let _rm = exec("rm -f '" + M1_SUMMARY_CSV + "'")
    let dir = baseline_dir()
    let dir_ok = exec("test -d '" + M1_BASELINE_DIR + "' && echo ok").trim()
    if dir_ok != "ok" {
        panic("m1_baseline FAIL [baseline_dir] dir not created: " + dir)
    }

    // 2. d2r catalog — 5 시나리오
    let d2r = d2r_scenarios()
    if len(d2r) != 5 {
        panic("m1_baseline FAIL [d2r catalog] expected=5 got=" + to_string(len(d2r)))
    }
    if d2r[0] != "campaign_act1" {
        panic("m1_baseline FAIL [d2r[0]] expected=campaign_act1 got=" + d2r[0])
    }

    // 3. d4 catalog — 5 시나리오
    let d4 = d4_scenarios()
    if len(d4) != 5 {
        panic("m1_baseline FAIL [d4 catalog] expected=5 got=" + to_string(len(d4)))
    }
    if d4[0] != "open_world_fractured_peaks" {
        panic("m1_baseline FAIL [d4[0]] expected=open_world_fractured_peaks got=" + d4[0])
    }

    // 4. synthetic_measure — single run (seed=42)
    let r1 = synthetic_measure("d2r", "campaign_act1", 42)
    if len(r1) != 5 {
        panic("m1_baseline FAIL [synthetic shape] expected=5 got=" + to_string(len(r1)))
    }
    let fps_avg = r1[0]
    let fps_p99 = r1[1]
    let ftp50   = r1[2]
    let ftp99   = r1[3]
    let stut    = r1[4]
    if fps_avg <= 0 {
        panic("m1_baseline FAIL [synthetic fps_avg<=0] got=" + to_string(fps_avg))
    }
    // P50 ≥ 14000μs (synthetic distribution 하한)
    if ftp50 < 14000 {
        panic("m1_baseline FAIL [synthetic ftp50 too low] got=" + to_string(ftp50))
    }
    // P99 ≥ P50
    if ftp99 < ftp50 {
        panic("m1_baseline FAIL [synthetic p99<p50] p50=" + to_string(ftp50) + " p99=" + to_string(ftp99))
    }
    // stutter ∈ [0, 200]
    if stut < 0 || stut > 200 {
        panic("m1_baseline FAIL [synthetic stutter out of range] got=" + to_string(stut))
    }
    // emit 1
    r0_emit("m1_baseline_synthetic",
        "\"game\":\"d2r\",\"scenario\":\"campaign_act1\",\"seed\":42"
        + ",\"fps_avg\":" + to_string(fps_avg)
        + ",\"fps_p99\":" + to_string(fps_p99)
        + ",\"ftp50\":" + to_string(ftp50)
        + ",\"ftp99\":" + to_string(ftp99)
        + ",\"stutter\":" + to_string(stut))

    // 5. unused — same emit as item 4 ensures #1 emit is the synthetic result.

    // 6. 3회 synthetic + median_of_3
    let r_a = synthetic_measure("d2r", "campaign_act1", 42)
    let r_b = synthetic_measure("d2r", "campaign_act1", 43)
    let r_c = synthetic_measure("d2r", "campaign_act1", 44)
    let med = median_of_3([r_a, r_b, r_c])
    if len(med) != 5 {
        panic("m1_baseline FAIL [median_of_3 shape] expected=5 got=" + to_string(len(med)))
    }
    // sanity — median fps_avg must be in [min, max] of three runs
    let lo = r_a[0]
    let hi = r_a[0]
    if r_b[0] < lo { lo = r_b[0] }
    if r_c[0] < lo { lo = r_c[0] }
    if r_b[0] > hi { hi = r_b[0] }
    if r_c[0] > hi { hi = r_c[0] }
    if med[0] < lo || med[0] > hi {
        panic("m1_baseline FAIL [median fps not in range] med=" + to_string(med[0])
            + " lo=" + to_string(lo) + " hi=" + to_string(hi))
    }
    // emit 2
    r0_emit("m1_baseline_median3",
        "\"med_fps_avg\":" + to_string(med[0])
        + ",\"med_fps_p99\":" + to_string(med[1])
        + ",\"med_ftp50\":" + to_string(med[2])
        + ",\"med_ftp99\":" + to_string(med[3])
        + ",\"med_stutter\":" + to_string(med[4]))

    // 7. record_baseline → CSV append
    record_baseline("d2r", "campaign_act1", med)
    // emit a second record for D4 to populate ≥ 2 rows
    let r_d4_a = synthetic_measure("d4", "zone_transition", 100)
    let r_d4_b = synthetic_measure("d4", "zone_transition", 101)
    let r_d4_c = synthetic_measure("d4", "zone_transition", 102)
    let med_d4 = median_of_3([r_d4_a, r_d4_b, r_d4_c])
    record_baseline("d4", "zone_transition", med_d4)

    // 8. baseline_summary — CSV with header + N rows (≥2)
    let summary = baseline_summary()
    if summary == "" {
        panic("m1_baseline FAIL [summary empty]")
    }
    let line_cnt = to_int(exec("wc -l < '" + M1_SUMMARY_CSV + "' | tr -d ' '").trim())
    if line_cnt < 3 {
        // 1 header + 2 rows = 3 lines minimum
        panic("m1_baseline FAIL [summary line count] expected>=3 got=" + to_string(line_cnt))
    }
    // header sanity
    let header_line = exec("head -1 '" + M1_SUMMARY_CSV + "'").trim()
    if header_line != M1_CSV_HEADER {
        panic("m1_baseline FAIL [csv header mismatch] got=" + header_line)
    }
    // emit 3
    r0_emit("m1_baseline_summary",
        "\"line_cnt\":" + to_string(line_cnt) + ",\"path\":\"" + M1_SUMMARY_CSV + "\"")

    // total scenarios cataloged = D2R 5 + D4 5 = 10
    let total_scenarios = len(d2r) + len(d4)
    if total_scenarios != 10 {
        panic("m1_baseline FAIL [total scenarios] expected=10 got=" + to_string(total_scenarios))
    }
    // emit 4
    r0_emit("m1_baseline_catalog",
        "\"d2r_count\":" + to_string(len(d2r))
        + ",\"d4_count\":" + to_string(len(d4))
        + ",\"total\":" + to_string(total_scenarios))

    // 9. cleanup — keep CSV (production artifact); only verify session emit count.
    //    Expected emits during self_test:
    //      synthetic_measure: 4 frame_tick (i=0,50,100,150) + 5 heap_sample + 3 pso_compiled
    //                       = 12 events × 7 calls (1 + 3 + 3) = 84
    //      m1_baseline_synthetic = 1
    //      m1_baseline_median3   = 1
    //      m1_baseline_record    = 2
    //      m1_baseline_summary   = 1
    //      m1_baseline_catalog   = 1
    //      total ≥ 90 (≥ 4 satisfied many times over)
    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 4 {
        panic("m1_baseline FAIL [emit count<4] got=" + to_string(emit_cnt))
    }

    // 10. PASS banner
    println("  ✅ m1_baseline self_test PASS (synthetic 3 runs + median + 10 scenarios cataloged, sid=" + sid + ")")
}

// ───────────────────────────────────────────────────────────────────────────
// main — CLI dispatch
// ───────────────────────────────────────────────────────────────────────────

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "scenarios" {
            // scenarios <d2r|d4>
            if len(a) >= 4 {
                let g = a[3]
                let xs = []
                let known = false
                if g == "d2r" { xs = d2r_scenarios() known = true }
                if g == "d4" { xs = d4_scenarios() known = true }
                if !known {
                    println("usage: scenarios <d2r|d4>")
                    return
                }
                let i = 0
                while i < len(xs) {
                    println(xs[i])
                    i = i + 1
                }
                return
            }
        }
        if sub == "synthetic" {
            // synthetic <game> <scenario> <seed>
            if len(a) >= 6 {
                let r = synthetic_measure(a[3], a[4], to_int(a[5]))
                println("fps_avg=" + to_string(r[0])
                    + " fps_p99=" + to_string(r[1])
                    + " frametime_p50_us=" + to_string(r[2])
                    + " frametime_p99_us=" + to_string(r[3])
                    + " stutter=" + to_string(r[4]))
                return
            }
            println("usage: synthetic <game> <scenario> <seed>")
            return
        }
        if sub == "summary" {
            let s = baseline_summary()
            println(s)
            return
        }
        if sub == "dir" {
            println(baseline_dir())
            return
        }
    }
    println("usage: hexa run m1_baseline.hexa { self-test | scenarios <d2r|d4> | synthetic <game> <scenario> <seed> | summary | dir }")
}
