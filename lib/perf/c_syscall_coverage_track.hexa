// lib/perf/c_syscall_coverage_track.hexa — CN-99 skeleton manjeom 15/15
//
// Phase 1 i386 syscall coverage — Battle.net-Setup 가 호출하는 syscall 의
// 매핑 진척률 추적.
//
// 무기: syscall × frequency table + columnar (per-syscall hit count).
// 효과: 미매핑 syscall 즉시 발견 → 매핑 추가 우선순위 결정.

use "./r0_common"

let CSCT_DIR = GAMEBOX_HOME + "/persist/syscall_coverage"
let SYS_LOG = CSCT_DIR + "/syscalls.tsv"

fn csct_dir() -> str { return CSCT_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CSCT_DIR + "'")
}

fn record_syscall(num: int, name: str, mapped: bool, hit_count: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + SYS_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v n=" + to_string(num) + " '$1!=n' '" + SYS_LOG + "' > '" + SYS_LOG + ".tmp' && mv '" + SYS_LOG + ".tmp' '" + SYS_LOG + "'")
    }
    let m = "0"
    if mapped { m = "1" }
    let line = to_string(num) + "\t" + name + "\t" + m + "\t" + to_string(hit_count)
    let tmp = SYS_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SYS_LOG + "' && rm -f '" + tmp + "'")
    if mapped {
        r0_emit("syscall_mapped", "\"num\":" + to_string(num) + ",\"name\":\"" + name + "\",\"hits\":" + to_string(hit_count))
    } else {
        r0_emit("syscall_unmapped", "\"num\":" + to_string(num) + ",\"name\":\"" + name + "\"")
    }
}

fn syscall_count() -> int {
    let exists = exec("test -f '" + SYS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + SYS_LOG + "' | tr -d ' '").trim())
}

fn mapped_count() -> int {
    let exists = exec("test -f '" + SYS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$3==1' '" + SYS_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn unmapped_count() -> int {
    return syscall_count() - mapped_count()
}

fn coverage_pct() -> int {
    let t = syscall_count()
    if t == 0 { return 0 }
    return mapped_count() * 100 / t
}

fn total_hits() -> int {
    let exists = exec("test -f '" + SYS_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + SYS_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_csct() -> void {
    let _ = exec("rm -rf '" + CSCT_DIR + "'")
}

fn self_test() -> void {
    let sid = "csct-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_csct()

    record_syscall(0x55, "NtCreateFile", true, 50)
    record_syscall(0x52, "NtReadFile", true, 200)
    record_syscall(0x57, "NtWriteFile", true, 100)
    record_syscall(0x05, "NtClose", true, 80)
    record_syscall(0x07, "NtMapViewOfSection", true, 30)
    record_syscall(0x18, "NtAllocateVirtualMemory", true, 60)
    record_syscall(0xa0, "NtUnknownSyscall", false, 5)
    record_syscall(0xb1, "NtAnotherUnknown", false, 2)

    let total = syscall_count()
    if total != 8 { panic("c_syscall_coverage_track FAIL [total] expected=8 got=" + to_string(total)) }

    let mapped = mapped_count()
    if mapped != 6 { panic("c_syscall_coverage_track FAIL [mapped] expected=6 got=" + to_string(mapped)) }

    let unmap = unmapped_count()
    if unmap != 2 { panic("c_syscall_coverage_track FAIL [unmapped] expected=2 got=" + to_string(unmap)) }

    let pct = coverage_pct()
    if pct != 75 { panic("c_syscall_coverage_track FAIL [pct] expected=75 got=" + to_string(pct)) }

    let hits = total_hits()
    if hits != 527 { panic("c_syscall_coverage_track FAIL [hits] expected=527 got=" + to_string(hits)) }

    r0_emit("syscall_coverage_summary", "\"total\":" + to_string(total) + ",\"mapped\":" + to_string(mapped) + ",\"pct\":" + to_string(pct))

    let cnt = r0_session_count(sid)
    if cnt < 8 { panic("c_syscall_coverage_track FAIL [emit] got=" + to_string(cnt)) }

    cleanup_csct()

    println("  ✅ c_syscall_coverage_track self_test PASS (8 syscalls, 6 mapped 75%, 527 hits, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 7 {
            let m = a[5] == "1"
            record_syscall(to_int(a[3]), a[4], m, to_int(a[6]))
            println("recorded")
            return
        }
        if sub == "stats" {
            println("total=" + to_string(syscall_count()) + " mapped=" + to_string(mapped_count()) + " pct=" + to_string(coverage_pct()) + "% hits=" + to_string(total_hits()))
            return
        }
        if sub == "cleanup" { cleanup_csct(); println("cleaned"); return }
    }
    println("usage: hexa run c_syscall_coverage_track.hexa { self-test | set <num> <name> <mapped0_1> <hits> | stats | cleanup }")
}
