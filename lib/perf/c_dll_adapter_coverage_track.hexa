// lib/perf/c_dll_adapter_coverage_track.hexa — CN-94 skeleton manjeom 15/15
//
// Phase 1 DLL adapter coverage — 18 adapters × 함수 수 / 알려진 IAT 함수.
// adapter 구현 진척률 (kernel32 100%, shell32 80%, etc).
//
// 무기: adapter table + columnar (DLL × known × implemented).
// 효과: closure path B Phase 1 의 adapter 진척 시각화.

use "./r0_common"

let CDAC_DIR = GAMEBOX_HOME + "/persist/dll_adapter_coverage"
let ADAPT_LOG = CDAC_DIR + "/adapters.tsv"

fn cdac_dir() -> str { return CDAC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CDAC_DIR + "'")
}

fn adapters() -> array {
    return ["kernel32", "ntdll", "msvcrt", "user32", "gdi32", "shell32", "advapi32", "ws2_32", "wininet", "crypt32", "rpcrt4", "ole32", "oleaut32", "wintrust", "version", "msimg32", "uiautomationcore", "winsock"]
}

fn record_adapter(name: str, known: int, implemented: int) -> void {
    ensure_dir()
    let exists = exec("test -f '" + ADAPT_LOG + "' && echo ok").trim()
    if exists == "ok" {
        let _ = exec("awk -F'\\t' -v n='" + name + "' '$1!=n' '" + ADAPT_LOG + "' > '" + ADAPT_LOG + ".tmp' && mv '" + ADAPT_LOG + ".tmp' '" + ADAPT_LOG + "'")
    }
    let pct = 0
    if known > 0 { pct = implemented * 100 / known }
    let line = name + "\t" + to_string(known) + "\t" + to_string(implemented) + "\t" + to_string(pct)
    let tmp = ADAPT_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + ADAPT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("dll_adapter", "\"dll\":\"" + name + "\",\"impl\":" + to_string(implemented) + ",\"pct\":" + to_string(pct))
}

fn adapter_count() -> int {
    let exists = exec("test -f '" + ADAPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + ADAPT_LOG + "' | tr -d ' '").trim())
}

fn total_known() -> int {
    let exists = exec("test -f '" + ADAPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + ADAPT_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn total_implemented() -> int {
    let exists = exec("test -f '" + ADAPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + ADAPT_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn overall_pct() -> int {
    let k = total_known()
    if k == 0 { return 0 }
    return total_implemented() * 100 / k
}

fn weakest_adapter() -> str {
    let exists = exec("test -f '" + ADAPT_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let r = exec("sort -t '\t' -k4 -n '" + ADAPT_LOG + "' | head -1 | awk -F'\\t' '{print $1\"@\"$4\"%\"}'").trim()
    return r
}

fn cleanup_cdac() -> void {
    let _ = exec("rm -rf '" + CDAC_DIR + "'")
}

fn self_test() -> void {
    let sid = "cdac-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cdac()

    let a = adapters()
    if len(a) != 18 { panic("c_dll_adapter_coverage_track FAIL [adapters] expected=18 got=" + to_string(len(a))) }

    // 현재 실 상태 (cycle 38 시점)
    record_adapter("kernel32", 100, 95)        // 95%
    record_adapter("kernel32_extras", 50, 45)
    record_adapter("ntdll", 30, 7)             // 23%
    record_adapter("msvcrt", 50, 12)
    record_adapter("user32", 60, 30)
    record_adapter("gdi32", 40, 6)
    record_adapter("shell32", 30, 8)           // 27%
    record_adapter("advapi32", 25, 6)
    record_adapter("ws2_32", 20, 10)
    record_adapter("wininet", 15, 11)          // 73%
    record_adapter("crypt32", 25, 18)          // 72%
    record_adapter("rpcrt4", 10, 3)
    record_adapter("ole32", 5, 3)
    record_adapter("oleaut32", 8, 4)
    record_adapter("wintrust", 3, 1)
    record_adapter("version", 5, 3)
    record_adapter("msimg32", 2, 1)
    record_adapter("uiautomationcore", 10, 5)

    let cnt = adapter_count()
    if cnt != 18 { panic("c_dll_adapter_coverage_track FAIL [count] expected=18 got=" + to_string(cnt)) }

    let pct = overall_pct()
    if pct < 30 || pct > 60 { panic("c_dll_adapter_coverage_track FAIL [overall pct] got=" + to_string(pct)) }

    let weakest = weakest_adapter()
    if weakest == "" { panic("c_dll_adapter_coverage_track FAIL [weakest empty]") }

    r0_emit("dll_adapter_summary", "\"adapters\":" + to_string(cnt) + ",\"overall_pct\":" + to_string(pct) + ",\"weakest\":\"" + weakest + "\"")

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 18 { panic("c_dll_adapter_coverage_track FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic DLL adapter coverage round-trip (Track BQ — c_dll_* family completion 100% — partial 유지) ───
    //
    // Track BQ mission: c_dll_* family completion 100% — c_dll_adapter_coverage_track
    // 측 PE DLL adapter implementation coverage synthetic round-trip. Coverage
    // lifecycle (probe_known_count → tally_implemented → compute_pct → audit_weakest)
    // 측 spec freeze. PE x64 loader Phase 1 adapter closure transitive
    // (long-horizon production smoke), Wine 의존 0 (hexa-only synthetic), met 승격 X.
    //
    // (a) synthetic 4-phase DLL adapter coverage pipeline —
    //     probe_known_count → tally_implemented → compute_pct → audit_weakest:
    //     phase_count               4
    //     dll_adapter_off           0x140174000         (synthetic DLL adapter coverage RVA)
    //     pipeline_kind             "synthetic_inline"  (실 PE DLL adapter dispatch 호출 X)
    //
    // (b) synthetic adapter × coverage_band 16-slot coverage matrix —
    //     4 adapter_kind (sys/net/sec/util) × 4 coverage_band (red/yellow/green/full) = 16 slots:
    //     slot_total                16
    //     hot_slot_count            4                   (coverage_band = green, hot path)
    //     cold_slot_count           12                  (red/yellow/full cold)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_coverage_phase(scaffold) → walk_coverage_matrix(scaffold).
    //              hexa-native loop only — 실 PE adapter dispatch 0, real Wine call 0.
    //
    // synthetic DLL adapter coverage phase emit
    r0_emit("c_dll_adapter_coverage_track_synthetic_phase",
        "\"stage\":\"adapter_coverage_phase\",\"phase_count\":4,\"dll_adapter_off\":\"0x140174000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"engine_gap\":\"PE x64 loader Phase 1 adapter closure transitive — long-horizon production smoke gate\"")
    println("__DLL_ADAPTER__ PARTIAL adapter_coverage_phase")

    // synthetic adapter × coverage_band coverage matrix emit
    r0_emit("c_dll_adapter_coverage_track_synthetic_matrix",
        "\"stage\":\"coverage_matrix\",\"slot_total\":16,\"hot_slot_count\":4,\"cold_slot_count\":12,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"engine_gap\":\"PE x64 loader Phase 1 adapter closure transitive — long-horizon production smoke gate\"")
    println("__DLL_ADAPTER__ PARTIAL coverage_matrix")

    cleanup_cdac()

    println("  ✅ c_dll_adapter_coverage_track self_test PASS (18 adapters, overall=" + to_string(pct) + "%, weakest=" + weakest + ", emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "set" && len(a) >= 6 {
            record_adapter(a[3], to_int(a[4]), to_int(a[5]))
            println("recorded")
            return
        }
        if sub == "stats" {
            println("adapters=" + to_string(adapter_count()) + " known=" + to_string(total_known()) + " impl=" + to_string(total_implemented()) + " pct=" + to_string(overall_pct()) + "% weakest=" + weakest_adapter())
            return
        }
        if sub == "cleanup" { cleanup_cdac(); println("cleaned"); return }
    }
    println("usage: hexa run c_dll_adapter_coverage_track.hexa { self-test | set <dll> <known> <impl> | stats | cleanup }")
}
