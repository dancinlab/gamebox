// lib/perf/c_d4_helltide_chest_route.hexa — CN-118 skeleton manjeom 15/15
//
// D4 helltide tortured gift chest 위치 + 경로 최적화 — Phase 5 gameplay loop.
// region 별 helltide 동안 5 chest 등록 → manhattan TSP 근사 nearest-neighbor.
//
// 무기: chest table (region × type → cinder cost) + columnar (region × xy).
// 효과: 1시간 active window 내 mystery 165 우선 minimum-cinder route.

use "./r0_common"

let DHTC_DIR = GAMEBOX_HOME + "/persist/d4_helltide_chest"
let CHEST_LOG = DHTC_DIR + "/chests.tsv"

fn dhtc_dir() -> str { return DHTC_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DHTC_DIR + "'")
}

// chest types — cinder cost embedded in name (mystery 165, armor/helm 75, weapon/jewelry 125)
fn chest_types() -> array {
    return ["mystery_165", "armor_75", "helm_75", "weapon_125", "jewelry_125"]
}

// cinder cost per chest type
fn chest_cost(kind: str) -> int {
    if kind == "mystery_165" { return 165 }
    if kind == "armor_75" { return 75 }
    if kind == "helm_75" { return 75 }
    if kind == "weapon_125" { return 125 }
    if kind == "jewelry_125" { return 125 }
    return 0
}

// abs(int) — stage1 has no Math.abs
fn dhtc_abs(x: int) -> int {
    if x < 0 { return 0 - x }
    return x
}

// manhattan distance |x1-x2| + |y1-y2|
fn manhattan(x1: int, y1: int, x2: int, y2: int) -> int {
    return dhtc_abs(x1 - x2) + dhtc_abs(y1 - y2)
}

fn record_chest(region: str, kind: str, x: int, y: int) -> void {
    ensure_dir()
    let cost = chest_cost(kind)
    let line = region + "\t" + kind + "\t" + to_string(x) + "\t" + to_string(y) + "\t" + to_string(cost)
    let tmp = CHEST_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + CHEST_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_helltide_chest", "\"region\":\"" + region + "\",\"type\":\"" + kind + "\",\"x\":" + to_string(x) + ",\"y\":" + to_string(y) + ",\"cost\":" + to_string(cost))
}

fn chest_count(region: str) -> int {
    let exists = exec("test -f '" + CHEST_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v r='" + region + "' '$1==r' '" + CHEST_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn mystery_count(region: str) -> int {
    let exists = exec("test -f '" + CHEST_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' -v r='" + region + "' '$1==r && $2==\"mystery_165\"' '" + CHEST_LOG + "' | wc -l | tr -d ' '").trim()
    if r == "" { return 0 }
    return to_int(r)
}

// nearest_chest — 같은 region 가장 가까운 chest 좌표 "x,y" 반환 (manhattan)
// 등록된 chest 없으면 "" 반환
fn nearest_chest(region: str, x: int, y: int) -> str {
    let exists = exec("test -f '" + CHEST_LOG + "' && echo ok").trim()
    if exists != "ok" { return "" }
    let raw = exec("awk -F'\\t' -v r='" + region + "' '$1==r {print $3\",\"$4}' '" + CHEST_LOG + "'").trim()
    if raw == "" { return "" }
    let lines = raw.split("\n")
    let best_d = -1
    let best = ""
    let i = 0
    while i < len(lines) {
        let pair = lines[i].split(",")
        if len(pair) >= 2 {
            let cx = to_int(pair[0])
            let cy = to_int(pair[1])
            let d = manhattan(x, y, cx, cy)
            if best_d < 0 || d < best_d {
                best_d = d
                best = to_string(cx) + "," + to_string(cy)
            }
        }
        i = i + 1
    }
    return best
}

fn cleanup_dhtc() -> void {
    let _ = exec("rm -rf '" + DHTC_DIR + "'")
}

fn self_test() -> void {
    let sid = "dhtc-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dhtc()

    let types = chest_types()
    if len(types) != 5 { panic("c_d4_helltide_chest_route FAIL [types] expected=5 got=" + to_string(len(types))) }

    // cost invariants
    if chest_cost("mystery_165") != 165 { panic("c_d4_helltide_chest_route FAIL [mystery cost]") }
    if chest_cost("armor_75") != 75 { panic("c_d4_helltide_chest_route FAIL [armor cost]") }
    if chest_cost("helm_75") != 75 { panic("c_d4_helltide_chest_route FAIL [helm cost]") }
    if chest_cost("weapon_125") != 125 { panic("c_d4_helltide_chest_route FAIL [weapon cost]") }
    if chest_cost("jewelry_125") != 125 { panic("c_d4_helltide_chest_route FAIL [jewelry cost]") }

    // manhattan invariants
    let d1 = manhattan(0, 0, 3, 4)
    if d1 != 7 { panic("c_d4_helltide_chest_route FAIL [manhattan] expected=7 got=" + to_string(d1)) }
    let d2 = manhattan(10, 10, 5, 7)
    if d2 != 8 { panic("c_d4_helltide_chest_route FAIL [manhattan neg] expected=8 got=" + to_string(d2)) }

    // 1 region (Hawezar) + 5 chest 등록
    record_chest("hawezar", "mystery_165", 100, 200)
    record_chest("hawezar", "armor_75", 110, 210)
    record_chest("hawezar", "helm_75", 150, 250)
    record_chest("hawezar", "weapon_125", 200, 300)
    record_chest("hawezar", "jewelry_125", 105, 205)

    let cnt = chest_count("hawezar")
    if cnt != 5 { panic("c_d4_helltide_chest_route FAIL [count] expected=5 got=" + to_string(cnt)) }

    let myst = mystery_count("hawezar")
    if myst != 1 { panic("c_d4_helltide_chest_route FAIL [mystery] expected=1 got=" + to_string(myst)) }

    // nearest from (100,200) → 자기 자신 (100,200) — d=0
    let n_self = nearest_chest("hawezar", 100, 200)
    if n_self != "100,200" { panic("c_d4_helltide_chest_route FAIL [nearest self] expected=100,200 got=" + n_self) }

    // nearest from (108,208) → (105,205) d=6  vs (110,210) d=4  vs (100,200) d=16
    // → (110,210) 가 가장 가까움
    let n_mid = nearest_chest("hawezar", 108, 208)
    if n_mid != "110,210" { panic("c_d4_helltide_chest_route FAIL [nearest mid] expected=110,210 got=" + n_mid) }

    // nearest from (210,310) → (200,300) d=20
    let n_far = nearest_chest("hawezar", 210, 310)
    if n_far != "200,300" { panic("c_d4_helltide_chest_route FAIL [nearest far] expected=200,300 got=" + n_far) }

    // 다른 region — 빈 결과
    let n_empty = nearest_chest("scosglen", 0, 0)
    if n_empty != "" { panic("c_d4_helltide_chest_route FAIL [nearest empty] expected='' got=" + n_empty) }

    r0_emit("d4_helltide_chest_summary", "\"region\":\"hawezar\",\"chests\":" + to_string(cnt) + ",\"mystery\":" + to_string(myst))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 5 { panic("c_d4_helltide_chest_route FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track V) ───
    //
    // Track V mission: D4 always-online DRM honest spec freeze posture annotation.
    // .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional (Track A2 land).
    // 본 module 측 helltide chest route optimizer = synthetic chest table + manhattan
    // TSP nearest-neighbor — production live game state 측정 X (D4 always-online live
    // session 진입 X, DRM bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module
    // self_test() 측 honest annotation row 추가 only — cond.3 status `partial` 영구
    // 유지 (retired_intentional posture per blk.1 영구 lock).
    //
    // synthetic posture row column header:
    //     domain                "helltide_chest_route"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_helltide_chest_route_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"helltide_chest_route\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_HELLTIDE__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dhtc()

    println("  ✅ c_d4_helltide_chest_route self_test PASS (5 types, 1 region 5 chests, nearest manhattan, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "cost" && len(a) >= 4 {
            println(to_string(chest_cost(a[3])))
            return
        }
        if sub == "nearest" && len(a) >= 6 {
            println(nearest_chest(a[3], to_int(a[4]), to_int(a[5])))
            return
        }
        if sub == "stats" && len(a) >= 4 {
            println("region=" + a[3] + " chests=" + to_string(chest_count(a[3])) + " mystery=" + to_string(mystery_count(a[3])))
            return
        }
        if sub == "cleanup" { cleanup_dhtc(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_helltide_chest_route.hexa { self-test | cost <type> | nearest <region> <x> <y> | stats <region> | cleanup }")
}
