// lib/perf/c_d4_helltide_event.hexa — CN-88 skeleton manjeom 15/15
//
// D4 helltide event window — Phase 5 gameplay loop.
// 매 2시간 15분 cycle 중 helltide active 1시간 → 정확한 시작 / 종료 예측.
//
// 무기: cycle table (period_s, active_s) + columnar (event × loot).
// 효과: helltide 자동 알림 — 시작 5분 전 trigger.

use "./r0_common"

let DHTE_DIR = GAMEBOX_HOME + "/persist/d4_helltide"
let EVENT_LOG = DHTE_DIR + "/events.tsv"

fn dhte_dir() -> str { return DHTE_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DHTE_DIR + "'")
}

fn cycle_period_s() -> int { return 8100 }   // 2h15m
fn active_window_s() -> int { return 3600 }  // 1h

// next start in seconds, given last_start
fn next_start(last_start: int, now: int) -> int {
    let elapsed = now - last_start
    let into_cycle = elapsed % cycle_period_s()
    return now + (cycle_period_s() - into_cycle)
}

fn is_active(last_start: int, now: int) -> bool {
    let elapsed = now - last_start
    let into_cycle = elapsed % cycle_period_s()
    return into_cycle < active_window_s()
}

fn record_event(start_ts: int, region: str, mob_kills: int, cinder: int) -> void {
    ensure_dir()
    let line = to_string(start_ts) + "\t" + region + "\t" + to_string(mob_kills) + "\t" + to_string(cinder)
    let tmp = EVENT_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + EVENT_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_helltide_event", "\"region\":\"" + region + "\",\"kills\":" + to_string(mob_kills) + ",\"cinder\":" + to_string(cinder))
}

fn event_count() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + EVENT_LOG + "' | tr -d ' '").trim())
}

fn total_cinder() -> int {
    let exists = exec("test -f '" + EVENT_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + EVENT_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_dhte() -> void {
    let _ = exec("rm -rf '" + DHTE_DIR + "'")
}

fn self_test() -> void {
    let sid = "dhte-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_dhte()

    if cycle_period_s() != 8100 { panic("c_d4_helltide_event FAIL [period]") }
    if active_window_s() != 3600 { panic("c_d4_helltide_event FAIL [active]") }

    // last_start=1000, now=1500 → into_cycle=500 → active (< 3600)
    if !is_active(1000, 1500) { panic("c_d4_helltide_event FAIL [active early]") }
    // last_start=1000, now=5000 → into_cycle=4000 → inactive (> 3600)
    if is_active(1000, 5000) { panic("c_d4_helltide_event FAIL [inactive mid]") }
    // wrap: last_start=1000, now=1000+8100+200 = 9300 → into_cycle=200 → active
    if !is_active(1000, 9300) { panic("c_d4_helltide_event FAIL [active wrap]") }

    let next1 = next_start(1000, 1500)  // 1000 + 8100 = 9100
    if next1 != 9100 { panic("c_d4_helltide_event FAIL [next] expected=9100 got=" + to_string(next1)) }

    record_event(1000, "fractured_peaks", 142, 350)
    record_event(9100, "scosglen", 180, 480)
    record_event(17200, "kehjistan", 130, 320)

    let cnt = event_count()
    if cnt != 3 { panic("c_d4_helltide_event FAIL [count] expected=3 got=" + to_string(cnt)) }

    let cind = total_cinder()
    if cind != 1150 { panic("c_d4_helltide_event FAIL [cinder] expected=1150 got=" + to_string(cind)) }

    r0_emit("d4_helltide_summary", "\"events\":" + to_string(cnt) + ",\"cinder\":" + to_string(cind))

    let emit_cnt = r0_session_count(sid)
    if emit_cnt < 3 { panic("c_d4_helltide_event FAIL [emit] got=" + to_string(emit_cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track AL) ───
    //
    // Track AL mission: extend Track V (7) + Track AJ (6) D4 retired_intentional posture
    // annotation to 6 additional c_d4_* modules (aspect_imprint_track + dungeon_sigil_
    // inventory + dxr_first_frame_trace + helltide_event + infernal_horde_wave + loot_
    // drop_predict). .roadmap.diablo4 blk.1 status_enum_adopted = retired_intentional
    // (Track A2 land 2026-05-03). 본 module 측 helltide world event cycle/cinder tracker
    // = synthetic event analyzer — production live game state 측정 X (D4 always-online
    // live session 진입 X, DRM bypass 0, Battle.net launcher 통과 X). 본 cycle 측 module
    // self_test() 측 honest annotation row 추가 only — cond.3 status `partial` 영구 유지
    // (retired_intentional posture per blk.1 영구 lock). pattern reference:
    //     lib/perf/c_d4_paragon_track.hexa (Track AJ predecessor, identical schema)
    //
    // synthetic posture row column header:
    //     domain                "helltide_event"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_helltide_event_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"helltide_event\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\"")
    println("__D4_HELLTIDE_EVENT__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_dhte()

    println("  ✅ c_d4_helltide_event self_test PASS (cycle 2h15m, active 1h, 3 events 1150 cinder, emits=" + to_string(emit_cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "active" && len(a) >= 5 {
            let r = is_active(to_int(a[3]), to_int(a[4]))
            if r { println("yes") } else { println("no") }
            return
        }
        if sub == "next" && len(a) >= 5 {
            println(to_string(next_start(to_int(a[3]), to_int(a[4]))))
            return
        }
        if sub == "stats" {
            println("events=" + to_string(event_count()) + " cinder=" + to_string(total_cinder()))
            return
        }
        if sub == "cleanup" { cleanup_dhte(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_helltide_event.hexa { self-test | active <last> <now> | next <last> <now> | stats | cleanup }")
}
