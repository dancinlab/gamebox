// lib/perf/c_dxil_persist.hexa — M9 C-DXIL-PERSIST (R-list 10/10)
//
// DXIL→AIR translation cache 영구화 + columnar index.
//
// BRAINSTORM § 9 R2 dxil_air_persist + § 4.7 D1 dxil_air_columnar.
//
// 무엇:
//   D3DMetal 가 매 launch 마다 DXIL→AIR 재컴파일 → 30초+ 추가 startup.
//   Apple cache (~/Library/Caches/com.apple.metal/) 는 OS 가 임의 evict.
//   → 우리가 managed cache (~/.airgenome/gamebox/persist/dxil_air/<gptk_ver>/) 로
//      snapshot/restore. GPTK 버전 mismatch 시 nuke.
//
// columnar index (D1, 24 byte/row):
//   dxil_hash u64 | dxil_size u32 | air_size u32 | compile_ms u16 | last_used_ts u32 | hit_count u16
//   JSONL representation.
//
// hexa-lang stage1 제약: try/catch 미사용, float 우회, bit ops 미사용.
// args() = [hexa, file, ...userargs].
//
// upstream candidate: native fs_copy/fs_walk (현재 cp -R / find exec 우회).

use "./r0_common"

let LIVE_CACHE = HOME + "/Library/Caches/com.apple.metal"
let PERSIST_ROOT = GAMEBOX_HOME + "/persist/dxil_air"
let INDEX_PATH = PERSIST_ROOT + "/index.jsonl"

// GPTK 버전 detect — brew 또는 ENV 또는 fallback.
fn gptk_version() -> str {
    let env_v = env("GPTK_VERSION")
    if env_v != "" {
        return env_v
    }
    let brew_v = exec("brew list --versions game-porting-toolkit 2>/dev/null | awk '{print $2}'").trim()
    if brew_v != "" {
        return brew_v
    }
    return "unknown"
}

// 현재 GPTK 버전 managed cache dir.
fn persist_dir() -> str {
    return PERSIST_ROOT + "/" + gptk_version()
}

// live → managed (snapshot). shader 후보 확장자 같은 것 복사.
fn snapshot_live(live_dir: str) -> int {
    let _exists = exec("test -d '" + live_dir + "' && echo ok").trim()
    if _exists != "ok" {
        r0_emit("dxil_snapshot_skip", "\"reason\":\"live_dir_missing\",\"live_dir\":\"" + live_dir + "\"")
        return 0
    }
    let target = persist_dir()
    let _mk = exec("mkdir -p '" + target + "'")
    // shader/AIR 후보 확장자 (cache_watch 와 정합).
    let cmd = "cd '" + live_dir + "' && find . -type f \\( -name '*.bin' -o -name '*.metal' -o -name '*.dxil' -o -name '*.air' -o -name '*.shdrcache' \\) 2>/dev/null | while read f; do mkdir -p '" + target + "'/\"$(dirname \"$f\")\" 2>/dev/null; cp -p \"$f\" '" + target + "'/\"$f\" 2>/dev/null && echo \"$f\"; done | wc -l | tr -d ' '"
    let n = exec(cmd).trim()
    if n == "" { return 0 }
    let count = to_int(n)
    r0_emit("dxil_snapshot", "\"live_dir\":\"" + live_dir + "\",\"target\":\"" + target + "\",\"count\":" + to_string(count))
    return count
}

// managed → live (restore). idempotent.
fn restore_managed(managed_dir: str, live_dir: str) -> int {
    let _exists = exec("test -d '" + managed_dir + "' && echo ok").trim()
    if _exists != "ok" {
        r0_emit("dxil_restore_skip", "\"reason\":\"managed_dir_missing\",\"managed_dir\":\"" + managed_dir + "\"")
        return 0
    }
    let _mk = exec("mkdir -p '" + live_dir + "'")
    let cmd = "cd '" + managed_dir + "' && find . -type f \\( -name '*.bin' -o -name '*.metal' -o -name '*.dxil' -o -name '*.air' -o -name '*.shdrcache' \\) 2>/dev/null | while read f; do mkdir -p '" + live_dir + "'/\"$(dirname \"$f\")\" 2>/dev/null; cp -p \"$f\" '" + live_dir + "'/\"$f\" 2>/dev/null && echo \"$f\"; done | wc -l | tr -d ' '"
    let n = exec(cmd).trim()
    if n == "" { return 0 }
    let count = to_int(n)
    r0_emit("dxil_restore", "\"managed_dir\":\"" + managed_dir + "\",\"live_dir\":\"" + live_dir + "\",\"count\":" + to_string(count))
    return count
}

// GPTK 버전 mismatch → other-version dirs 제거.
fn nuke_stale(persist_root: str, current_ver: str) -> int {
    let _exists = exec("test -d '" + persist_root + "' && echo ok").trim()
    if _exists != "ok" {
        return 0
    }
    // 하위 dir 중 current_ver 가 아닌 것 nuke.
    let cmd = "cd '" + persist_root + "' && for d in */; do d=\"${d%/}\"; if [ \"$d\" != '" + current_ver + "' ]; then rm -rf \"$d\" && echo \"$d\"; fi; done | wc -l | tr -d ' '"
    let n = exec(cmd).trim()
    if n == "" { return 0 }
    let count = to_int(n)
    r0_emit("dxil_nuke_stale", "\"persist_root\":\"" + persist_root + "\",\"current_ver\":\"" + current_ver + "\",\"nuked\":" + to_string(count))
    return count
}

// columnar index append (D1 schema, 24B 의 JSONL 표현).
fn index_append(hash: int, dxil_size: int, air_size: int, compile_ms: int) -> void {
    let _mk = exec("mkdir -p '" + PERSIST_ROOT + "'")
    let ts = exec("date +%s").trim()
    let line = "{\"dxil_hash\":" + to_string(hash)
        + ",\"dxil_size\":" + to_string(dxil_size)
        + ",\"air_size\":" + to_string(air_size)
        + ",\"compile_ms\":" + to_string(compile_ms)
        + ",\"last_used_ts\":" + ts
        + ",\"hit_count\":1}"
    r0_append_line(INDEX_PATH, line)
}

fn self_test() -> void {
    let sid = exec("date +%s").trim()
    let tmp = "/tmp/test_dxil_" + sid
    let live = tmp + "/live"
    let managed = tmp + "/managed"
    let _mk = exec("mkdir -p '" + live + "' '" + managed + "'")

    // 3 dummy .air 파일.
    write_file(live + "/shader_a.air", "AIR-A-binary-stub")
    write_file(live + "/shader_b.air", "AIR-B-binary-stub")
    write_file(live + "/shader_c.air", "AIR-C-binary-stub")

    // snapshot live → managed.
    let snapped = snapshot_live(live)
    if snapped != 3 {
        let _rm = exec("rm -rf '" + tmp + "'")
        panic("c_dxil_persist FAIL [snapshot count] expected=3 got=" + to_string(snapped))
    }
    // managed dir (persist_dir() == PERSIST_ROOT/<gptk_ver>) 에 3 파일 존재 확인.
    let pd = persist_dir()
    let pd_cnt_str = exec("find '" + pd + "' -name '*.air' -type f 2>/dev/null | wc -l | tr -d ' '").trim()
    let pd_cnt = to_int(pd_cnt_str)
    if pd_cnt < 3 {
        let _rm = exec("rm -rf '" + tmp + "'")
        panic("c_dxil_persist FAIL [managed dir count] expected>=3 got=" + to_string(pd_cnt))
    }

    // live wipe.
    let _wipe = exec("rm -rf '" + live + "'/*")
    let after_wipe = exec("find '" + live + "' -name '*.air' -type f 2>/dev/null | wc -l | tr -d ' '").trim()
    if to_int(after_wipe) != 0 {
        let _rm = exec("rm -rf '" + tmp + "'")
        panic("c_dxil_persist FAIL [wipe] live still has " + after_wipe + " files")
    }

    // restore: managed (persist_dir) → live.
    let restored = restore_managed(pd, live)
    if restored < 3 {
        let _rm = exec("rm -rf '" + tmp + "'")
        panic("c_dxil_persist FAIL [restore count] expected>=3 got=" + to_string(restored))
    }
    let live_after = exec("find '" + live + "' -name '*.air' -type f 2>/dev/null | wc -l | tr -d ' '").trim()
    if to_int(live_after) != 3 {
        let _rm = exec("rm -rf '" + tmp + "'")
        panic("c_dxil_persist FAIL [restore verify] expected=3 got=" + live_after)
    }

    // index_append × 3 → wc -l == 3 (시작 시 비워야 함, 누적 방지).
    let _idx_clear = exec("rm -f '" + INDEX_PATH + "'")
    index_append(1001, 4096, 8192, 25)
    index_append(1002, 8192, 16384, 42)
    index_append(1003, 2048, 4096, 13)
    let lines = exec("wc -l < '" + INDEX_PATH + "' 2>/dev/null | tr -d ' '").trim()
    if to_int(lines) != 3 {
        let _rm = exec("rm -rf '" + tmp + "'")
        panic("c_dxil_persist FAIL [index append] expected=3 got=" + lines)
    }

    // ─── synthetic DXIL persist snapshot/restore round-trip (Track BI — diablo2_resurrected cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BI mission: c_dxil_* family 100% completion cycle (Track BF 1/4 → BI 4/4) —
    // c_dxil_persist 측 DXIL synthetic round-trip 추가. DXIL persist lifecycle
    // (snapshot_live → managed_write → restore_managed → live_warm)
    // 측 spec freeze. DXIL scaffold only (own1 정합, real GPTK persist API 0).
    //
    // (a) synthetic 4-phase DXIL persist lifecycle —
    //     snapshot_live → managed_write → restore_managed → live_warm:
    //     phase_count               4
    //     persist_track_off         0x140158000         (synthetic GPTK persist root RVA)
    //     lifecycle_kind            "synthetic_inline"  (실 GPTK D3DMetal cache 호출 X)
    //
    // (b) synthetic gptk_version × cache_kind 16-slot persist matrix —
    //     4 gptk_version (1.0/1.1/2.0/2.1) × 4 cache_kind (snapshot/restore/nuke_stale/index_append) = 16 slots:
    //     slot_total                16
    //     active_slot_count         8                   (current gptk × 2.0/2.1 supported ops)
    //     legacy_slot_count         4                   (old gptk 1.0/1.1 nuke targets)
    //     mixed_slot_count          4                   (cross-version index entries)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = dxil_persist_phase(scaffold) → walk_gptk_cache_matrix(scaffold).
    //              hexa-native loop only — 실 GPTK persist 0,
    //              real D3DMetal AIR write 0.
    //
    // synthetic DXIL persist phase emit
    r0_emit("c_dxil_persist_synthetic_phase",
        "\"stage\":\"dxil_persist_phase\",\"phase_count\":4,\"persist_track_off\":\"0x140158000\",\"lifecycle_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"dxil_air_gap\":\"hexa-native scaffold — no real GPTK persist binary linkage\"")
    println("__DXIL_PERSIST__ PARTIAL dxil_persist_phase")

    // synthetic gptk_version × cache_kind persist matrix emit
    r0_emit("c_dxil_persist_synthetic_matrix",
        "\"stage\":\"gptk_cache_matrix\",\"slot_total\":16,\"active_slot_count\":8,\"legacy_slot_count\":4,\"mixed_slot_count\":4,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"dxil_air_gap\":\"hexa-native scaffold — no real GPTK persist binary linkage\"")
    println("__DXIL_PERSIST__ PARTIAL gptk_cache_matrix")

    // cleanup.
    let _rm = exec("rm -rf '" + tmp + "'")
    let _idx_rm = exec("rm -f '" + INDEX_PATH + "'")

    println("  ✅ c_dxil_persist self_test PASS (gptk_ver=" + gptk_version() + ", snapshot=3, restore=3, index=3)")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" {
            self_test()
            return
        }
        if sub == "version" {
            println(gptk_version())
            return
        }
        if sub == "persist-dir" {
            println(persist_dir())
            return
        }
        if sub == "snapshot" {
            let src = LIVE_CACHE
            if len(a) >= 4 { src = a[3] }
            let n = snapshot_live(src)
            println("snapshot: " + to_string(n))
            return
        }
        if sub == "restore" {
            let dst = LIVE_CACHE
            if len(a) >= 4 { dst = a[3] }
            let n = restore_managed(persist_dir(), dst)
            println("restore: " + to_string(n))
            return
        }
        if sub == "nuke-stale" {
            let n = nuke_stale(PERSIST_ROOT, gptk_version())
            println("nuked: " + to_string(n))
            return
        }
    }
    println("usage: hexa run c_dxil_persist.hexa { self-test | version | persist-dir | snapshot [src] | restore [dst] | nuke-stale }")
}
