// lib/perf/c_install_signature_verify.hexa — CN-140 skeleton manjeom 15/15
//
// Phase 1/3 install precondition — installer 의 Authenticode signature 검증.
// Battle.net-Setup.exe / Steam.exe / WeGame.exe / NCLauncher.exe 등 게임 installer 가
// 알려진 publisher cert (Blizzard / Valve / Tencent / NCSOFT / Microsoft) 의
// thumbprint 와 일치하는지 사전 확인 → 위변조/사칭 installer 사전 차단.
//
// 무기: known publisher table + thumbprint match + verify log.
// 효과: install 시작 전 untrusted PE 차단 → 악성 installer 로 인한 fan-out 손상 방어.

use "./r0_common"

let CISV_DIR = GAMEBOX_HOME + "/persist/install_signature_verify"
let VERIFY_LOG = CISV_DIR + "/verifies.tsv"

fn cisv_dir() -> str { return CISV_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + CISV_DIR + "'")
}

// ─── known publishers: [name, thumbprint_sha] ───
fn known_publishers() -> array {
    return [
        ["Blizzard",  "thumbprint_blizzard_sha"],
        ["Valve",     "thumbprint_valve_sha"],
        ["Tencent",   "thumbprint_tencent_sha"],
        ["NCSOFT",    "thumbprint_ncsoft_sha"],
        ["Microsoft", "thumbprint_ms_sha"]
    ]
}

// ─── thumbprint → known publisher 인지 ───
fn is_known_publisher(thumbprint: str) -> bool {
    if thumbprint == "" { return false }
    let pubs = known_publishers()
    let i = 0
    while i < len(pubs) {
        let p = pubs[i]
        if p[1] == thumbprint { return true }
        i = i + 1
    }
    return false
}

// ─── verify 기록 ───
fn record_verify(pe_name: str, publisher: str, thumbprint: str, ok: bool) -> void {
    ensure_dir()
    let ok_s = "fail"
    if ok { ok_s = "ok" }
    let line = pe_name + "\t" + publisher + "\t" + thumbprint + "\t" + ok_s
    let tmp = VERIFY_LOG + ".add"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + VERIFY_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("install_signature_verify", "\"pe\":\"" + pe_name + "\",\"publisher\":\"" + publisher + "\",\"thumbprint\":\"" + thumbprint + "\",\"status\":\"" + ok_s + "\"")
}

fn verify_count() -> int {
    let exists = exec("test -f '" + VERIFY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    return to_int(exec("wc -l < '" + VERIFY_LOG + "' | tr -d ' '").trim())
}

fn verified_count() -> int {
    let exists = exec("test -f '" + VERIFY_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let r = exec("awk -F'\\t' '$4==\"ok\"{c++} END{print c+0}' '" + VERIFY_LOG + "'").trim()
    if r == "" { return 0 }
    return to_int(r)
}

fn cleanup_cisv() -> void {
    let _ = exec("rm -rf '" + CISV_DIR + "'")
}

fn self_test() -> void {
    let sid = "cisv-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cisv()

    // known publisher table — 5 entries
    let pubs = known_publishers()
    if len(pubs) != 5 { panic("c_install_signature_verify FAIL [pubs] expected=5 got=" + to_string(len(pubs))) }

    // is_known_publisher: 5 known thumbprints
    if !is_known_publisher("thumbprint_blizzard_sha") { panic("c_install_signature_verify FAIL [Blizzard known]") }
    if !is_known_publisher("thumbprint_valve_sha")    { panic("c_install_signature_verify FAIL [Valve known]") }
    if !is_known_publisher("thumbprint_tencent_sha")  { panic("c_install_signature_verify FAIL [Tencent known]") }
    if !is_known_publisher("thumbprint_ncsoft_sha")   { panic("c_install_signature_verify FAIL [NCSOFT known]") }
    if !is_known_publisher("thumbprint_ms_sha")       { panic("c_install_signature_verify FAIL [MS known]") }

    // is_known_publisher: unknown / empty
    if is_known_publisher("thumbprint_evil_sha") { panic("c_install_signature_verify FAIL [evil known?]") }
    if is_known_publisher("")                    { panic("c_install_signature_verify FAIL [empty known?]") }

    // 5 PE 등록 — 3 known (Blizzard/Valve/Tencent) + 2 unknown (위변조 / 무서명)
    record_verify("Battle.net-Setup.exe", "Blizzard", "thumbprint_blizzard_sha", true)
    record_verify("Steam.exe",            "Valve",    "thumbprint_valve_sha",    true)
    record_verify("WeGameSetup.exe",      "Tencent",  "thumbprint_tencent_sha",  true)
    record_verify("FakeBattleNet.exe",    "Unknown",  "thumbprint_evil_sha",     false)
    record_verify("UnsignedInstaller.exe","",         "",                        false)

    let total = verify_count()
    if total != 5 { panic("c_install_signature_verify FAIL [total] expected=5 got=" + to_string(total)) }

    let ok_n = verified_count()
    if ok_n != 3 { panic("c_install_signature_verify FAIL [verified] expected=3 got=" + to_string(ok_n)) }

    r0_emit("install_signature_summary", "\"total\":" + to_string(total) + ",\"verified\":" + to_string(ok_n))

    let cnt = r0_session_count(sid)
    if cnt < 6 { panic("c_install_signature_verify FAIL [emit] got=" + to_string(cnt)) }

    // ─── synthetic install signature-verify state machine round-trip (Track-AR cond.3 EVIDENCE AUGMENT — partial 유지, cond.2 cross-link) ───
    //
    // Track-AR mission: battlenet cond.2 setup install phase + Phase 1 Battle.net-Setup.exe
    // 측 evidence augment cross-link. cond.3 status `partial` 영구 유지 — 실 Authenticode
    // signature WinVerifyTrust 측 cond.2 met (offline shim) territory, 본 cycle 측
    // cond.3 측 cross-link evidence augment 만 추가.
    //
    // synthetic verify state machine: PUBLISHER_LOOKUP → THUMBPRINT_MATCH
    // → CHAIN_VALIDATE → TRUST_VERDICT 4 transition. hexa-native loop only — 실 X.509
    // chain build 0, 실 Authenticode parse 0, 실 OCSP/CRL 0.
    // payload = verify_session_id + verify_step_kind + publisher_count_simulated.
    // round-trip emit = `__INSTALL_SIGVERIFY__ PARTIAL <state>` per row.
    //
    // own1: Wine 0 / WinVerifyTrust link 0 / X.509 chain build 0 / OCSP probe 0.
    // own2: PARTIAL emit explicit (NOT PASS — production smoke deferred).
    let sig_sid = "sig-synth-" + exec("date +%s").trim()

    println("__INSTALL_SIGVERIFY__ PARTIAL PUBLISHER_LOOKUP")
    r0_emit("c_install_signature_verify_synthetic_state",
        "\"stage\":\"signature_verify_state_machine\",\"verify_session_id\":\"" + sig_sid + "\",\"verify_step_kind\":\"PUBLISHER_LOOKUP\",\"publisher_count_simulated\":5,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"production_smoke_gap\":\"permanent_until_real_network — blk.1 transitive\"")

    println("__INSTALL_SIGVERIFY__ PARTIAL THUMBPRINT_MATCH")
    r0_emit("c_install_signature_verify_synthetic_state",
        "\"stage\":\"signature_verify_state_machine\",\"verify_session_id\":\"" + sig_sid + "\",\"verify_step_kind\":\"THUMBPRINT_MATCH\",\"publisher_count_simulated\":5,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__INSTALL_SIGVERIFY__ PARTIAL CHAIN_VALIDATE")
    r0_emit("c_install_signature_verify_synthetic_state",
        "\"stage\":\"signature_verify_state_machine\",\"verify_session_id\":\"" + sig_sid + "\",\"verify_step_kind\":\"CHAIN_VALIDATE\",\"publisher_count_simulated\":5,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    println("__INSTALL_SIGVERIFY__ PARTIAL TRUST_VERDICT")
    r0_emit("c_install_signature_verify_synthetic_state",
        "\"stage\":\"signature_verify_state_machine\",\"verify_session_id\":\"" + sig_sid + "\",\"verify_step_kind\":\"TRUST_VERDICT\",\"publisher_count_simulated\":5,\"transport_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\"")

    r0_emit("c_install_signature_verify_synthetic_round_trip_matrix",
        "\"states_total\":4,\"states_partial\":4,\"states_pass\":0,\"verify_session_id\":\"" + sig_sid + "\",\"transport_kind\":\"synthetic_inline\",\"network\":\"none\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"track\":\"AR\",\"lockin_iso\":\"2026-05-04\"")

    cleanup_cisv()

    println("  ✅ c_install_signature_verify self_test PASS (5 publishers, 5 PE registered, 3 verified / 2 rejected, +4 synthetic verify state PARTIAL transitions, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "verify" && len(a) >= 6 {
            let pe = a[3]
            let pub = a[4]
            let tp = a[5]
            let ok = is_known_publisher(tp)
            record_verify(pe, pub, tp, ok)
            let s = "fail"
            if ok { s = "ok" }
            println(pe + " publisher=" + pub + " thumbprint=" + tp + " " + s)
            return
        }
        if sub == "known" && len(a) >= 4 {
            if is_known_publisher(a[3]) { println("known") } else { println("unknown") }
            return
        }
        if sub == "stats" {
            println("total=" + to_string(verify_count()) + " verified=" + to_string(verified_count()))
            return
        }
        if sub == "cleanup" { cleanup_cisv(); println("cleaned"); return }
    }
    println("usage: hexa run c_install_signature_verify.hexa { self-test | verify <pe> <publisher> <thumbprint> | known <thumbprint> | stats | cleanup }")
}
