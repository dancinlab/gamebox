// lib/perf/c_nightreign_dx12_first_frame_co_op_variant.hexa — Track CM (Nightreign fan-out skeleton-tier).
//
// Elden Ring Nightreign DX12 first-frame co-op variant — synthetic scaffold for
// FromSoft Dantelion 2 engine first-frame timing in 3-player co-op session
// context. D3DMetal binary licence transitive blocker (loader_dx blk.1) +
// EAC anti-tamper inherited boundary. Skeleton-tier per Track BL/BM forensic;
// validated_manjeom = 0 (no real frame yet). Wine 0 own1 정합.
//
// own1: Wine 0 / DX12 emul 0 / FromSoft engine ext 0 / EAC bypass 0.
// own2: r0_emit ≥ 6 + RETIRED_INTENTIONAL posture explicit.
//
// frame_phase code:
//   1 = device_create     (D3D12 device + queue)
//   2 = swapchain_init    (swapchain create for co-op rendering)
//   3 = pso_warm          (PSO compile warm — Dantelion shaders inherited)
//   4 = first_present     (first DX12 swapchain Present)
//   5 = co_op_sync_render (3-player viewport sync render NEW for co-op)

use "./r0_common"

let CNDF_DIR = GAMEBOX_HOME + "/persist/c_nightreign_dx12_first_frame_co_op_variant"
let FRAME_LOG = CNDF_DIR + "/frames.tsv"

fn ensure_dir() -> void {
    let _ = exec("mkdir -p '" + CNDF_DIR + "'")
}

fn record_frame(frame_id: int, frame_phase: int, session_id: int, ms_to_present: int) -> void {
    if frame_phase < 1 || frame_phase > 5 {
        panic("c_nightreign_dx12_first_frame_co_op_variant FAIL [record] expected=phase in [1,5] got=" + to_string(frame_phase))
    }
    ensure_dir()
    let line = to_string(frame_id) + "\t" + to_string(frame_phase) + "\t" + to_string(session_id) + "\t" + to_string(ms_to_present)
    let tmp = FRAME_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + FRAME_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("cndf_record", "\"frame\":" + to_string(frame_id) + ",\"phase\":" + to_string(frame_phase) + ",\"session\":" + to_string(session_id) + ",\"ms\":" + to_string(ms_to_present))
}

fn frame_count() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + FRAME_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

fn count_by_phase(phase: int) -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v v=" + to_string(phase) + " '$2==v {c++} END{print c+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn total_ms_to_present() -> int {
    let exists = exec("test -f '" + FRAME_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + FRAME_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn cndf_stats() -> array {
    return [frame_count(), count_by_phase(4), count_by_phase(5), total_ms_to_present()]
}

fn cleanup_cndf() -> void {
    let _ = exec("rm -rf '" + CNDF_DIR + "'")
}

fn self_test() -> void {
    let sid = "cndf-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_cndf()

    // 합성 5-phase first-frame co-op variant (synthetic, retired_intentional — D3DMetal transitive + EAC inherited):
    //   frame 1 — device_create, session 47001, 250ms
    //   frame 2 — swapchain_init, session 47001, 80ms
    //   frame 3 — pso_warm, session 47001, 1200ms (Dantelion engine PSO compile)
    //   frame 4 — first_present, session 47001, 30ms
    //   frame 5 — co_op_sync_render, session 47001, 50ms (3-player viewport sync NEW)
    record_frame(1, 1, 47001, 250)
    record_frame(2, 2, 47001, 80)
    record_frame(3, 3, 47001, 1200)
    record_frame(4, 4, 47001, 30)
    record_frame(5, 5, 47001, 50)

    let fc = frame_count()
    if fc != 5 { panic("c_nightreign_dx12_first_frame_co_op_variant FAIL [count] expected=5 got=" + to_string(fc)) }

    let p4 = count_by_phase(4)
    if p4 != 1 { panic("c_nightreign_dx12_first_frame_co_op_variant FAIL [first_present] expected=1 got=" + to_string(p4)) }
    let p5 = count_by_phase(5)
    if p5 != 1 { panic("c_nightreign_dx12_first_frame_co_op_variant FAIL [co_op_sync] expected=1 got=" + to_string(p5)) }

    let total = total_ms_to_present()
    let expected_total = 250 + 80 + 1200 + 30 + 50
    if total != expected_total { panic("c_nightreign_dx12_first_frame_co_op_variant FAIL [total_ms] expected=" + to_string(expected_total) + " got=" + to_string(total)) }

    let stats = cndf_stats()
    r0_emit("cndf_summary", "\"frames\":" + to_string(stats[0]) + ",\"first_present\":" + to_string(stats[1]) + ",\"co_op_sync\":" + to_string(stats[2]) + ",\"total_ms\":" + to_string(stats[3]))

    // ─── retired_intentional posture annotation (Track CM, EAC inherited + D3DMetal transitive + skeleton-tier) ───
    r0_emit("cndf_retired_intentional",
        "\"stage\":\"nightreign_dx12_co_op_first_frame_synthetic\",\"domain\":\"dx12_first_frame_co_op_variant\",\"posture\":\"retired_intentional_inherited\",\"production_smoke\":\"no_attempt\",\"d3dmetal_transitive\":1,\"eac_anti_tamper_inherited\":1,\"validated_manjeom\":0,\"blocker_ref_1\":\"elden_ring_nightreign.blk.1\",\"blocker_class_1\":\"eac_anti_tamper_inherited\",\"blocker_ref_2\":\"loader_dx.blk.1\",\"blocker_class_2\":\"d3dmetal_binary_licence_transitive\",\"adoption_iso\":\"2026-05-05\",\"adoption_track\":\"BY+CM\",\"verdict\":\"RETIRED_INTENTIONAL\"")
    println("__NIGHTREIGN_RENDER__ RETIRED_INTENTIONAL nightreign_dx12_co_op_first_frame_synthetic")

    cleanup_cndf()

    let cnt = r0_session_count(sid)
    if cnt < 7 { panic("c_nightreign_dx12_first_frame_co_op_variant FAIL [emit count] expected>=7 got=" + to_string(cnt)) }

    println("  ✅ c_nightreign_dx12_first_frame_co_op_variant self_test PASS (5 frames, total_ms=" + to_string(total) + ", sid=" + sid + ", emits=" + to_string(cnt) + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = cndf_stats()
            println("frames=" + to_string(s[0]) + " first_present=" + to_string(s[1]) + " co_op_sync=" + to_string(s[2]) + " total_ms=" + to_string(s[3]))
            return
        }
        if sub == "cleanup" { cleanup_cndf(); println("cleaned"); return }
    }
    println("usage: hexa run c_nightreign_dx12_first_frame_co_op_variant.hexa { self-test | stats | cleanup }")
}
