// lib/perf/c_wot_garage_warmup.hexa — CN-177 skeleton manjeom 15/15
//
// WoT garage (lobby UI) warm-up 추적 — battle 진입 X (multiplayer 거부 directive
// 정합). WoT 의 garage 는 lobby UI — tank 선택, equipment 장착, crew 관리 등을
// 담당하며 battle 진입은 일절 다루지 않으므로 multiplayer 보류 directive 와
// 100% 정합한다. 본 모듈은 garage session 단위 (session_id × tank_count ×
// ui_load_us × asset_load_mb) 의 4-key columnar 로그와 cold→warm 전환 정량화만
// 담당 — 실제 garage UI render 는 host 측 책임.
//
// 무기: session × tank × ui_load × asset_mb 4-key columnar log + sum/avg.
// 효과: WoT garage UI cold→warm 전환 정량화, battle 진입 0.

use "./r0_common"

let WGW_DIR = GAMEBOX_HOME + "/persist/wot_garage_warmup"
let SESSION_LOG = WGW_DIR + "/sessions.tsv"

fn wgw_dir() -> str { return WGW_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + WGW_DIR + "'")
}

// ─── garage session 등록 ───
//   session_id (garage open 단위 id),
//   tank_count (garage 에 표시된 tank 수),
//   ui_load_us (lobby UI 로드 누적 시간 µs — host 측 측정),
//   asset_load_mb (asset (texture / model) 로드 누적 크기 MB).
fn record_session(session_id: int, tank_count: int, ui_load_us: int, asset_load_mb: int) -> void {
    ensure_dir()
    let line = to_string(session_id) + "\t" + to_string(tank_count) + "\t" + to_string(ui_load_us) + "\t" + to_string(asset_load_mb)
    let tmp = SESSION_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + SESSION_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("wot_garage_record", "\"session\":" + to_string(session_id) + ",\"tanks\":" + to_string(tank_count) + ",\"ui_us\":" + to_string(ui_load_us) + ",\"asset_mb\":" + to_string(asset_load_mb))
}

// ─── session_count — 등록된 garage session 행 수 ───
fn session_count() -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + SESSION_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_tanks — 모든 session tank_count 합 ───
fn total_tanks() -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + SESSION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_ui_load_us — 모든 session ui_load_us 합 ───
fn total_ui_load_us() -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + SESSION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_asset_load_mb — 모든 session asset_load_mb 합 (MB) ───
fn total_asset_load_mb() -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + SESSION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_ui_load_us — total_ui_load_us / session_count ───
//   stage1 float X → 정수 나눗셈으로 안정화.
//   session 0 이면 0 반환 (divide-by-zero guard).
fn avg_ui_load_us() -> int {
    let sc = session_count()
    if sc == 0 { return 0 }
    let tu = total_ui_load_us()
    return tu / sc
}

// ─── session_tanks — 특정 session_id 의 tank_count ───
//   session_id 미등록이면 0.
fn session_tanks(session_id: int) -> int {
    let exists = exec("test -f '" + SESSION_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v a=" + to_string(session_id) + " '$1==a {s+=$2} END{print s+0}' '" + SESSION_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── wgw_stats — [session_count, total_tanks, total_ui_load_us, total_asset_load_mb] ───
fn wgw_stats() -> array {
    return [session_count(), total_tanks(), total_ui_load_us(), total_asset_load_mb()]
}

fn cleanup_wgw() -> void {
    let _ = exec("rm -rf '" + WGW_DIR + "'")
}

fn self_test() -> void {
    let sid = "wgw-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_wgw()

    // 합성 garage session 3 종 (battle 진입 X — lobby UI only):
    //   32001 (cold first launch, full garage) — 24 tank / 480000 µs / 320 MB
    //   32002 (warm, asset cache hit)          — 24 tank / 120000 µs /  80 MB
    //   32003 (hot, only tank reselect)        —  8 tank /  24000 µs /  12 MB
    record_session(32001, 24, 480000, 320)
    record_session(32002, 24, 120000, 80)
    record_session(32003, 8, 24000, 12)

    // session_count = 3
    let sc = session_count()
    if sc != 3 { panic("c_wot_garage_warmup FAIL [session_count] expected=3 got=" + to_string(sc)) }

    // total_tanks = 24+24+8 = 56
    let tt = total_tanks()
    if tt != 56 { panic("c_wot_garage_warmup FAIL [total_tanks] expected=56 got=" + to_string(tt)) }

    // total_ui_load_us = 480000+120000+24000 = 624000
    let tu = total_ui_load_us()
    if tu != 624000 { panic("c_wot_garage_warmup FAIL [total_ui_load_us] expected=624000 got=" + to_string(tu)) }

    // total_asset_load_mb = 320+80+12 = 412
    let ta = total_asset_load_mb()
    if ta != 412 { panic("c_wot_garage_warmup FAIL [total_asset_load_mb] expected=412 got=" + to_string(ta)) }

    // avg_ui_load_us = 624000 / 3 = 208000
    let avg = avg_ui_load_us()
    if avg != 208000 { panic("c_wot_garage_warmup FAIL [avg_ui_load_us] expected=208000 got=" + to_string(avg)) }

    // session_tanks:
    //   32001 → 24, 32002 → 24, 32003 → 8, 9999 → 0 (미등록)
    let t1 = session_tanks(32001)
    if t1 != 24 { panic("c_wot_garage_warmup FAIL [tanks 32001] expected=24 got=" + to_string(t1)) }
    let t2 = session_tanks(32002)
    if t2 != 24 { panic("c_wot_garage_warmup FAIL [tanks 32002] expected=24 got=" + to_string(t2)) }
    let t3 = session_tanks(32003)
    if t3 != 8 { panic("c_wot_garage_warmup FAIL [tanks 32003] expected=8 got=" + to_string(t3)) }
    let t4 = session_tanks(9999)
    if t4 != 0 { panic("c_wot_garage_warmup FAIL [tanks unknown] expected=0 got=" + to_string(t4)) }

    let stats = wgw_stats()
    if stats[0] != 3 { panic("c_wot_garage_warmup FAIL [stats sessions] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 56 { panic("c_wot_garage_warmup FAIL [stats tanks] expected=56 got=" + to_string(stats[1])) }
    if stats[2] != 624000 { panic("c_wot_garage_warmup FAIL [stats ui_us] expected=624000 got=" + to_string(stats[2])) }
    if stats[3] != 412 { panic("c_wot_garage_warmup FAIL [stats asset_mb] expected=412 got=" + to_string(stats[3])) }

    r0_emit("wot_garage_summary", "\"sessions\":" + to_string(stats[0]) + ",\"tanks\":" + to_string(stats[1]) + ",\"ui_us\":" + to_string(stats[2]) + ",\"asset_mb\":" + to_string(stats[3]) + ",\"avg_ui_us\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_wot_garage_warmup FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic WoT garage warmup round-trip (Track BM — c_wot_* family inventory v2 — partial 유지) ───
    //
    // Track BM mission: c_wot_* family inventory v2 — c_wot_garage_warmup
    // 측 World of Tanks garage UI warmup synthetic round-trip. Warmup lifecycle
    // (probe_garage_xml → load_tank_pkg → warm_ui_widgets → audit_load_us)
    // 측 spec freeze. BigWorld engine binary licence transitive (long-horizon production
    // smoke gate), Wargaming network production smoke long-horizon, met 승격 X.
    //
    // (a) synthetic 4-phase WoT garage warmup pipeline —
    //     probe_garage_xml → load_tank_pkg → warm_ui_widgets → audit_load_us:
    //     phase_count               4
    //     wot_garage_off            0x140166000         (synthetic WoT garage warmup RVA)
    //     pipeline_kind             "synthetic_inline"  (실 BigWorld pkg load 호출 X)
    //
    // (b) synthetic tank_class × warmup_stage 16-slot warmup matrix —
    //     4 tank_class (light/medium/heavy/td) × 4 warmup_stage (xml/pkg/ui/audit) = 16 slots:
    //     slot_total                16
    //     hot_slot_count            4                   (warmup_stage = ui, hot warmup)
    //     cold_slot_count           12                  (xml/pkg/audit cold)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = synthesize_warmup_phase(scaffold) → walk_warmup_matrix(scaffold).
    //              hexa-native loop only — 실 BigWorld pkg disk read 0,
    //              real Wargaming launcher network 0.
    //
    // synthetic WoT garage warmup phase emit
    r0_emit("c_wot_garage_warmup_synthetic_phase",
        "\"stage\":\"garage_warmup_phase\",\"phase_count\":4,\"wot_garage_off\":\"0x140166000\",\"pipeline_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"engine_gap\":\"BigWorld engine binary licence transitive — long-horizon Wargaming production smoke gate\"")
    println("__WOT_GARAGE__ PARTIAL garage_warmup_phase")

    // synthetic tank × warmup matrix emit
    r0_emit("c_wot_garage_warmup_synthetic_matrix",
        "\"stage\":\"warmup_matrix\",\"slot_total\":16,\"hot_slot_count\":4,\"cold_slot_count\":12,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"battlenet.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"engine_gap\":\"BigWorld engine binary licence transitive — long-horizon Wargaming production smoke gate\"")
    println("__WOT_GARAGE__ PARTIAL warmup_matrix")

    cleanup_wgw()

    println("  ✅ c_wot_garage_warmup self_test PASS (3 sessions, 56 tanks, ui_us=624000, asset_mb=412, avg_ui_us=208000, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = wgw_stats()
            println("sessions=" + to_string(s[0]) + " tanks=" + to_string(s[1]) + " ui_us=" + to_string(s[2]) + " asset_mb=" + to_string(s[3]))
            return
        }
        if sub == "tanks" {
            if len(a) >= 4 {
                let sid_q = to_int(a[3])
                let tc = session_tanks(sid_q)
                println(to_string(tc))
                return
            }
        }
        if sub == "cleanup" { cleanup_wgw(); println("cleaned"); return }
    }
    println("usage: hexa run c_wot_garage_warmup.hexa { self-test | stats | tanks <session_id> | cleanup }")
}
