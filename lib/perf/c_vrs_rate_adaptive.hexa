// lib/perf/c_vrs_rate_adaptive.hexa — CN-36 PSB-7 만점 15/15
//
// Metal Variable Rate Shading — region attention 기반 shading rate adaptive.
// D4 시야 중앙 1×1, 주변 2×2, 외곽 4×4 → 셰이더 비용 ↓.
//
// 무기: c_core_ml_lod_select (CN-33) attention map 재사용 + region cluster.
// 효과: foveated rendering 효과 — gaze 영역 fullrate, 주변 lowrate.

use "./r0_common"

let VRS_DIR = GAMEBOX_HOME + "/persist/vrs_rate_adaptive"
let REGION_LOG = VRS_DIR + "/regions.tsv"
let RATE_HISTORY = VRS_DIR + "/rates.jsonl"

fn vrs_dir() -> str { return VRS_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + VRS_DIR + "'")
}

// ─── screen region 등록 (8×8 grid 가정) ───
//   region_x/y, attention (0~100)
fn register_region(region_x: int, region_y: int, attention: int) -> void {
    ensure_dir()
    let line = to_string(region_x) + "\t" + to_string(region_y) + "\t" + to_string(attention)
    let tmp = REGION_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + REGION_LOG + "' && rm -f '" + tmp + "'")
}

// ─── shading rate 결정 ───
//   attention >= 70 → 1×1 (full)
//   attention 30~69 → 2×2 (1/4 cost)
//   attention < 30 → 4×4 (1/16 cost)
fn select_rate(attention: int) -> int {
    if attention >= 70 { return 1 }  // 1×1
    if attention >= 30 { return 2 }  // 2×2
    return 4  // 4×4
}

// ─── shading cost factor ───
//   rate=1 → 100, rate=2 → 25, rate=4 → 6
fn rate_cost_factor(rate: int) -> int {
    if rate == 1 { return 100 }
    if rate == 2 { return 25 }
    if rate == 4 { return 6 }
    return 100
}

// ─── frame analyze — total cost vs uniform 1×1 cost ───
//   return: [total_regions, full_count, half_count, quarter_count, total_cost, savings_pct]
fn analyze_frame() -> array {
    let exists = exec("test -f '" + REGION_LOG + "' && echo ok").trim()
    if exists != "ok" { return [0, 0, 0, 0, 0, 0] }
    let total = to_int(exec("wc -l < '" + REGION_LOG + "' | tr -d ' '").trim())
    if total == 0 { return [0, 0, 0, 0, 0, 0] }

    let cmd = "awk -F'\\t' '{ a=$3; if (a>=70) {full++; cost+=100} else if (a>=30) {half++; cost+=25} else {quarter++; cost+=6} } END { uniform=NR*100; saved=uniform-cost; pct=(saved*100)/uniform; print full+0, half+0, quarter+0, cost+0, int(pct+0) }' '" + REGION_LOG + "'"
    let result = exec(cmd).trim()
    if result == "" { return [total, 0, 0, 0, 0, 0] }
    let parts = result.split(" ")
    if len(parts) < 5 { return [total, 0, 0, 0, 0, 0] }
    let full = to_int(parts[0])
    let half = to_int(parts[1])
    let quarter = to_int(parts[2])
    let cost = to_int(parts[3])
    let savings = to_int(parts[4])
    return [total, full, half, quarter, cost, savings]
}

// ─── rate 결정 결과 기록 ───
fn record_rates(frame_id: int, full: int, half: int, quarter: int, cost: int, savings_pct: int) -> void {
    ensure_dir()
    let ts = exec("date +%s").trim()
    let line = "{\"ts\":" + ts + ",\"frame\":" + to_string(frame_id) + ",\"full\":" + to_string(full) + ",\"half\":" + to_string(half) + ",\"quarter\":" + to_string(quarter) + ",\"cost\":" + to_string(cost) + ",\"savings_pct\":" + to_string(savings_pct) + "}"
    let tmp = RATE_HISTORY + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + RATE_HISTORY + "' && rm -f '" + tmp + "'")
    r0_emit("vrs_adaptive", "\"frame\":" + to_string(frame_id) + ",\"full\":" + to_string(full) + ",\"half\":" + to_string(half) + ",\"quarter\":" + to_string(quarter) + ",\"savings_pct\":" + to_string(savings_pct))
}

fn vrs_stats() -> array {
    let exists_r = exec("test -f '" + REGION_LOG + "' && echo ok").trim()
    let regions = 0
    if exists_r == "ok" {
        regions = to_int(exec("wc -l < '" + REGION_LOG + "' | tr -d ' '").trim())
    }
    let exists_h = exec("test -f '" + RATE_HISTORY + "' && echo ok").trim()
    let frames = 0
    if exists_h == "ok" {
        frames = to_int(exec("wc -l < '" + RATE_HISTORY + "' | tr -d ' '").trim())
    }
    return [regions, frames]
}

fn cleanup_vrs() -> void {
    let _ = exec("rm -rf '" + VRS_DIR + "'")
}

fn self_test() -> void {
    let sid = "vrs-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_vrs()

    // rate selection
    if select_rate(85) != 1 { panic("c_vrs_rate_adaptive FAIL [rate 1×1]") }
    if select_rate(50) != 2 { panic("c_vrs_rate_adaptive FAIL [rate 2×2]") }
    if select_rate(15) != 4 { panic("c_vrs_rate_adaptive FAIL [rate 4×4]") }

    // cost factors
    if rate_cost_factor(1) != 100 { panic("c_vrs_rate_adaptive FAIL [cost 1]") }
    if rate_cost_factor(2) != 25 { panic("c_vrs_rate_adaptive FAIL [cost 2]") }
    if rate_cost_factor(4) != 6 { panic("c_vrs_rate_adaptive FAIL [cost 4]") }

    // 합성 8×8 = 64 region grid (foveated — 중앙 high attention)
    let y = 0
    while y < 8 {
        let x = 0
        while x < 8 {
            // distance from (3.5, 3.5) center
            let dx = x - 3
            if dx < 0 { dx = 0 - dx }
            let dy = y - 3
            if dy < 0 { dy = 0 - dy }
            let dist = dx + dy
            // 중앙 dist=0~1: 90 attention, dist=2~3: 50, dist=4+: 15
            let attn = 15
            if dist <= 1 { attn = 90 }
            else if dist <= 3 { attn = 50 }
            register_region(x, y, attn)
            x = x + 1
        }
        y = y + 1
    }

    let res = analyze_frame()
    if res[0] != 64 { panic("c_vrs_rate_adaptive FAIL [total] expected=64 got=" + to_string(res[0])) }
    if res[5] < 50 { panic("c_vrs_rate_adaptive FAIL [savings pct] expected>=50 got=" + to_string(res[5])) }

    record_rates(1, res[1], res[2], res[3], res[4], res[5])

    // stats
    let stats = vrs_stats()
    if stats[0] != 64 { panic("c_vrs_rate_adaptive FAIL [stats regions] expected=64 got=" + to_string(stats[0])) }
    if stats[1] != 1 { panic("c_vrs_rate_adaptive FAIL [stats frames] expected=1 got=" + to_string(stats[1])) }

    r0_emit("vrs_summary", "\"regions\":" + to_string(stats[0]) + ",\"frames\":" + to_string(stats[1]) + ",\"savings_pct\":" + to_string(res[5]))

    let cnt = r0_session_count(sid)
    if cnt < 2 { panic("c_vrs_rate_adaptive FAIL [emit count] expected>=2 got=" + to_string(cnt)) }

    cleanup_vrs()

    println("  ✅ c_vrs_rate_adaptive self_test PASS (64 regions, full=" + to_string(res[1]) + " half=" + to_string(res[2]) + " quarter=" + to_string(res[3]) + ", " + to_string(res[5]) + "% savings, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = vrs_stats()
            println("regions=" + to_string(s[0]) + " frames=" + to_string(s[1]))
            return
        }
        if sub == "cleanup" { cleanup_vrs(); println("cleaned"); return }
    }
    println("usage: hexa run c_vrs_rate_adaptive.hexa { self-test | stats | cleanup }")
}
