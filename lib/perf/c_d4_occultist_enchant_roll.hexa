// lib/perf/c_d4_occultist_enchant_roll.hexa — CN-192 skeleton manjeom 15/15
//
// D4 Occultist NPC enchant reroll 추적 — affix 1개 reroll, 비용 누적 증가.
// 시나리오: D4 Occultist NPC 가 item 의 affix 1개 (사용자 선택) reroll. 비용
// (gold + Veiled Crystals) 이 roll 마다 증가. item × roll_count ×
// cumulative_gold × veiled_crystal 추적.
//
// 무기: item × roll × gold × crystal 4-key 컬럼 로그.
// 효과: D4 enchant 비용 정량화.

use "./r0_common"

let DOER_DIR = GAMEBOX_HOME + "/persist/d4_occultist_enchant_roll"
let DOER_LOG = DOER_DIR + "/enchants.tsv"

fn doer_dir() -> str { return DOER_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + DOER_DIR + "'")
}

// ─── enchant 등록 ───
//   item_id (Occultist 가 reroll 한 item id),
//   roll_count (이 item 에 누적된 reroll 횟수),
//   cumulative_gold (이 item reroll 누적 gold 비용),
//   veiled_crystal (이 item reroll 누적 Veiled Crystals 소모).
fn record_enchant(item_id: int, roll_count: int, cumulative_gold: int, veiled_crystal: int) -> void {
    ensure_dir()
    let line = to_string(item_id) + "\t" + to_string(roll_count) + "\t" + to_string(cumulative_gold) + "\t" + to_string(veiled_crystal)
    let tmp = DOER_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + DOER_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("d4_occultist_enchant_record", "\"item\":" + to_string(item_id) + ",\"rolls\":" + to_string(roll_count) + ",\"gold\":" + to_string(cumulative_gold) + ",\"crystal\":" + to_string(veiled_crystal))
}

// ─── enchant_count — 등록된 enchant 행 수 ───
fn enchant_count() -> int {
    let exists = exec("test -f '" + DOER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + DOER_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_rolls — 모든 enchant roll_count 합 ───
fn total_rolls() -> int {
    let exists = exec("test -f '" + DOER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$2} END{print s+0}' '" + DOER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_gold — 모든 enchant cumulative_gold 합 ───
fn total_gold() -> int {
    let exists = exec("test -f '" + DOER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$3} END{print s+0}' '" + DOER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── total_crystal — 모든 enchant veiled_crystal 합 ───
fn total_crystal() -> int {
    let exists = exec("test -f '" + DOER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + DOER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── avg_gold_per_roll — total_gold / total_rolls (0-guard) ───
fn avg_gold_per_roll() -> int {
    let tr = total_rolls()
    if tr == 0 { return 0 }
    let tg = total_gold()
    return tg / tr
}

// ─── item_total_gold — 특정 item_id 의 cumulative_gold 합 ───
//   item_id 미등록이면 0.
fn item_total_gold(item_id: int) -> int {
    let exists = exec("test -f '" + DOER_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v i=" + to_string(item_id) + " '$1==i {s+=$3} END{print s+0}' '" + DOER_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── doer_stats — [enchant_count, total_rolls, total_gold, total_crystal] ───
fn doer_stats() -> array {
    return [enchant_count(), total_rolls(), total_gold(), total_crystal()]
}

fn cleanup_doer() -> void {
    let _ = exec("rm -rf '" + DOER_DIR + "'")
}

fn self_test() -> void {
    let sid = "doer-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_doer()

    // 합성 enchant 3 종:
    //   helm   (id=46001) — first reroll  : 3 rolls / 2,000,000 gold / 12 crystal
    //   chest  (id=46002) — many rerolls : 8 rolls / 15,000,000 gold / 48 crystal
    //   gloves (id=46003) — one reroll   : 1 roll / 400,000 gold / 4 crystal
    record_enchant(46001, 3, 2000000, 12)
    record_enchant(46002, 8, 15000000, 48)
    record_enchant(46003, 1, 400000, 4)

    // enchant_count = 3
    let ec = enchant_count()
    if ec != 3 { panic("c_d4_occultist_enchant_roll FAIL [enchant_count] expected=3 got=" + to_string(ec)) }

    // total_rolls = 3+8+1 = 12
    let tr = total_rolls()
    if tr != 12 { panic("c_d4_occultist_enchant_roll FAIL [total_rolls] expected=12 got=" + to_string(tr)) }

    // total_gold = 2000000+15000000+400000 = 17400000
    let tg = total_gold()
    if tg != 17400000 { panic("c_d4_occultist_enchant_roll FAIL [total_gold] expected=17400000 got=" + to_string(tg)) }

    // total_crystal = 12+48+4 = 64
    let tc = total_crystal()
    if tc != 64 { panic("c_d4_occultist_enchant_roll FAIL [total_crystal] expected=64 got=" + to_string(tc)) }

    // avg_gold_per_roll = 17400000 / 12 = 1450000
    let avg = avg_gold_per_roll()
    if avg != 1450000 { panic("c_d4_occultist_enchant_roll FAIL [avg_gold_per_roll] expected=1450000 got=" + to_string(avg)) }

    // item_total_gold:
    //   helm   46001 = 2000000
    //   chest  46002 = 15000000
    //   gloves 46003 = 400000
    let g1 = item_total_gold(46001)
    if g1 != 2000000 { panic("c_d4_occultist_enchant_roll FAIL [item_gold 46001] expected=2000000 got=" + to_string(g1)) }
    let g2 = item_total_gold(46002)
    if g2 != 15000000 { panic("c_d4_occultist_enchant_roll FAIL [item_gold 46002] expected=15000000 got=" + to_string(g2)) }
    let g3 = item_total_gold(46003)
    if g3 != 400000 { panic("c_d4_occultist_enchant_roll FAIL [item_gold 46003] expected=400000 got=" + to_string(g3)) }
    // 미등록 item_id 는 0
    let g4 = item_total_gold(9999)
    if g4 != 0 { panic("c_d4_occultist_enchant_roll FAIL [item_gold unknown] expected=0 got=" + to_string(g4)) }

    let stats = doer_stats()
    if stats[0] != 3 { panic("c_d4_occultist_enchant_roll FAIL [stats enchants] expected=3 got=" + to_string(stats[0])) }
    if stats[1] != 12 { panic("c_d4_occultist_enchant_roll FAIL [stats rolls] expected=12 got=" + to_string(stats[1])) }
    if stats[2] != 17400000 { panic("c_d4_occultist_enchant_roll FAIL [stats gold] expected=17400000 got=" + to_string(stats[2])) }
    if stats[3] != 64 { panic("c_d4_occultist_enchant_roll FAIL [stats crystal] expected=64 got=" + to_string(stats[3])) }

    r0_emit("d4_occultist_enchant_summary", "\"enchants\":" + to_string(stats[0]) + ",\"rolls\":" + to_string(stats[1]) + ",\"gold\":" + to_string(stats[2]) + ",\"crystal\":" + to_string(stats[3]) + ",\"avg_gold\":" + to_string(avg))

    // record × 3 + summary × 1 = ≥ 4 emits
    let cnt = r0_session_count(sid)
    if cnt < 4 { panic("c_d4_occultist_enchant_roll FAIL [emit count] expected>=4 got=" + to_string(cnt)) }

    // ─── synthetic D4 economy retired_intentional posture annotation (Track BA) ───
    //
    // Track BA mission: extend Track V (7) + Track AJ (6) + Track AL (6) D4 retired_
    // intentional posture annotation to 6 additional c_d4_* modules. cumulative
    // coverage 25/27 = ~92.6%. .roadmap.diablo4 blk.1 status_enum_adopted = retired_
    // intentional (Track A2 land 2026-05-03). 본 module 측 occultist enchant reroll
    // (gold + veiled crystal cost) tracker = synthetic build analyzer — production
    // live game state 측정 X (D4 always-online live session 진입 X, DRM bypass 0,
    // Battle.net launcher 통과 X). cond.3 status `partial` 영구 유지 (retired_
    // intentional posture per blk.1 영구 lock). pattern reference: lib/perf/c_d4_
    // aspect_imprint_track.hexa (Track AL predecessor, identical schema).
    //
    // synthetic posture row column header:
    //     domain                "occultist_enchant_roll"
    //     posture               "retired_intentional"  (NOT pass / NOT partial / NOT fail)
    //     production_smoke      "no_attempt"           (no live game state acquire)
    //     drm_bypass            "0"                    (own1 Wine 0 / no evasion)
    //     always_online_evade   "0"                    (own1 honest acknowledgment)
    //     blocker_ref           "diablo4.blk.1"        (always_online_drm)
    //     adoption_iso          "2026-05-03"           (Track A2 retired_intentional adopt)
    r0_emit("c_d4_occultist_enchant_roll_retired_intentional",
        "\"stage\":\"d4_economy_synthetic\",\"domain\":\"occultist_enchant_roll\",\"posture\":\"retired_intentional\",\"production_smoke\":\"no_attempt\",\"drm_bypass\":0,\"always_online_evade\":0,\"blocker_ref\":\"diablo4.blk.1\",\"blocker_class\":\"always_online_drm\",\"adoption_iso\":\"2026-05-03\",\"cond\":\"diablo4.cond.3\",\"verdict\":\"RETIRED_INTENTIONAL\",\"posture_kind\":\"block_acknowledged_pass_equivalent\",\"track\":\"BA\"")
    println("__D4_OCCULTIST_ENCHANT__ RETIRED_INTENTIONAL d4_economy_synthetic")

    cleanup_doer()

    println("  ✅ c_d4_occultist_enchant_roll self_test PASS (3 enchants, 12 rolls, 17400000 gold, 64 crystal, avg=1450000, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = doer_stats()
            println("enchants=" + to_string(s[0]) + " rolls=" + to_string(s[1]) + " gold=" + to_string(s[2]) + " crystal=" + to_string(s[3]))
            return
        }
        if sub == "gold" {
            if len(a) >= 4 {
                let iid = to_int(a[3])
                let g = item_total_gold(iid)
                println(to_string(g))
                return
            }
        }
        if sub == "cleanup" { cleanup_doer(); println("cleaned"); return }
    }
    println("usage: hexa run c_d4_occultist_enchant_roll.hexa { self-test | stats | gold <item_id> | cleanup }")
}
