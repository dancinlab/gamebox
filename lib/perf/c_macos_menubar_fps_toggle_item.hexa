// lib/perf/c_macos_menubar_fps_toggle_item.hexa — CN-215 skeleton manjeom 15/15
//
// macOS 메뉴바 의 "Show FPS" menu item (NSMenu checkmark 형식) 의 on/off
// toggle 추적. 사용자 directive: "메뉴에서 on/off 가능 필요" — NSMenuItem
// click 시 prev_state ↔ new_state toggle 이 발생하며 (toggle_id × prev_state
// × new_state × elapsed_us) 4-key columnar log 로 정량화. CN-218 (hotkey
// handler) 와 동기 — 둘 다 같은 toggle state 변경.
//
// 무기: toggle × prev × new × elapsed 4-key columnar log + sum/count.
// 효과: 메뉴바 FPS toggle 행동 정량화 → on/off 빈도 + per-toggle latency.

use "./r0_common"

let MMFTI_DIR = GAMEBOX_HOME + "/persist/macos_menubar_fps_toggle_item"
let TOGGLE_LOG = MMFTI_DIR + "/toggles.tsv"

fn mmfti_dir() -> str { return MMFTI_DIR }

fn ensure_dir() -> void {
    let _mk = exec("mkdir -p '" + MMFTI_DIR + "'")
}

// ─── toggle 등록 ───
//   toggle_id (event 식별자),
//   prev_state (0=off / 1=on — toggle 전 상태),
//   new_state (0=off / 1=on — toggle 후 상태),
//   elapsed_us (toggle handler 처리 시간 µs).
fn record_toggle(toggle_id: int, prev_state: int, new_state: int, elapsed_us: int) -> void {
    ensure_dir()
    let line = to_string(toggle_id) + "\t" + to_string(prev_state) + "\t" + to_string(new_state) + "\t" + to_string(elapsed_us)
    let tmp = TOGGLE_LOG + ".tmp"
    write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + TOGGLE_LOG + "' && rm -f '" + tmp + "'")
    r0_emit("mmfti_record", "\"toggle\":" + to_string(toggle_id) + ",\"prev\":" + to_string(prev_state) + ",\"new\":" + to_string(new_state) + ",\"elapsed_us\":" + to_string(elapsed_us))
}

// ─── toggle_count — 등록된 toggle 행 수 ───
fn toggle_count() -> int {
    let exists = exec("test -f '" + TOGGLE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let n = exec("wc -l < '" + TOGGLE_LOG + "' | tr -d ' '").trim()
    if n == "" { return 0 }
    return to_int(n)
}

// ─── total_elapsed_us — 모든 toggle elapsed_us 합 ───
fn total_elapsed_us() -> int {
    let exists = exec("test -f '" + TOGGLE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '{s+=$4} END{print s+0}' '" + TOGGLE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── on_count — new_state==1 (off→on) toggle 행 수 ───
fn on_count() -> int {
    let exists = exec("test -f '" + TOGGLE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==1 {c++} END{print c+0}' '" + TOGGLE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── off_count — new_state==0 (on→off) toggle 행 수 ───
fn off_count() -> int {
    let exists = exec("test -f '" + TOGGLE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' '$3==0 {c++} END{print c+0}' '" + TOGGLE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── toggle_elapsed — 특정 toggle_id 의 elapsed_us 조회 ───
//   toggle_id 미등록이면 0.
fn toggle_elapsed(toggle_id: int) -> int {
    let exists = exec("test -f '" + TOGGLE_LOG + "' && echo ok").trim()
    if exists != "ok" { return 0 }
    let s = exec("awk -F'\\t' -v t=" + to_string(toggle_id) + " '$1==t {s+=$4} END{print s+0}' '" + TOGGLE_LOG + "'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── mmfti_stats — [toggle_count, total_elapsed_us, on_count, off_count] ───
fn mmfti_stats() -> array {
    return [toggle_count(), total_elapsed_us(), on_count(), off_count()]
}

fn cleanup_mmfti() -> void {
    let _ = exec("rm -rf '" + MMFTI_DIR + "'")
}

fn self_test() -> void {
    let sid = "mmfti-" + exec("date +%s").trim()
    r0_session_set(sid)

    cleanup_mmfti()

    // 합성 toggle 4 종 (alternating on/off):
    //   66001 off→on / 120 µs
    //   66002 on→off /  80 µs
    //   66003 off→on / 100 µs
    //   66004 on→off /  90 µs
    record_toggle(66001, 0, 1, 120)
    record_toggle(66002, 1, 0, 80)
    record_toggle(66003, 0, 1, 100)
    record_toggle(66004, 1, 0, 90)

    // toggle_count = 4
    let tc = toggle_count()
    if tc != 4 { panic("c_macos_menubar_fps_toggle_item FAIL [toggle_count] expected=4 got=" + to_string(tc)) }

    // total_elapsed_us = 120+80+100+90 = 390
    let te = total_elapsed_us()
    if te != 390 { panic("c_macos_menubar_fps_toggle_item FAIL [total_elapsed_us] expected=390 got=" + to_string(te)) }

    // on_count = 2 (66001+66003)
    let oc = on_count()
    if oc != 2 { panic("c_macos_menubar_fps_toggle_item FAIL [on_count] expected=2 got=" + to_string(oc)) }

    // off_count = 2 (66002+66004)
    let fc = off_count()
    if fc != 2 { panic("c_macos_menubar_fps_toggle_item FAIL [off_count] expected=2 got=" + to_string(fc)) }

    // toggle_elapsed:
    //   66001 → 120
    //   66004 →  90
    //   9999  →   0 (미등록)
    let e1 = toggle_elapsed(66001)
    if e1 != 120 { panic("c_macos_menubar_fps_toggle_item FAIL [elapsed 66001] expected=120 got=" + to_string(e1)) }
    let e4 = toggle_elapsed(66004)
    if e4 != 90 { panic("c_macos_menubar_fps_toggle_item FAIL [elapsed 66004] expected=90 got=" + to_string(e4)) }
    let e9 = toggle_elapsed(9999)
    if e9 != 0 { panic("c_macos_menubar_fps_toggle_item FAIL [elapsed unknown] expected=0 got=" + to_string(e9)) }

    let stats = mmfti_stats()
    if stats[0] != 4 { panic("c_macos_menubar_fps_toggle_item FAIL [stats toggles] expected=4 got=" + to_string(stats[0])) }
    if stats[1] != 390 { panic("c_macos_menubar_fps_toggle_item FAIL [stats elapsed] expected=390 got=" + to_string(stats[1])) }
    if stats[2] != 2 { panic("c_macos_menubar_fps_toggle_item FAIL [stats on] expected=2 got=" + to_string(stats[2])) }
    if stats[3] != 2 { panic("c_macos_menubar_fps_toggle_item FAIL [stats off] expected=2 got=" + to_string(stats[3])) }

    r0_emit("mmfti_summary", "\"toggles\":" + to_string(stats[0]) + ",\"elapsed_us\":" + to_string(stats[1]) + ",\"on\":" + to_string(stats[2]) + ",\"off\":" + to_string(stats[3]))

    // record × 4 + summary × 1 = ≥ 5 emits
    let cnt = r0_session_count(sid)
    if cnt < 5 { panic("c_macos_menubar_fps_toggle_item FAIL [emit count] expected>=5 got=" + to_string(cnt)) }

    // ─── synthetic NSStatusBar FPS toggle round-trip (Track BI — diablo2_resurrected cond.3 EVIDENCE AUGMENT — partial 유지) ───
    //
    // Track BI mission: c_macos_* family 100% completion cycle (Track BF 1/4 → BI 4/4) —
    // c_macos_menubar_fps_toggle_item 측 Apple-native synthetic round-trip 추가.
    // NSStatusBarItem FPS toggle lifecycle (idle → click → state_flip → overlay_dispatch)
    // 측 spec freeze. Apple-native scaffold only (own1 정합, NSStatusBar binary linkage 0).
    //
    // (a) synthetic 4-phase FPS toggle lifecycle —
    //     idle → click_event → state_flip → overlay_dispatch:
    //     phase_count               4
    //     toggle_obj_off            0x180052000         (synthetic NSStatusItem FPS RVA)
    //     lifecycle_kind            "synthetic_inline"  (실 NSStatusItem.action 호출 X)
    //
    // (b) synthetic on/off × source 8-slot toggle matrix —
    //     2 toggle_state (on/off) × 4 source (menubar/hotkey/cmd_line/api) = 8 slots:
    //     slot_total                8
    //     menubar_slot_count        2                   (NSStatusBar dispatched only)
    //     non_menubar_slot_count    6                   (hotkey/cmd_line/api dispatched)
    //     matrix_kind               "synthetic_inline"
    //
    // round-trip = fps_toggle_phase(scaffold) → walk_toggle_state_matrix(scaffold).
    //              hexa-native loop only — 실 NSStatusItem.target/action 0,
    //              real NSEventModifierFlags dispatch 0.
    //
    // synthetic FPS toggle phase emit
    r0_emit("c_macos_menubar_fps_toggle_item_synthetic_phase",
        "\"stage\":\"fps_toggle_phase\",\"phase_count\":4,\"toggle_obj_off\":\"0x180052000\",\"lifecycle_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real NSStatusBar binary linkage\"")
    println("__MACOS_FPS_TOGGLE__ PARTIAL fps_toggle_phase")

    // synthetic on/off × source toggle state matrix emit
    r0_emit("c_macos_menubar_fps_toggle_item_synthetic_matrix",
        "\"stage\":\"toggle_state_matrix\",\"slot_total\":8,\"menubar_slot_count\":2,\"non_menubar_slot_count\":6,\"matrix_kind\":\"synthetic_inline\",\"shim_kind\":\"synthetic_inline\",\"cond\":\"diablo2_resurrected.cond.3\",\"verdict\":\"PARTIAL\",\"posture\":\"evidence_augment_partial_to_partial\",\"appkit_gap\":\"hexa-native scaffold — no real NSStatusBar binary linkage\"")
    println("__MACOS_FPS_TOGGLE__ PARTIAL toggle_state_matrix")

    cleanup_mmfti()

    println("  ✅ c_macos_menubar_fps_toggle_item self_test PASS (4 toggles, elapsed=390 us, on=2, off=2, emits=" + to_string(cnt) + ", sid=" + sid + ")")
}

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { self_test(); return }
        if sub == "stats" {
            let s = mmfti_stats()
            println("toggles=" + to_string(s[0]) + " elapsed_us=" + to_string(s[1]) + " on=" + to_string(s[2]) + " off=" + to_string(s[3]))
            return
        }
        if sub == "elapsed" {
            if len(a) >= 4 {
                let tid = to_int(a[3])
                let us = toggle_elapsed(tid)
                println(to_string(us))
                return
            }
        }
        if sub == "cleanup" { cleanup_mmfti(); println("cleaned"); return }
    }
    println("usage: hexa run c_macos_menubar_fps_toggle_item.hexa { self-test | stats | elapsed <toggle_id> | cleanup }")
}
