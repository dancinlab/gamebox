// native/i386_decode.hexa — hexa-native port of native/i386_decode.c leaves.
//
// C-PORT domain · Milestone-2. Tier-A pure-logic port, RUNEQ-gated against
// the C baseline (native/i386_decode.c). See the C-PORT node in ARCHITECTURE.json
// (under GAMEBOX-NATIVE; formerly domains/C-PORT.md).
//
// Ported leaf (M2): decode_modrm_disp — the ModR/M + SIB + displacement
// field extractor. Pure: bytes in → (n, modrm, sib, disp, has_disp) out.
// No I/O, no syscalls, deterministic. C source lines 99–141.
//
// Also ports the two trivial lookup leaves used by disassembly:
//   i386_reg32_name (C 25–32) and a ModR/M field splitter helper.
//
// own1: written from Intel SDM Vol.2 + the in-repo C baseline. No Wine.
//
// Semantics match C exactly:
//   - all arithmetic in hexa `int` (64-bit); disp values are MANUALLY
//     sign-extended to int32 range so they byte-match C's int32_t.
//   - decode_modrm_disp returns n=0 (failure) on short buffer, exactly
//     as the C returns 0.
//   - `bytes` is a list of int (0..255), `avail` = bytes available from
//     the ModR/M byte onward (caller passes `avail - 1`, as the C does).

// ─── register-name lookup (C lines 25–32) ───────────────────────
fn i386_reg32_name(r: int) -> str {
    if r < 0 { return "?" }
    if r > 7 { return "?" }
    let names = ["eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi"]
    return names[r]
}

// ─── sign-extend an unsigned byte (0..255) to int32 range ───────
fn sx8(b: int) -> int {
    if b >= 128 { return b - 256 }
    return b
}

// ─── sign-extend an unsigned 32-bit value to int32 range ────────
fn sx32(u: int) -> int {
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

// ─── decode_modrm_disp (C lines 99–141) ─────────────────────────
// Returns a 5-tuple: (n, modrm, sib, disp, has_disp).
//   n         = bytes consumed (0 = failure / short buffer)
//   modrm     = the ModR/M byte (0 on failure)
//   sib       = the SIB byte (0 if none)
//   disp      = displacement, sign-extended to int32 (0 if none)
//   has_disp  = 1 if a displacement was decoded, else 0
//
// `p` is the byte list starting AT the ModR/M byte; `avail` is how many
// bytes are available from there (== C's `avail - 1` passed by caller).
fn decode_modrm_disp(p: [int], avail: int) -> (int, int, int, int, int) {
    let mut has_disp = 0
    let mut disp = 0
    let mut sib = 0
    if avail < 1 { return (0, 0, 0, 0, 0) }
    let modrm = p[0]
    let mut n = 1
    let mod_f = (modrm >> 6) & 3
    let rm = modrm & 7
    let has_sib = (mod_f != 3) && (rm == 4)
    if has_sib {
        // C semantics: modrm_out is ALREADY written before this SIB-avail
        // check (C i386_decode.c line 107), so on the n>=avail failure C
        // returns 0 but leaves modrm_out set. Match that exactly.
        if n >= avail { return (0, modrm, 0, 0, 0) }
        sib = p[n]
        n = n + 1
    }
    let mut disp_size = 0
    if mod_f == 0 {
        if rm == 5 {
            disp_size = 4
        } else if has_sib && ((sib & 7) == 5) {
            disp_size = 4
        }
    } else if mod_f == 1 {
        disp_size = 1
    } else if mod_f == 2 {
        disp_size = 4
    }
    if disp_size > 0 {
        // C: modrm_out + sib_out already written before the disp-avail
        // check (C line 127); on failure C returns 0 with those set.
        if (n + disp_size) > avail { return (0, modrm, sib, 0, 0) }
        if disp_size == 1 {
            disp = sx8(p[n])
        } else {
            let u = p[n] | (p[n+1] << 8) | (p[n+2] << 16) | (p[n+3] << 24)
            disp = sx32(u)
        }
        has_disp = 1
        n = n + disp_size
    }
    return (n, modrm, sib, disp, has_disp)
}

// ════════════════════════════════════════════════════════════════
// Milestone-3 leaves (extends M2). All PURE: deterministic input→
// output, no I/O, no syscalls. RUNEQ-gated bit-exact vs the C baseline
// (native/i386_decode.c) via native/i386_decode_m3_runeq.c.
// ════════════════════════════════════════════════════════════════

// ─── prefix bitmask constants (i386_decode.h lines 55–65) ───────
// Must match the C #define values exactly.
fn pfx_opsz()   -> int { return 0x01 }
fn pfx_addrsz() -> int { return 0x02 }
fn pfx_repnz()  -> int { return 0x04 }
fn pfx_repz()   -> int { return 0x08 }
fn pfx_lock()   -> int { return 0x10 }
fn pfx_cs()     -> int { return 0x20 }
fn pfx_ss()     -> int { return 0x40 }
fn pfx_ds()     -> int { return 0x80 }
fn pfx_es()     -> int { return 0x100 }
fn pfx_fs()     -> int { return 0x200 }
fn pfx_gs()     -> int { return 0x400 }

// ─── decode_prefixes (C lines 72–95) ────────────────────────────
// Consume the leading prefix-byte run. Returns (n, prefixes):
//   n         = number of prefix bytes consumed (0..8)
//   prefixes  = OR'd I386_PREFIX_* bitmask
// `p` = byte list; `avail` = bytes available. Pure: scans bytes,
// stops at the first non-prefix byte or after 8 prefixes (matches C
// `n < 8` cap and the `(size_t)n < avail` bound).
fn decode_prefixes(p: [int], avail: int) -> (int, int) {
    let mut n = 0
    let mut pre = 0
    while (n < avail) && (n < 8) {
        let b = p[n]
        if b == 0x66 {
            pre = pre | pfx_opsz();   n = n + 1
        } else if b == 0x67 {
            pre = pre | pfx_addrsz(); n = n + 1
        } else if b == 0xF2 {
            pre = pre | pfx_repnz();  n = n + 1
        } else if b == 0xF3 {
            pre = pre | pfx_repz();   n = n + 1
        } else if b == 0xF0 {
            pre = pre | pfx_lock();   n = n + 1
        } else if b == 0x2E {
            pre = pre | pfx_cs();     n = n + 1
        } else if b == 0x36 {
            pre = pre | pfx_ss();     n = n + 1
        } else if b == 0x3E {
            pre = pre | pfx_ds();     n = n + 1
        } else if b == 0x26 {
            pre = pre | pfx_es();     n = n + 1
        } else if b == 0x64 {
            pre = pre | pfx_fs();     n = n + 1
        } else if b == 0x65 {
            pre = pre | pfx_gs();     n = n + 1
        } else {
            break
        }
    }
    return (n, pre)
}

// ─── i386_op_name (C lines 34–70) ───────────────────────────────
// op enum int → mnemonic string. The enum integer values match the
// declaration order in i386_decode.h (sequential from 0):
//   0  UNKNOWN        1  NOP            2  MOV_R_IMM    3  MOV_RM_R
//   4  MOV_R_RM       5  PUSH_R         6  PUSH_IMM     7  POP_R
//   8  CALL_REL       9  CALL_RM       10  RET         11  JMP_REL
//  12  JMP_RM        13  PUSH_RM       14  INC_RM      15  DEC_RM
//  16  JCC           17  INT           18  LEA         19  XOR_RM_R
//  20  XOR_R_RM      21  ADD_RM_R      22  ADD_R_RM    23  SUB_RM_R
//  24  SUB_R_RM      25  CMP_RM_R      26  CMP_R_RM    27  TEST_RM_R
//  28  INC_R         29  DEC_R         30  HLT         31  PREFIX_ONLY
fn i386_op_name(op: int) -> str {
    if op == 13 { return "push" }    // PUSH_RM
    if op == 14 { return "inc" }     // INC_RM
    if op == 15 { return "dec" }     // DEC_RM
    if op == 1  { return "nop" }     // NOP
    if op == 2  { return "mov" }     // MOV_R_IMM
    if op == 3  { return "mov" }     // MOV_RM_R
    if op == 4  { return "mov" }     // MOV_R_RM
    if op == 5  { return "push" }    // PUSH_R
    if op == 6  { return "push" }    // PUSH_IMM
    if op == 7  { return "pop" }     // POP_R
    if op == 8  { return "call" }    // CALL_REL
    if op == 9  { return "call" }    // CALL_RM
    if op == 10 { return "ret" }     // RET
    if op == 11 { return "jmp" }     // JMP_REL
    if op == 12 { return "jmp" }     // JMP_RM
    if op == 16 { return "j_cc" }    // JCC
    if op == 17 { return "int" }     // INT
    if op == 18 { return "lea" }     // LEA
    if op == 19 { return "xor" }     // XOR_RM_R
    if op == 20 { return "xor" }     // XOR_R_RM
    if op == 21 { return "add" }     // ADD_RM_R
    if op == 22 { return "add" }     // ADD_R_RM
    if op == 23 { return "sub" }     // SUB_RM_R
    if op == 24 { return "sub" }     // SUB_R_RM
    if op == 25 { return "cmp" }     // CMP_RM_R
    if op == 26 { return "cmp" }     // CMP_R_RM
    if op == 27 { return "test" }    // TEST_RM_R
    if op == 28 { return "inc" }     // INC_R
    if op == 29 { return "dec" }     // DEC_R
    if op == 30 { return "hlt" }     // HLT
    if op == 31 { return "(prefix-only)" }  // PREFIX_ONLY
    return "(unknown)"               // UNKNOWN (0) + default
}

// ─── rd_s32 (C lines 143–148) ───────────────────────────────────
// Read a little-endian 32-bit value, sign-extended to int32 range.
// `p` = byte list, `i` = offset of the first byte.
fn rd_s32(p: [int], i: int) -> int {
    let u = p[i] | (p[i+1] << 8) | (p[i+2] << 16) | (p[i+3] << 24)
    return sx32(u)
}

// ─── rd_s16 (C lines 150–152) ───────────────────────────────────
// Read a little-endian 16-bit value, sign-extended to int16 range.
fn rd_s16(p: [int], i: int) -> int {
    let u = p[i] | (p[i+1] << 8)
    if u >= 32768 { return u - 65536 }
    return u
}

// ─── self-test: a few hand-checked ModR/M cases ─────────────────
fn self_test() -> int {
    let mut fails = 0

    // mod=3 reg-direct: modrm=0xC0, no sib, no disp, n=1
    let (n1, m1, s1, d1, h1) = decode_modrm_disp([0xC0, 0, 0, 0, 0], 5)
    if n1 != 1 { fails = fails + 1; println("FAIL c0 n=" + to_string(n1)) }
    if h1 != 0 { fails = fails + 1; println("FAIL c0 has_disp") }

    // mod=0 rm=5: [disp32]. modrm=0x05 + 4 disp bytes. n=5, has_disp=1
    let (n2, m2, s2, d2, h2) = decode_modrm_disp([0x05, 0x78, 0x56, 0x34, 0x12], 5)
    if n2 != 5 { fails = fails + 1; println("FAIL 05 n=" + to_string(n2)) }
    if h2 != 1 { fails = fails + 1; println("FAIL 05 has_disp") }
    if d2 != 0x12345678 { fails = fails + 1; println("FAIL 05 disp=" + to_string(d2)) }

    // mod=1 disp8 sign-extended: modrm=0x45 (rm=5 mod=1), disp=0x80 -> -128
    let (n3, m3, s3, d3, h3) = decode_modrm_disp([0x45, 0x80, 0, 0, 0], 5)
    if n3 != 2 { fails = fails + 1; println("FAIL 45 n=" + to_string(n3)) }
    if d3 != (0 - 128) { fails = fails + 1; println("FAIL 45 disp=" + to_string(d3)) }

    // mod=0 rm=4 (SIB), sib base=5 -> disp32: modrm=0x04 sib=0x05 + 4 disp
    let (n4, m4, s4, d4, h4) = decode_modrm_disp([0x04, 0x05, 0x01, 0x00, 0x00, 0x00], 6)
    if n4 != 6 { fails = fails + 1; println("FAIL 04/05 n=" + to_string(n4)) }
    if s4 != 0x05 { fails = fails + 1; println("FAIL 04/05 sib=" + to_string(s4)) }
    if d4 != 1 { fails = fails + 1; println("FAIL 04/05 disp=" + to_string(d4)) }

    // short buffer: mod=2 disp32 but only 2 bytes avail -> n=0
    let (n5, m5, s5, d5, h5) = decode_modrm_disp([0x85, 0x00], 2)
    if n5 != 0 { fails = fails + 1; println("FAIL 85-short n=" + to_string(n5)) }

    // reg name lookup
    if i386_reg32_name(0) != "eax" { fails = fails + 1; println("FAIL reg0") }
    if i386_reg32_name(4) != "esp" { fails = fails + 1; println("FAIL reg4") }
    if i386_reg32_name(8) != "?" { fails = fails + 1; println("FAIL reg8") }

    // ─── M3 leaf checks ─────────────────────────────────────────
    // decode_prefixes: 0x66 0x67 then opcode 0x90 → n=2, bits OPSZ|ADDRSZ
    let (pn1, pb1) = decode_prefixes([0x66, 0x67, 0x90, 0, 0], 5)
    if pn1 != 2 { fails = fails + 1; println("FAIL pfx n=" + to_string(pn1)) }
    if pb1 != (0x01 | 0x02) { fails = fails + 1; println("FAIL pfx bits=" + to_string(pb1)) }
    // no prefixes: opcode first → n=0, bits=0
    let (pn2, pb2) = decode_prefixes([0x90, 0, 0, 0, 0], 5)
    if pn2 != 0 { fails = fails + 1; println("FAIL pfx0 n=" + to_string(pn2)) }
    if pb2 != 0 { fails = fails + 1; println("FAIL pfx0 bits=" + to_string(pb2)) }
    // all-prefix buffer (8 of them) capped at 8
    let (pn3, pb3) = decode_prefixes([0xF0, 0xF0, 0xF0, 0xF0, 0xF0, 0xF0, 0xF0, 0xF0, 0xF0], 9)
    if pn3 != 8 { fails = fails + 1; println("FAIL pfxcap n=" + to_string(pn3)) }

    // i386_op_name spot checks
    if i386_op_name(1) != "nop" { fails = fails + 1; println("FAIL op nop") }
    if i386_op_name(16) != "j_cc" { fails = fails + 1; println("FAIL op jcc") }
    if i386_op_name(0) != "(unknown)" { fails = fails + 1; println("FAIL op unk") }
    if i386_op_name(99) != "(unknown)" { fails = fails + 1; println("FAIL op oob") }

    // rd_s32 / rd_s16
    if rd_s32([0x78, 0x56, 0x34, 0x12], 0) != 0x12345678 { fails = fails + 1; println("FAIL rd32") }
    if rd_s32([0x00, 0x00, 0x00, 0x80], 0) != (0 - 2147483648) { fails = fails + 1; println("FAIL rd32 neg") }
    if rd_s16([0x34, 0x12], 0) != 0x1234 { fails = fails + 1; println("FAIL rd16") }
    if rd_s16([0x00, 0x80], 0) != (0 - 32768) { fails = fails + 1; println("FAIL rd16 neg") }

    if fails == 0 {
        println("__GAMEBOX__ PASS i386_decode.self_test all-cases-ok")
    } else {
        println("__GAMEBOX__ FAIL i386_decode.self_test fails=" + to_string(fails))
    }
    return fails
}

// ─── RUNEQ harness: dump (n modrm sib disp has_disp) for a corpus ─
// One line per corpus entry, tab-separated, identical format to the C
// harness (native/i386_decode_modrm_runeq.c). Reads no input — the
// corpus is generated deterministically here AND in C identically.
fn runeq_dump() -> void {
    // Corpus = every ModR/M byte 0..255, each followed by a fixed
    // 5-byte tail (sib + 4 disp bytes), avail = 6 (always enough).
    // Tail bytes chosen to exercise sign bits: sib=0x25 (base=5),
    // disp bytes 0x78 0x9A 0xBC 0xFE.
    let mut modrm = 0
    while modrm < 256 {
        let bytes = [modrm, 0x25, 0x78, 0x9A, 0xBC, 0xFE]
        let (n, m, s, d, h) = decode_modrm_disp(bytes, 6)
        println(to_string(modrm) + "\t" + to_string(n) + "\t" + to_string(m)
              + "\t" + to_string(s) + "\t" + to_string(d) + "\t" + to_string(h))
        modrm = modrm + 1
    }
    // Short-buffer family: each ModR/M byte with avail=1 (only the
    // modrm byte present) — exercises the return-0 / no-disp paths.
    let mut mr2 = 0
    while mr2 < 256 {
        let bytes2 = [mr2, 0, 0, 0, 0, 0]
        let (n, m, s, d, h) = decode_modrm_disp(bytes2, 1)
        println("S1\t" + to_string(mr2) + "\t" + to_string(n) + "\t" + to_string(m)
              + "\t" + to_string(s) + "\t" + to_string(d) + "\t" + to_string(h))
        mr2 = mr2 + 1
    }
    // mod=1 disp8 family across all sign values: modrm=0x45, disp 0..255
    let mut db = 0
    while db < 256 {
        let bytes3 = [0x45, db, 0, 0, 0, 0]
        let (n, m, s, d, h) = decode_modrm_disp(bytes3, 6)
        println("D8\t" + to_string(db) + "\t" + to_string(n) + "\t" + to_string(d))
        db = db + 1
    }
}

// ─── RUNEQ harness for the M3 leaves ────────────────────────────
// Three sub-corpora, tab-separated, byte-identical to the C harness
// (native/i386_decode_m3_runeq.c):
//   P  decode_prefixes over every single byte 0..255 (avail=1)
//   P2 decode_prefixes over every 2-byte pair (b, 0x90), avail=2 —
//      exercises multi-prefix accumulation + stop-at-opcode
//   O  i386_op_name over op enum 0..33 (covers all + 2 out-of-range)
//   R  rd_s32 / rd_s16 over sign-bit-spanning inputs
fn runeq_dump_m3() -> void {
    // P: each byte alone, avail=1.
    let mut b = 0
    while b < 256 {
        let (n, pre) = decode_prefixes([b, 0x90, 0x90, 0x90], 1)
        println("P\t" + to_string(b) + "\t" + to_string(n) + "\t" + to_string(pre))
        b = b + 1
    }
    // P2: each byte then a non-prefix opcode 0x90, avail=4.
    let mut b2 = 0
    while b2 < 256 {
        let (n, pre) = decode_prefixes([b2, 0x90, 0x00, 0x00], 4)
        println("P2\t" + to_string(b2) + "\t" + to_string(n) + "\t" + to_string(pre))
        b2 = b2 + 1
    }
    // P3: a run of the SAME prefix byte 9 times, avail=9 — tests the
    // n<8 cap + bitmask idempotence across all 11 prefix kinds.
    let pkinds = [0x66, 0x67, 0xF2, 0xF3, 0xF0, 0x2E, 0x36, 0x3E, 0x26, 0x64, 0x65]
    let mut ki = 0
    while ki < len(pkinds) {
        let pk = pkinds[ki]
        let (n, pre) = decode_prefixes([pk, pk, pk, pk, pk, pk, pk, pk, pk], 9)
        println("P3\t" + to_string(pk) + "\t" + to_string(n) + "\t" + to_string(pre))
        ki = ki + 1
    }
    // O: op enum 0..33 (33 > max valid 31 → default "(unknown)").
    let mut op = 0
    while op < 34 {
        println("O\t" + to_string(op) + "\t" + i386_op_name(op))
        op = op + 1
    }
    // R32: rd_s32 over a sweep of the high byte (sign bit), low 3 fixed.
    let mut hb = 0
    while hb < 256 {
        let v = rd_s32([0x11, 0x22, 0x33, hb], 0)
        println("R32\t" + to_string(hb) + "\t" + to_string(v))
        hb = hb + 1
    }
    // R16: rd_s16 over a sweep of the high byte (sign bit).
    let mut hb2 = 0
    while hb2 < 256 {
        let v = rd_s16([0x44, hb2], 0)
        println("R16\t" + to_string(hb2) + "\t" + to_string(v))
        hb2 = hb2 + 1
    }
}

fn main() -> int {
    // Run modes: "runeq-m3" → M3 corpus; "runeq" → M2 corpus; else self-test.
    // (arg index differs between `hexa-run` and `hexa` launch, so we scan.)
    let argv = args()
    let mut want_runeq = false
    let mut want_runeq_m3 = false
    let mut ai = 0
    while ai < len(argv) {
        if argv[ai] == "runeq" { want_runeq = true }
        if argv[ai] == "runeq-m3" { want_runeq_m3 = true }
        ai = ai + 1
    }
    if want_runeq_m3 {
        runeq_dump_m3()
        return 0
    }
    if want_runeq {
        runeq_dump()
        return 0
    }
    return self_test()
}
