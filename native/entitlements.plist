<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- JIT memory required for future i386 → arm64 binary translation
         (E2..E5 phases per docs/PE_TO_MACHO_SHIM_PLAN.ai.md).
         E1 (this commit) only mmap MAP_JIT, no execution yet. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- We mmap user-supplied PE binaries into our address space; library
         validation rejects unsigned mapped pages. Required for any future
         i386 code interpretation. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Allow unsigned executable memory pages (for the mmapped PE
         sections). own1: we never load .dylib's that aren't signed by us;
         this only loosens the page-level check on mmap. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
